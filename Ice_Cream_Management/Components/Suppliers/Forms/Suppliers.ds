form Suppliers
{
    success message = "Supplier saved successfully"

    Basic_Information
    (
        type = section
        displayname = "Basic Information"
        row = 1
        column = 0
    )
    must have unique Supplier_Name
    (
        type = text
        displayname = "Supplier Name"
        row = 1
        column = 1
        width = medium
    )
    Contact_Person
    (
        type = text
        displayname = "Contact Person"
        row = 1
        column = 1
        width = medium
    )
    Phone
    (
        type = phonenumber
        displayname = "Phone"
        defaultcountry = "in"
        row = 1
        column = 1
        width = medium
    )
    Email
    (
        type = email
        displayname = "Email"
        row = 1
        column = 1
        width = medium
    )
    Address_Classification
    (
        type = section
        displayname = "Address & Classification"
        visibility = true
        row = 2
        column = 1
    )
    Address
    (
        type = address
        displayname = "Address"
        row = 2
        column = 1
        width = medium
        address_line_1
        (
            type = address_line_1
            displayname = "Address Line 1"
        )
        address_line_2
        (
            type = address_line_2
            displayname = "Address Line 2"
        )
        district_city
        (
            type = district_city
            displayname = "City"
        )
        state_province
        (
            type = state_province
            displayname = "State"
        )
        postal_Code
        (
            type = postal_Code
            displayname = "Postal Code"
        )
        country
        (
            type = country
            displayname = "Country"
        )
        latitude
        (
            type = latitude
            displayname = "Latitude"
            visibility = false
        )
        longitude
        (
            type = longitude
            displayname = "Longitude"
            visibility = false
        )
    )
    Material_Category_Supplied
    (
        type = picklist
        displayname = "Material Category Supplied"
        values = {"Dairy & Cream","Sugar & Sweeteners","Flavoring & Essence","Fruits, Nuts & Toppings","Stabilizers & Emulsifiers","Packaging","Other"}
        row = 2
        column = 1
        width = medium
    )
    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Inactive"}
        initial value = "Active"
        row = 2
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
