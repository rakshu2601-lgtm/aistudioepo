form Temperature_Logs
{
    success message = "Temperature log recorded"

    Log_Details
    (
        type = section
        displayname = "Log Details"
        row = 1
        column = 0
    )
    Log_Number
    (
        type = autonumber
        displayname = "Log Number"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Cold_Storage_Unit
    (
        type = picklist
        displayname = "Cold Storage Unit"
        values = Cold_Storage_Units.ID
        displayformat = [Unit_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Recorded_DateTime
    (
        type = datetime
        displayname = "Recorded Date Time"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    Reading_Details
    (
        type = section
        displayname = "Reading Details"
        visibility = true
        row = 2
        column = 1
    )
    must have Recorded_Temperature_C
    (
        type = decimal
        displayname = "Recorded Temperature (C)"
        row = 2
        column = 1
        width = medium
    )
    Recorded_By
    (
        type = text
        displayname = "Recorded By"
        row = 2
        column = 1
        width = medium
    )
    Within_Range
    (
        type = checkbox
        displayname = "Within Range"
        row = 2
        column = 1
        width = medium
    )
    Remarks
    (
        type = textarea
        displayname = "Remarks"
        row = 2
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
