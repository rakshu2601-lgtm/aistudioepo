report All_Purchase_Orders
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    PO_Number
                    Supplier
                    Purchase_Date
                    Total_Amount
                    Status
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    PO_Number
                    Supplier
                    Purchase_Date
                    Total_Amount
                    Status
                    Received_Date
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
