            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Batch_Number
                    Product
                    Batch_Date
                    Actual_Quantity_Produced
                    Stage
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Batch_Number
                    Product
                    Batch_Date
                    Cold_Storage_Unit
                    Planned_Quantity
