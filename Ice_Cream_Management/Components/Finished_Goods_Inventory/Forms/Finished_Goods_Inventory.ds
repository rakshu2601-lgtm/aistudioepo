form Finished_Goods_Inventory
{
    success message = "Inventory lot saved"

    Lot_Information
    (
        type = section
        displayname = "Lot Information"
        row = 1
        column = 0
    )
    Lot_Number
    (
        type = autonumber
        displayname = "Lot Number"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Product
    (
        type = picklist
        displayname = "Product"
        values = Products.ID
        displayformat = [Product_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Production_Batch
    (
        type = picklist
        displayname = "Production Batch"
        values = Production_Batches.ID
        displayformat = [Batch_Number]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Stock_Details
    (
        type = section
        displayname = "Stock Details"
        visibility = true
        row = 2
        column = 1
    )
    Quantity_On_Hand
    (
        type = decimal
        displayname = "Quantity On Hand"
        initial value = 0
        row = 2
        column = 1
        width = medium
    )
    Manufacture_Date
    (
        type = date
        displayname = "Manufacture Date"
        row = 2
        column = 1
        width = medium
    )
    Expiry_Date
    (
        type = date
        displayname = "Expiry Date"
        row = 2
        column = 1
        width = medium
    )
    Storage_Unit
    (
        type = picklist
        displayname = "Storage Unit"
        values = Cold_Storage_Units.ID
        displayformat = [Unit_Name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    Status
    (
        type = picklist
        displayname = "Status"
        values = {"In Stock","Sold Out","Expired","Disposed"}
        initial value = "In Stock"
        row = 2
        column = 1
        width = medium
    )
    Last_Updated
    (
        type = date
        displayname = "Last Updated"
        initial value = "${zoho.currentdate}"
        row = 2
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
