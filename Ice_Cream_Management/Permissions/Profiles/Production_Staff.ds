"Production_Staff"
{
    name        = "Production_Staff"
    type        = Users_Permissions
    permissions = { Chat:true, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
    description = "Manages raw materials, purchasing, product recipes, production batches, quality checks, and cold-storage/temperature monitoring."

    ModulePermissions
    {
        Suppliers
        {
            enabled          = Create,View,Edit,Viewall,Modifyall,Import,Export,Search,Tab
            allFieldsVisible = true
            ReportPermissions
