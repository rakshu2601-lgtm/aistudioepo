"Sales_Staff"
{
    name        = "Sales_Staff"
    type        = Users_Permissions
    permissions = { Chat:true, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
    description = "Manages customers and sales orders, with read access to the product catalog and finished-goods stock."

    ModulePermissions
    {
        Customers
        {
            enabled          = Create,View,Edit,Viewall,Modifyall,Import,Export,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_Customers={"View","Edit","Delete"}
                Active_Customers={"View","Edit","Delete"}
            }
        }

        Sales_Orders
        {
            enabled          = Create,View,Edit,Viewall,Modifyall,Import,Export,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_Sales_Orders={"View","Edit","Delete"}
                Pending_Sales_Orders={"View","Edit","Delete"}
                Delivery_Calendar={"View","Edit","Delete"}
            }
        }

        Products
        {
            enabled          = View,Viewall,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_Products={"View"}
                Active_Products={"View"}
                Products_Board={"View"}
            }
        }

        Finished_Goods_Inventory
        {
            enabled          = View,Viewall,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_Finished_Goods={"View"}
                Expiring_Soon={"View"}
                Expired_Stock={"View"}
            }
        }

        Sales_Dashboard
        {
            enabled = tab
        }
    }
}
