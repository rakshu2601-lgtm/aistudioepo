"Shop_Manager"
{
    name        = "Shop_Manager"
    type        = Users_Permissions
    permissions = { Chat:true, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
    description = "Full operational access across the app, including both dashboards."

    ModulePermissions
    {
        Suppliers
        {
            enabled          = Create,View,Edit,Viewall,Modifyall,Import,Export,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_Suppliers={"View","Edit","Delete"}
                Active_Suppliers={"View","Edit","Delete"}
            }
        }

        Customers
        {
            enabled          = Create,View,Edit,Viewall,Modifyall,Import,Export,Search,Tab
            allFieldsVisible = true
