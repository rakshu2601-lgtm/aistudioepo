form KYC_Document_Requests
{
    title
    {
        displayname = "KYC Document Requests"
        on add = "Add KYC Document Request"
        on edit = "Edit KYC Document Request"
    }
    success message = "KYC document request saved successfully."
    record owner = Customer_Portal_User

    Request_Details
    (
        type = section
        displayname = "Request Details"
        row = 1
        column = 0
    )
    Request_ID
    (
        type = autonumber
        displayname = "Request ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Customer
    (
        type = picklist
        displayname = "Customer"
        values = Customers.ID
        displayformat = [Customer_Name.first_name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Customer_Portal_User
    (
        type = picklist
        displayname = "Customer Portal User"
        module = users
        user type = "portal users"
        displayformat = [name]
        row = 1
        column = 2
        width = medium
    )
    Rule
    (
        type = picklist
        displayname = "KYC Rule"
        values = KYC_Document_Rules.ID
        displayformat = [Document_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Requested_Document_Name
    (
        type = text
        displayname = "Requested Document Name"
        maxchar = 150
        row = 1
        column = 2
        width = medium
    )
    Instructions
    (
        type = textarea
        displayname = "Instructions"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    Required_Document
    (
        type = checkbox
        displayname = "Required Document"
        initial value = true
        row = 1
        column = 2
        width = medium
    )
    Requested_By
    (
        type = picklist
        displayname = "Requested By"
        values = Employees.ID
        displayformat = [Employee_Name.first_name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Requested_On
    (
        type = datetime
        displayname = "Requested On"
        mins_displayinterval = 5
        row = 1
        column = 2
        width = medium
    )
    Verification_Status
    (
        type = picklist
        displayname = "Verification Status"
        values = {"Draft","Requested","Uploaded","Approved","Rejected"}
        initial value = "Draft"
        row = 1
        column = 1
        width = medium
    )
    Customer_Upload
    (
        type = section
        displayname = "Customer Upload"
        visibility = true
        row = 2
        column = 1
    )
    Uploaded_Document
    (
        type = upload file
        displayname = "Uploaded Document"
        file count = 1
        browse = local_drive, google_docs, zoho_docs
        row = 2
        column = 1
        width = medium
    )
    Uploaded_On
    (
        type = datetime
        displayname = "Uploaded On"
        mins_displayinterval = 5
        row = 2
        column = 2
        width = medium
    )
    Review_Details
    (
        type = section
        displayname = "Review Details"
        visibility = true
        row = 3
        column = 1
    )
    Reviewed_By
    (
        type = picklist
        displayname = "Reviewed By"
        values = Employees.ID
        displayformat = [Employee_Name.first_name]
        searchable = true
        row = 3
        column = 1
        width = medium
    )
    Reviewed_On
    (
        type = datetime
        displayname = "Reviewed On"
        mins_displayinterval = 5
        row = 3
        column = 2
        width = medium
    )
    Review_Notes
    (
        type = textarea
        displayname = "Review Notes"
        height = 100px
        row = 3
        column = 1
        width = medium
    )
    Rejection_Reason
    (
        type = textarea
        displayname = "Rejection Reason"
        height = 100px
        row = 3
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Draft Request"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Request"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
    blueprint components
    {
        stages = {"Draft","Requested","Uploaded","Approved","Rejected"}
    }
}