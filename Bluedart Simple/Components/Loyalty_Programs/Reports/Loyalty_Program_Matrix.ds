default list Loyalty_Program_Matrix
{
    displayName = "Loyalty Programme Matrix"
    show all rows from Loyalty_Programs
    (
        Program_ID
        Customer_Type
        Tier_Name
        Min_Lifetime_Points
        Max_Lifetime_Points
        Points_Per_Rupee
        Redemption_Value_Per_Point
        Minimum_Redemption_Points
        Max_Shipment_Discount_Percent
        Expiry_Months
        Effective_From
        Effective_To
        Priority
        Active
        (
            displaytrue = "Active"
            displayfalse = "Inactive"
        )
    )
    filters
    (
        Customer_Type
        Tier_Name
        Effective_From
        Effective_To
        Active
        "Active Programmes" : (Active == true)
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Customer_Type ascending
    )
    sort by
    (
        Customer_Type ascending
        Min_Lifetime_Points ascending
        Priority ascending
        Effective_From descending
    )
}