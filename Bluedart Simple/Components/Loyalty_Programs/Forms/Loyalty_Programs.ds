form Loyalty_Programs
{
    title
    {
        displayname = "Loyalty Programmes"
        on add = "Add Loyalty Programme"
        on edit = "Edit Loyalty Programme"
    }
    success message = "Loyalty programme saved successfully."

    Tier_Classification
    (
        type = section
        displayname = "Tier Classification"
        row = 1
        column = 0
    )
    Program_ID
    (
        type = autonumber
        displayname = "Programme ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Customer_Type
    (
        type = picklist
        displayname = "Customer Type"
        values = {"Retail","Corporate","Wholesale"}
        row = 1
        column = 1
        width = medium
    )
    must have Tier_Name
    (
        type = text
        displayname = "Tier Name"
        maxchar = 100
        row = 1
        column = 2
        width = medium
    )
    must have Min_Lifetime_Points
    (
        type = number
        displayname = "Minimum Lifetime Points"
        format = commadotindian
        row = 1
        column = 1
        width = medium
    )
    Max_Lifetime_Points
    (
        type = number
        displayname = "Maximum Lifetime Points"
        format = commadotindian
        row = 1
        column = 2
        width = medium
    )
    Priority
    (
        type = number
        displayname = "Selection Priority"
        format = commadotindian
        initial value = 1
        row = 1
        column = 1
        width = medium
    )

    Earning_and_Redemption
    (
        type = section
        displayname = "Earning and Redemption"
        visibility = true
        row = 2
        column = 1
    )
    must have Points_Per_Rupee
    (
        type = decimal
        displayname = "Points per Rupee"
        format = commadotindian
        decimalplace = 4
        row = 2
        column = 1
        width = medium
    )
    must have Redemption_Value_Per_Point
    (
        type = INR
        displayname = "Redemption Value per Point (INR)"
        format = commadotindian
        decimalplace = 4
        maxchar = 16
        row = 2
        column = 2
        width = medium
    )
    must have Minimum_Redemption_Points
    (
        type = number
        displayname = "Minimum Redemption Points"
        format = commadotindian
        row = 2
        column = 1
        width = medium
    )
    Max_Shipment_Discount_Percent
    (
        type = decimal
        displayname = "Maximum Shipment Discount (%)"
        format = commadotindian
        initial value = 100
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Expiry_Months
    (
        type = number
        displayname = "Points Expiry (Months)"
        description [ type = tooltip  message = "Enter 0 when loyalty points do not expire." ]
        format = commadotindian
        initial value = 0
        row = 2
        column = 1
        width = medium
    )

    Effective_Period
    (
        type = section
        displayname = "Effective Period"
        visibility = true
        row = 3
        column = 1
    )
    must have Effective_From
    (
        type = date
        displayname = "Effective From"
        row = 3
        column = 1
        width = medium
    )
    Effective_To
    (
        type = date
        displayname = "Effective To"
        row = 3
        column = 2
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 3
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Programme"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Programme"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}