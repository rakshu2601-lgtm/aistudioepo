form Manifests
{
    title
    {
        displayname = "Manifests"
        on add = "Create Manifest Leg"
        on edit = "Edit Manifest Leg"
    }
    success message = "Manifest leg saved successfully."
    record owner = Assigned_Agent_User

    Manifest_Details
    (
        type = section
        displayname = "Manifest Details"
        row = 1
        column = 0
    )
    Manifest_Number
    (
        type = autonumber
        displayname = "Manifest Number"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Manifest_Type
    (
        type = picklist
        displayname = "Manifest Type"
        values = {"Pickup","Line Haul","Hub Transfer","Delivery"}
        row = 1
        column = 1
        width = medium
    )
    must have Origin_Hub
    (
        type = picklist
        displayname = "Origin Hub"
        values = Hubs[Status == "Active"].ID
        displayformat = [Hub_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Destination_Hub
    (
        type = picklist
        displayname = "Destination Hub"
        values = Hubs[Status == "Active"].ID
        displayformat = [Hub_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Transport_Mode
    (
        type = picklist
        displayname = "Transport Mode"
        values = {"Road","Air","Rail","Sea"}
        row = 1
        column = 2
        width = medium
    )

    Agent_and_Carrier
    (
        type = section
        displayname = "Agent and Carrier"
        visibility = true
        row = 2
        column = 1
    )
    Assigned_Agent
    (
        type = picklist
        displayname = "Assigned Agent"
        values = Employees[Employee_Type == "Agent" && Active == true].ID
        displayformat = [Employee_Name.first_name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    Assigned_Agent_User
    (
        type = picklist
        displayname = "Assigned Agent User"
        module = users
        displayformat = [name]
        row = 2
        column = 2
        width = medium
    )
    Vehicle_or_Carrier_Details
    (
        type = text
        displayname = "Vehicle or Carrier Details"
        maxchar = 200
        row = 2
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 90px
        row = 2
        column = 2
        width = medium
    )

    Journey_Timing
    (
        type = section
        displayname = "Journey Timing"
        visibility = true
        row = 3
        column = 1
    )
    Planned_Departure
    (
        type = datetime
        displayname = "Planned Departure"
        mins_displayinterval = 5
        row = 3
        column = 1
        width = medium
    )
    Planned_Arrival
    (
        type = datetime
        displayname = "Planned Arrival"
        mins_displayinterval = 5
        row = 3
        column = 2
        width = medium
    )
    Actual_Departure
    (
        type = datetime
        displayname = "Actual Departure"
        mins_displayinterval = 5
        row = 3
        column = 1
        width = medium
    )
    Actual_Arrival
    (
        type = datetime
        displayname = "Actual Arrival"
        mins_displayinterval = 5
        row = 3
        column = 2
        width = medium
    )
    Manifest_Status
    (
        type = picklist
        displayname = "Manifest Status"
        values = {"Draft","Ready","Dispatched","Arrived","Closed","Cancelled"}
        initial value = "Draft"
        row = 3
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Create Manifest Leg"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Manifest Leg"
            )
            Cancel
            (
                type = cancel
                displayname = "Close"
            )
        }
    }

    blueprint components
    {
        stages = {"Draft","Ready","Dispatched","Arrived","Closed","Cancelled"}
    }
}