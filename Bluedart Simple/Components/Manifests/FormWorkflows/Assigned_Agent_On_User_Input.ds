Manifest_Assigned_Agent_On_User_Input as "Copy Manifest Agent Owner"
{
    type = form
    form = Manifests
    record event = on add or edit
    description = "Copies the selected agent's internal user into the manifest record owner field."

    on user input of Assigned_Agent
    {
        actions
        {
            custom deluge script
            (
                if(input.Assigned_Agent != null)
                {
                    agentRecord = Employees[ID == input.Assigned_Agent];
                    if(agentRecord.count() > 0)
                    {
                        input.Assigned_Agent_User = agentRecord.Internal_User;
                    }
                }
                else
                {
                    input.Assigned_Agent_User = null;
                }
            )
        }
    }
}