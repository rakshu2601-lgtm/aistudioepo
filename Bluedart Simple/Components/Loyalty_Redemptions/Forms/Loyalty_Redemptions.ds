form Loyalty_Redemptions
{
    title
    {
        displayname = "Loyalty Redemptions"
        on add = "Request Loyalty Redemption"
        on edit = "Review Loyalty Redemption"
    }
    success message = "Loyalty redemption saved successfully."
    record owner = Customer_Portal_User

    Redemption_Context
    (
        type = section
        displayname = "Redemption Context"
        row = 1
        column = 0
    )
    Redemption_Number
    (
        type = autonumber
        displayname = "Redemption Number"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Customer
    (
        type = picklist
        displayname = "Customer"
        values = Customers.ID
        displayformat = [Customer_Name.first_name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Customer_Portal_User
    (
        type = picklist
        displayname = "Customer Portal User"
        module = users
        user type = "portal users"
        displayformat = [name]
        row = 1
        column = 2
        width = medium
    )
    must have Redemption_Type
    (
        type = picklist
        displayname = "Redemption Type"
        values = {"Cash Value","Shipment Discount"}
        row = 1
        column = 1
        width = medium
    )
    Shipment
    (
        type = picklist
        displayname = "Shipment"
        values = Shipment_Requests.ID
        displayformat = [Shipment_Number]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Program
    (
        type = picklist
        displayname = "Loyalty Programme"
        values = Loyalty_Programs.ID
        displayformat = [Tier_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )

    Redemption_Value
    (
        type = section
        displayname = "Redemption Value"
        visibility = true
        row = 2
        column = 1
    )
    must have Points_Requested
    (
        type = number
        displayname = "Points Requested"
        format = commadotindian
        row = 2
        column = 1
        width = medium
    )
    Amount_Value
    (
        type = INR
        displayname = "Amount Value (INR)"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        initial value = 0
        row = 2
        column = 2
        width = medium
    )
    Redemption_Status
    (
        type = picklist
        displayname = "Redemption Status"
        values = {"Requested","Approved","Applied","Paid","Rejected","Cancelled"}
        initial value = "Requested"
        row = 2
        column = 1
        width = medium
    )
    Requested_On
    (
        type = datetime
        displayname = "Requested On"
        initial value = "${zoho.currenttime}"
        mins_displayinterval = 5
        row = 2
        column = 2
        width = medium
    )
    Generated_Transaction
    (
        type = picklist
        displayname = "Generated Ledger Transaction"
        values = Loyalty_Transactions.ID
        displayformat = [Transaction_ID]
        searchable = true
        row = 2
        column = 1
        width = medium
    )

    Review_and_Payout
    (
        type = section
        displayname = "Review and Payout"
        visibility = true
        row = 3
        column = 1
    )
    Reviewed_By
    (
        type = picklist
        displayname = "Reviewed By"
        values = Employees.ID
        displayformat = [Employee_Name.first_name]
        searchable = true
        row = 3
        column = 1
        width = medium
    )
    Reviewed_On
    (
        type = datetime
        displayname = "Reviewed On"
        mins_displayinterval = 5
        row = 3
        column = 2
        width = medium
    )
    Payment_Reference
    (
        type = text
        displayname = "UPI / Bank Payment Reference"
        maxchar = 255
        row = 3
        column = 1
        width = medium
    )
    Review_Notes
    (
        type = textarea
        displayname = "Review Notes"
        height = 120px
        row = 3
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Request Redemption"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Redemption"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }

    blueprint components
    {
        stages = {"Requested","Approved","Applied","Paid","Rejected","Cancelled"}
    }
}