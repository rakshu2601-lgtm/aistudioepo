form KYC_Document_Rules
{
    title
    {
        displayname = "KYC Document Rules"
        on add = "Add KYC Document Rule"
        on edit = "Edit KYC Document Rule"
    }
    success message = "KYC document rule saved successfully."

    Document_Configuration
    (
        type = section
        displayname = "Document Configuration"
        row = 1
        column = 0
    )
    Rule_ID
    (
        type = autonumber
        displayname = "Rule ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Customer_Type
    (
        type = picklist
        displayname = "Customer Type"
        values = {"Corporate","Wholesale"}
        row = 1
        column = 1
        width = medium
    )
    must have Document_Name
    (
        type = text
        displayname = "Document Name"
        maxchar = 150
        row = 1
        column = 2
        width = medium
    )
    Instructions
    (
        type = textarea
        displayname = "Instructions"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    Allowed_File_Type
    (
        type = picklist
        displayname = "Allowed File Type"
        values = {"PDF","Image","Any"}
        initial value = "PDF"
        row = 1
        column = 2
        width = medium
    )
    Rule_Status
    (
        type = section
        displayname = "Rule Status"
        visibility = true
        row = 2
        column = 1
    )
    Required_Document
    (
        type = checkbox
        displayname = "Required Document"
        initial value = true
        row = 2
        column = 1
        width = medium
    )
    Sort_Order
    (
        type = number
        displayname = "Sort Order"
        format = commadotindian
        initial value = 1
        row = 2
        column = 2
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 2
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Rule"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Rule"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}