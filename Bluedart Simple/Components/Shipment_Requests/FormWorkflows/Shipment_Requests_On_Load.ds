Shipment_Requests_On_Load as "Configure Shipment Request Form"
{
    type = form
    form = Shipment_Requests
    record event = on add or edit
    description = "Resolves the logged-in requester and separates customer entry from internal quotation and routing controls."

    on load
    {
        actions
        {
            custom deluge script
            (
                isPortalCustomer = thisapp.portal.isUserInProfile("Customer_Portal");
                if(isPortalCustomer == true)
                {
                    customerRecord = Customers[Portal_User == zoho.loginuserid];
                    if(customerRecord.count() > 0)
                    {
                        input.Customer = customerRecord.ID;
                        input.Customer_Portal_User = customerRecord.Portal_User;
                        input.Requested_By_Type = "Customer";
                        input.Available_Points = ifnull(customerRecord.Current_Points_Balance,0);
                        if(input.ID == null)
                        {
                            input.Pickup_Contact_Name = customerRecord.Customer_Name.first_name;
                            input.Pickup_Phone = customerRecord.Customer_Phone;
                            input.Pickup_Address = customerRecord.Primary_Address;
                        }
                    }
                    disable Customer;
                    disable Customer_Portal_User;
                    disable Requested_By_Type;
                    hide Requested_By_Employee;
                    hide Manual_Distance_Km;
                    hide Origin_Hub;
                    hide Destination_Hub;
                    hide Current_Hub;
                    hide Pickup_Agent;
                    hide Applied_Rate;
                    if(input.Shipment_Status == "Requested" || input.ID == null)
                    {
                        enable Pickup_Contact_Name;
                        enable Pickup_Phone;
                        enable Pickup_Address;
                        enable Delivery_Contact_Name;
                        enable Delivery_Phone;
                        enable Delivery_Address;
                        enable Package_Description;
                        enable Weight_Kg;
                        enable Dimensions_Cm;
                        enable Transport_Mode;
                        disable Use_Loyalty;
                        disable Loyalty_Points_To_Use;
                    }
                    else
                    {
                        disable Pickup_Contact_Name;
                        disable Pickup_Phone;
                        disable Pickup_Address;
                        disable Delivery_Contact_Name;
                        disable Delivery_Phone;
                        disable Delivery_Address;
                        disable Package_Description;
                        disable Weight_Kg;
                        disable Dimensions_Cm;
                        disable Transport_Mode;
                        if(input.Shipment_Status == "Quoted")
                        {
                            enable Use_Loyalty;
                            enable Loyalty_Points_To_Use;
                        }
                        else
                        {
                            disable Use_Loyalty;
                            disable Loyalty_Points_To_Use;
                        }
                    }
                }
                else
                {
                    input.Requested_By_Type = "Employee";
                    requester = Employees[Work_Email == zoho.loginuserid];
                    if(input.ID == null && requester.count() > 0)
                    {
                        input.Requested_By_Employee = requester.ID;
                    }
                    show Requested_By_Employee;
                    show Manual_Distance_Km;
                    show Origin_Hub;
                    show Destination_Hub;
                    show Current_Hub;
                    show Pickup_Agent;
                    show Applied_Rate;
                    disable Customer_Portal_User;
                    disable Available_Points;
                }
                if(input.Use_Loyalty == true)
                {
                    show Loyalty_Points_To_Use;
                }
                else
                {
                    hide Loyalty_Points_To_Use;
                }
                disable Requested_On;
                disable Available_Points;
                disable Base_Transport_Amount;
                disable Fuel_Surcharge;
                disable Gross_Amount;
                disable Loyalty_Discount;
                disable Net_Amount;
                disable Shipment_Status;
                disable Quoted_On;
                disable Confirmed_On;
                disable Picked_Up_On;
                disable Delivered_On;
                disable Latest_Tracking_Text;
            )
        }
    }
}