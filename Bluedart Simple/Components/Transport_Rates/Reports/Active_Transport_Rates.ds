default spreadsheet Active_Transport_Rates
{
    displayName = "Active Transport Rates"
    show all rows from Transport_Rates [Active == true]
    (
        Rate_ID
        Rate_Name
        Customer_Type
        Transport_Mode
        Min_Weight_Kg
        Max_Weight_Kg
        Min_Distance_Km
        Max_Distance_Km
        Base_Charge
        Charge_Per_Kg
        Charge_Per_Km
        Minimum_Charge
        Fuel_Surcharge_Percent
        Priority
        Effective_From
        Effective_To
        Active
        (
            displaytrue = "Active"
            displayfalse = "Inactive"
        )
    )
    filters
    (
        Customer_Type
        Transport_Mode
        Effective_From
        Effective_To
        Active
    )
    sort by
    (
        Transport_Mode ascending
        Customer_Type ascending
        Priority ascending
        Effective_From descending
    )
}