<%
loginEmail = zoho.loginuserid;
isAgent = thisapp.permissions.isUserInProfile("Hub_Agent");
isAdmin = thisapp.permissions.isUserInProfile("Logistics_Admin");
agentRows = Employees[Work_Email == loginEmail && Employee_Type == "Agent" && Active == true];
%>
<style>
/* zcs-global utility sheet: included once for this page, limited to the utilities used by this mobile-first composition. */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;--zcs-page-bg-color:#f3f3f4;font-size:16px;line-height:1.5}
.zcs-row,.zcs-flex{display:flex}.zcs-row{flex-wrap:wrap}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-row-wrap{flex-wrap:wrap}.zcs-no-shrink{flex-shrink:0}.zcs-relative{position:relative}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-text-center{text-align:center}.zcs-no-underline{text-decoration:none}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-m-0{margin:0}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-6{margin-top:.375rem}.zcs-mt-8{margin-top:.5rem}.zcs-mb-0{margin-bottom:0}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-p-0{padding:0}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-card{background:var(--zcs-white-color);border:1px solid #e1e4ea;border-radius:12px}.zcs-list-none{list-style:none}
/* ZCS badge-badge-with-icon and card-fleets-card-1 badge styles. */
.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-green{background:#e4fcf3;border-color:#147a56;color:#116b4c}.zcs-badge-red{background:#fde3e6;border-color:#b42335;color:#9d1d2d}.zcs-badge-yellow{background:#fcf4e6;border-color:#9a6508;color:#744b04}.zcs-badge-blue{background:#e8efff;border-color:#245fca;color:#174caa}.zcs-badge-grey{background:#eceef1;border-color:#5f6670;color:#3f454d}.zcs-badge-orange{background:#fff0e8;border-color:#b94d0b;color:#8e3906}
/* ZCS button-primary-button and quick-actions-card-type-quick-actions. */
.zcs-button{width:auto;min-width:5rem;min-height:44px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-button:hover{filter:brightness(.96)}.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-quick-action-item{list-style:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}
/* ZCS fleet trip summary progress and recent-activity timeline. */
.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}.zcs-tl-dot{width:12px;height:12px;background:var(--zcs_brand_color);border:1px solid #fff;box-shadow:0 2px 6px #c4dee4}.zcs-tl-line{width:1px;background:#d8dde3;align-self:stretch;margin:4px 10px 0 5px}
/* Agent dashboard composition. */
*{box-sizing:border-box}.ad-shell{min-height:100%;background:var(--zcs-page-bg-color);padding:12px;color:var(--zcs-primary-text-color)}.ad-container{max-width:1180px;margin:0 auto}.ad-header{display:flex;flex-direction:column;gap:16px}.ad-header-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.ad-header-actions .zcs-button{width:100%}.ad-kpis{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:12px}.ad-kpi{min-height:112px}.ad-kpi-icon{width:40px;height:40px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.ad-main{display:grid;grid-template-columns:1fr;gap:14px;margin-top:14px}.ad-section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}.ad-task-list,.ad-manifest-list{display:grid;gap:12px}.ad-task{border-left:4px solid var(--zcs_brand_color)}.ad-task-overdue{border-left-color:#b42335}.ad-task-head,.ad-manifest-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.ad-route{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.ad-details{display:grid;grid-template-columns:1fr;gap:9px;margin-top:14px}.ad-detail{display:flex;gap:9px;align-items:flex-start;min-width:0}.ad-detail i{width:18px;color:var(--zcs-teritiary-text-color);margin-top:2px}.ad-detail span,.ad-detail a{word-break:break-word}.ad-proof{margin-top:14px}.ad-actions{display:grid;grid-template-columns:1fr;gap:8px;margin-top:14px}.ad-actions .zcs-button{width:100%}.ad-proof-ready{color:#116b4c}.ad-proof-needed{color:#8e3906}.ad-side{display:grid;gap:14px}.ad-activity-item{display:flex;align-items:stretch}.ad-activity-content{padding-bottom:14px;min-width:0}.ad-empty{min-height:130px}.ad-empty i{font-size:28px;color:var(--zcs-teritiary-text-color)}.ad-notfound{max-width:720px;margin:44px auto;text-align:center}.ad-call{color:var(--zcs_brand_color);font-weight:600}.ad-link{color:var(--zcs_brand_color)}.ad-manifest-actions{margin-top:14px}.ad-availability{align-self:flex-start}.ad-updated{white-space:nowrap}
@media(min-width:700px){.ad-shell{padding:20px}.ad-header{flex-direction:row;align-items:flex-start;justify-content:space-between}.ad-header-actions{min-width:330px}.ad-kpis{grid-template-columns:repeat(4,minmax(0,1fr))}.ad-details{grid-template-columns:repeat(2,minmax(0,1fr))}.ad-actions{grid-template-columns:repeat(2,minmax(0,1fr))}.ad-actions .ad-wide{grid-column:1/-1}}
@media(min-width:1020px){.ad-main{grid-template-columns:minmax(0,1.65fr) minmax(320px,.85fr)}.ad-manifest-list{grid-template-columns:repeat(2,minmax(0,1fr))}.ad-side{align-content:start}}
</style>
<div class='ad-shell'><div class='ad-container'>
<%
if(isAgent == false && isAdmin == false)
{
%>
<div class='zcs-card zcs-p-24 ad-notfound' role='alert'>
    <i class='zc-li-outline ui-1-lock'></i>
    <h1 class='zcs-font-24 zcs-font-semibold'>Access unavailable</h1>
    <p class='zcs-font-14 zcs-color-secondary'>This work queue is available only to Hub Agent and Logistics Admin profiles.</p>
</div>
<%
}
else if(agentRows.count() == 0)
{
%>
<div class='zcs-card zcs-p-24 ad-notfound' role='status'>
    <i class='zc-li-outline users-1-single-body'></i>
    <h1 class='zcs-font-24 zcs-font-semibold'>No active agent record is mapped</h1>
    <p class='zcs-font-14 zcs-color-secondary'>Employees.Work_Email must exactly match <%=loginEmail%>, Employee Type must be Agent, and Active must be selected. No operational records are shown until that identity is resolved.</p>
    <%if(isAdmin){%><a class='zcs-button zcs-primary-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-no-underline' href='#Report:Active_Agents'><i class='zc-li-outline users-1-single-body'></i><span>Open active agents</span></a><%}%>
</div>
<%
}
else
{
    agent = agentRows;
    agentID = agent.ID;
    agentName = ifnull(agent.Employee_Name.first_name,"");
    if(ifnull(agent.Employee_Name.last_name,"") != "")
    {
        agentName = agentName + " " + agent.Employee_Name.last_name;
    }
    availabilityClass = "zcs-badge-grey";
    availabilityIcon = "ui-2-time";
    if(agent.Availability_Status == "Available")
    {
        availabilityClass = "zcs-badge-green";
        availabilityIcon = "ui-1-check-circle-08";
    }
    else if(agent.Availability_Status == "Assigned")
    {
        availabilityClass = "zcs-badge-blue";
        availabilityIcon = "loader-dots-06";
    }
    else if(agent.Availability_Status == "Off Duty" || agent.Availability_Status == "Inactive")
    {
        availabilityClass = "zcs-badge-red";
        availabilityIcon = "ui-1-circle-remove";
    }
    assignedCount = Agent_Tasks[Agent_User == loginEmail && Assigned_Agent == agentID && Task_Status == "Assigned"].count();
    inProgressCount = Agent_Tasks[Agent_User == loginEmail && Assigned_Agent == agentID && Task_Status == "In Progress"].count();
    completedTodayCount = Agent_Tasks[Agent_User == loginEmail && Assigned_Agent == agentID && Task_Status == "Completed" && Completed_On >= zoho.currentdate && Completed_On < zoho.currentdate.addDay(1)].count();
    failedCount = Agent_Tasks[Agent_User == loginEmail && Assigned_Agent == agentID && Task_Status == "Failed"].count();
    openManifestRows = Manifests[Assigned_Agent_User == loginEmail && Assigned_Agent == agentID && Manifest_Status != "Closed" && Manifest_Status != "Cancelled"] sort by Planned_Departure asc;
%>
<header class='zcs-card zcs-p-20 ad-header'>
    <div>
        <div class='zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-10'>
            <h1 class='zcs-font-24 zcs-font-semibold zcs-m-0'><%=agentName%>'s work queue</h1>
            <span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13 <%=availabilityClass%>'><i class='zc-li-outline <%=availabilityIcon%>'></i><span><%=agent.Availability_Status%></span></span>
        </div>
        <p class='zcs-font-13 zcs-color-secondary zcs-mt-6 zcs-mb-0'><%=ifnull(agent.Hub.Hub_Name,"Hub not mapped")%> · <span class='ad-updated'>Updated <%=zoho.currenttime.toString("dd-MMM-yyyy, hh:mm a")%> IST</span></p>
    </div>
    <nav class='ad-header-actions' aria-label='Agent reports'>
        <a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md zcs-no-underline' href='#Report:My_Agent_Tasks'><i class='zc-li-outline design-todo'></i><span>My tasks</span></a>
        <a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md zcs-no-underline' href='#Report:My_Assigned_Manifests'><i class='zc-li-outline transport-delivery-fast'></i><span>My manifests</span></a>
    </nav>
</header>
<section class='ad-kpis' aria-label='Daily work metrics'>
<%
kpiValues = {assignedCount,inProgressCount,completedTodayCount,failedCount};
kpiLabels = {"Assigned","In progress","Completed today","Failed tasks"};
kpiIcons = {"design-todo","loader-dots-06","ui-1-check-circle-08","ui-1-circle-remove"};
kpiBadgeClasses = {"zcs-badge-blue","zcs-badge-orange","zcs-badge-green","zcs-badge-red"};
for each index kpiIndex in kpiValues
{
%>
<div class='zcs-card zcs-flex zcs-direction-column zcs-gap-8 zcs-p-16 ad-kpi'>
    <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><span class='ad-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline <%=kpiIcons.get(kpiIndex)%>'></i></span><span class='zcs-badge zcs-badge-filled-outline zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12 <%=kpiBadgeClasses.get(kpiIndex)%>'><%=kpiLabels.get(kpiIndex)%></span></div>
    <strong class='zcs-font-28'><%=kpiValues.get(kpiIndex).toString("##,##,##0")%></strong>
</div>
<%
}
%>
</section>
<div class='ad-main'>
<main>
<section class='zcs-card zcs-p-16'>
    <div class='ad-section-head'><div><h2 class='zcs-font-20 zcs-font-semibold zcs-m-0'>Prioritized pickup and delivery tasks</h2><p class='zcs-font-13 zcs-color-secondary zcs-mt-4 zcs-mb-0'>In progress first, then accepted and assigned; earliest schedule first.</p></div><a class='ad-link zcs-font-13 zcs-font-semibold' href='#Report:Agent_Task_Calendar'>Calendar</a></div>
    <div class='ad-task-list'>
<%
taskCounter = 0;
taskStates = {"In Progress","Accepted","Assigned"};
for each taskState in taskStates
{
    taskRows = Agent_Tasks[Agent_User == loginEmail && Assigned_Agent == agentID && Task_Status == taskState] sort by Scheduled_At asc;
    for each taskRow in taskRows
    {
        if(taskCounter < 12)
        {
            statusClass = "zcs-badge-yellow";
            statusIcon = "ui-2-time";
            if(taskRow.Task_Status == "In Progress")
            {
                statusClass = "zcs-badge-orange";
                statusIcon = "loader-dots-06";
            }
            else if(taskRow.Task_Status == "Accepted")
            {
                statusClass = "zcs-badge-blue";
                statusIcon = "ui-1-check-circle-08";
            }
            isOverdue = taskRow.Scheduled_At != null && taskRow.Scheduled_At < zoho.currenttime;
            scheduleText = "Schedule pending";
            if(taskRow.Scheduled_At != null)
            {
                scheduleText = taskRow.Scheduled_At.toString("dd-MMM-yyyy, hh:mm a") + " IST";
            }
            taskAddress = ifnull(taskRow.Task_Address.address_line_1,"");
            if(ifnull(taskRow.Task_Address.address_line_2,"") != "")
            {
                taskAddress = taskAddress + ", " + taskRow.Task_Address.address_line_2;
            }
            taskAddress = taskAddress + ", " + ifnull(taskRow.Task_Address.district_city,"") + ", " + ifnull(taskRow.Task_Address.state_province,"") + " - " + ifnull(taskRow.Task_Address.postal_Code,"") + ", " + ifnull(taskRow.Task_Address.country,"India");
            shipmentNumber = taskRow.Shipment.Shipment_Number;
            proofReady = false;
            proofText = "Proof file required before completion";
            if(taskRow.Task_Type == "Pickup")
            {
                proofReady = taskRow.Proof_File != null;
            }
            else
            {
                proofText = "Recipient name plus proof file or signature required";
                proofReady = ifnull(taskRow.Recipient_Name,"") != "" && (taskRow.Proof_File != null || taskRow.Recipient_Signature != null);
            }
            if(proofReady)
            {
                proofText = "Required proof captured";
            }
%>
<article class='zcs-card zcs-p-16 ad-task <%if(isOverdue){%>ad-task-overdue<%}%>'>
    <div class='ad-task-head'>
        <div class='zcs-flex zcs-align-items-start zcs-gap-10'>
            <span class='ad-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg zcs-no-shrink'><i class='zc-li-outline <%if(taskRow.Task_Type == "Pickup"){%>arrows-1-tail-left<%}else{%>arrows-1-tail-right<%}%>'></i></span>
            <div><h3 class='zcs-font-18 zcs-font-semibold zcs-m-0'><%=taskRow.Task_Type%> task <%=taskRow.Task_Number%></h3><p class='zcs-font-13 zcs-color-secondary zcs-mt-4 zcs-mb-0'>Shipment <%=shipmentNumber%></p></div>
        </div>
        <span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12 <%=statusClass%>'><i class='zc-li-outline <%=statusIcon%>'></i><%=taskRow.Task_Status%></span>
    </div>
    <div class='ad-details'>
        <div class='ad-detail'><i class='zc-li-outline users-1-single-body'></i><div><span class='zcs-font-12 zcs-color-tertiary'>Contact</span><br><strong class='zcs-font-14'><%=taskRow.Contact_Name%></strong> · <a class='ad-call' href='tel:<%=taskRow.Contact_Phone%>'><%=taskRow.Contact_Phone%></a></div></div>
        <div class='ad-detail'><i class='zc-li-outline ui-2-time'></i><div><span class='zcs-font-12 zcs-color-tertiary'>Scheduled</span><br><strong class='zcs-font-14'><%=scheduleText%></strong><%if(isOverdue){%> <span class='zcs-badge zcs-badge-filled-outline zcs-badge-red zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'>Overdue</span><%}%></div></div>
        <div class='ad-detail'><i class='zc-li-outline location-pin-copy'></i><div><span class='zcs-font-12 zcs-color-tertiary'>Indian address</span><br><strong class='zcs-font-14'><%=taskAddress%></strong></div></div>
        <div class='ad-detail'><i class='zc-li-outline design-app'></i><div><span class='zcs-font-12 zcs-color-tertiary'>Hub</span><br><strong class='zcs-font-14'><%=taskRow.Hub.Hub_Name%></strong></div></div>
    </div>
    <div class='ad-proof zcs-flex zcs-align-items-center zcs-gap-8 <%if(proofReady){%>ad-proof-ready<%}else{%>ad-proof-needed<%}%>'><i class='zc-li-outline <%if(proofReady){%>ui-1-check-circle-08<%}else{%>files-2-doc<%}%>'></i><strong class='zcs-font-13'><%=proofText%></strong></div>
    <div class='ad-actions'>
        <%if(taskRow.Task_Status == "Assigned"){%><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-10 zcs-rounded-md zcs-no-underline ad-wide' href='#Report:My_Agent_Tasks?ID=<%=taskRow.ID%>&amp;zc_LoadIn=dialog'><i class='zc-li-outline ui-1-check-circle-08'></i><span>Accept task</span></a><%}%>
        <%if(taskRow.Task_Status == "Accepted"){%><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-10 zcs-rounded-md zcs-no-underline ad-wide' href='#Report:My_Agent_Tasks?ID=<%=taskRow.ID%>&amp;zc_LoadIn=dialog'><i class='zc-li-outline media-1-button-play'></i><span>Start task</span></a><%}%>
        <%if(taskRow.Task_Status == "In Progress"){%>
        <a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-10 zcs-rounded-md zcs-no-underline ad-wide' href='#Form:Agent_Tasks?recLinkID=<%=taskRow.ID%>&amp;viewLinkName=My_Agent_Tasks&amp;zc_LoadIn=dialog'><i class='zc-li-outline files-2-doc'></i><span>Capture proof or failure reason</span></a>
        <a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-10 zcs-rounded-md zcs-no-underline' href='#Report:My_Agent_Tasks?ID=<%=taskRow.ID%>&amp;zc_LoadIn=dialog'><i class='zc-li-outline ui-1-check-circle-08'></i><span>Complete task</span></a>
        <a class='zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-10 zcs-rounded-md zcs-no-underline' href='#Report:My_Agent_Tasks?ID=<%=taskRow.ID%>&amp;zc_LoadIn=dialog'><i class='zc-li-outline ui-1-circle-remove'></i><span>Fail task</span></a>
        <%}%>
    </div>
</article>
<%
            taskCounter = taskCounter + 1;
        }
    }
}
if(taskCounter == 0)
{
%>
<div class='ad-empty zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center zcs-p-20'><i class='zc-li-outline ui-1-check-circle-08'></i><h3 class='zcs-font-18 zcs-font-medium zcs-mb-0'>No open tasks</h3><p class='zcs-font-13 zcs-color-secondary'>Assigned, accepted, and in-progress work will appear here.</p></div>
<%
}
%>
    </div>
</section>
<section class='zcs-card zcs-p-16 zcs-mt-8'>
    <div class='ad-section-head'><div><h2 class='zcs-font-20 zcs-font-semibold zcs-m-0'>Assigned manifest legs</h2><p class='zcs-font-13 zcs-color-secondary zcs-mt-4 zcs-mb-0'>One card per pickup, line-haul, transfer, or delivery leg.</p></div><a class='ad-link zcs-font-13 zcs-font-semibold' href='#Report:My_Assigned_Manifests'>Open report</a></div>
    <div class='ad-manifest-list'>
<%
manifestCounter = 0;
for each manifestRow in openManifestRows
{
    if(manifestCounter < 8)
    {
        manifestStatusClass = "zcs-badge-grey";
        if(manifestRow.Manifest_Status == "Ready")
        {
            manifestStatusClass = "zcs-badge-blue";
        }
        else if(manifestRow.Manifest_Status == "Dispatched")
        {
            manifestStatusClass = "zcs-badge-orange";
        }
        else if(manifestRow.Manifest_Status == "Arrived")
        {
            manifestStatusClass = "zcs-badge-green";
        }
        departureText = "Not planned";
        arrivalText = "Not planned";
        if(manifestRow.Planned_Departure != null){departureText = manifestRow.Planned_Departure.toString("dd-MMM-yyyy, hh:mm a") + " IST";}
        if(manifestRow.Planned_Arrival != null){arrivalText = manifestRow.Planned_Arrival.toString("dd-MMM-yyyy, hh:mm a") + " IST";}
        manifestActionText = "Open manifest";
        manifestActionIcon = "arrows-1-tail-right";
        if(manifestRow.Manifest_Status == "Ready")
        {
            manifestActionText = "Dispatch manifest";
            manifestActionIcon = "media-1-button-play";
        }
        else if(manifestRow.Manifest_Status == "Dispatched")
        {
            manifestActionText = "Record arrival";
            manifestActionIcon = "location-pin-copy";
        }
%>
<article class='zcs-card zcs-flex zcs-direction-column zcs-gap-10 zcs-p-16'>
    <div class='ad-manifest-head'><div><h3 class='zcs-font-18 zcs-font-semibold zcs-m-0'>Manifest <%=manifestRow.Manifest_Number%></h3><p class='zcs-font-13 zcs-color-secondary zcs-mt-4 zcs-mb-0'><%=manifestRow.Manifest_Type%> · <%=manifestRow.Transport_Mode%></p></div><span class='zcs-badge zcs-badge-filled-outline zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12 <%=manifestStatusClass%>'><%=manifestRow.Manifest_Status%></span></div>
    <div class='ad-route zcs-font-14 zcs-font-medium'><i class='zc-li-outline location-pin-copy zcs-color-tertiary'></i><span><%=manifestRow.Origin_Hub.Hub_Name%></span><i class='zc-li-outline arrows-1-tail-right zcs-color-theme'></i><span><%=manifestRow.Destination_Hub.Hub_Name%></span></div>
    <div class='zcs-font-13 zcs-color-secondary'><i class='zc-li-outline ui-2-time'></i> Depart <%=departureText%><br><i class='zc-li-outline ui-1-calendar-60'></i> Arrive <%=arrivalText%></div>
    <%if(ifnull(manifestRow.Vehicle_or_Carrier_Details,"") != ""){%><div class='zcs-font-13'><i class='zc-li-outline transport-delivery-fast'></i> <%=manifestRow.Vehicle_or_Carrier_Details%></div><%}%>
    <div class='ad-manifest-actions'><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-10 zcs-rounded-md zcs-no-underline zcs-w-full' href='#Report:My_Assigned_Manifests?ID=<%=manifestRow.ID%>&amp;zc_LoadIn=dialog'><i class='zc-li-outline <%=manifestActionIcon%>'></i><span><%=manifestActionText%></span></a></div>
</article>
<%
        manifestCounter = manifestCounter + 1;
    }
}
if(manifestCounter == 0)
{
%>
<div class='ad-empty zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center zcs-p-20'><i class='zc-li-outline transport-delivery-fast'></i><h3 class='zcs-font-18 zcs-font-medium zcs-mb-0'>No assigned manifest legs</h3><p class='zcs-font-13 zcs-color-secondary'>Open manifest work assigned to this agent will appear here.</p></div>
<%
}
%>
    </div>
</section>
</main>
<aside class='ad-side'>
<section class='zcs-card zcs-p-16'>
    <h2 class='zcs-font-18 zcs-font-semibold zcs-m-0'>Proof checklist</h2>
    <div class='zcs-fleet-trip-summary zcs-flex zcs-direction-column zcs-gap-16 zcs-mt-8'>
        <div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%if(inProgressCount > 0){%>50<%}else{%>100<%}%>%'></div></div>
        <ul class='zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0'>
            <li class='zcs-flex zcs-align-items-start zcs-gap-10 zcs-list-none'><i class='zc-li-outline files-2-doc zcs-color-theme'></i><span class='zcs-font-14'>Pickup: upload one proof file before completion.</span></li>
            <li class='zcs-flex zcs-align-items-start zcs-gap-10 zcs-list-none'><i class='zc-li-outline design-signature zcs-color-theme'></i><span class='zcs-font-14'>Delivery: enter recipient name and capture a proof file or signature.</span></li>
            <li class='zcs-flex zcs-align-items-start zcs-gap-10 zcs-list-none'><i class='zc-li-outline ui-3-alert zcs-color-theme'></i><span class='zcs-font-14'>Failure: enter a clear failure reason before using Fail Task.</span></li>
        </ul>
    </div>
</section>
<section class='zcs-card zcs-p-16'>
    <div class='ad-section-head'><h2 class='zcs-font-18 zcs-font-semibold zcs-m-0'>Recent completed activity</h2><a class='ad-link zcs-font-13 zcs-font-semibold' href='#Report:My_Agent_Tasks'>View all</a></div>
<%
recentRows = Agent_Tasks[Agent_User == loginEmail && Assigned_Agent == agentID && Task_Status == "Completed"] sort by Completed_On desc;
recentCounter = 0;
for each recentRow in recentRows
{
    if(recentCounter < 6)
    {
        completedText = "Completion time not recorded";
        if(recentRow.Completed_On != null){completedText = recentRow.Completed_On.toString("dd-MMM-yyyy, hh:mm a") + " IST";}
%>
<div class='ad-activity-item'>
    <div class='zcs-flex zcs-direction-column zcs-align-items-center'><span class='zcs-tl-dot zcs-rounded-half'></span><span class='zcs-tl-line'></span></div>
    <div class='ad-activity-content'><a class='ad-link zcs-font-14 zcs-font-semibold' href='#Report:My_Agent_Tasks?ID=<%=recentRow.ID%>&amp;zc_LoadIn=dialog'><%=recentRow.Task_Type%> <%=recentRow.Task_Number%></a><p class='zcs-font-12 zcs-color-secondary zcs-mt-4 zcs-mb-0'>Shipment <%=recentRow.Shipment.Shipment_Number%> · <%=completedText%></p></div>
</div>
<%
        recentCounter = recentCounter + 1;
    }
}
if(recentCounter == 0)
{
%>
<div class='ad-empty zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center'><i class='zc-li-outline ui-1-check-circle-08'></i><p class='zcs-font-14 zcs-color-secondary'>No completed activity yet.</p></div>
<%
}
%>
</section>
<section class='zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16'>
    <h2 class='zcs-font-18 zcs-font-semibold zcs-m-0'>Quick access</h2>
    <ul class='zcs-flex zcs-direction-column zcs-gap-10 zcs-p-0 zcs-m-0'>
        <li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary zcs-no-underline' href='#Report:My_Agent_Tasks'><i class='zc-li-outline design-todo'></i><span>Open assigned tasks</span></a></li>
        <li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary zcs-no-underline' href='#Report:Agent_Task_Calendar'><i class='zc-li-outline ui-1-calendar-60'></i><span>Open task calendar</span></a></li>
        <li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary zcs-no-underline' href='#Report:My_Assigned_Manifests'><i class='zc-li-outline transport-delivery-fast'></i><span>Open assigned manifests</span></a></li>
    </ul>
</section>
</aside>
</div>
<%
}
%>
</div></div>