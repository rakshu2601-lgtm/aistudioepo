<%
activeCustomers = Customers[Active == true && Onboarding_Status == "Active"].count();
pendingKYC = KYC_Document_Requests[Verification_Status == "Uploaded"].count();
shipmentsTransit = Shipment_Requests[Shipment_Status == "In Transit" || Shipment_Status == "At Hub" || Shipment_Status == "Out for Delivery"].count();
deliveriesToday = Shipment_Requests[Shipment_Status == "Delivered" && Delivered_On >= zoho.currentdate].count();
grossValue = ifnull(Shipment_Requests[ID != 0].sum(Gross_Amount),0);
netValue = ifnull(Shipment_Requests[ID != 0].sum(Net_Amount),0);
pendingCash = Loyalty_Redemptions[Redemption_Type == "Cash Value" && (Redemption_Status == "Requested" || Redemption_Status == "Approved")].count();
criticalAudit = Audit_Log[Severity == "Critical"].count();
failedTasks = Agent_Tasks[Task_Status == "Failed"].count();
itemExceptions = Manifest_Items[Item_Status == "Exception"].count();
criticalExceptions = criticalAudit + failedTasks + itemExceptions;
lateManifestCount = Manifests[Planned_Departure < zoho.currenttime && (Manifest_Status == "Draft" || Manifest_Status == "Ready")].count();
lateTaskCount = Agent_Tasks[Scheduled_At < zoho.currenttime && Task_Status != "Completed" && Task_Status != "Failed"].count();
loyaltyLiability = 0.0;
for each liabilityCustomer in Customers[Current_Points_Balance > 0]
{
	if(liabilityCustomer.Current_Loyalty_Program != null)
	{
		loyaltyLiability = loyaltyLiability + (liabilityCustomer.Current_Points_Balance * liabilityCustomer.Current_Loyalty_Program.Redemption_Value_Per_Point);
	}
}
retailCount = Customers[Customer_Type == "Retail"].count();
corporateCount = Customers[Customer_Type == "Corporate"].count();
wholesaleCount = Customers[Customer_Type == "Wholesale"].count();
customerTotal = retailCount + corporateCount + wholesaleCount;
retailPct = if(customerTotal > 0,(retailCount * 100.0 / customerTotal).round(1),0);
corporatePct = if(customerTotal > 0,(corporateCount * 100.0 / customerTotal).round(1),0);
wholesalePct = if(customerTotal > 0,(wholesaleCount * 100.0 / customerTotal).round(1),0);
newCount = Customers[Onboarding_Status == "New"].count();
pendingOnboardCount = Customers[Onboarding_Status == "Pending KYC"].count();
suspendedCount = Customers[Onboarding_Status == "Suspended" || Onboarding_Status == "Rejected"].count();
onboardTotal = newCount + pendingOnboardCount + activeCustomers + suspendedCount;
newPct = if(onboardTotal > 0,(newCount * 100.0 / onboardTotal).round(1),0);
pendingOnboardPct = if(onboardTotal > 0,(pendingOnboardCount * 100.0 / onboardTotal).round(1),0);
activePct = if(onboardTotal > 0,(activeCustomers * 100.0 / onboardTotal).round(1),0);
suspendedPct = if(onboardTotal > 0,(suspendedCount * 100.0 / onboardTotal).round(1),0);
requestedShip = Shipment_Requests[Shipment_Status == "Requested" || Shipment_Status == "Quoted" || Shipment_Status == "Confirmed"].count();
movementShip = Shipment_Requests[Shipment_Status == "Pickup Assigned" || Shipment_Status == "Picked Up" || Shipment_Status == "In Transit" || Shipment_Status == "At Hub" || Shipment_Status == "Delivery Assigned" || Shipment_Status == "Out for Delivery"].count();
deliveredShip = Shipment_Requests[Shipment_Status == "Delivered"].count();
cancelledShip = Shipment_Requests[Shipment_Status == "Cancelled"].count();
shipTotal = requestedShip + movementShip + deliveredShip + cancelledShip;
requestedPct = if(shipTotal > 0,(requestedShip * 100.0 / shipTotal).round(1),0);
movementPct = if(shipTotal > 0,(movementShip * 100.0 / shipTotal).round(1),0);
deliveredPct = if(shipTotal > 0,(deliveredShip * 100.0 / shipTotal).round(1),0);
cancelledPct = if(shipTotal > 0,(cancelledShip * 100.0 / shipTotal).round(1),0);
roadCount = Shipment_Requests[Transport_Mode == "Road"].count();
airCount = Shipment_Requests[Transport_Mode == "Air"].count();
railCount = Shipment_Requests[Transport_Mode == "Rail"].count();
seaCount = Shipment_Requests[Transport_Mode == "Sea"].count();
modeMax = roadCount;
if(airCount > modeMax){modeMax = airCount;}
if(railCount > modeMax){modeMax = railCount;}
if(seaCount > modeMax){modeMax = seaCount;}
if(modeMax == 0){modeMax = 1;}
roadPct = (roadCount * 100.0 / modeMax).round(0);
airPct = (airCount * 100.0 / modeMax).round(0);
railPct = (railCount * 100.0 / modeMax).round(0);
seaPct = (seaCount * 100.0 / modeMax).round(0);
rev30 = ifnull(Shipment_Requests[Delivered_On >= zoho.currentdate.subDay(30)].sum(Net_Amount),0);
rev60 = ifnull(Shipment_Requests[Delivered_On >= zoho.currentdate.subDay(60) && Delivered_On < zoho.currentdate.subDay(30)].sum(Net_Amount),0);
rev90 = ifnull(Shipment_Requests[Delivered_On >= zoho.currentdate.subDay(90) && Delivered_On < zoho.currentdate.subDay(60)].sum(Net_Amount),0);
rev120 = ifnull(Shipment_Requests[Delivered_On >= zoho.currentdate.subDay(120) && Delivered_On < zoho.currentdate.subDay(90)].sum(Net_Amount),0);
revMax = rev30;
if(rev60 > revMax){revMax = rev60;}
if(rev90 > revMax){revMax = rev90;}
if(rev120 > revMax){revMax = rev120;}
if(revMax == 0){revMax = 1;}
rev30Pct = (rev30 * 100.0 / revMax).round(0);
rev60Pct = (rev60 * 100.0 / revMax).round(0);
rev90Pct = (rev90 * 100.0 / revMax).round(0);
rev120Pct = (rev120 * 100.0 / revMax).round(0);
%>
<style>
/* zcs-global: page-scoped utility subset loaded once */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#f3f3f4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;--zcs-border-color:var(--zcs_tertiary_border_color);font-size:16px;line-height:1.5}
.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-end{align-items:flex-end}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-overflow-auto{overflow:auto}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-half{border-radius:50%}.zcs-gap-4{gap:4px}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-gap-20{gap:20px}.zcs-gap-24{gap:24px}.zcs-p-0{padding:0}.zcs-p-2{padding:2px}.zcs-p-8{padding:8px}.zcs-p-12{padding:12px}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-12{padding-top:12px;padding-bottom:12px}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:8px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-heading{line-height:1.25}.zcs-lh-body{line-height:1.5}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}
.admin-dashboard{background:var(--zcs-page-bg-color);padding:24px 30px;font-family:Arial,sans-serif;color:var(--zcs-primary-text-color)}.admin-header{padding:22px 24px;background:linear-gradient(115deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));border-radius:14px;color:var(--zcs_brand_foreground_color)}.admin-header h1{font-size:24px;margin:0 0 4px}.admin-header p{margin:0;opacity:.9}.asof{font-size:13px;white-space:nowrap}.dashboard-stack{display:flex;flex-direction:column;gap:20px;margin-top:20px}.kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.zcs-panel{border:1px solid var(--zcs-border-color);box-shadow:0 2px 8px #0000000a;background:var(--zcs-white-color);padding:16px;border-radius:12px}.zcs-panel-top{display:flex;align-items:center;gap:10px}.zcs-panel-icon-wrapper{width:40px;height:40px;display:flex;align-items:center;justify-content:center;border-radius:8px;background:#e8efff;color:#2a6ffc}.tone-green .zcs-panel-icon-wrapper{background:#e4fcf3;color:#147d58}.tone-yellow .zcs-panel-icon-wrapper{background:#fcf4e6;color:#8a5a09}.tone-red .zcs-panel-icon-wrapper{background:#fde3e6;color:#c62e43}.tone-violet .zcs-panel-icon-wrapper{background:#f1edff;color:#5c45ba}.kpi-value{font-size:22px;font-weight:700}.kpi-label{font-size:13px;color:var(--zcs-teritiary-text-color);margin:8px 0 0}.content-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:20px}.span-4{grid-column:span 4}.span-5{grid-column:span 5}.span-6{grid-column:span 6}.span-7{grid-column:span 7}.span-8{grid-column:span 8}.span-12{grid-column:span 12}.section-card{padding:18px;min-width:0}.section-title{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:16px}.section-title h2{font-size:17px;margin:0}.section-link{font-size:13px;color:var(--zcs_brand_color);font-weight:600}.chart-split{display:grid;grid-template-columns:1fr 1fr;gap:16px}.zcs-donut-chart-wrapper{display:flex;align-items:center;justify-content:center;gap:12px}.zcs-simple-donut-chart{width:150px;height:150px;border-radius:50%;background:conic-gradient(#fece56 0 calc(var(--a1)*1%),#36a2eb calc(var(--a1)*1%) calc((var(--a1) + var(--a2))*1%),#ff6283 calc((var(--a1) + var(--a2))*1%) calc((var(--a1) + var(--a2) + var(--a3))*1%),#28cc97 calc((var(--a1) + var(--a2) + var(--a3))*1%) 100%);position:relative}.zcs-simple-donut-chart:after{content:'';position:absolute;inset:25px;border-radius:50%;background:var(--zcs-white-color)}.zcs-donut-chart-name{z-index:1;position:absolute;text-align:center;font-size:14px;line-height:1.2}.zcs-legend-wrapper ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px}.zcs-legend-wrapper li{font-size:13px;display:flex;align-items:center;gap:7px}.legend-dot{width:10px;height:10px;border-radius:50%;display:inline-block}.l1{background:#fece56}.l2{background:#36a2eb}.l3{background:#ff6283}.l4{background:#28cc97}.bars{display:flex;flex-direction:column;gap:12px}.bar-row{display:grid;grid-template-columns:105px 1fr 64px;gap:10px;align-items:center;font-size:13px}.bar-track{height:10px;background:#edf0f6;border-radius:6px;overflow:hidden}.bar-fill{height:100%;border-radius:6px;background:var(--zcs_brand_color)}.bar-fill.alt{background:#ff7300}.bar-fill.green{background:#179e6c}.bar-fill.red{background:#fe455d}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:var(--zcs-white-color);overflow:auto;border-radius:6px}.zcs-table-wrapper table{width:100%;border-collapse:collapse;line-height:normal}.zcs-table-wrapper th{background:#f9fafe;white-space:nowrap;font-weight:600}.zcs-table-wrapper th,.zcs-table-wrapper td{padding:10px 12px;text-align:left;font-size:13px;border-top:1px solid var(--zcs-border-color);vertical-align:middle}.zcs-table-wrapper thead th{border-top:0}.zcs-table-wrapper tbody tr:hover td{background:#f9fafe}.zcs-badge{width:auto;border:1px solid;display:inline-flex;align-items:center;gap:6px;border-radius:4px;padding:2px 8px;font-size:12px;white-space:nowrap}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#126f50}.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#a91931}.zcs-badge-yellow{background:#fcf4e6;border-color:#d59412;color:#80560b}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#1749a4}.alert-list,.activity-list{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px}.alert-item,.activity-item{border:1px solid var(--zcs-border-color);border-radius:8px;padding:11px 12px;display:flex;gap:10px;align-items:flex-start}.alert-item>i{font-size:18px;color:#c62e43;margin-top:2px}.activity-item>i{font-size:18px;color:var(--zcs_brand_color);margin-top:2px}.item-title{font-size:13px;font-weight:600}.item-meta{font-size:12px;color:var(--zcs-teritiary-text-color);margin-top:3px}.hub-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.hub-card{padding:12px;border:1px solid var(--zcs-border-color);border-radius:8px}.hub-number{font-size:20px;font-weight:700}.zcs-quick-actions-wrapper{padding:16px}.quick-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;list-style:none;padding:0;margin:0}.zcs-quick-action-item{border:1px solid var(--zcs-border-color);border-radius:8px}.zcs-quick-action-link{display:flex;align-items:center;gap:9px;padding:11px 12px;color:var(--zcs-primary-text-color);font-size:13px}.zcs-quick-action-item:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover a{color:var(--zcs_brand_color)}.empty{padding:18px;text-align:center;color:var(--zcs-teritiary-text-color);font-size:13px}.money-note{font-size:11px;color:var(--zcs-teritiary-text-color);margin-top:4px}.zcs-button{min-height:36px;border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs_brand_color);padding:8px 13px;border-radius:6px;display:inline-flex;align-items:center;gap:7px;font-size:13px}.zcs-button:hover,.zcs-button:focus{background:var(--zcs_component_hover_color);outline:2px solid var(--zcs_brand_color);outline-offset:2px}
@media(max-width:1180px){.kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.span-4,.span-5,.span-6,.span-7,.span-8{grid-column:span 6}.quick-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:820px){.admin-dashboard{padding:16px}.admin-header{align-items:flex-start;flex-direction:column}.content-grid{grid-template-columns:1fr}.span-4,.span-5,.span-6,.span-7,.span-8,.span-12{grid-column:1}.chart-split{grid-template-columns:1fr}.quick-grid{grid-template-columns:1fr}.hub-grid{grid-template-columns:1fr}}
</style>
<div class='admin-dashboard zcs-box-border'>
  <header class='admin-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16'>
    <div><h1>Organization command centre</h1><p>Onboarding, operations, finance, loyalty and risk across India</p></div>
    <div class='asof'><i class='zc-li-outline ui-2-time'></i> As of <%=zoho.currenttime.toString("dd-MMM-yyyy HH:mm")%> IST</div>
  </header>
  <main class='dashboard-stack'>
    <section class='kpi-grid' aria-label='Organization KPIs'>
      <div class='zcs-panel tone-green'><div class='zcs-panel-top'><div class='zcs-panel-icon-wrapper'><i class='zc-li-outline users-single-05'></i></div><div class='kpi-value'><%=activeCustomers%></div></div><p class='kpi-label'>Active customers</p></div>
      <div class='zcs-panel tone-yellow'><div class='zcs-panel-top'><div class='zcs-panel-icon-wrapper'><i class='zc-li-outline files-2-doc'></i></div><div class='kpi-value'><%=pendingKYC%></div></div><p class='kpi-label'>Pending KYC reviews</p></div>
      <div class='zcs-panel'><div class='zcs-panel-top'><div class='zcs-panel-icon-wrapper'><i class='zc-li-outline arrows-4-restore'></i></div><div class='kpi-value'><%=shipmentsTransit%></div></div><p class='kpi-label'>Shipments in transit</p></div>
      <div class='zcs-panel tone-green'><div class='zcs-panel-top'><div class='zcs-panel-icon-wrapper'><i class='zc-li-outline ui-1-check-circle-08'></i></div><div class='kpi-value'><%=deliveriesToday%></div></div><p class='kpi-label'>Deliveries today</p></div>
      <div class='zcs-panel tone-violet'><div class='zcs-panel-top'><div class='zcs-panel-icon-wrapper'><i class='zc-li-outline business-money-coins'></i></div><div><div class='kpi-value'>₹<%=grossValue.toString("##,##,###.00")%></div><div class='money-note'>Net ₹<%=netValue.toString("##,##,###.00")%></div></div></div><p class='kpi-label'>Gross / net shipment value</p></div>
      <div class='zcs-panel tone-yellow'><div class='zcs-panel-top'><div class='zcs-panel-icon-wrapper'><i class='zc-li-outline business-money-bag'></i></div><div class='kpi-value'>₹<%=loyaltyLiability.toString("##,##,###.00")%></div></div><p class='kpi-label'>Outstanding loyalty liability</p></div>
      <div class='zcs-panel tone-yellow'><div class='zcs-panel-top'><div class='zcs-panel-icon-wrapper'><i class='zc-li-outline arrows-4-share-66'></i></div><div class='kpi-value'><%=pendingCash%></div></div><p class='kpi-label'>Pending cash redemptions</p></div>
      <div class='zcs-panel tone-red'><div class='zcs-panel-top'><div class='zcs-panel-icon-wrapper'><i class='zc-li-outline ui-3-alert'></i></div><div class='kpi-value'><%=criticalExceptions%></div></div><p class='kpi-label'>Critical exceptions</p></div>
    </section>

    <section class='content-grid'>
      <article class='zcs-card section-card span-6'>
        <div class='section-title'><h2>Customer distribution</h2><a class='section-link' href='#Report:All_Customers'>Open customers</a></div>
        <div class='chart-split'>
          <div class='zcs-donut-chart-wrapper'><div class='zcs-simple-donut-chart zcs-flex zcs-align-items-center zcs-justify-center' style='--a1:<%=retailPct%>;--a2:<%=corporatePct%>;--a3:<%=wholesalePct%>;--a4:0'><div class='zcs-donut-chart-name'><strong><%=customerTotal%></strong><br>customers</div></div><div class='zcs-legend-wrapper'><ul><li><span class='legend-dot l1'></span>Retail <strong><%=retailCount%></strong></li><li><span class='legend-dot l2'></span>Corporate <strong><%=corporateCount%></strong></li><li><span class='legend-dot l3'></span>Wholesale <strong><%=wholesaleCount%></strong></li></ul></div></div>
          <div class='zcs-donut-chart-wrapper'><div class='zcs-simple-donut-chart zcs-flex zcs-align-items-center zcs-justify-center' style='--a1:<%=newPct%>;--a2:<%=pendingOnboardPct%>;--a3:<%=suspendedPct%>;--a4:<%=activePct%>'><div class='zcs-donut-chart-name'><strong><%=onboardTotal%></strong><br>onboarded</div></div><div class='zcs-legend-wrapper'><ul><li><span class='legend-dot l1'></span>New <strong><%=newCount%></strong></li><li><span class='legend-dot l2'></span>Pending KYC <strong><%=pendingOnboardCount%></strong></li><li><span class='legend-dot l3'></span>Restricted <strong><%=suspendedCount%></strong></li><li><span class='legend-dot l4'></span>Active <strong><%=activeCustomers%></strong></li></ul></div></div>
        </div>
      </article>

      <article class='zcs-card section-card span-6'>
        <div class='section-title'><h2>Shipment status and mode</h2><a class='section-link' href='#Report:Shipment_Status_Board'>Open operations</a></div>
        <div class='chart-split'>
          <div class='zcs-donut-chart-wrapper'><div class='zcs-simple-donut-chart zcs-flex zcs-align-items-center zcs-justify-center' style='--a1:<%=requestedPct%>;--a2:<%=movementPct%>;--a3:<%=cancelledPct%>;--a4:<%=deliveredPct%>'><div class='zcs-donut-chart-name'><strong><%=shipTotal%></strong><br>shipments</div></div><div class='zcs-legend-wrapper'><ul><li><span class='legend-dot l1'></span>Pre-transit <strong><%=requestedShip%></strong></li><li><span class='legend-dot l2'></span>Moving <strong><%=movementShip%></strong></li><li><span class='legend-dot l3'></span>Cancelled <strong><%=cancelledShip%></strong></li><li><span class='legend-dot l4'></span>Delivered <strong><%=deliveredShip%></strong></li></ul></div></div>
          <div class='bars'><div class='bar-row'><span>Road</span><div class='bar-track'><div class='bar-fill' style='width:<%=roadPct%>%'></div></div><strong><%=roadCount%></strong></div><div class='bar-row'><span>Air</span><div class='bar-track'><div class='bar-fill alt' style='width:<%=airPct%>%'></div></div><strong><%=airCount%></strong></div><div class='bar-row'><span>Rail</span><div class='bar-track'><div class='bar-fill green' style='width:<%=railPct%>%'></div></div><strong><%=railCount%></strong></div><div class='bar-row'><span>Sea</span><div class='bar-track'><div class='bar-fill red' style='width:<%=seaPct%>%'></div></div><strong><%=seaCount%></strong></div></div>
        </div>
      </article>

      <article class='zcs-card section-card span-7'>
        <div class='section-title'><h2>Net revenue trend</h2><a class='section-link' href='#Report:All_Shipments'>Shipment financials</a></div>
        <div class='bars'><div class='bar-row'><span>Last 30 days</span><div class='bar-track'><div class='bar-fill green' style='width:<%=rev30Pct%>%'></div></div><strong>₹<%=rev30.toString("##,##,###")%></strong></div><div class='bar-row'><span>31–60 days</span><div class='bar-track'><div class='bar-fill' style='width:<%=rev60Pct%>%'></div></div><strong>₹<%=rev60.toString("##,##,###")%></strong></div><div class='bar-row'><span>61–90 days</span><div class='bar-track'><div class='bar-fill alt' style='width:<%=rev90Pct%>%'></div></div><strong>₹<%=rev90.toString("##,##,###")%></strong></div><div class='bar-row'><span>91–120 days</span><div class='bar-track'><div class='bar-fill red' style='width:<%=rev120Pct%>%'></div></div><strong>₹<%=rev120.toString("##,##,###")%></strong></div></div>
      </article>
      <article class='zcs-card section-card span-5'>
        <div class='section-title'><h2>Hub throughput</h2><a class='section-link' href='#Report:Hub_Map'>Hub map</a></div><div class='hub-grid'>
        <% for each hubRec in Hubs[Status == "Active"] sort by Hub_Name asc range from 0 to 5 { hubLoad = Shipment_Requests[Current_Hub == hubRec.ID && Shipment_Status != "Delivered" && Shipment_Status != "Cancelled"].count(); %>
          <div class='hub-card'><div class='hub-number'><%=hubLoad%></div><div class='item-title'><%=hubRec.Hub_Name%></div><div class='item-meta'><%=hubRec.Hub_Code%> · open at hub</div></div>
        <% } %></div>
      </article>

      <article class='zcs-card section-card span-7'>
        <div class='section-title'><h2>KYC review queue</h2><a class='zcs-button' href='#Report:KYC_Review_Queue'><i class='zc-li-outline files-2-doc'></i> Review all</a></div>
        <div class='zcs-table-wrapper'><table><thead><tr><th>Customer</th><th>Document</th><th>Uploaded</th><th>Status</th></tr></thead><tbody>
        <% kycRows = KYC_Document_Requests[Verification_Status == "Uploaded"] sort by Uploaded_On asc range from 0 to 5; if(kycRows.count() == 0){ %><tr><td colspan='4' class='empty'>No uploaded documents are awaiting review.</td></tr><% } else { for each kycRow in kycRows { %>
          <tr><td><%=kycRow.Customer.Customer_Name.first_name%></td><td><%=kycRow.Requested_Document_Name%></td><td><%=if(kycRow.Uploaded_On != null,kycRow.Uploaded_On.toString("dd-MMM-yyyy HH:mm"),"Not recorded")%></td><td><span class='zcs-badge zcs-badge-blue'><i class='zc-li-outline loader-dots-06'></i> Awaiting review</span></td></tr>
        <% } } %></tbody></table></div>
      </article>
      <article class='zcs-card section-card span-5'>
        <div class='section-title'><h2>Late manifests and tasks</h2><span class='zcs-badge zcs-badge-red'><i class='zc-li-outline ui-3-alert'></i> <%=lateManifestCount + lateTaskCount%> overdue</span></div>
        <ul class='alert-list'>
        <% for each lateManifest in Manifests[Planned_Departure < zoho.currenttime && (Manifest_Status == "Draft" || Manifest_Status == "Ready")] sort by Planned_Departure asc range from 0 to 3 { %><li class='alert-item'><i class='zc-li-outline transportation-truck-front'></i><div><div class='item-title'>Manifest <%=lateManifest.Manifest_Number%> has not departed</div><div class='item-meta'><%=lateManifest.Origin_Hub.Hub_Name%> to <%=lateManifest.Destination_Hub.Hub_Name%> · planned <%=lateManifest.Planned_Departure.toString("dd-MMM-yyyy HH:mm")%></div></div></li><% } %>
        <% for each lateTask in Agent_Tasks[Scheduled_At < zoho.currenttime && Task_Status != "Completed" && Task_Status != "Failed"] sort by Scheduled_At asc range from 0 to 3 { %><li class='alert-item'><i class='zc-li-outline ui-2-time'></i><div><div class='item-title'>Task <%=lateTask.Task_Number%> is overdue</div><div class='item-meta'><%=lateTask.Task_Type%> · <%=lateTask.Hub.Hub_Name%> · <%=lateTask.Scheduled_At.toString("dd-MMM-yyyy HH:mm")%></div></div></li><% } %>
        <% if(lateManifestCount + lateTaskCount == 0){ %><li class='empty'>No overdue manifests or open agent tasks.</li><% } %>
        </ul>
      </article>

      <article class='zcs-card section-card span-6'>
        <div class='section-title'><h2>Top customers by shipment value</h2><a class='section-link' href='#Report:All_Shipments'>Open shipments</a></div><div class='zcs-table-wrapper'><table><thead><tr><th>Customer</th><th>Shipments</th><th>Net value</th><th>Lifetime points</th></tr></thead><tbody>
        <% shipmentValueRows = 0; for each valueCustomer in Customers[ID != 0] { customerShipmentCount = Shipment_Requests[Customer == valueCustomer.ID].count(); customerNetValue = ifnull(Shipment_Requests[Customer == valueCustomer.ID].sum(Net_Amount),0); if(customerShipmentCount > 0) { shipmentValueRows = shipmentValueRows + 1; %><tr><td><%=valueCustomer.Customer_Name.first_name%></td><td><%=customerShipmentCount%></td><td>₹<%=customerNetValue.toString("##,##,###.00")%></td><td><%=valueCustomer.Overall_Points_Earned.toString("##,##,###")%></td></tr><% } } if(shipmentValueRows == 0){ %><tr><td colspan='4' class='empty'>No customer shipment value is available.</td></tr><% } %>
        </tbody></table></div>
      </article>
      <article class='zcs-card section-card span-6'>
        <div class='section-title'><h2>Top customers by points</h2><a class='section-link' href='#Report:Loyalty_Ledger'>Loyalty ledger</a></div><div class='zcs-table-wrapper'><table><thead><tr><th>Customer</th><th>Type</th><th>Lifetime</th><th>Balance</th></tr></thead><tbody>
        <% for each topCustomer in Customers[ID != 0] sort by Overall_Points_Earned desc range from 0 to 5 { %><tr><td><%=topCustomer.Customer_Name.first_name%></td><td><%=topCustomer.Customer_Type%></td><td><%=topCustomer.Overall_Points_Earned.toString("##,##,###")%></td><td><strong><%=topCustomer.Current_Points_Balance.toString("##,##,###")%></strong></td></tr><% } %>
        </tbody></table></div>
      </article>

      <article class='zcs-card section-card span-8'>
        <div class='section-title'><h2>Agent workload</h2><a class='section-link' href='#Report:Agent_Task_Board'>Task board</a></div><div class='zcs-table-wrapper'><table><thead><tr><th>Agent</th><th>Hub</th><th>Availability</th><th>Assigned</th><th>In progress</th><th>Completed today</th></tr></thead><tbody>
        <% for each agentRec in Employees[Employee_Type == "Agent" && Active == true] range from 0 to 7 { assignedCount = Agent_Tasks[Assigned_Agent == agentRec.ID && Task_Status == "Assigned"].count(); progressCount = Agent_Tasks[Assigned_Agent == agentRec.ID && (Task_Status == "Accepted" || Task_Status == "In Progress")].count(); completedCount = Agent_Tasks[Assigned_Agent == agentRec.ID && Task_Status == "Completed" && Completed_On >= zoho.currentdate].count(); badgeClass = if(agentRec.Availability_Status == "Available","zcs-badge-green",if(agentRec.Availability_Status == "Inactive" || agentRec.Availability_Status == "Off Duty","zcs-badge-red","zcs-badge-yellow")); %><tr><td><%=agentRec.Employee_Name.first_name%></td><td><%=if(agentRec.Hub != null,agentRec.Hub.Hub_Name,"Unassigned")%></td><td><span class='zcs-badge <%=badgeClass%>'><i class='zc-li-outline users-single-05'></i> <%=agentRec.Availability_Status%></span></td><td><%=assignedCount%></td><td><%=progressCount%></td><td><%=completedCount%></td></tr><% } %>
        </tbody></table></div>
      </article>
      <article class='zcs-card section-card span-4'>
        <div class='section-title'><h2>Recent loyalty adjustments</h2><a class='section-link' href='#Report:Loyalty_Ledger'>Open ledger</a></div><ul class='activity-list'>
        <% adjustments = Loyalty_Transactions[Transaction_Type == "Adjust" || Transaction_Type == "Reverse" || Transaction_Type == "Expire"] sort by Transaction_Date desc range from 0 to 5; if(adjustments.count() == 0){ %><li class='empty'>No recent adjustments, reversals or expiry entries.</li><% } else { for each adjustment in adjustments { %><li class='activity-item'><i class='zc-li-outline business-money-coins'></i><div><div class='item-title'><%=adjustment.Transaction_Type%> · <%=adjustment.Points.toString("##,##,###")%> points</div><div class='item-meta'><%=adjustment.Customer.Customer_Name.first_name%> · <%=adjustment.Transaction_Date.toString("dd-MMM-yyyy HH:mm")%></div></div></li><% } } %></ul>
      </article>

      <article class='zcs-card section-card span-7'>
        <div class='section-title'><h2>Recent audit activity</h2><a class='section-link' href='#Report:Audit_Trail'>Audit trail</a></div><ul class='activity-list'>
        <% auditRows = Audit_Log[ID != 0] sort by Event_Time desc range from 0 to 6; if(auditRows.count() == 0){ %><li class='empty'>No audit activity has been recorded.</li><% } else { for each auditRow in auditRows { auditBadge = if(auditRow.Severity == "Critical","zcs-badge-red",if(auditRow.Severity == "Warning","zcs-badge-yellow","zcs-badge-blue")); %><li class='activity-item'><i class='zc-li-outline design-2-ruler-pencil'></i><div class='zcs-col-common'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><div class='item-title'><%=auditRow.Action%> · <%=auditRow.Entity_Type%></div><span class='zcs-badge <%=auditBadge%>'><%=auditRow.Severity%></span></div><div class='item-meta'><%=auditRow.User_Email%> · <%=auditRow.Event_Time.toString("dd-MMM-yyyy HH:mm")%></div></div></li><% } } %></ul>
      </article>
      <aside class='span-5'>
        <div class='zcs-quick-actions-wrapper zcs-card'><div class='section-title'><h2>Quick actions</h2></div><ul class='quick-grid'>
          <li class='zcs-quick-action-item'><a class='zcs-quick-action-link' href='#Form:Customers?zc_LoadIn=dialog'><i class='zc-li-outline ui-1-simple-add'></i><span>Add customer</span></a></li>
          <li class='zcs-quick-action-item'><a class='zcs-quick-action-link' href='#Report:Rate_Matrix'><i class='zc-li-outline business-money-coins'></i><span>Configure rates</span></a></li>
          <li class='zcs-quick-action-item'><a class='zcs-quick-action-link' href='#Form:Loyalty_Programs?zc_LoadIn=dialog'><i class='zc-li-outline business-money-bag'></i><span>Configure programs</span></a></li>
          <li class='zcs-quick-action-item'><a class='zcs-quick-action-link' href='#Report:KYC_Review_Queue'><i class='zc-li-outline files-2-doc'></i><span>Review KYC</span></a></li>
          <li class='zcs-quick-action-item'><a class='zcs-quick-action-link' href='#Form:Manifests?zc_LoadIn=dialog'><i class='zc-li-outline transportation-truck-front'></i><span>Create manifest</span></a></li>
          <li class='zcs-quick-action-item'><a class='zcs-quick-action-link' href='#Report:All_Shipments'><i class='zc-li-outline arrows-1-tail-right'></i><span>Operational reports</span></a></li>
        </ul></div>
      </aside>
    </section>
  </main>
</div>