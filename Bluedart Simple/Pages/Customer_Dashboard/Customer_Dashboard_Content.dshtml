<%
loginEmail = zoho.loginuserid;
customerRecords = Customers[Customer_Email == loginEmail || Portal_User == loginEmail];
%>
<style>
/* ===== zcs-global.css (single page include; utility subset used by this page) ===== */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-page-bg-color:#f3f3f4;--zcs-primary-btn-color:var(--zcs_brand_color);--zcs-primary-btn-text-color:var(--zcs_brand_foreground_color);font-size:16px;line-height:1.5}
.zcs-row,.zcs-flex{display:flex}.zcs-row{flex-wrap:wrap}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-row-wrap{flex-wrap:wrap}.zcs-no-shrink{flex-shrink:0}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-overflow-auto{overflow:auto}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-no-underline{text-decoration:none}.zcs-cursor-pointer{cursor:pointer}.zcs-list-none{list-style:none}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-white{color:#fff}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-m-0{margin:0}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mt-0{margin-top:0}.zcs-mt-5{margin-top:.3125rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mb-0{margin-bottom:0}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-p-0{padding:0}.zcs-p-2{padding:.125rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-60{padding-left:3.75rem;padding-right:3.75rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-15{gap:.9375rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-gap-32{gap:2rem}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-card{background:var(--zcs-white-color);border:1px solid #e1e4ea;border-radius:12px}
.zcs-col-2{flex:0 0 16.6667%;max-width:16.6667%}.zcs-col-3{flex:0 0 25%;max-width:25%}.zcs-col-4{flex:0 0 33.3333%;max-width:33.3333%}.zcs-col-5{flex:0 0 41.6667%;max-width:41.6667%}.zcs-col-6{flex:0 0 50%;max-width:50%}.zcs-col-7{flex:0 0 58.3333%;max-width:58.3333%}.zcs-col-8{flex:0 0 66.6667%;max-width:66.6667%}.zcs-col-10{flex:0 0 83.3333%;max-width:83.3333%}.zcs-col-12{flex:0 0 100%;max-width:100%}
/* ZCS: card-profile-card */
.zcs-avatar{width:var(--zcs-avatar-size);height:var(--zcs-avatar-size);background:var(--zcs_brand_color);border-radius:var(--zcs-avatar-radius)}.zcs-avatar .zcs-avatar-img{border-radius:inherit;object-fit:cover}
/* ZCS: badge-badge-with-icon */
.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-green{background:#e4fcf3;border-color:#147a56;color:#116b4c}.zcs-badge-red{background:#fde3e6;border-color:#b42335;color:#9d1d2d}.zcs-badge-yellow{background:#fcf4e6;border-color:#9a6508;color:#744b04}.zcs-badge-blue{background:#e8efff;border-color:#245fca;color:#174caa}.zcs-badge-grey{background:#eceef1;border-color:#5f6670;color:#3f454d}.zcs-badge-orange{background:#fff0e8;border-color:#b94d0b;color:#8e3906}
/* ZCS: progress-bar-range-bar-with-texts / card-fleets-performance-metrics */
.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color,#e6e9ef)}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}
/* ZCS: table-simple-table */
.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper th{background:#f7f8fb;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tbody tr:first-child td{border-top-color:transparent}.zcs-table-wrapper tbody tr:hover td{background:#f7f8fb}
/* ZCS: timeline-simple-timeline */
.zcs-tl-indicator{width:60px;left:16.6667%}.zcs-tl-dot{width:12px;height:12px;background:var(--zcs_brand_color);border:1px solid #fff;box-shadow:0 2px 6px #c4dee4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:"";display:flex;position:absolute;width:1px;height:calc(100% + 32px);background:#d5d9df;top:5px}
/* ZCS: banner-outline-banner-with-icon */
.zcs-outline-toast{border:1px solid}.zcs-warning-toast{background:#fef4e5;border-color:#9a6508;color:#663c01}.zcs-info-toast{background:#e4f6fd;border-color:#0875a5;color:#024361}
/* ZCS: quick-actions-card-type-quick-actions */
.zcs-quick-action-item{list-style:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}
/* Dashboard composition */
*{box-sizing:border-box}.cd-shell{background:var(--zcs-page-bg-color);min-height:100%;padding:20px;color:var(--zcs-primary-text-color)}.cd-container{max-width:1440px;margin:0 auto}.cd-grid{display:grid;gap:16px}.cd-hero-grid{grid-template-columns:minmax(0,2fr) minmax(280px,1fr)}.cd-kpis{grid-template-columns:repeat(4,minmax(0,1fr))}.cd-two{grid-template-columns:repeat(2,minmax(0,1fr))}.cd-main{grid-template-columns:minmax(0,2fr) minmax(300px,1fr)}.cd-span-2{grid-column:span 2}.cd-section{margin-top:16px}.cd-profile{min-height:100%}.cd-initials{color:var(--zcs_brand_foreground_color);font-weight:700;font-size:22px}.cd-profile-main{display:flex;align-items:flex-start;gap:16px}.cd-profile-details{min-width:0;flex:1}.cd-badges{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.cd-meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 18px;margin-top:16px}.cd-meta-item{display:flex;gap:8px;align-items:flex-start;min-width:0}.cd-meta-item i{margin-top:3px;color:var(--zcs_brand_color)}.cd-address{word-break:break-word}.cd-kpi{height:100%;min-height:128px}.cd-kpi-top{display:flex;justify-content:space-between;align-items:flex-start}.cd-kpi-icon{width:40px;height:40px;border-radius:10px;background:var(--zcs_brand_light_color,#e8efff);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;font-size:20px}.cd-kpi-value{font-variant-numeric:tabular-nums}.cd-muted{color:var(--zcs-teritiary-text-color)}.cd-tier-grid{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:start}.cd-tier-name{font-size:26px;font-weight:700;color:var(--zcs_brand_color)}.cd-value-box{background:#f7f8fb;border:1px solid var(--zcs_tertiary_border_color);padding:12px;border-radius:8px;text-align:right}.cd-actions ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.cd-action-disabled{opacity:.58;cursor:not-allowed}.cd-action-disabled:hover{border-color:#e1e4ea!important}.cd-action-disabled .zcs-quick-action-link{color:var(--zcs-teritiary-text-color)!important}.cd-action-note{display:block;font-size:12px;margin-top:3px;color:var(--zcs-teritiary-text-color)}.cd-card-header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px}.cd-card-header a{color:var(--zcs_brand_color);font-size:14px}.cd-shipment{margin-bottom:12px}.cd-shipment:last-child{margin-bottom:0}.cd-shipment-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.cd-route{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:10px;margin-top:12px}.cd-route-point{min-width:0}.cd-route-point:last-child{text-align:right}.cd-route-line{color:var(--zcs_brand_color)}.cd-timeline-compact{margin-top:16px}.cd-timeline-compact .zcs-tl-time{font-size:12px}.cd-timeline-compact .zcs-tl-content{padding-left:60px}.cd-timeline-compact .zcs-tl-indicator{left:16.6667%}.cd-redemption-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.cd-summary-box{background:#f7f8fb;border:1px solid var(--zcs_tertiary_border_color);padding:12px;border-radius:8px}.cd-summary-box strong{display:block;font-size:20px}.cd-link{color:var(--zcs_brand_color);text-decoration:none}.cd-link:hover{text-decoration:underline}.cd-primary-link{background:var(--zcs-primary-btn-color);color:var(--zcs-primary-btn-text-color);border:1px solid var(--zcs-primary-btn-color);padding:9px 13px;border-radius:7px;display:inline-flex;align-items:center;gap:7px;text-decoration:none}.cd-primary-link:hover{filter:brightness(.94)}.cd-empty{min-height:120px}.cd-empty-icon{font-size:28px;color:var(--zcs-teritiary-text-color)}.cd-report-links{display:flex;flex-wrap:wrap;gap:8px}.cd-report-links a{border:1px solid var(--zcs_tertiary_border_color);background:#fff;color:var(--zcs-primary-text-color);padding:8px 11px;border-radius:6px;text-decoration:none}.cd-report-links a:hover{border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.cd-notfound{max-width:720px;margin:60px auto;text-align:center}.cd-table-points-positive{color:#116b4c;font-weight:600}.cd-table-points-negative{color:#9d1d2d;font-weight:600}
@media(max-width:1100px){.cd-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.cd-main{grid-template-columns:1fr}.cd-hero-grid{grid-template-columns:1fr}.cd-actions ul{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:768px){.cd-shell{padding:12px}.cd-two,.cd-actions ul{grid-template-columns:1fr}.cd-meta{grid-template-columns:1fr}.cd-redemption-list{grid-template-columns:1fr}.cd-profile-main{flex-direction:column}.cd-route{grid-template-columns:1fr}.cd-route-line{transform:rotate(90deg);justify-self:center}.cd-route-point:last-child{text-align:left}.zcs-tl-li{flex-direction:column}.cd-timeline-compact .zcs-tl-indicator{left:0}.cd-timeline-compact .zcs-tl-time{text-align:left;padding-left:60px;margin-bottom:8px}.cd-timeline-compact .zcs-tl-content{padding-left:60px}.cd-table-hide-mobile{display:none}}
@media(max-width:520px){.cd-kpis{grid-template-columns:1fr}.cd-tier-grid{grid-template-columns:1fr}.cd-value-box{text-align:left}.cd-shipment-head{flex-direction:column}}
</style>

<div class='cd-shell'>
<div class='cd-container'>
<%
if(customerRecords.count() == 0)
{
%>
<div class='zcs-card zcs-p-24 cd-notfound'>
    <i class='cd-empty-icon zc-li-outline users-1-single-02'></i>
    <h2 class='zcs-font-24 zcs-font-semibold zcs-color-primary'>Customer profile not found</h2>
    <p class='zcs-font-14 zcs-color-secondary'>No customer record matches <%=loginEmail%>. Contact support to link your portal account before using this dashboard.</p>
</div>
<%
}
else
{
    customer = customerRecords;
    customerID = customer.ID;
    firstName = ifnull(customer.Customer_Name.first_name,"");
    lastName = ifnull(customer.Customer_Name.last_name,"");
    fullName = (firstName + " " + lastName).trim();
    if(fullName == "")
    {
        fullName = ifnull(customer.Company_Name,"Customer");
    }
    initialText = firstName.left(1) + lastName.left(1);
    if(initialText == "")
    {
        initialText = fullName.left(1);
    }
    customerType = ifnull(customer.Customer_Type,"Retail");
    onboardingStatus = ifnull(customer.Onboarding_Status,"New");
    kycStatus = ifnull(customer.KYC_Status,"Not Required");
    isBusiness = customerType == "Corporate" || customerType == "Wholesale";
    shipmentAllowed = isBusiness == false || onboardingStatus == "Active";
    overallPoints = ifnull(customer.Overall_Points_Earned,0);
    currentPoints = ifnull(customer.Current_Points_Balance,0);
    overallPointsText = overallPoints.toString("##,##,##0");
    currentPointsText = currentPoints.toString("##,##,##0");
    activeShipments = Shipment_Requests[Customer == customerID && Shipment_Status != "Delivered" && Shipment_Status != "Cancelled"];
    deliveredShipments = Shipment_Requests[Customer == customerID && Shipment_Status == "Delivered"];
    activeCount = activeShipments.count();
    deliveredCount = deliveredShipments.count();
    currentProgram = Loyalty_Programs[ID == customer.Current_Loyalty_Program];
    tierName = "Member";
    pointValueRate = 0;
    minimumRedemption = 0;
    currentTierMin = 0;
    if(currentProgram.count() > 0)
    {
        tierName = currentProgram.Tier_Name;
        pointValueRate = ifnull(currentProgram.Redemption_Value_Per_Point,0);
        minimumRedemption = ifnull(currentProgram.Minimum_Redemption_Points,0);
        currentTierMin = ifnull(currentProgram.Min_Lifetime_Points,0);
    }
    nextPrograms = Loyalty_Programs[Customer_Type == customerType && Active == true && Min_Lifetime_Points > overallPoints] sort by Min_Lifetime_Points asc;
    nextTierName = "Top tier reached";
    nextTierPoints = overallPoints;
    pointsToNext = 0;
    tierProgress = 100;
    for each nextProgram in nextPrograms
    {
        if(nextTierName == "Top tier reached")
        {
            nextTierName = nextProgram.Tier_Name;
            nextTierPoints = nextProgram.Min_Lifetime_Points;
            pointsToNext = nextTierPoints - overallPoints;
            tierSpan = nextTierPoints - currentTierMin;
            if(tierSpan > 0)
            {
                tierProgress = (((overallPoints - currentTierMin) * 100.0) / tierSpan).round(0);
            }
            else
            {
                tierProgress = 0;
            }
            if(tierProgress < 0)
            {
                tierProgress = 0;
            }
            if(tierProgress > 100)
            {
                tierProgress = 100;
            }
        }
    }
    pointsRupees = (currentPoints * pointValueRate).round(2);
    pointsRupeesText = pointsRupees.toString("##,##,##0.00");
    loyaltyRows = Loyalty_Transactions[Customer == customerID] sort by Transaction_Date desc;
    openShipmentRows = Shipment_Requests[Customer == customerID && Shipment_Status != "Delivered" && Shipment_Status != "Cancelled"] sort by Requested_On desc;
    if(openShipmentRows.count() == 0)
    {
        openShipmentRows = Shipment_Requests[Customer == customerID] sort by Requested_On desc;
    }
    kycRows = KYC_Document_Requests[Customer == customerID && (Verification_Status == "Requested" || Verification_Status == "Rejected")] sort by Requested_On asc;
    redemptionRows = Loyalty_Redemptions[Customer == customerID] sort by Requested_On desc;
    redemptionRequested = Loyalty_Redemptions[Customer == customerID && (Redemption_Status == "Requested" || Redemption_Status == "Approved")].count();
    redemptionFulfilled = Loyalty_Redemptions[Customer == customerID && (Redemption_Status == "Paid" || Redemption_Status == "Applied")].count();
    redeemedValue = ifnull(Loyalty_Redemptions[Customer == customerID && (Redemption_Status == "Paid" || Redemption_Status == "Applied")].sum(Amount_Value),0);
    redeemedValueText = redeemedValue.toString("##,##,##0.00");
    onboardingBadgeClass = "zcs-badge-yellow";
    onboardingIcon = "loader-dots-06";
    if(onboardingStatus == "Active")
    {
        onboardingBadgeClass = "zcs-badge-green";
        onboardingIcon = "ui-1-check-circle-08";
    }
    else if(onboardingStatus == "Rejected" || onboardingStatus == "Suspended")
    {
        onboardingBadgeClass = "zcs-badge-red";
        onboardingIcon = "ui-1-circle-remove";
    }
    else if(onboardingStatus == "Pending KYC")
    {
        onboardingBadgeClass = "zcs-badge-blue";
    }
    kycBadgeClass = "zcs-badge-grey";
    kycIcon = "ui-2-time";
    if(kycStatus == "Approved" || kycStatus == "Not Required")
    {
        kycBadgeClass = "zcs-badge-green";
        kycIcon = "ui-1-check-circle-08";
    }
    else if(kycStatus == "Rejected")
    {
        kycBadgeClass = "zcs-badge-red";
        kycIcon = "ui-1-circle-remove";
    }
    else if(kycStatus == "Under Review")
    {
        kycBadgeClass = "zcs-badge-blue";
        kycIcon = "loader-dots-06";
    }
    else if(kycStatus == "Documents Requested")
    {
        kycBadgeClass = "zcs-badge-orange";
        kycIcon = "files-2-doc";
    }
    addressText = ifnull(customer.Primary_Address.address_line_1,"");
    if(ifnull(customer.Primary_Address.address_line_2,"") != "")
    {
        addressText = addressText + ", " + customer.Primary_Address.address_line_2;
    }
    addressText = addressText + ", " + ifnull(customer.Primary_Address.district_city,"") + ", " + ifnull(customer.Primary_Address.state_province,"") + " " + ifnull(customer.Primary_Address.postal_Code,"") + ", " + ifnull(customer.Primary_Address.country,"India");
%>

<div class='cd-grid cd-hero-grid'>
    <section class='zcs-card zcs-p-24 cd-profile' aria-labelledby='welcome-heading'>
        <div class='cd-profile-main'>
            <div class='zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink' style='--zcs-avatar-size:64px;--zcs-avatar-radius:14px' aria-hidden='true'>
                <span class='cd-initials'><%=initialText.toUpperCase()%></span>
            </div>
            <div class='cd-profile-details'>
                <p class='zcs-font-14 zcs-color-secondary zcs-m-0'>Welcome back</p>
                <h1 id='welcome-heading' class='zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-mt-5 zcs-mb-8'><%=fullName%></h1>
                <p class='zcs-font-14 zcs-color-secondary zcs-m-0'><%=customerType%> customer <span aria-hidden='true'>·</span> Customer ID <%=customer.Customer_ID%></p>
                <div class='cd-badges' aria-label='Account status'>
                    <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 <%=onboardingBadgeClass%>'>
                        <i class='zcs-no-shrink zc-li-outline <%=onboardingIcon%>'></i><span class='zcs-font-14'>Onboarding: <%=onboardingStatus%></span>
                    </div>
                    <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 <%=kycBadgeClass%>'>
                        <i class='zcs-no-shrink zc-li-outline <%=kycIcon%>'></i><span class='zcs-font-14'>KYC: <%=kycStatus%></span>
                    </div>
                </div>
            </div>
            <a class='cd-primary-link zcs-no-shrink' href='#Form:Customers?recLinkID=<%=customerID%>&amp;viewLinkName=All_Customers&amp;zc_LoadIn=dialog' aria-label='Edit profile'>
                <i class='zc-li-outline design-pencil-44'></i><span>Edit profile</span>
            </a>
        </div>
        <div class='cd-meta'>
            <div class='cd-meta-item'><i class='zc-li-outline ui-1-email-85' aria-hidden='true'></i><span class='zcs-font-14 zcs-ellipsis'><%=customer.Customer_Email%></span></div>
            <div class='cd-meta-item'><i class='zc-li-outline ui-3-phone-call' aria-hidden='true'></i><span class='zcs-font-14'><%=customer.Customer_Phone%></span></div>
            <div class='cd-meta-item cd-span-2'><i class='zc-li-outline location-pin-copy' aria-hidden='true'></i><span class='zcs-font-14 cd-address'><%=addressText%></span></div>
        </div>
    </section>

    <aside class='zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border cd-actions' aria-labelledby='quick-actions-heading'>
        <h2 id='quick-actions-heading' class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Quick actions</h2>
        <ul class='zcs-p-0 zcs-m-0'>
            <li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10 zcs-box-border'>
                <a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary' href='#Form:Customers?recLinkID=<%=customerID%>&amp;viewLinkName=All_Customers&amp;zc_LoadIn=dialog'>
                    <i class='zc-li-outline design-pencil-44'></i><span>Edit profile</span>
                </a>
            </li>
            <%
            if(shipmentAllowed)
            {
            %>
            <li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10 zcs-box-border'>
                <a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary' href='#Form:Shipment_Requests?Customer=<%=customerID%>&amp;zc_LoadIn=dialog'>
                    <i class='zc-li-outline transport-delivery-fast'></i><span>Request shipment</span>
                </a>
            </li>
            <%
            }
            else
            {
            %>
            <li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10 zcs-box-border cd-action-disabled' aria-disabled='true'>
                <span class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15'>
                    <i class='zc-li-outline ui-1-lock'></i><span>Request shipment<span class='cd-action-note'>Available after business KYC is approved and onboarding becomes Active.</span></span>
                </span>
            </li>
            <%
            }
            %>
            <li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10 zcs-box-border'>
                <a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary' href='#Form:Loyalty_Redemptions?Customer=<%=customerID%>&amp;Redemption_Type=Cash%20Value&amp;zc_LoadIn=dialog'>
                    <i class='zc-li-outline business-coins'></i><span>Request cash redemption</span>
                </a>
            </li>
            <li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10 zcs-box-border'>
                <a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary' href='#Report:My_Shipments'>
                    <i class='zc-li-outline files-2-doc'></i><span>Open my reports</span>
                </a>
            </li>
        </ul>
    </aside>
</div>

<%
if(isBusiness && shipmentAllowed == false)
{
%>
<div class='cd-section zcs-toast zcs-outline-toast zcs-warning-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14' role='status'>
    <i class='zcs-no-shrink zc-li-outline ui-3-alert' aria-hidden='true'></i>
    <div><strong>Shipment requests are temporarily unavailable.</strong> Your business account is <%=onboardingStatus%>. Complete the outstanding KYC steps below; profile access, KYC uploads, points balance, and redemption information remain available.</div>
</div>
<%
}
%>

<div class='cd-grid cd-kpis cd-section' aria-label='Account metrics'>
    <div class='zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border cd-kpi'>
        <div class='cd-kpi-top'><span class='zcs-font-14 zcs-color-secondary'>Lifetime points earned</span><span class='cd-kpi-icon'><i class='zc-li-outline sport-trophy' aria-hidden='true'></i></span></div>
        <strong class='zcs-font-30 cd-kpi-value'><%=overallPointsText%></strong><span class='zcs-font-12 cd-muted'>Posted earn transactions</span>
    </div>
    <div class='zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border cd-kpi'>
        <div class='cd-kpi-top'><span class='zcs-font-14 zcs-color-secondary'>Current points balance</span><span class='cd-kpi-icon'><i class='zc-li-outline business-coins' aria-hidden='true'></i></span></div>
        <strong class='zcs-font-30 cd-kpi-value'><%=currentPointsText%></strong><span class='zcs-font-12 cd-muted'>Worth approximately ₹<%=pointsRupeesText%></span>
    </div>
    <div class='zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border cd-kpi'>
        <div class='cd-kpi-top'><span class='zcs-font-14 zcs-color-secondary'>Active shipments</span><span class='cd-kpi-icon'><i class='zc-li-outline transport-delivery-fast' aria-hidden='true'></i></span></div>
        <strong class='zcs-font-30 cd-kpi-value'><%=activeCount.toString("##,##,##0")%></strong><span class='zcs-font-12 cd-muted'>Open and in-progress requests</span>
    </div>
    <div class='zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border cd-kpi'>
        <div class='cd-kpi-top'><span class='zcs-font-14 zcs-color-secondary'>Delivered shipments</span><span class='cd-kpi-icon'><i class='zc-li-outline ui-1-check-circle-08' aria-hidden='true'></i></span></div>
        <strong class='zcs-font-30 cd-kpi-value'><%=deliveredCount.toString("##,##,##0")%></strong><span class='zcs-font-12 cd-muted'>Lifetime successful deliveries</span>
    </div>
</div>

<div class='cd-grid cd-two cd-section'>
    <section class='zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-24 zcs-box-border' aria-labelledby='tier-heading'>
        <div class='cd-tier-grid'>
            <div><p class='zcs-font-14 zcs-color-secondary zcs-m-0'>Current loyalty tier</p><h2 id='tier-heading' class='cd-tier-name zcs-mt-5 zcs-mb-8'><%=tierName%></h2><p class='zcs-font-14 zcs-color-secondary zcs-m-0'><%=overallPointsText%> lifetime points</p></div>
            <div class='cd-value-box'><span class='zcs-font-12 zcs-color-secondary'>Points value</span><strong class='zcs-font-20 zcs-color-primary'>₹<%=pointsRupeesText%></strong><span class='zcs-font-12 zcs-color-secondary'> at ₹<%=pointValueRate.toString("##,##,##0.00")%> per point</span></div>
        </div>
        <div class='zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6'>
            <div class='zcs-progress-bar zcs-rounded-sm' role='progressbar' aria-valuemin='0' aria-valuemax='100' aria-valuenow='<%=tierProgress%>' aria-label='Progress to next loyalty tier'><div class='zcs-progress-bar-indicator' style='width:<%=tierProgress%>%;'></div></div>
            <p class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-lh-body zcs-m-0'>
                <span class='zcs-color-primary'><%=tierProgress%>% tier progress</span>
                <span class='zcs-color-primary'><%if(pointsToNext > 0){%><%=pointsToNext.toString("##,##,##0")%> points to <%=nextTierName%><%}else{%><%=nextTierName%><%}%></span>
            </p>
        </div>
        <p class='zcs-font-13 zcs-color-secondary zcs-m-0'>Minimum cash redemption: <%=minimumRedemption.toString("##,##,##0")%> points.</p>
    </section>

    <section class='zcs-card zcs-p-24' aria-labelledby='redemption-heading'>
        <div class='cd-card-header'><h2 id='redemption-heading' class='zcs-font-18 zcs-font-semibold zcs-m-0'>Redemption summary</h2><a href='#Report:My_Redemptions'>View all</a></div>
        <div class='cd-redemption-list'>
            <div class='cd-summary-box'><span class='zcs-font-12 zcs-color-secondary'>Pending review</span><strong><%=redemptionRequested.toString("##,##,##0")%></strong></div>
            <div class='cd-summary-box'><span class='zcs-font-12 zcs-color-secondary'>Paid or applied</span><strong><%=redemptionFulfilled.toString("##,##,##0")%></strong></div>
            <div class='cd-summary-box'><span class='zcs-font-12 zcs-color-secondary'>Fulfilled value</span><strong>₹<%=redeemedValueText%></strong></div>
        </div>
        <%
        redemptionCounter = 0;
        for each redemption in redemptionRows
        {
            if(redemptionCounter < 3)
            {
                redemptionStatusClass = "zcs-badge-yellow";
                if(redemption.Redemption_Status == "Paid" || redemption.Redemption_Status == "Applied")
                {
                    redemptionStatusClass = "zcs-badge-green";
                }
                else if(redemption.Redemption_Status == "Rejected" || redemption.Redemption_Status == "Cancelled")
                {
                    redemptionStatusClass = "zcs-badge-red";
                }
        %>
        <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-py-10'>
            <div><strong class='zcs-font-14'><%=redemption.Redemption_Type%> · <%=ifnull(redemption.Points_Requested,0).toString("##,##,##0")%> points</strong><div class='zcs-font-12 zcs-color-secondary'><%=redemption.Requested_On.toString("dd-MMM-yyyy, hh:mm a")%></div></div>
            <span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12 <%=redemptionStatusClass%>'><%=redemption.Redemption_Status%></span>
        </div>
        <%
                redemptionCounter = redemptionCounter + 1;
            }
        }
        if(redemptionCounter == 0)
        {
        %>
        <div class='zcs-nodata-wrapper cd-empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><h3 class='zcs-font-16 zcs-font-medium zcs-m-0'>No redemption requests yet</h3></div></div>
        <%
        }
        %>
    </section>
</div>

<%
if(kycRows.count() > 0)
{
%>
<section class='cd-section zcs-card zcs-p-20' aria-labelledby='kyc-actions-heading'>
    <div class='zcs-toast zcs-outline-toast zcs-warning-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border'>
        <i class='zcs-no-shrink zc-li-outline files-2-doc' aria-hidden='true'></i>
        <div class='zcs-w-full'>
            <h2 id='kyc-actions-heading' class='zcs-font-18 zcs-font-semibold zcs-m-0'>KYC documents need your attention</h2>
            <p class='zcs-font-14 zcs-mt-5 zcs-mb-12'>Upload or resubmit the requested documents. Files are reviewed securely by the logistics support team.</p>
            <div class='cd-report-links'>
            <%
            for each kycRequest in kycRows
            {
            %>
                <a href='#Report:My_KYC_Documents?ID=<%=kycRequest.ID%>&amp;zc_LoadIn=dialog'><i class='zc-li-outline cloud-upload-96' aria-hidden='true'></i> <%=kycRequest.Requested_Document_Name%> · <%=kycRequest.Verification_Status%></a>
            <%
            }
            %>
            </div>
        </div>
    </div>
</section>
<%
}
%>

<div class='cd-grid cd-main cd-section'>
    <section class='zcs-card zcs-p-24' aria-labelledby='shipments-heading'>
        <div class='cd-card-header'><h2 id='shipments-heading' class='zcs-font-18 zcs-font-semibold zcs-m-0'>Recent and open shipments</h2><a href='#Report:My_Shipments'>View all shipments</a></div>
        <%
        shipmentCounter = 0;
        for each shipment in openShipmentRows
        {
            if(shipmentCounter < 3)
            {
                shipmentStatusClass = "zcs-badge-blue";
                if(shipment.Shipment_Status == "Delivered")
                {
                    shipmentStatusClass = "zcs-badge-green";
                }
                else if(shipment.Shipment_Status == "Cancelled")
                {
                    shipmentStatusClass = "zcs-badge-red";
                }
                else if(shipment.Shipment_Status == "Requested" || shipment.Shipment_Status == "Quoted")
                {
                    shipmentStatusClass = "zcs-badge-yellow";
                }
                pickupCity = ifnull(shipment.Pickup_Address.district_city,"Pickup");
                pickupState = ifnull(shipment.Pickup_Address.state_province,"");
                deliveryCity = ifnull(shipment.Delivery_Address.district_city,"Delivery");
                deliveryState = ifnull(shipment.Delivery_Address.state_province,"");
                eventRows = Shipment_Tracking_Events[Shipment == shipment.ID && Customer_Visible == true] sort by Event_Time desc;
        %>
        <article class='zcs-card zcs-p-20 cd-shipment'>
            <div class='cd-shipment-head'>
                <div><a class='cd-link zcs-font-16 zcs-font-semibold' href='#Report:My_Shipments?ID=<%=shipment.ID%>&amp;zc_LoadIn=dialog'>Shipment <%=shipment.Shipment_Number%></a><div class='zcs-font-12 zcs-color-secondary'>Requested <%=shipment.Requested_On.toString("dd-MMM-yyyy, hh:mm a")%> IST · <%=shipment.Transport_Mode%></div></div>
                <span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13 <%=shipmentStatusClass%>'><i class='zc-li-outline transport-delivery-fast'></i><%=shipment.Shipment_Status%></span>
            </div>
            <div class='cd-route'>
                <div class='cd-route-point'><span class='zcs-font-12 zcs-color-secondary'>From</span><strong class='zcs-font-14'><%=pickupCity%><%if(pickupState != ""){%>, <%=pickupState%><%}%></strong></div>
                <i class='cd-route-line zc-li-outline arrows-1-tail-right' aria-hidden='true'></i>
                <div class='cd-route-point'><span class='zcs-font-12 zcs-color-secondary'>To</span><strong class='zcs-font-14'><%=deliveryCity%><%if(deliveryState != ""){%>, <%=deliveryState%><%}%></strong></div>
            </div>
            <p class='zcs-font-13 zcs-color-secondary zcs-mt-10 zcs-mb-0'><i class='zc-li-outline location-pin-copy' aria-hidden='true'></i> <%=ifnull(shipment.Latest_Tracking_Text,"Tracking will appear after the request is submitted.")%></p>
            <%
            eventCounter = 0;
            if(eventRows.count() > 0)
            {
            %>
            <div class='zcs-timeline-wrapper cd-timeline-compact' aria-label='Shipment tracking timeline'>
                <ul class='zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0'>
                <%
                for each eventRow in eventRows
                {
                    if(eventCounter < 4)
                    {
                %>
                    <li class='zcs-tl-li zcs-row zcs-gap-0 zcs-relative zcs-list-none'>
                        <div class='zcs-tl-indicator zcs-flex zcs-justify-center zcs-absolute'><span class='zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative'></span></div>
                        <span class='zcs-col-2 zcs-tl-time zcs-color-tertiary zcs-text-right'><%=eventRow.Event_Time.toString("dd-MMM-yyyy, hh:mm a")%></span>
                        <div class='zcs-flex zcs-direction-column zcs-col-10 zcs-box-border cd-tl-content'>
                            <strong class='zcs-font-14'><%=eventRow.Event_Type%></strong><span class='zcs-font-12 zcs-color-secondary'><%=ifnull(eventRow.Location_Text,ifnull(eventRow.Details,"Status updated"))%></span>
                        </div>
                    </li>
                <%
                        eventCounter = eventCounter + 1;
                    }
                }
                %>
                </ul>
            </div>
            <%
            }
            %>
        </article>
        <%
                shipmentCounter = shipmentCounter + 1;
            }
        }
        if(shipmentCounter == 0)
        {
        %>
        <div class='zcs-nodata-wrapper cd-empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><i class='cd-empty-icon zc-li-outline transport-delivery-fast'></i><h3 class='zcs-font-18 zcs-font-medium zcs-mt-10 zcs-mb-0'>No shipments yet</h3><%if(shipmentAllowed){%><p class='zcs-font-14 zcs-color-secondary'>Create your first shipment request from Quick actions.</p><%}%></div></div>
        <%
        }
        %>
    </section>

    <aside class='zcs-card zcs-p-24' aria-labelledby='reports-heading'>
        <div class='cd-card-header'><h2 id='reports-heading' class='zcs-font-18 zcs-font-semibold zcs-m-0'>My reports</h2></div>
        <div class='cd-report-links zcs-direction-column'>
            <a href='#Report:My_KYC_Documents'><i class='zc-li-outline files-2-doc'></i> My KYC documents</a>
            <a href='#Report:My_Shipments'><i class='zc-li-outline transport-delivery-fast'></i> My shipments</a>
            <a href='#Report:My_Tracking_Events'><i class='zc-li-outline location-pin-copy'></i> My tracking events</a>
            <a href='#Report:My_Loyalty_Transactions'><i class='zc-li-outline business-coins'></i> My loyalty transactions</a>
            <a href='#Report:My_Redemptions'><i class='zc-li-outline business-wallet-44'></i> My redemptions</a>
        </div>
        <div class='zcs-toast zcs-outline-toast zcs-info-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-13 zcs-mt-10'>
            <i class='zc-li-outline travel-info' aria-hidden='true'></i><span>All links open reports already restricted to your portal-owned records.</span>
        </div>
    </aside>
</div>

<section class='cd-section zcs-card zcs-p-24' aria-labelledby='loyalty-ledger-heading'>
    <div class='cd-card-header'><h2 id='loyalty-ledger-heading' class='zcs-font-18 zcs-font-semibold zcs-m-0'>Recent loyalty transactions</h2><a href='#Report:My_Loyalty_Transactions'>Open full ledger</a></div>
    <%
    if(loyaltyRows.count() > 0)
    {
    %>
    <div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
        <table class='zcs-w-full'>
            <thead class='zcs-sticky'><tr>
                <th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium'>Date and time</th>
                <th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium'>Type</th>
                <th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium cd-table-hide-mobile'>Reference</th>
                <th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium'>Points</th>
                <th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium cd-table-hide-mobile'>Value</th>
                <th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium'>Balance</th>
            </tr></thead>
            <tbody>
            <%
            transactionCounter = 0;
            for each transaction in loyaltyRows
            {
                if(transactionCounter < 6)
                {
                    pointClass = "cd-table-points-positive";
                    pointPrefix = "+";
                    if(transaction.Points < 0)
                    {
                        pointClass = "cd-table-points-negative";
                        pointPrefix = "";
                    }
            %>
                <tr>
                    <td class='zcs-px-16 zcs-py-8 zcs-font-14'><%=transaction.Transaction_Date.toString("dd-MMM-yyyy, hh:mm a")%></td>
                    <td class='zcs-px-16 zcs-py-8 zcs-font-14'><%=transaction.Transaction_Type%></td>
                    <td class='zcs-px-16 zcs-py-8 zcs-font-14 cd-table-hide-mobile'><%=ifnull(transaction.Reference_Text,"—")%></td>
                    <td class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 <%=pointClass%>'><%=pointPrefix%><%=transaction.Points.toString("##,##,##0")%></td>
                    <td class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 cd-table-hide-mobile'>₹<%=ifnull(transaction.Monetary_Value,0).toString("##,##,##0.00")%></td>
                    <td class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14'><%=ifnull(transaction.Balance_After,0).toString("##,##,##0")%></td>
                </tr>
            <%
                    transactionCounter = transactionCounter + 1;
                }
            }
            %>
            </tbody>
        </table>
    </div>
    <%
    }
    else
    {
    %>
    <div class='zcs-nodata-wrapper cd-empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><h3 class='zcs-font-18 zcs-font-medium zcs-m-0'>No loyalty transactions yet</h3></div></div>
    <%
    }
    %>
</section>
<%
}
%>
</div>
</div>