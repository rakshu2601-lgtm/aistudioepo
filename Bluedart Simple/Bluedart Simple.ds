	pages
	{
		page Admin_Dashboard
		{
					displayname = "Admin Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Admin_Overview' elementName='Admin_Overview'>\n\t\t\t\t\t<![CDATA[htmlpage Admin_Overview()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nactiveCustomers = Customers[Active == true &amp;&amp; Onboarding_Status == &quot;Active&quot;].count();\npendingKYC = KYC_Document_Requests[Verification_Status == &quot;Uploaded&quot;].count();\nshipmentsTransit = Shipment_Requests[Shipment_Status == &quot;In Transit&quot; || Shipment_Status == &quot;At Hub&quot; || Shipment_Status == &quot;Out for Delivery&quot;].count();\ndeliveriesToday = Shipment_Requests[Shipment_Status == &quot;Delivered&quot; &amp;&amp; Delivered_On &gt;= zoho.currentdate].count();\ngrossValue = ifnull(Shipment_Requests[ID != 0].sum(Gross_Amount),0);\nnetValue = ifnull(Shipment_Requests[ID != 0].sum(Net_Amount),0);\npendingCash = Loyalty_Redemptions[Redemption_Type == &quot;Cash Value&quot; &amp;&amp; (Redemption_Status == &quot;Requested&quot; || Redemption_Status == &quot;Approved&quot;)].count();\ncriticalAudit = Audit_Log[Severity == &quot;Critical&quot;].count();\nfailedTasks = Agent_Tasks[Task_Status == &quot;Failed&quot;].count();\nitemExceptions = Manifest_Items[Item_Status == &quot;Exception&quot;].count();\ncriticalExceptions = criticalAudit + failedTasks + itemExceptions;\nlateManifestCount = Manifests[Planned_Departure &lt; zoho.currenttime &amp;&amp; (Manifest_Status == &quot;Draft&quot; || Manifest_Status == &quot;Ready&quot;)].count();\nlateTaskCount = Agent_Tasks[Scheduled_At &lt; zoho.currenttime &amp;&amp; Task_Status != &quot;Completed&quot; &amp;&amp; Task_Status != &quot;Failed&quot;].count();\nloyaltyLiability = 0.0;\nfor each liabilityCustomer in Customers[Current_Points_Balance &gt; 0]\n{\n\tif(liabilityCustomer.Current_Loyalty_Program != null)\n\t{\n\t\tloyaltyLiability = loyaltyLiability + (liabilityCustomer.Current_Points_Balance * liabilityCustomer.Current_Loyalty_Program.Redemption_Value_Per_Point);\n\t}\n}\nretailCount = Customers[Customer_Type == &quot;Retail&quot;].count();\ncorporateCount = Customers[Customer_Type == &quot;Corporate&quot;].count();\nwholesaleCount = Customers[Customer_Type == &quot;Wholesale&quot;].count();\ncustomerTotal = retailCount + corporateCount + wholesaleCount;\nretailPct = if(customerTotal &gt; 0,(retailCount * 100.0 / customerTotal).round(1),0);\ncorporatePct = if(customerTotal &gt; 0,(corporateCount * 100.0 / customerTotal).round(1),0);\nwholesalePct = if(customerTotal &gt; 0,(wholesaleCount * 100.0 / customerTotal).round(1),0);\nnewCount = Customers[Onboarding_Status == &quot;New&quot;].count();\npendingOnboardCount = Customers[Onboarding_Status == &quot;Pending KYC&quot;].count();\nsuspendedCount = Customers[Onboarding_Status == &quot;Suspended&quot; || Onboarding_Status == &quot;Rejected&quot;].count();\nonboardTotal = newCount + pendingOnboardCount + activeCustomers + suspendedCount;\nnewPct = if(onboardTotal &gt; 0,(newCount * 100.0 / onboardTotal).round(1),0);\npendingOnboardPct = if(onboardTotal &gt; 0,(pendingOnboardCount * 100.0 / onboardTotal).round(1),0);\nactivePct = if(onboardTotal &gt; 0,(activeCustomers * 100.0 / onboardTotal).round(1),0);\nsuspendedPct = if(onboardTotal &gt; 0,(suspendedCount * 100.0 / onboardTotal).round(1),0);\nrequestedShip = Shipment_Requests[Shipment_Status == &quot;Requested&quot; || Shipment_Status == &quot;Quoted&quot; || Shipment_Status == &quot;Confirmed&quot;].count();\nmovementShip = Shipment_Requests[Shipment_Status == &quot;Pickup Assigned&quot; || Shipment_Status == &quot;Picked Up&quot; || Shipment_Status == &quot;In Transit&quot; || Shipment_Status == &quot;At Hub&quot; || Shipment_Status == &quot;Delivery Assigned&quot; || Shipment_Status == &quot;Out for Delivery&quot;].count();\ndeliveredShip = Shipment_Requests[Shipment_Status == &quot;Delivered&quot;].count();\ncancelledShip = Shipment_Requests[Shipment_Status == &quot;Cancelled&quot;].count();\nshipTotal = requestedShip + movementShip + deliveredShip + cancelledShip;\nrequestedPct = if(shipTotal &gt; 0,(requestedShip * 100.0 / shipTotal).round(1),0);\nmovementPct = if(shipTotal &gt; 0,(movementShip * 100.0 / shipTotal).round(1),0);\ndeliveredPct = if(shipTotal &gt; 0,(deliveredShip * 100.0 / shipTotal).round(1),0);\ncancelledPct = if(shipTotal &gt; 0,(cancelledShip * 100.0 / shipTotal).round(1),0);\nroadCount = Shipment_Requests[Transport_Mode == &quot;Road&quot;].count();\nairCount = Shipment_Requests[Transport_Mode == &quot;Air&quot;].count();\nrailCount = Shipment_Requests[Transport_Mode == &quot;Rail&quot;].count();\nseaCount = Shipment_Requests[Transport_Mode == &quot;Sea&quot;].count();\nmodeMax = roadCount;\nif(airCount &gt; modeMax){modeMax = airCount;}\nif(railCount &gt; modeMax){modeMax = railCount;}\nif(seaCount &gt; modeMax){modeMax = seaCount;}\nif(modeMax == 0){modeMax = 1;}\nroadPct = (roadCount * 100.0 / modeMax).round(0);\nairPct = (airCount * 100.0 / modeMax).round(0);\nrailPct = (railCount * 100.0 / modeMax).round(0);\nseaPct = (seaCount * 100.0 / modeMax).round(0);\nrev30 = ifnull(Shipment_Requests[Delivered_On &gt;= zoho.currentdate.subDay(30)].sum(Net_Amount),0);\nrev60 = ifnull(Shipment_Requests[Delivered_On &gt;= zoho.currentdate.subDay(60) &amp;&amp; Delivered_On &lt; zoho.currentdate.subDay(30)].sum(Net_Amount),0);\nrev90 = ifnull(Shipment_Requests[Delivered_On &gt;= zoho.currentdate.subDay(90) &amp;&amp; Delivered_On &lt; zoho.currentdate.subDay(60)].sum(Net_Amount),0);\nrev120 = ifnull(Shipment_Requests[Delivered_On &gt;= zoho.currentdate.subDay(120) &amp;&amp; Delivered_On &lt; zoho.currentdate.subDay(90)].sum(Net_Amount),0);\nrevMax = rev30;\nif(rev60 &gt; revMax){revMax = rev60;}\nif(rev90 &gt; revMax){revMax = rev90;}\nif(rev120 &gt; revMax){revMax = rev120;}\nif(revMax == 0){revMax = 1;}\nrev30Pct = (rev30 * 100.0 / revMax).round(0);\nrev60Pct = (rev60 * 100.0 / revMax).round(0);\nrev90Pct = (rev90 * 100.0 / revMax).round(0);\nrev120Pct = (rev120 * 100.0 / revMax).round(0);\n%&gt;\n&lt;style&gt;\n/* zcs-global: page-scoped utility subset loaded once */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#f3f3f4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;--zcs-border-color:var(--zcs_tertiary_border_color);font-size:16px;line-height:1.5}\n.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-end{align-items:flex-end}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-overflow-auto{overflow:auto}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-half{border-radius:50%}.zcs-gap-4{gap:4px}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-gap-20{gap:20px}.zcs-gap-24{gap:24px}.zcs-p-0{padding:0}.zcs-p-2{padding:2px}.zcs-p-8{padding:8px}.zcs-p-12{padding:12px}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-12{padding-top:12px;padding-bottom:12px}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:8px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-heading{line-height:1.25}.zcs-lh-body{line-height:1.5}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}\n.admin-dashboard{background:var(--zcs-page-bg-color);padding:24px 30px;font-family:Arial,sans-serif;color:var(--zcs-primary-text-color)}.admin-header{padding:22px 24px;background:linear-gradient(115deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));border-radius:14px;color:var(--zcs_brand_foreground_color)}.admin-header h1{font-size:24px;margin:0 0 4px}.admin-header p{margin:0;opacity:.9}.asof{font-size:13px;white-space:nowrap}.dashboard-stack{display:flex;flex-direction:column;gap:20px;margin-top:20px}.kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.zcs-panel{border:1px solid var(--zcs-border-color);box-shadow:0 2px 8px #0000000a;background:var(--zcs-white-color);padding:16px;border-radius:12px}.zcs-panel-top{display:flex;align-items:center;gap:10px}.zcs-panel-icon-wrapper{width:40px;height:40px;display:flex;align-items:center;justify-content:center;border-radius:8px;background:#e8efff;color:#2a6ffc}.tone-green .zcs-panel-icon-wrapper{background:#e4fcf3;color:#147d58}.tone-yellow .zcs-panel-icon-wrapper{background:#fcf4e6;color:#8a5a09}.tone-red .zcs-panel-icon-wrapper{background:#fde3e6;color:#c62e43}.tone-violet .zcs-panel-icon-wrapper{background:#f1edff;color:#5c45ba}.kpi-value{font-size:22px;font-weight:700}.kpi-label{font-size:13px;color:var(--zcs-teritiary-text-color);margin:8px 0 0}.content-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:20px}.span-4{grid-column:span 4}.span-5{grid-column:span 5}.span-6{grid-column:span 6}.span-7{grid-column:span 7}.span-8{grid-column:span 8}.span-12{grid-column:span 12}.section-card{padding:18px;min-width:0}.section-title{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:16px}.section-title h2{font-size:17px;margin:0}.section-link{font-size:13px;color:var(--zcs_brand_color);font-weight:600}.chart-split{display:grid;grid-template-columns:1fr 1fr;gap:16px}.zcs-donut-chart-wrapper{display:flex;align-items:center;justify-content:center;gap:12px}.zcs-simple-donut-chart{width:150px;height:150px;border-radius:50%;background:conic-gradient(#fece56 0 calc(var(--a1)*1%),#36a2eb calc(var(--a1)*1%) calc((var(--a1) + var(--a2))*1%),#ff6283 calc((var(--a1) + var(--a2))*1%) calc((var(--a1) + var(--a2) + var(--a3))*1%),#28cc97 calc((var(--a1) + var(--a2) + var(--a3))*1%) 100%);position:relative}.zcs-simple-donut-chart:after{content:&apos;&apos;;position:absolute;inset:25px;border-radius:50%;background:var(--zcs-white-color)}.zcs-donut-chart-name{z-index:1;position:absolute;text-align:center;font-size:14px;line-height:1.2}.zcs-legend-wrapper ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px}.zcs-legend-wrapper li{font-size:13px;display:flex;align-items:center;gap:7px}.legend-dot{width:10px;height:10px;border-radius:50%;display:inline-block}.l1{background:#fece56}.l2{background:#36a2eb}.l3{background:#ff6283}.l4{background:#28cc97}.bars{display:flex;flex-direction:column;gap:12px}.bar-row{display:grid;grid-template-columns:105px 1fr 64px;gap:10px;align-items:center;font-size:13px}.bar-track{height:10px;background:#edf0f6;border-radius:6px;overflow:hidden}.bar-fill{height:100%;border-radius:6px;background:var(--zcs_brand_color)}.bar-fill.alt{background:#ff7300}.bar-fill.green{background:#179e6c}.bar-fill.red{background:#fe455d}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:var(--zcs-white-color);overflow:auto;border-radius:6px}.zcs-table-wrapper table{width:100%;border-collapse:collapse;line-height:normal}.zcs-table-wrapper th{background:#f9fafe;white-space:nowrap;font-weight:600}.zcs-table-wrapper th,.zcs-table-wrapper td{padding:10px 12px;text-align:left;font-size:13px;border-top:1px solid var(--zcs-border-color);vertical-align:middle}.zcs-table-wrapper thead th{border-top:0}.zcs-table-wrapper tbody tr:hover td{background:#f9fafe}.zcs-badge{width:auto;border:1px solid;display:inline-flex;align-items:center;gap:6px;border-radius:4px;padding:2px 8px;font-size:12px;white-space:nowrap}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#126f50}.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#a91931}.zcs-badge-yellow{background:#fcf4e6;border-color:#d59412;color:#80560b}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#1749a4}.alert-list,.activity-list{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px}.alert-item,.activity-item{border:1px solid var(--zcs-border-color);border-radius:8px;padding:11px 12px;display:flex;gap:10px;align-items:flex-start}.alert-item&gt;i{font-size:18px;color:#c62e43;margin-top:2px}.activity-item&gt;i{font-size:18px;color:var(--zcs_brand_color);margin-top:2px}.item-title{font-size:13px;font-weight:600}.item-meta{font-size:12px;color:var(--zcs-teritiary-text-color);margin-top:3px}.hub-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.hub-card{padding:12px;border:1px solid var(--zcs-border-color);border-radius:8px}.hub-number{font-size:20px;font-weight:700}.zcs-quick-actions-wrapper{padding:16px}.quick-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;list-style:none;padding:0;margin:0}.zcs-quick-action-item{border:1px solid var(--zcs-border-color);border-radius:8px}.zcs-quick-action-link{display:flex;align-items:center;gap:9px;padding:11px 12px;color:var(--zcs-primary-text-color);font-size:13px}.zcs-quick-action-item:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover a{color:var(--zcs_brand_color)}.empty{padding:18px;text-align:center;color:var(--zcs-teritiary-text-color);font-size:13px}.money-note{font-size:11px;color:var(--zcs-teritiary-text-color);margin-top:4px}.zcs-button{min-height:36px;border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs_brand_color);padding:8px 13px;border-radius:6px;display:inline-flex;align-items:center;gap:7px;font-size:13px}.zcs-button:hover,.zcs-button:focus{background:var(--zcs_component_hover_color);outline:2px solid var(--zcs_brand_color);outline-offset:2px}\n@media(max-width:1180px){.kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.span-4,.span-5,.span-6,.span-7,.span-8{grid-column:span 6}.quick-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media(max-width:820px){.admin-dashboard{padding:16px}.admin-header{align-items:flex-start;flex-direction:column}.content-grid{grid-template-columns:1fr}.span-4,.span-5,.span-6,.span-7,.span-8,.span-12{grid-column:1}.chart-split{grid-template-columns:1fr}.quick-grid{grid-template-columns:1fr}.hub-grid{grid-template-columns:1fr}}\n&lt;/style&gt;\n&lt;div class=&apos;admin-dashboard zcs-box-border&apos;&gt;\n\t&lt;header class=&apos;admin-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&apos;&gt;\n\t\t&lt;div&gt;&lt;h1&gt;Organization command centre&lt;/h1&gt;&lt;p&gt;Onboarding, operations, finance, loyalty and risk across India&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;asof&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt; As of &lt;%=zoho.currenttime.toString(&quot;dd-MMM-yyyy HH:mm&quot;)%&gt; IST&lt;/div&gt;\n\t&lt;/header&gt;\n\t&lt;main class=&apos;dashboard-stack&apos;&gt;\n\t\t&lt;section class=&apos;kpi-grid&apos; aria-label=&apos;Organization KPIs&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-panel tone-green&apos;&gt;&lt;div class=&apos;zcs-panel-top&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-05&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;kpi-value&apos;&gt;&lt;%=activeCustomers%&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&apos;kpi-label&apos;&gt;Active customers&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-panel tone-yellow&apos;&gt;&lt;div class=&apos;zcs-panel-top&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-doc&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;kpi-value&apos;&gt;&lt;%=pendingKYC%&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&apos;kpi-label&apos;&gt;Pending KYC reviews&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-panel&apos;&gt;&lt;div class=&apos;zcs-panel-top&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-4-restore&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;kpi-value&apos;&gt;&lt;%=shipmentsTransit%&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&apos;kpi-label&apos;&gt;Shipments in transit&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-panel tone-green&apos;&gt;&lt;div class=&apos;zcs-panel-top&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;kpi-value&apos;&gt;&lt;%=deliveriesToday%&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&apos;kpi-label&apos;&gt;Deliveries today&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-panel tone-violet&apos;&gt;&lt;div class=&apos;zcs-panel-top&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper&apos;&gt;&lt;i class=&apos;zc-li-outline business-money-coins&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;kpi-value&apos;&gt;₹&lt;%=grossValue.toString(&quot;##,##,###.00&quot;)%&gt;&lt;/div&gt;&lt;div class=&apos;money-note&apos;&gt;Net ₹&lt;%=netValue.toString(&quot;##,##,###.00&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&apos;kpi-label&apos;&gt;Gross / net shipment value&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-panel tone-yellow&apos;&gt;&lt;div class=&apos;zcs-panel-top&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper&apos;&gt;&lt;i class=&apos;zc-li-outline business-money-bag&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;kpi-value&apos;&gt;₹&lt;%=loyaltyLiability.toString(&quot;##,##,###.00&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&apos;kpi-label&apos;&gt;Outstanding loyalty liability&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-panel tone-yellow&apos;&gt;&lt;div class=&apos;zcs-panel-top&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-4-share-66&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;kpi-value&apos;&gt;&lt;%=pendingCash%&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&apos;kpi-label&apos;&gt;Pending cash redemptions&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-panel tone-red&apos;&gt;&lt;div class=&apos;zcs-panel-top&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;kpi-value&apos;&gt;&lt;%=criticalExceptions%&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&apos;kpi-label&apos;&gt;Critical exceptions&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;content-grid&apos;&gt;\n\t\t\t&lt;article class=&apos;zcs-card section-card span-6&apos;&gt;\n\t\t\t\t&lt;div class=&apos;section-title&apos;&gt;&lt;h2&gt;Customer distribution&lt;/h2&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Report:All_Customers&apos;&gt;Open customers&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;chart-split&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-donut-chart-wrapper&apos;&gt;&lt;div class=&apos;zcs-simple-donut-chart zcs-flex zcs-align-items-center zcs-justify-center&apos; style=&apos;--a1:&lt;%=retailPct%&gt;;--a2:&lt;%=corporatePct%&gt;;--a3:&lt;%=wholesalePct%&gt;;--a4:0&apos;&gt;&lt;div class=&apos;zcs-donut-chart-name&apos;&gt;&lt;strong&gt;&lt;%=customerTotal%&gt;&lt;/strong&gt;&lt;br&gt;customers&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;zcs-legend-wrapper&apos;&gt;&lt;ul&gt;&lt;li&gt;&lt;span class=&apos;legend-dot l1&apos;&gt;&lt;/span&gt;Retail &lt;strong&gt;&lt;%=retailCount%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span class=&apos;legend-dot l2&apos;&gt;&lt;/span&gt;Corporate &lt;strong&gt;&lt;%=corporateCount%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span class=&apos;legend-dot l3&apos;&gt;&lt;/span&gt;Wholesale &lt;strong&gt;&lt;%=wholesaleCount%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-donut-chart-wrapper&apos;&gt;&lt;div class=&apos;zcs-simple-donut-chart zcs-flex zcs-align-items-center zcs-justify-center&apos; style=&apos;--a1:&lt;%=newPct%&gt;;--a2:&lt;%=pendingOnboardPct%&gt;;--a3:&lt;%=suspendedPct%&gt;;--a4:&lt;%=activePct%&gt;&apos;&gt;&lt;div class=&apos;zcs-donut-chart-name&apos;&gt;&lt;strong&gt;&lt;%=onboardTotal%&gt;&lt;/strong&gt;&lt;br&gt;onboarded&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;zcs-legend-wrapper&apos;&gt;&lt;ul&gt;&lt;li&gt;&lt;span class=&apos;legend-dot l1&apos;&gt;&lt;/span&gt;New &lt;strong&gt;&lt;%=newCount%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span class=&apos;legend-dot l2&apos;&gt;&lt;/span&gt;Pending KYC &lt;strong&gt;&lt;%=pendingOnboardCount%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span class=&apos;legend-dot l3&apos;&gt;&lt;/span&gt;Restricted &lt;strong&gt;&lt;%=suspendedCount%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span class=&apos;legend-dot l4&apos;&gt;&lt;/span&gt;Active &lt;strong&gt;&lt;%=activeCustomers%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/article&gt;\n\n\t\t\t&lt;article class=&apos;zcs-card section-card span-6&apos;&gt;\n\t\t\t\t&lt;div class=&apos;section-title&apos;&gt;&lt;h2&gt;Shipment status and mode&lt;/h2&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Report:Shipment_Status_Board&apos;&gt;Open operations&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;chart-split&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-donut-chart-wrapper&apos;&gt;&lt;div class=&apos;zcs-simple-donut-chart zcs-flex zcs-align-items-center zcs-justify-center&apos; style=&apos;--a1:&lt;%=requestedPct%&gt;;--a2:&lt;%=movementPct%&gt;;--a3:&lt;%=cancelledPct%&gt;;--a4:&lt;%=deliveredPct%&gt;&apos;&gt;&lt;div class=&apos;zcs-donut-chart-name&apos;&gt;&lt;strong&gt;&lt;%=shipTotal%&gt;&lt;/strong&gt;&lt;br&gt;shipments&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;zcs-legend-wrapper&apos;&gt;&lt;ul&gt;&lt;li&gt;&lt;span class=&apos;legend-dot l1&apos;&gt;&lt;/span&gt;Pre-transit &lt;strong&gt;&lt;%=requestedShip%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span class=&apos;legend-dot l2&apos;&gt;&lt;/span&gt;Moving &lt;strong&gt;&lt;%=movementShip%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span class=&apos;legend-dot l3&apos;&gt;&lt;/span&gt;Cancelled &lt;strong&gt;&lt;%=cancelledShip%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span class=&apos;legend-dot l4&apos;&gt;&lt;/span&gt;Delivered &lt;strong&gt;&lt;%=deliveredShip%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;bars&apos;&gt;&lt;div class=&apos;bar-row&apos;&gt;&lt;span&gt;Road&lt;/span&gt;&lt;div class=&apos;bar-track&apos;&gt;&lt;div class=&apos;bar-fill&apos; style=&apos;width:&lt;%=roadPct%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong&gt;&lt;%=roadCount%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;bar-row&apos;&gt;&lt;span&gt;Air&lt;/span&gt;&lt;div class=&apos;bar-track&apos;&gt;&lt;div class=&apos;bar-fill alt&apos; style=&apos;width:&lt;%=airPct%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong&gt;&lt;%=airCount%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;bar-row&apos;&gt;&lt;span&gt;Rail&lt;/span&gt;&lt;div class=&apos;bar-track&apos;&gt;&lt;div class=&apos;bar-fill green&apos; style=&apos;width:&lt;%=railPct%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong&gt;&lt;%=railCount%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;bar-row&apos;&gt;&lt;span&gt;Sea&lt;/span&gt;&lt;div class=&apos;bar-track&apos;&gt;&lt;div class=&apos;bar-fill red&apos; style=&apos;width:&lt;%=seaPct%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong&gt;&lt;%=seaCount%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/article&gt;\n\n\t\t\t&lt;article class=&apos;zcs-card section-card span-7&apos;&gt;\n\t\t\t\t&lt;div class=&apos;section-title&apos;&gt;&lt;h2&gt;Net revenue trend&lt;/h2&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Report:All_Shipments&apos;&gt;Shipment financials&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;bars&apos;&gt;&lt;div class=&apos;bar-row&apos;&gt;&lt;span&gt;Last 30 days&lt;/span&gt;&lt;div class=&apos;bar-track&apos;&gt;&lt;div class=&apos;bar-fill green&apos; style=&apos;width:&lt;%=rev30Pct%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong&gt;₹&lt;%=rev30.toString(&quot;##,##,###&quot;)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;bar-row&apos;&gt;&lt;span&gt;31–60 days&lt;/span&gt;&lt;div class=&apos;bar-track&apos;&gt;&lt;div class=&apos;bar-fill&apos; style=&apos;width:&lt;%=rev60Pct%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong&gt;₹&lt;%=rev60.toString(&quot;##,##,###&quot;)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;bar-row&apos;&gt;&lt;span&gt;61–90 days&lt;/span&gt;&lt;div class=&apos;bar-track&apos;&gt;&lt;div class=&apos;bar-fill alt&apos; style=&apos;width:&lt;%=rev90Pct%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong&gt;₹&lt;%=rev90.toString(&quot;##,##,###&quot;)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;bar-row&apos;&gt;&lt;span&gt;91–120 days&lt;/span&gt;&lt;div class=&apos;bar-track&apos;&gt;&lt;div class=&apos;bar-fill red&apos; style=&apos;width:&lt;%=rev120Pct%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong&gt;₹&lt;%=rev120.toString(&quot;##,##,###&quot;)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;/article&gt;\n\t\t\t&lt;article class=&apos;zcs-card section-card span-5&apos;&gt;\n\t\t\t\t&lt;div class=&apos;section-title&apos;&gt;&lt;h2&gt;Hub throughput&lt;/h2&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Report:Hub_Map&apos;&gt;Hub map&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;hub-grid&apos;&gt;\n\t\t\t\t&lt;% for each hubRec in Hubs[Status == &quot;Active&quot;] sort by Hub_Name asc range from 0 to 5 { hubLoad = Shipment_Requests[Current_Hub == hubRec.ID &amp;&amp; Shipment_Status != &quot;Delivered&quot; &amp;&amp; Shipment_Status != &quot;Cancelled&quot;].count(); %&gt;\n\t\t\t\t\t&lt;div class=&apos;hub-card&apos;&gt;&lt;div class=&apos;hub-number&apos;&gt;&lt;%=hubLoad%&gt;&lt;/div&gt;&lt;div class=&apos;item-title&apos;&gt;&lt;%=hubRec.Hub_Name%&gt;&lt;/div&gt;&lt;div class=&apos;item-meta&apos;&gt;&lt;%=hubRec.Hub_Code%&gt; · open at hub&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;% } %&gt;&lt;/div&gt;\n\t\t\t&lt;/article&gt;\n\n\t\t\t&lt;article class=&apos;zcs-card section-card span-7&apos;&gt;\n\t\t\t\t&lt;div class=&apos;section-title&apos;&gt;&lt;h2&gt;KYC review queue&lt;/h2&gt;&lt;a class=&apos;zcs-button&apos; href=&apos;#Report:KYC_Review_Queue&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-doc&apos;&gt;&lt;/i&gt; Review all&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Customer&lt;/th&gt;&lt;th&gt;Document&lt;/th&gt;&lt;th&gt;Uploaded&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t&lt;% kycRows = KYC_Document_Requests[Verification_Status == &quot;Uploaded&quot;] sort by Uploaded_On asc range from 0 to 5; if(kycRows.count() == 0){ %&gt;&lt;tr&gt;&lt;td colspan=&apos;4&apos; class=&apos;empty&apos;&gt;No uploaded documents are awaiting review.&lt;/td&gt;&lt;/tr&gt;&lt;% } else { for each kycRow in kycRows { %&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td&gt;&lt;%=kycRow.Customer.Customer_Name.first_name%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=kycRow.Requested_Document_Name%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=if(kycRow.Uploaded_On != null,kycRow.Uploaded_On.toString(&quot;dd-MMM-yyyy HH:mm&quot;),&quot;Not recorded&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;span class=&apos;zcs-badge zcs-badge-blue&apos;&gt;&lt;i class=&apos;zc-li-outline loader-dots-06&apos;&gt;&lt;/i&gt; Awaiting review&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t&lt;% } } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/article&gt;\n\t\t\t&lt;article class=&apos;zcs-card section-card span-5&apos;&gt;\n\t\t\t\t&lt;div class=&apos;section-title&apos;&gt;&lt;h2&gt;Late manifests and tasks&lt;/h2&gt;&lt;span class=&apos;zcs-badge zcs-badge-red&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt; &lt;%=lateManifestCount + lateTaskCount%&gt; overdue&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;ul class=&apos;alert-list&apos;&gt;\n\t\t\t\t&lt;% for each lateManifest in Manifests[Planned_Departure &lt; zoho.currenttime &amp;&amp; (Manifest_Status == &quot;Draft&quot; || Manifest_Status == &quot;Ready&quot;)] sort by Planned_Departure asc range from 0 to 3 { %&gt;&lt;li class=&apos;alert-item&apos;&gt;&lt;i class=&apos;zc-li-outline transportation-truck-front&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;div class=&apos;item-title&apos;&gt;Manifest &lt;%=lateManifest.Manifest_Number%&gt; has not departed&lt;/div&gt;&lt;div class=&apos;item-meta&apos;&gt;&lt;%=lateManifest.Origin_Hub.Hub_Name%&gt; to &lt;%=lateManifest.Destination_Hub.Hub_Name%&gt; · planned &lt;%=lateManifest.Planned_Departure.toString(&quot;dd-MMM-yyyy HH:mm&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;&lt;% } %&gt;\n\t\t\t\t&lt;% for each lateTask in Agent_Tasks[Scheduled_At &lt; zoho.currenttime &amp;&amp; Task_Status != &quot;Completed&quot; &amp;&amp; Task_Status != &quot;Failed&quot;] sort by Scheduled_At asc range from 0 to 3 { %&gt;&lt;li class=&apos;alert-item&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;div class=&apos;item-title&apos;&gt;Task &lt;%=lateTask.Task_Number%&gt; is overdue&lt;/div&gt;&lt;div class=&apos;item-meta&apos;&gt;&lt;%=lateTask.Task_Type%&gt; · &lt;%=lateTask.Hub.Hub_Name%&gt; · &lt;%=lateTask.Scheduled_At.toString(&quot;dd-MMM-yyyy HH:mm&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;&lt;% } %&gt;\n\t\t\t\t&lt;% if(lateManifestCount + lateTaskCount == 0){ %&gt;&lt;li class=&apos;empty&apos;&gt;No overdue manifests or open agent tasks.&lt;/li&gt;&lt;% } %&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/article&gt;\n\n\t\t\t&lt;article class=&apos;zcs-card section-card span-6&apos;&gt;\n\t\t\t\t&lt;div class=&apos;section-title&apos;&gt;&lt;h2&gt;Top customers by shipment value&lt;/h2&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Report:All_Shipments&apos;&gt;Open shipments&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Customer&lt;/th&gt;&lt;th&gt;Shipments&lt;/th&gt;&lt;th&gt;Net value&lt;/th&gt;&lt;th&gt;Lifetime points&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t&lt;% shipmentValueRows = 0; for each valueCustomer in Customers[ID != 0] { customerShipmentCount = Shipment_Requests[Customer == valueCustomer.ID].count(); customerNetValue = ifnull(Shipment_Requests[Customer == valueCustomer.ID].sum(Net_Amount),0); if(customerShipmentCount &gt; 0) { shipmentValueRows = shipmentValueRows + 1; %&gt;&lt;tr&gt;&lt;td&gt;&lt;%=valueCustomer.Customer_Name.first_name%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=customerShipmentCount%&gt;&lt;/td&gt;&lt;td&gt;₹&lt;%=customerNetValue.toString(&quot;##,##,###.00&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=valueCustomer.Overall_Points_Earned.toString(&quot;##,##,###&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } } if(shipmentValueRows == 0){ %&gt;&lt;tr&gt;&lt;td colspan=&apos;4&apos; class=&apos;empty&apos;&gt;No customer shipment value is available.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/article&gt;\n\t\t\t&lt;article class=&apos;zcs-card section-card span-6&apos;&gt;\n\t\t\t\t&lt;div class=&apos;section-title&apos;&gt;&lt;h2&gt;Top customers by points&lt;/h2&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Report:Loyalty_Ledger&apos;&gt;Loyalty ledger&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Customer&lt;/th&gt;&lt;th&gt;Type&lt;/th&gt;&lt;th&gt;Lifetime&lt;/th&gt;&lt;th&gt;Balance&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t&lt;% for each topCustomer in Customers[ID != 0] sort by Overall_Points_Earned desc range from 0 to 5 { %&gt;&lt;tr&gt;&lt;td&gt;&lt;%=topCustomer.Customer_Name.first_name%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=topCustomer.Customer_Type%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=topCustomer.Overall_Points_Earned.toString(&quot;##,##,###&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;strong&gt;&lt;%=topCustomer.Current_Points_Balance.toString(&quot;##,##,###&quot;)%&gt;&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/article&gt;\n\n\t\t\t&lt;article class=&apos;zcs-card section-card span-8&apos;&gt;\n\t\t\t\t&lt;div class=&apos;section-title&apos;&gt;&lt;h2&gt;Agent workload&lt;/h2&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Report:Agent_Task_Board&apos;&gt;Task board&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Agent&lt;/th&gt;&lt;th&gt;Hub&lt;/th&gt;&lt;th&gt;Availability&lt;/th&gt;&lt;th&gt;Assigned&lt;/th&gt;&lt;th&gt;In progress&lt;/th&gt;&lt;th&gt;Completed today&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t&lt;% for each agentRec in Employees[Employee_Type == &quot;Agent&quot; &amp;&amp; Active == true] range from 0 to 7 { assignedCount = Agent_Tasks[Assigned_Agent == agentRec.ID &amp;&amp; Task_Status == &quot;Assigned&quot;].count(); progressCount = Agent_Tasks[Assigned_Agent == agentRec.ID &amp;&amp; (Task_Status == &quot;Accepted&quot; || Task_Status == &quot;In Progress&quot;)].count(); completedCount = Agent_Tasks[Assigned_Agent == agentRec.ID &amp;&amp; Task_Status == &quot;Completed&quot; &amp;&amp; Completed_On &gt;= zoho.currentdate].count(); badgeClass = if(agentRec.Availability_Status == &quot;Available&quot;,&quot;zcs-badge-green&quot;,if(agentRec.Availability_Status == &quot;Inactive&quot; || agentRec.Availability_Status == &quot;Off Duty&quot;,&quot;zcs-badge-red&quot;,&quot;zcs-badge-yellow&quot;)); %&gt;&lt;tr&gt;&lt;td&gt;&lt;%=agentRec.Employee_Name.first_name%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=if(agentRec.Hub != null,agentRec.Hub.Hub_Name,&quot;Unassigned&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;span class=&apos;zcs-badge &lt;%=badgeClass%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-05&apos;&gt;&lt;/i&gt; &lt;%=agentRec.Availability_Status%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;%=assignedCount%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=progressCount%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=completedCount%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/article&gt;\n\t\t\t&lt;article class=&apos;zcs-card section-card span-4&apos;&gt;\n\t\t\t\t&lt;div class=&apos;section-title&apos;&gt;&lt;h2&gt;Recent loyalty adjustments&lt;/h2&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Report:Loyalty_Ledger&apos;&gt;Open ledger&lt;/a&gt;&lt;/div&gt;&lt;ul class=&apos;activity-list&apos;&gt;\n\t\t\t\t&lt;% adjustments = Loyalty_Transactions[Transaction_Type == &quot;Adjust&quot; || Transaction_Type == &quot;Reverse&quot; || Transaction_Type == &quot;Expire&quot;] sort by Transaction_Date desc range from 0 to 5; if(adjustments.count() == 0){ %&gt;&lt;li class=&apos;empty&apos;&gt;No recent adjustments, reversals or expiry entries.&lt;/li&gt;&lt;% } else { for each adjustment in adjustments { %&gt;&lt;li class=&apos;activity-item&apos;&gt;&lt;i class=&apos;zc-li-outline business-money-coins&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;div class=&apos;item-title&apos;&gt;&lt;%=adjustment.Transaction_Type%&gt; · &lt;%=adjustment.Points.toString(&quot;##,##,###&quot;)%&gt; points&lt;/div&gt;&lt;div class=&apos;item-meta&apos;&gt;&lt;%=adjustment.Customer.Customer_Name.first_name%&gt; · &lt;%=adjustment.Transaction_Date.toString(&quot;dd-MMM-yyyy HH:mm&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;&lt;% } } %&gt;&lt;/ul&gt;\n\t\t\t&lt;/article&gt;\n\n\t\t\t&lt;article class=&apos;zcs-card section-card span-7&apos;&gt;\n\t\t\t\t&lt;div class=&apos;section-title&apos;&gt;&lt;h2&gt;Recent audit activity&lt;/h2&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Report:Audit_Trail&apos;&gt;Audit trail&lt;/a&gt;&lt;/div&gt;&lt;ul class=&apos;activity-list&apos;&gt;\n\t\t\t\t&lt;% auditRows = Audit_Log[ID != 0] sort by Event_Time desc range from 0 to 6; if(auditRows.count() == 0){ %&gt;&lt;li class=&apos;empty&apos;&gt;No audit activity has been recorded.&lt;/li&gt;&lt;% } else { for each auditRow in auditRows { auditBadge = if(auditRow.Severity == &quot;Critical&quot;,&quot;zcs-badge-red&quot;,if(auditRow.Severity == &quot;Warning&quot;,&quot;zcs-badge-yellow&quot;,&quot;zcs-badge-blue&quot;)); %&gt;&lt;li class=&apos;activity-item&apos;&gt;&lt;i class=&apos;zc-li-outline design-2-ruler-pencil&apos;&gt;&lt;/i&gt;&lt;div class=&apos;zcs-col-common&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;div class=&apos;item-title&apos;&gt;&lt;%=auditRow.Action%&gt; · &lt;%=auditRow.Entity_Type%&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge &lt;%=auditBadge%&gt;&apos;&gt;&lt;%=auditRow.Severity%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;item-meta&apos;&gt;&lt;%=auditRow.User_Email%&gt; · &lt;%=auditRow.Event_Time.toString(&quot;dd-MMM-yyyy HH:mm&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;&lt;% } } %&gt;&lt;/ul&gt;\n\t\t\t&lt;/article&gt;\n\t\t\t&lt;aside class=&apos;span-5&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-quick-actions-wrapper zcs-card&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;h2&gt;Quick actions&lt;/h2&gt;&lt;/div&gt;&lt;ul class=&apos;quick-grid&apos;&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item&apos;&gt;&lt;a class=&apos;zcs-quick-action-link&apos; href=&apos;#Form:Customers?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;span&gt;Add customer&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item&apos;&gt;&lt;a class=&apos;zcs-quick-action-link&apos; href=&apos;#Report:Rate_Matrix&apos;&gt;&lt;i class=&apos;zc-li-outline business-money-coins&apos;&gt;&lt;/i&gt;&lt;span&gt;Configure rates&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item&apos;&gt;&lt;a class=&apos;zcs-quick-action-link&apos; href=&apos;#Form:Loyalty_Programs?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline business-money-bag&apos;&gt;&lt;/i&gt;&lt;span&gt;Configure programs&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item&apos;&gt;&lt;a class=&apos;zcs-quick-action-link&apos; href=&apos;#Report:KYC_Review_Queue&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-doc&apos;&gt;&lt;/i&gt;&lt;span&gt;Review KYC&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item&apos;&gt;&lt;a class=&apos;zcs-quick-action-link&apos; href=&apos;#Form:Manifests?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline transportation-truck-front&apos;&gt;&lt;/i&gt;&lt;span&gt;Create manifest&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item&apos;&gt;&lt;a class=&apos;zcs-quick-action-link&apos; href=&apos;#Report:All_Shipments&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;span&gt;Operational reports&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;&lt;/div&gt;\n\t\t\t&lt;/aside&gt;\n\t\t&lt;/section&gt;\n\t&lt;/main&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Agent_Dashboard
		{
					displayname = "Agent Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Agent_Dashboard_Content' elementName='Agent_Dashboard_Content'>\n\t\t\t\t\t<![CDATA[htmlpage Agent_Dashboard_Content()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nloginEmail = zoho.loginuserid;\nisAgent = thisapp.permissions.isUserInProfile(&quot;Hub_Agent&quot;);\nisAdmin = thisapp.permissions.isUserInProfile(&quot;Logistics_Admin&quot;);\nagentRows = Employees[Work_Email == loginEmail &amp;&amp; Employee_Type == &quot;Agent&quot; &amp;&amp; Active == true];\n%&gt;\n&lt;style&gt;\n/* zcs-global utility sheet: included once for this page, limited to the utilities used by this mobile-first composition. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;--zcs-page-bg-color:#f3f3f4;font-size:16px;line-height:1.5}\n.zcs-row,.zcs-flex{display:flex}.zcs-row{flex-wrap:wrap}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-row-wrap{flex-wrap:wrap}.zcs-no-shrink{flex-shrink:0}.zcs-relative{position:relative}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-text-center{text-align:center}.zcs-no-underline{text-decoration:none}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-m-0{margin:0}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-6{margin-top:.375rem}.zcs-mt-8{margin-top:.5rem}.zcs-mb-0{margin-bottom:0}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-p-0{padding:0}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-card{background:var(--zcs-white-color);border:1px solid #e1e4ea;border-radius:12px}.zcs-list-none{list-style:none}\n/* ZCS badge-badge-with-icon and card-fleets-card-1 badge styles. */\n.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-green{background:#e4fcf3;border-color:#147a56;color:#116b4c}.zcs-badge-red{background:#fde3e6;border-color:#b42335;color:#9d1d2d}.zcs-badge-yellow{background:#fcf4e6;border-color:#9a6508;color:#744b04}.zcs-badge-blue{background:#e8efff;border-color:#245fca;color:#174caa}.zcs-badge-grey{background:#eceef1;border-color:#5f6670;color:#3f454d}.zcs-badge-orange{background:#fff0e8;border-color:#b94d0b;color:#8e3906}\n/* ZCS button-primary-button and quick-actions-card-type-quick-actions. */\n.zcs-button{width:auto;min-width:5rem;min-height:44px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-button:hover{filter:brightness(.96)}.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-quick-action-item{list-style:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}\n/* ZCS fleet trip summary progress and recent-activity timeline. */\n.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}.zcs-tl-dot{width:12px;height:12px;background:var(--zcs_brand_color);border:1px solid #fff;box-shadow:0 2px 6px #c4dee4}.zcs-tl-line{width:1px;background:#d8dde3;align-self:stretch;margin:4px 10px 0 5px}\n/* Agent dashboard composition. */\n*{box-sizing:border-box}.ad-shell{min-height:100%;background:var(--zcs-page-bg-color);padding:12px;color:var(--zcs-primary-text-color)}.ad-container{max-width:1180px;margin:0 auto}.ad-header{display:flex;flex-direction:column;gap:16px}.ad-header-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.ad-header-actions .zcs-button{width:100%}.ad-kpis{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:12px}.ad-kpi{min-height:112px}.ad-kpi-icon{width:40px;height:40px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.ad-main{display:grid;grid-template-columns:1fr;gap:14px;margin-top:14px}.ad-section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}.ad-task-list,.ad-manifest-list{display:grid;gap:12px}.ad-task{border-left:4px solid var(--zcs_brand_color)}.ad-task-overdue{border-left-color:#b42335}.ad-task-head,.ad-manifest-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.ad-route{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.ad-details{display:grid;grid-template-columns:1fr;gap:9px;margin-top:14px}.ad-detail{display:flex;gap:9px;align-items:flex-start;min-width:0}.ad-detail i{width:18px;color:var(--zcs-teritiary-text-color);margin-top:2px}.ad-detail span,.ad-detail a{word-break:break-word}.ad-proof{margin-top:14px}.ad-actions{display:grid;grid-template-columns:1fr;gap:8px;margin-top:14px}.ad-actions .zcs-button{width:100%}.ad-proof-ready{color:#116b4c}.ad-proof-needed{color:#8e3906}.ad-side{display:grid;gap:14px}.ad-activity-item{display:flex;align-items:stretch}.ad-activity-content{padding-bottom:14px;min-width:0}.ad-empty{min-height:130px}.ad-empty i{font-size:28px;color:var(--zcs-teritiary-text-color)}.ad-notfound{max-width:720px;margin:44px auto;text-align:center}.ad-call{color:var(--zcs_brand_color);font-weight:600}.ad-link{color:var(--zcs_brand_color)}.ad-manifest-actions{margin-top:14px}.ad-availability{align-self:flex-start}.ad-updated{white-space:nowrap}\n@media(min-width:700px){.ad-shell{padding:20px}.ad-header{flex-direction:row;align-items:flex-start;justify-content:space-between}.ad-header-actions{min-width:330px}.ad-kpis{grid-template-columns:repeat(4,minmax(0,1fr))}.ad-details{grid-template-columns:repeat(2,minmax(0,1fr))}.ad-actions{grid-template-columns:repeat(2,minmax(0,1fr))}.ad-actions .ad-wide{grid-column:1/-1}}\n@media(min-width:1020px){.ad-main{grid-template-columns:minmax(0,1.65fr) minmax(320px,.85fr)}.ad-manifest-list{grid-template-columns:repeat(2,minmax(0,1fr))}.ad-side{align-content:start}}\n&lt;/style&gt;\n&lt;div class=&apos;ad-shell&apos;&gt;&lt;div class=&apos;ad-container&apos;&gt;\n&lt;%\nif(isAgent == false &amp;&amp; isAdmin == false)\n{\n%&gt;\n&lt;div class=&apos;zcs-card zcs-p-24 ad-notfound&apos; role=&apos;alert&apos;&gt;\n\t\t&lt;i class=&apos;zc-li-outline ui-1-lock&apos;&gt;&lt;/i&gt;\n\t\t&lt;h1 class=&apos;zcs-font-24 zcs-font-semibold&apos;&gt;Access unavailable&lt;/h1&gt;\n\t\t&lt;p class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;This work queue is available only to Hub Agent and Logistics Admin profiles.&lt;/p&gt;\n&lt;/div&gt;\n&lt;%\n}\nelse if(agentRows.count() == 0)\n{\n%&gt;\n&lt;div class=&apos;zcs-card zcs-p-24 ad-notfound&apos; role=&apos;status&apos;&gt;\n\t\t&lt;i class=&apos;zc-li-outline users-1-single-body&apos;&gt;&lt;/i&gt;\n\t\t&lt;h1 class=&apos;zcs-font-24 zcs-font-semibold&apos;&gt;No active agent record is mapped&lt;/h1&gt;\n\t\t&lt;p class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;Employees.Work_Email must exactly match &lt;%=loginEmail%&gt;, Employee Type must be Agent, and Active must be selected. No operational records are shown until that identity is resolved.&lt;/p&gt;\n\t\t&lt;%if(isAdmin){%&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-no-underline&apos; href=&apos;#Report:Active_Agents&apos;&gt;&lt;i class=&apos;zc-li-outline users-1-single-body&apos;&gt;&lt;/i&gt;&lt;span&gt;Open active agents&lt;/span&gt;&lt;/a&gt;&lt;%}%&gt;\n&lt;/div&gt;\n&lt;%\n}\nelse\n{\n\t\tagent = agentRows;\n\t\tagentID = agent.ID;\n\t\tagentName = ifnull(agent.Employee_Name.first_name,&quot;&quot;);\n\t\tif(ifnull(agent.Employee_Name.last_name,&quot;&quot;) != &quot;&quot;)\n\t\t{\n\t\t\t\tagentName = agentName + &quot; &quot; + agent.Employee_Name.last_name;\n\t\t}\n\t\tavailabilityClass = &quot;zcs-badge-grey&quot;;\n\t\tavailabilityIcon = &quot;ui-2-time&quot;;\n\t\tif(agent.Availability_Status == &quot;Available&quot;)\n\t\t{\n\t\t\t\tavailabilityClass = &quot;zcs-badge-green&quot;;\n\t\t\t\tavailabilityIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t}\n\t\telse if(agent.Availability_Status == &quot;Assigned&quot;)\n\t\t{\n\t\t\t\tavailabilityClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\tavailabilityIcon = &quot;loader-dots-06&quot;;\n\t\t}\n\t\telse if(agent.Availability_Status == &quot;Off Duty&quot; || agent.Availability_Status == &quot;Inactive&quot;)\n\t\t{\n\t\t\t\tavailabilityClass = &quot;zcs-badge-red&quot;;\n\t\t\t\tavailabilityIcon = &quot;ui-1-circle-remove&quot;;\n\t\t}\n\t\tassignedCount = Agent_Tasks[Agent_User == loginEmail &amp;&amp; Assigned_Agent == agentID &amp;&amp; Task_Status == &quot;Assigned&quot;].count();\n\t\tinProgressCount = Agent_Tasks[Agent_User == loginEmail &amp;&amp; Assigned_Agent == agentID &amp;&amp; Task_Status == &quot;In Progress&quot;].count();\n\t\tcompletedTodayCount = Agent_Tasks[Agent_User == loginEmail &amp;&amp; Assigned_Agent == agentID &amp;&amp; Task_Status == &quot;Completed&quot; &amp;&amp; Completed_On &gt;= zoho.currentdate &amp;&amp; Completed_On &lt; zoho.currentdate.addDay(1)].count();\n\t\tfailedCount = Agent_Tasks[Agent_User == loginEmail &amp;&amp; Assigned_Agent == agentID &amp;&amp; Task_Status == &quot;Failed&quot;].count();\n\t\topenManifestRows = Manifests[Assigned_Agent_User == loginEmail &amp;&amp; Assigned_Agent == agentID &amp;&amp; Manifest_Status != &quot;Closed&quot; &amp;&amp; Manifest_Status != &quot;Cancelled&quot;] sort by Planned_Departure asc;\n%&gt;\n&lt;header class=&apos;zcs-card zcs-p-20 ad-header&apos;&gt;\n\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-10&apos;&gt;\n\t\t\t\t\t\t&lt;h1 class=&apos;zcs-font-24 zcs-font-semibold zcs-m-0&apos;&gt;&lt;%=agentName%&gt;&apos;s work queue&lt;/h1&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13 &lt;%=availabilityClass%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=availabilityIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=agent.Availability_Status%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-mt-6 zcs-mb-0&apos;&gt;&lt;%=ifnull(agent.Hub.Hub_Name,&quot;Hub not mapped&quot;)%&gt; · &lt;span class=&apos;ad-updated&apos;&gt;Updated &lt;%=zoho.currenttime.toString(&quot;dd-MMM-yyyy, hh:mm a&quot;)%&gt; IST&lt;/span&gt;&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;nav class=&apos;ad-header-actions&apos; aria-label=&apos;Agent reports&apos;&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md zcs-no-underline&apos; href=&apos;#Report:My_Agent_Tasks&apos;&gt;&lt;i class=&apos;zc-li-outline design-todo&apos;&gt;&lt;/i&gt;&lt;span&gt;My tasks&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md zcs-no-underline&apos; href=&apos;#Report:My_Assigned_Manifests&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;&lt;span&gt;My manifests&lt;/span&gt;&lt;/a&gt;\n\t\t&lt;/nav&gt;\n&lt;/header&gt;\n&lt;section class=&apos;ad-kpis&apos; aria-label=&apos;Daily work metrics&apos;&gt;\n&lt;%\nkpiValues = {assignedCount,inProgressCount,completedTodayCount,failedCount};\nkpiLabels = {&quot;Assigned&quot;,&quot;In progress&quot;,&quot;Completed today&quot;,&quot;Failed tasks&quot;};\nkpiIcons = {&quot;design-todo&quot;,&quot;loader-dots-06&quot;,&quot;ui-1-check-circle-08&quot;,&quot;ui-1-circle-remove&quot;};\nkpiBadgeClasses = {&quot;zcs-badge-blue&quot;,&quot;zcs-badge-orange&quot;,&quot;zcs-badge-green&quot;,&quot;zcs-badge-red&quot;};\nfor each index kpiIndex in kpiValues\n{\n%&gt;\n&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-8 zcs-p-16 ad-kpi&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;span class=&apos;ad-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=kpiIcons.get(kpiIndex)%&gt;&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12 &lt;%=kpiBadgeClasses.get(kpiIndex)%&gt;&apos;&gt;&lt;%=kpiLabels.get(kpiIndex)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;strong class=&apos;zcs-font-28&apos;&gt;&lt;%=kpiValues.get(kpiIndex).toString(&quot;##,##,##0&quot;)%&gt;&lt;/strong&gt;\n&lt;/div&gt;\n&lt;%\n}\n%&gt;\n&lt;/section&gt;\n&lt;div class=&apos;ad-main&apos;&gt;\n&lt;main&gt;\n&lt;section class=&apos;zcs-card zcs-p-16&apos;&gt;\n\t\t&lt;div class=&apos;ad-section-head&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-20 zcs-font-semibold zcs-m-0&apos;&gt;Prioritized pickup and delivery tasks&lt;/h2&gt;&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-mt-4 zcs-mb-0&apos;&gt;In progress first, then accepted and assigned; earliest schedule first.&lt;/p&gt;&lt;/div&gt;&lt;a class=&apos;ad-link zcs-font-13 zcs-font-semibold&apos; href=&apos;#Report:Agent_Task_Calendar&apos;&gt;Calendar&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;ad-task-list&apos;&gt;\n&lt;%\ntaskCounter = 0;\ntaskStates = {&quot;In Progress&quot;,&quot;Accepted&quot;,&quot;Assigned&quot;};\nfor each taskState in taskStates\n{\n\t\ttaskRows = Agent_Tasks[Agent_User == loginEmail &amp;&amp; Assigned_Agent == agentID &amp;&amp; Task_Status == taskState] sort by Scheduled_At asc;\n\t\tfor each taskRow in taskRows\n\t\t{\n\t\t\t\tif(taskCounter &lt; 12)\n\t\t\t\t{\n\t\t\t\t\t\tstatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\tstatusIcon = &quot;ui-2-time&quot;;\n\t\t\t\t\t\tif(taskRow.Task_Status == &quot;In Progress&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tstatusClass = &quot;zcs-badge-orange&quot;;\n\t\t\t\t\t\t\t\tstatusIcon = &quot;loader-dots-06&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse if(taskRow.Task_Status == &quot;Accepted&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tstatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\t\t\t\t\tstatusIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t\tisOverdue = taskRow.Scheduled_At != null &amp;&amp; taskRow.Scheduled_At &lt; zoho.currenttime;\n\t\t\t\t\t\tscheduleText = &quot;Schedule pending&quot;;\n\t\t\t\t\t\tif(taskRow.Scheduled_At != null)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tscheduleText = taskRow.Scheduled_At.toString(&quot;dd-MMM-yyyy, hh:mm a&quot;) + &quot; IST&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t\ttaskAddress = ifnull(taskRow.Task_Address.address_line_1,&quot;&quot;);\n\t\t\t\t\t\tif(ifnull(taskRow.Task_Address.address_line_2,&quot;&quot;) != &quot;&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\ttaskAddress = taskAddress + &quot;, &quot; + taskRow.Task_Address.address_line_2;\n\t\t\t\t\t\t}\n\t\t\t\t\t\ttaskAddress = taskAddress + &quot;, &quot; + ifnull(taskRow.Task_Address.district_city,&quot;&quot;) + &quot;, &quot; + ifnull(taskRow.Task_Address.state_province,&quot;&quot;) + &quot; - &quot; + ifnull(taskRow.Task_Address.postal_Code,&quot;&quot;) + &quot;, &quot; + ifnull(taskRow.Task_Address.country,&quot;India&quot;);\n\t\t\t\t\t\tshipmentNumber = taskRow.Shipment.Shipment_Number;\n\t\t\t\t\t\tproofReady = false;\n\t\t\t\t\t\tproofText = &quot;Proof file required before completion&quot;;\n\t\t\t\t\t\tif(taskRow.Task_Type == &quot;Pickup&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tproofReady = taskRow.Proof_File != null;\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tproofText = &quot;Recipient name plus proof file or signature required&quot;;\n\t\t\t\t\t\t\t\tproofReady = ifnull(taskRow.Recipient_Name,&quot;&quot;) != &quot;&quot; &amp;&amp; (taskRow.Proof_File != null || taskRow.Recipient_Signature != null);\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(proofReady)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tproofText = &quot;Required proof captured&quot;;\n\t\t\t\t\t\t}\n%&gt;\n&lt;article class=&apos;zcs-card zcs-p-16 ad-task &lt;%if(isOverdue){%&gt;ad-task-overdue&lt;%}%&gt;&apos;&gt;\n\t\t&lt;div class=&apos;ad-task-head&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-start zcs-gap-10&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;ad-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg zcs-no-shrink&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%if(taskRow.Task_Type == &quot;Pickup&quot;){%&gt;arrows-1-tail-left&lt;%}else{%&gt;arrows-1-tail-right&lt;%}%&gt;&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;&lt;%=taskRow.Task_Type%&gt; task &lt;%=taskRow.Task_Number%&gt;&lt;/h3&gt;&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-mt-4 zcs-mb-0&apos;&gt;Shipment &lt;%=shipmentNumber%&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12 &lt;%=statusClass%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=statusIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;%=taskRow.Task_Status%&gt;&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;ad-details&apos;&gt;\n\t\t\t\t&lt;div class=&apos;ad-detail&apos;&gt;&lt;i class=&apos;zc-li-outline users-1-single-body&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Contact&lt;/span&gt;&lt;br&gt;&lt;strong class=&apos;zcs-font-14&apos;&gt;&lt;%=taskRow.Contact_Name%&gt;&lt;/strong&gt; · &lt;a class=&apos;ad-call&apos; href=&apos;tel:&lt;%=taskRow.Contact_Phone%&gt;&apos;&gt;&lt;%=taskRow.Contact_Phone%&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;ad-detail&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Scheduled&lt;/span&gt;&lt;br&gt;&lt;strong class=&apos;zcs-font-14&apos;&gt;&lt;%=scheduleText%&gt;&lt;/strong&gt;&lt;%if(isOverdue){%&gt; &lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-red zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&apos;&gt;Overdue&lt;/span&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;ad-detail&apos;&gt;&lt;i class=&apos;zc-li-outline location-pin-copy&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Indian address&lt;/span&gt;&lt;br&gt;&lt;strong class=&apos;zcs-font-14&apos;&gt;&lt;%=taskAddress%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;ad-detail&apos;&gt;&lt;i class=&apos;zc-li-outline design-app&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Hub&lt;/span&gt;&lt;br&gt;&lt;strong class=&apos;zcs-font-14&apos;&gt;&lt;%=taskRow.Hub.Hub_Name%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;ad-proof zcs-flex zcs-align-items-center zcs-gap-8 &lt;%if(proofReady){%&gt;ad-proof-ready&lt;%}else{%&gt;ad-proof-needed&lt;%}%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%if(proofReady){%&gt;ui-1-check-circle-08&lt;%}else{%&gt;files-2-doc&lt;%}%&gt;&apos;&gt;&lt;/i&gt;&lt;strong class=&apos;zcs-font-13&apos;&gt;&lt;%=proofText%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;ad-actions&apos;&gt;\n\t\t\t\t&lt;%if(taskRow.Task_Status == &quot;Assigned&quot;){%&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-10 zcs-rounded-md zcs-no-underline ad-wide&apos; href=&apos;#Report:My_Agent_Tasks?ID=&lt;%=taskRow.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;Accept task&lt;/span&gt;&lt;/a&gt;&lt;%}%&gt;\n\t\t\t\t&lt;%if(taskRow.Task_Status == &quot;Accepted&quot;){%&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-10 zcs-rounded-md zcs-no-underline ad-wide&apos; href=&apos;#Report:My_Agent_Tasks?ID=&lt;%=taskRow.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline media-1-button-play&apos;&gt;&lt;/i&gt;&lt;span&gt;Start task&lt;/span&gt;&lt;/a&gt;&lt;%}%&gt;\n\t\t\t\t&lt;%if(taskRow.Task_Status == &quot;In Progress&quot;){%&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-10 zcs-rounded-md zcs-no-underline ad-wide&apos; href=&apos;#Form:Agent_Tasks?recLinkID=&lt;%=taskRow.ID%&gt;&amp;amp;viewLinkName=My_Agent_Tasks&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-doc&apos;&gt;&lt;/i&gt;&lt;span&gt;Capture proof or failure reason&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-10 zcs-rounded-md zcs-no-underline&apos; href=&apos;#Report:My_Agent_Tasks?ID=&lt;%=taskRow.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;Complete task&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-10 zcs-rounded-md zcs-no-underline&apos; href=&apos;#Report:My_Agent_Tasks?ID=&lt;%=taskRow.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;&lt;span&gt;Fail task&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;%}%&gt;\n\t\t&lt;/div&gt;\n&lt;/article&gt;\n&lt;%\n\t\t\t\t\t\ttaskCounter = taskCounter + 1;\n\t\t\t\t}\n\t\t}\n}\nif(taskCounter == 0)\n{\n%&gt;\n&lt;div class=&apos;ad-empty zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center zcs-p-20&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-medium zcs-mb-0&apos;&gt;No open tasks&lt;/h3&gt;&lt;p class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Assigned, accepted, and in-progress work will appear here.&lt;/p&gt;&lt;/div&gt;\n&lt;%\n}\n%&gt;\n\t\t&lt;/div&gt;\n&lt;/section&gt;\n&lt;section class=&apos;zcs-card zcs-p-16 zcs-mt-8&apos;&gt;\n\t\t&lt;div class=&apos;ad-section-head&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-20 zcs-font-semibold zcs-m-0&apos;&gt;Assigned manifest legs&lt;/h2&gt;&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-mt-4 zcs-mb-0&apos;&gt;One card per pickup, line-haul, transfer, or delivery leg.&lt;/p&gt;&lt;/div&gt;&lt;a class=&apos;ad-link zcs-font-13 zcs-font-semibold&apos; href=&apos;#Report:My_Assigned_Manifests&apos;&gt;Open report&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;ad-manifest-list&apos;&gt;\n&lt;%\nmanifestCounter = 0;\nfor each manifestRow in openManifestRows\n{\n\t\tif(manifestCounter &lt; 8)\n\t\t{\n\t\t\t\tmanifestStatusClass = &quot;zcs-badge-grey&quot;;\n\t\t\t\tif(manifestRow.Manifest_Status == &quot;Ready&quot;)\n\t\t\t\t{\n\t\t\t\t\t\tmanifestStatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\t}\n\t\t\t\telse if(manifestRow.Manifest_Status == &quot;Dispatched&quot;)\n\t\t\t\t{\n\t\t\t\t\t\tmanifestStatusClass = &quot;zcs-badge-orange&quot;;\n\t\t\t\t}\n\t\t\t\telse if(manifestRow.Manifest_Status == &quot;Arrived&quot;)\n\t\t\t\t{\n\t\t\t\t\t\tmanifestStatusClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t}\n\t\t\t\tdepartureText = &quot;Not planned&quot;;\n\t\t\t\tarrivalText = &quot;Not planned&quot;;\n\t\t\t\tif(manifestRow.Planned_Departure != null){departureText = manifestRow.Planned_Departure.toString(&quot;dd-MMM-yyyy, hh:mm a&quot;) + &quot; IST&quot;;}\n\t\t\t\tif(manifestRow.Planned_Arrival != null){arrivalText = manifestRow.Planned_Arrival.toString(&quot;dd-MMM-yyyy, hh:mm a&quot;) + &quot; IST&quot;;}\n\t\t\t\tmanifestActionText = &quot;Open manifest&quot;;\n\t\t\t\tmanifestActionIcon = &quot;arrows-1-tail-right&quot;;\n\t\t\t\tif(manifestRow.Manifest_Status == &quot;Ready&quot;)\n\t\t\t\t{\n\t\t\t\t\t\tmanifestActionText = &quot;Dispatch manifest&quot;;\n\t\t\t\t\t\tmanifestActionIcon = &quot;media-1-button-play&quot;;\n\t\t\t\t}\n\t\t\t\telse if(manifestRow.Manifest_Status == &quot;Dispatched&quot;)\n\t\t\t\t{\n\t\t\t\t\t\tmanifestActionText = &quot;Record arrival&quot;;\n\t\t\t\t\t\tmanifestActionIcon = &quot;location-pin-copy&quot;;\n\t\t\t\t}\n%&gt;\n&lt;article class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-10 zcs-p-16&apos;&gt;\n\t\t&lt;div class=&apos;ad-manifest-head&apos;&gt;&lt;div&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Manifest &lt;%=manifestRow.Manifest_Number%&gt;&lt;/h3&gt;&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-mt-4 zcs-mb-0&apos;&gt;&lt;%=manifestRow.Manifest_Type%&gt; · &lt;%=manifestRow.Transport_Mode%&gt;&lt;/p&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12 &lt;%=manifestStatusClass%&gt;&apos;&gt;&lt;%=manifestRow.Manifest_Status%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;ad-route zcs-font-14 zcs-font-medium&apos;&gt;&lt;i class=&apos;zc-li-outline location-pin-copy zcs-color-tertiary&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=manifestRow.Origin_Hub.Hub_Name%&gt;&lt;/span&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=manifestRow.Destination_Hub.Hub_Name%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt; Depart &lt;%=departureText%&gt;&lt;br&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-60&apos;&gt;&lt;/i&gt; Arrive &lt;%=arrivalText%&gt;&lt;/div&gt;\n\t\t&lt;%if(ifnull(manifestRow.Vehicle_or_Carrier_Details,&quot;&quot;) != &quot;&quot;){%&gt;&lt;div class=&apos;zcs-font-13&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt; &lt;%=manifestRow.Vehicle_or_Carrier_Details%&gt;&lt;/div&gt;&lt;%}%&gt;\n\t\t&lt;div class=&apos;ad-manifest-actions&apos;&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-10 zcs-rounded-md zcs-no-underline zcs-w-full&apos; href=&apos;#Report:My_Assigned_Manifests?ID=&lt;%=manifestRow.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=manifestActionIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=manifestActionText%&gt;&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n&lt;/article&gt;\n&lt;%\n\t\t\t\tmanifestCounter = manifestCounter + 1;\n\t\t}\n}\nif(manifestCounter == 0)\n{\n%&gt;\n&lt;div class=&apos;ad-empty zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center zcs-p-20&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-medium zcs-mb-0&apos;&gt;No assigned manifest legs&lt;/h3&gt;&lt;p class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Open manifest work assigned to this agent will appear here.&lt;/p&gt;&lt;/div&gt;\n&lt;%\n}\n%&gt;\n\t\t&lt;/div&gt;\n&lt;/section&gt;\n&lt;/main&gt;\n&lt;aside class=&apos;ad-side&apos;&gt;\n&lt;section class=&apos;zcs-card zcs-p-16&apos;&gt;\n\t\t&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Proof checklist&lt;/h2&gt;\n\t\t&lt;div class=&apos;zcs-fleet-trip-summary zcs-flex zcs-direction-column zcs-gap-16 zcs-mt-8&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%if(inProgressCount &gt; 0){%&gt;50&lt;%}else{%&gt;100&lt;%}%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-align-items-start zcs-gap-10 zcs-list-none&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-doc zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-14&apos;&gt;Pickup: upload one proof file before completion.&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-align-items-start zcs-gap-10 zcs-list-none&apos;&gt;&lt;i class=&apos;zc-li-outline design-signature zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-14&apos;&gt;Delivery: enter recipient name and capture a proof file or signature.&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-align-items-start zcs-gap-10 zcs-list-none&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-14&apos;&gt;Failure: enter a clear failure reason before using Fail Task.&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t&lt;/div&gt;\n&lt;/section&gt;\n&lt;section class=&apos;zcs-card zcs-p-16&apos;&gt;\n\t\t&lt;div class=&apos;ad-section-head&apos;&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Recent completed activity&lt;/h2&gt;&lt;a class=&apos;ad-link zcs-font-13 zcs-font-semibold&apos; href=&apos;#Report:My_Agent_Tasks&apos;&gt;View all&lt;/a&gt;&lt;/div&gt;\n&lt;%\nrecentRows = Agent_Tasks[Agent_User == loginEmail &amp;&amp; Assigned_Agent == agentID &amp;&amp; Task_Status == &quot;Completed&quot;] sort by Completed_On desc;\nrecentCounter = 0;\nfor each recentRow in recentRows\n{\n\t\tif(recentCounter &lt; 6)\n\t\t{\n\t\t\t\tcompletedText = &quot;Completion time not recorded&quot;;\n\t\t\t\tif(recentRow.Completed_On != null){completedText = recentRow.Completed_On.toString(&quot;dd-MMM-yyyy, hh:mm a&quot;) + &quot; IST&quot;;}\n%&gt;\n&lt;div class=&apos;ad-activity-item&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-align-items-center&apos;&gt;&lt;span class=&apos;zcs-tl-dot zcs-rounded-half&apos;&gt;&lt;/span&gt;&lt;span class=&apos;zcs-tl-line&apos;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;ad-activity-content&apos;&gt;&lt;a class=&apos;ad-link zcs-font-14 zcs-font-semibold&apos; href=&apos;#Report:My_Agent_Tasks?ID=&lt;%=recentRow.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;%=recentRow.Task_Type%&gt; &lt;%=recentRow.Task_Number%&gt;&lt;/a&gt;&lt;p class=&apos;zcs-font-12 zcs-color-secondary zcs-mt-4 zcs-mb-0&apos;&gt;Shipment &lt;%=recentRow.Shipment.Shipment_Number%&gt; · &lt;%=completedText%&gt;&lt;/p&gt;&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t\t\t\trecentCounter = recentCounter + 1;\n\t\t}\n}\nif(recentCounter == 0)\n{\n%&gt;\n&lt;div class=&apos;ad-empty zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;p class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;No completed activity yet.&lt;/p&gt;&lt;/div&gt;\n&lt;%\n}\n%&gt;\n&lt;/section&gt;\n&lt;section class=&apos;zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16&apos;&gt;\n\t\t&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Quick access&lt;/h2&gt;\n\t\t&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-10 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary zcs-no-underline&apos; href=&apos;#Report:My_Agent_Tasks&apos;&gt;&lt;i class=&apos;zc-li-outline design-todo&apos;&gt;&lt;/i&gt;&lt;span&gt;Open assigned tasks&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary zcs-no-underline&apos; href=&apos;#Report:Agent_Task_Calendar&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-60&apos;&gt;&lt;/i&gt;&lt;span&gt;Open task calendar&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary zcs-no-underline&apos; href=&apos;#Report:My_Assigned_Manifests&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;&lt;span&gt;Open assigned manifests&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t&lt;/ul&gt;\n&lt;/section&gt;\n&lt;/aside&gt;\n&lt;/div&gt;\n&lt;%\n}\n%&gt;\n&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Customer_Dashboard
		{
					displayname = "Customer Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Customer_Dashboard_Content' elementName='Customer_Dashboard_Content'>\n\t\t\t\t\t<![CDATA[htmlpage Customer_Dashboard_Content()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nloginEmail = zoho.loginuserid;\ncustomerRecords = Customers[Customer_Email == loginEmail || Portal_User == loginEmail];\n%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css (single page include; utility subset used by this page) ===== */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-page-bg-color:#f3f3f4;--zcs-primary-btn-color:var(--zcs_brand_color);--zcs-primary-btn-text-color:var(--zcs_brand_foreground_color);font-size:16px;line-height:1.5}\n.zcs-row,.zcs-flex{display:flex}.zcs-row{flex-wrap:wrap}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-row-wrap{flex-wrap:wrap}.zcs-no-shrink{flex-shrink:0}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-overflow-auto{overflow:auto}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-no-underline{text-decoration:none}.zcs-cursor-pointer{cursor:pointer}.zcs-list-none{list-style:none}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-white{color:#fff}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-m-0{margin:0}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mt-0{margin-top:0}.zcs-mt-5{margin-top:.3125rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mb-0{margin-bottom:0}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-p-0{padding:0}.zcs-p-2{padding:.125rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-60{padding-left:3.75rem;padding-right:3.75rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-15{gap:.9375rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-gap-32{gap:2rem}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-card{background:var(--zcs-white-color);border:1px solid #e1e4ea;border-radius:12px}\n.zcs-col-2{flex:0 0 16.6667%;max-width:16.6667%}.zcs-col-3{flex:0 0 25%;max-width:25%}.zcs-col-4{flex:0 0 33.3333%;max-width:33.3333%}.zcs-col-5{flex:0 0 41.6667%;max-width:41.6667%}.zcs-col-6{flex:0 0 50%;max-width:50%}.zcs-col-7{flex:0 0 58.3333%;max-width:58.3333%}.zcs-col-8{flex:0 0 66.6667%;max-width:66.6667%}.zcs-col-10{flex:0 0 83.3333%;max-width:83.3333%}.zcs-col-12{flex:0 0 100%;max-width:100%}\n/* ZCS: card-profile-card */\n.zcs-avatar{width:var(--zcs-avatar-size);height:var(--zcs-avatar-size);background:var(--zcs_brand_color);border-radius:var(--zcs-avatar-radius)}.zcs-avatar .zcs-avatar-img{border-radius:inherit;object-fit:cover}\n/* ZCS: badge-badge-with-icon */\n.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-green{background:#e4fcf3;border-color:#147a56;color:#116b4c}.zcs-badge-red{background:#fde3e6;border-color:#b42335;color:#9d1d2d}.zcs-badge-yellow{background:#fcf4e6;border-color:#9a6508;color:#744b04}.zcs-badge-blue{background:#e8efff;border-color:#245fca;color:#174caa}.zcs-badge-grey{background:#eceef1;border-color:#5f6670;color:#3f454d}.zcs-badge-orange{background:#fff0e8;border-color:#b94d0b;color:#8e3906}\n/* ZCS: progress-bar-range-bar-with-texts / card-fleets-performance-metrics */\n.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color,#e6e9ef)}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}\n/* ZCS: table-simple-table */\n.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper th{background:#f7f8fb;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tbody tr:first-child td{border-top-color:transparent}.zcs-table-wrapper tbody tr:hover td{background:#f7f8fb}\n/* ZCS: timeline-simple-timeline */\n.zcs-tl-indicator{width:60px;left:16.6667%}.zcs-tl-dot{width:12px;height:12px;background:var(--zcs_brand_color);border:1px solid #fff;box-shadow:0 2px 6px #c4dee4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:&quot;&quot;;display:flex;position:absolute;width:1px;height:calc(100% + 32px);background:#d5d9df;top:5px}\n/* ZCS: banner-outline-banner-with-icon */\n.zcs-outline-toast{border:1px solid}.zcs-warning-toast{background:#fef4e5;border-color:#9a6508;color:#663c01}.zcs-info-toast{background:#e4f6fd;border-color:#0875a5;color:#024361}\n/* ZCS: quick-actions-card-type-quick-actions */\n.zcs-quick-action-item{list-style:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}\n/* Dashboard composition */\n*{box-sizing:border-box}.cd-shell{background:var(--zcs-page-bg-color);min-height:100%;padding:20px;color:var(--zcs-primary-text-color)}.cd-container{max-width:1440px;margin:0 auto}.cd-grid{display:grid;gap:16px}.cd-hero-grid{grid-template-columns:minmax(0,2fr) minmax(280px,1fr)}.cd-kpis{grid-template-columns:repeat(4,minmax(0,1fr))}.cd-two{grid-template-columns:repeat(2,minmax(0,1fr))}.cd-main{grid-template-columns:minmax(0,2fr) minmax(300px,1fr)}.cd-span-2{grid-column:span 2}.cd-section{margin-top:16px}.cd-profile{min-height:100%}.cd-initials{color:var(--zcs_brand_foreground_color);font-weight:700;font-size:22px}.cd-profile-main{display:flex;align-items:flex-start;gap:16px}.cd-profile-details{min-width:0;flex:1}.cd-badges{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.cd-meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 18px;margin-top:16px}.cd-meta-item{display:flex;gap:8px;align-items:flex-start;min-width:0}.cd-meta-item i{margin-top:3px;color:var(--zcs_brand_color)}.cd-address{word-break:break-word}.cd-kpi{height:100%;min-height:128px}.cd-kpi-top{display:flex;justify-content:space-between;align-items:flex-start}.cd-kpi-icon{width:40px;height:40px;border-radius:10px;background:var(--zcs_brand_light_color,#e8efff);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;font-size:20px}.cd-kpi-value{font-variant-numeric:tabular-nums}.cd-muted{color:var(--zcs-teritiary-text-color)}.cd-tier-grid{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:start}.cd-tier-name{font-size:26px;font-weight:700;color:var(--zcs_brand_color)}.cd-value-box{background:#f7f8fb;border:1px solid var(--zcs_tertiary_border_color);padding:12px;border-radius:8px;text-align:right}.cd-actions ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.cd-action-disabled{opacity:.58;cursor:not-allowed}.cd-action-disabled:hover{border-color:#e1e4ea!important}.cd-action-disabled .zcs-quick-action-link{color:var(--zcs-teritiary-text-color)!important}.cd-action-note{display:block;font-size:12px;margin-top:3px;color:var(--zcs-teritiary-text-color)}.cd-card-header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px}.cd-card-header a{color:var(--zcs_brand_color);font-size:14px}.cd-shipment{margin-bottom:12px}.cd-shipment:last-child{margin-bottom:0}.cd-shipment-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.cd-route{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:10px;margin-top:12px}.cd-route-point{min-width:0}.cd-route-point:last-child{text-align:right}.cd-route-line{color:var(--zcs_brand_color)}.cd-timeline-compact{margin-top:16px}.cd-timeline-compact .zcs-tl-time{font-size:12px}.cd-timeline-compact .zcs-tl-content{padding-left:60px}.cd-timeline-compact .zcs-tl-indicator{left:16.6667%}.cd-redemption-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.cd-summary-box{background:#f7f8fb;border:1px solid var(--zcs_tertiary_border_color);padding:12px;border-radius:8px}.cd-summary-box strong{display:block;font-size:20px}.cd-link{color:var(--zcs_brand_color);text-decoration:none}.cd-link:hover{text-decoration:underline}.cd-primary-link{background:var(--zcs-primary-btn-color);color:var(--zcs-primary-btn-text-color);border:1px solid var(--zcs-primary-btn-color);padding:9px 13px;border-radius:7px;display:inline-flex;align-items:center;gap:7px;text-decoration:none}.cd-primary-link:hover{filter:brightness(.94)}.cd-empty{min-height:120px}.cd-empty-icon{font-size:28px;color:var(--zcs-teritiary-text-color)}.cd-report-links{display:flex;flex-wrap:wrap;gap:8px}.cd-report-links a{border:1px solid var(--zcs_tertiary_border_color);background:#fff;color:var(--zcs-primary-text-color);padding:8px 11px;border-radius:6px;text-decoration:none}.cd-report-links a:hover{border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.cd-notfound{max-width:720px;margin:60px auto;text-align:center}.cd-table-points-positive{color:#116b4c;font-weight:600}.cd-table-points-negative{color:#9d1d2d;font-weight:600}\n@media(max-width:1100px){.cd-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.cd-main{grid-template-columns:1fr}.cd-hero-grid{grid-template-columns:1fr}.cd-actions ul{grid-template-columns:repeat(4,minmax(0,1fr))}}\n@media(max-width:768px){.cd-shell{padding:12px}.cd-two,.cd-actions ul{grid-template-columns:1fr}.cd-meta{grid-template-columns:1fr}.cd-redemption-list{grid-template-columns:1fr}.cd-profile-main{flex-direction:column}.cd-route{grid-template-columns:1fr}.cd-route-line{transform:rotate(90deg);justify-self:center}.cd-route-point:last-child{text-align:left}.zcs-tl-li{flex-direction:column}.cd-timeline-compact .zcs-tl-indicator{left:0}.cd-timeline-compact .zcs-tl-time{text-align:left;padding-left:60px;margin-bottom:8px}.cd-timeline-compact .zcs-tl-content{padding-left:60px}.cd-table-hide-mobile{display:none}}\n@media(max-width:520px){.cd-kpis{grid-template-columns:1fr}.cd-tier-grid{grid-template-columns:1fr}.cd-value-box{text-align:left}.cd-shipment-head{flex-direction:column}}\n&lt;/style&gt;\n\n&lt;div class=&apos;cd-shell&apos;&gt;\n&lt;div class=&apos;cd-container&apos;&gt;\n&lt;%\nif(customerRecords.count() == 0)\n{\n%&gt;\n&lt;div class=&apos;zcs-card zcs-p-24 cd-notfound&apos;&gt;\n\t\t&lt;i class=&apos;cd-empty-icon zc-li-outline users-1-single-02&apos;&gt;&lt;/i&gt;\n\t\t&lt;h2 class=&apos;zcs-font-24 zcs-font-semibold zcs-color-primary&apos;&gt;Customer profile not found&lt;/h2&gt;\n\t\t&lt;p class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;No customer record matches &lt;%=loginEmail%&gt;. Contact support to link your portal account before using this dashboard.&lt;/p&gt;\n&lt;/div&gt;\n&lt;%\n}\nelse\n{\n\t\tcustomer = customerRecords;\n\t\tcustomerID = customer.ID;\n\t\tfirstName = ifnull(customer.Customer_Name.first_name,&quot;&quot;);\n\t\tlastName = ifnull(customer.Customer_Name.last_name,&quot;&quot;);\n\t\tfullName = (firstName + &quot; &quot; + lastName).trim();\n\t\tif(fullName == &quot;&quot;)\n\t\t{\n\t\t\t\tfullName = ifnull(customer.Company_Name,&quot;Customer&quot;);\n\t\t}\n\t\tinitialText = firstName.left(1) + lastName.left(1);\n\t\tif(initialText == &quot;&quot;)\n\t\t{\n\t\t\t\tinitialText = fullName.left(1);\n\t\t}\n\t\tcustomerType = ifnull(customer.Customer_Type,&quot;Retail&quot;);\n\t\tonboardingStatus = ifnull(customer.Onboarding_Status,&quot;New&quot;);\n\t\tkycStatus = ifnull(customer.KYC_Status,&quot;Not Required&quot;);\n\t\tisBusiness = customerType == &quot;Corporate&quot; || customerType == &quot;Wholesale&quot;;\n\t\tshipmentAllowed = isBusiness == false || onboardingStatus == &quot;Active&quot;;\n\t\toverallPoints = ifnull(customer.Overall_Points_Earned,0);\n\t\tcurrentPoints = ifnull(customer.Current_Points_Balance,0);\n\t\toverallPointsText = overallPoints.toString(&quot;##,##,##0&quot;);\n\t\tcurrentPointsText = currentPoints.toString(&quot;##,##,##0&quot;);\n\t\tactiveShipments = Shipment_Requests[Customer == customerID &amp;&amp; Shipment_Status != &quot;Delivered&quot; &amp;&amp; Shipment_Status != &quot;Cancelled&quot;];\n\t\tdeliveredShipments = Shipment_Requests[Customer == customerID &amp;&amp; Shipment_Status == &quot;Delivered&quot;];\n\t\tactiveCount = activeShipments.count();\n\t\tdeliveredCount = deliveredShipments.count();\n\t\tcurrentProgram = Loyalty_Programs[ID == customer.Current_Loyalty_Program];\n\t\ttierName = &quot;Member&quot;;\n\t\tpointValueRate = 0;\n\t\tminimumRedemption = 0;\n\t\tcurrentTierMin = 0;\n\t\tif(currentProgram.count() &gt; 0)\n\t\t{\n\t\t\t\ttierName = currentProgram.Tier_Name;\n\t\t\t\tpointValueRate = ifnull(currentProgram.Redemption_Value_Per_Point,0);\n\t\t\t\tminimumRedemption = ifnull(currentProgram.Minimum_Redemption_Points,0);\n\t\t\t\tcurrentTierMin = ifnull(currentProgram.Min_Lifetime_Points,0);\n\t\t}\n\t\tnextPrograms = Loyalty_Programs[Customer_Type == customerType &amp;&amp; Active == true &amp;&amp; Min_Lifetime_Points &gt; overallPoints] sort by Min_Lifetime_Points asc;\n\t\tnextTierName = &quot;Top tier reached&quot;;\n\t\tnextTierPoints = overallPoints;\n\t\tpointsToNext = 0;\n\t\ttierProgress = 100;\n\t\tfor each nextProgram in nextPrograms\n\t\t{\n\t\t\t\tif(nextTierName == &quot;Top tier reached&quot;)\n\t\t\t\t{\n\t\t\t\t\t\tnextTierName = nextProgram.Tier_Name;\n\t\t\t\t\t\tnextTierPoints = nextProgram.Min_Lifetime_Points;\n\t\t\t\t\t\tpointsToNext = nextTierPoints - overallPoints;\n\t\t\t\t\t\ttierSpan = nextTierPoints - currentTierMin;\n\t\t\t\t\t\tif(tierSpan &gt; 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\ttierProgress = (((overallPoints - currentTierMin) * 100.0) / tierSpan).round(0);\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\ttierProgress = 0;\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(tierProgress &lt; 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\ttierProgress = 0;\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(tierProgress &gt; 100)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\ttierProgress = 100;\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t}\n\t\tpointsRupees = (currentPoints * pointValueRate).round(2);\n\t\tpointsRupeesText = pointsRupees.toString(&quot;##,##,##0.00&quot;);\n\t\tloyaltyRows = Loyalty_Transactions[Customer == customerID] sort by Transaction_Date desc;\n\t\topenShipmentRows = Shipment_Requests[Customer == customerID &amp;&amp; Shipment_Status != &quot;Delivered&quot; &amp;&amp; Shipment_Status != &quot;Cancelled&quot;] sort by Requested_On desc;\n\t\tif(openShipmentRows.count() == 0)\n\t\t{\n\t\t\t\topenShipmentRows = Shipment_Requests[Customer == customerID] sort by Requested_On desc;\n\t\t}\n\t\tkycRows = KYC_Document_Requests[Customer == customerID &amp;&amp; (Verification_Status == &quot;Requested&quot; || Verification_Status == &quot;Rejected&quot;)] sort by Requested_On asc;\n\t\tredemptionRows = Loyalty_Redemptions[Customer == customerID] sort by Requested_On desc;\n\t\tredemptionRequested = Loyalty_Redemptions[Customer == customerID &amp;&amp; (Redemption_Status == &quot;Requested&quot; || Redemption_Status == &quot;Approved&quot;)].count();\n\t\tredemptionFulfilled = Loyalty_Redemptions[Customer == customerID &amp;&amp; (Redemption_Status == &quot;Paid&quot; || Redemption_Status == &quot;Applied&quot;)].count();\n\t\tredeemedValue = ifnull(Loyalty_Redemptions[Customer == customerID &amp;&amp; (Redemption_Status == &quot;Paid&quot; || Redemption_Status == &quot;Applied&quot;)].sum(Amount_Value),0);\n\t\tredeemedValueText = redeemedValue.toString(&quot;##,##,##0.00&quot;);\n\t\tonboardingBadgeClass = &quot;zcs-badge-yellow&quot;;\n\t\tonboardingIcon = &quot;loader-dots-06&quot;;\n\t\tif(onboardingStatus == &quot;Active&quot;)\n\t\t{\n\t\t\t\tonboardingBadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\t\tonboardingIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t}\n\t\telse if(onboardingStatus == &quot;Rejected&quot; || onboardingStatus == &quot;Suspended&quot;)\n\t\t{\n\t\t\t\tonboardingBadgeClass = &quot;zcs-badge-red&quot;;\n\t\t\t\tonboardingIcon = &quot;ui-1-circle-remove&quot;;\n\t\t}\n\t\telse if(onboardingStatus == &quot;Pending KYC&quot;)\n\t\t{\n\t\t\t\tonboardingBadgeClass = &quot;zcs-badge-blue&quot;;\n\t\t}\n\t\tkycBadgeClass = &quot;zcs-badge-grey&quot;;\n\t\tkycIcon = &quot;ui-2-time&quot;;\n\t\tif(kycStatus == &quot;Approved&quot; || kycStatus == &quot;Not Required&quot;)\n\t\t{\n\t\t\t\tkycBadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\t\tkycIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t}\n\t\telse if(kycStatus == &quot;Rejected&quot;)\n\t\t{\n\t\t\t\tkycBadgeClass = &quot;zcs-badge-red&quot;;\n\t\t\t\tkycIcon = &quot;ui-1-circle-remove&quot;;\n\t\t}\n\t\telse if(kycStatus == &quot;Under Review&quot;)\n\t\t{\n\t\t\t\tkycBadgeClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\tkycIcon = &quot;loader-dots-06&quot;;\n\t\t}\n\t\telse if(kycStatus == &quot;Documents Requested&quot;)\n\t\t{\n\t\t\t\tkycBadgeClass = &quot;zcs-badge-orange&quot;;\n\t\t\t\tkycIcon = &quot;files-2-doc&quot;;\n\t\t}\n\t\taddressText = ifnull(customer.Primary_Address.address_line_1,&quot;&quot;);\n\t\tif(ifnull(customer.Primary_Address.address_line_2,&quot;&quot;) != &quot;&quot;)\n\t\t{\n\t\t\t\taddressText = addressText + &quot;, &quot; + customer.Primary_Address.address_line_2;\n\t\t}\n\t\taddressText = addressText + &quot;, &quot; + ifnull(customer.Primary_Address.district_city,&quot;&quot;) + &quot;, &quot; + ifnull(customer.Primary_Address.state_province,&quot;&quot;) + &quot; &quot; + ifnull(customer.Primary_Address.postal_Code,&quot;&quot;) + &quot;, &quot; + ifnull(customer.Primary_Address.country,&quot;India&quot;);\n%&gt;\n\n&lt;div class=&apos;cd-grid cd-hero-grid&apos;&gt;\n\t\t&lt;section class=&apos;zcs-card zcs-p-24 cd-profile&apos; aria-labelledby=&apos;welcome-heading&apos;&gt;\n\t\t\t\t&lt;div class=&apos;cd-profile-main&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink&apos; style=&apos;--zcs-avatar-size:64px;--zcs-avatar-radius:14px&apos; aria-hidden=&apos;true&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;cd-initials&apos;&gt;&lt;%=initialText.toUpperCase()%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;cd-profile-details&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;Welcome back&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;h1 id=&apos;welcome-heading&apos; class=&apos;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-mt-5 zcs-mb-8&apos;&gt;&lt;%=fullName%&gt;&lt;/h1&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;&lt;%=customerType%&gt; customer &lt;span aria-hidden=&apos;true&apos;&gt;·&lt;/span&gt; Customer ID &lt;%=customer.Customer_ID%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;cd-badges&apos; aria-label=&apos;Account status&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=onboardingBadgeClass%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-no-shrink zc-li-outline &lt;%=onboardingIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-14&apos;&gt;Onboarding: &lt;%=onboardingStatus%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=kycBadgeClass%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-no-shrink zc-li-outline &lt;%=kycIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-14&apos;&gt;KYC: &lt;%=kycStatus%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&apos;cd-primary-link zcs-no-shrink&apos; href=&apos;#Form:Customers?recLinkID=&lt;%=customerID%&gt;&amp;amp;viewLinkName=All_Customers&amp;amp;zc_LoadIn=dialog&apos; aria-label=&apos;Edit profile&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline design-pencil-44&apos;&gt;&lt;/i&gt;&lt;span&gt;Edit profile&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;cd-meta&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;cd-meta-item&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-email-85&apos; aria-hidden=&apos;true&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-14 zcs-ellipsis&apos;&gt;&lt;%=customer.Customer_Email%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;cd-meta-item&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-phone-call&apos; aria-hidden=&apos;true&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-14&apos;&gt;&lt;%=customer.Customer_Phone%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;cd-meta-item cd-span-2&apos;&gt;&lt;i class=&apos;zc-li-outline location-pin-copy&apos; aria-hidden=&apos;true&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-14 cd-address&apos;&gt;&lt;%=addressText%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;aside class=&apos;zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border cd-actions&apos; aria-labelledby=&apos;quick-actions-heading&apos;&gt;\n\t\t\t\t&lt;h2 id=&apos;quick-actions-heading&apos; class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Quick actions&lt;/h2&gt;\n\t\t\t\t&lt;ul class=&apos;zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary&apos; href=&apos;#Form:Customers?recLinkID=&lt;%=customerID%&gt;&amp;amp;viewLinkName=All_Customers&amp;amp;zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline design-pencil-44&apos;&gt;&lt;/i&gt;&lt;span&gt;Edit profile&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\tif(shipmentAllowed)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary&apos; href=&apos;#Form:Shipment_Requests?Customer=&lt;%=customerID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;&lt;span&gt;Request shipment&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10 zcs-box-border cd-action-disabled&apos; aria-disabled=&apos;true&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-lock&apos;&gt;&lt;/i&gt;&lt;span&gt;Request shipment&lt;span class=&apos;cd-action-note&apos;&gt;Available after business KYC is approved and onboarding becomes Active.&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/span&gt;\n\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary&apos; href=&apos;#Form:Loyalty_Redemptions?Customer=&lt;%=customerID%&gt;&amp;amp;Redemption_Type=Cash%20Value&amp;amp;zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline business-coins&apos;&gt;&lt;/i&gt;&lt;span&gt;Request cash redemption&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary&apos; href=&apos;#Report:My_Shipments&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline files-2-doc&apos;&gt;&lt;/i&gt;&lt;span&gt;Open my reports&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t&lt;/aside&gt;\n&lt;/div&gt;\n\n&lt;%\nif(isBusiness &amp;&amp; shipmentAllowed == false)\n{\n%&gt;\n&lt;div class=&apos;cd-section zcs-toast zcs-outline-toast zcs-warning-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14&apos; role=&apos;status&apos;&gt;\n\t\t&lt;i class=&apos;zcs-no-shrink zc-li-outline ui-3-alert&apos; aria-hidden=&apos;true&apos;&gt;&lt;/i&gt;\n\t\t&lt;div&gt;&lt;strong&gt;Shipment requests are temporarily unavailable.&lt;/strong&gt; Your business account is &lt;%=onboardingStatus%&gt;. Complete the outstanding KYC steps below; profile access, KYC uploads, points balance, and redemption information remain available.&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n}\n%&gt;\n\n&lt;div class=&apos;cd-grid cd-kpis cd-section&apos; aria-label=&apos;Account metrics&apos;&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border cd-kpi&apos;&gt;\n\t\t\t\t&lt;div class=&apos;cd-kpi-top&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;Lifetime points earned&lt;/span&gt;&lt;span class=&apos;cd-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline sport-trophy&apos; aria-hidden=&apos;true&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;strong class=&apos;zcs-font-30 cd-kpi-value&apos;&gt;&lt;%=overallPointsText%&gt;&lt;/strong&gt;&lt;span class=&apos;zcs-font-12 cd-muted&apos;&gt;Posted earn transactions&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border cd-kpi&apos;&gt;\n\t\t\t\t&lt;div class=&apos;cd-kpi-top&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;Current points balance&lt;/span&gt;&lt;span class=&apos;cd-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline business-coins&apos; aria-hidden=&apos;true&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;strong class=&apos;zcs-font-30 cd-kpi-value&apos;&gt;&lt;%=currentPointsText%&gt;&lt;/strong&gt;&lt;span class=&apos;zcs-font-12 cd-muted&apos;&gt;Worth approximately ₹&lt;%=pointsRupeesText%&gt;&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border cd-kpi&apos;&gt;\n\t\t\t\t&lt;div class=&apos;cd-kpi-top&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;Active shipments&lt;/span&gt;&lt;span class=&apos;cd-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos; aria-hidden=&apos;true&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;strong class=&apos;zcs-font-30 cd-kpi-value&apos;&gt;&lt;%=activeCount.toString(&quot;##,##,##0&quot;)%&gt;&lt;/strong&gt;&lt;span class=&apos;zcs-font-12 cd-muted&apos;&gt;Open and in-progress requests&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border cd-kpi&apos;&gt;\n\t\t\t\t&lt;div class=&apos;cd-kpi-top&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;Delivered shipments&lt;/span&gt;&lt;span class=&apos;cd-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos; aria-hidden=&apos;true&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;strong class=&apos;zcs-font-30 cd-kpi-value&apos;&gt;&lt;%=deliveredCount.toString(&quot;##,##,##0&quot;)%&gt;&lt;/strong&gt;&lt;span class=&apos;zcs-font-12 cd-muted&apos;&gt;Lifetime successful deliveries&lt;/span&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\n&lt;div class=&apos;cd-grid cd-two cd-section&apos;&gt;\n\t\t&lt;section class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-24 zcs-box-border&apos; aria-labelledby=&apos;tier-heading&apos;&gt;\n\t\t\t\t&lt;div class=&apos;cd-tier-grid&apos;&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;Current loyalty tier&lt;/p&gt;&lt;h2 id=&apos;tier-heading&apos; class=&apos;cd-tier-name zcs-mt-5 zcs-mb-8&apos;&gt;&lt;%=tierName%&gt;&lt;/h2&gt;&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;&lt;%=overallPointsText%&gt; lifetime points&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;cd-value-box&apos;&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Points value&lt;/span&gt;&lt;strong class=&apos;zcs-font-20 zcs-color-primary&apos;&gt;₹&lt;%=pointsRupeesText%&gt;&lt;/strong&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt; at ₹&lt;%=pointValueRate.toString(&quot;##,##,##0.00&quot;)%&gt; per point&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos; role=&apos;progressbar&apos; aria-valuemin=&apos;0&apos; aria-valuemax=&apos;100&apos; aria-valuenow=&apos;&lt;%=tierProgress%&gt;&apos; aria-label=&apos;Progress to next loyalty tier&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=tierProgress%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-lh-body zcs-m-0&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-color-primary&apos;&gt;&lt;%=tierProgress%&gt;% tier progress&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-color-primary&apos;&gt;&lt;%if(pointsToNext &gt; 0){%&gt;&lt;%=pointsToNext.toString(&quot;##,##,##0&quot;)%&gt; points to &lt;%=nextTierName%&gt;&lt;%}else{%&gt;&lt;%=nextTierName%&gt;&lt;%}%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-m-0&apos;&gt;Minimum cash redemption: &lt;%=minimumRedemption.toString(&quot;##,##,##0&quot;)%&gt; points.&lt;/p&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;zcs-card zcs-p-24&apos; aria-labelledby=&apos;redemption-heading&apos;&gt;\n\t\t\t\t&lt;div class=&apos;cd-card-header&apos;&gt;&lt;h2 id=&apos;redemption-heading&apos; class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Redemption summary&lt;/h2&gt;&lt;a href=&apos;#Report:My_Redemptions&apos;&gt;View all&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;cd-redemption-list&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;cd-summary-box&apos;&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Pending review&lt;/span&gt;&lt;strong&gt;&lt;%=redemptionRequested.toString(&quot;##,##,##0&quot;)%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;cd-summary-box&apos;&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Paid or applied&lt;/span&gt;&lt;strong&gt;&lt;%=redemptionFulfilled.toString(&quot;##,##,##0&quot;)%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;cd-summary-box&apos;&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Fulfilled value&lt;/span&gt;&lt;strong&gt;₹&lt;%=redeemedValueText%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;%\n\t\t\t\tredemptionCounter = 0;\n\t\t\t\tfor each redemption in redemptionRows\n\t\t\t\t{\n\t\t\t\t\t\tif(redemptionCounter &lt; 3)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tredemptionStatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t\t\tif(redemption.Redemption_Status == &quot;Paid&quot; || redemption.Redemption_Status == &quot;Applied&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tredemptionStatusClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse if(redemption.Redemption_Status == &quot;Rejected&quot; || redemption.Redemption_Status == &quot;Cancelled&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tredemptionStatusClass = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t%&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-py-10&apos;&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;strong class=&apos;zcs-font-14&apos;&gt;&lt;%=redemption.Redemption_Type%&gt; · &lt;%=ifnull(redemption.Points_Requested,0).toString(&quot;##,##,##0&quot;)%&gt; points&lt;/strong&gt;&lt;div class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;&lt;%=redemption.Requested_On.toString(&quot;dd-MMM-yyyy, hh:mm a&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12 &lt;%=redemptionStatusClass%&gt;&apos;&gt;&lt;%=redemption.Redemption_Status%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\tredemptionCounter = redemptionCounter + 1;\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(redemptionCounter == 0)\n\t\t\t\t{\n\t\t\t\t%&gt;\n\t\t\t\t&lt;div class=&apos;zcs-nodata-wrapper cd-empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;h3 class=&apos;zcs-font-16 zcs-font-medium zcs-m-0&apos;&gt;No redemption requests yet&lt;/h3&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;%\n\t\t\t\t}\n\t\t\t\t%&gt;\n\t\t&lt;/section&gt;\n&lt;/div&gt;\n\n&lt;%\nif(kycRows.count() &gt; 0)\n{\n%&gt;\n&lt;section class=&apos;cd-section zcs-card zcs-p-20&apos; aria-labelledby=&apos;kyc-actions-heading&apos;&gt;\n\t\t&lt;div class=&apos;zcs-toast zcs-outline-toast zcs-warning-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-no-shrink zc-li-outline files-2-doc&apos; aria-hidden=&apos;true&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;div class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t\t&lt;h2 id=&apos;kyc-actions-heading&apos; class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;KYC documents need your attention&lt;/h2&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-mt-5 zcs-mb-12&apos;&gt;Upload or resubmit the requested documents. Files are reviewed securely by the logistics support team.&lt;/p&gt;\n\t\t\t\t\t\t&lt;div class=&apos;cd-report-links&apos;&gt;\n\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\tfor each kycRequest in kycRows\n\t\t\t\t\t\t{\n\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t&lt;a href=&apos;#Report:My_KYC_Documents?ID=&lt;%=kycRequest.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline cloud-upload-96&apos; aria-hidden=&apos;true&apos;&gt;&lt;/i&gt; &lt;%=kycRequest.Requested_Document_Name%&gt; · &lt;%=kycRequest.Verification_Status%&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/section&gt;\n&lt;%\n}\n%&gt;\n\n&lt;div class=&apos;cd-grid cd-main cd-section&apos;&gt;\n\t\t&lt;section class=&apos;zcs-card zcs-p-24&apos; aria-labelledby=&apos;shipments-heading&apos;&gt;\n\t\t\t\t&lt;div class=&apos;cd-card-header&apos;&gt;&lt;h2 id=&apos;shipments-heading&apos; class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Recent and open shipments&lt;/h2&gt;&lt;a href=&apos;#Report:My_Shipments&apos;&gt;View all shipments&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;%\n\t\t\t\tshipmentCounter = 0;\n\t\t\t\tfor each shipment in openShipmentRows\n\t\t\t\t{\n\t\t\t\t\t\tif(shipmentCounter &lt; 3)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tshipmentStatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\t\t\t\t\tif(shipment.Shipment_Status == &quot;Delivered&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tshipmentStatusClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse if(shipment.Shipment_Status == &quot;Cancelled&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tshipmentStatusClass = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse if(shipment.Shipment_Status == &quot;Requested&quot; || shipment.Shipment_Status == &quot;Quoted&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tshipmentStatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tpickupCity = ifnull(shipment.Pickup_Address.district_city,&quot;Pickup&quot;);\n\t\t\t\t\t\t\t\tpickupState = ifnull(shipment.Pickup_Address.state_province,&quot;&quot;);\n\t\t\t\t\t\t\t\tdeliveryCity = ifnull(shipment.Delivery_Address.district_city,&quot;Delivery&quot;);\n\t\t\t\t\t\t\t\tdeliveryState = ifnull(shipment.Delivery_Address.state_province,&quot;&quot;);\n\t\t\t\t\t\t\t\teventRows = Shipment_Tracking_Events[Shipment == shipment.ID &amp;&amp; Customer_Visible == true] sort by Event_Time desc;\n\t\t\t\t%&gt;\n\t\t\t\t&lt;article class=&apos;zcs-card zcs-p-20 cd-shipment&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;cd-shipment-head&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;&lt;a class=&apos;cd-link zcs-font-16 zcs-font-semibold&apos; href=&apos;#Report:My_Shipments?ID=&lt;%=shipment.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;Shipment &lt;%=shipment.Shipment_Number%&gt;&lt;/a&gt;&lt;div class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Requested &lt;%=shipment.Requested_On.toString(&quot;dd-MMM-yyyy, hh:mm a&quot;)%&gt; IST · &lt;%=shipment.Transport_Mode%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13 &lt;%=shipmentStatusClass%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;&lt;%=shipment.Shipment_Status%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;cd-route&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;cd-route-point&apos;&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;From&lt;/span&gt;&lt;strong class=&apos;zcs-font-14&apos;&gt;&lt;%=pickupCity%&gt;&lt;%if(pickupState != &quot;&quot;){%&gt;, &lt;%=pickupState%&gt;&lt;%}%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;cd-route-line zc-li-outline arrows-1-tail-right&apos; aria-hidden=&apos;true&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;cd-route-point&apos;&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;To&lt;/span&gt;&lt;strong class=&apos;zcs-font-14&apos;&gt;&lt;%=deliveryCity%&gt;&lt;%if(deliveryState != &quot;&quot;){%&gt;, &lt;%=deliveryState%&gt;&lt;%}%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-mt-10 zcs-mb-0&apos;&gt;&lt;i class=&apos;zc-li-outline location-pin-copy&apos; aria-hidden=&apos;true&apos;&gt;&lt;/i&gt; &lt;%=ifnull(shipment.Latest_Tracking_Text,&quot;Tracking will appear after the request is submitted.&quot;)%&gt;&lt;/p&gt;\n\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\teventCounter = 0;\n\t\t\t\t\t\tif(eventRows.count() &gt; 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-timeline-wrapper cd-timeline-compact&apos; aria-label=&apos;Shipment tracking timeline&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\tfor each eventRow in eventRows\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tif(eventCounter &lt; 4)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-tl-li zcs-row zcs-gap-0 zcs-relative zcs-list-none&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-tl-indicator zcs-flex zcs-justify-center zcs-absolute&apos;&gt;&lt;span class=&apos;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&apos;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-col-2 zcs-tl-time zcs-color-tertiary zcs-text-right&apos;&gt;&lt;%=eventRow.Event_Time.toString(&quot;dd-MMM-yyyy, hh:mm a&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-col-10 zcs-box-border cd-tl-content&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;strong class=&apos;zcs-font-14&apos;&gt;&lt;%=eventRow.Event_Type%&gt;&lt;/strong&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;&lt;%=ifnull(eventRow.Location_Text,ifnull(eventRow.Details,&quot;Status updated&quot;))%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\teventCounter = eventCounter + 1;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t\t%&gt;\n\t\t\t\t&lt;/article&gt;\n\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\tshipmentCounter = shipmentCounter + 1;\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(shipmentCounter == 0)\n\t\t\t\t{\n\t\t\t\t%&gt;\n\t\t\t\t&lt;div class=&apos;zcs-nodata-wrapper cd-empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;i class=&apos;cd-empty-icon zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-medium zcs-mt-10 zcs-mb-0&apos;&gt;No shipments yet&lt;/h3&gt;&lt;%if(shipmentAllowed){%&gt;&lt;p class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;Create your first shipment request from Quick actions.&lt;/p&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;%\n\t\t\t\t}\n\t\t\t\t%&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;aside class=&apos;zcs-card zcs-p-24&apos; aria-labelledby=&apos;reports-heading&apos;&gt;\n\t\t\t\t&lt;div class=&apos;cd-card-header&apos;&gt;&lt;h2 id=&apos;reports-heading&apos; class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;My reports&lt;/h2&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;cd-report-links zcs-direction-column&apos;&gt;\n\t\t\t\t\t\t&lt;a href=&apos;#Report:My_KYC_Documents&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-doc&apos;&gt;&lt;/i&gt; My KYC documents&lt;/a&gt;\n\t\t\t\t\t\t&lt;a href=&apos;#Report:My_Shipments&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt; My shipments&lt;/a&gt;\n\t\t\t\t\t\t&lt;a href=&apos;#Report:My_Tracking_Events&apos;&gt;&lt;i class=&apos;zc-li-outline location-pin-copy&apos;&gt;&lt;/i&gt; My tracking events&lt;/a&gt;\n\t\t\t\t\t\t&lt;a href=&apos;#Report:My_Loyalty_Transactions&apos;&gt;&lt;i class=&apos;zc-li-outline business-coins&apos;&gt;&lt;/i&gt; My loyalty transactions&lt;/a&gt;\n\t\t\t\t\t\t&lt;a href=&apos;#Report:My_Redemptions&apos;&gt;&lt;i class=&apos;zc-li-outline business-wallet-44&apos;&gt;&lt;/i&gt; My redemptions&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-toast zcs-outline-toast zcs-info-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-13 zcs-mt-10&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline travel-info&apos; aria-hidden=&apos;true&apos;&gt;&lt;/i&gt;&lt;span&gt;All links open reports already restricted to your portal-owned records.&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/aside&gt;\n&lt;/div&gt;\n\n&lt;section class=&apos;cd-section zcs-card zcs-p-24&apos; aria-labelledby=&apos;loyalty-ledger-heading&apos;&gt;\n\t\t&lt;div class=&apos;cd-card-header&apos;&gt;&lt;h2 id=&apos;loyalty-ledger-heading&apos; class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Recent loyalty transactions&lt;/h2&gt;&lt;a href=&apos;#Report:My_Loyalty_Transactions&apos;&gt;Open full ledger&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;%\n\t\tif(loyaltyRows.count() &gt; 0)\n\t\t{\n\t\t%&gt;\n\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&apos;&gt;Date and time&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&apos;&gt;Type&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium cd-table-hide-mobile&apos;&gt;Reference&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium&apos;&gt;Points&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium cd-table-hide-mobile&apos;&gt;Value&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium&apos;&gt;Balance&lt;/th&gt;\n\t\t\t\t\t\t&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\ttransactionCounter = 0;\n\t\t\t\t\t\tfor each transaction in loyaltyRows\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tif(transactionCounter &lt; 6)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tpointClass = &quot;cd-table-points-positive&quot;;\n\t\t\t\t\t\t\t\t\t\tpointPrefix = &quot;+&quot;;\n\t\t\t\t\t\t\t\t\t\tif(transaction.Points &lt; 0)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tpointClass = &quot;cd-table-points-negative&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tpointPrefix = &quot;&quot;;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-14&apos;&gt;&lt;%=transaction.Transaction_Date.toString(&quot;dd-MMM-yyyy, hh:mm a&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-14&apos;&gt;&lt;%=transaction.Transaction_Type%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-14 cd-table-hide-mobile&apos;&gt;&lt;%=ifnull(transaction.Reference_Text,&quot;—&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 &lt;%=pointClass%&gt;&apos;&gt;&lt;%=pointPrefix%&gt;&lt;%=transaction.Points.toString(&quot;##,##,##0&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 cd-table-hide-mobile&apos;&gt;₹&lt;%=ifnull(transaction.Monetary_Value,0).toString(&quot;##,##,##0.00&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&apos;&gt;&lt;%=ifnull(transaction.Balance_After,0).toString(&quot;##,##,##0&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\ttransactionCounter = transactionCounter + 1;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t%&gt;\n\t\t&lt;div class=&apos;zcs-nodata-wrapper cd-empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-medium zcs-m-0&apos;&gt;No loyalty transactions yet&lt;/h3&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/section&gt;\n&lt;%\n}\n%&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Hub_Dashboard
		{
					displayname = "Hub Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Hub_Dashboard_Content' elementName='Hub_Dashboard_Content'>\n\t\t\t\t\t<![CDATA[htmlpage Hub_Dashboard_Content()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nloginEmail = zoho.loginuserid;\nisAdmin = thisapp.permissions.isUserInProfile(&quot;Logistics_Admin&quot;);\nisHubManager = thisapp.permissions.isUserInProfile(&quot;Hub_Manager&quot;);\ncurrentEmployee = Employees[(Work_Email == loginEmail || Internal_User == loginEmail) &amp;&amp; Active == true];\nhubID = 0;\nhubContextType = &quot;Assigned hub&quot;;\ndirectHubRows = Hubs[Manager_User == loginEmail &amp;&amp; Status == &quot;Active&quot;];\nfor each directHub in directHubRows\n{\n\t\tif(hubID == 0)\n\t\t{\n\t\t\t\thubID = directHub.ID;\n\t\t}\n}\nif(hubID == 0 &amp;&amp; currentEmployee.count() &gt; 0 &amp;&amp; currentEmployee.Hub != null)\n{\n\t\thubID = currentEmployee.Hub.ID;\n}\nif(isAdmin &amp;&amp; hubID == 0)\n{\n\t\tdefaultHubRows = Hubs[Status == &quot;Active&quot;] sort by Hub_Name asc;\n\t\tfor each defaultHub in defaultHubRows\n\t\t{\n\t\t\t\tif(hubID == 0)\n\t\t\t\t{\n\t\t\t\t\t\thubID = defaultHub.ID;\n\t\t\t\t\t\thubContextType = &quot;Administrator default hub&quot;;\n\t\t\t\t}\n\t\t}\n}\nhubRows = Hubs[ID == hubID &amp;&amp; Status == &quot;Active&quot;];\n%&gt;\n&lt;style&gt;\n/* zcs-global utility sheet: included once for this page, limited to utilities used below. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#f3f3f4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;--zcs-border-color:var(--zcs_tertiary_border_color);font-size:16px;line-height:1.5}\n.zcs-row,.zcs-flex{display:flex}.zcs-row{flex-wrap:wrap}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-row-wrap{flex-wrap:wrap}.zcs-no-shrink{flex-shrink:0}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-overflow-auto{overflow:auto}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-no-underline{text-decoration:none}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-m-0{margin:0}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mt-5{margin-top:.3125rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mb-0{margin-bottom:0}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-p-0{padding:0}.zcs-p-2{padding:.125rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-60{padding-left:3.75rem;padding-right:3.75rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-gap-32{gap:2rem}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-card{background:var(--zcs-white-color);border:1px solid #e1e4ea;border-radius:12px}.zcs-list-none{list-style:none}\n.zcs-col-2{flex:0 0 16.6667%;max-width:16.6667%}.zcs-col-4{flex:0 0 33.3333%;max-width:33.3333%}.zcs-col-5{flex:0 0 41.6667%;max-width:41.6667%}.zcs-col-6{flex:0 0 50%;max-width:50%}.zcs-col-7{flex:0 0 58.3333%;max-width:58.3333%}.zcs-col-10{flex:0 0 83.3333%;max-width:83.3333%}.zcs-col-12{flex:0 0 100%;max-width:100%}\n/* ZCS: layout-dashboard KPI panels */\n.zcs-panel{border:1px solid var(--zcs_tertiary_border_color);box-shadow:0 2px 8px #f2f2f6;background:#fff}.zcs-panel-icon-wrapper{width:40px;height:40px}.zcs-panel-icon{font-size:22px}.zcs-panel-green .zcs-panel-icon-wrapper{background:#e4fcf3;color:#147a56}.zcs-panel-yellow .zcs-panel-icon-wrapper{background:#fcf4e6;color:#8a5a06}.zcs-panel-red .zcs-panel-icon-wrapper{background:#fde3e6;color:#a42135}.zcs-panel-d_blue .zcs-panel-icon-wrapper{background:#eaf2ff;color:#1652bb}.zcs-panel-l_blue .zcs-panel-icon-wrapper{background:#e8efff;color:#2a6ffc}.zcs-panel-orange .zcs-panel-icon-wrapper{background:#fdf5f3;color:#c9580a}\n/* ZCS: filled badges */\n.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-green{background:#e4fcf3;border-color:#147a56;color:#116b4c}.zcs-badge-red{background:#fde3e6;border-color:#b42335;color:#9d1d2d}.zcs-badge-yellow{background:#fcf4e6;border-color:#9a6508;color:#744b04}.zcs-badge-blue{background:#e8efff;border-color:#245fca;color:#174caa}.zcs-badge-grey{background:#eceef1;border-color:#5f6670;color:#3f454d}.zcs-badge-orange{background:#fff0e8;border-color:#b94d0b;color:#8e3906}\n/* ZCS: primary button */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color)}\n/* ZCS: quick actions */\n.zcs-quick-action-item{list-style:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}\n/* ZCS: simple table */\n.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:680px}.zcs-table-wrapper thead{top:0}.zcs-table-wrapper th{background:#f7f8fb;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tbody tr:first-child td{border-top-color:transparent}.zcs-table-wrapper tbody tr:hover td{background:#f7f8fb}\n/* ZCS: donut chart with text */\n.zcs-legend-wrapper li{list-style:none}.zcs-legend-wrapper li label:before{content:&apos;&apos;;display:inline-block;width:12px;height:12px;margin:4px 10px 4px 0;border-radius:50%}.zcs-legend-wrapper li:nth-child(1) label:before{background:#fece56}.zcs-legend-wrapper li:nth-child(2) label:before{background:#36a2eb}.zcs-legend-wrapper li:nth-child(3) label:before{background:#ff6283}.zcs-legend-wrapper li:nth-child(4) label:before{background:#28cc97}.zcs-simple-donut-chart{--donut-cx:80px;--donut-cy:80px;--donut-r:62;--donut-pi:3.14;--donut-stroke:18px}.zcs-simple-donut-chart svg{width:160px;height:160px;overflow:hidden}.zcs-simple-donut-chart circle{cx:var(--donut-cx);cy:var(--donut-cy);r:var(--donut-r);stroke-width:var(--donut-stroke);fill:transparent}.zcs-simple-donut-chart circle:nth-child(1){stroke:#fece56;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100) 500;stroke-dashoffset:calc((2 * var(--donut-pi) * var(--donut-r)) / 4)}.zcs-simple-donut-chart circle:nth-child(2){stroke:#36a2eb;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a2) / 100) 500;stroke-dashoffset:calc((2 * var(--donut-pi) * var(--donut-r)) / 4 - 2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100)}.zcs-simple-donut-chart circle:nth-child(3){stroke:#ff6283;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a3) / 100) 500;stroke-dashoffset:calc((2 * var(--donut-pi) * var(--donut-r)) / 4 - 2 * var(--donut-pi) * var(--donut-r) * (var(--donut-a1) + var(--donut-a2)) / 100)}.zcs-simple-donut-chart circle:nth-child(4){stroke:#28cc97;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a4) / 100) 500;stroke-dashoffset:calc((2 * var(--donut-pi) * var(--donut-r)) / 4 - 2 * var(--donut-pi) * var(--donut-r) * (var(--donut-a1) + var(--donut-a2) + var(--donut-a3)) / 100)}\n/* ZCS: simple timeline */\n.zcs-tl-indicator{width:44px;left:16.6667%}.zcs-tl-dot{width:12px;height:12px;background:var(--zcs_brand_color);border:1px solid #fff;box-shadow:0 2px 6px #c4dee4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:&apos;&apos;;position:absolute;width:1px;height:calc(100% + 32px);background:#d8dde3;top:5px}\n/* ZCS: outline banner */\n.zcs-outline-toast{border:1px solid}.zcs-info-toast{background:#e4f6fd;border-color:#0875a5;color:#024361}.zcs-warning-toast{background:#fef4e5;border-color:#9a6508;color:#663c01}.zcs-error-toast{background:#feedec;border-color:#b42335;color:#5f2120}\n/* Hub dashboard composition */\n*{box-sizing:border-box}.hd-shell{background:var(--zcs-page-bg-color);min-height:100%;padding:20px;color:var(--zcs-primary-text-color)}.hd-container{max-width:1520px;margin:0 auto}.hd-grid{display:grid;gap:16px}.hd-header{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}.hd-title{min-width:0}.hd-address{margin-top:7px;word-break:break-word}.hd-header-actions{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end}.hd-kpis{grid-template-columns:repeat(6,minmax(0,1fr));margin-top:16px}.hd-kpi{height:100%;min-height:118px}.hd-two{grid-template-columns:repeat(2,minmax(0,1fr));margin-top:16px}.hd-main{grid-template-columns:minmax(0,2fr) minmax(300px,1fr);margin-top:16px}.hd-section{margin-top:16px}.hd-card-header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px}.hd-card-header a,.hd-link{color:var(--zcs_brand_color);text-decoration:none}.hd-card-header a:hover,.hd-link:hover{text-decoration:underline}.hd-chart-wrap{min-height:255px}.hd-chart-inner{display:flex;align-items:center;justify-content:center;gap:28px;flex-wrap:wrap}.hd-donut-name{inset:0;display:flex;align-items:center;justify-content:center}.hd-agents{grid-template-columns:repeat(3,minmax(0,1fr))}.hd-agent-avatar{width:38px;height:38px;border-radius:50%;background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color);display:flex;align-items:center;justify-content:center;font-weight:700}.hd-agent-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:14px}.hd-agent-metric{background:#f7f8fb;border:1px solid var(--zcs_tertiary_border_color);border-radius:8px;padding:9px}.hd-agent-metric strong{display:block;font-size:18px}.hd-empty{min-height:130px}.hd-empty i{font-size:28px;color:var(--zcs-teritiary-text-color)}.hd-quick ul{display:grid;gap:10px}.hd-exception{padding:12px 0;border-top:1px solid var(--zcs_tertiary_border_color)}.hd-exception:first-of-type{border-top:0}.hd-exception-title{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.hd-table-status{white-space:nowrap}.hd-nowrap{white-space:nowrap}.hd-muted{color:var(--zcs-teritiary-text-color)}.hd-notfound{max-width:760px;margin:56px auto;text-align:center}.hd-timeline .zcs-tl-content{padding-left:44px}.hd-timeline .zcs-tl-time{font-size:12px}\n@media(max-width:1280px){.hd-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.hd-agents{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media(max-width:960px){.hd-main,.hd-two{grid-template-columns:1fr}.hd-header{flex-direction:column}.hd-header-actions{justify-content:flex-start}.hd-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media(max-width:700px){.hd-shell{padding:12px}.hd-kpis,.hd-agents{grid-template-columns:1fr}.hd-chart-inner{align-items:flex-start;justify-content:flex-start}.zcs-tl-li{flex-direction:column}.hd-timeline .zcs-tl-indicator{left:0}.hd-timeline .zcs-tl-time{text-align:left;padding-left:44px;margin-bottom:8px}.hd-timeline .zcs-tl-content{padding-left:44px}.hd-header-actions .zcs-button{width:100%}}\n&lt;/style&gt;\n&lt;div class=&apos;hd-shell&apos;&gt;&lt;div class=&apos;hd-container&apos;&gt;\n&lt;%\nif(isAdmin == false &amp;&amp; isHubManager == false)\n{\n%&gt;\n&lt;div class=&apos;zcs-toast zcs-outline-toast zcs-error-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border&apos; role=&apos;alert&apos;&gt;\n\t\t&lt;i class=&apos;zc-li-outline ui-1-lock&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;Access unavailable.&lt;/strong&gt; This operational dashboard is intended for Hub Manager and Logistics Admin profiles.&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n}\nelse if(hubRows.count() == 0)\n{\n%&gt;\n&lt;div class=&apos;zcs-card zcs-p-24 hd-notfound&apos;&gt;\n\t\t&lt;i class=&apos;zc-li-outline location-pin-copy&apos; style=&apos;font-size:32px;color:var(--zcs-teritiary-text-color)&apos;&gt;&lt;/i&gt;\n\t\t&lt;h1 class=&apos;zcs-font-24 zcs-font-semibold zcs-color-primary&apos;&gt;No active hub is mapped&lt;/h1&gt;\n\t\t&lt;p class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;No active hub could be resolved from Hubs.Manager_User or Employees.Internal_User and Work_Email for &lt;%=loginEmail%&gt;.&lt;%if(isAdmin){%&gt; Add or activate a hub, or map your employee record; administrators use the first active hub as their default context.&lt;%}else{%&gt; Contact a Logistics Admin to map your user to one hub before using operational data.&lt;%}%&gt;&lt;/p&gt;\n\t\t&lt;%if(isAdmin){%&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-no-underline&apos; href=&apos;#Form:Hubs?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;span&gt;Create hub&lt;/span&gt;&lt;/a&gt;&lt;%}%&gt;\n&lt;/div&gt;\n&lt;%\n}\nelse\n{\n\t\thub = hubRows;\n\t\thubName = hub.Hub_Name;\n\t\thubCode = hub.Hub_Code;\n\t\thubAddress = ifnull(hub.Hub_Address.address_line_1,&quot;&quot;);\n\t\tif(ifnull(hub.Hub_Address.address_line_2,&quot;&quot;) != &quot;&quot;)\n\t\t{\n\t\t\t\thubAddress = hubAddress + &quot;, &quot; + hub.Hub_Address.address_line_2;\n\t\t}\n\t\thubAddress = hubAddress + &quot;, &quot; + ifnull(hub.Hub_Address.district_city,&quot;&quot;) + &quot;, &quot; + ifnull(hub.Hub_Address.state_province,&quot;&quot;) + &quot; - &quot; + ifnull(hub.Hub_Address.postal_Code,&quot;&quot;) + &quot;, &quot; + ifnull(hub.Hub_Address.country,&quot;India&quot;);\n\t\tshipmentsAtHub = Shipment_Requests[Current_Hub == hubID &amp;&amp; Shipment_Status != &quot;Delivered&quot; &amp;&amp; Shipment_Status != &quot;Cancelled&quot;];\n\t\tpickupRows = Agent_Tasks[Hub == hubID &amp;&amp; Task_Type == &quot;Pickup&quot; &amp;&amp; Task_Status != &quot;Completed&quot; &amp;&amp; Task_Status != &quot;Failed&quot;] sort by Scheduled_At asc;\n\t\tdeliveryRows = Agent_Tasks[Hub == hubID &amp;&amp; Task_Type == &quot;Delivery&quot; &amp;&amp; Task_Status != &quot;Completed&quot; &amp;&amp; Task_Status != &quot;Failed&quot;] sort by Scheduled_At asc;\n\t\tpickupsDue = Agent_Tasks[Hub == hubID &amp;&amp; Task_Type == &quot;Pickup&quot; &amp;&amp; Task_Status != &quot;Completed&quot; &amp;&amp; Task_Status != &quot;Failed&quot; &amp;&amp; Scheduled_At &lt;= zoho.currenttime.addDay(1)];\n\t\tdeliveriesDue = Agent_Tasks[Hub == hubID &amp;&amp; Task_Type == &quot;Delivery&quot; &amp;&amp; Task_Status != &quot;Completed&quot; &amp;&amp; Task_Status != &quot;Failed&quot; &amp;&amp; Scheduled_At &lt;= zoho.currenttime.addDay(1)];\n\t\toutboundRows = Manifests[Origin_Hub == hubID &amp;&amp; Manifest_Status != &quot;Closed&quot; &amp;&amp; Manifest_Status != &quot;Cancelled&quot;] sort by Planned_Departure asc;\n\t\tinboundRows = Manifests[Destination_Hub == hubID &amp;&amp; Manifest_Status != &quot;Closed&quot; &amp;&amp; Manifest_Status != &quot;Cancelled&quot;] sort by Planned_Arrival asc;\n\t\texceptionRows = Shipment_Tracking_Events[Hub == hubID &amp;&amp; Event_Type == &quot;Exception&quot;] sort by Event_Time desc;\n\t\trecentExceptionCount = Shipment_Tracking_Events[Hub == hubID &amp;&amp; Event_Type == &quot;Exception&quot; &amp;&amp; Event_Time &gt;= zoho.currenttime.subDay(7)].count();\n\t\tagentRows = Employees[Hub == hubID &amp;&amp; Employee_Type == &quot;Agent&quot; &amp;&amp; Active == true];\n\t\tatHubStatusCount = Shipment_Requests[Current_Hub == hubID &amp;&amp; Shipment_Status == &quot;At Hub&quot;].count();\n\t\tinTransitStatusCount = Shipment_Requests[Current_Hub == hubID &amp;&amp; Shipment_Status == &quot;In Transit&quot;].count();\n\t\tpickupFlowCount = Shipment_Requests[Current_Hub == hubID &amp;&amp; (Shipment_Status == &quot;Confirmed&quot; || Shipment_Status == &quot;Pickup Assigned&quot; || Shipment_Status == &quot;Picked Up&quot;)].count();\n\t\tdistributionTotal = shipmentsAtHub.count();\n\t\tatHubPct = 0;\n\t\tinTransitPct = 0;\n\t\tpickupPct = 0;\n\t\tremainingPct = 0;\n\t\tif(distributionTotal &gt; 0)\n\t\t{\n\t\t\t\tatHubPct = ((atHubStatusCount * 100.0) / distributionTotal).round(1);\n\t\t\t\tinTransitPct = ((inTransitStatusCount * 100.0) / distributionTotal).round(1);\n\t\t\t\tpickupPct = ((pickupFlowCount * 100.0) / distributionTotal).round(1);\n\t\t\t\tremainingPct = 100 - atHubPct - inTransitPct - pickupPct;\n\t\t\t\tif(remainingPct &lt; 0)\n\t\t\t\t{\n\t\t\t\t\t\tremainingPct = 0;\n\t\t\t\t}\n\t\t}\n\t\ttimelineRows = Manifests[(Origin_Hub == hubID || Destination_Hub == hubID) &amp;&amp; Manifest_Status != &quot;Closed&quot; &amp;&amp; Manifest_Status != &quot;Cancelled&quot;] sort by Planned_Departure asc;\n%&gt;\n&lt;header class=&apos;zcs-card zcs-p-24 hd-header&apos;&gt;\n\t\t&lt;div class=&apos;hd-title&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10 zcs-row-wrap&apos;&gt;&lt;h1 class=&apos;zcs-font-24 zcs-font-semibold zcs-m-0&apos;&gt;&lt;%=hubName%&gt;&lt;/h1&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=hubCode%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-mt-5 zcs-mb-0&apos;&gt;&lt;%=hubContextType%&gt; · Updated &lt;%=zoho.currenttime.toString(&quot;dd-MMM-yyyy, hh:mm a&quot;)%&gt; IST&lt;/p&gt;\n\t\t\t\t&lt;p class=&apos;hd-address zcs-font-14 zcs-color-secondary zcs-mb-0&apos;&gt;&lt;i class=&apos;zc-li-outline location-pin-copy&apos;&gt;&lt;/i&gt; &lt;%=hubAddress%&gt;&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;nav class=&apos;hd-header-actions&apos; aria-label=&apos;Hub quick actions&apos;&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-no-underline&apos; href=&apos;#Form:Manifests?Origin_Hub=&lt;%=hubID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;span&gt;Create manifest&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-no-underline&apos; href=&apos;#Form:Agent_Tasks?Hub=&lt;%=hubID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline users-1-add-29&apos;&gt;&lt;/i&gt;&lt;span&gt;Assign agent task&lt;/span&gt;&lt;/a&gt;\n\t\t&lt;/nav&gt;\n&lt;/header&gt;\n\n&lt;section class=&apos;hd-grid hd-kpis&apos; aria-label=&apos;Hub operational metrics&apos;&gt;\n&lt;%\nkpiValues = {shipmentsAtHub.count(),pickupsDue.count(),deliveriesDue.count(),outboundRows.count(),inboundRows.count(),recentExceptionCount};\nkpiLabels = {&quot;Shipments at hub&quot;,&quot;Pickups due in 24 hours&quot;,&quot;Deliveries due in 24 hours&quot;,&quot;Outbound manifests&quot;,&quot;Inbound manifests&quot;,&quot;Exceptions in 7 days&quot;};\nkpiIcons = {&quot;transport-delivery-fast&quot;,&quot;ui-2-time&quot;,&quot;location-pin-copy&quot;,&quot;arrows-1-tail-right&quot;,&quot;arrows-1-tail-left&quot;,&quot;ui-3-alert&quot;};\nkpiClasses = {&quot;zcs-panel-d_blue&quot;,&quot;zcs-panel-yellow&quot;,&quot;zcs-panel-green&quot;,&quot;zcs-panel-l_blue&quot;,&quot;zcs-panel-orange&quot;,&quot;zcs-panel-red&quot;};\nfor each index kpiIndex in kpiValues\n{\n%&gt;\n\t\t&lt;div class=&apos;zcs-panel &lt;%=kpiClasses.get(kpiIndex)%&gt; zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border hd-kpi&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;span class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-panel-icon zc-li-outline &lt;%=kpiIcons.get(kpiIndex)%&gt;&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;strong class=&apos;zcs-font-24&apos;&gt;&lt;%=kpiValues.get(kpiIndex).toString(&quot;##,##,##0&quot;)%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;&lt;%=kpiLabels.get(kpiIndex)%&gt;&lt;/span&gt;\n\t\t&lt;/div&gt;\n&lt;%\n}\n%&gt;\n&lt;/section&gt;\n\n&lt;div class=&apos;hd-grid hd-two&apos;&gt;\n&lt;section class=&apos;zcs-card zcs-p-24 hd-chart-wrap&apos; aria-labelledby=&apos;distribution-heading&apos;&gt;\n\t\t&lt;div class=&apos;hd-card-header&apos;&gt;&lt;h2 id=&apos;distribution-heading&apos; class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Shipment status distribution&lt;/h2&gt;&lt;a href=&apos;#Report:Shipment_Status_Board&apos;&gt;Open status board&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;%if(distributionTotal &gt; 0){%&gt;\n\t\t&lt;div class=&apos;zcs-donut-chart-wrapper hd-chart-inner&apos; style=&apos;--donut-a1:&lt;%=atHubPct%&gt;;--donut-a2:&lt;%=inTransitPct%&gt;;--donut-a3:&lt;%=pickupPct%&gt;;--donut-a4:&lt;%=remainingPct%&gt;&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-donut-chart zcs-simple-donut-chart zcs-flex zcs-align-items-center zcs-justify-center zcs-relative&apos;&gt;&lt;svg class=&apos;zcs-rounded-half&apos;&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;/svg&gt;&lt;div class=&apos;hd-donut-name zcs-absolute zcs-text-center&apos;&gt;&lt;div&gt;&lt;strong class=&apos;zcs-font-24&apos;&gt;&lt;%=distributionTotal.toString(&quot;##,##,##0&quot;)%&gt;&lt;/strong&gt;&lt;div class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;open shipments&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-legend-wrapper&apos;&gt;&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\t&lt;li&gt;&lt;label class=&apos;zcs-font-14&apos;&gt;At Hub: &lt;strong&gt;&lt;%=atHubStatusCount%&gt;&lt;/strong&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li&gt;&lt;label class=&apos;zcs-font-14&apos;&gt;In Transit: &lt;strong&gt;&lt;%=inTransitStatusCount%&gt;&lt;/strong&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li&gt;&lt;label class=&apos;zcs-font-14&apos;&gt;Pickup flow: &lt;strong&gt;&lt;%=pickupFlowCount%&gt;&lt;/strong&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li&gt;&lt;label class=&apos;zcs-font-14&apos;&gt;Delivery and other: &lt;strong&gt;&lt;%=distributionTotal - atHubStatusCount - inTransitStatusCount - pickupFlowCount%&gt;&lt;/strong&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;%}else{%&gt;&lt;div class=&apos;hd-empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;&lt;h3 class=&apos;zcs-font-16 zcs-font-medium zcs-mt-8 zcs-mb-0&apos;&gt;No open shipments at this hub&lt;/h3&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}%&gt;\n&lt;/section&gt;\n&lt;section class=&apos;zcs-card zcs-p-24&apos; aria-labelledby=&apos;timeline-heading&apos;&gt;\n\t\t&lt;div class=&apos;hd-card-header&apos;&gt;&lt;h2 id=&apos;timeline-heading&apos; class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Manifest departures and arrivals&lt;/h2&gt;&lt;a href=&apos;#Report:All_Manifests&apos;&gt;Open manifests&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;%\n\t\ttimelineCounter = 0;\n\t\tif(timelineRows.count() &gt; 0)\n\t\t{\n\t\t%&gt;&lt;div class=&apos;zcs-timeline-wrapper hd-timeline&apos;&gt;&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0&apos;&gt;&lt;%\n\t\t\t\tfor each manifestRow in timelineRows\n\t\t\t\t{\n\t\t\t\t\t\tif(timelineCounter &lt; 6)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tmovementLabel = &quot;Departure&quot;;\n\t\t\t\t\t\t\t\tmovementTimeText = &quot;Not scheduled&quot;;\n\t\t\t\t\t\t\t\tif(manifestRow.Origin_Hub == hubID)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tif(manifestRow.Actual_Departure != null)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tmovementTimeText = manifestRow.Actual_Departure.toString(&quot;dd-MMM-yyyy, hh:mm a&quot;) + &quot; IST&quot;;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\telse if(manifestRow.Planned_Departure != null)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tmovementTimeText = manifestRow.Planned_Departure.toString(&quot;dd-MMM-yyyy, hh:mm a&quot;) + &quot; IST&quot;;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tmovementLabel = &quot;Arrival&quot;;\n\t\t\t\t\t\t\t\t\t\tif(manifestRow.Actual_Arrival != null)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tmovementTimeText = manifestRow.Actual_Arrival.toString(&quot;dd-MMM-yyyy, hh:mm a&quot;) + &quot; IST&quot;;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\telse if(manifestRow.Planned_Arrival != null)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tmovementTimeText = manifestRow.Planned_Arrival.toString(&quot;dd-MMM-yyyy, hh:mm a&quot;) + &quot; IST&quot;;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t%&gt;&lt;li class=&apos;zcs-tl-li zcs-row zcs-gap-0 zcs-relative zcs-list-none&apos;&gt;&lt;div class=&apos;zcs-tl-indicator zcs-flex zcs-justify-center zcs-absolute&apos;&gt;&lt;span class=&apos;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-relative&apos;&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&apos;zcs-col-2 zcs-tl-time zcs-color-tertiary zcs-text-right&apos;&gt;&lt;%=movementTimeText%&gt;&lt;/span&gt;&lt;div class=&apos;zcs-flex zcs-direction-column zcs-col-10 zcs-box-border zcs-tl-content&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-row-wrap&apos;&gt;&lt;a class=&apos;hd-link zcs-font-14 zcs-font-semibold&apos; href=&apos;#Report:All_Manifests?ID=&lt;%=manifestRow.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;%=movementLabel%&gt; &lt;%=manifestRow.Manifest_Number%&gt;&lt;/a&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=manifestRow.Manifest_Status%&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;&lt;%=manifestRow.Origin_Hub.Hub_Name%&gt; to &lt;%=manifestRow.Destination_Hub.Hub_Name%&gt; · &lt;%=manifestRow.Transport_Mode%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;&lt;%\n\t\t\t\t\t\t\t\ttimelineCounter = timelineCounter + 1;\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t%&gt;&lt;/ul&gt;&lt;/div&gt;&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t%&gt;&lt;div class=&apos;hd-empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;h3 class=&apos;zcs-font-16 zcs-font-medium zcs-mt-8 zcs-mb-0&apos;&gt;No upcoming manifest movement&lt;/h3&gt;&lt;/div&gt;&lt;/div&gt;&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/section&gt;\n&lt;/div&gt;\n\n&lt;section class=&apos;zcs-card zcs-p-24 hd-section&apos; aria-labelledby=&apos;agents-heading&apos;&gt;\n\t\t&lt;div class=&apos;hd-card-header&apos;&gt;&lt;h2 id=&apos;agents-heading&apos; class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Agent availability and workload&lt;/h2&gt;&lt;a href=&apos;#Report:Active_Agents&apos;&gt;Open active agents&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;%if(agentRows.count() &gt; 0){%&gt;&lt;div class=&apos;hd-grid hd-agents&apos;&gt;&lt;%\n\t\tagentCounter = 0;\n\t\tfor each agent in agentRows\n\t\t{\n\t\t\t\tif(agentCounter &lt; 6)\n\t\t\t\t{\n\t\t\t\t\t\tagentName = (ifnull(agent.Employee_Name.first_name,&quot;&quot;) + &quot; &quot; + ifnull(agent.Employee_Name.last_name,&quot;&quot;)).trim();\n\t\t\t\t\t\tagentInitial = ifnull(agent.Employee_Name.first_name,&quot;&quot;).left(1) + ifnull(agent.Employee_Name.last_name,&quot;&quot;).left(1);\n\t\t\t\t\t\tagentOpenTasks = Agent_Tasks[Assigned_Agent == agent.ID &amp;&amp; Task_Status != &quot;Completed&quot; &amp;&amp; Task_Status != &quot;Failed&quot;];\n\t\t\t\t\t\tagentInProgress = Agent_Tasks[Assigned_Agent == agent.ID &amp;&amp; Task_Status == &quot;In Progress&quot;].count();\n\t\t\t\t\t\tavailabilityClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\tif(agent.Availability_Status == &quot;Assigned&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tavailabilityClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse if(agent.Availability_Status == &quot;Off Duty&quot; || agent.Availability_Status == &quot;Inactive&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tavailabilityClass = &quot;zcs-badge-grey&quot;;\n\t\t\t\t\t\t}\n\t\t%&gt;&lt;article class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;hd-agent-avatar&apos;&gt;&lt;%=agentInitial.toUpperCase()%&gt;&lt;/div&gt;&lt;div style=&apos;min-width:0;flex:1&apos;&gt;&lt;strong class=&apos;zcs-font-14 zcs-ellipsis&apos;&gt;&lt;%=agentName%&gt;&lt;/strong&gt;&lt;div class=&apos;zcs-font-12 zcs-color-secondary zcs-ellipsis&apos;&gt;&lt;%=agent.Work_Email%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline &lt;%=availabilityClass%&gt; zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=agent.Availability_Status%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;hd-agent-metrics&apos;&gt;&lt;div class=&apos;hd-agent-metric&apos;&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Open tasks&lt;/span&gt;&lt;strong&gt;&lt;%=agentOpenTasks.count()%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;hd-agent-metric&apos;&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;In progress&lt;/span&gt;&lt;strong&gt;&lt;%=agentInProgress%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;/div&gt;&lt;/article&gt;&lt;%\n\t\t\t\t\t\tagentCounter = agentCounter + 1;\n\t\t\t\t}\n\t\t}\n\t\t%&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;hd-empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div&gt;&lt;i class=&apos;zc-li-outline users-1-single-02&apos;&gt;&lt;/i&gt;&lt;h3 class=&apos;zcs-font-16 zcs-font-medium zcs-mt-8 zcs-mb-0&apos;&gt;No active agents are assigned to this hub&lt;/h3&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}%&gt;\n&lt;/section&gt;\n\n&lt;div class=&apos;hd-grid hd-main&apos;&gt;\n&lt;div&gt;\n&lt;%\nqueueTypes = {&quot;Pickup&quot;,&quot;Delivery&quot;};\nfor each queueType in queueTypes\n{\n\t\tqueueRows = pickupRows;\n\t\tqueueHeading = &quot;Pickup queue&quot;;\n\t\tqueueIcon = &quot;arrows-1-tail-right&quot;;\n\t\tif(queueType == &quot;Delivery&quot;)\n\t\t{\n\t\t\t\tqueueRows = deliveryRows;\n\t\t\t\tqueueHeading = &quot;Delivery queue&quot;;\n\t\t\t\tqueueIcon = &quot;transport-delivery-fast&quot;;\n\t\t}\n%&gt;\n&lt;section class=&apos;zcs-card zcs-p-24 &lt;%if(queueType == &quot;Delivery&quot;){%&gt;hd-section&lt;%}%&gt;&apos; aria-label=&apos;&lt;%=queueHeading%&gt;&apos;&gt;\n\t\t&lt;div class=&apos;hd-card-header&apos;&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;&lt;%=queueHeading%&gt;&lt;/h2&gt;&lt;a href=&apos;#Report:Agent_Task_Board&apos;&gt;Open task board&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;%if(queueRows.count() &gt; 0){%&gt;&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-relative&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Task&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Shipment&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Scheduled&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Contact and address&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-13&apos;&gt;Shipment value&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%\n\t\tqueueCounter = 0;\n\t\tfor each taskRow in queueRows\n\t\t{\n\t\t\t\tif(queueCounter &lt; 6)\n\t\t\t\t{\n\t\t\t\t\t\tscheduleText = &quot;Not scheduled&quot;;\n\t\t\t\t\t\tif(taskRow.Scheduled_At != null)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tscheduleText = taskRow.Scheduled_At.toString(&quot;dd-MMM-yyyy, hh:mm a&quot;) + &quot; IST&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t\ttaskAddress = ifnull(taskRow.Task_Address.address_line_1,&quot;&quot;);\n\t\t\t\t\t\tif(ifnull(taskRow.Task_Address.address_line_2,&quot;&quot;) != &quot;&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\ttaskAddress = taskAddress + &quot;, &quot; + taskRow.Task_Address.address_line_2;\n\t\t\t\t\t\t}\n\t\t\t\t\t\ttaskAddress = taskAddress + &quot;, &quot; + ifnull(taskRow.Task_Address.district_city,&quot;&quot;) + &quot;, &quot; + ifnull(taskRow.Task_Address.state_province,&quot;&quot;) + &quot; - &quot; + ifnull(taskRow.Task_Address.postal_Code,&quot;&quot;);\n\t\t\t\t\t\ttaskStatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\tif(taskRow.Task_Status == &quot;In Progress&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\ttaskStatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse if(taskRow.Task_Status == &quot;Accepted&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\ttaskStatusClass = &quot;zcs-badge-orange&quot;;\n\t\t\t\t\t\t}\n\t\t%&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-font-13&apos;&gt;&lt;a class=&apos;hd-link zcs-font-semibold&apos; href=&apos;#Report:Agent_Task_Board?ID=&lt;%=taskRow.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;%=taskRow.Task_Number%&gt;&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-font-13&apos;&gt;&lt;%=taskRow.Shipment.Shipment_Number%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-font-13 hd-nowrap&apos;&gt;&lt;%=scheduleText%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-font-13&apos;&gt;&lt;strong&gt;&lt;%=taskRow.Contact_Name%&gt;&lt;/strong&gt;&lt;div class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;&lt;%=taskAddress%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-font-13 zcs-text-right hd-nowrap&apos;&gt;₹&lt;%=ifnull(taskRow.Shipment.Net_Amount,0).toString(&quot;##,##,##0.00&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-font-13 hd-table-status&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline &lt;%=taskStatusClass%&gt; zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=taskRow.Task_Status%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\tqueueCounter = queueCounter + 1;\n\t\t\t\t}\n\t\t}\n\t\t%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;hd-empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div&gt;&lt;i class=&apos;zc-li-outline &lt;%=queueIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;h3 class=&apos;zcs-font-16 zcs-font-medium zcs-mt-8 zcs-mb-0&apos;&gt;No open &lt;%=queueType.toLowerCase()%&gt; tasks&lt;/h3&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}%&gt;\n&lt;/section&gt;\n&lt;%\n}\n%&gt;\n&lt;/div&gt;\n&lt;aside&gt;\n&lt;section class=&apos;zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 hd-quick&apos; aria-labelledby=&apos;quick-heading&apos;&gt;\n\t\t&lt;h2 id=&apos;quick-heading&apos; class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Quick actions and reports&lt;/h2&gt;\n\t\t&lt;ul class=&apos;zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary zcs-no-underline&apos; href=&apos;#Form:Manifests?Origin_Hub=&lt;%=hubID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;span&gt;Create manifest&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary zcs-no-underline&apos; href=&apos;#Form:Agent_Tasks?Hub=&lt;%=hubID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline users-1-add-29&apos;&gt;&lt;/i&gt;&lt;span&gt;Assign agent task&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary zcs-no-underline&apos; href=&apos;#Report:All_Shipments?Current_Hub=&lt;%=hubID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;&lt;span&gt;Hub shipments report&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary zcs-no-underline&apos; href=&apos;#Report:All_Manifests&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-doc&apos;&gt;&lt;/i&gt;&lt;span&gt;Manifest reports&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary zcs-no-underline&apos; href=&apos;#Report:Shipment_Tracking_History?Hub=&lt;%=hubID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline location-pin-copy&apos;&gt;&lt;/i&gt;&lt;span&gt;Tracking history&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t&lt;/ul&gt;\n&lt;/section&gt;\n&lt;section class=&apos;zcs-card zcs-p-24 hd-section&apos; aria-labelledby=&apos;exceptions-heading&apos;&gt;\n\t\t&lt;div class=&apos;hd-card-header&apos;&gt;&lt;h2 id=&apos;exceptions-heading&apos; class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Recent tracking exceptions&lt;/h2&gt;&lt;a href=&apos;#Report:Shipment_Tracking_History?Hub=&lt;%=hubID%&gt;&apos;&gt;View all&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;%\n\t\texceptionCounter = 0;\n\t\tfor each exceptionRow in exceptionRows\n\t\t{\n\t\t\t\tif(exceptionCounter &lt; 6)\n\t\t\t\t{\n\t\t%&gt;&lt;article class=&apos;hd-exception&apos;&gt;&lt;div class=&apos;hd-exception-title&apos;&gt;&lt;div&gt;&lt;a class=&apos;hd-link zcs-font-14 zcs-font-semibold&apos; href=&apos;#Report:Shipment_Tracking_History?ID=&lt;%=exceptionRow.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;Shipment &lt;%=exceptionRow.Shipment.Shipment_Number%&gt;&lt;/a&gt;&lt;div class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;&lt;%=exceptionRow.Event_Time.toString(&quot;dd-MMM-yyyy, hh:mm a&quot;)%&gt; IST&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-red zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&apos;&gt;Exception&lt;/span&gt;&lt;/div&gt;&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-mt-8 zcs-mb-0&apos;&gt;&lt;%=ifnull(exceptionRow.Details,ifnull(exceptionRow.Location_Text,&quot;Operational exception recorded&quot;))%&gt;&lt;/p&gt;&lt;/article&gt;&lt;%\n\t\t\t\t\t\texceptionCounter = exceptionCounter + 1;\n\t\t\t\t}\n\t\t}\n\t\tif(exceptionCounter == 0)\n\t\t{\n\t\t%&gt;&lt;div class=&apos;hd-empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;h3 class=&apos;zcs-font-16 zcs-font-medium zcs-mt-8 zcs-mb-0&apos;&gt;No tracking exceptions recorded&lt;/h3&gt;&lt;/div&gt;&lt;/div&gt;&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/section&gt;\n&lt;/aside&gt;\n&lt;/div&gt;\n&lt;%\n}\n%&gt;\n&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Agent_Task_Reassignment_On_Success as "Notify Agent Task Reassignment"
			{
			    type = form
			    form = Agent_Tasks[Task_Status != "Completed"]
			    record event = on edit
			    description = "Notifies a newly selected agent and records a controlled pre-completion reassignment."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                assignmentHistory = Audit_Log[Entity_Type == "Agent_Tasks" && Entity_Record_ID == input.ID.toString() && (Action == "Agent Task Assigned" || Action == "Agent Task Reassigned")] sort by Event_Time desc range from 0 to 0;
			                if(assignmentHistory.count() > 0 && assignmentHistory.After_Value != input.Assigned_Agent.toString())
			                {
			                    priorAgent = Employees[ID == assignmentHistory.After_Value.toLong()];
			                    newAgent = Employees[ID == input.Assigned_Agent];
			                    if(newAgent.count() > 0)
			                    {
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : newAgent.Work_Email
			                            subject : input.Task_Type + " task reassigned to you"
			                            message : "Task " + input.Task_Number.toString() + " for shipment " + input.Shipment.toString() + " has been reassigned to you. Scheduled time: " + input.Scheduled_At.toString() + "."
			                        )
			                        newAgent.Availability_Status = "Assigned";
			                    }
			                    if(priorAgent.count() > 0)
			                    {
			                        priorOpenTasks = Agent_Tasks[Assigned_Agent == priorAgent.ID && ID != input.ID && Task_Status != "Completed" && Task_Status != "Failed"];
			                        if(priorOpenTasks.count() == 0)
			                        {
			                            priorAgent.Availability_Status = "Available";
			                        }
			                    }
			                    auditID = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        User_Email = zoho.loginuserid
			                        User_Profile = "Agent Task Reassignment"
			                        Entity_Type = "Agent_Tasks"
			                        Entity_Record_ID = input.ID.toString()
			                        Action = "Agent Task Reassigned"
			                        Before_Value = assignmentHistory.After_Value
			                        After_Value = input.Assigned_Agent.toString()
			                        Details = "Task reassigned before completion at hub " + input.Hub.toString() + "."
			                        Severity = "Info"
			                    ];
			                }
			            )
			        }
			    }
			}

			Agent_Tasks_On_Load as "Configure Agent Task on Load"
			{
			    type = form
			    form = Agent_Tasks
			    record event = on add or edit
			    description = "Protects ownership and lifecycle fields while exposing India-localized proof and exception inputs to the assigned agent."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Agent_User;
			                disable Task_Status;
			                disable Accepted_On;
			                disable Started_On;
			                disable Completed_On;
			                hide Recipient_Name;
			                hide Recipient_Signature;
			                hide Failure_Reason;
			                currentEmployee = Employees[Work_Email == zoho.loginuserid && Active == true];
			                isAgent = thisapp.permissions.isUserInProfile("Hub_Agent");
			                if(isAgent == true)
			                {
			                    disable Task_Type;
			                    disable Shipment;
			                    disable Hub;
			                    disable Assigned_Agent;
			                    disable Scheduled_At;
			                    disable Contact_Name;
			                    disable Contact_Phone;
			                    disable Task_Address;
			                    if(input.Agent_User != zoho.loginuserid)
			                    {
			                        disable Proof_File;
			                        disable Recipient_Name;
			                        disable Recipient_Signature;
			                        disable Failure_Reason;
			                        disable Agent_Notes;
			                    }
			                    else if(input.Task_Status == "In Progress")
			                    {
			                        enable Proof_File;
			                        enable Agent_Notes;
			                        show Failure_Reason;
			                        enable Failure_Reason;
			                        if(input.Task_Type == "Delivery")
			                        {
			                            show Recipient_Name;
			                            show Recipient_Signature;
			                            enable Recipient_Name;
			                            enable Recipient_Signature;
			                        }
			                    }
			                    else
			                    {
			                        disable Proof_File;
			                        disable Recipient_Name;
			                        disable Recipient_Signature;
			                        disable Failure_Reason;
			                    }
			                }
			                else if(input.Task_Type == "Delivery")
			                {
			                    show Recipient_Name;
			                    show Recipient_Signature;
			                }
			                if(input.Task_Status == "Failed")
			                {
			                    show Failure_Reason;
			                }
			            )
			        }
			    }
			}

			Agent_Tasks_On_Success as "Notify Agent Task Assignment"
			{
			    type = form
			    form = Agent_Tasks[Task_Status == "Assigned"]
			    record event = on add
			    description = "Notifies the first assignee and records the initial assignment in the audit trail."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                agentRecord = Employees[ID == input.Assigned_Agent];
			                if(agentRecord.count() > 0)
			                {
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : agentRecord.Work_Email
			                        subject : "New " + input.Task_Type + " task assigned"
			                        message : "Task " + input.Task_Number.toString() + " for shipment " + input.Shipment.toString() + " is assigned at your hub. Scheduled time: " + input.Scheduled_At.toString() + "."
			                    )
			                    agentRecord.Availability_Status = "Assigned";
			                }
			                auditID = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    User_Email = zoho.loginuserid
			                    User_Profile = "Agent Task Assignment"
			                    Entity_Type = "Agent_Tasks"
			                    Entity_Record_ID = input.ID.toString()
			                    Action = "Agent Task Assigned"
			                    After_Value = input.Assigned_Agent.toString()
			                    Details = "Task assigned to employee record " + input.Assigned_Agent.toString() + " at hub " + input.Hub.toString() + "."
			                    Severity = "Info"
			                ];
			            )
			        }
			    }
			}

			Agent_Tasks_On_Validate as "Validate Agent Task"
			{
			    type = form
			    form = Agent_Tasks
			    record event = on add or edit
			    description = "Enforces hub-agent eligibility, ownership, shipment consistency, reassignment authority, and completion evidence."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                shipmentRecord = Shipment_Requests[ID == input.Shipment];
			                hubRecord = Hubs[ID == input.Hub];
			                agentRecord = Employees[ID == input.Assigned_Agent];
			                if(shipmentRecord.count() == 0 || hubRecord.count() == 0 || hubRecord.Status != "Active")
			                {
			                    alert "Select a valid shipment and active hub.";
			                    cancel submit;
			                }
			                if(agentRecord.count() == 0 || agentRecord.Employee_Type != "Agent" || agentRecord.Active == false || agentRecord.Internal_User == null)
			                {
			                    alert "Select an active hub agent with an internal user account.";
			                    cancel submit;
			                }
			                if(agentRecord.Hub != input.Hub)
			                {
			                    alert "The assigned agent must belong to the selected hub.";
			                    cancel submit;
			                }
			                input.Agent_User = agentRecord.Internal_User;
			                expectedHub = null;
			                expectedContactName = "";
			                if(input.Task_Type == "Pickup")
			                {
			                    expectedHub = shipmentRecord.Origin_Hub;
			                    expectedContactName = shipmentRecord.Pickup_Contact_Name;
			                }
			                else
			                {
			                    expectedHub = shipmentRecord.Destination_Hub;
			                    expectedContactName = shipmentRecord.Delivery_Contact_Name;
			                }
			                if(expectedHub != input.Hub)
			                {
			                    alert "The task hub must match the shipment's " + input.Task_Type.toLowerCase() + " hub.";
			                    cancel submit;
			                }
			                duplicateOpenTasks = Agent_Tasks[Shipment == input.Shipment && Task_Type == input.Task_Type && Task_Status != "Completed" && Task_Status != "Failed"];
			                for each duplicateTask in duplicateOpenTasks
			                {
			                    if(duplicateTask.ID != input.ID)
			                    {
			                        alert "This shipment already has an open " + input.Task_Type.toLowerCase() + " task.";
			                        cancel submit;
			                    }
			                }
			                isAdministrator = thisapp.permissions.isUserInProfile("Logistics_Admin");
			                isHubManager = thisapp.permissions.isUserInProfile("Hub_Manager");
			                isAgent = thisapp.permissions.isUserInProfile("Hub_Agent");
			                isOperations = thisapp.permissions.isUserInProfile("Operations_Employee");
			                currentEmployee = Employees[Work_Email == zoho.loginuserid && Active == true];
			                if(isAdministrator == false)
			                {
			                    if(currentEmployee.count() == 0)
			                    {
			                        alert "Only active logistics employees can save agent tasks.";
			                        cancel submit;
			                    }
			                    if(isHubManager == true && currentEmployee.Hub != input.Hub)
			                    {
			                        alert "Hub managers can manage tasks only at their assigned hub.";
			                        cancel submit;
			                    }
			                    if(isOperations == true && input.ID != null)
			                    {
			                        alert "Operations employees can create and view tasks but cannot modify existing assignments.";
			                        cancel submit;
			                    }
			                    if(isAgent == true)
			                    {
			                        if(input.ID == null || input.Agent_User != zoho.loginuserid)
			                        {
			                            alert "Agents can update only their own assigned tasks.";
			                            cancel submit;
			                        }
			                        persistedTask = Agent_Tasks[ID == input.ID];
			                        if(persistedTask.Task_Type != input.Task_Type || persistedTask.Shipment != input.Shipment || persistedTask.Hub != input.Hub || persistedTask.Assigned_Agent != input.Assigned_Agent || persistedTask.Agent_User != input.Agent_User || persistedTask.Scheduled_At != input.Scheduled_At || persistedTask.Contact_Name != input.Contact_Name || persistedTask.Contact_Phone != input.Contact_Phone || persistedTask.Task_Address != input.Task_Address || persistedTask.Task_Status != input.Task_Status || persistedTask.Accepted_On != input.Accepted_On || persistedTask.Started_On != input.Started_On || persistedTask.Completed_On != input.Completed_On)
			                        {
			                            alert "Task ownership, contact details, and lifecycle fields are controlled by authorized managers and blueprint transitions.";
			                            cancel submit;
			                        }
			                    }
			                    persistedTask = Agent_Tasks[ID == input.ID];
			                    if(input.ID != null && persistedTask.Assigned_Agent != input.Assigned_Agent)
			                    {
			                        if(persistedTask.Task_Status == "Completed")
			                        {
			                            alert "Completed tasks cannot be reassigned.";
			                            cancel submit;
			                        }
			                        if(isHubManager == false)
			                        {
			                            alert "Only a hub manager or logistics administrator may reassign a task.";
			                            cancel submit;
			                        }
			                    }
			                }
			                if(input.Task_Status == "Completed")
			                {
			                    if(input.Task_Type == "Pickup" && input.Proof_File == null)
			                    {
			                        alert "Upload pickup proof before completing the task.";
			                        cancel submit;
			                    }
			                    if(input.Task_Type == "Delivery" && (input.Recipient_Name in {""," ","null"} || (input.Proof_File == null && input.Recipient_Signature == null)))
			                    {
			                        alert "Enter the recipient name and capture a proof file or signature before completing delivery.";
			                        cancel submit;
			                    }
			                }
			                if(input.Task_Status == "Failed" && input.Failure_Reason in {""," ","null"})
			                {
			                    alert "Enter a failure reason before marking the task Failed.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Task_Assigned_Agent_On_User_Input as "Copy Assigned Agent User"
			{
			    type = form
