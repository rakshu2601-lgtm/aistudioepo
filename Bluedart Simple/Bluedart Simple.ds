		    (
		        type = picklist
		        displayname = "Recorded By"
		        values = Employees.ID
		        displayformat = [Employee_Name.first_name]
		        searchable = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    Customer_Visible
		    (
		        type = checkbox
		        displayname = "Customer Visible"
		        initial value = true
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Record Event"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Event"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Close"
		            )
		        }
		    }
		}

		form Transport_Rates
		{
		    title
		    {
		        displayname = "Transport Rates"
		        on add = "Add Transport Rate"
		        on edit = "Edit Transport Rate"
		    }
		    success message = "Transport rate saved successfully."
		
		    Rate_Classification
		    (
		        type = section
		        displayname = "Rate Classification"
		        row = 1
		        column = 0
		    )
		    Rate_ID
		    (
		        type = autonumber
		        displayname = "Rate ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Rate_Name
		    (
		        type = text
		        displayname = "Rate Name"
		        maxchar = 150
		        row = 1
		        column = 1
		        width = medium
		    )
		    Customer_Type
		    (
		        type = picklist
		        displayname = "Customer Type"
		        values = {"All","Retail","Corporate","Wholesale"}
		        initial value = "All"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Transport_Mode
		    (
		        type = picklist
		        displayname = "Transport Mode"
		        values = {"Road","Air","Rail","Sea"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Priority
		    (
		        type = number
		        displayname = "Selection Priority"
		        format = commadotindian
		        initial value = 1
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Pricing_Bands
		    (
		        type = section
		        displayname = "Pricing Bands"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Min_Weight_Kg
		    (
		        type = decimal
		        displayname = "Minimum Weight (kg)"
		        format = commadotindian
		        decimalplace = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Max_Weight_Kg
		    (
		        type = decimal
		        displayname = "Maximum Weight (kg)"
		        format = commadotindian
		        decimalplace = 2
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Min_Distance_Km
		    (
		        type = decimal
		        displayname = "Minimum Distance (km)"
		        format = commadotindian
		        decimalplace = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Max_Distance_Km
		    (
		        type = decimal
		        displayname = "Maximum Distance (km)"
		        format = commadotindian
		        decimalplace = 2
		        row = 2
		        column = 2
		        width = medium
		    )
		    Base_Charge
		    (
		        type = INR
		        displayname = "Base Charge (INR)"
		        format = commadotindian
		        initial value = 0
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 1
		        width = medium
		    )
		    Charge_Per_Kg
		    (
		        type = INR
		        displayname = "Charge per kg (INR)"
		        format = commadotindian
		        initial value = 0
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 2
		        width = medium
		    )
		    Charge_Per_Km
		    (
		        type = INR
		        displayname = "Charge per km (INR)"
		        format = commadotindian
		        initial value = 0
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 1
		        width = medium
		    )
		    Minimum_Charge
		    (
		        type = INR
		        displayname = "Minimum Charge (INR)"
		        format = commadotindian
		        initial value = 0
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 2
		        width = medium
		    )
		    Fuel_Surcharge_Percent
		    (
		        type = decimal
		        displayname = "Fuel Surcharge (%)"
		        format = commadotindian
		        initial value = 0
		        decimalplace = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Effective_Period
		    (
		        type = section
		        displayname = "Effective Period"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    must have Effective_From
		    (
		        type = date
		        displayname = "Effective From"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Effective_To
		    (
		        type = date
		        displayname = "Effective To"
		        row = 3
		        column = 2
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Rate"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Rate"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		kanban Agent_Task_Board
		{
		    displayName = "Agent Task Board"
		    show all rows from Agent_Tasks
		    (
		        Task_Number
		        Task_Type
		        Shipment
		        Hub
		        Assigned_Agent
		        Agent_User
		        Scheduled_At
		        Contact_Name
		        Contact_Phone
		        (
		            displayformat = formattednumber
		            linktodial = enable
		        )
		        Task_Address
		        Task_Status
		        Accepted_On
		        Started_On
		        Completed_On
		        Failure_Reason
		        Agent_Notes
		    )
		    filters
		    (
		        Task_Type
		        Hub
		        Assigned_Agent
		        Scheduled_At
		        Task_Status
		        "Open Tasks" : (Task_Status != "Completed" && Task_Status != "Failed")
		    )
		    sort by
		    (
		        Scheduled_At ascending
		        Task_Number descending
		    )
		    options
		    (
		        display field = Task_Status
		        othercolumn = "Other"
		        filter type = manual
		        sort order = custom
		        record count = enable
		    )
		}

		calendar Agent_Task_Calendar
		{
		    displayName = "Agent Task Calendar"
		    show all rows from Agent_Tasks [Scheduled_At is not null]
		    (
		        Task_Number
		        Task_Type
		        Shipment
		        Hub
		        Assigned_Agent
		        Scheduled_At
		        Contact_Name
		        Contact_Phone
		        (
		            displayformat = formattednumber
		            linktodial = enable
		        )
		        Task_Address
		        Task_Status
		    )
		    filters
		    (
		        Task_Type
		        Hub
		        Assigned_Agent
		        Scheduled_At
		        Task_Status
		        "Open Tasks" : (Task_Status != "Completed" && Task_Status != "Failed")
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Assigned_Agent ascending
		    )
		    options
		    (
		        display type = week
		        week start day = monday
		        display field = Task_Number
		        start date = Scheduled_At
		        default date
		        (
		            day = Today
		            month = Currentmonth
		            year = Currentyear
		        )
		    )
		}

		default list My_Agent_Tasks
		{
		    displayName = "My Agent Tasks"
		    show all rows from Agent_Tasks [Agent_User == zoho.loginuserid]
		    (
		        Task_Number
		        Task_Type
		        Shipment
		        Hub
		        Assigned_Agent
		        Agent_User
		        Scheduled_At
		        Contact_Name
		        Contact_Phone
		        (
		            displayformat = formattednumber
		            linktodial = enable
		        )
		        Task_Address
		        Task_Status
		        Accepted_On
		        Started_On
		        Completed_On
		        Recipient_Name
		        Proof_File
		        Recipient_Signature
		        Failure_Reason
		        Agent_Notes
		    )
		    filters
		    (
		        Task_Type
		        Hub
		        Scheduled_At
		        Task_Status
		        "My Open Tasks" : (Task_Status != "Completed" && Task_Status != "Failed")
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Task_Status ascending
		    )
		    sort by
		    (
		        Scheduled_At ascending
		        Task_Number descending
		    )
		}

		default list Audit_Trail
		{
		    displayName = "Audit Trail"
		    show all rows from Audit_Log
		    (
		        Log_ID
		        Event_Time
		        User_Email
		        User_Profile
		        Entity_Type
		        Entity_Record_ID
		        Action
		        Before_Value
		        After_Value
		        Details
		        Severity
		    )
		    filters
		    (
		        Entity_Type
		        Action
		        User_Email
		        Severity
		        Event_Time
		        "Critical Events" : (Severity == "Critical")
		        "Warnings and Critical" : (Severity == "Warning" || Severity == "Critical")
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Entity_Type ascending
		    )
		    sort by
		    (
		        Event_Time descending
		    )
		}

		default list All_Customers
		{
		    displayName = "All Customers"
		    show all rows from Customers
		    (
		        Customer_ID
		        Customer_Name
		        Customer_Email
