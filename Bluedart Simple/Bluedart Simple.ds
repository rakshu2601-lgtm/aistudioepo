			Shipment_Tracking_Events_On_Delete as "Protect Tracking Event Deletion"
			{
			    type = form
			    form = Shipment_Tracking_Events
			    record event = on delete
			    description = "Prevents ordinary users from deleting append-only shipment history."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                isAdministrator = thisapp.permissions.isUserInProfile("Logistics_Admin");
			                if(isAdministrator == false)
			                {
			                    alert "Shipment tracking history is append-only and cannot be deleted.";
			                    cancel delete;
			                }
			            )
			        }
			    }
			}

			Shipment_Tracking_Events_On_Load as "Protect Tracking History on Load"
			{
			    type = form
			    form = Shipment_Tracking_Events
			    record event = on add or edit
			    description = "Keeps shipment ownership and timestamps system-managed and makes saved history read-only for ordinary users."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Customer_Portal_User;
			                disable Event_Time;
			                disable Recorded_By;
			                isAdministrator = thisapp.permissions.isUserInProfile("Logistics_Admin");
			                if(input.ID != null && isAdministrator == false)
			                {
			                    disable Shipment;
			                    disable Manifest;
			                    disable Agent_Task;
			                    disable Event_Type;
			                    disable Hub;
			                    disable Location_Text;
			                    disable Details;
			                    disable Customer_Visible;
			                }
			            )
			        }
			    }
			}

			Shipment_Tracking_Events_On_Success as "Synchronize Latest Tracking Summary"
			{
			    type = form
			    form = Shipment_Tracking_Events
			    record event = on add
			    description = "Keeps the shipment's latest customer-facing tracking summary aligned with new visible events."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Customer_Visible == true)
			                {
			                    shipmentRecord = Shipment_Requests[ID == input.Shipment];
			                    if(shipmentRecord.count() > 0)
			                    {
			                        summaryText = input.Event_Type;
			                        if(ifnull(input.Details,"") != "")
			                        {
			                            summaryText = input.Details;
			                        }
			                        shipmentRecord.Latest_Tracking_Text = summaryText;
			                    }
			                }
			            )
			        }
			    }
			}

			Shipment_Tracking_Events_On_Validate as "Validate Append-Only Tracking Event"
			{
			    type = form
			    form = Shipment_Tracking_Events
			    record event = on add or edit
			    description = "Copies shipment ownership and rejects non-admin edits to the append-only operational history."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                shipmentRecord = Shipment_Requests[ID == input.Shipment];
			                if(shipmentRecord.count() == 0)
			                {
			                    alert "Select a valid shipment.";
			                    cancel submit;
			                }
			                input.Customer_Portal_User = shipmentRecord.Customer_Portal_User;
			                if(input.Event_Time == null)
			                {
			                    input.Event_Time = zoho.currenttime;
			                }
			                currentEmployee = Employees[Work_Email == zoho.loginuserid && Active == true];
			                if(input.ID == null && input.Recorded_By == null && currentEmployee.count() > 0)
			                {
			                    input.Recorded_By = currentEmployee.ID;
			                }
			                if(input.Manifest != null)
			                {
			                    manifestRecord = Manifests[ID == input.Manifest];
			                    manifestItem = Manifest_Items[Manifest == input.Manifest && Shipment == input.Shipment];
			                    if(manifestRecord.count() == 0 || manifestItem.count() == 0)
			                    {
			                        alert "The selected manifest leg must contain this shipment.";
			                        cancel submit;
			                    }
			                }
			                if(input.Agent_Task != null)
			                {
			                    taskRecord = Agent_Tasks[ID == input.Agent_Task];
			                    if(taskRecord.count() == 0 || taskRecord.Shipment != input.Shipment)
			                    {
			                        alert "The selected agent task must belong to this shipment.";
			                        cancel submit;
			                    }
			                }
			                isAdministrator = thisapp.permissions.isUserInProfile("Logistics_Admin");
			                persistedEvent = Shipment_Tracking_Events[ID == input.ID];
			                if(input.ID != null && isAdministrator == false)
			                {
			                    if(persistedEvent.Shipment != input.Shipment || persistedEvent.Customer_Portal_User != input.Customer_Portal_User || persistedEvent.Manifest != input.Manifest || persistedEvent.Agent_Task != input.Agent_Task || persistedEvent.Event_Type != input.Event_Type || persistedEvent.Event_Time != input.Event_Time || persistedEvent.Hub != input.Hub || persistedEvent.Location_Text != input.Location_Text || persistedEvent.Details != input.Details || persistedEvent.Recorded_By != input.Recorded_By || persistedEvent.Customer_Visible != input.Customer_Visible)
			                    {
			                        alert "Shipment tracking history is append-only and cannot be edited.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Transport_Rates_On_Validate as "Validate Transport Rate"
			{
			    type = form
			    form = Transport_Rates
			    record event = on add or edit
			    description = "Validates India-specific rate values, ranges, effective dates, and overlapping active pricing bands."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(ifnull(input.Min_Weight_Kg,0) < 0 || ifnull(input.Max_Weight_Kg,0) < 0 || ifnull(input.Min_Distance_Km,0) < 0 || ifnull(input.Max_Distance_Km,0) < 0)
			                {
			                    alert "Weight and distance values cannot be negative.";
			                    cancel submit;
			                }
			                if(input.Max_Weight_Kg < input.Min_Weight_Kg)
			                {
			                    alert "Maximum weight must be greater than or equal to minimum weight.";
			                    cancel submit;
			                }
			                if(input.Max_Distance_Km < input.Min_Distance_Km)
			                {
			                    alert "Maximum distance must be greater than or equal to minimum distance.";
			                    cancel submit;
			                }
			                if(ifnull(input.Base_Charge,0) < 0 || ifnull(input.Charge_Per_Kg,0) < 0 || ifnull(input.Charge_Per_Km,0) < 0 || ifnull(input.Minimum_Charge,0) < 0 || ifnull(input.Fuel_Surcharge_Percent,0) < 0)
			                {
			                    alert "Charges and fuel surcharge cannot be negative.";
			                    cancel submit;
			                }
			                if(ifnull(input.Priority,0) < 1)
			                {
			                    alert "Selection priority must be 1 or greater.";
			                    cancel submit;
			                }
			                if(input.Effective_To != null && input.Effective_To < input.Effective_From)
			                {
			                    alert "Effective To must be on or after Effective From.";
			                    cancel submit;
			                }
			                if(input.Active == true)
			                {
			                    candidateRates = Transport_Rates[Transport_Mode == input.Transport_Mode && Customer_Type == input.Customer_Type && Priority == input.Priority && Active == true];
			                    for each candidateRate in candidateRates
			                    {
			                        if(candidateRate.ID != input.ID)
			                        {
			                            dateOverlaps = true;
			                            if(candidateRate.Effective_To != null && input.Effective_From > candidateRate.Effective_To)
			                            {
			                                dateOverlaps = false;
			                            }
			                            if(input.Effective_To != null && candidateRate.Effective_From > input.Effective_To)
			                            {
			                                dateOverlaps = false;
			                            }
			                            weightOverlaps = input.Min_Weight_Kg <= candidateRate.Max_Weight_Kg && input.Max_Weight_Kg >= candidateRate.Min_Weight_Kg;
			                            distanceOverlaps = input.Min_Distance_Km <= candidateRate.Max_Distance_Km && input.Max_Distance_Km >= candidateRate.Min_Distance_Km;
			                            if(dateOverlaps == true && weightOverlaps == true && distanceOverlaps == true)
			                            {
			                                alert "An active rate with the same mode, customer type, priority, effective period, weight band, and distance band already overlaps this rate.";
			                                cancel submit;
			                            }
			                        }
			                    }
			                }
			            )
			        }
			    }
			}
		}

		schedule
		{
			Loyalty_Point_Expiry as "Loyalty Point Expiry"
			{
			    type = schedule
			    form = Loyalty_Transactions[Transaction_Type == "Earn" && Transaction_Status == "Posted" && Remaining_Points > 0]
			    start = Expiry_Date at "00:15:00"
			    frequency = daily
			    time zone = "Asia/Kolkata"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                if(input.Expiry_Date != null && input.Expiry_Date <= zoho.currentdate && input.Transaction_Status == "Posted" && input.Remaining_Points > 0)
			                {
			                    pointsToExpire = input.Remaining_Points;
			                    expiryID = insert into Loyalty_Transactions
			                    [
			                        Customer = input.Customer
			                        Customer_Portal_User = input.Customer_Portal_User
			                        Shipment = input.Shipment
			                        Program = input.Program
			                        Transaction_Type = "Expire"
			                        Points = 0 - pointsToExpire
			                        Monetary_Value = 0
			                        Transaction_Date = zoho.currenttime
			                        Remaining_Points = 0
			                        Used_Points = pointsToExpire
			                        Transaction_Status = "Posted"
			                        Reference_Text = "Expiry of earn transaction " + input.Transaction_ID.toString()
			                    ];
			                    input.Remaining_Points = 0;
			                    input.Used_Points = ifnull(input.Used_Points,0) + pointsToExpire;
			                    input.Transaction_Status = "Expired";
			                    ledgerBalance = ifnull(Loyalty_Transactions[Customer == input.Customer].sum(Points),0);
			                    customerRecord = Customers[ID == input.Customer];
			                    if(customerRecord.count() > 0)
			                    {
			                        customerRecord.Current_Points_Balance = ledgerBalance;
			                    }
			                    expiryRecord = Loyalty_Transactions[ID == expiryID];
			                    if(expiryRecord.count() > 0)
			                    {
			                        expiryRecord.Balance_After = ledgerBalance;
			                    }
			                    auditID = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        User_Email = zoho.loginuserid
			                        User_Profile = "Loyalty Expiry Schedule"
			                        Entity_Type = "Loyalty_Transactions"
			                        Entity_Record_ID = expiryID.toString()
			                        Action = "Points Expired"
			                        Before_Value = pointsToExpire.toString()
			                        After_Value = ledgerBalance.toString()
			                        Details = "Expired remaining points from earn transaction " + input.Transaction_ID.toString() + "."
			                        Severity = "Info"
			                    ];
			                }
			            )
			        }
			    }
			}
		}

		blueprint
		{
			Agent_Task_Lifecycle as "Agent Task Lifecycle"
			{
			    type = blueprint
			    form = Agent_Tasks
			
			    start
			    {
			        start stage = "Assigned"
			    }
			
			    stages
			    {
			        "Assigned" { }
			        "Accepted" { }
			        "In Progress" { }
			        "Completed" { }
			        "Failed" { }
			    }
			
			    transitions
			    {
			        Accept_Task as "Accept Task"
			        {
			            type = normal
			            from stage = "Assigned"
			            to stage = "Accepted"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Hub_Agent"}
			                    userfields = {Agent_User}
			                )
			                confirmation before execution
			                (
			                    message = "Accept this assigned pickup or delivery task?"
			                    confirm button text = "Accept Task"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Accepted_On = zoho.currenttime;
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Agent Task Lifecycle"
			                            Entity_Type = "Agent_Tasks"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Agent Task Accepted"
			                            Before_Value = "Assigned"
			                            After_Value = "Accepted"
			                            Details = "Assigned agent accepted the " + input.Task_Type.toLowerCase() + " task."
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			
			        Start_Task as "Start Task"
			        {
			            type = normal
			            from stage = "Accepted"
			            to stage = "In Progress"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Hub_Agent"}
			                    userfields = {Agent_User}
			                )
			                confirmation before execution
			                (
			                    message = "Start this task now?"
			                    confirm button text = "Start Task"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Started_On = zoho.currenttime;
			                        shipmentRecord = Shipment_Requests[ID == input.Shipment];
			                        if(shipmentRecord.count() > 0 && input.Task_Type == "Delivery")
			                        {
			                            shipmentRecord.Shipment_Status = "Out for Delivery";
			                            shipmentRecord.Current_Hub = input.Hub;
			                            shipmentRecord.Latest_Tracking_Text = "Shipment is out for delivery.";
			                            trackingID = insert into Shipment_Tracking_Events
			                            [
			                                Shipment = shipmentRecord.ID
			                                Customer_Portal_User = shipmentRecord.Customer_Portal_User
			                                Event_Type = "Out for Delivery"
			                                Event_Time = zoho.currenttime
			                                Hub = input.Hub
			                                Location_Text = "Delivery route"
			                                Details = "Final-delivery agent started the assigned task."
			                                Customer_Visible = true
			                            ];
			                        }
			                    )
			                }
			            }
			        }
			
			        Complete_Task as "Complete Task"
			        {
			            type = normal
			            from stage = "In Progress"
			            to stage = "Completed"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Hub_Agent"}
			                    userfields = {Agent_User}
			                )
			                transition criteria = ( (Task_Type == "Pickup" && Proof_File is not null) || (Task_Type == "Delivery" && Recipient_Name is not null && (Proof_File is not null || Recipient_Signature is not null)) )
			                confirmation before execution
			                (
			                    message = "Complete this task using the captured proof?"
			                    confirm button text = "Complete Task"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Completed_On = zoho.currenttime;
			                        shipmentRecord = Shipment_Requests[ID == input.Shipment];
			                        if(shipmentRecord.count() > 0)
			                        {
			                            if(input.Task_Type == "Pickup")
			                            {
			                                shipmentRecord.Picked_Up_On = zoho.currenttime;
			                                shipmentRecord.Current_Hub = input.Hub;
			                                shipmentRecord.Shipment_Status = "Picked Up";
			                                shipmentRecord.Latest_Tracking_Text = "Shipment picked up and received at the origin hub.";
			                                trackingID = insert into Shipment_Tracking_Events
			                                [
			                                    Shipment = shipmentRecord.ID
			                                    Customer_Portal_User = shipmentRecord.Customer_Portal_User
			                                    Event_Type = "Picked Up"
			                                    Event_Time = zoho.currenttime
			                                    Hub = input.Hub
			                                    Location_Text = "Origin hub"
			                                    Details = "Pickup task completed with proof. Shipment is eligible for a manifest journey leg."
			                                    Customer_Visible = true
			                                ];
			                            }
			                            else
			                            {
			                                shipmentRecord.Delivered_On = zoho.currenttime;
			                                shipmentRecord.Current_Hub = input.Hub;
			                                shipmentRecord.Shipment_Status = "Delivered";
			                                shipmentRecord.Latest_Tracking_Text = "Shipment delivered successfully.";
			                                trackingID = insert into Shipment_Tracking_Events
			                                [
			                                    Shipment = shipmentRecord.ID
			                                    Customer_Portal_User = shipmentRecord.Customer_Portal_User
			                                    Event_Type = "Delivered"
			                                    Event_Time = zoho.currenttime
			                                    Hub = input.Hub
			                                    Location_Text = "Delivery address"
			                                    Details = "Delivery completed for recipient " + input.Recipient_Name + "."
			                                    Customer_Visible = true
			                                ];
			                                customerRecord = Customers[ID == shipmentRecord.Customer];
			                                priorEarn = Loyalty_Transactions[Shipment == shipmentRecord.ID && Transaction_Type == "Earn"];
			                                if(customerRecord.count() > 0 && customerRecord.Current_Loyalty_Program != null && priorEarn.count() == 0)
			                                {
			                                    programRecord = Loyalty_Programs[ID == customerRecord.Current_Loyalty_Program];
			                                    if(programRecord.count() > 0 && programRecord.Active == true)
			                                    {
			                                        earnedPoints = (shipmentRecord.Net_Amount * programRecord.Points_Per_Rupee).round(0).toNumber();
			                                        if(earnedPoints > 0)
			                                        {
			                                            expiryDate = null;
			                                            if(programRecord.Expiry_Months > 0)
			                                            {
			                                                expiryDate = zoho.currentdate.addMonth(programRecord.Expiry_Months);
			                                            }
			                                            newBalance = customerRecord.Current_Points_Balance + earnedPoints;
			                                            transactionID = insert into Loyalty_Transactions
			                                            [
			                                                Customer = shipmentRecord.Customer
			                                                Customer_Portal_User = shipmentRecord.Customer_Portal_User
			                                                Shipment = shipmentRecord.ID
			                                                Program = programRecord.ID
			                                                Transaction_Type = "Earn"
			                                                Points = earnedPoints
			                                                Monetary_Value = 0
			                                                Transaction_Date = zoho.currenttime
			                                                Expiry_Date = expiryDate
			                                                Remaining_Points = earnedPoints
			                                                Used_Points = 0
			                                                Transaction_Status = "Posted"
			                                                Reference_Text = "Points earned on delivered shipment"
			                                                Balance_After = newBalance
			                                            ];
			                                            customerRecord.Current_Points_Balance = newBalance;
			                                            customerRecord.Overall_Points_Earned = customerRecord.Overall_Points_Earned + earnedPoints;
			                                        }
			                                    }
			                                }
			                            }
			                        }
			                        agentRecord = Employees[ID == input.Assigned_Agent];
			                        openTasks = Agent_Tasks[Assigned_Agent == input.Assigned_Agent && ID != input.ID && Task_Status != "Completed" && Task_Status != "Failed"];
			                        if(agentRecord.count() > 0 && openTasks.count() == 0)
			                        {
			                            agentRecord.Availability_Status = "Available";
			                        }
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Agent Task Lifecycle"
			                            Entity_Type = "Agent_Tasks"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Agent Task Completed"
			                            Before_Value = "In Progress"
			                            After_Value = "Completed"
			                            Details = input.Task_Type + " task completed; shipment and loyalty outcomes were applied idempotently."
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			
			        Fail_Task as "Fail Task"
			        {
			            type = normal
			            from stage = "In Progress"
			            to stage = "Failed"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Hub_Agent"}
			                    userfields = {Agent_User}
			                )
			                transition criteria = ( Failure_Reason is not null )
			                confirmation before execution
			                (
			                    message = "Record this task as failed and create a shipment exception?"
			                    confirm button text = "Record Failure"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Completed_On = zoho.currenttime;
			                        shipmentRecord = Shipment_Requests[ID == input.Shipment];
			                        if(shipmentRecord.count() > 0)
			                        {
			                            shipmentRecord.Latest_Tracking_Text = "An exception occurred during the " + input.Task_Type.toLowerCase() + " task.";
			                            trackingID = insert into Shipment_Tracking_Events
			                            [
			                                Shipment = shipmentRecord.ID
			                                Customer_Portal_User = shipmentRecord.Customer_Portal_User
			                                Event_Type = "Exception"
			                                Event_Time = zoho.currenttime
			                                Hub = input.Hub
			                                Location_Text = input.Task_Type + " location"
			                                Details = input.Failure_Reason
			                                Customer_Visible = true
			                            ];
			                        }
			                        agentRecord = Employees[ID == input.Assigned_Agent];
			                        openTasks = Agent_Tasks[Assigned_Agent == input.Assigned_Agent && ID != input.ID && Task_Status != "Completed" && Task_Status != "Failed"];
			                        if(agentRecord.count() > 0 && openTasks.count() == 0)
			                        {
			                            agentRecord.Availability_Status = "Available";
			                        }
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Agent Task Lifecycle"
			                            Entity_Type = "Agent_Tasks"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Agent Task Failed"
			                            Before_Value = "In Progress"
			                            After_Value = "Failed"
			                            Details = input.Failure_Reason
			                            Severity = "Warning"
			                        ];
			                    )
			                }
			            }
			        }
			
			        Retry_Task as "Retry Failed Task"
			        {
			            type = normal
			            from stage = "Failed"
			            to stage = "Assigned"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin","Hub_Manager"}
			                )
			                transition criteria = ( Assigned_Agent is not null )
			                confirmation before execution
			                (
			                    message = "Retry this failed task with the selected agent and schedule?"
			                    confirm button text = "Retry Task"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Accepted_On = null;
			                        Started_On = null;
			                        Completed_On = null;
			                        agentRecord = Employees[ID == input.Assigned_Agent];
			                        if(agentRecord.count() > 0)
			                        {
			                            Agent_User = agentRecord.Internal_User;
			                            agentRecord.Availability_Status = "Assigned";
			                            sendmail
			                            (
			                                from : zoho.adminuserid
			                                to : agentRecord.Work_Email
			                                subject : "Retried " + input.Task_Type + " task assigned"
			                                message : "Task " + input.Task_Number.toString() + " has been retried and assigned to you. Review the earlier failure reason before proceeding."
			                            )
			                        }
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Agent Task Retry"
			                            Entity_Type = "Agent_Tasks"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Failed Task Retried"
			                            Before_Value = "Failed"
			                            After_Value = "Assigned"
			                            Details = "Task retried with employee record " + input.Assigned_Agent.toString() + "."
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			    }
			}

			KYC_Document_Lifecycle as "KYC Document Lifecycle"
			{
			    type = blueprint
			    form = KYC_Document_Requests
			
			    start
			    {
			        start stage = "Draft"
			    }
			
			    stages
			    {
			        "Draft"
			        {
			        }
			        "Requested"
			        {
			        }
			        "Uploaded"
			        {
			        }
			        "Approved"
			        {
			        }
			        "Rejected"
			        {
			        }
			    }
			
			    transitions
			    {
			        Send_Request as "Send Request"
			        {
			            type = normal
			            from stage = "Draft"
			            to stage = "Requested"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin","Operations_Employee"}
			                )
			                confirmation before execution
			                (
			                    message = "Send this KYC document request to the customer?"
			                    confirm button text = "Send Request"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Requested_On = zoho.currenttime;
			                        requester = Employees[Work_Email == zoho.loginuserid];
			                        if(requester.count() > 0)
			                        {
			                            Requested_By = requester.ID;
			                        }
			                        customerRecord = Customers[ID == input.Customer];
			                        if(customerRecord.count() > 0)
			                        {
			                            customerRecord.KYC_Status = "Documents Requested";
			                            sendmail
			                            (
			                                from : zoho.adminuserid
			                                to : customerRecord.Customer_Email
			                                subject : "KYC document requested"
			                                message : "Please upload your " + input.Requested_Document_Name + " in the customer portal."
			                            )
			                        }
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "KYC Request Workflow"
			                            Entity_Type = "KYC_Document_Requests"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Document Requested"
			                            After_Value = input.Requested_Document_Name
			                            Details = "KYC document request sent to customer."
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			
			        Upload_Document as "Upload Document"
			        {
			            type = normal
			            from stage = "Requested"
			            to stage = "Uploaded"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Customer_Portal"}
			                )
			                transition criteria = ( Uploaded_Document is not null )
			                tooltip message = "Upload and save the requested document before submitting it for review."
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Uploaded_On = zoho.currenttime;
			                        customerRecord = Customers[ID == input.Customer];
			                        if(customerRecord.count() > 0)
			                        {
			                            customerRecord.KYC_Status = "Under Review";
			                        }
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : zoho.adminuserid
			                            subject : "KYC document uploaded for review"
			                            message : "A customer has uploaded " + input.Requested_Document_Name + " for KYC review."
			                        )
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Customer_Portal"
			                            Entity_Type = "KYC_Document_Requests"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Document Uploaded"
			                            After_Value = input.Requested_Document_Name
			                            Details = "Customer uploaded a KYC document for review."
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			
			        Approve_Document as "Approve Document"
			        {
			            type = normal
			            from stage = "Uploaded"
			            to stage = "Approved"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin"}
			                )
			                confirmation before execution
			                (
			                    message = "Approve this KYC document?"
			                    confirm button text = "Approve"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Reviewed_On = zoho.currenttime;
			                        reviewer = Employees[Work_Email == zoho.loginuserid];
			                        if(reviewer.count() > 0)
			                        {
			                            Reviewed_By = reviewer.ID;
			                        }
			                        requiredRequests = KYC_Document_Requests[Customer == input.Customer && Required_Document == true];
			                        allApproved = true;
			                        for each requiredRequest in requiredRequests
			                        {
			                            if(requiredRequest.ID != input.ID && requiredRequest.Verification_Status != "Approved")
			                            {
			                                allApproved = false;
			                            }
			                        }
			                        customerRecord = Customers[ID == input.Customer];
			                        if(customerRecord.count() > 0)
			                        {
			                            if(allApproved == true)
			                            {
			                                customerRecord.KYC_Status = "Approved";
			                                customerRecord.Onboarding_Status = "Active";
			                                customerRecord.Onboarded_On = zoho.currenttime;
			                            }
			                            else
			                            {
			                                customerRecord.KYC_Status = "Under Review";
			                            }
			                            sendmail
			                            (
			                                from : zoho.adminuserid
			                                to : customerRecord.Customer_Email
			                                subject : "KYC document approved"
			                                message : "Your " + input.Requested_Document_Name + " has been approved."
			                            )
			                        }
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Logistics_Admin"
			                            Entity_Type = "KYC_Document_Requests"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Document Approved"
			                            After_Value = input.Requested_Document_Name
			                            Details = "KYC document approved and customer status recalculated."
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			
			        Reject_Document as "Reject Document"
			        {
			            type = normal
			            from stage = "Uploaded"
			            to stage = "Rejected"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin"}
			                )
			                transition criteria = ( Rejection_Reason is not null )
			                tooltip message = "Enter and save a rejection reason before rejecting."
			                confirmation before execution
			                (
			                    message = "Reject this KYC document and request resubmission?"
			                    confirm button text = "Reject"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Reviewed_On = zoho.currenttime;
			                        reviewer = Employees[Work_Email == zoho.loginuserid];
			                        if(reviewer.count() > 0)
			                        {
			                            Reviewed_By = reviewer.ID;
			                        }
			                        customerRecord = Customers[ID == input.Customer];
			                        if(customerRecord.count() > 0)
			                        {
			                            customerRecord.KYC_Status = "Rejected";
			                            customerRecord.Onboarding_Status = "Pending KYC";
			                            sendmail
			                            (
			                                from : zoho.adminuserid
			                                to : customerRecord.Customer_Email
			                                subject : "KYC document requires resubmission"
			                                message : "Your " + input.Requested_Document_Name + " was rejected. Reason: " + input.Rejection_Reason + ". Please upload a corrected document."
			                            )
			                        }
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Logistics_Admin"
			                            Entity_Type = "KYC_Document_Requests"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Document Rejected"
			                            After_Value = input.Rejection_Reason
			                            Details = "KYC document rejected; customer may resubmit."
			                            Severity = "Warning"
			                        ];
			                    )
			                }
			            }
			        }
			
			        Resubmit_Document as "Resubmit Document"
			        {
			            type = normal
			            from stage = "Rejected"
			            to stage = "Uploaded"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Customer_Portal"}
			                )
			                transition criteria = ( Uploaded_Document is not null )
			                tooltip message = "Upload and save a corrected document before resubmitting it."
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Uploaded_On = zoho.currenttime;
			                        Rejection_Reason = "";
			                        customerRecord = Customers[ID == input.Customer];
			                        if(customerRecord.count() > 0)
			                        {
			                            customerRecord.KYC_Status = "Under Review";
			                        }
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : zoho.adminuserid
			                            subject : "KYC document resubmitted for review"
			                            message : "A customer has resubmitted " + input.Requested_Document_Name + " for KYC review."
			                        )
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Customer_Portal"
			                            Entity_Type = "KYC_Document_Requests"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Document Resubmitted"
			                            After_Value = input.Requested_Document_Name
			                            Details = "Customer resubmitted a rejected KYC document."
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			    }
			}

			Loyalty_Redemption_Lifecycle as "Loyalty Redemption Lifecycle"
			{
			    type = blueprint
			    form = Loyalty_Redemptions
			
			    start
			    {
			        start stage = "Requested"
			    }
			
			    stages
			    {
			        "Requested" { }
			        "Approved" { }
			        "Applied" { }
			        "Paid" { }
			        "Rejected" { }
			        "Cancelled" { }
			    }
			
			    transitions
			    {
			        Approve_Redemption as "Approve Redemption"
			        {
			            type = normal
			            from stage = "Requested"
			            to stage = "Approved"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin"}
			                )
			                confirmation before execution
			                (
			                    message = "Approve this redemption after confirming the available points and value?"
			                    confirm button text = "Approve"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Reviewed_On = zoho.currenttime;
			                        reviewer = Employees[Work_Email == zoho.loginuserid && Active == true];
			                        if(reviewer.count() > 0)
			                        {
			                            Reviewed_By = reviewer.ID;
			                        }
			                        customerRecord = Customers[ID == input.Customer];
			                        if(input.Redemption_Type == "Cash Value" && input.Generated_Transaction == null && customerRecord.count() > 0)
			                        {
			                            newBalance = customerRecord.Current_Points_Balance - input.Points_Requested;
			                            transactionID = insert into Loyalty_Transactions
			                            [
			                                Customer = input.Customer
			                                Customer_Portal_User = input.Customer_Portal_User
			                                Program = input.Program
			                                Transaction_Type = "Redeem"
			                                Points = 0 - input.Points_Requested
			                                Monetary_Value = input.Amount_Value
			                                Transaction_Date = zoho.currenttime
			                                Remaining_Points = 0
			                                Used_Points = input.Points_Requested
			                                Transaction_Status = "Posted"
			                                Reference_Text = "Cash value redemption " + input.Redemption_Number.toString()
			                                Balance_After = newBalance
			                                Created_By = reviewer.ID
			                            ];
			                            Generated_Transaction = transactionID;
			                            pointsToAllocate = input.Points_Requested;
			                            earnLots = Loyalty_Transactions[Customer == input.Customer && Points > 0 && Remaining_Points > 0 && Transaction_Status != "Expired"] sort by Expiry_Date, Transaction_Date;
			                            for each earnLot in earnLots
			                            {
			                                if(pointsToAllocate > 0)
			                                {
			                                    lotAvailable = ifnull(earnLot.Remaining_Points,0);
			                                    lotUsed = lotAvailable;
			                                    if(lotUsed > pointsToAllocate)
			                                    {
			                                        lotUsed = pointsToAllocate;
			                                    }
			                                    earnLot.Remaining_Points = lotAvailable - lotUsed;
			                                    earnLot.Used_Points = ifnull(earnLot.Used_Points,0) + lotUsed;
			                                    pointsToAllocate = pointsToAllocate - lotUsed;
			                                }
			                            }
			                            customerRecord.Current_Points_Balance = newBalance;
			                        }
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Logistics_Admin"
			                            Entity_Type = "Loyalty_Redemptions"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Redemption Approved"
			                            Before_Value = "Requested"
			                            After_Value = "Approved"
			                            Details = input.Redemption_Type + " redemption approved for INR " + input.Amount_Value.toString() + "."
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			
			        Reject_Redemption as "Reject Redemption"
			        {
			            type = normal
			            from stage = "Requested"
			            to stage = "Rejected"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin"}
			                )
			                transition criteria = ( Review_Notes is not null )
			                tooltip message = "Enter review notes before rejecting the request."
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Reviewed_On = zoho.currenttime;
			                        reviewer = Employees[Work_Email == zoho.loginuserid && Active == true];
			                        if(reviewer.count() > 0)
			                        {
			                            Reviewed_By = reviewer.ID;
			                        }
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Logistics_Admin"
			                            Entity_Type = "Loyalty_Redemptions"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Redemption Rejected"
			                            Before_Value = "Requested"
			                            After_Value = "Rejected"
			                            Details = input.Review_Notes
			                            Severity = "Warning"
			                        ];
			                    )
			                }
			            }
			        }
			
			        Pay_Cash_Value as "Record Cash Payout"
			        {
			            type = normal
			            from stage = "Approved"
			            to stage = "Paid"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin"}
			                )
			                transition criteria = ( Redemption_Type == "Cash Value" && Payment_Reference is not null && Generated_Transaction is not null )
			                tooltip message = "Enter the UPI or bank payment reference before recording payout."
			                confirmation before execution
			                (
			                    message = "Confirm that the INR payout has been completed?"
			                    confirm button text = "Record Payout"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Reviewed_On = zoho.currenttime;
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Logistics_Admin"
			                            Entity_Type = "Loyalty_Redemptions"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Cash Redemption Paid"
			                            Before_Value = "Approved"
			                            After_Value = "Paid"
			                            Details = "INR payout recorded with reference " + input.Payment_Reference + "."
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			
			        Apply_Shipment_Discount as "Apply Shipment Discount"
			        {
			            type = normal
			            from stage = "Approved"
			            to stage = "Applied"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin"}
			                )
			                transition criteria = ( Redemption_Type == "Shipment Discount" && Shipment is not null )
			                confirmation before execution
			                (
			                    message = "Apply this loyalty discount to the selected shipment?"
			                    confirm button text = "Apply Discount"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        customerRecord = Customers[ID == input.Customer];
			                        shipmentRecord = Shipment_Requests[ID == input.Shipment];
			                        if(input.Generated_Transaction == null && customerRecord.count() > 0 && shipmentRecord.count() > 0)
			                        {
			                            newBalance = customerRecord.Current_Points_Balance - input.Points_Requested;
			                            transactionID = insert into Loyalty_Transactions
			                            [
			                                Customer = input.Customer
			                                Customer_Portal_User = input.Customer_Portal_User
			                                Shipment = input.Shipment
			                                Program = input.Program
			                                Transaction_Type = "Redeem"
			                                Points = 0 - input.Points_Requested
			                                Monetary_Value = input.Amount_Value
			                                Transaction_Date = zoho.currenttime
			                                Remaining_Points = 0
			                                Used_Points = input.Points_Requested
			                                Transaction_Status = "Posted"
			                                Reference_Text = "Shipment discount redemption " + input.Redemption_Number.toString()
			                                Balance_After = newBalance
			                            ];
			                            Generated_Transaction = transactionID;
			                            pointsToAllocate = input.Points_Requested;
			                            earnLots = Loyalty_Transactions[Customer == input.Customer && Points > 0 && Remaining_Points > 0 && Transaction_Status != "Expired"] sort by Expiry_Date, Transaction_Date;
			                            for each earnLot in earnLots
			                            {
			                                if(pointsToAllocate > 0)
			                                {
			                                    lotAvailable = ifnull(earnLot.Remaining_Points,0);
			                                    lotUsed = lotAvailable;
			                                    if(lotUsed > pointsToAllocate)
			                                    {
			                                        lotUsed = pointsToAllocate;
			                                    }
			                                    earnLot.Remaining_Points = lotAvailable - lotUsed;
			                                    earnLot.Used_Points = ifnull(earnLot.Used_Points,0) + lotUsed;
			                                    pointsToAllocate = pointsToAllocate - lotUsed;
			                                }
			                            }
			                            customerRecord.Current_Points_Balance = newBalance;
			                            shipmentRecord.Use_Loyalty = true;
			                            shipmentRecord.Loyalty_Points_To_Use = input.Points_Requested;
			                            shipmentRecord.Loyalty_Discount = input.Amount_Value;
			                            shipmentRecord.Net_Amount = shipmentRecord.Gross_Amount - input.Amount_Value;
			                            if(shipmentRecord.Net_Amount < 0)
			                            {
			                                shipmentRecord.Net_Amount = 0;
			                            }
			                        }
			                        Reviewed_On = zoho.currenttime;
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Logistics_Admin"
			                            Entity_Type = "Loyalty_Redemptions"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Shipment Discount Applied"
			                            Before_Value = "Approved"
			                            After_Value = "Applied"
			                            Details = "Applied INR " + input.Amount_Value.toString() + " to shipment " + input.Shipment.toString() + "."
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			
			        Cancel_Redemption as "Cancel Redemption"
			        {
			            type = common
			            from stage = "Requested"
			            to stage = "Cancelled"
			            common stages = {"Approved"}
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Customer_Portal","Logistics_Admin","Operations_Employee"}
			                )
			                confirmation before execution
			                (
			                    message = "Cancel this unfulfilled redemption and reverse any posted points debit?"
			                    confirm button text = "Cancel Redemption"
			                    cancel button text = "Keep Request"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        previousStatus = input.Redemption_Status;
			                        if(input.Generated_Transaction != null)
			                        {
			                            originalTransaction = Loyalty_Transactions[ID == input.Generated_Transaction];
			                            reversalExists = Loyalty_Transactions[Transaction_Type == "Reverse" && Reference_Text == "Redemption cancellation " + input.Redemption_Number.toString()];
			                            customerRecord = Customers[ID == input.Customer];
			                            if(originalTransaction.count() > 0 && reversalExists.count() == 0 && customerRecord.count() > 0)
			                            {
			                                pointsToRestore = 0 - originalTransaction.Points;
			                                newBalance = customerRecord.Current_Points_Balance + pointsToRestore;
			                                reversalID = insert into Loyalty_Transactions
			                                [
			                                    Customer = input.Customer
			                                    Customer_Portal_User = input.Customer_Portal_User
			                                    Shipment = input.Shipment
			                                    Program = input.Program
			                                    Transaction_Type = "Reverse"
			                                    Points = pointsToRestore
			                                    Monetary_Value = input.Amount_Value
			                                    Transaction_Date = zoho.currenttime
			                                    Remaining_Points = pointsToRestore
			                                    Used_Points = 0
			                                    Transaction_Status = "Posted"
			                                    Reference_Text = "Redemption cancellation " + input.Redemption_Number.toString()
			                                    Balance_After = newBalance
			                                ];
			                                originalTransaction.Transaction_Status = "Reversed";
			                                customerRecord.Current_Points_Balance = newBalance;
			                            }
			                        }
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Loyalty Redemption Lifecycle"
			                            Entity_Type = "Loyalty_Redemptions"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Redemption Cancelled"
			                            Before_Value = previousStatus
			                            After_Value = "Cancelled"
			                            Details = "Unfulfilled redemption cancelled; posted points were reversed when applicable."
			                            Severity = "Warning"
			                        ];
			                    )
			                }
			            }
			        }
			    }
			}

			Manifest_Lifecycle as "Manifest Lifecycle"
			{
			    type = blueprint
			    form = Manifests
			
			    start
			    {
			        start stage = "Draft"
			    }
			
			    stages
			    {
			        "Draft" { }
			        "Ready" { }
			        "Dispatched" { }
			        "Arrived" { }
			        "Closed" { }
			        "Cancelled" { }
			    }
			
			    transitions
			    {
			        Ready_Manifest as "Ready Manifest"
			        {
			            type = normal
			            from stage = "Draft"
			            to stage = "Ready"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin","Hub_Manager"}
			                )
			                transition criteria = ( Assigned_Agent is not null && Planned_Departure is not null && Planned_Arrival is not null )
			                confirmation before execution
			                (
			                    message = "Confirm that this one-leg manifest is loaded and ready for dispatch?"
			                    confirm button text = "Mark Ready"
			                    cancel button text = "Keep Draft"
			                )
			            }
			            after
			            {
			            }
			        }
			
			        Dispatch_Manifest as "Dispatch Manifest"
			        {
			            type = normal
			            from stage = "Ready"
			            to stage = "Dispatched"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin","Hub_Manager","Hub_Agent"}
			                    userfields = {Assigned_Agent_User}
			                )
			                confirmation before execution
			                (
			                    message = "Dispatch this manifest leg from the origin hub?"
			                    confirm button text = "Dispatch"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Actual_Departure = zoho.currenttime;
			                        manifestItems = Manifest_Items[Manifest == input.ID];
			                        for each manifestItem in manifestItems
			                        {
			                            manifestItem.Item_Status = "Departed";
			                            shipmentRecord = Shipment_Requests[ID == manifestItem.Shipment];
			                            if(shipmentRecord.count() > 0)
			                            {
			                                shipmentRecord.Shipment_Status = "In Transit";
			                                shipmentRecord.Current_Hub = input.Origin_Hub;
			                                shipmentRecord.Latest_Tracking_Text = "Shipment departed the origin hub on manifest leg " + input.Manifest_Number.toString() + ".";
			                                trackingID = insert into Shipment_Tracking_Events
			                                [
			                                    Shipment = shipmentRecord.ID
			                                    Customer_Portal_User = shipmentRecord.Customer_Portal_User
			                                    Manifest = input.ID
			                                    Event_Type = "Departed Hub"
			                                    Event_Time = zoho.currenttime
			                                    Hub = input.Origin_Hub
			                                    Location_Text = "Departed origin hub"
			                                    Details = "Shipment dispatched on manifest leg " + input.Manifest_Number.toString() + "."
			                                    Customer_Visible = true
			                                ];
			                            }
			                        }
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Manifest Dispatch"
			                            Entity_Type = "Manifests"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Manifest Dispatched"
			                            Before_Value = "Ready"
			                            After_Value = "Dispatched"
			                            Details = "One-leg manifest departed origin hub " + input.Origin_Hub.toString() + "."
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			
			        Arrive_Manifest as "Arrive Manifest"
			        {
			            type = normal
			            from stage = "Dispatched"
			            to stage = "Arrived"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin","Hub_Manager","Hub_Agent"}
			                    userfields = {Assigned_Agent_User}
			                )
			                confirmation before execution
			                (
			                    message = "Confirm arrival of this manifest leg at the destination hub?"
			                    confirm button text = "Record Arrival"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Actual_Arrival = zoho.currenttime;
			                        manifestItems = Manifest_Items[Manifest == input.ID];
			                        for each manifestItem in manifestItems
			                        {
			                            manifestItem.Item_Status = "Arrived";
			                            manifestItem.Unloaded_On = zoho.currenttime;
			                            shipmentRecord = Shipment_Requests[ID == manifestItem.Shipment];
			                            if(shipmentRecord.count() > 0)
			                            {
			                                shipmentRecord.Current_Hub = input.Destination_Hub;
			                                shipmentRecord.Shipment_Status = "At Hub";
			                                shipmentRecord.Latest_Tracking_Text = "Shipment arrived at the destination hub for manifest leg " + input.Manifest_Number.toString() + ".";
			                                trackingID = insert into Shipment_Tracking_Events
			                                [
			                                    Shipment = shipmentRecord.ID
			                                    Customer_Portal_User = shipmentRecord.Customer_Portal_User
			                                    Manifest = input.ID
			                                    Event_Type = "Arrived Hub"
			                                    Event_Time = zoho.currenttime
			                                    Hub = input.Destination_Hub
			                                    Location_Text = "Destination hub"
			                                    Details = "Shipment arrived on manifest leg " + input.Manifest_Number.toString() + "."
			                                    Customer_Visible = true
			                                ];
			                                if(input.Destination_Hub == shipmentRecord.Destination_Hub)
			                                {
			                                    existingDeliveryTask = Agent_Tasks[Shipment == shipmentRecord.ID && Task_Type == "Delivery" && Task_Status != "Completed"];
			                                    if(existingDeliveryTask.count() == 0)
			                                    {
			                                        deliveryAgent = Employees[Hub == input.Destination_Hub && Employee_Type == "Agent" && Active == true && Availability_Status == "Available"] sort by Employee_ID range from 0 to 0;
			                                        if(deliveryAgent.count() > 0)
			                                        {
			                                            taskID = insert into Agent_Tasks
			                                            [
			                                                Task_Type = "Delivery"
			                                                Shipment = shipmentRecord.ID
			                                                Hub = input.Destination_Hub
			                                                Assigned_Agent = deliveryAgent.ID
			                                                Agent_User = deliveryAgent.Internal_User
			                                                Scheduled_At = zoho.currenttime
			                                                Contact_Name = shipmentRecord.Delivery_Contact_Name
			                                                Contact_Phone = shipmentRecord.Delivery_Phone
			                                                Task_Address = shipmentRecord.Delivery_Address
			                                                Task_Status = "Assigned"
			                                                Agent_Notes = "Final delivery generated after manifest arrival."
			                                            ];
			                                            deliveryAgent.Availability_Status = "Assigned";
			                                            shipmentRecord.Shipment_Status = "Delivery Assigned";
			                                            shipmentRecord.Latest_Tracking_Text = "Shipment arrived at the final hub and was assigned for delivery.";
			                                        }
			                                        else
			                                        {
			                                            shipmentRecord.Latest_Tracking_Text = "Shipment arrived at the final hub and is awaiting delivery-agent assignment.";
			                                        }
			                                    }
			                                }
			                            }
			                        }
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Manifest Arrival"
			                            Entity_Type = "Manifests"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Manifest Arrived"
			                            Before_Value = "Dispatched"
			                            After_Value = "Arrived"
			                            Details = "One-leg manifest arrived at destination hub " + input.Destination_Hub.toString() + "; final-hub shipments were assigned for delivery when an agent was available."
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			
			        Close_Manifest as "Close Manifest"
			        {
			            type = normal
			            from stage = "Arrived"
			            to stage = "Closed"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin","Hub_Manager"}
			                )
			                confirmation before execution
			                (
			                    message = "Close this completed one-leg manifest?"
			                    confirm button text = "Close Manifest"
			                    cancel button text = "Keep Open"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Manifest Closure"
			                            Entity_Type = "Manifests"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Manifest Closed"
			                            Before_Value = "Arrived"
			                            After_Value = "Closed"
			                            Details = "Manifest leg closed after arrival processing."
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			
			        Cancel_Manifest as "Cancel Manifest"
			        {
			            type = common
			            from stage = "Draft"
			            to stage = "Cancelled"
			            common stages = {"Ready","Dispatched"}
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin","Hub_Manager"}
			                )
			                confirmation before execution
			                (
			                    message = "Cancel this manifest before arrival?"
			                    confirm button text = "Cancel Manifest"
			                    cancel button text = "Keep Manifest"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        previousStatus = input.Manifest_Status;
			                        manifestItems = Manifest_Items[Manifest == input.ID];
			                        for each manifestItem in manifestItems
			                        {
			                            if(previousStatus == "Dispatched")
			                            {
			                                manifestItem.Item_Status = "Exception";
			                                manifestItem.Exception_Notes = "Manifest cancelled after dispatch; shipment returned to origin-hub exception handling.";
			                                shipmentRecord = Shipment_Requests[ID == manifestItem.Shipment];
			                                if(shipmentRecord.count() > 0)
			                                {
			                                    shipmentRecord.Current_Hub = input.Origin_Hub;
			                                    shipmentRecord.Shipment_Status = "At Hub";
			                                    shipmentRecord.Latest_Tracking_Text = "Manifest leg cancelled after dispatch; shipment returned to origin-hub exception handling.";
			                                    trackingID = insert into Shipment_Tracking_Events
			                                    [
			                                        Shipment = shipmentRecord.ID
			                                        Customer_Portal_User = shipmentRecord.Customer_Portal_User
			                                        Manifest = input.ID
			                                        Event_Type = "Exception"
			                                        Event_Time = zoho.currenttime
			                                        Hub = input.Origin_Hub
			                                        Location_Text = "Origin hub exception handling"
			                                        Details = "Manifest leg cancelled after dispatch; shipment requires operational reassignment."
			                                        Customer_Visible = true
			                                    ];
			                                }
			                            }
			                        }
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Manifest Cancellation"
			                            Entity_Type = "Manifests"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Manifest Cancelled"
			                            Before_Value = previousStatus
			                            After_Value = "Cancelled"
			                            Details = "Manifest leg cancelled before arrival; dispatched shipments were returned to origin-hub exception handling for reassignment."
			                            Severity = "Warning"
			                        ];
			                    )
			                }
			            }
			        }
			    }
			}

			Shipment_Lifecycle as "Shipment Lifecycle"
			{
			    type = blueprint
			    form = Shipment_Requests
			
			    start
			    {
			        start stage = "Requested"
			    }
			
			    stages
			    {
			        "Requested" { }
			        "Quoted" { }
			        "Confirmed" { }
			        "Pickup Assigned" { }
			        "Picked Up" { }
			        "In Transit" { }
			        "At Hub" { }
			        "Delivery Assigned" { }
			        "Out for Delivery" { }
			        "Delivered" { }
			        "Cancelled" { }
			    }
			
			    transitions
			    {
			        Quote_Shipment as "Quote Shipment"
			        {
			            type = normal
			            from stage = "Requested"
			            to stage = "Quoted"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin","Operations_Employee","Hub_Manager"}
			                )
			                transition criteria = ( Manual_Distance_Km is not null && Origin_Hub is not null && Destination_Hub is not null && Applied_Rate is not null && Gross_Amount > 0 )
			                confirmation before execution
			                (
			                    message = "Send this INR shipment quote to the customer?"
			                    confirm button text = "Send Quote"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Quoted_On = zoho.currenttime;
			                        Payment_Status = "Not Due";
			                        Latest_Tracking_Text = "Shipment quoted and awaiting customer confirmation.";
			                        customerRecord = Customers[ID == input.Customer];
			                        if(customerRecord.count() > 0)
			                        {
			                            sendmail
			                            (
			                                from : zoho.adminuserid
			                                to : customerRecord.Customer_Email
			                                subject : "Shipment quote ready"
			                                message : "Your shipment quote is ready for confirmation. Net amount: INR " + input.Net_Amount.toString() + "."
			                            )
			                        }
			                        trackingID = insert into Shipment_Tracking_Events
			                        [
			                            Shipment = input.ID
			                            Customer_Portal_User = input.Customer_Portal_User
			                            Event_Type = "Quoted"
			                            Event_Time = zoho.currenttime
			                            Hub = input.Origin_Hub
			                            Location_Text = "Origin hub"
			                            Details = "Shipment quoted after manual distance and hub confirmation."
			                            Customer_Visible = true
			                        ];
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Shipment Quotation"
			                            Entity_Type = "Shipment_Requests"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Shipment Quoted"
			                            Before_Value = "Requested"
			                            After_Value = "Quoted"
			                            Details = "Rate " + input.Applied_Rate.toString() + " produced gross INR " + input.Gross_Amount.toString() + " and net INR " + input.Net_Amount.toString() + "."
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			
			        Confirm_Shipment as "Confirm Shipment"
			        {
			            type = normal
			            from stage = "Quoted"
			            to stage = "Confirmed"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Customer_Portal","Logistics_Admin","Operations_Employee"}
			                )
			                transition criteria = ( Applied_Rate is not null && Net_Amount >= 0 )
			                confirmation before execution
			                (
			                    message = "Confirm this shipment and apply the selected loyalty discount?"
			                    confirm button text = "Confirm Shipment"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Confirmed_On = zoho.currenttime;
			                        if(input.Net_Amount == 0)
			                        {
			                            Payment_Status = "Waived";
			                        }
			                        else
			                        {
			                            Payment_Status = "Pending";
			                        }
			                        Latest_Tracking_Text = "Shipment confirmed and awaiting pickup assignment.";
			                        customerRecord = Customers[ID == input.Customer];
			                        if(input.Use_Loyalty == true && input.Loyalty_Points_To_Use > 0 && customerRecord.count() > 0)
			                        {
			                            priorRedemption = Loyalty_Redemptions[Shipment == input.ID && Redemption_Type == "Shipment Discount" && Redemption_Status != "Cancelled"];
			                            if(priorRedemption.count() == 0)
			                            {
			                                redemptionID = insert into Loyalty_Redemptions
			                                [
			                                    Customer = input.Customer
			                                    Customer_Portal_User = input.Customer_Portal_User
			                                    Redemption_Type = "Shipment Discount"
			                                    Shipment = input.ID
			                                    Program = customerRecord.Current_Loyalty_Program
			                                    Points_Requested = input.Loyalty_Points_To_Use
			                                    Amount_Value = input.Loyalty_Discount
			                                    Redemption_Status = "Applied"
			                                    Requested_On = zoho.currenttime
			                                    Review_Notes = "Automatically applied when the customer confirmed the shipment."
			                                ];
			                                newBalance = customerRecord.Current_Points_Balance - input.Loyalty_Points_To_Use;
			                                transactionID = insert into Loyalty_Transactions
			                                [
			                                    Customer = input.Customer
			                                    Customer_Portal_User = input.Customer_Portal_User
			                                    Shipment = input.ID
			                                    Program = customerRecord.Current_Loyalty_Program
			                                    Transaction_Type = "Redeem"
			                                    Points = 0 - input.Loyalty_Points_To_Use
			                                    Monetary_Value = input.Loyalty_Discount
			                                    Transaction_Date = zoho.currenttime
			                                    Remaining_Points = 0
			                                    Used_Points = input.Loyalty_Points_To_Use
			                                    Transaction_Status = "Posted"
			                                    Reference_Text = "Shipment discount redemption"
			                                    Balance_After = newBalance
			                                ];
			                                redemptionRecord = Loyalty_Redemptions[ID == redemptionID];
			                                if(redemptionRecord.count() > 0)
			                                {
			                                    redemptionRecord.Generated_Transaction = transactionID;
			                                }
			                                pointsToAllocate = input.Loyalty_Points_To_Use;
			                                earnLots = Loyalty_Transactions[Customer == input.Customer && Transaction_Type == "Earn" && Transaction_Status == "Posted" && Remaining_Points > 0] sort by Expiry_Date, Transaction_Date;
			                                for each earnLot in earnLots
			                                {
			                                    if(pointsToAllocate > 0)
			                                    {
			                                        lotAvailable = earnLot.Remaining_Points;
			                                        lotUsed = lotAvailable;
			                                        if(lotUsed > pointsToAllocate)
			                                        {
			                                            lotUsed = pointsToAllocate;
			                                        }
			                                        earnLot.Remaining_Points = lotAvailable - lotUsed;
			                                        earnLot.Used_Points = ifnull(earnLot.Used_Points,0) + lotUsed;
			                                        pointsToAllocate = pointsToAllocate - lotUsed;
			                                    }
			                                }
			                                customerRecord.Current_Points_Balance = newBalance;
			                                Available_Points = newBalance;
			                            }
			                        }
			                        trackingID = insert into Shipment_Tracking_Events
			                        [
			                            Shipment = input.ID
			                            Customer_Portal_User = input.Customer_Portal_User
			                            Event_Type = "Confirmed"
			                            Event_Time = zoho.currenttime
			                            Hub = input.Origin_Hub
			                            Location_Text = "Origin hub"
			                            Details = "Shipment confirmed and ready for pickup assignment."
			                            Customer_Visible = true
			                        ];
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Shipment Confirmation"
			                            Entity_Type = "Shipment_Requests"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Shipment Confirmed"
			                            Before_Value = "Quoted"
			                            After_Value = "Confirmed"
			                            Details = "Shipment confirmed with net amount INR " + input.Net_Amount.toString() + "."
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			
			        Assign_Pickup as "Assign Pickup"
			        {
			            type = normal
			            from stage = "Confirmed"
			            to stage = "Pickup Assigned"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin","Hub_Manager"}
			                )
			                transition criteria = ( Origin_Hub is not null && Pickup_Agent is not null )
			                confirmation before execution
			                (
			                    message = "Assign this pickup to the selected origin-hub agent?"
			                    confirm button text = "Assign Pickup"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        agentRecord = Employees[ID == input.Pickup_Agent];
			                        existingTask = Agent_Tasks[Shipment == input.ID && Task_Type == "Pickup" && Task_Status != "Completed"];
			                        if(agentRecord.count() > 0 && existingTask.count() == 0)
			                        {
			                            taskID = insert into Agent_Tasks
			                            [
			                                Task_Type = "Pickup"
			                                Shipment = input.ID
			                                Hub = input.Origin_Hub
			                                Assigned_Agent = input.Pickup_Agent
			                                Agent_User = agentRecord.Internal_User
			                                Scheduled_At = zoho.currenttime
			                                Contact_Name = input.Pickup_Contact_Name
			                                Contact_Phone = input.Pickup_Phone
			                                Task_Address = input.Pickup_Address
			                                Task_Status = "Assigned"
			                                Agent_Notes = "Pickup generated from shipment confirmation."
			                            ];
			                            agentRecord.Availability_Status = "Assigned";
			                        }
			                        Latest_Tracking_Text = "Pickup assigned to an origin-hub agent.";
			                        trackingID = insert into Shipment_Tracking_Events
			                        [
			                            Shipment = input.ID
			                            Customer_Portal_User = input.Customer_Portal_User
			                            Event_Type = "Pickup Assigned"
			                            Event_Time = zoho.currenttime
			                            Hub = input.Origin_Hub
			                            Location_Text = "Origin hub"
			                            Details = "Pickup assigned to an agent."
			                            Customer_Visible = true
			                        ];
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Pickup Assignment"
			                            Entity_Type = "Shipment_Requests"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Pickup Assigned"
			                            Before_Value = "Confirmed"
			                            After_Value = "Pickup Assigned"
			                            Details = "Pickup assigned to employee record " + input.Pickup_Agent.toString() + "."
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			
			        Record_Pickup as "Record Pickup"
			        {
			            type = normal
			            from stage = "Pickup Assigned"
			            to stage = "Picked Up"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin","Hub_Manager","Hub_Agent"}
			                )
			                transition criteria = ( Origin_Hub is not null )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Picked_Up_On = zoho.currenttime;
			                        Current_Hub = input.Origin_Hub;
			                        Latest_Tracking_Text = "Shipment picked up and received at the origin hub.";
			                        trackingID = insert into Shipment_Tracking_Events
			                        [
			                            Shipment = input.ID
			                            Customer_Portal_User = input.Customer_Portal_User
			                            Event_Type = "Picked Up"
			                            Event_Time = zoho.currenttime
			                            Hub = input.Origin_Hub
			                            Location_Text = "Origin hub"
			                            Details = "Shipment picked up by the assigned agent."
			                            Customer_Visible = true
			                        ];
			                    )
			                }
			            }
			        }
			
			        Dispatch_Shipment as "Dispatch Shipment"
			        {
			            type = normal
			            from stage = "Picked Up"
			            to stage = "In Transit"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin","Hub_Manager","Hub_Agent"}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Latest_Tracking_Text = "Shipment departed the current hub and is in transit.";
			                        trackingID = insert into Shipment_Tracking_Events
			                        [
			                            Shipment = input.ID
			                            Customer_Portal_User = input.Customer_Portal_User
			                            Event_Type = "Departed Hub"
			                            Event_Time = zoho.currenttime
			                            Hub = input.Current_Hub
			                            Location_Text = "Departed hub"
			                            Details = "Shipment dispatched on a manifest leg."
			                            Customer_Visible = true
			                        ];
			                    )
			                }
			            }
			        }
			
			        Receive_At_Hub as "Receive at Hub"
			        {
			            type = normal
			            from stage = "In Transit"
			            to stage = "At Hub"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin","Hub_Manager","Hub_Agent"}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Latest_Tracking_Text = "Shipment arrived at a hub.";
			                        trackingID = insert into Shipment_Tracking_Events
			                        [
			                            Shipment = input.ID
			                            Customer_Portal_User = input.Customer_Portal_User
			                            Event_Type = "Arrived Hub"
			                            Event_Time = zoho.currenttime
			                            Hub = input.Current_Hub
			                            Location_Text = "Arrival hub"
			                            Details = "Shipment arrived on a manifest leg."
			                            Customer_Visible = true
			                        ];
			                    )
			                }
			            }
			        }
			
			        Assign_Delivery as "Assign Delivery"
			        {
			            type = normal
			            from stage = "At Hub"
			            to stage = "Delivery Assigned"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin","Hub_Manager"}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Latest_Tracking_Text = "Shipment assigned for final delivery.";
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Delivery Assignment"
			                            Entity_Type = "Shipment_Requests"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Delivery Assigned"
			                            Before_Value = "At Hub"
			                            After_Value = "Delivery Assigned"
			                            Details = "Final-delivery task assigned by hub operations."
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			
			        Start_Delivery as "Start Delivery"
			        {
			            type = normal
			            from stage = "Delivery Assigned"
			            to stage = "Out for Delivery"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin","Hub_Manager","Hub_Agent"}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Latest_Tracking_Text = "Shipment is out for delivery.";
			                        trackingID = insert into Shipment_Tracking_Events
			                        [
			                            Shipment = input.ID
			                            Customer_Portal_User = input.Customer_Portal_User
			                            Event_Type = "Out for Delivery"
			                            Event_Time = zoho.currenttime
			                            Hub = input.Current_Hub
			                            Location_Text = "Delivery route"
			                            Details = "Final-delivery agent started the task."
			                            Customer_Visible = true
			                        ];
			                    )
			                }
			            }
			        }
			
			        Complete_Delivery as "Complete Delivery"
			        {
			            type = normal
			            from stage = "Out for Delivery"
			            to stage = "Delivered"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Logistics_Admin","Hub_Manager","Hub_Agent"}
			                )
			                confirmation before execution
			                (
			                    message = "Confirm successful delivery after proof has been captured?"
			                    confirm button text = "Mark Delivered"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        Delivered_On = zoho.currenttime;
			                        Latest_Tracking_Text = "Shipment delivered successfully.";
			                        customerRecord = Customers[ID == input.Customer];
			                        priorEarn = Loyalty_Transactions[Shipment == input.ID && Transaction_Type == "Earn"];
			                        if(customerRecord.count() > 0 && customerRecord.Current_Loyalty_Program != null && priorEarn.count() == 0)
			                        {
			                            programRecord = Loyalty_Programs[ID == customerRecord.Current_Loyalty_Program];
			                            if(programRecord.count() > 0 && programRecord.Active == true)
			                            {
			                                earnedPoints = (input.Net_Amount * programRecord.Points_Per_Rupee).round(0).toNumber();
			                                if(earnedPoints > 0)
			                                {
			                                    expiryDate = null;
			                                    if(programRecord.Expiry_Months > 0)
			                                    {
			                                        expiryDate = zoho.currentdate.addMonth(programRecord.Expiry_Months);
			                                    }
			                                    newBalance = customerRecord.Current_Points_Balance + earnedPoints;
			                                    transactionID = insert into Loyalty_Transactions
			                                    [
			                                        Customer = input.Customer
			                                        Customer_Portal_User = input.Customer_Portal_User
			                                        Shipment = input.ID
			                                        Program = programRecord.ID
			                                        Transaction_Type = "Earn"
			                                        Points = earnedPoints
			                                        Monetary_Value = 0
			                                        Transaction_Date = zoho.currenttime
			                                        Expiry_Date = expiryDate
			                                        Remaining_Points = earnedPoints
			                                        Used_Points = 0
			                                        Transaction_Status = "Posted"
			                                        Reference_Text = "Points earned on delivered shipment"
			                                        Balance_After = newBalance
			                                    ];
			                                    customerRecord.Current_Points_Balance = newBalance;
			                                    customerRecord.Overall_Points_Earned = customerRecord.Overall_Points_Earned + earnedPoints;
			                                    Available_Points = newBalance;
			                                }
			                            }
			                        }
			                        trackingID = insert into Shipment_Tracking_Events
			                        [
			                            Shipment = input.ID
			                            Customer_Portal_User = input.Customer_Portal_User
			                            Event_Type = "Delivered"
			                            Event_Time = zoho.currenttime
			                            Hub = input.Destination_Hub
			                            Location_Text = "Delivery address"
			                            Details = "Shipment delivered successfully."
			                            Customer_Visible = true
			                        ];
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Delivery Completion"
			                            Entity_Type = "Shipment_Requests"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Shipment Delivered"
			                            Before_Value = "Out for Delivery"
			                            After_Value = "Delivered"
			                            Details = "Delivery completed and eligible loyalty points posted once."
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			
			        Cancel_Shipment as "Cancel Shipment"
			        {
			            type = common
			            from stage = "Requested"
			            to stage = "Cancelled"
			            common stages = {"Quoted","Confirmed","Pickup Assigned","Picked Up","In Transit","At Hub","Delivery Assigned","Out for Delivery"}
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Customer_Portal","Logistics_Admin","Operations_Employee","Hub_Manager"}
			                )
			                confirmation before execution
			                (
			                    message = "Cancel this undelivered shipment and reverse any posted loyalty discount?"
			                    confirm button text = "Cancel Shipment"
			                    cancel button text = "Keep Shipment"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        previousStatus = input.Shipment_Status;
			                        Latest_Tracking_Text = "Shipment cancelled.";
			                        customerRecord = Customers[ID == input.Customer];
			                        redemptionRecord = Loyalty_Redemptions[Shipment == input.ID && Redemption_Type == "Shipment Discount" && Redemption_Status == "Applied"];
			                        if(customerRecord.count() > 0 && redemptionRecord.count() > 0 && redemptionRecord.Generated_Transaction != null)
			                        {
			                            originalTransaction = Loyalty_Transactions[ID == redemptionRecord.Generated_Transaction];
			                            reversalExists = Loyalty_Transactions[Shipment == input.ID && Transaction_Type == "Reverse" && Reference_Text == "Shipment cancellation reversal"];
			                            if(originalTransaction.count() > 0 && reversalExists.count() == 0)
			                            {
			                                pointsToRestore = 0 - originalTransaction.Points;
			                                newBalance = customerRecord.Current_Points_Balance + pointsToRestore;
			                                reversalID = insert into Loyalty_Transactions
			                                [
			                                    Customer = input.Customer
			                                    Customer_Portal_User = input.Customer_Portal_User
			                                    Shipment = input.ID
			                                    Program = originalTransaction.Program
			                                    Transaction_Type = "Reverse"
			                                    Points = pointsToRestore
			                                    Monetary_Value = originalTransaction.Monetary_Value
			                                    Transaction_Date = zoho.currenttime
			                                    Remaining_Points = pointsToRestore
			                                    Used_Points = 0
			                                    Transaction_Status = "Posted"
			                                    Reference_Text = "Shipment cancellation reversal"
			                                    Balance_After = newBalance
			                                ];
			                                originalTransaction.Transaction_Status = "Reversed";
			                                redemptionRecord.Redemption_Status = "Cancelled";
			                                customerRecord.Current_Points_Balance = newBalance;
			                                Available_Points = newBalance;
			                            }
			                        }
			                        trackingID = insert into Shipment_Tracking_Events
			                        [
			                            Shipment = input.ID
			                            Customer_Portal_User = input.Customer_Portal_User
			                            Event_Type = "Cancelled"
			                            Event_Time = zoho.currenttime
			                            Hub = input.Current_Hub
			                            Location_Text = "Shipment operations"
			                            Details = "Shipment cancelled before delivery."
			                            Customer_Visible = true
			                        ];
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Shipment Cancellation"
			                            Entity_Type = "Shipment_Requests"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Shipment Cancelled"
			                            Before_Value = previousStatus
			                            After_Value = "Cancelled"
			                            Details = "Undelivered shipment cancelled; posted loyalty discount reversed when applicable."
			                            Severity = "Warning"
			                        ];
			                    )
			                }
			            }
			        }
			    }
			}
		}
	}

	share_settings
	{
	"Customer_Portal"
	{
	    name = "Customer_Portal"
	    type = customer_portal
	    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
	    description = "Customer profile, KYC, shipment, tracking, loyalty, and redemption access"
	    ModulePermissions
	    {
	        Customers
	        {
	            enabled = View,Edit,Search,Tab
	            allFieldsVisible = false
	            FieldPermissions
	            {
	                Customer_ID{visibility:true,readonly:true}
	                Customer_Name{visibility:true,readonly:false}
	                Customer_Email{visibility:true,readonly:true}
	                Customer_Phone{visibility:true,readonly:false}
	                Customer_Type{visibility:true,readonly:true}
	                Primary_Address{visibility:true,readonly:false}
	                Company_Name{visibility:true,readonly:false}
	                GSTIN{visibility:true,readonly:false}
	                PAN{visibility:true,readonly:false}
	                CIN_or_Udyam_Number{visibility:true,readonly:false}
	                Billing_Contact_Name{visibility:true,readonly:false}
	                Billing_Email{visibility:true,readonly:false}
	                Portal_User{visibility:false}
	                Onboarding_Status{visibility:true,readonly:true}
	                KYC_Status{visibility:true,readonly:true}
	                Onboarded_On{visibility:true,readonly:true}
	                Active{visibility:true,readonly:true}
	                Current_Loyalty_Program{visibility:true,readonly:true}
	                Overall_Points_Earned{visibility:true,readonly:true}
	                Current_Points_Balance{visibility:true,readonly:true}
	            }
	        }
	        KYC_Document_Requests
	        {
	            enabled = View,Edit,Search,Tab
	            allFieldsVisible = false
	            FieldPermissions
	            {
	                Request_ID{visibility:true,readonly:true}
	                Customer{visibility:true,readonly:true}
	                Customer_Portal_User{visibility:false}
	                Rule{visibility:false}
	                Requested_Document_Name{visibility:true,readonly:true}
	                Instructions{visibility:true,readonly:true}
	                Required_Document{visibility:true,readonly:true}
	                Requested_By{visibility:false}
	                Requested_On{visibility:true,readonly:true}
	                Verification_Status{visibility:true,readonly:true}
	                Uploaded_Document{visibility:true,readonly:false}
	                Uploaded_On{visibility:true,readonly:true}
	                Reviewed_By{visibility:false}
	                Reviewed_On{visibility:true,readonly:true}
	                Review_Notes{visibility:true,readonly:true}
	                Rejection_Reason{visibility:true,readonly:true}
	            }
	            ReportPermissions
	            {
	                My_KYC_Documents={"View","Edit"}
