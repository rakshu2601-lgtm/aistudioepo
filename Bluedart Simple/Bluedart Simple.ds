			Customers_On_Success as "Complete Customer Onboarding Setup"
			{
			    type = form
			    form = Customers
			    record event = on add
			    description = "Creates portal access, applies onboarding status, and seeds data-driven KYC requests."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                portalAssignment = thisapp.portal.assignUserInProfile(input.Customer_Email, "Customer_Portal");
			                customerRecord = Customers[ID == input.ID];
			                if(customerRecord.count() > 0)
			                {
			                    customerRecord.Portal_User = input.Customer_Email;
			                    if(input.Customer_Type == "Retail")
			                    {
			                        customerRecord.Onboarding_Status = "Active";
			                        customerRecord.KYC_Status = "Not Required";
			                        customerRecord.Onboarded_On = zoho.currenttime;
			                    }
			                    else
			                    {
			                        customerRecord.Onboarding_Status = "Pending KYC";
			                        customerRecord.KYC_Status = "Awaiting Request";
			                        activeRules = KYC_Document_Rules[Customer_Type == input.Customer_Type && Active == true] sort by Sort_Order;
			                        for each activeRule in activeRules
			                        {
			                            requestID = insert into KYC_Document_Requests
			                            [
			                                Customer = input.ID
			                                Customer_Portal_User = input.Customer_Email
			                                Rule = activeRule.ID
			                                Requested_Document_Name = activeRule.Document_Name
			                                Instructions = activeRule.Instructions
			                                Required_Document = activeRule.Required_Document
			                                Requested_On = zoho.currenttime
			                                Verification_Status = "Draft"
			                            ];
			                        }
			                    }
			                }
			                auditID = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    User_Email = zoho.loginuserid
			                    User_Profile = "Customer Onboarding Workflow"
			                    Entity_Type = "Customers"
			                    Entity_Record_ID = input.ID.toString()
			                    Action = "Customer Onboarded"
			                    After_Value = input.Customer_Type
			                    Details = "Portal access assigned and onboarding status initialized."
			                    Severity = "Info"
			                ];
			            )
			        }
			    }
			}

			Customers_On_Validate as "Validate Customer Details"
			{
			    type = form
			    form = Customers
			    record event = on add or edit
			    description = "Requires and validates Indian business identifiers for Corporate and Wholesale customers."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Customer_Type == "Corporate" || input.Customer_Type == "Wholesale")
			                {
			                    if(ifnull(input.Company_Name, "").trim() == "" || ifnull(input.GSTIN, "").trim() == "" || ifnull(input.PAN, "").trim() == "")
			                    {
			                        alert "Company Name, GSTIN, and PAN are required for Corporate and Wholesale customers.";
			                        cancel submit;
			                    }
			                    input.GSTIN = input.GSTIN.trim().toUpperCase();
			                    input.PAN = input.PAN.trim().toUpperCase();
			                    if(input.GSTIN.matches("^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$") == false)
			                    {
			                        alert "Enter a valid 15-character Indian GSTIN.";
			                        cancel submit;
			                    }
			                    if(input.PAN.matches("^[A-Z]{5}[0-9]{4}[A-Z]$") == false)
			                    {
			                        alert "Enter a valid 10-character Indian PAN.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Customers_Protected_Fields_On_Validate as "Protect Customer System Fields"
			{
			    type = form
			    form = Customers
			    record event = on edit
			    description = "Prevents non-administrators from changing workflow-controlled onboarding and loyalty values."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                isAdministrator = thisapp.permissions.isUserInProfile("Logistics_Admin");
			                if(isAdministrator == false)
			                {
			                    if(old.Portal_User != input.Portal_User || old.Onboarding_Status != input.Onboarding_Status || old.KYC_Status != input.KYC_Status || old.Current_Loyalty_Program != input.Current_Loyalty_Program || old.Overall_Points_Earned != input.Overall_Points_Earned || old.Current_Points_Balance != input.Current_Points_Balance || old.Onboarded_On != input.Onboarded_On || old.Active != input.Active)
			                    {
			                        alert "Onboarding, portal ownership, and loyalty summary fields are managed by authorized workflows.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

