			KYC_Document_Requests_On_Load as "Configure KYC Request Form"
			{
			    type = form
			    form = KYC_Document_Requests
			    record event = on add or edit
			    description = "Shows upload fields to the owning customer and review fields to authorized staff."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                isPortalCustomer = thisapp.portal.isUserInProfile("Customer_Portal");
			                isAdministrator = thisapp.permissions.isUserInProfile("Logistics_Admin");
			                isOperations = thisapp.permissions.isUserInProfile("Operations_Employee");
			                if(isPortalCustomer == true && (input.Verification_Status == "Requested" || input.Verification_Status == "Rejected"))
			                {
			                    show Uploaded_Document;
			                    show Uploaded_On;
			                    enable Uploaded_Document;
			                    disable Uploaded_On;
			                }
			                else
			                {
			                    hide Uploaded_Document;
			                    hide Uploaded_On;
			                }
			                if(isAdministrator == true || isOperations == true)
			                {
			                    show Reviewed_By;
			                    show Reviewed_On;
			                    show Review_Notes;
			                    show Rejection_Reason;
			                }
			                else
			                {
			                    hide Reviewed_By;
			                    hide Reviewed_On;
			                    hide Review_Notes;
			                    hide Rejection_Reason;
			                }
			                disable Customer_Portal_User;
			                disable Requested_On;
			                disable Verification_Status;
			                disable Uploaded_On;
			                disable Reviewed_On;
			            )
			        }
			    }
			}

			KYC_Document_Requests_On_Validate as "Validate KYC Document Upload"
			{
			    type = form
			    form = KYC_Document_Requests
			    record event = on add or edit
			    description = "Enforces portal ownership for each KYC request."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                customerRecord = Customers[ID == input.Customer];
			                if(customerRecord.count() > 0 && input.Customer_Portal_User != customerRecord.Portal_User)
			                {
			                    alert "The KYC request owner must match the customer's portal user.";
			                    cancel submit;
			                }
			                isPortalCustomer = thisapp.portal.isUserInProfile("Customer_Portal");
			                if(isPortalCustomer == true && input.Customer_Portal_User != zoho.loginuserid)
			                {
			                    alert "You can update only your own KYC document requests.";
			                    cancel submit;
			                }
			            )
			        }
			    }
