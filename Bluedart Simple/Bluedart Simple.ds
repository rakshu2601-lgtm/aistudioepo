application "Bluedart-Simple"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "12-hr"



	forms
	{
		form Agent_Tasks
		{
		    title
		    {
		        displayname = "Agent Tasks"
		        on add = "Assign Agent Task"
		        on edit = "Edit Agent Task"
		    }
		    success message = "Agent task saved successfully."
		    record owner = Agent_User
		
		    Task_Assignment
		    (
		        type = section
		        displayname = "Task Assignment"
		        row = 1
		        column = 0
		    )
		    Task_Number
		    (
		        type = autonumber
		        displayname = "Task Number"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Task_Type
		    (
		        type = picklist
		        displayname = "Task Type"
		        values = {"Pickup","Delivery"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Shipment
		    (
		        type = picklist
		        displayname = "Shipment"
		        values = Shipment_Requests.ID
		        displayformat = [Shipment_Number]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Hub
		    (
		        type = picklist
		        displayname = "Hub"
		        values = Hubs[Status == "Active"].ID
		        displayformat = [Hub_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Assigned_Agent
		    (
		        type = picklist
		        displayname = "Assigned Agent"
		        values = Employees[Employee_Type == "Agent" && Active == true].ID
		        displayformat = [Employee_Name.first_name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Agent_User
		    (
		        type = picklist
		        displayname = "Agent User"
		        module = users
		        displayformat = [name]
		        row = 1
		        column = 1
		        width = medium
		    )
		    Scheduled_At
		    (
		        type = datetime
		        displayname = "Scheduled At"
		        mins_displayinterval = 5
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Contact_and_Location
		    (
		        type = section
		        displayname = "Contact and Location"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Contact_Name
		    (
		        type = text
		        displayname = "Contact Name"
		        maxchar = 120
		        personal data = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Contact_Phone
		    (
		        type = phonenumber
		        displayname = "Contact Phone"
		        allowedcountries = {in}
		        defaultcountry = "in"
		        personal data = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Task_Address
		    (
		        type = address
		        displayname = "Task Address"
		        capture_coordinates = true
		        adjust_using_map = true
		        address_line_1
		        (
		            type = address_line_1
		            displayname = "Address Line 1"
		        )
		        address_line_2
		        (
		            type = address_line_2
		            displayname = "Address Line 2"
		        )
		        district_city
		        (
		            type = district_city
		            displayname = "City"
		        )
		        state_province
		        (
		            type = state_province
		            displayname = "State"
		        )
		        postal_Code
		        (
		            type = postal_Code
		            displayname = "PIN Code"
		        )
		        country
		        (
		            type = country
		            displayname = "Country"
		        )
		        latitude
		        (
		            type = latitude
		            displayname = "Latitude"
		            visibility = false
		        )
		        longitude
		        (
		            type = longitude
		            displayname = "Longitude"
		            visibility = false
		        )
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Task_Progress
		    (
		        type = section
		        displayname = "Task Progress"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    must have Task_Status
		    (
		        type = picklist
		        displayname = "Task Status"
		        values = {"Assigned","Accepted","In Progress","Completed","Failed"}
		        initial value = "Assigned"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Accepted_On
		    (
		        type = datetime
		        displayname = "Accepted On"
		        mins_displayinterval = 5
		        row = 3
		        column = 2
		        width = medium
		    )
		    Started_On
		    (
		        type = datetime
		        displayname = "Started On"
		        mins_displayinterval = 5
		        row = 3
		        column = 1
		        width = medium
		    )
		    Completed_On
		    (
		        type = datetime
		        displayname = "Completed On"
		        mins_displayinterval = 5
		        row = 3
		        column = 2
		        width = medium
		    )
		
		    Completion_and_Exceptions
		    (
		        type = section
		        displayname = "Completion and Exceptions"
		        visibility = true
		        row = 4
		        column = 1
		    )
		    Recipient_Name
		    (
		        type = text
		        displayname = "Recipient Name"
		        maxchar = 120
		        personal data = true
		        row = 4
		        column = 1
		        width = medium
		    )
		    Proof_File
		    (
		        type = upload file
		        displayname = "Proof File"
		        browse = local_drive, google_docs, zoho_docs
		        row = 4
		        column = 2
		        width = medium
		    )
		    Recipient_Signature
		    (
		        type = signature
		        displayname = "Recipient Signature"
		        row = 4
		        column = 1
		        width = medium
		    )
		    Failure_Reason
		    (
		        type = textarea
		        displayname = "Failure Reason"
		        height = 90px
		        row = 4
		        column = 2
		        width = medium
		    )
		    Agent_Notes
		    (
		        type = textarea
		        displayname = "Agent Notes"
		        height = 90px
		        row = 4
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Assign Task"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Task"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Close"
		            )
		        }
		    }
		
		    blueprint components
		    {
		        stages = {"Assigned","Accepted","In Progress","Completed","Failed"}
		    }
		}

		form Audit_Log
		{
		    title
		    {
		        displayname = "Audit Log"
		        on add = "Add Audit Entry"
		        on edit = "View Audit Entry"
		    }
		    success message = "Audit entry recorded."
		
		    Event_Identity
		    (
		        type = section
		        displayname = "Event Identity"
		        row = 1
		        column = 0
		    )
		    Log_ID
		    (
		        type = autonumber
		        displayname = "Log ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Event_Time
		    (
		        type = datetime
		        displayname = "Event Time"
		        initial value = "${zoho.currenttime}"
		        mins_displayinterval = 5
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have User_Email
		    (
		        type = email
		        displayname = "User Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    User_Profile
		    (
		        type = text
		        displayname = "User Profile / Workflow"
		        maxchar = 255
		        row = 1
		        column = 1
		        width = medium
		    )
		    Severity
		    (
		        type = picklist
		        displayname = "Severity"
		        values = {"Info","Warning","Critical"}
		        initial value = "Info"
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Entity_and_Action
		    (
		        type = section
		        displayname = "Entity and Action"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Entity_Type
		    (
		        type = text
		        displayname = "Entity Type"
		        maxchar = 255
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Entity_Record_ID
		    (
		        type = text
		        displayname = "Entity Record ID"
		        maxchar = 255
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Action
		    (
		        type = text
		        displayname = "Action"
		        maxchar = 255
		        row = 2
		        column = 1
		        width = medium
		    )
		    Details
		    (
		        type = textarea
		        displayname = "Details"
		        height = 120px
		        row = 2
		        column = 2
		        width = medium
		    )
		
		    Change_Snapshot
		    (
		        type = section
		        displayname = "Change Snapshot"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Before_Value
		    (
		        type = textarea
		        displayname = "Before Value"
		        height = 120px
		        row = 3
		        column = 1
		        width = medium
		    )
		    After_Value
		    (
		        type = textarea
		        displayname = "After Value"
		        height = 120px
		        row = 3
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Customers
		{
		    title
		    {
		        displayname = "Customers"
		        on add = "Register Customer"
		        on edit = "Edit Customer Profile"
		    }
		    success message = "Customer profile saved successfully."
		    record owner = Portal_User
		
		    Customer_Identity
		    (
		        type = section
		        displayname = "Customer Identity"
		        row = 1
		        column = 0
		    )
		    Customer_ID
		    (
		        type = autonumber
		        displayname = "Customer ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Customer_Name
		    (
		        type = name
		        displayname = "Customer Name"
		        prefix
		        (
		            type = prefix
		            displayname = "Title"
		            value = {"Mr.","Mrs.","Ms.","Dr."}
		        )
		        first_name
		        (
		            type = first_name
		            displayname = "First Name"
		        )
		        last_name
		        (
		            type = last_name
		            displayname = "Last Name"
		        )
		        suffix
		        (
		            type = suffix
		            displayname = "Suffix"
		            visibility = false
		        )
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Customer_Email
		    (
		        type = email
		        displayname = "Customer Email"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Customer_Phone
		    (
		        type = phonenumber
		        displayname = "Customer Phone"
		        allowedcountries = {in}
		        defaultcountry = "in"
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Customer_Type
		    (
		        type = picklist
		        displayname = "Customer Type"
		        values = {"Retail","Corporate","Wholesale"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Primary_Address
		    (
		        type = address
		        displayname = "Primary Address"
		        capture_coordinates = true
		        adjust_using_map = true
		        address_line_1
		        (
		            type = address_line_1
		            displayname = "Address Line 1"
		        )
		        address_line_2
		        (
		            type = address_line_2
		            displayname = "Address Line 2"
		        )
		        district_city
		        (
		            type = district_city
		            displayname = "City"
		        )
		        state_province
		        (
		            type = state_province
		            displayname = "State"
		        )
		        postal_Code
		        (
		            type = postal_Code
		            displayname = "PIN Code"
		        )
		        country
		        (
		            type = country
		            displayname = "Country"
		        )
		        latitude
		        (
		            type = latitude
		            displayname = "Latitude"
		            visibility = false
		        )
		        longitude
		        (
		            type = longitude
		            displayname = "Longitude"
		            visibility = false
		        )
		        row = 1
		        column = 2
		        width = medium
		    )
		    Business_Details
		    (
		        type = section
		        displayname = "Business Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Company_Name
		    (
		        type = text
		        displayname = "Company Name"
		        maxchar = 150
		        row = 2
		        column = 1
		        width = medium
		    )
		    GSTIN
		    (
		        type = text
		        displayname = "GSTIN"
		        maxchar = 15
		        row = 2
		        column = 2
		        width = medium
		    )
		    PAN
		    (
		        type = text
		        displayname = "PAN"
		        maxchar = 10
		        row = 2
		        column = 1
		        width = medium
		    )
		    CIN_or_Udyam_Number
		    (
		        type = text
		        displayname = "CIN or Udyam Number"
		        maxchar = 30
		        row = 2
		        column = 2
		        width = medium
		    )
		    Billing_Contact_Name
		    (
		        type = text
		        displayname = "Billing Contact Name"
		        maxchar = 100
		        row = 2
		        column = 1
		        width = medium
		    )
		    Billing_Email
		    (
		        type = email
		        displayname = "Billing Email"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Account_Status
		    (
		        type = section
		        displayname = "Account Status"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Portal_User
		    (
		        type = picklist
		        displayname = "Portal User"
		        module = users
		        user type = "portal users"
		        displayformat = [name]
		        row = 3
		        column = 1
		        width = medium
		    )
		    Onboarding_Status
		    (
		        type = picklist
		        displayname = "Onboarding Status"
		        values = {"New","Pending KYC","Active","Suspended","Rejected"}
		        initial value = "New"
		        row = 3
		        column = 2
		        width = medium
		    )
		    KYC_Status
		    (
		        type = picklist
		        displayname = "KYC Status"
		        values = {"Not Required","Awaiting Request","Documents Requested","Under Review","Approved","Rejected"}
		        initial value = "Not Required"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Onboarded_On
		    (
		        type = datetime
		        displayname = "Onboarded On"
		        mins_displayinterval = 5
		        row = 3
		        column = 2
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 3
		        column = 1
		        width = medium
		    )
		    Loyalty_Summary
		    (
		        type = section
		        displayname = "Loyalty Summary"
		        visibility = true
		        row = 4
		        column = 1
		    )
		    Current_Loyalty_Program
		    (
		        type = picklist
		        displayname = "Current Loyalty Program"
		        values = Loyalty_Programs.ID
		        displayformat = [Tier_Name]
		        searchable = true
		        row = 4
		        column = 1
		        width = medium
		    )
		    Overall_Points_Earned
		    (
		        type = number
		        displayname = "Overall Points Earned"
		        format = commadotindian
		        initial value = 0
		        row = 4
		        column = 2
		        width = medium
		    )
		    Current_Points_Balance
		    (
		        type = number
		        displayname = "Current Points Balance"
		        format = commadotindian
		        initial value = 0
		        row = 4
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Register Customer"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Profile"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Employees
		{
		    title
		    {
		        displayname = "Employees"
		        on add = "Add Employee"
		        on edit = "Edit Employee"
		    }
		    success message = "Employee saved successfully."
		
		    Employee_Identity
		    (
		        type = section
		        displayname = "Employee Identity"
		        row = 1
		        column = 0
		    )
		    Employee_ID
		    (
		        type = autonumber
		        displayname = "Employee ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Employee_Name
		    (
		        type = name
		        displayname = "Employee Name"
		        prefix
		        (
		            type = prefix
		            displayname = "Title"
		            value = {"Mr.","Mrs.","Ms.","Dr."}
		        )
		        first_name
		        (
		            type = first_name
		            displayname = "First Name"
		        )
		        last_name
		        (
		            type = last_name
		            displayname = "Last Name"
		        )
		        suffix
		        (
		            type = suffix
		            displayname = "Suffix"
		            visibility = false
		        )
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Work_Email
		    (
		        type = email
		        displayname = "Work Email"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Phone
		    (
		        type = phonenumber
		        displayname = "Phone"
		        allowedcountries = {in}
		        defaultcountry = "in"
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Employment_Details
		    (
		        type = section
		        displayname = "Employment Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Internal_User
		    (
		        type = picklist
		        displayname = "Internal User"
		        module = users
		        displayformat = [name]
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Employee_Type
		    (
		        type = picklist
		        displayname = "Employee Type"
		        values = {"Administrator","Hub Manager","Operations Employee","Agent"}
		        row = 2
		        column = 2
		        width = medium
		    )
		    Hub
		    (
		        type = picklist
		        displayname = "Hub"
		        values = Hubs.ID
		        displayformat = [Hub_Name]
		        searchable = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    Availability_Status
		    (
		        type = picklist
		        displayname = "Availability Status"
		        values = {"Available","Assigned","Off Duty","Inactive"}
		        initial value = "Available"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Employee"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Employee"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Hubs
		{
		    title
		    {
		        displayname = "Hubs"
		        on add = "Add Hub"
		        on edit = "Edit Hub"
		    }
		    success message = "Hub saved successfully."
		
		    Hub_Information
		    (
		        type = section
		        displayname = "Hub Information"
		        row = 1
		        column = 0
		    )
		    Hub_ID
		    (
		        type = autonumber
		        displayname = "Hub ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Hub_Code
		    (
		        type = text
		        displayname = "Hub Code"
		        maxchar = 30
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Hub_Name
		    (
		        type = text
		        displayname = "Hub Name"
		        maxchar = 100
		        row = 1
		        column = 2
		        width = medium
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Inactive"}
		        initial value = "Active"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Contact_and_Location
		    (
		        type = section
		        displayname = "Contact and Location"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Hub_Address
		    (
		        type = address
		        displayname = "Hub Address"
		        capture_coordinates = true
		        adjust_using_map = true
		        address_line_1
		        (
		            type = address_line_1
		            displayname = "Address Line 1"
		        )
		        address_line_2
		        (
		            type = address_line_2
		            displayname = "Address Line 2"
		        )
		        district_city
		        (
		            type = district_city
		            displayname = "City"
		        )
		        state_province
		        (
		            type = state_province
		            displayname = "State"
		        )
		        postal_Code
		        (
		            type = postal_Code
		            displayname = "PIN Code"
		        )
		        country
		        (
		            type = country
		            displayname = "Country"
		        )
		        latitude
		        (
		            type = latitude
		            displayname = "Latitude"
		            visibility = false
		        )
		        longitude
		        (
		            type = longitude
		            displayname = "Longitude"
		            visibility = false
		        )
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Manager_User
		    (
		        type = picklist
		        displayname = "Hub Manager"
		        module = users
		        displayformat = [name]
		        row = 2
		        column = 2
		        width = medium
		    )
		    Contact_Phone
		    (
		        type = phonenumber
		        displayname = "Contact Phone"
		        allowedcountries = {in}
		        defaultcountry = "in"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Contact_Email
		    (
		        type = email
		        displayname = "Contact Email"
		        row = 2
