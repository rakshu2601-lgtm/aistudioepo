		        Transaction_Status
		        Reference_Text
		        Balance_After
		        Created_By
		    )
		    filters
		    (
		        Customer
		        Shipment
		        Program
		        Transaction_Type
		        Transaction_Date
		        Expiry_Date
		        Transaction_Status
		        Created_By
		        "Open Earn Lots" : (Transaction_Type == "Earn" && Remaining_Points > 0)
		        "Adjustments and Reversals" : (Transaction_Type == "Adjust" || Transaction_Type == "Reverse")
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Customer ascending
		    )
		    sort by
		    (
		        Transaction_Date descending
		        Transaction_ID descending
		    )
		}

