			            (
			                input.Agent_User = null;
			                if(input.Assigned_Agent != null)
			                {
			                    agentRecord = Employees[ID == input.Assigned_Agent && Employee_Type == "Agent" && Active == true];
			                    if(agentRecord.count() > 0)
			                    {
			                        input.Agent_User = agentRecord.Internal_User;
			                    }
			                }
			            )
			        }
