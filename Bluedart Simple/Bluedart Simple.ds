			Loyalty_Transactions_On_Success as "Post Loyalty Ledger Entry"
			{
			    type = form
			    form = Loyalty_Transactions
			    record event = on add
			    description = "Recalculates cached balances, consumes oldest lots, selects the applicable programme tier, and audits exceptional entries."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                customerRecord = Customers[ID == input.Customer];
			                if(customerRecord.count() > 0)
			                {
			                    if(input.Transaction_Type == "Redeem")
			                    {
			                        pointsToAllocate = 0 - input.Points;
			                        positiveLots = Loyalty_Transactions[Customer == input.Customer && Points > 0 && Remaining_Points > 0 && Transaction_Status != "Expired" && ID != input.ID] sort by Transaction_Date;
			                        for each positiveLot in positiveLots
			                        {
			                            if(pointsToAllocate > 0)
			                            {
			                                lotAvailable = ifnull(positiveLot.Remaining_Points,0);
			                                lotUsed = lotAvailable;
			                                if(lotUsed > pointsToAllocate)
			                                {
			                                    lotUsed = pointsToAllocate;
			                                }
			                                positiveLot.Remaining_Points = lotAvailable - lotUsed;
			                                positiveLot.Used_Points = ifnull(positiveLot.Used_Points,0) + lotUsed;
			                                pointsToAllocate = pointsToAllocate - lotUsed;
			                            }
			                        }
			                    }
			                    ledgerBalance = ifnull(Loyalty_Transactions[Customer == input.Customer].sum(Points),0);
			                    lifetimeEarned = ifnull(Loyalty_Transactions[Customer == input.Customer && Transaction_Type == "Earn"].sum(Points),0);
			                    customerRecord.Current_Points_Balance = ledgerBalance;
			                    customerRecord.Overall_Points_Earned = lifetimeEarned;
			                    transactionRecord = Loyalty_Transactions[ID == input.ID];
			                    if(transactionRecord.count() > 0)
			                    {
			                        transactionRecord.Balance_After = ledgerBalance;
			                    }
			                    selectedProgram = null;
			                    eligiblePrograms = Loyalty_Programs[Active == true && Customer_Type == customerRecord.Customer_Type && Min_Lifetime_Points <= lifetimeEarned && (Max_Lifetime_Points is null || Max_Lifetime_Points >= lifetimeEarned) && Effective_From <= zoho.currentdate && (Effective_To is null || Effective_To >= zoho.currentdate)] sort by Priority;
			                    for each eligibleProgram in eligiblePrograms
			                    {
			                        if(selectedProgram == null)
			                        {
			                            selectedProgram = eligibleProgram.ID;
			                        }
			                    }
			                    if(selectedProgram != null)
			                    {
			                        customerRecord.Current_Loyalty_Program = selectedProgram;
			                    }
			                    if(input.Transaction_Type == "Adjust" || input.Transaction_Type == "Reverse" || input.Transaction_Type == "Expire")
			                    {
			                        auditID = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = "Loyalty Ledger"
			                            Entity_Type = "Loyalty_Transactions"
			                            Entity_Record_ID = input.ID.toString()
			                            Action = "Loyalty " + input.Transaction_Type
			                            After_Value = input.Points.toString()
			                            Details = ifnull(input.Reference_Text,"Signed loyalty ledger entry posted.")
			                            Severity = if(input.Transaction_Type == "Adjust","Warning","Info")
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

			Loyalty_Transactions_On_Validate as "Validate Loyalty Ledger Entry"
			{
			    type = form
			    form = Loyalty_Transactions
			    record event = on add or edit
			    description = "Validates signed points, ownership, lot values, and the resulting authoritative balance."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                isAdministrator = thisapp.permissions.isUserInProfile("Logistics_Admin");
			                if(input.ID == null && isAdministrator == false)
			                {
			                    alert "Only logistics administrators and trusted application workflows can post loyalty ledger entries.";
			                    cancel submit;
			                }
			                customerRecord = Customers[ID == input.Customer];
			                if(customerRecord.count() == 0)
			                {
			                    alert "Select a valid customer.";
			                    cancel submit;
			                }
			                input.Customer_Portal_User = customerRecord.Portal_User;
			                if(input.Transaction_Date == null)
			                {
			                    input.Transaction_Date = zoho.currenttime;
			                }
			                if(input.Points == 0)
			                {
			                    alert "Points must be a non-zero signed value.";
			                    cancel submit;
			                }
			                if(input.Transaction_Type == "Earn" && input.Points < 0)
			                {
			                    alert "Earn transactions must contain positive points.";
			                    cancel submit;
			                }
			                if((input.Transaction_Type == "Redeem" || input.Transaction_Type == "Expire") && input.Points > 0)
			                {
			                    alert "Redeem and expiry transactions must contain negative points.";
			                    cancel submit;
			                }
			                if(ifnull(input.Monetary_Value,0) < 0 || ifnull(input.Remaining_Points,0) < 0 || ifnull(input.Used_Points,0) < 0)
			                {
			                    alert "Monetary value and lot point values cannot be negative.";
			                    cancel submit;
			                }
			                if(input.Shipment != null)
			                {
			                    shipmentRecord = Shipment_Requests[ID == input.Shipment];
			                    if(shipmentRecord.count() == 0 || shipmentRecord.Customer != input.Customer)
			                    {
			                        alert "The selected shipment must belong to this customer.";
			                        cancel submit;
			                    }
			                }
			                if(input.ID == null)
			                {
			                    currentBalance = ifnull(Loyalty_Transactions[Customer == input.Customer].sum(Points),0);
			                    if(currentBalance + input.Points < 0)
			                    {
			                        alert "This transaction would make the customer's loyalty balance negative.";
			                        cancel submit;
			                    }
			                    if(input.Transaction_Type == "Earn")
			                    {
			                        input.Remaining_Points = input.Points;
			                        input.Used_Points = 0;
			                        if(input.Program != null && input.Expiry_Date == null)
			                        {
			                            programRecord = Loyalty_Programs[ID == input.Program];
			                            if(programRecord.count() > 0 && ifnull(programRecord.Expiry_Months,0) > 0)
			                            {
			                                input.Expiry_Date = zoho.currentdate.addMonth(programRecord.Expiry_Months);
			                            }
			                        }
			                    }
			                    currentEmployee = Employees[Work_Email == zoho.loginuserid && Active == true];
			                    if(input.Created_By == null && currentEmployee.count() > 0)
			                    {
			                        input.Created_By = currentEmployee.ID;
			                    }
			                }
			                else
			                {
			                    persistedTransaction = Loyalty_Transactions[ID == input.ID];
			                    if(persistedTransaction.Customer != input.Customer || persistedTransaction.Customer_Portal_User != input.Customer_Portal_User || persistedTransaction.Shipment != input.Shipment || persistedTransaction.Program != input.Program || persistedTransaction.Transaction_Type != input.Transaction_Type || persistedTransaction.Points != input.Points || persistedTransaction.Monetary_Value != input.Monetary_Value || persistedTransaction.Transaction_Date != input.Transaction_Date || persistedTransaction.Expiry_Date != input.Expiry_Date || persistedTransaction.Remaining_Points != input.Remaining_Points || persistedTransaction.Used_Points != input.Used_Points || persistedTransaction.Transaction_Status != input.Transaction_Status || persistedTransaction.Reference_Text != input.Reference_Text || persistedTransaction.Balance_After != input.Balance_After || persistedTransaction.Created_By != input.Created_By)
			                    {
			                        alert "Posted loyalty ledger entries are immutable. Create an adjustment or reversal instead.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Manifest_Items_On_Load as "Configure Manifest Shipment on Load"
			{
			    type = form
			    form = Manifest_Items
			    record event = on add or edit
			    description = "Filters eligible shipments, copies manifest ownership, and protects blueprint-managed handling fields."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Assigned_Agent_User;
			                disable Loaded_On;
			                disable Unloaded_On;
			                isAdministrator = thisapp.permissions.isUserInProfile("Logistics_Admin");
			                isAgent = thisapp.permissions.isUserInProfile("Hub_Agent");
			                if(input.Manifest != null)
			                {
			                    manifestRecord = Manifests[ID == input.Manifest];
			                    if(manifestRecord.count() > 0)
			                    {
			                        input.Assigned_Agent_User = manifestRecord.Assigned_Agent_User;
			                        clear Shipment;
			                        eligibleShipments = Shipment_Requests[((Shipment_Status == "Confirmed" && Origin_Hub == manifestRecord.Origin_Hub) || ((Shipment_Status == "Picked Up" || Shipment_Status == "At Hub") && Current_Hub == manifestRecord.Origin_Hub)) || ID == input.Shipment] sort by Shipment_Number;
			                        if(eligibleShipments.count() > 0)
			                        {
			                            Shipment:ui.add(eligibleShipments.ID.getall());
			                        }
			                    }
			                }
			                else
			                {
			                    clear Shipment;
			                    input.Assigned_Agent_User = null;
			                }
			                if(isAdministrator == false)
			                {
			                    disable Item_Status;
			                    if(isAgent == true && input.Assigned_Agent_User == zoho.loginuserid && input.ID != null)
			                    {
			                        enable Item_Status;
			                        enable Exception_Notes;
			                    }
			                }
			            )
			        }
			    }
			}

			Manifest_Items_On_Success as "Complete Manifest Shipment Save"
			{
			    type = form
			    form = Manifest_Items
			    record event = on add or edit
			    description = "Synchronizes manifest ownership, records loading time, and audits handling exceptions."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                itemRecord = Manifest_Items[ID == input.ID];
			                manifestRecord = Manifests[ID == input.Manifest];
			                if(itemRecord.count() > 0 && manifestRecord.count() > 0)
			                {
			                    itemRecord.Assigned_Agent_User = manifestRecord.Assigned_Agent_User;
			                    if(itemRecord.Loaded_On == null)
			                    {
			                        itemRecord.Loaded_On = zoho.currenttime;
			                    }
			                }
			                if(input.Item_Status == "Exception")
			                {
			                    auditID = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        User_Email = zoho.loginuserid
			                        User_Profile = "Manifest Item Exception"
			                        Entity_Type = "Manifest_Items"
			                        Entity_Record_ID = input.ID.toString()
			                        Action = "Journey Leg Exception Recorded"
			                        Before_Value = "In Handling"
			                        After_Value = "Exception"
			                        Details = input.Exception_Notes
			                        Severity = "Warning"
			                    ];
			                }
			            )
			        }
			    }
			}

			Manifest_Items_On_Validate as "Validate Manifest Shipment"
			{
			    type = form
			    form = Manifest_Items
			    record event = on add or edit
			    description = "Enforces eligible origin-hub loading, unique sequential journey legs, ownership, and exception-only agent edits."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                manifestRecord = Manifests[ID == input.Manifest];
			                shipmentRecord = Shipment_Requests[ID == input.Shipment];
			                if(manifestRecord.count() == 0 || shipmentRecord.count() == 0)
			                {
			                    alert "Select a valid manifest and shipment.";
			                    cancel submit;
			                }
			                coreLinkChanged = false;
			                persistedItem = Manifest_Items[ID == input.ID];
			                if(input.ID == null)
			                {
			                    coreLinkChanged = true;
			                }
			                else if(persistedItem.Manifest != input.Manifest || persistedItem.Shipment != input.Shipment || persistedItem.Leg_Sequence != input.Leg_Sequence)
			                {
			                    coreLinkChanged = true;
			                }
			                if(coreLinkChanged == true && manifestRecord.Manifest_Status != "Draft" && manifestRecord.Manifest_Status != "Ready")
			                {
			                    alert "Shipments can be added or resequenced only while the manifest is Draft or Ready.";
			                    cancel submit;
			                }
			                if(input.Leg_Sequence == null || input.Leg_Sequence <= 0)
			                {
			                    alert "Leg sequence must be a positive whole number.";
			                    cancel submit;
			                }
			                duplicateLinks = Manifest_Items[Manifest == input.Manifest && Shipment == input.Shipment];
			                for each duplicateLink in duplicateLinks
			                {
			                    if(duplicateLink.ID != input.ID)
			                    {
			                        alert "This shipment is already linked to the selected manifest leg.";
			                        cancel submit;
			                    }
			                }
			                if(coreLinkChanged == true)
			                {
			                    statusEligible = shipmentRecord.Shipment_Status == "Confirmed" || shipmentRecord.Shipment_Status == "Picked Up" || shipmentRecord.Shipment_Status == "At Hub";
			                    hubEligible = false;
			                    if(shipmentRecord.Shipment_Status == "Confirmed" && shipmentRecord.Origin_Hub == manifestRecord.Origin_Hub)
			                    {
			                        hubEligible = true;
			                    }
			                    if((shipmentRecord.Shipment_Status == "Picked Up" || shipmentRecord.Shipment_Status == "At Hub") && shipmentRecord.Current_Hub == manifestRecord.Origin_Hub)
			                    {
			                        hubEligible = true;
			                    }
			                    if(statusEligible == false || hubEligible == false)
			                    {
			                        alert "The shipment must be Confirmed, Picked Up, or At Hub and associated with the manifest origin hub.";
			                        cancel submit;
			                    }
			                    expectedSequence = 1;
			                    previousDestination = null;
			                    existingLegs = Manifest_Items[Shipment == input.Shipment] sort by Leg_Sequence;
			                    for each existingLeg in existingLegs
			                    {
			                        if(existingLeg.ID != input.ID && existingLeg.Leg_Sequence >= expectedSequence)
			                        {
			                            expectedSequence = existingLeg.Leg_Sequence + 1;
			                            previousManifest = Manifests[ID == existingLeg.Manifest];
			                            if(previousManifest.count() > 0)
			                            {
			                                previousDestination = previousManifest.Destination_Hub;
			                            }
			                        }
			                    }
			                    if(input.Leg_Sequence != expectedSequence)
			                    {
			                        alert "The next journey leg for this shipment must use sequence " + expectedSequence.toString() + ".";
			                        cancel submit;
			                    }
			                    if(expectedSequence > 1 && previousDestination != manifestRecord.Origin_Hub)
			                    {
			                        alert "The manifest origin hub must match the preceding journey leg's destination hub.";
			                        cancel submit;
			                    }
			                }
			                input.Assigned_Agent_User = manifestRecord.Assigned_Agent_User;
			                isAdministrator = thisapp.permissions.isUserInProfile("Logistics_Admin");
			                isAgent = thisapp.permissions.isUserInProfile("Hub_Agent");
			                currentEmployee = Employees[Work_Email == zoho.loginuserid && Active == true];
			                if(isAdministrator == false)
			                {
			                    if(currentEmployee.count() == 0)
			                    {
			                        alert "Only authorized logistics employees can manage manifest shipments.";
			                        cancel submit;
			                    }
			                    if(isAgent == true)
			                    {
			                        if(input.Assigned_Agent_User != zoho.loginuserid)
			                        {
			                            alert "Agents can update only items on their assigned manifests.";
			                            cancel submit;
			                        }
			                        if(input.ID == null || coreLinkChanged == true || persistedItem.Assigned_Agent_User != input.Assigned_Agent_User || persistedItem.Loaded_On != input.Loaded_On || persistedItem.Unloaded_On != input.Unloaded_On)
			                        {
			                            alert "Agents cannot change manifest links, sequence, ownership, or handling timestamps.";
			                            cancel submit;
			                        }
			                        if(persistedItem.Item_Status != input.Item_Status && input.Item_Status != "Exception")
			                        {
			                            alert "Agents may change an item status only to Exception.";
			                            cancel submit;
			                        }
			                    }
			                    else
			                    {
			                        if(currentEmployee.Hub != manifestRecord.Origin_Hub && currentEmployee.Hub != manifestRecord.Destination_Hub)
			                        {
			                            alert "You can manage only manifest items touching your assigned hub.";
			                            cancel submit;
			                        }
			                        if(input.ID != null && (persistedItem.Assigned_Agent_User != input.Assigned_Agent_User || persistedItem.Item_Status != input.Item_Status || persistedItem.Loaded_On != input.Loaded_On || persistedItem.Unloaded_On != input.Unloaded_On))
			                        {
			                            alert "Handling status, ownership, and timestamps are managed by manifest workflows.";
			                            cancel submit;
			                        }
			                    }
			                }
			                if(input.Item_Status == "Exception" && input.Exception_Notes in {""," ","null"})
			                {
			                    alert "Enter exception notes when recording a manifest-item exception.";
			                    cancel submit;
			                }
			                if(input.ID == null && input.Item_Status != "Loaded")
			                {
			                    alert "A new manifest item must begin with Loaded status.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Manifest_On_User_Input as "Filter Shipments for Manifest"
			{
			    type = form
			    form = Manifest_Items
			    record event = on add or edit
			    description = "Refreshes eligible shipments and assigned ownership when the selected manifest changes."
			
			    on user input of Manifest
			    {
			        actions
			        {
			            custom deluge script
			            (
			                clear Shipment;
			                input.Shipment = null;
			                input.Leg_Sequence = null;
			                input.Assigned_Agent_User = null;
			                if(input.Manifest != null)
			                {
			                    manifestRecord = Manifests[ID == input.Manifest];
			                    if(manifestRecord.count() > 0)
			                    {
			                        input.Assigned_Agent_User = manifestRecord.Assigned_Agent_User;
			                        eligibleShipments = Shipment_Requests[(Shipment_Status == "Confirmed" && Origin_Hub == manifestRecord.Origin_Hub) || ((Shipment_Status == "Picked Up" || Shipment_Status == "At Hub") && Current_Hub == manifestRecord.Origin_Hub)] sort by Shipment_Number;
			                        if(eligibleShipments.count() > 0)
			                        {
			                            Shipment:ui.add(eligibleShipments.ID.getall());
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Shipment_On_User_Input as "Set Shipment Leg Sequence"
			{
			    type = form
			    form = Manifest_Items
			    record event = on add or edit
			    description = "Suggests the next positive journey-leg sequence for the selected shipment."
			
			    on user input of Shipment
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Shipment == null)
			                {
			                    input.Leg_Sequence = null;
			                }
			                else
			                {
			                    nextSequence = 1;
			                    shipmentLegs = Manifest_Items[Shipment == input.Shipment] sort by Leg_Sequence;
			                    for each shipmentLeg in shipmentLegs
			                    {
			                        if(shipmentLeg.ID != input.ID && shipmentLeg.Leg_Sequence >= nextSequence)
			                        {
			                            nextSequence = shipmentLeg.Leg_Sequence + 1;
			                        }
			                    }
			                    input.Leg_Sequence = nextSequence;
			                }
			            )
			        }
			    }
			}

			Manifest_Assigned_Agent_On_User_Input as "Copy Manifest Agent Owner"
			{
			    type = form
			    form = Manifests
			    record event = on add or edit
			    description = "Copies the selected agent's internal user into the manifest record owner field."
			
			    on user input of Assigned_Agent
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Assigned_Agent != null)
			                {
			                    agentRecord = Employees[ID == input.Assigned_Agent];
			                    if(agentRecord.count() > 0)
			                    {
			                        input.Assigned_Agent_User = agentRecord.Internal_User;
			                    }
			                }
			                else
			                {
			                    input.Assigned_Agent_User = null;
			                }
			            )
			        }
			    }
			}

			Manifests_On_Load as "Configure Manifest Leg Form"
			{
			    type = form
			    form = Manifests
			    record event = on add or edit
			    description = "Protects lifecycle fields and limits operational users to manifests connected with their own hub."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Assigned_Agent_User;
			                disable Actual_Departure;
			                disable Actual_Arrival;
			                disable Manifest_Status;
			                currentEmployee = Employees[Work_Email == zoho.loginuserid && Active == true];
			                isAdmin = thisapp.permissions.isUserInProfile("Logistics_Admin");
			                if(currentEmployee.count() > 0 && currentEmployee.Employee_Type == "Agent")
			                {
			                    disable Manifest_Type;
			                    disable Origin_Hub;
			                    disable Destination_Hub;
			                    disable Transport_Mode;
			                    disable Assigned_Agent;
			                    disable Vehicle_or_Carrier_Details;
			                    disable Planned_Departure;
			                    disable Planned_Arrival;
			                    disable Notes;
			                }
			                else if(isAdmin == false && currentEmployee.count() > 0 && currentEmployee.Hub != null)
			                {
			                    if(input.ID == null)
			                    {
			                        input.Origin_Hub = currentEmployee.Hub;
			                    }
			                }
			            )
			        }
			    }
			}

			Manifests_On_Success as "Synchronize Manifest Agent Ownership"
			{
			    type = form
			    form = Manifests
			    record event = on add or edit
			    description = "Keeps the manifest record owner synchronized with the selected active agent."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Assigned_Agent != null)
			                {
			                    agentRecord = Employees[ID == input.Assigned_Agent];
			                    manifestRecord = Manifests[ID == input.ID];
			                    if(agentRecord.count() > 0 && manifestRecord.count() > 0)
			                    {
			                        manifestRecord.Assigned_Agent_User = agentRecord.Internal_User;
			                    }
			                }
			            )
			        }
			    }
			}

			Manifests_On_Validate as "Validate Manifest Leg"
			{
			    type = form
			    form = Manifests
			    record event = on add or edit
			    description = "Enforces active hubs, agent ownership, hub access, journey timing, and lifecycle field protection."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                originRecord = Hubs[ID == input.Origin_Hub];
			                destinationRecord = Hubs[ID == input.Destination_Hub];
			                if(originRecord.count() == 0 || destinationRecord.count() == 0 || originRecord.Status != "Active" || destinationRecord.Status != "Active")
			                {
			                    alert "Select active origin and destination hubs.";
			                    cancel submit;
			                }
			                if(input.Origin_Hub == input.Destination_Hub)
			                {
			                    alert "A manifest leg must connect two different hubs.";
			                    cancel submit;
			                }
			                if(input.Planned_Departure != null && input.Planned_Arrival != null && input.Planned_Arrival <= input.Planned_Departure)
			                {
			                    alert "Planned arrival must be after planned departure.";
			                    cancel submit;
			                }
			                if(input.Actual_Departure != null && input.Actual_Arrival != null && input.Actual_Arrival < input.Actual_Departure)
			                {
			                    alert "Actual arrival cannot be before actual departure.";
			                    cancel submit;
			                }
			                if(input.Manifest_Status != "Draft" && input.Assigned_Agent == null)
			                {
			                    alert "Assign an agent before the manifest leaves Draft.";
			                    cancel submit;
			                }
			                if(input.Assigned_Agent != null)
			                {
			                    agentRecord = Employees[ID == input.Assigned_Agent];
			                    if(agentRecord.count() == 0 || agentRecord.Active == false || agentRecord.Employee_Type != "Agent" || agentRecord.Internal_User == null)
			                    {
			                        alert "Select an active agent with an internal user account.";
			                        cancel submit;
			                    }
			                    if(agentRecord.Hub != input.Origin_Hub)
			                    {
			                        alert "The assigned agent must belong to the manifest origin hub.";
			                        cancel submit;
			                    }
			                    if(input.Assigned_Agent_User != agentRecord.Internal_User)
			                    {
			                        input.Assigned_Agent_User = agentRecord.Internal_User;
			                    }
			                }
			                else
			                {
			                    input.Assigned_Agent_User = null;
			                }
			                currentEmployee = Employees[Work_Email == zoho.loginuserid && Active == true];
			                isAdmin = thisapp.permissions.isUserInProfile("Logistics_Admin");
			                if(isAdmin == false && currentEmployee.count() > 0)
			                {
			                    if(currentEmployee.Employee_Type == "Hub Manager" && currentEmployee.Hub != input.Origin_Hub && currentEmployee.Hub != input.Destination_Hub)
			                    {
			                        alert "Hub managers can manage only manifests touching their own hub.";
			                        cancel submit;
			                    }
			                    if(currentEmployee.Employee_Type == "Agent" && input.Assigned_Agent_User != currentEmployee.Internal_User)
			                    {
			                        alert "Agents can access only manifests assigned to them.";
			                        cancel submit;
			                    }
			                }
			                if(input.Manifest_Status != "Draft")
			                {
			                    manifestItems = Manifest_Items[Manifest == input.ID];
			                    if(manifestItems.count() == 0)
			                    {
			                        alert "Add at least one shipment before the manifest leaves Draft.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Shipment_Customer_On_User_Input as "Populate Customer and Recalculate Quote"
			{
			    type = form
			    form = Shipment_Requests
			    record event = on add or edit
			    description = "Copies customer ownership and loyalty values, then selects the configured transport rate."
			
			    on user input of Customer
			    {
			        actions
			        {
			            custom deluge script
			            (
			                customerRecord = Customers[ID == input.Customer];
			                if(customerRecord.count() > 0)
			                {
			                    input.Customer_Portal_User = customerRecord.Portal_User;
			                    input.Available_Points = ifnull(customerRecord.Current_Points_Balance,0);
			                    if(input.Pickup_Contact_Name in {""," ","null"})
			                    {
			                        input.Pickup_Contact_Name = customerRecord.Customer_Name.first_name;
			                        input.Pickup_Phone = customerRecord.Customer_Phone;
			                        input.Pickup_Address = customerRecord.Primary_Address;
			                    }
			                    selectedRateID = 0;
			                    if(input.Weight_Kg != null && input.Weight_Kg > 0 && input.Manual_Distance_Km != null && input.Manual_Distance_Km > 0 && input.Transport_Mode != null)
			                    {
			                        rateCandidates = Transport_Rates[Active == true && Transport_Mode == input.Transport_Mode && Effective_From <= zoho.currentdate] sort by Priority, Effective_From desc;
			                        for each rateRecord in rateCandidates
			                        {
			                            if(selectedRateID == 0 && rateRecord.Customer_Type == customerRecord.Customer_Type && (rateRecord.Effective_To == null || rateRecord.Effective_To >= zoho.currentdate) && rateRecord.Min_Weight_Kg <= input.Weight_Kg && (rateRecord.Max_Weight_Kg == null || rateRecord.Max_Weight_Kg >= input.Weight_Kg) && rateRecord.Min_Distance_Km <= input.Manual_Distance_Km && (rateRecord.Max_Distance_Km == null || rateRecord.Max_Distance_Km >= input.Manual_Distance_Km))
			                            {
			                                selectedRateID = rateRecord.ID;
			                            }
			                        }
			                        if(selectedRateID == 0)
			                        {
			                            for each rateRecord in rateCandidates
			                            {
			                                if(selectedRateID == 0 && rateRecord.Customer_Type == "All" && (rateRecord.Effective_To == null || rateRecord.Effective_To >= zoho.currentdate) && rateRecord.Min_Weight_Kg <= input.Weight_Kg && (rateRecord.Max_Weight_Kg == null || rateRecord.Max_Weight_Kg >= input.Weight_Kg) && rateRecord.Min_Distance_Km <= input.Manual_Distance_Km && (rateRecord.Max_Distance_Km == null || rateRecord.Max_Distance_Km >= input.Manual_Distance_Km))
			                                {
			                                    selectedRateID = rateRecord.ID;
			                                }
			                            }
			                        }
			                    }
			                    if(selectedRateID != 0)
			                    {
			                        selectedRate = Transport_Rates[ID == selectedRateID];
			                        input.Applied_Rate = selectedRate.ID;
			                        calculatedBase = ifnull(selectedRate.Base_Charge,0) + (ifnull(selectedRate.Charge_Per_Kg,0) * input.Weight_Kg) + (ifnull(selectedRate.Charge_Per_Km,0) * input.Manual_Distance_Km);
			                        if(calculatedBase < ifnull(selectedRate.Minimum_Charge,0))
			                        {
			                            calculatedBase = selectedRate.Minimum_Charge;
			                        }
			                        input.Base_Transport_Amount = calculatedBase.round(2);
			                        input.Fuel_Surcharge = (calculatedBase * ifnull(selectedRate.Fuel_Surcharge_Percent,0) / 100).round(2);
			                        input.Gross_Amount = (input.Base_Transport_Amount + input.Fuel_Surcharge).round(2);
			                    }
			                    else
			                    {
			                        input.Applied_Rate = null;
			                        input.Base_Transport_Amount = 0;
			                        input.Fuel_Surcharge = 0;
			                        input.Gross_Amount = 0;
			                    }
			                    input.Loyalty_Discount = 0;
			                    if(input.Use_Loyalty == true && input.Loyalty_Points_To_Use > 0 && customerRecord.Current_Loyalty_Program != null)
			                    {
			                        programRecord = Loyalty_Programs[ID == customerRecord.Current_Loyalty_Program];
			                        if(programRecord.count() > 0)
			                        {
			                            pointsValue = input.Loyalty_Points_To_Use * programRecord.Redemption_Value_Per_Point;
			                            maximumDiscount = input.Gross_Amount * programRecord.Max_Shipment_Discount_Percent / 100;
			                            input.Loyalty_Discount = pointsValue;
			                            if(input.Loyalty_Discount > maximumDiscount)
			                            {
			                                input.Loyalty_Discount = maximumDiscount;
			                            }
			                            if(input.Loyalty_Discount > input.Gross_Amount)
			                            {
			                                input.Loyalty_Discount = input.Gross_Amount;
			                            }
			                            input.Loyalty_Discount = input.Loyalty_Discount.round(2);
			                        }
			                    }
			                    input.Net_Amount = (input.Gross_Amount - input.Loyalty_Discount).round(2);
			                }
			            )
			        }
			    }
			}

			Loyalty_Points_To_Use_On_User_Input as "Calculate Loyalty Discount"
			{
			    type = form
			    form = Shipment_Requests
			    record event = on add or edit
			    description = "Calculates the rupee discount and enforces the configured maximum shipment discount."
			
			    on user input of Loyalty_Points_To_Use
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Loyalty_Discount = 0;
			                customerRecord = Customers[ID == input.Customer];
			                if(customerRecord.count() > 0)
			                {
			                    input.Available_Points = ifnull(customerRecord.Current_Points_Balance,0);
			                    if(input.Use_Loyalty == true && input.Loyalty_Points_To_Use > 0 && customerRecord.Current_Loyalty_Program != null)
			                    {
			                        programRecord = Loyalty_Programs[ID == customerRecord.Current_Loyalty_Program];
			                        if(programRecord.count() > 0)
			                        {
			                            input.Loyalty_Discount = (input.Loyalty_Points_To_Use * programRecord.Redemption_Value_Per_Point).round(2);
			                            maximumDiscount = input.Gross_Amount * programRecord.Max_Shipment_Discount_Percent / 100;
			                            if(input.Loyalty_Discount > maximumDiscount)
			                            {
			                                input.Loyalty_Discount = maximumDiscount.round(2);
			                            }
			                            if(input.Loyalty_Discount > input.Gross_Amount)
			                            {
			                                input.Loyalty_Discount = input.Gross_Amount;
			                            }
			                        }
			                    }
			                }
			                input.Net_Amount = (input.Gross_Amount - input.Loyalty_Discount).round(2);
			            )
			        }
			    }
			}

			Manual_Distance_Km_On_User_Input as "Recalculate Quote for Distance"
			{
			    type = form
			    form = Shipment_Requests
			    record event = on add or edit
			    description = "Selects the configured rate after internal staff confirms the route distance in kilometres."
			
			    on user input of Manual_Distance_Km
			    {
			        actions
			        {
			            custom deluge script
			            (
			                customerRecord = Customers[ID == input.Customer];
			                selectedRateID = 0;
			                if(customerRecord.count() > 0 && input.Weight_Kg != null && input.Weight_Kg > 0 && input.Manual_Distance_Km != null && input.Manual_Distance_Km > 0 && input.Transport_Mode != null)
			                {
			                    rateCandidates = Transport_Rates[Active == true && Transport_Mode == input.Transport_Mode && Effective_From <= zoho.currentdate] sort by Priority, Effective_From desc;
			                    for each rateRecord in rateCandidates
			                    {
			                        if(selectedRateID == 0 && rateRecord.Customer_Type == customerRecord.Customer_Type && (rateRecord.Effective_To == null || rateRecord.Effective_To >= zoho.currentdate) && rateRecord.Min_Weight_Kg <= input.Weight_Kg && (rateRecord.Max_Weight_Kg == null || rateRecord.Max_Weight_Kg >= input.Weight_Kg) && rateRecord.Min_Distance_Km <= input.Manual_Distance_Km && (rateRecord.Max_Distance_Km == null || rateRecord.Max_Distance_Km >= input.Manual_Distance_Km))
			                        {
			                            selectedRateID = rateRecord.ID;
			                        }
			                    }
			                    if(selectedRateID == 0)
			                    {
			                        for each rateRecord in rateCandidates
			                        {
			                            if(selectedRateID == 0 && rateRecord.Customer_Type == "All" && (rateRecord.Effective_To == null || rateRecord.Effective_To >= zoho.currentdate) && rateRecord.Min_Weight_Kg <= input.Weight_Kg && (rateRecord.Max_Weight_Kg == null || rateRecord.Max_Weight_Kg >= input.Weight_Kg) && rateRecord.Min_Distance_Km <= input.Manual_Distance_Km && (rateRecord.Max_Distance_Km == null || rateRecord.Max_Distance_Km >= input.Manual_Distance_Km))
			                            {
			                                selectedRateID = rateRecord.ID;
			                            }
			                        }
			                    }
			                }
			                if(selectedRateID != 0)
			                {
			                    selectedRate = Transport_Rates[ID == selectedRateID];
			                    input.Applied_Rate = selectedRate.ID;
			                    calculatedBase = ifnull(selectedRate.Base_Charge,0) + (ifnull(selectedRate.Charge_Per_Kg,0) * input.Weight_Kg) + (ifnull(selectedRate.Charge_Per_Km,0) * input.Manual_Distance_Km);
			                    if(calculatedBase < ifnull(selectedRate.Minimum_Charge,0))
			                    {
			                        calculatedBase = selectedRate.Minimum_Charge;
			                    }
			                    input.Base_Transport_Amount = calculatedBase.round(2);
			                    input.Fuel_Surcharge = (calculatedBase * ifnull(selectedRate.Fuel_Surcharge_Percent,0) / 100).round(2);
			                    input.Gross_Amount = (input.Base_Transport_Amount + input.Fuel_Surcharge).round(2);
			                }
			                else
			                {
			                    input.Applied_Rate = null;
			                    input.Base_Transport_Amount = 0;
			                    input.Fuel_Surcharge = 0;
			                    input.Gross_Amount = 0;
			                }
			                input.Loyalty_Discount = 0;
			                if(customerRecord.count() > 0 && input.Use_Loyalty == true && input.Loyalty_Points_To_Use > 0 && customerRecord.Current_Loyalty_Program != null)
			                {
			                    programRecord = Loyalty_Programs[ID == customerRecord.Current_Loyalty_Program];
			                    if(programRecord.count() > 0)
			                    {
			                        input.Loyalty_Discount = (input.Loyalty_Points_To_Use * programRecord.Redemption_Value_Per_Point).round(2);
			                        maximumDiscount = input.Gross_Amount * programRecord.Max_Shipment_Discount_Percent / 100;
			                        if(input.Loyalty_Discount > maximumDiscount)
			                        {
			                            input.Loyalty_Discount = maximumDiscount.round(2);
			                        }
			                        if(input.Loyalty_Discount > input.Gross_Amount)
			                        {
			                            input.Loyalty_Discount = input.Gross_Amount;
			                        }
			                    }
			                }
			                input.Net_Amount = (input.Gross_Amount - input.Loyalty_Discount).round(2);
			            )
			        }
			    }
			}

			Shipment_Requests_On_Load as "Configure Shipment Request Form"
			{
			    type = form
			    form = Shipment_Requests
			    record event = on add or edit
			    description = "Resolves the logged-in requester and separates customer entry from internal quotation and routing controls."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                isPortalCustomer = thisapp.portal.isUserInProfile("Customer_Portal");
			                if(isPortalCustomer == true)
			                {
			                    customerRecord = Customers[Portal_User == zoho.loginuserid];
			                    if(customerRecord.count() > 0)
			                    {
			                        input.Customer = customerRecord.ID;
			                        input.Customer_Portal_User = customerRecord.Portal_User;
			                        input.Requested_By_Type = "Customer";
			                        input.Available_Points = ifnull(customerRecord.Current_Points_Balance,0);
			                        if(input.ID == null)
			                        {
			                            input.Pickup_Contact_Name = customerRecord.Customer_Name.first_name;
			                            input.Pickup_Phone = customerRecord.Customer_Phone;
			                            input.Pickup_Address = customerRecord.Primary_Address;
			                        }
			                    }
			                    disable Customer;
			                    disable Customer_Portal_User;
			                    disable Requested_By_Type;
			                    hide Requested_By_Employee;
			                    hide Manual_Distance_Km;
			                    hide Origin_Hub;
			                    hide Destination_Hub;
			                    hide Current_Hub;
			                    hide Pickup_Agent;
			                    hide Applied_Rate;
			                    if(input.Shipment_Status == "Requested" || input.ID == null)
			                    {
			                        enable Pickup_Contact_Name;
			                        enable Pickup_Phone;
			                        enable Pickup_Address;
			                        enable Delivery_Contact_Name;
			                        enable Delivery_Phone;
			                        enable Delivery_Address;
			                        enable Package_Description;
			                        enable Weight_Kg;
			                        enable Dimensions_Cm;
			                        enable Transport_Mode;
			                        disable Use_Loyalty;
			                        disable Loyalty_Points_To_Use;
			                    }
			                    else
			                    {
			                        disable Pickup_Contact_Name;
			                        disable Pickup_Phone;
			                        disable Pickup_Address;
			                        disable Delivery_Contact_Name;
			                        disable Delivery_Phone;
			                        disable Delivery_Address;
			                        disable Package_Description;
			                        disable Weight_Kg;
			                        disable Dimensions_Cm;
			                        disable Transport_Mode;
			                        if(input.Shipment_Status == "Quoted")
			                        {
			                            enable Use_Loyalty;
			                            enable Loyalty_Points_To_Use;
			                        }
			                        else
			                        {
			                            disable Use_Loyalty;
			                            disable Loyalty_Points_To_Use;
			                        }
			                    }
			                }
			                else
			                {
			                    input.Requested_By_Type = "Employee";
			                    requester = Employees[Work_Email == zoho.loginuserid];
			                    if(input.ID == null && requester.count() > 0)
			                    {
			                        input.Requested_By_Employee = requester.ID;
			                    }
			                    show Requested_By_Employee;
			                    show Manual_Distance_Km;
			                    show Origin_Hub;
			                    show Destination_Hub;
			                    show Current_Hub;
			                    show Pickup_Agent;
			                    show Applied_Rate;
			                    disable Customer_Portal_User;
			                    disable Available_Points;
			                }
			                if(input.Use_Loyalty == true)
			                {
			                    show Loyalty_Points_To_Use;
			                }
			                else
			                {
			                    hide Loyalty_Points_To_Use;
			                }
			                disable Requested_On;
			                disable Available_Points;
			                disable Base_Transport_Amount;
			                disable Fuel_Surcharge;
			                disable Gross_Amount;
			                disable Loyalty_Discount;
			                disable Net_Amount;
			                disable Shipment_Status;
			                disable Quoted_On;
			                disable Confirmed_On;
			                disable Picked_Up_On;
			                disable Delivered_On;
			                disable Latest_Tracking_Text;
			            )
			        }
			    }
			}

			Shipment_Requests_On_Success as "Initialize Shipment Request"
			{
			    type = form
			    form = Shipment_Requests
			    record event = on add
			    description = "Initializes request ownership and writes the immutable audit trail entry."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                shipmentRecord = Shipment_Requests[ID == input.ID];
			                customerRecord = Customers[ID == input.Customer];
			                if(shipmentRecord.count() > 0 && customerRecord.count() > 0)
			                {
			                    shipmentRecord.Customer_Portal_User = customerRecord.Portal_User;
			                    shipmentRecord.Available_Points = ifnull(customerRecord.Current_Points_Balance,0);
			                    shipmentRecord.Shipment_Status = "Requested";
			                    shipmentRecord.Payment_Status = "Not Due";
			                    shipmentRecord.Latest_Tracking_Text = "Shipment request received and awaiting quotation.";
			                }
			                trackingID = insert into Shipment_Tracking_Events
			                [
			                    Shipment = input.ID
			                    Customer_Portal_User = customerRecord.Portal_User
			                    Event_Type = "Requested"
			                    Event_Time = zoho.currenttime
			                    Location_Text = "Shipment request received"
			                    Details = "Shipment request received and awaiting quotation."
			                    Customer_Visible = true
			                ];
			                auditID = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    User_Email = zoho.loginuserid
			                    User_Profile = input.Requested_By_Type
			                    Entity_Type = "Shipment_Requests"
			                    Entity_Record_ID = input.ID.toString()
			                    Action = "Shipment Requested"
			                    After_Value = "Requested"
			                    Details = "Shipment request created and queued for manual distance and hub confirmation."
			                    Severity = "Info"
			                ];
			            )
			        }
			    }
			}

			Shipment_Requests_On_Validate as "Validate Shipment Request"
			{
			    type = form
			    form = Shipment_Requests
			    record event = on add or edit
			    description = "Enforces ownership, routing, quotation, and loyalty constraints for shipment requests."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                isPortalCustomer = thisapp.portal.isUserInProfile("Customer_Portal");
			                customerRecord = Customers[ID == input.Customer];
			                if(customerRecord.count() == 0 || customerRecord.Active == false || customerRecord.Onboarding_Status != "Active")
			                {
			                    alert "Select an active, fully onboarded customer.";
			                    cancel submit;
			                }
			                if(input.Customer_Portal_User != customerRecord.Portal_User)
			                {
			                    alert "The shipment owner must match the customer's portal user.";
			                    cancel submit;
			                }
			                if(isPortalCustomer == true && input.Customer_Portal_User != zoho.loginuserid)
			                {
			                    alert "You can create or update only your own shipment requests.";
			                    cancel submit;
			                }
			                if(ifnull(input.Weight_Kg,0) <= 0)
			                {
			                    alert "Weight must be greater than zero kilograms.";
			                    cancel submit;
			                }
			                if(input.Manual_Distance_Km != null && input.Manual_Distance_Km <= 0)
			                {
			                    alert "Confirmed distance must be greater than zero kilometres.";
			                    cancel submit;
			                }
			                if(input.Origin_Hub != null && input.Destination_Hub != null && input.Origin_Hub == input.Destination_Hub)
			                {
			                    alert "Origin and destination hubs must be different.";
			                    cancel submit;
			                }
			                if(input.Pickup_Agent != null)
			                {
			                    agentRecord = Employees[ID == input.Pickup_Agent];
			                    if(agentRecord.count() == 0 || agentRecord.Active == false || agentRecord.Employee_Type != "Agent" || agentRecord.Internal_User == null)
			                    {
			                        alert "Select an active pickup agent with an internal user account.";
			                        cancel submit;
			                    }
			                    if(input.Origin_Hub != null && agentRecord.Hub != input.Origin_Hub)
			                    {
			                        alert "The pickup agent must belong to the origin hub.";
			                        cancel submit;
			                    }
			                }
			                if(input.Shipment_Status != "Requested" && input.Shipment_Status != "Cancelled")
			                {
			                    if(input.Manual_Distance_Km == null || input.Origin_Hub == null || input.Destination_Hub == null || input.Applied_Rate == null || input.Gross_Amount <= 0)
			                    {
			                        alert "A confirmed distance, origin hub, destination hub, applied rate, and positive quote are required after the request stage.";
			                        cancel submit;
			                    }
			                }
			                if(input.Use_Loyalty == true)
			                {
			                    if(ifnull(input.Loyalty_Points_To_Use,0) <= 0)
			                    {
			                        alert "Enter the number of loyalty points to use.";
			                        cancel submit;
			                    }
			                    if(input.Loyalty_Points_To_Use > ifnull(customerRecord.Current_Points_Balance,0))
			                    {
			                        alert "The requested loyalty points exceed the customer's available balance.";
			                        cancel submit;
			                    }
			                    if(customerRecord.Current_Loyalty_Program == null)
			                    {
			                        alert "The customer does not have an active loyalty programme.";
			                        cancel submit;
			                    }
			                    programRecord = Loyalty_Programs[ID == customerRecord.Current_Loyalty_Program];
			                    if(programRecord.count() == 0 || programRecord.Active == false)
			                    {
			                        alert "The customer's loyalty programme is not active.";
			                        cancel submit;
			                    }
			                    if(input.Loyalty_Points_To_Use < programRecord.Minimum_Redemption_Points)
			                    {
			                        alert "The loyalty points are below the programme's minimum redemption.";
			                        cancel submit;
			                    }
			                    maximumDiscount = input.Gross_Amount * programRecord.Max_Shipment_Discount_Percent / 100;
			                    if(input.Loyalty_Discount > maximumDiscount || input.Loyalty_Discount > input.Gross_Amount)
			                    {
			                        alert "The loyalty discount exceeds the configured shipment limit.";
			                        cancel submit;
			                    }
			                }
			                else
			                {
			                    input.Loyalty_Points_To_Use = 0;
			                    input.Loyalty_Discount = 0;
			                    input.Net_Amount = input.Gross_Amount;
			                }
			                if(input.Net_Amount < 0)
			                {
			                    alert "Net amount cannot be negative.";
			                    cancel submit;
			                }
			                persistedShipment = Shipment_Requests[ID == input.ID];
			                if(isPortalCustomer == true && input.ID != null)
			                {
			                    if(persistedShipment.Customer != input.Customer || persistedShipment.Customer_Portal_User != input.Customer_Portal_User || persistedShipment.Requested_By_Type != input.Requested_By_Type || persistedShipment.Requested_By_Employee != input.Requested_By_Employee || persistedShipment.Manual_Distance_Km != input.Manual_Distance_Km || persistedShipment.Origin_Hub != input.Origin_Hub || persistedShipment.Destination_Hub != input.Destination_Hub || persistedShipment.Current_Hub != input.Current_Hub || persistedShipment.Pickup_Agent != input.Pickup_Agent || persistedShipment.Applied_Rate != input.Applied_Rate || persistedShipment.Base_Transport_Amount != input.Base_Transport_Amount || persistedShipment.Fuel_Surcharge != input.Fuel_Surcharge || persistedShipment.Gross_Amount != input.Gross_Amount || persistedShipment.Payment_Status != input.Payment_Status || persistedShipment.Shipment_Status != input.Shipment_Status || persistedShipment.Quoted_On != input.Quoted_On || persistedShipment.Confirmed_On != input.Confirmed_On || persistedShipment.Picked_Up_On != input.Picked_Up_On || persistedShipment.Delivered_On != input.Delivered_On || persistedShipment.Latest_Tracking_Text != input.Latest_Tracking_Text)
			                    {
			                        alert "Routing, quote, payment, and lifecycle fields are managed by authorized workflows.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Transport_Mode_On_User_Input as "Recalculate Quote for Transport Mode"
			{
			    type = form
			    form = Shipment_Requests
			    record event = on add or edit
			    description = "Recalculates configured INR transport charges when transport mode changes."
			
			    on user input of Transport_Mode
			    {
			        actions
			        {
			            custom deluge script
			            (
			                customerRecord = Customers[ID == input.Customer];
			                selectedRateID = 0;
			                if(customerRecord.count() > 0 && input.Weight_Kg != null && input.Weight_Kg > 0 && input.Manual_Distance_Km != null && input.Manual_Distance_Km > 0 && input.Transport_Mode != null)
			                {
			                    rateCandidates = Transport_Rates[Active == true && Transport_Mode == input.Transport_Mode && Effective_From <= zoho.currentdate] sort by Priority, Effective_From desc;
			                    for each rateRecord in rateCandidates
			                    {
			                        if(selectedRateID == 0 && rateRecord.Customer_Type == customerRecord.Customer_Type && (rateRecord.Effective_To == null || rateRecord.Effective_To >= zoho.currentdate) && rateRecord.Min_Weight_Kg <= input.Weight_Kg && (rateRecord.Max_Weight_Kg == null || rateRecord.Max_Weight_Kg >= input.Weight_Kg) && rateRecord.Min_Distance_Km <= input.Manual_Distance_Km && (rateRecord.Max_Distance_Km == null || rateRecord.Max_Distance_Km >= input.Manual_Distance_Km))
			                        {
			                            selectedRateID = rateRecord.ID;
			                        }
			                    }
			                    if(selectedRateID == 0)
			                    {
			                        for each rateRecord in rateCandidates
			                        {
			                            if(selectedRateID == 0 && rateRecord.Customer_Type == "All" && (rateRecord.Effective_To == null || rateRecord.Effective_To >= zoho.currentdate) && rateRecord.Min_Weight_Kg <= input.Weight_Kg && (rateRecord.Max_Weight_Kg == null || rateRecord.Max_Weight_Kg >= input.Weight_Kg) && rateRecord.Min_Distance_Km <= input.Manual_Distance_Km && (rateRecord.Max_Distance_Km == null || rateRecord.Max_Distance_Km >= input.Manual_Distance_Km))
			                            {
			                                selectedRateID = rateRecord.ID;
			                            }
			                        }
			                    }
			                }
			                if(selectedRateID != 0)
			                {
			                    selectedRate = Transport_Rates[ID == selectedRateID];
			                    input.Applied_Rate = selectedRate.ID;
			                    calculatedBase = ifnull(selectedRate.Base_Charge,0) + (ifnull(selectedRate.Charge_Per_Kg,0) * input.Weight_Kg) + (ifnull(selectedRate.Charge_Per_Km,0) * input.Manual_Distance_Km);
			                    if(calculatedBase < ifnull(selectedRate.Minimum_Charge,0))
			                    {
			                        calculatedBase = selectedRate.Minimum_Charge;
			                    }
			                    input.Base_Transport_Amount = calculatedBase.round(2);
			                    input.Fuel_Surcharge = (calculatedBase * ifnull(selectedRate.Fuel_Surcharge_Percent,0) / 100).round(2);
			                    input.Gross_Amount = (input.Base_Transport_Amount + input.Fuel_Surcharge).round(2);
			                }
			                else
			                {
			                    input.Applied_Rate = null;
			                    input.Base_Transport_Amount = 0;
			                    input.Fuel_Surcharge = 0;
			                    input.Gross_Amount = 0;
			                }
			                input.Loyalty_Discount = 0;
			                if(customerRecord.count() > 0 && input.Use_Loyalty == true && input.Loyalty_Points_To_Use > 0 && customerRecord.Current_Loyalty_Program != null)
			                {
			                    programRecord = Loyalty_Programs[ID == customerRecord.Current_Loyalty_Program];
			                    if(programRecord.count() > 0)
			                    {
			                        input.Loyalty_Discount = (input.Loyalty_Points_To_Use * programRecord.Redemption_Value_Per_Point).round(2);
			                        maximumDiscount = input.Gross_Amount * programRecord.Max_Shipment_Discount_Percent / 100;
			                        if(input.Loyalty_Discount > maximumDiscount)
			                        {
			                            input.Loyalty_Discount = maximumDiscount.round(2);
			                        }
			                        if(input.Loyalty_Discount > input.Gross_Amount)
			                        {
			                            input.Loyalty_Discount = input.Gross_Amount;
			                        }
			                    }
			                }
			                input.Net_Amount = (input.Gross_Amount - input.Loyalty_Discount).round(2);
			            )
			        }
			    }
			}

			Use_Loyalty_On_User_Input as "Configure Loyalty Discount"
			{
			    type = form
			    form = Shipment_Requests
			    record event = on add or edit
			    description = "Shows loyalty input and recalculates the INR discount from the customer's active programme."
			
			    on user input of Use_Loyalty
			    {
			        actions
			        {
			            custom deluge script
			            (
			                customerRecord = Customers[ID == input.Customer];
			                if(customerRecord.count() > 0)
			                {
			                    input.Available_Points = ifnull(customerRecord.Current_Points_Balance,0);
			                }
			                if(input.Use_Loyalty == true)
			                {
			                    show Loyalty_Points_To_Use;
			                }
			                else
			                {
			                    input.Loyalty_Points_To_Use = 0;
			                    input.Loyalty_Discount = 0;
			                    hide Loyalty_Points_To_Use;
			                }
			                if(input.Use_Loyalty == true && input.Loyalty_Points_To_Use > 0 && customerRecord.count() > 0 && customerRecord.Current_Loyalty_Program != null)
			                {
			                    programRecord = Loyalty_Programs[ID == customerRecord.Current_Loyalty_Program];
			                    if(programRecord.count() > 0)
			                    {
			                        input.Loyalty_Discount = (input.Loyalty_Points_To_Use * programRecord.Redemption_Value_Per_Point).round(2);
			                        maximumDiscount = input.Gross_Amount * programRecord.Max_Shipment_Discount_Percent / 100;
			                        if(input.Loyalty_Discount > maximumDiscount)
			                        {
			                            input.Loyalty_Discount = maximumDiscount.round(2);
			                        }
			                        if(input.Loyalty_Discount > input.Gross_Amount)
			                        {
			                            input.Loyalty_Discount = input.Gross_Amount;
			                        }
			                    }
			                }
			                input.Net_Amount = (input.Gross_Amount - input.Loyalty_Discount).round(2);
			            )
			        }
			    }
			}

