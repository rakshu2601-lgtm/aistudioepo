			KYC_Document_Rules_On_Validate as "Validate KYC Document Rule"
			{
			    type = form
			    form = KYC_Document_Rules
			    record event = on add or edit
			    description = "Prevents duplicate active document mappings for the same customer type."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Active == true)
			                {
			                    duplicateRules = KYC_Document_Rules[Customer_Type == input.Customer_Type && Document_Name == input.Document_Name && Active == true];
			                    for each duplicateRule in duplicateRules
			                    {
			                        if(duplicateRule.ID != input.ID)
			                        {
			                            alert "An active KYC rule already exists for this customer type and document name.";
			                            cancel submit;
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Loyalty_Programs_On_Validate as "Validate Loyalty Programme"
			{
			    type = form
			    form = Loyalty_Programs
			    record event = on add or edit
			    description = "Validates tier thresholds, earning and redemption values, effective dates, and overlapping active tiers."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(ifnull(input.Min_Lifetime_Points,0) < 0 || ifnull(input.Max_Lifetime_Points,0) < 0 || ifnull(input.Points_Per_Rupee,0) < 0 || ifnull(input.Redemption_Value_Per_Point,0) < 0 || ifnull(input.Minimum_Redemption_Points,0) < 0 || ifnull(input.Expiry_Months,0) < 0)
			                {
			                    alert "Points, redemption values, and expiry months cannot be negative.";
			                    cancel submit;
			                }
			                if(input.Max_Lifetime_Points != null && input.Max_Lifetime_Points < input.Min_Lifetime_Points)
			                {
			                    alert "Maximum lifetime points must be greater than or equal to minimum lifetime points.";
			                    cancel submit;
			                }
			                if(ifnull(input.Max_Shipment_Discount_Percent,0) < 0 || ifnull(input.Max_Shipment_Discount_Percent,0) > 100)
			                {
			                    alert "Maximum shipment discount must be between 0 and 100 percent.";
			                    cancel submit;
			                }
			                if(ifnull(input.Priority,0) < 1)
			                {
			                    alert "Selection priority must be 1 or greater.";
			                    cancel submit;
			                }
			                if(input.Effective_To != null && input.Effective_To < input.Effective_From)
			                {
			                    alert "Effective To must be on or after Effective From.";
			                    cancel submit;
			                }
			                if(input.Active == true)
			                {
			                    candidateProgrammes = Loyalty_Programs[Customer_Type == input.Customer_Type && Active == true];
			                    for each candidateProgramme in candidateProgrammes
			                    {
			                        if(candidateProgramme.ID != input.ID)
			                        {
			                            dateOverlaps = true;
			                            if(candidateProgramme.Effective_To != null && input.Effective_From > candidateProgramme.Effective_To)
			                            {
			                                dateOverlaps = false;
			                            }
			                            if(input.Effective_To != null && candidateProgramme.Effective_From > input.Effective_To)
			                            {
			                                dateOverlaps = false;
			                            }
			                            pointsOverlap = true;
			                            if(candidateProgramme.Max_Lifetime_Points != null && input.Min_Lifetime_Points > candidateProgramme.Max_Lifetime_Points)
			                            {
			                                pointsOverlap = false;
			                            }
			                            if(input.Max_Lifetime_Points != null && candidateProgramme.Min_Lifetime_Points > input.Max_Lifetime_Points)
			                            {
			                                pointsOverlap = false;
			                            }
			                            if(dateOverlaps == true && pointsOverlap == true)
			                            {
			                                alert "An active loyalty tier for this customer type already overlaps the same lifetime-points band and effective period.";
			                                cancel submit;
			                            }
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Redemption_Customer_On_User_Input as "Populate Redemption Customer Details"
			{
			    type = form
			    form = Loyalty_Redemptions
			    record event = on add or edit
			
			    on user input of Customer
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Customer != null)
			                {
			                    customerRecord = Customers[ID == input.Customer];
			                    if(customerRecord.count() > 0)
			                    {
			                        input.Customer_Portal_User = customerRecord.Portal_User;
			                        input.Program = customerRecord.Current_Loyalty_Program;
			                    }
			                }
			                else
			                {
			                    input.Customer_Portal_User = null;
			                    input.Program = null;
			                    input.Shipment = null;
			                    input.Amount_Value = 0;
			                }
			            )
			        }
			    }
			}

			Loyalty_Redemptions_On_Delete as "Protect Redemption History"
			{
			    type = form
			    form = Loyalty_Redemptions
			    record event = on delete
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                alert "Redemption history cannot be deleted. Cancel an eligible request through its lifecycle instead.";
			                cancel delete;
			            )
			        }
			    }
			}

			Loyalty_Redemptions_On_Load as "Prepare Loyalty Redemption Form"
			{
			    type = form
			    form = Loyalty_Redemptions
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                isAdministrator = thisapp.permissions.isUserInProfile("Logistics_Admin");
			                isPortalCustomer = thisapp.portal.isUserInProfile("Customer_Portal");
			                disable Customer_Portal_User;
			                disable Program;
			                disable Amount_Value;
			                disable Redemption_Status;
			                disable Requested_On;
			                disable Reviewed_By;
			                disable Reviewed_On;
			                disable Generated_Transaction;
			                hide Payment_Reference;
			                if(input.Redemption_Type == "Shipment Discount")
			                {
			                    show Shipment;
			                }
			                else
			                {
			                    hide Shipment;
			                }
			                if(isAdministrator == true && input.Redemption_Type == "Cash Value" && input.Redemption_Status == "Approved")
			                {
			                    show Payment_Reference;
			                    enable Payment_Reference;
			                }
			                if(isAdministrator == false)
			                {
			                    disable Review_Notes;
			                }
			                if(isPortalCustomer == true)
			                {
			                    portalCustomer = Customers[Customer_Email == zoho.loginuserid && Active == true];
			                    if(portalCustomer.count() > 0 && input.ID == null)
			                    {
			                        input.Customer = portalCustomer.ID;
			                        input.Customer_Portal_User = portalCustomer.Portal_User;
			                        input.Program = portalCustomer.Current_Loyalty_Program;
			                    }
			                    disable Customer;
			                }
			                if(input.ID != null)
			                {
			                    disable Customer;
			                    disable Redemption_Type;
			                    disable Shipment;
			                    disable Points_Requested;
			                }
			            )
			        }
			    }
			}

			Loyalty_Redemptions_On_Success as "Audit Loyalty Redemption Request"
			{
			    type = form
			    form = Loyalty_Redemptions
			    record event = on add
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                auditID = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    User_Email = zoho.loginuserid
			                    User_Profile = "Loyalty Redemption Request"
			                    Entity_Type = "Loyalty_Redemptions"
			                    Entity_Record_ID = input.ID.toString()
			                    Action = "Redemption Requested"
			                    After_Value = input.Points_Requested.toString()
			                    Details = input.Redemption_Type + " request for INR " + input.Amount_Value.toString() + "."
			                    Severity = "Info"
			                ];
			            )
			        }
			    }
			}

			Loyalty_Redemptions_On_Validate as "Validate Loyalty Redemption"
			{
			    type = form
			    form = Loyalty_Redemptions
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                customerRecord = Customers[ID == input.Customer];
			                if(customerRecord.count() == 0 || customerRecord.Active == false || customerRecord.Onboarding_Status != "Active")
			                {
			                    alert "Select an active, fully onboarded customer.";
			                    cancel submit;
			                }
			                isPortalCustomer = thisapp.portal.isUserInProfile("Customer_Portal");
			                if(isPortalCustomer == true && customerRecord.Customer_Email != zoho.loginuserid)
			                {
			                    alert "You can request redemptions only for your own loyalty account.";
			                    cancel submit;
			                }
			                input.Customer_Portal_User = customerRecord.Portal_User;
			                input.Program = customerRecord.Current_Loyalty_Program;
			                if(input.Program == null)
			                {
			                    alert "No active loyalty programme is assigned to this customer.";
			                    cancel submit;
			                }
			                programRecord = Loyalty_Programs[ID == input.Program];
			                if(programRecord.count() == 0 || programRecord.Active == false || programRecord.Effective_From > zoho.currentdate || (programRecord.Effective_To != null && programRecord.Effective_To < zoho.currentdate))
			                {
			                    alert "The customer's loyalty programme is not currently active.";
			                    cancel submit;
			                }
			                if(ifnull(input.Points_Requested,0) <= 0)
			                {
			                    alert "Points requested must be greater than zero.";
			                    cancel submit;
			                }
			                if(input.Points_Requested < programRecord.Minimum_Redemption_Points)
			                {
			                    alert "The request is below the minimum redemption points for this programme.";
			                    cancel submit;
			                }
			                currentBalance = ifnull(Loyalty_Transactions[Customer == input.Customer].sum(Points),0);
			                if(input.ID == null && input.Points_Requested > currentBalance)
			                {
			                    alert "The requested points exceed the available loyalty balance.";
			                    cancel submit;
			                }
			                input.Amount_Value = (input.Points_Requested * programRecord.Redemption_Value_Per_Point).round(2);
			                if(input.Redemption_Type == "Shipment Discount")
			                {
			                    if(input.Shipment == null)
			                    {
			                        alert "Select the shipment that will receive the loyalty discount.";
			                        cancel submit;
			                    }
			                    shipmentRecord = Shipment_Requests[ID == input.Shipment];
			                    if(shipmentRecord.count() == 0 || shipmentRecord.Customer != input.Customer || shipmentRecord.Shipment_Status not in {"Quoted","Confirmed"})
			                    {
			                        alert "The shipment must belong to this customer and be Quoted or Confirmed.";
			                        cancel submit;
			                    }
			                    maximumDiscount = shipmentRecord.Gross_Amount * programRecord.Max_Shipment_Discount_Percent / 100;
			                    if(input.Amount_Value > maximumDiscount)
			                    {
			                        alert "The redemption exceeds the programme's maximum shipment discount.";
			                        cancel submit;
			                    }
			                }
			                else
			                {
			                    input.Shipment = null;
			                }
			                if(input.ID == null)
			                {
			                    input.Redemption_Status = "Requested";
			                    input.Requested_On = zoho.currenttime;
			                }
			                else
			                {
			                    persistedRecord = Loyalty_Redemptions[ID == input.ID];
			                    if(persistedRecord.count() > 0 && (persistedRecord.Customer != input.Customer || persistedRecord.Customer_Portal_User != input.Customer_Portal_User || persistedRecord.Redemption_Type != input.Redemption_Type || persistedRecord.Shipment != input.Shipment || persistedRecord.Program != input.Program || persistedRecord.Points_Requested != input.Points_Requested || persistedRecord.Amount_Value != input.Amount_Value || persistedRecord.Requested_On != input.Requested_On || persistedRecord.Generated_Transaction != input.Generated_Transaction))
			                    {
			                        alert "Core redemption details cannot be changed after submission. Cancel and create a new request instead.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Points_Requested_On_User_Input as "Calculate Redemption Value"
			{
			    type = form
			    form = Loyalty_Redemptions
			    record event = on add or edit
			
			    on user input of Points_Requested
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Amount_Value = 0;
			                if(input.Program != null && ifnull(input.Points_Requested,0) > 0)
			                {
			                    programRecord = Loyalty_Programs[ID == input.Program];
			                    if(programRecord.count() > 0)
			                    {
			                        input.Amount_Value = (input.Points_Requested * programRecord.Redemption_Value_Per_Point).round(2);
			                    }
			                }
			            )
			        }
			    }
			}

			Redemption_Type_On_User_Input as "Change Redemption Type Fields"
			{
			    type = form
			    form = Loyalty_Redemptions
			    record event = on add or edit
			
			    on user input of Redemption_Type
			    {
			        actions
			        {
			            custom deluge script
			            (
			                isAdministrator = thisapp.permissions.isUserInProfile("Logistics_Admin");
			                if(input.Redemption_Type == "Shipment Discount")
			                {
			                    show Shipment;
			                    hide Payment_Reference;
			                    input.Payment_Reference = "";
			                }
			                else
			                {
			                    hide Shipment;
			                    input.Shipment = null;
			                    if(isAdministrator == true && input.Redemption_Status == "Approved")
			                    {
			                        show Payment_Reference;
			                    }
			                }
			            )
			        }
			    }
			}

