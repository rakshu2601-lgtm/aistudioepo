		        Reviewer_User
		        Feedback_Category
		        Feedback_Comments
		        Resource_Response
		        Feedback_Status
		        Added_Time
		    )
		    filters
		    (
		        Feedback_Category
		        Feedback_Status
		        Reviewer_User
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Document ascending
		    )
		    sort by
