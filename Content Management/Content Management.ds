		    )
		    sort by
		    (
		        Display_Name ascending
		    )
		}
	}

	pages
	{
		page Administration_Center(string section)
		{
					displayname = "Administration Center"
					Content="<zml mobileDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"onebyone\",\"forcedOrientation\":false}}' tabletDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"onebyone\",\"forcedOrientation\":false}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Administration_Center_Snippet' elementName='Administration Center'>\n\t\t\t\t\t<![CDATA[htmlpage Administration_Center_Snippet()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t <file name:Administration_Center/Administration_Workspace.dshtml/>\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
