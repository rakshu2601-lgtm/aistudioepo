application "Content-Management"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Application_Settings
		{
		    displayname = "Application Settings"
		    success message = "Application settings saved successfully."
		
		        Configuration
		        (
		            type = section
		            displayname = "Configuration"
		            row = 1
		            column = 0
		        )
		        must have unique Configuration_Key
		        (
		            type = text
		            displayname = "Configuration Key"
		            initial value = "GLOBAL"
		            row = 1
		            column = 1
		            width = medium
		        )
		        must have Default_SLA_Business_Days
		        (
		            type = number
		            displayname = "Default SLA (Business Days)"
		            row = 1
		            column = 1
		            width = medium
		        )
		        must have Due_Soon_Lead_Business_Days
		        (
		            type = number
		            displayname = "Due Soon Lead (Business Days)"
		            initial value = 1
		            row = 1
		            column = 2
		            width = medium
		        )
		        must have Reminder_Time_UTC
		        (
		            type = time
		            displayname = "Reminder Time (UTC)"
		            initial value = "09:00:00"
		            row = 1
		            column = 2
		        )
		        Automation
		        (
		            type = section
		            displayname = "Automation"
		            visibility = true
		            row = 2
		            column = 1
		        )
		        must have Time_Zone
		        (
		            type = picklist
		            displayname = "Time Zone"
		            values = {"UTC"}
		            initial value = "UTC"
		            row = 2
		            column = 1
		        )
		        must have Auto_Assignment_Strategy
		        (
		            type = picklist
		            displayname = "Auto Assignment Strategy"
		            values = {"Least Open Workload"}
		            initial value = "Least Open Workload"
		            row = 2
		            column = 1
		        )
		        Reminders_Enabled
		        (
		            type = checkbox
		            displayname = "Reminders Enabled"
		            initial value = true
		            row = 2
		            column = 2
		        )
		        Last_Reference_Data_Seeded_On
		        (
		            type = datetime
		            displayname = "Last Reference Data Seeded On"
		            row = 2
		            column = 2
		        )
		
		    actions
		    {
		        on add
		        {
		            Save
		            (
		                type = submit
		                displayname = "Save Settings"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Settings"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Audit_Log
		{
		    displayname = "Audit Log"
		    success message = "Audit record saved."
		
		        Audit_Details
		        (
		            type = section
		            displayname = "Audit Details"
		            row = 1
		            column = 0
		        )
		        Audit_ID
		        (
		            type = autonumber
		            displayname = "Audit ID"
		            start index = 1
		            row = 1
		            column = 1
		        )
		        Document
		        (
		            type = picklist
		            displayname = "Document"
		            values = Content_Documents.ID
		            displayformat = [Document_Title]
		            searchable = true
		            row = 1
		            column = 1
		            width = medium
		        )
		        must have Action_Name
		        (
		            type = text
		            displayname = "Action"
		            row = 1
		            column = 2
		            width = medium
		        )
		        From_State
		        (
		            type = text
		            displayname = "From State"
		            row = 1
		            column = 1
		            width = medium
		        )
		        To_State
		        (
		            type = text
		            displayname = "To State"
		            row = 1
		            column = 2
		            width = medium
		        )
		        Performed_By
		        (
		            type = email
		            displayname = "Performed By"
		            row = 1
		            column = 1
		            width = medium
		        )
		        Performed_On
		        (
		            type = datetime
		            displayname = "Performed On"
		            row = 1
		            column = 2
		            width = medium
		        )
		        Assigned_Reviewer
		        (
		            type = email
		            displayname = "Assigned Reviewer"
		            row = 1
		            column = 1
		            width = medium
		        )
		        SLA_Due_On
		        (
		            type = datetime
		            displayname = "SLA Due On"
		            row = 1
		            column = 2
		            width = medium
		        )
		        Details
		        (
		            type = textarea
		            displayname = "Details"
		            height = 120px
		            row = 1
		            column = 1
		            width = medium
		        )
		
		    actions
		    {
		        on add
		        {
		            Save
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Content_Documents
		{
		    displayname = "Content Documents"
		    success message = "Content document saved successfully."
		    record owner = Resource_User
		
		        Content_Details
		        (
		            type = section
		            displayname = "Content Details"
		            row = 1
		            column = 0
		        )
		        Document_ID
		        (
		            type = autonumber
		            displayname = "Document ID"
		            start index = 1
		            row = 1
		            column = 1
		        )
		        must have Document_Title
		        (
		            type = text
		            displayname = "Document Title"
		            row = 1
		            column = 1
		            width = medium
		        )
		        must have Session
		        (
		            type = picklist
		            displayname = "Session"
		            values = Sessions[Status != "Cancelled"].ID
		            displayformat = [Session_Name]
		            searchable = true
		            row = 1
		            column = 2
		            width = medium
		        )
		        must have Product
		        (
		            type = picklist
		            displayname = "Product"
		            values = Products[Active == true].ID
		            displayformat = [Product_Name]
		            searchable = true
		            row = 1
		            column = 1
		            width = medium
		        )
		        must have Document_Type
		        (
		            type = picklist
		            displayname = "Document Type"
		            values = Document_Types[Active == true].ID
		            displayformat = [Document_Type_Name]
		            searchable = true
		            row = 1
		            column = 2
		            width = medium
		        )
		        Version_Label
		        (
		            type = text
		            displayname = "Version Label"
		            initial value = "1.0"
		            row = 1
		            column = 1
		            width = medium
		        )
		        Asset
		        (
		            type = section
		            displayname = "Asset"
		            visibility = true
		            row = 2
		            column = 1
		        )
		        Source_Files
		        (
		            type = upload file
		            displayname = "Source Files"
		            file count = 10
		            browse = local_drive, google_docs, zoho_docs
		            row = 2
		            column = 1
		            width = medium
		        )
		        Content_URL
		        (
		            type = url
		            displayname = "Content URL"
		            enable = linkname, title
		            target = new window
		            row = 2
		            column = 2
		            width = medium
		        )
		        Assignment
		        (
		            type = section
		            displayname = "Assignment"
		            visibility = true
		            row = 3
		            column = 1
		        )
		        must have Resource_User
		        (
		            type = picklist
		            displayname = "Resource"
		            module = users
		            displayformat = [name]
		            row = 3
		            column = 1
		            width = medium
		        )
		        Assignment_Mode
		        (
		            type = radiobuttons
		            displayname = "Assignment Mode"
		            values = {"Auto","Manual"}
		            initial value = "Auto"
		            row = 3
		            column = 2
		            width = medium
		        )
		        Assigned_Reviewer
		        (
		            type = picklist
		            displayname = "Assigned Reviewer"
		            module = users
		            displayformat = [name]
		            row = 3
		            column = 1
		            width = medium
		        )
		        Stage
		        (
		            type = picklist
		            displayname = "Stage"
		            values = {"Draft","Review Under Progress","Feedback Fixes In Progress","Feedback Changes Completed","Review Completed","Ready for Downstream"}
		            initial value = "Draft"
		            row = 3
		            column = 2
		            width = medium
		        )
		        SLA_Tracking
		        (
		            type = section
		            displayname = "SLA Tracking"
		            visibility = true
		            row = 4
		            column = 1
		        )
		        Selected_SLA_Policy
		        (
		            type = picklist
		            displayname = "Selected SLA Policy"
		            values = SLA_Policies[Active == true].ID
		            displayformat = [Policy_Name]
		            row = 4
		            column = 1
		            width = medium
		        )
		        Applied_SLA_Business_Days
		        (
		            type = number
		            displayname = "Applied SLA Business Days"
		            row = 4
		            column = 2
		            width = medium
		        )
		        Review_Cycle_Number
		        (
		            type = number
		            displayname = "Review Cycle Number"
		            initial value = 1
		            row = 4
		            column = 1
		            width = medium
		        )
		        Review_Cycle_Type
		        (
		            type = picklist
		            displayname = "Review Cycle Type"
		            values = {"Initial Review","Fix Verification"}
		            initial value = "Initial Review"
		            row = 4
		            column = 2
		            width = medium
		        )
		        Submitted_On
		        (
		            type = datetime
		            displayname = "Submitted On"
		            row = 4
		            column = 1
		            width = medium
		        )
		        Due_On
		        (
		            type = datetime
		            displayname = "Due On"
		            row = 4
		            column = 2
		            width = medium
		        )
		        Due_Soon_Reminder_On
		        (
		            type = datetime
		            displayname = "Due Soon Reminder On"
		            row = 4
		            column = 1
		            width = medium
		        )
		        SLA_Status
		        (
		            type = picklist
		            displayname = "SLA Status"
		            values = {"Not Started","On Track","Due Soon","Overdue","Met","Breached"}
		            initial value = "Not Started"
		            row = 4
		            column = 2
		            width = medium
		        )
		        Review_Feedback
		        (
		            type = section
		            displayname = "Review Feedback"
		            visibility = true
		            row = 5
		            column = 1
		        )
		        Review_Summary
		        (
		            type = textarea
		            displayname = "Review Summary"
		            height = 100px
		            row = 5
		            column = 1
		            width = medium
		        )
		        Review_Attachment
		        (
		            type = upload file
		            displayname = "Review Attachment"
		            file count = 3
		            browse = local_drive, google_docs, zoho_docs
		            row = 5
		            column = 2
		            width = medium
		        )
		        Resource_Response
		        (
		            type = textarea
		            displayname = "Resource Response"
		            height = 100px
		            row = 5
		            column = 1
		            width = medium
		        )
		        Final_Reviewer_Comments
		        (
		            type = textarea
		            displayname = "Final Reviewer Comments"
		            height = 100px
		            row = 5
		            column = 2
		            width = medium
		        )
		        Downstream_Handoff
		        (
		            type = section
		            displayname = "Downstream Handoff"
		            visibility = true
		            row = 6
		            column = 1
		        )
		        Downstream_Route
		        (
		            type = picklist
		            displayname = "Downstream Route"
		            values = Downstream_Routes[Active == true].ID
		            displayformat = [Route_Name]
		            searchable = true
		            row = 6
		            column = 1
		            width = medium
		        )
		        Handoff_Notes
		        (
		            type = textarea
		            displayname = "Handoff Notes"
		            height = 100px
		            row = 6
		            column = 2
		            width = medium
		        )
		        Final_Approved_On
		        (
		            type = datetime
		            displayname = "Final Approved On"
		            row = 6
		            column = 1
		            width = medium
		        )
		        Routed_On
		        (
		            type = datetime
		            displayname = "Routed On"
		            row = 6
		            column = 2
		            width = medium
		        )
		        Last_Status_Changed_On
		        (
		            type = datetime
		            displayname = "Last Status Changed On"
		            row = 6
		            column = 1
		            width = medium
		        )
		
		    actions
		    {
		        on add
		        {
		            Save
		            (
		                type = submit
		                displayname = "Save Draft"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Document"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
		    blueprint components
		    {
		        stages = {"Draft","Review Under Progress","Feedback Fixes In Progress","Feedback Changes Completed","Review Completed","Ready for Downstream"}
		    }
		}

		form Document_Types
		{
		    displayname = "Document Types"
		    success message = "Document type saved successfully."
		
		        Document_Type_Details
		        (
		            type = section
		            displayname = "Document Type Details"
		            row = 1
		            column = 0
		        )
		        must have unique Document_Type_Name
		        (
		            type = text
		            displayname = "Document Type Name"
		            row = 1
		            column = 1
		            width = medium
		        )
		        Description
		        (
		            type = textarea
		            displayname = "Description"
		            height = 100px
		            row = 1
		            column = 2
		            width = medium
		        )
		        File_Expected
		        (
		            type = checkbox
		            displayname = "File Expected"
		            initial value = true
		            row = 1
		            column = 1
		            width = medium
		        )
		        URL_Allowed
		        (
		            type = checkbox
		            displayname = "URL Allowed"
		            initial value = true
		            row = 1
		            column = 2
		            width = medium
		        )
		        Active
		        (
		            type = checkbox
		            displayname = "Active"
		            initial value = true
		            row = 1
		            column = 1
		            width = medium
		        )
		
		    actions
		    {
		        on add
		        {
		            Save
		            (
		                type = submit
		                displayname = "Save Document Type"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Document Type"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Downstream_Routes
		{
		    displayname = "Downstream Routes"
		    success message = "Downstream route saved successfully."
		
		        Route_Details
		        (
		            type = section
		            displayname = "Route Details"
		            row = 1
		            column = 0
		        )
		        must have unique Route_Name
		        (
		            type = text
		            displayname = "Route Name"
		            row = 1
		            column = 1
		            width = medium
		        )
		        must have Route_Type
		        (
		            type = picklist
		            displayname = "Route Type"
		            values = {"Communications Review","Other Process"}
		            row = 1
		            column = 2
		            width = medium
		        )
		        Instructions
		        (
		            type = textarea
		            displayname = "Instructions"
		            height = 100px
		            row = 1
		            column = 1
		            width = medium
		        )
		        Handoff_Contact
		        (
		            type = section
		            displayname = "Handoff Contact"
		            visibility = true
		            row = 2
		            column = 1
		        )
		        Destination_Team
		        (
		            type = text
		            displayname = "Destination Team"
		            row = 2
		            column = 1
		            width = medium
		        )
		        Destination_Email
		        (
		            type = email
		            displayname = "Destination Email"
		            row = 2
		            column = 2
		            width = medium
		        )
		        Active
		        (
		            type = checkbox
		            displayname = "Active"
		            initial value = true
		            row = 2
		            column = 1
		            width = medium
		        )
		
		    actions
		    {
		        on add
		        {
		            Save
		            (
		                type = submit
		                displayname = "Save Route"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Route"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Holidays
		{
		    displayname = "Holidays"
		    success message = "Holiday saved successfully."
		
		        Holiday_Details
		        (
		            type = section
		            displayname = "Holiday Details"
		            row = 1
		            column = 0
		        )
		        must have unique Holiday_Date
		        (
		            type = date
		            displayname = "Holiday Date"
		            row = 1
		            column = 1
		            width = medium
		        )
		        must have Holiday_Name
		        (
		            type = text
		            displayname = "Holiday Name"
		            row = 1
		            column = 2
		            width = medium
		        )
		        Active
		        (
		            type = checkbox
		            displayname = "Active"
		            initial value = true
		            row = 1
		            column = 1
		            width = medium
		        )
		        Notes
		        (
		            type = textarea
		            displayname = "Notes"
		            height = 100px
		            row = 1
		            column = 2
		            width = medium
		        )
		
		    actions
		    {
		        on add
		        {
		            Save
		            (
		                type = submit
		                displayname = "Save Holiday"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Holiday"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Products
		{
		    displayname = "Products"
		    success message = "Product saved successfully."
		
		        Product_Details
		        (
		            type = section
		            displayname = "Product Details"
		            row = 1
		            column = 0
		        )
		        must have unique Product_Name
		        (
		            type = text
		            displayname = "Product Name"
		            row = 1
		            column = 1
		            width = medium
		        )
		        unique Product_Code
		        (
		            type = text
		            displayname = "Product Code"
		            row = 1
		            column = 2
		            width = medium
		        )
		        Description
		        (
		            type = textarea
		            displayname = "Description"
		            height = 100px
		            row = 1
		            column = 1
		            width = medium
		        )
		        Ownership
		        (
		            type = section
		            displayname = "Ownership"
		            visibility = true
		            row = 2
		            column = 1
		        )
		        Product_Owner
		        (
		            type = picklist
		            displayname = "Product Owner"
		            module = users
		            displayformat = [name]
		            row = 2
		            column = 1
		            width = medium
		        )
		        Active
		        (
		            type = checkbox
		            displayname = "Active"
		            initial value = true
		            row = 2
		            column = 2
		            width = medium
		        )
		
		    actions
		    {
		        on add
		        {
		            Save
		            (
		                type = submit
		                displayname = "Save Product"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Product"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Review_Feedback
		{
		    displayname = "Review Feedback"
		    success message = "Feedback saved successfully."
		
		        Feedback_Details
		        (
		            type = section
		            displayname = "Feedback Details"
		            row = 1
		            column = 0
		        )
		        Feedback_ID
		        (
		            type = autonumber
		            displayname = "Feedback ID"
		            start index = 1
		            row = 1
		            column = 1
		        )
		        must have Document
		        (
		            type = picklist
		            displayname = "Document"
		            values = Content_Documents.ID
		            displayformat = [Document_Title]
		            searchable = true
		            row = 1
		            column = 1
		            width = medium
		        )
		        must have Review_Cycle_Number
		        (
		            type = number
		            displayname = "Review Cycle Number"
		            row = 1
		            column = 2
		            width = medium
		        )
		        must have Reviewer_User
		        (
		            type = picklist
		            displayname = "Reviewer"
		            module = users
		            displayformat = [name]
		            row = 1
		            column = 1
		            width = medium
		        )
		        Feedback_Category
		        (
		            type = picklist
		            displayname = "Feedback Category"
		            values = {"Content","Brand","Accuracy","Design","Compliance","Other"}
		            row = 1
		            column = 2
		            width = medium
		        )
		        must have Feedback_Comments
		        (
		            type = textarea
		            displayname = "Feedback Comments"
		            height = 120px
		            row = 1
		            column = 1
		            width = medium
		        )
		        Reference_File
		        (
		            type = upload file
		            displayname = "Reference File"
		            file count = 3
		            browse = local_drive, google_docs, zoho_docs
		            row = 1
		            column = 2
		            width = medium
		        )
		        Resolution
		        (
		            type = section
		            displayname = "Resolution"
		            visibility = true
		            row = 2
		            column = 1
		        )
		        Feedback_Status
		        (
		            type = picklist
		            displayname = "Feedback Status"
		            values = {"Open","Addressed","Closed"}
		            initial value = "Open"
		            row = 2
		            column = 1
		            width = medium
		        )
		        Resource_Response
		        (
		            type = textarea
		            displayname = "Resource Response"
		            height = 120px
		            row = 2
		            column = 2
		            width = medium
		        )
		        Addressed_On
		        (
		            type = datetime
		            displayname = "Addressed On"
		            row = 2
		            column = 1
		            width = medium
		        )
		        Closed_On
		        (
		            type = datetime
		            displayname = "Closed On"
		            row = 2
		            column = 2
		            width = medium
		        )
		
		    actions
		    {
		        on add
		        {
		            Save
		            (
		                type = submit
		                displayname = "Save Feedback"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Feedback"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form SLA_Policies
		{
		    displayname = "SLA Policies"
		    success message = "SLA policy saved successfully."
		
		        Policy_Scope
		        (
		            type = section
		            displayname = "Policy Scope"
		            row = 1
		            column = 0
		        )
		        must have unique Policy_Name
		        (
		            type = text
		            displayname = "Policy Name"
		            row = 1
		            column = 1
		            width = medium
		        )
		        Product
		        (
		            type = picklist
		            displayname = "Product"
		            values = Products.ID
		            displayformat = [Product_Name]
		            searchable = true
		            row = 1
		            column = 2
		            width = medium
		        )
		        Session_Type
		        (
		            type = picklist
		            displayname = "Session Type"
		            values = Session_Types.ID
		            displayformat = [Session_Type_Name]
		            searchable = true
		            row = 1
		            column = 1
		            width = medium
		        )
		        Document_Type
		        (
		            type = picklist
		            displayname = "Document Type"
		            values = Document_Types.ID
		            displayformat = [Document_Type_Name]
		            searchable = true
		            row = 1
		            column = 2
		            width = medium
		        )
		        must have Review_Cycle_Type
		        (
		            type = picklist
		            displayname = "Review Cycle Type"
		            values = {"Any","Initial Review","Fix Verification"}
		            initial value = "Any"
		            row = 1
		            column = 1
		            width = medium
		        )
		        Timing
		        (
		            type = section
		            displayname = "Timing"
		            visibility = true
		            row = 2
		            column = 1
		        )
		        must have SLA_Business_Days
		        (
		            type = number
		            displayname = "SLA Business Days"
		            row = 2
		            column = 1
		            width = medium
		        )
		        Priority
		        (
		            type = number
		            displayname = "Priority"
		            initial value = 100
		            row = 2
		            column = 2
		            width = medium
		        )
		        Effective_From
		        (
		            type = date
		            displayname = "Effective From"
		            row = 2
		            column = 1
		            width = medium
		        )
		        Effective_To
		        (
		            type = date
		            displayname = "Effective To"
		            row = 2
		            column = 2
		            width = medium
		        )
		        Active
		        (
		            type = checkbox
		            displayname = "Active"
		            initial value = true
		            row = 2
		            column = 1
		            width = medium
		        )
		        Notes
		        (
		            type = textarea
		            displayname = "Notes"
		            height = 100px
		            row = 2
		            column = 2
		            width = medium
		        )
		
		    actions
		    {
		        on add
		        {
		            Save
		            (
		                type = submit
		                displayname = "Save SLA Policy"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update SLA Policy"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Session_Types
		{
		    displayname = "Session Types"
		    success message = "Session type saved successfully."
		
		        Session_Type_Details
		        (
		            type = section
		            displayname = "Session Type Details"
		            row = 1
		            column = 0
		        )
		        must have unique Session_Type_Name
		        (
		            type = text
		            displayname = "Session Type Name"
		            row = 1
		            column = 1
		            width = medium
		        )
		        Description
		        (
		            type = textarea
		            displayname = "Description"
		            height = 100px
		            row = 1
		            column = 2
		            width = medium
		        )
		        Active
		        (
		            type = checkbox
		            displayname = "Active"
		            initial value = true
		            row = 1
		            column = 1
		            width = medium
		        )
		
		    actions
		    {
		        on add
		        {
		            Save
		            (
		                type = submit
		                displayname = "Save Session Type"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Session Type"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Sessions
		{
		    displayname = "Sessions"
		    success message = "Session saved successfully."
		    record owner = Session_Owner
		
		        Session_Details
		        (
		            type = section
		            displayname = "Session Details"
		            row = 1
		            column = 0
		        )
		        Session_ID
		        (
		            type = autonumber
		            displayname = "Session ID"
		            start index = 1
		            row = 1
		            column = 1
		        )
		        must have Session_Name
		        (
		            type = text
		            displayname = "Session Name"
		            row = 1
		            column = 1
		            width = medium
		        )
		        must have Product
		        (
		            type = picklist
		            displayname = "Product"
		            values = Products[Active == true].ID
		            displayformat = [Product_Name]
		            searchable = true
		            row = 1
		            column = 2
		            width = medium
		        )
		        must have Session_Type
		        (
		            type = picklist
		            displayname = "Session Type"
		            values = Session_Types[Active == true].ID
		            displayformat = [Session_Type_Name]
		            searchable = true
		            row = 1
		            column = 1
		            width = medium
		        )
		        Series_Name
		        (
		            type = text
		            displayname = "Series Name"
		            row = 1
		            column = 2
		            width = medium
		        )
		        Description
		        (
		            type = textarea
		            displayname = "Description"
		            height = 100px
		            row = 1
		            column = 1
		            width = medium
		        )
		        Schedule
		        (
		            type = section
		            displayname = "Schedule"
		            visibility = true
		            row = 2
		            column = 1
		        )
		        Start_Date_Time
		        (
		            type = datetime
		            displayname = "Start Date and Time"
		            row = 2
		            column = 1
		            width = medium
		        )
		        End_Date_Time
		        (
		            type = datetime
		            displayname = "End Date and Time"
		            row = 2
		            column = 2
		            width = medium
		        )
		        Ownership
		        (
		            type = section
		            displayname = "Ownership"
		            visibility = true
		            row = 3
		            column = 1
		        )
		        must have Session_Owner
		        (
		            type = picklist
		            displayname = "Session Owner"
		            module = users
		            displayformat = [name]
		            row = 3
		            column = 1
		            width = medium
		        )
		        must have Status
		        (
		            type = picklist
		            displayname = "Status"
		            values = {"Planned","Scheduled","Completed","Cancelled"}
		            initial value = "Planned"
		            row = 3
		            column = 2
		            width = medium
		        )
		
		    actions
		    {
		        on add
		        {
		            Save
		            (
		                type = submit
		                displayname = "Save Session"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Session"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Team_Members
		{
		    displayname = "Team Members"
		    success message = "Team member saved successfully."
		
		        User_Details
		        (
		            type = section
		            displayname = "User Details"
		            row = 1
		            column = 0
		        )
		        must have Member_User
		        (
		            type = picklist
		            displayname = "Member User"
		            module = users
		            displayformat = [name]
		            row = 1
		            column = 1
		            width = medium
		        )
		        must have unique Email
		        (
		            type = email
		            displayname = "Email"
		            row = 1
		            column = 2
		            width = medium
		        )
		        must have Display_Name
		        (
		            type = text
		            displayname = "Display Name"
		            row = 1
		            column = 1
		            width = medium
		        )
		        must have Member_Roles
		        (
		            type = checkboxes
		            displayname = "Member Roles"
		            values = {"Content Resource","Content Reviewer"}
		            layout = 1
		            row = 1
		            column = 2
		            width = medium
		        )
		        Review_Capacity
		        (
		            type = section
		            displayname = "Review Capacity"
		            visibility = true
		            row = 2
		            column = 1
		        )
		        Product_Coverage
		        (
		            type = list
		            displayname = "Product Coverage"
		            values = Products.ID
		            displayformat = [Product_Name]
		            searchable = true
		            height = 120px
		            row = 2
		            column = 1
		            width = medium
		        )
		        Reviewer_Capacity
		        (
		            type = number
		            displayname = "Reviewer Capacity"
		            initial value = 0
		            description [ type = tooltip  message = "Enter 0 for unlimited review capacity." ]
		            row = 2
		            column = 2
		            width = medium
		        )
		        Active
		        (
		            type = checkbox
		            displayname = "Active"
		            initial value = true
		            row = 2
		            column = 1
		            width = medium
		        )
		
		    actions
		    {
		        on add
		        {
		            Save
		            (
		                type = submit
		                displayname = "Save Team Member"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Team Member"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		default list Configuration_Settings
		{
		    displayName = "Configuration Settings"
		    show all rows from Application_Settings
		    (
		        Configuration_Key
		        Default_SLA_Business_Days
		        Due_Soon_Lead_Business_Days
		        Reminder_Time_UTC
		        Time_Zone
		        Auto_Assignment_Strategy
		        Reminders_Enabled
		        Last_Reference_Data_Seeded_On
		    )
		}

		default list Audit_Trail
		{
		    displayName = "Audit Trail"
		    show all rows from Audit_Log
		    (
		        Audit_ID
		        Document
		        Action_Name
		        From_State
		        To_State
		        Performed_By
		        Performed_On
		        Assigned_Reviewer
		        SLA_Due_On
		        Details
		    )
		    filters
		    (
		        Action_Name
		        From_State
		        To_State
		        Performed_By
		    )
		    sort by
		    (
		        Performed_On descending
		    )
		}

		default list All_Content_Documents
		{
		    displayName = "All Content Documents"
		    show all rows from Content_Documents
		    (
		        Document_ID
		        Document_Title
		        Product
		        Session
		        Document_Type
		        Resource_User
		        Assigned_Reviewer
		        Stage
		        Due_On
		        SLA_Status
		        Downstream_Route
		        Modified_Time
		    )
		    filters
		    (
		        Product
		        Session
		        Document_Type
		        Stage
		        SLA_Status
		        Assigned_Reviewer
		        Resource_User
		    )
		    sort by
		    (
		        Modified_Time descending
		    )
		    conditional formatting
		    (
		        "Overdue"
		        {
		            condition = (SLA_Status == "Overdue" || SLA_Status == "Breached")
		            fields = [Document_Title, Stage, Due_On, SLA_Status]
		            format = "background-color:#FDE8E8;color:#9B1C1C;font-weight:bold"
		        }
		        "Due Soon"
		        {
		            condition = (SLA_Status == "Due Soon")
		            fields = [Document_Title, Due_On, SLA_Status]
		            format = "background-color:#FFF8DB;color:#8A5A00"
		        }
		        "Completed"
		        {
		            condition = (Stage == "Review Completed" || Stage == "Ready for Downstream")
		            fields = [Document_Title, Stage, SLA_Status]
		            format = "background-color:#E8F7EE;color:#146C43"
		        }
		    )
		}

		calendar Content_Due_Calendar
		{
		    displayName = "Content Due Calendar"
		    show all rows from Content_Documents [Due_On is not null]
		    (
		        Document_Title
		        Product
		        Assigned_Reviewer
		        Stage
		        Due_On
		        SLA_Status
		    )
		    filters
		    (
		        Product
		        Assigned_Reviewer
		        Stage
		        SLA_Status
		    )
		    options
		    (
		        display type = month
		        week start day = monday
		        display field = Document_Title
		        start date = Due_On
		        default date
		        (
		            day = Today
		            month = Currentmonth
		            year = Currentyear
		        )
		    )
		    conditional formatting
		    (
		        "Overdue"
		        {
		            condition = (SLA_Status == "Overdue" || SLA_Status == "Breached")
		            fields = [Document_Title, Due_On, SLA_Status]
		            format = "background-color:#FDE8E8;color:#9B1C1C"
		        }
		        "Due Soon"
		        {
		            condition = (SLA_Status == "Due Soon")
		            fields = [Document_Title, Due_On, SLA_Status]
		            format = "background-color:#FFF8DB;color:#8A5A00"
		        }
		    )
		}

		list My_Reviews
		{
		    displayName = "My Reviews"
		    show all rows from Content_Documents [Assigned_Reviewer == zoho.loginuser && (Stage == "Review Under Progress" || Stage == "Feedback Changes Completed")]
		    (
		        Document_ID
		        Document_Title
		        Product
		        Session
		        Document_Type
		        Resource_User
		        Source_Files
		        Content_URL
		        Version_Label
		        Review_Cycle_Number
		        Review_Cycle_Type
		        Due_On
		        SLA_Status
		        Review_Summary
		        Stage
		    )
		    filters
		    (
		        Product
		        Session
		        Document_Type
		        Review_Cycle_Type
		        SLA_Status
		        Stage
		    )
		    sort by
		    (
		        Due_On ascending
		    )
		}

		list My_Submissions
		{
		    displayName = "My Submissions"
		    show all rows from Content_Documents [Resource_User == zoho.loginuser]
		    (
		        Document_ID
		        Document_Title
		        Product
		        Session
		        Document_Type
		        Source_Files
		        Content_URL
		        Version_Label
		        Stage
		        Assigned_Reviewer
		        Due_On
		        SLA_Status
		        Review_Summary
		        Downstream_Route
		        Modified_Time
		    )
		    filters
		    (
		        Product
		        Session
		        Document_Type
		        Stage
		        SLA_Status
		    )
		    sort by
		    (
		        Modified_Time descending
		    )
		}

		list Overdue_Reviews
		{
		    displayName = "Overdue Reviews"
		    show all rows from Content_Documents [SLA_Status == "Overdue" && (Stage == "Review Under Progress" || Stage == "Feedback Changes Completed")]
		    (
		        Document_ID
		        Document_Title
		        Product
		        Session
		        Resource_User
		        Assigned_Reviewer
		        Stage
		        Due_On
		        SLA_Status
		    )
		    filters
		    (
		        Product
		        Session
		        Assigned_Reviewer
		        Stage
		        SLA_Status
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Assigned_Reviewer ascending
		    )
		    sort by
		    (
		        Due_On ascending
		    )
		}

		kanban Review_Pipeline
		{
		    displayName = "Review Pipeline"
		    show all rows from Content_Documents
		    (
		        Document_ID
		        Document_Title
		        Product
		        Assigned_Reviewer
		        Due_On
		        SLA_Status
		        Stage
		    )
		    filters
		    (
		        Product
		        Assigned_Reviewer
		        SLA_Status
		    )
		    options
		    (
		        display field = Stage
		        filter type = manual
		        sort order = custom
		        record count = enable
		    )
		    conditional formatting
		    (
		        "Overdue"
		        {
		            condition = (SLA_Status == "Overdue" || SLA_Status == "Breached")
		            fields = [Document_Title, Due_On, SLA_Status]
		            format = "background-color:#FDE8E8;color:#9B1C1C"
		        }
		        "Due Soon"
		        {
		            condition = (SLA_Status == "Due Soon")
		            fields = [Document_Title, Due_On, SLA_Status]
		            format = "background-color:#FFF8DB;color:#8A5A00"
		        }
		    )
		}

		default list All_Document_Types
		{
		    displayName = "All Document Types"
		    show all rows from Document_Types
