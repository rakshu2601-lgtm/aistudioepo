	workflow
	{
		form
		{
			Application_Settings_On_Load as "Load Application Settings"
			{
			    type = form
			    form = Application_Settings
			    record event = on add or edit
			    description = "Locks fixed configuration choices and protects the system-managed seed timestamp."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Time_Zone;
			                disable Auto_Assignment_Strategy;
			                disable Last_Reference_Data_Seeded_On;
			                if(input.ID != null)
			                {
			                    disable Configuration_Key;
			                }
			            )
			        }
			    }
			}

			Application_Settings_On_Success as "Seed Reference Data"
			{
			    type = form
			    form = Application_Settings
			    record event = on add or edit
			    description = "Creates missing starter products, session types, and document types without changing existing master records."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                product_names = {"Zoho Creator","Zoho Flow","Zoho RPA","Zoho QEngine","Zoho Tables"};
			                for each product_name in product_names
			                {
			                    if(Products[Product_Name == product_name].count() == 0)
			                    {
			                        insert into Products
			                        [
			                            Product_Name = product_name
			                            Active = true
			                        ];
			                    }
			                }
			                session_type_names = {"Webinar","Online Training","Event","Roadshow","In-Person Workshop"};
			                for each session_type_name in session_type_names
			                {
			                    if(Session_Types[Session_Type_Name == session_type_name].count() == 0)
			                    {
			                        insert into Session_Types
			                        [
			                            Session_Type_Name = session_type_name
			                            Active = true
			                        ];
			                    }
			                }
			                document_type_names = {"Promotional Document","Connect Post","Email Invite","Cliq Channel"};
			                for each document_type_name in document_type_names
			                {
			                    if(Document_Types[Document_Type_Name == document_type_name].count() == 0)
			                    {
			                        insert into Document_Types
			                        [
			                            Document_Type_Name = document_type_name
			                            File_Expected = true
			                            URL_Allowed = true
			                            Active = true
			                        ];
			                    }
			                }
			                settings_record = Application_Settings[ID == input.ID];
			                settings_record.Last_Reference_Data_Seeded_On = zoho.currenttime;
			            )
			        }
			    }
			}

			Application_Settings_On_Validate as "Validate Application Settings"
			{
			    type = form
			    form = Application_Settings
			    record event = on add or edit
			    description = "Enforces the single global configuration and valid SLA reminder settings."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Configuration_Key != "GLOBAL")
			                {
			                    alert(Configuration_Key, "The configuration key must be GLOBAL.");
			                    cancel submit;
			                }
			                if(input.Default_SLA_Business_Days <= 0)
			                {
			                    alert(Default_SLA_Business_Days, "Default SLA business days must be greater than zero.");
			                    cancel submit;
			                }
			                if(input.Due_Soon_Lead_Business_Days < 0)
			                {
			                    alert(Due_Soon_Lead_Business_Days, "Due soon lead business days cannot be negative.");
			                    cancel submit;
			                }
			                duplicate_count = Application_Settings[Configuration_Key == "GLOBAL" && ID != input.ID].count();
			                if(duplicate_count > 0)
			                {
			                    alert "Only one GLOBAL application settings record is allowed.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Assignment_Mode_On_User_Input as "Change Reviewer Assignment Mode"
			{
			    type = form
			    form = Content_Documents
			    record event = on add or edit
			    description = "Shows manual reviewer selection or performs least-workload automatic assignment."
			
			    on user input of Assignment_Mode
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Assignment_Mode == "Manual")
			                {
			                    show Assigned_Reviewer;
			                    enable Assigned_Reviewer;
			                    input.Assigned_Reviewer = null;
			                }
			                else
			                {
			                    hide Assigned_Reviewer;
			                    input.Assigned_Reviewer = null;
			                    best_load = 999999999;
			                    best_member_id = 999999999999999999;
			                    for each member in Team_Members[Active == true && Member_Roles.contains("Content Reviewer")] sort by ID
			                    {
			                        if(member.Product_Coverage.isEmpty() || member.Product_Coverage.contains(input.Product))
			                        {
			                            open_load = Content_Documents[Assigned_Reviewer == member.Member_User && (Stage == "Review Under Progress" || Stage == "Feedback Changes Completed")].count();
			                            within_capacity = member.Reviewer_Capacity == 0 || open_load < member.Reviewer_Capacity;
			                            if(within_capacity && (open_load < best_load || (open_load == best_load && member.ID < best_member_id)))
			                            {
			                                input.Assigned_Reviewer = member.Member_User;
			                                best_load = open_load;
			                                best_member_id = member.ID;
			                            }
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Content_Documents_On_Load as "Load Content Document Workspace"
			{
			    type = form
			    form = Content_Documents
			    record event = on add or edit
			    description = "Applies role-aware field visibility and locks system-maintained values."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Product;
			                disable Stage;
			                disable Selected_SLA_Policy;
			                disable Applied_SLA_Business_Days;
			                disable Review_Cycle_Number;
			                disable Review_Cycle_Type;
			                disable Submitted_On;
			                disable Due_On;
			                disable Due_Soon_Reminder_On;
			                disable SLA_Status;
			                disable Final_Approved_On;
			                disable Routed_On;
			                disable Last_Status_Changed_On;
			                if(input.Assignment_Mode == "Manual")
			                {
			                    show Assigned_Reviewer;
			                }
			                else
			                {
			                    hide Assigned_Reviewer;
			                }
			                hide Review_Summary, Review_Attachment, Resource_Response, Final_Reviewer_Comments;
			                if(input.Stage == "Review Under Progress" || input.Stage == "Feedback Changes Completed")
			                {
			                    show Review_Summary, Review_Attachment;
			                }
			                if(input.Stage == "Feedback Fixes In Progress" || input.Stage == "Feedback Changes Completed")
			                {
			                    show Resource_Response;
			                }
			                if(input.Stage == "Review Completed" || input.Stage == "Ready for Downstream")
			                {
			                    show Final_Reviewer_Comments;
			                }
			                hide Downstream_Route, Handoff_Notes;
			                if(input.Stage == "Review Completed" || input.Stage == "Ready for Downstream")
			                {
			                    show Downstream_Route, Handoff_Notes;
			                }
			                is_admin = thisapp.permissions.isUserInProfile("Content Administrator");
			                is_resource = input.Resource_User == null || input.Resource_User.email == zoho.loginuserid;
			                if(is_admin == false && is_resource == false)
			                {
			                    disable Document_Title;
			                    disable Session;
			                    disable Document_Type;
			                    disable Version_Label;
			                    disable Source_Files;
			                    disable Content_URL;
			                    disable Resource_User;
			                    disable Assignment_Mode;
			                    disable Assigned_Reviewer;
			                    disable Resource_Response;
			                    disable Downstream_Route;
			                    disable Handoff_Notes;
			                }
			                if(is_admin == false && (input.Stage == "Review Under Progress" || input.Stage == "Feedback Changes Completed"))
			                {
			                    disable Review_Summary;
			                    disable Review_Attachment;
			                    disable Final_Reviewer_Comments;
			                }
			            )
			        }
			    }
			}

			Content_Documents_On_Success as "Synchronize Assignment and SLA"
			{
			    type = form
			    form = Content_Documents
			    record event = on add or edit
			    description = "Re-resolves automatic reviewer assignment and SLA for draft records after relevant edits."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Stage == "Draft")
			                {
			                    resolved_reviewer = input.Assigned_Reviewer;
			                    if(input.Assignment_Mode == "Auto")
			                    {
			                        resolved_reviewer = null;
			                        best_load = 999999999;
			                        best_member_id = 999999999999999999;
			                        for each member in Team_Members[Active == true && Member_Roles.contains("Content Reviewer")] sort by ID
			                        {
			                            if(member.Product_Coverage.isEmpty() || member.Product_Coverage.contains(input.Product))
			                            {
			                                open_load = Content_Documents[Assigned_Reviewer == member.Member_User && (Stage == "Review Under Progress" || Stage == "Feedback Changes Completed")].count();
			                                within_capacity = member.Reviewer_Capacity == 0 || open_load < member.Reviewer_Capacity;
			                                if(within_capacity && (open_load < best_load || (open_load == best_load && member.ID < best_member_id)))
			                                {
			                                    resolved_reviewer = member.Member_User;
			                                    best_load = open_load;
			                                    best_member_id = member.ID;
			                                }
			                            }
			                        }
			                    }
			                    resolved_policy = null;
			                    resolved_days = input.Applied_SLA_Business_Days;
			                    fallback_settings = Application_Settings[Configuration_Key == "GLOBAL"];
			                    if(fallback_settings.count() > 0) { resolved_days = fallback_settings.Default_SLA_Business_Days; }
			                    best_cycle_rank = -1;
			                    best_dimension_count = -1;
			                    best_priority = -999999;
			                    best_effective = null;
			                    best_id = 0;
			                    session_type_id = input.Session.Session_Type;
			                    for each policy in SLA_Policies[Active == true]
			                    {
			                        effective_now = (policy.Effective_From == null || policy.Effective_From <= zoho.currentdate) && (policy.Effective_To == null || policy.Effective_To >= zoho.currentdate);
			                        scope_matches = (policy.Product == null || policy.Product == input.Product) && (policy.Session_Type == null || policy.Session_Type == session_type_id) && (policy.Document_Type == null || policy.Document_Type == input.Document_Type);
			                        cycle_matches = policy.Review_Cycle_Type == "Any" || policy.Review_Cycle_Type == input.Review_Cycle_Type;
			                        if(effective_now && scope_matches && cycle_matches)
			                        {
			                            cycle_rank = if(policy.Review_Cycle_Type == input.Review_Cycle_Type,1,0);
			                            dimensions = 0;
			                            if(policy.Product != null) { dimensions = dimensions + 1; }
			                            if(policy.Session_Type != null) { dimensions = dimensions + 1; }
			                            if(policy.Document_Type != null) { dimensions = dimensions + 1; }
			                            newer_effective = best_effective == null || (policy.Effective_From != null && policy.Effective_From > best_effective);
			                            better = cycle_rank > best_cycle_rank || (cycle_rank == best_cycle_rank && dimensions > best_dimension_count) || (cycle_rank == best_cycle_rank && dimensions == best_dimension_count && policy.Priority > best_priority) || (cycle_rank == best_cycle_rank && dimensions == best_dimension_count && policy.Priority == best_priority && newer_effective) || (cycle_rank == best_cycle_rank && dimensions == best_dimension_count && policy.Priority == best_priority && policy.Effective_From == best_effective && policy.ID > best_id);
			                            if(better)
			                            {
			                                resolved_policy = policy.ID;
			                                resolved_days = policy.SLA_Business_Days;
			                                best_cycle_rank = cycle_rank;
			                                best_dimension_count = dimensions;
			                                best_priority = policy.Priority;
			                                best_effective = policy.Effective_From;
			                                best_id = policy.ID;
			                            }
			                        }
			                    }
			                    saved_doc = Content_Documents[ID == input.ID];
			                    if(saved_doc.count() > 0)
			                    {
			                        saved_doc.Assigned_Reviewer = resolved_reviewer;
			                        saved_doc.Selected_SLA_Policy = resolved_policy;
			                        saved_doc.Applied_SLA_Business_Days = resolved_days;
			                    }
			                }
			            )
			        }
			    }
			}

			Content_Documents_On_Validate as "Validate Content Document"
			{
			    type = form
			    form = Content_Documents
			    record event = on add or edit
			    description = "Validates assets, session availability, manual reviewer eligibility, and resource ownership."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Source_Files == null && input.Content_URL in {""," ","null"})
			                {
			                    alert "Upload at least one source file or provide a content URL.";
			                    cancel submit;
			                }
			                if(input.Session != null)
			                {
			                    selected_session = Sessions[ID == input.Session];
			                    if(selected_session.count() == 0 || selected_session.Status == "Cancelled")
			                    {
			                        alert "Select a session that has not been cancelled.";
			                        cancel submit;
			                    }
			                }
			                if(input.Assignment_Mode == "Manual" && input.Assigned_Reviewer != null)
			                {
			                    eligible_reviewer = Team_Members[Member_User == input.Assigned_Reviewer && Active == true && Member_Roles.contains("Content Reviewer")];
			                    reviewer_is_eligible = false;
			                    if(eligible_reviewer.count() > 0)
			                    {
			                        if(eligible_reviewer.Product_Coverage.isEmpty() || eligible_reviewer.Product_Coverage.contains(input.Product))
			                        {
			                            reviewer_is_eligible = true;
			                        }
			                    }
			                    if(reviewer_is_eligible == false)
			                    {
			                        alert "The manually selected reviewer is not active or is not eligible for this product.";
			                        cancel submit;
			                    }
			                }
			                is_admin = thisapp.permissions.isUserInProfile("Content Administrator");
			                if(is_admin == false && input.Resource_User != null && input.Resource_User.email != zoho.loginuserid)
			                {
			                    is_blueprint_reviewer = false;
			                    if(input.Assigned_Reviewer != null && input.Assigned_Reviewer.email == zoho.loginuserid && input.ID != null)
			                    {
			                        is_blueprint_reviewer = true;
			                    }
			                    if(is_blueprint_reviewer == false)
			                    {
			                        alert "Only the assigned resource may edit this content document directly.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Document_Type_On_User_Input as "Apply Document Type SLA"
			{
			    type = form
			    form = Content_Documents
			    record event = on add or edit
			    description = "Recalculates the SLA when the document type changes."
			
			    on user input of Document_Type
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Selected_SLA_Policy = null;
			                fallback_settings = Application_Settings[Configuration_Key == "GLOBAL"];
			                if(fallback_settings.count() > 0) { input.Applied_SLA_Business_Days = fallback_settings.Default_SLA_Business_Days; }
			                best_cycle_rank = -1;
			                best_dimension_count = -1;
			                best_priority = -999999;
			                best_effective = null;
			                best_id = 0;
			                session_type_id = null;
			                if(input.Session != null) { session_type_id = input.Session.Session_Type; }
			                for each policy in SLA_Policies[Active == true]
			                {
			                    effective_now = (policy.Effective_From == null || policy.Effective_From <= zoho.currentdate) && (policy.Effective_To == null || policy.Effective_To >= zoho.currentdate);
			                    scope_matches = (policy.Product == null || policy.Product == input.Product) && (policy.Session_Type == null || policy.Session_Type == session_type_id) && (policy.Document_Type == null || policy.Document_Type == input.Document_Type);
			                    cycle_matches = policy.Review_Cycle_Type == "Any" || policy.Review_Cycle_Type == input.Review_Cycle_Type;
			                    if(effective_now && scope_matches && cycle_matches)
			                    {
			                        cycle_rank = if(policy.Review_Cycle_Type == input.Review_Cycle_Type,1,0);
			                        dimensions = 0;
			                        if(policy.Product != null) { dimensions = dimensions + 1; }
			                        if(policy.Session_Type != null) { dimensions = dimensions + 1; }
			                        if(policy.Document_Type != null) { dimensions = dimensions + 1; }
			                        newer_effective = best_effective == null || (policy.Effective_From != null && policy.Effective_From > best_effective);
			                        better = cycle_rank > best_cycle_rank || (cycle_rank == best_cycle_rank && dimensions > best_dimension_count) || (cycle_rank == best_cycle_rank && dimensions == best_dimension_count && policy.Priority > best_priority) || (cycle_rank == best_cycle_rank && dimensions == best_dimension_count && policy.Priority == best_priority && newer_effective) || (cycle_rank == best_cycle_rank && dimensions == best_dimension_count && policy.Priority == best_priority && policy.Effective_From == best_effective && policy.ID > best_id);
			                        if(better)
			                        {
			                            input.Selected_SLA_Policy = policy.ID;
			                            input.Applied_SLA_Business_Days = policy.SLA_Business_Days;
			                            best_cycle_rank = cycle_rank;
			                            best_dimension_count = dimensions;
			                            best_priority = policy.Priority;
			                            best_effective = policy.Effective_From;
			                            best_id = policy.ID;
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Product_On_User_Input as "Apply Product Assignment and SLA"
			{
			    type = form
			    form = Content_Documents
			    record event = on add or edit
			    description = "Recalculates SLA and assigns the least-loaded eligible reviewer for automatic assignment."
			
			    on user input of Product
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Selected_SLA_Policy = null;
			                fallback_settings = Application_Settings[Configuration_Key == "GLOBAL"];
			                if(fallback_settings.count() > 0) { input.Applied_SLA_Business_Days = fallback_settings.Default_SLA_Business_Days; }
			                best_cycle_rank = -1;
			                best_dimension_count = -1;
			                best_priority = -999999;
			                best_effective = null;
			                best_id = 0;
			                session_type_id = null;
			                if(input.Session != null) { session_type_id = input.Session.Session_Type; }
			                for each policy in SLA_Policies[Active == true]
			                {
			                    effective_now = (policy.Effective_From == null || policy.Effective_From <= zoho.currentdate) && (policy.Effective_To == null || policy.Effective_To >= zoho.currentdate);
			                    scope_matches = (policy.Product == null || policy.Product == input.Product) && (policy.Session_Type == null || policy.Session_Type == session_type_id) && (policy.Document_Type == null || policy.Document_Type == input.Document_Type);
			                    cycle_matches = policy.Review_Cycle_Type == "Any" || policy.Review_Cycle_Type == input.Review_Cycle_Type;
			                    if(effective_now && scope_matches && cycle_matches)
			                    {
			                        cycle_rank = if(policy.Review_Cycle_Type == input.Review_Cycle_Type,1,0);
			                        dimensions = 0;
			                        if(policy.Product != null) { dimensions = dimensions + 1; }
			                        if(policy.Session_Type != null) { dimensions = dimensions + 1; }
			                        if(policy.Document_Type != null) { dimensions = dimensions + 1; }
			                        newer_effective = best_effective == null || (policy.Effective_From != null && policy.Effective_From > best_effective);
			                        better = cycle_rank > best_cycle_rank || (cycle_rank == best_cycle_rank && dimensions > best_dimension_count) || (cycle_rank == best_cycle_rank && dimensions == best_dimension_count && policy.Priority > best_priority) || (cycle_rank == best_cycle_rank && dimensions == best_dimension_count && policy.Priority == best_priority && newer_effective) || (cycle_rank == best_cycle_rank && dimensions == best_dimension_count && policy.Priority == best_priority && policy.Effective_From == best_effective && policy.ID > best_id);
			                        if(better)
			                        {
			                            input.Selected_SLA_Policy = policy.ID;
			                            input.Applied_SLA_Business_Days = policy.SLA_Business_Days;
			                            best_cycle_rank = cycle_rank;
			                            best_dimension_count = dimensions;
			                            best_priority = policy.Priority;
			                            best_effective = policy.Effective_From;
			                            best_id = policy.ID;
			                        }
			                    }
			                }
			                if(input.Assignment_Mode == "Auto")
			                {
			                    input.Assigned_Reviewer = null;
			                    best_load = 999999999;
			                    best_member_id = 999999999999999999;
			                    for each member in Team_Members[Active == true && Member_Roles.contains("Content Reviewer")] sort by ID
			                    {
			                        if(member.Product_Coverage.isEmpty() || member.Product_Coverage.contains(input.Product))
			                        {
			                            open_load = Content_Documents[Assigned_Reviewer == member.Member_User && (Stage == "Review Under Progress" || Stage == "Feedback Changes Completed")].count();
			                            within_capacity = member.Reviewer_Capacity == 0 || open_load < member.Reviewer_Capacity;
			                            if(within_capacity && (open_load < best_load || (open_load == best_load && member.ID < best_member_id)))
			                            {
			                                input.Assigned_Reviewer = member.Member_User;
			                                best_load = open_load;
			                                best_member_id = member.ID;
			                            }
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Session_On_User_Input as "Apply Session Product and SLA"
			{
			    type = form
			    form = Content_Documents
			    record event = on add or edit
			    description = "Derives the product from the selected session and applies the most-specific SLA policy."
			
			    on user input of Session
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Session != null)
			                {
			                    selected_session = Sessions[ID == input.Session];
			                    if(selected_session.count() > 0)
			                    {
			                        input.Product = selected_session.Product;
			                    }
			                }
			                input.Selected_SLA_Policy = null;
			                fallback_settings = Application_Settings[Configuration_Key == "GLOBAL"];
			                if(fallback_settings.count() > 0)
			                {
			                    input.Applied_SLA_Business_Days = fallback_settings.Default_SLA_Business_Days;
			                }
			                best_cycle_rank = -1;
			                best_dimension_count = -1;
			                best_priority = -999999;
			                best_effective = null;
			                best_id = 0;
			                for each policy in SLA_Policies[Active == true]
			                {
			                    effective_now = (policy.Effective_From == null || policy.Effective_From <= zoho.currentdate) && (policy.Effective_To == null || policy.Effective_To >= zoho.currentdate);
			                    scope_matches = (policy.Product == null || policy.Product == input.Product) && (policy.Session_Type == null || policy.Session_Type == input.Session.Session_Type) && (policy.Document_Type == null || policy.Document_Type == input.Document_Type);
			                    cycle_matches = policy.Review_Cycle_Type == "Any" || policy.Review_Cycle_Type == input.Review_Cycle_Type;
			                    if(effective_now && scope_matches && cycle_matches)
			                    {
			                        cycle_rank = if(policy.Review_Cycle_Type == input.Review_Cycle_Type,1,0);
			                        dimensions = 0;
			                        if(policy.Product != null) { dimensions = dimensions + 1; }
			                        if(policy.Session_Type != null) { dimensions = dimensions + 1; }
			                        if(policy.Document_Type != null) { dimensions = dimensions + 1; }
			                        newer_effective = best_effective == null || (policy.Effective_From != null && policy.Effective_From > best_effective);
			                        better = cycle_rank > best_cycle_rank || (cycle_rank == best_cycle_rank && dimensions > best_dimension_count) || (cycle_rank == best_cycle_rank && dimensions == best_dimension_count && policy.Priority > best_priority) || (cycle_rank == best_cycle_rank && dimensions == best_dimension_count && policy.Priority == best_priority && newer_effective) || (cycle_rank == best_cycle_rank && dimensions == best_dimension_count && policy.Priority == best_priority && policy.Effective_From == best_effective && policy.ID > best_id);
			                        if(better)
			                        {
			                            input.Selected_SLA_Policy = policy.ID;
			                            input.Applied_SLA_Business_Days = policy.SLA_Business_Days;
			                            best_cycle_rank = cycle_rank;
			                            best_dimension_count = dimensions;
			                            best_priority = policy.Priority;
			                            best_effective = policy.Effective_From;
			                            best_id = policy.ID;
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Downstream_Routes_On_Validate as "Validate Downstream Route"
			{
			    type = form
			    form = Downstream_Routes
			    record event = on add or edit
			    description = "Ensures every route has a destination and that nonstandard processes have instructions."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if((input.Destination_Team == null || input.Destination_Team.trim() == "") && (input.Destination_Email == null || input.Destination_Email == ""))
			                {
			                    alert "Enter either a destination team or destination email.";
			                    cancel submit;
			                }
			                if(input.Route_Type == "Other Process" && (input.Instructions == null || input.Instructions.trim() == ""))
			                {
			                    alert(Instructions, "Instructions are required for an Other Process route.");
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Feedback_Status_On_User_Input as "Update Feedback Response Visibility"
			{
			    type = form
			    form = Review_Feedback
			    record event = on add or edit
			    description = "Keeps the resource response available while feedback is open or addressed."
			
			    on user input of Feedback_Status
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Feedback_Status == "Open" || input.Feedback_Status == "Addressed")
			                {
			                    show Resource_Response;
			                }
			                else
			                {
			                    hide Resource_Response;
			                }
			            )
			        }
			    }
			}

			Review_Feedback_On_Load as "Load Feedback Workspace"
			{
			    type = form
			    form = Review_Feedback
			    record event = on add or edit
			    description = "Applies role-aware edit controls for comments, responses, status, and timestamps."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Addressed_On, Closed_On;
			                document_record = Content_Documents[ID == input.Document];
			                is_admin = thisapp.permissions.isUserInProfile("Content Administrator");
			                is_resource = document_record.count() > 0 && document_record.Resource_User.email == zoho.loginuserid;
			                is_reviewer = document_record.count() > 0 && document_record.Assigned_Reviewer.email == zoho.loginuserid;
			                if(input.Feedback_Status == "Open" || input.Feedback_Status == "Addressed")
			                {
			                    show Resource_Response;
			                }
			                else
			                {
			                    hide Resource_Response;
			                }
			                if(is_admin == false && is_resource)
			                {
			                    disable Document;
			                    disable Review_Cycle_Number;
			                    disable Reviewer_User;
			                    disable Feedback_Category;
			                    disable Feedback_Comments;
			                    disable Reference_File;
			                    enable Resource_Response;
			                    enable Feedback_Status;
			                }
			                if(is_admin == false && is_reviewer)
			                {
			                    disable Resource_Response;
			                }
			                if(is_admin == false && is_resource == false && is_reviewer == false)
			                {
			                    disable Document;
			                    disable Review_Cycle_Number;
			                    disable Reviewer_User;
			                    disable Feedback_Category;
			                    disable Feedback_Comments;
			                    disable Reference_File;
			                    disable Feedback_Status;
			                    disable Resource_Response;
			                }
			            )
			        }
			    }
			}

			Review_Feedback_On_Success as "Audit Feedback Resolution"
			{
			    type = form
			    form = Review_Feedback
			    record event = on add or edit
			    description = "Stamps feedback resolution milestones and writes an audit record."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                feedback_record = Review_Feedback[ID == input.ID];
			                action_name = "Feedback Saved";
			                from_state = "";
			                if(input.Feedback_Status == "Addressed")
			                {
			                    action_name = "Feedback Addressed";
			                    feedback_record.Addressed_On = zoho.currenttime;
			                }
			                if(input.Feedback_Status == "Closed")
			                {
			                    action_name = "Feedback Closed";
			                    feedback_record.Closed_On = zoho.currenttime;
			                }
			                document_record = Content_Documents[ID == input.Document];
			                reviewer_email = "";
			                due_on = null;
			                if(document_record.count() > 0)
			                {
			                    due_on = document_record.Due_On;
			                    if(document_record.Assigned_Reviewer != null) { reviewer_email = document_record.Assigned_Reviewer.email; }
			                }
			                insert into Audit_Log
			                [
			                    Document = input.Document
			                    Action_Name = action_name
			                    From_State = from_state
			                    To_State = input.Feedback_Status
			                    Performed_By = zoho.loginuserid
			                    Performed_On = zoho.currenttime
			                    Assigned_Reviewer = reviewer_email
			                    SLA_Due_On = due_on
			                    Details = input.Feedback_Comments + " Response: " + input.Resource_Response
			                ];
			            )
			        }
			    }
			}

			Review_Feedback_On_Validate as "Validate Review Feedback"
			{
			    type = form
			    form = Review_Feedback
			    record event = on add or edit
			    description = "Enforces reviewer ownership and resource/reviewer resolution responsibilities."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                is_admin = thisapp.permissions.isUserInProfile("Content Administrator");
			                document_record = Content_Documents[ID == input.Document];
			                if(document_record.count() == 0)
			                {
			                    alert "Select a valid content document.";
			                    cancel submit;
			                }
			                if(is_admin == false && input.Reviewer_User != document_record.Assigned_Reviewer)
			                {
			                    alert "Reviewer must match the reviewer assigned to the content document.";
			                    cancel submit;
			                }
			                if(input.ID != null)
			                {
			                    if(input.Feedback_Status == "Addressed" && is_admin == false && document_record.Resource_User.email != zoho.loginuserid)
			                    {
			                        alert "Only the document resource may mark feedback as addressed.";
			                        cancel submit;
			                    }
			                    if(input.Feedback_Status == "Closed" && is_admin == false && document_record.Assigned_Reviewer.email != zoho.loginuserid)
			                    {
			                        alert "Only the assigned reviewer may close feedback.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			SLA_Policies_On_Validate as "Validate SLA Policy"
			{
			    type = form
			    form = SLA_Policies
			    record event = on add or edit
			    description = "Validates policy scope, dates, duration, and overlapping active rules."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(ifnull(input.SLA_Business_Days,0) <= 0)
			                {
			                    alert(SLA_Business_Days, "SLA business days must be greater than zero.");
			                    cancel submit;
			                }
			                if(input.Effective_From != null && input.Effective_To != null && input.Effective_To < input.Effective_From)
			                {
			                    alert(Effective_To, "Effective To cannot be earlier than Effective From.");
			                    cancel submit;
			                }
			                if(input.Product == null && input.Session_Type == null && input.Document_Type == null && input.Review_Cycle_Type == "Any")
			                {
			                    alert "Select at least one scope dimension or a specific review cycle.";
			                    cancel submit;
			                }
			                if(input.Active == true)
			                {
			                    for each existing_policy in SLA_Policies[Active == true && ID != input.ID]
			                    {
			                        same_product = (existing_policy.Product == input.Product);
			                        same_session_type = (existing_policy.Session_Type == input.Session_Type);
			                        same_document_type = (existing_policy.Document_Type == input.Document_Type);
			                        same_cycle = (existing_policy.Review_Cycle_Type == input.Review_Cycle_Type);
			                        dates_overlap = true;
			                        if(existing_policy.Effective_To != null && input.Effective_From != null && existing_policy.Effective_To < input.Effective_From)
			                        {
			                            dates_overlap = false;
			                        }
			                        if(input.Effective_To != null && existing_policy.Effective_From != null && input.Effective_To < existing_policy.Effective_From)
			                        {
			                            dates_overlap = false;
			                        }
			                        if(same_product && same_session_type && same_document_type && same_cycle && dates_overlap)
			                        {
			                            alert "An active SLA policy with the same scope and overlapping effective dates already exists.";
			                            cancel submit;
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			End_Date_Time_On_User_Input as "Validate Session End"
			{
			    type = form
			    form = Sessions
			    record event = on add or edit
			    description = "Provides immediate feedback when the selected end precedes the start."
			
			    on user input of End_Date_Time
