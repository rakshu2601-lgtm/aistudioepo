form SLA_Policies
{
    displayname = "SLA Policies"
    success message = "SLA policy saved successfully."

        Policy_Scope
        (
            type = section
            displayname = "Policy Scope"
            row = 1
            column = 0
        )
        must have unique Policy_Name
        (
            type = text
            displayname = "Policy Name"
            row = 1
            column = 1
            width = medium
        )
        Product
        (
            type = picklist
            displayname = "Product"
            values = Products.ID
            displayformat = [Product_Name]
            searchable = true
            row = 1
            column = 2
            width = medium
        )
        Session_Type
        (
            type = picklist
            displayname = "Session Type"
            values = Session_Types.ID
            displayformat = [Session_Type_Name]
            searchable = true
            row = 1
            column = 1
            width = medium
        )
        Document_Type
        (
            type = picklist
            displayname = "Document Type"
            values = Document_Types.ID
            displayformat = [Document_Type_Name]
            searchable = true
            row = 1
            column = 2
            width = medium
        )
        must have Review_Cycle_Type
        (
            type = picklist
            displayname = "Review Cycle Type"
            values = {"Any","Initial Review","Fix Verification"}
            initial value = "Any"
            row = 1
            column = 1
            width = medium
        )
        Timing
        (
            type = section
            displayname = "Timing"
            visibility = true
            row = 2
            column = 1
        )
        must have SLA_Business_Days
        (
            type = number
            displayname = "SLA Business Days"
            row = 2
            column = 1
            width = medium
        )
        Priority
        (
            type = number
            displayname = "Priority"
            initial value = 100
            row = 2
            column = 2
            width = medium
        )
        Effective_From
        (
            type = date
            displayname = "Effective From"
            row = 2
            column = 1
            width = medium
        )
        Effective_To
        (
            type = date
            displayname = "Effective To"
            row = 2
            column = 2
            width = medium
        )
        Active
        (
            type = checkbox
            displayname = "Active"
            initial value = true
            row = 2
            column = 1
            width = medium
        )
        Notes
        (
            type = textarea
            displayname = "Notes"
            height = 100px
            row = 2
            column = 2
            width = medium
        )

    actions
    {
        on add
        {
            Save
            (
                type = submit
                displayname = "Save SLA Policy"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update SLA Policy"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}