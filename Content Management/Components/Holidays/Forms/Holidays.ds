form Holidays
{
    displayname = "Holidays"
    success message = "Holiday saved successfully."

        Holiday_Details
        (
            type = section
            displayname = "Holiday Details"
            row = 1
            column = 0
        )
        must have unique Holiday_Date
        (
            type = date
            displayname = "Holiday Date"
            row = 1
            column = 1
            width = medium
        )
        must have Holiday_Name
        (
            type = text
            displayname = "Holiday Name"
            row = 1
            column = 2
            width = medium
        )
        Active
        (
            type = checkbox
            displayname = "Active"
            initial value = true
            row = 1
            column = 1
            width = medium
        )
        Notes
        (
            type = textarea
            displayname = "Notes"
            height = 100px
            row = 1
            column = 2
            width = medium
        )

    actions
    {
        on add
        {
            Save
            (
                type = submit
                displayname = "Save Holiday"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Holiday"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}