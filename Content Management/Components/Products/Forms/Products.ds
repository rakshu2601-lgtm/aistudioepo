form Products
{
    displayname = "Products"
    success message = "Product saved successfully."

        Product_Details
        (
            type = section
            displayname = "Product Details"
            row = 1
            column = 0
        )
        must have unique Product_Name
        (
            type = text
            displayname = "Product Name"
            row = 1
            column = 1
            width = medium
        )
        unique Product_Code
        (
            type = text
            displayname = "Product Code"
            row = 1
            column = 2
            width = medium
        )
        Description
        (
            type = textarea
            displayname = "Description"
            height = 100px
            row = 1
            column = 1
            width = medium
        )
        Ownership
        (
            type = section
            displayname = "Ownership"
            visibility = true
            row = 2
            column = 1
        )
        Product_Owner
        (
            type = picklist
            displayname = "Product Owner"
            module = users
            displayformat = [name]
            row = 2
            column = 1
            width = medium
        )
        Active
        (
            type = checkbox
            displayname = "Active"
            initial value = true
            row = 2
            column = 2
            width = medium
        )

    actions
    {
        on add
        {
            Save
            (
                type = submit
                displayname = "Save Product"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Product"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}