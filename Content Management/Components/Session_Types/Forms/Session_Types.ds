form Session_Types
{
    displayname = "Session Types"
    success message = "Session type saved successfully."

        Session_Type_Details
        (
            type = section
            displayname = "Session Type Details"
            row = 1
            column = 0
        )
        must have unique Session_Type_Name
        (
            type = text
            displayname = "Session Type Name"
            row = 1
            column = 1
            width = medium
        )
        Description
        (
            type = textarea
            displayname = "Description"
            height = 100px
            row = 1
            column = 2
            width = medium
        )
        Active
        (
            type = checkbox
            displayname = "Active"
            initial value = true
            row = 1
            column = 1
            width = medium
        )

    actions
    {
        on add
        {
            Save
            (
                type = submit
                displayname = "Save Session Type"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Session Type"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}