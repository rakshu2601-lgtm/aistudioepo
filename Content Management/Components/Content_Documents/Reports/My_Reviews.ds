list My_Reviews
{
    displayName = "My Reviews"
    show all rows from Content_Documents [Assigned_Reviewer == zoho.loginuser && (Stage == "Review Under Progress" || Stage == "Feedback Changes Completed")]
    (
        Document_ID
        Document_Title
        Product
        Session
        Document_Type
        Resource_User
        Source_Files
        Content_URL
        Version_Label
        Review_Cycle_Number
        Review_Cycle_Type
        Due_On
        SLA_Status
        Review_Summary
        Stage
    )
    filters
    (
        Product
        Session
        Document_Type
        Review_Cycle_Type
        SLA_Status
        Stage
    )
    sort by
    (
        Due_On ascending
    )
}