Session_On_User_Input as "Apply Session Product and SLA"
{
    type = form
    form = Content_Documents
    record event = on add or edit
    description = "Derives the product from the selected session and applies the most-specific SLA policy."

    on user input of Session
    {
        actions
        {
            custom deluge script
            (
                if(input.Session != null)
                {
                    selected_session = Sessions[ID == input.Session];
                    if(selected_session.count() > 0)
                    {
                        input.Product = selected_session.Product;
                    }
                }
                input.Selected_SLA_Policy = null;
                fallback_settings = Application_Settings[Configuration_Key == "GLOBAL"];
                if(fallback_settings.count() > 0)
                {
                    input.Applied_SLA_Business_Days = fallback_settings.Default_SLA_Business_Days;
                }
                best_cycle_rank = -1;
                best_dimension_count = -1;
                best_priority = -999999;
                best_effective = null;
                best_id = 0;
                for each policy in SLA_Policies[Active == true]
                {
                    effective_now = (policy.Effective_From == null || policy.Effective_From <= zoho.currentdate) && (policy.Effective_To == null || policy.Effective_To >= zoho.currentdate);
                    scope_matches = (policy.Product == null || policy.Product == input.Product) && (policy.Session_Type == null || policy.Session_Type == input.Session.Session_Type) && (policy.Document_Type == null || policy.Document_Type == input.Document_Type);
                    cycle_matches = policy.Review_Cycle_Type == "Any" || policy.Review_Cycle_Type == input.Review_Cycle_Type;
                    if(effective_now && scope_matches && cycle_matches)
                    {
                        cycle_rank = if(policy.Review_Cycle_Type == input.Review_Cycle_Type,1,0);
                        dimensions = 0;
                        if(policy.Product != null) { dimensions = dimensions + 1; }
                        if(policy.Session_Type != null) { dimensions = dimensions + 1; }
                        if(policy.Document_Type != null) { dimensions = dimensions + 1; }
                        newer_effective = best_effective == null || (policy.Effective_From != null && policy.Effective_From > best_effective);
                        better = cycle_rank > best_cycle_rank || (cycle_rank == best_cycle_rank && dimensions > best_dimension_count) || (cycle_rank == best_cycle_rank && dimensions == best_dimension_count && policy.Priority > best_priority) || (cycle_rank == best_cycle_rank && dimensions == best_dimension_count && policy.Priority == best_priority && newer_effective) || (cycle_rank == best_cycle_rank && dimensions == best_dimension_count && policy.Priority == best_priority && policy.Effective_From == best_effective && policy.ID > best_id);
                        if(better)
                        {
                            input.Selected_SLA_Policy = policy.ID;
                            input.Applied_SLA_Business_Days = policy.SLA_Business_Days;
                            best_cycle_rank = cycle_rank;
                            best_dimension_count = dimensions;
                            best_priority = policy.Priority;
                            best_effective = policy.Effective_From;
                            best_id = policy.ID;
                        }
                    }
                }
            )
        }
    }
}