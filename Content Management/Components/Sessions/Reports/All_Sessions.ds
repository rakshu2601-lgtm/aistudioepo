default list All_Sessions
{
    displayName = "All Sessions"
    show all rows from Sessions
    (
        Session_ID
        Session_Name
        Product
        Session_Type
        Series_Name
        Start_Date_Time
        End_Date_Time
        Session_Owner
        Status
    )
    filters
    (
        Product
        Session_Type
        Status
        Session_Owner
    )
    sort by
    (
        Start_Date_Time descending
    )
}