Start_Date_Time_On_User_Input as "Adjust Session End"
{
    type = form
    form = Sessions
    record event = on add or edit
    description = "Clears an end date and time that becomes earlier than the selected start."

    on user input of Start_Date_Time
    {
        actions
        {
            custom deluge script
            (
                if(input.Start_Date_Time != null && input.End_Date_Time != null && input.End_Date_Time < input.Start_Date_Time)
                {
                    input.End_Date_Time = null;
                    alert "The previous end date and time was cleared because it preceded the new start.";
                }
            )
        }
    }
}