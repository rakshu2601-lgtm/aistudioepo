form Downstream_Routes
{
    displayname = "Downstream Routes"
    success message = "Downstream route saved successfully."

        Route_Details
        (
            type = section
            displayname = "Route Details"
            row = 1
            column = 0
        )
        must have unique Route_Name
        (
            type = text
            displayname = "Route Name"
            row = 1
            column = 1
            width = medium
        )
        must have Route_Type
        (
            type = picklist
            displayname = "Route Type"
            values = {"Communications Review","Other Process"}
            row = 1
            column = 2
            width = medium
        )
        Instructions
        (
            type = textarea
            displayname = "Instructions"
            height = 100px
            row = 1
            column = 1
            width = medium
        )
        Handoff_Contact
        (
            type = section
            displayname = "Handoff Contact"
            visibility = true
            row = 2
            column = 1
        )
        Destination_Team
        (
            type = text
            displayname = "Destination Team"
            row = 2
            column = 1
            width = medium
        )
        Destination_Email
        (
            type = email
            displayname = "Destination Email"
            row = 2
            column = 2
            width = medium
        )
        Active
        (
            type = checkbox
            displayname = "Active"
            initial value = true
            row = 2
            column = 1
            width = medium
        )

    actions
    {
        on add
        {
            Save
            (
                type = submit
                displayname = "Save Route"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Route"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}