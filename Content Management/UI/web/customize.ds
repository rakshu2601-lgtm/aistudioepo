customize
{
    layout
    {
        theme = "theme_2"
        variant = "variant_2"
    }
    font = "lato"
    color options
    {
        name = "Content Indigo"
        brand color = "#4338CA"
        type = "custom"
        dark mode color = "#818CF8"
    }
    logo
    {
        preference = "app_icon"
        placement = "left"
    }
    custom css
    {
        content = ".zc-app-header{box-shadow:0 1px 0 rgba(15,23,42,.08)} .zc-menu-item:focus-visible{outline:3px solid #93c5fd;outline-offset:2px}"
    }
}