<%
selectedView = ifnull(input.view,"queue").toString().toLowerCase();
if(selectedView != "queue" && selectedView != "pipeline" && selectedView != "overdue" && selectedView != "calendar" && selectedView != "feedback" && selectedView != "completed")
{
    selectedView = "queue";
}
activeCount = Content_Documents[Assigned_Reviewer == zoho.loginuser && (Stage == "Review Under Progress" || Stage == "Feedback Changes Completed")].count();
dueSoonCount = Content_Documents[Assigned_Reviewer == zoho.loginuser && SLA_Status == "Due Soon" && (Stage == "Review Under Progress" || Stage == "Feedback Changes Completed")].count();
overDueCount = Content_Documents[Assigned_Reviewer == zoho.loginuser && (SLA_Status == "Overdue" || SLA_Status == "Breached") && (Stage == "Review Under Progress" || Stage == "Feedback Changes Completed")].count();
completedMonthCount = 0;
completedReviews = Content_Documents[Assigned_Reviewer == zoho.loginuser && (Stage == "Review Completed" || Stage == "Ready for Downstream")];
for each completedReview in completedReviews
{
    if(completedReview.Final_Approved_On != null && completedReview.Final_Approved_On.toString("MM-yyyy") == zoho.currentdate.toString("MM-yyyy"))
    {
        completedMonthCount = completedMonthCount + 1;
    }
}
urgentReviews = Content_Documents[Assigned_Reviewer == zoho.loginuser && (Stage == "Review Under Progress" || Stage == "Feedback Changes Completed")] sort by Due_On asc range from 1 to 5;
%>
<style>
/* zcs-global: page-scoped utility subset used by this workspace */
.rw-workspace{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;--rw-border:var(--zcs_tertiary_border_color);--rw-surface:#fff;--rw-page:#f7f8fc;width:100%;min-height:100%;padding:clamp(12px,2vw,28px);box-sizing:border-box;background:var(--rw-page);color:var(--zcs-primary-text-color);font-family:inherit}
.rw-workspace *{box-sizing:border-box}.rw-workspace a{text-decoration:none}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0;min-width:0}.zcs-no-shrink{flex-shrink:0}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-p-0{padding:0}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mt-20{margin-top:1.25rem}.zcs-mb-0{margin-bottom:0}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-list-none{list-style:none}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-card{background:var(--rw-surface);border:1px solid var(--rw-border);border-radius:12px}
/* horizontal-tab-horizontal-tab-with-icon */
.zcs-horizontal-tabhead{box-shadow:0 -1px 0 var(--rw-border) inset;overflow-x:auto;overflow-y:hidden;-ms-overflow-style:none;scrollbar-width:none}.zcs-horizontal-tabhead::-webkit-scrollbar{display:none}.zcs-horizontal-tabitem{list-style:none;border-bottom:2px solid transparent;letter-spacing:.1px}.zcs-horizontal-tablink{min-height:48px;color:var(--zcs-teritiary-text-color);white-space:nowrap}.zcs-horizontal-tabitem:hover .zcs-horizontal-tablink,.zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tablink{color:var(--zcs_brand_color)}.zcs-horizontal-tabitem.zcs-horizontal-tabactive{border-bottom-color:var(--zcs_brand_color)}
/* badge-badge-with-icon */
.zcs-badge{width:auto;border:1px solid}.zcs-badge-filled-outline.zcs-badge-red{background:#fef2f2;border-color:#dc2626;color:#991b1b}.zcs-badge-filled-outline.zcs-badge-yellow{background:#fffbeb;border-color:#d97706;color:#854d0e}.zcs-badge-filled-outline.zcs-badge-green{background:#ecfdf5;border-color:#059669;color:#065f46}.zcs-badge-filled-outline.zcs-badge-blue{background:#eff6ff;border-color:#2563eb;color:#1e40af}
/* quick-actions-icon-with-text */
.zcs-quick-action-item{list-style:none}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-text{text-decoration:underline}
.rw-header{padding:clamp(20px,3vw,34px);border-radius:18px;background:linear-gradient(125deg,#172554 0%,#3730a3 52%,#2563eb 100%);color:#fff;box-shadow:0 16px 38px rgba(30,41,59,.16)}.rw-header-copy{max-width:800px}.rw-eyebrow{color:#dbeafe;letter-spacing:.08em;text-transform:uppercase}.rw-title{font-size:clamp(1.6rem,3vw,2.3rem);color:#fff}.rw-subtitle{color:#e0e7ff}.rw-header-badge{background:rgba(15,23,42,.28);border:1px solid rgba(255,255,255,.55);color:#fff;white-space:nowrap}.rw-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(150px,1fr));gap:14px;margin-top:18px}.rw-kpi{min-height:126px;padding:18px;color:inherit;box-shadow:0 7px 22px rgba(30,41,59,.05);transition:transform .2s ease,border-color .2s ease}.rw-kpi:hover{transform:translateY(-2px);border-color:var(--zcs_brand_color)}.rw-kpi-icon{width:40px;height:40px;border-radius:11px;background:#eef2ff;color:#4338ca}.rw-kpi-warning .rw-kpi-icon{background:#fffbeb;color:#a16207}.rw-kpi-danger{border-color:#fecaca}.rw-kpi-danger .rw-kpi-icon{background:#fef2f2;color:#b91c1c}.rw-kpi-success .rw-kpi-icon{background:#ecfdf5;color:#047857}.rw-kpi-value{font-size:1.85rem;color:#172554}.rw-tab-card{margin-top:18px;overflow:hidden;box-shadow:0 8px 26px rgba(30,41,59,.05)}.rw-tab-body{padding:clamp(14px,2vw,22px)}.rw-section-heading{font-size:1.1rem}.rw-section-copy{max-width:760px}.rw-priority-list{display:grid;grid-template-columns:repeat(5,minmax(190px,1fr));gap:12px;overflow-x:auto;padding-bottom:4px}.rw-priority-card{min-width:190px;padding:16px;display:flex;flex-direction:column;gap:12px;border-left:4px solid #4f46e5;color:inherit}.rw-priority-card.rw-overdue{border-left-color:#b91c1c;background:#fffafa}.rw-priority-card:hover{border-color:var(--zcs_brand_color);box-shadow:0 8px 20px rgba(30,41,59,.08)}.rw-priority-title{color:var(--zcs-primary-text-color)}.rw-priority-card:hover .rw-priority-title{text-decoration:underline;color:var(--zcs_brand_color)}.rw-priority-meta{color:var(--zcs-secondary-text-color)}.rw-priority-action{color:var(--zcs_brand_color)}.rw-report-shell{width:100%;min-width:0;margin-top:16px;border:1px solid var(--rw-border);border-radius:12px;background:#fff;overflow:hidden}.rw-report-embed{display:block;width:100%!important;min-width:100%;overflow:auto}.rw-report-embed>div{width:100%!important}.rw-sla-banner{border:1px solid #dc2626;background:#fef2f2;color:#7f1d1d;border-radius:10px}.rw-info-banner{border:1px solid #2563eb;background:#eff6ff;color:#1e3a8a;border-radius:10px}.rw-feedback-grid{display:grid;grid-template-columns:1fr;gap:18px}.rw-nodata-wrapper{min-height:250px}.rw-nodata-icon{width:64px;height:64px;border-radius:18px;background:#eef2ff;color:#4338ca}.rw-workspace a:focus-visible{outline:3px solid #60a5fa;outline-offset:3px;border-radius:5px}
@media(max-width:1100px){.rw-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.rw-header{align-items:flex-start;flex-direction:column}.rw-header-badge{white-space:normal}}
@media(max-width:720px){.rw-workspace{padding:10px}.rw-header{border-radius:14px}.rw-tab-body{padding:12px}.rw-kpi-grid{gap:10px}.rw-kpi{min-height:112px;padding:14px}.rw-horizontal-tabtext{font-size:.8125rem}.rw-report-shell{border-radius:8px}.rw-priority-list{grid-template-columns:repeat(5,minmax(240px,84vw))}}
@media(max-width:480px){.rw-kpi-grid{grid-template-columns:1fr 1fr}.rw-kpi-value{font-size:1.55rem}.rw-kpi{min-height:106px}.rw-kpi .zcs-font-14{font-size:.78rem}.rw-title{font-size:1.55rem}}
</style>
<div class='rw-workspace'>
  <header class='rw-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-24'>
    <div class='rw-header-copy'>
      <div class='rw-eyebrow zcs-font-12 zcs-font-semibold zcs-mb-8'>Reviewer Workspace</div>
      <h1 class='rw-title zcs-font-bold zcs-lh-heading zcs-m-0'>Review Workspace</h1>
      <p class='rw-subtitle zcs-font-15 zcs-lh-body zcs-mt-10 zcs-mb-0'>Prioritize assigned reviews, track every stage and due date, open source files or content URLs, and enter the record detail view to run available blueprint transitions.</p>
    </div>
    <% if(overDueCount > 0) { %>
    <a class='rw-header-badge zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-px-16 zcs-py-10 zcs-rounded-lg zcs-font-14 zcs-font-semibold' href='#Page:Review_Workspace?view=overdue' target='_parent'>
      <i class='zc-li-outline ui-3-alert' aria-hidden='true'></i><span><%=overDueCount%> assigned overdue</span><i class='zc-li-outline arrows-1-tail-right' aria-hidden='true'></i>
    </a>
    <% } else { %>
    <div class='rw-header-badge zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-px-16 zcs-py-10 zcs-rounded-lg zcs-font-14 zcs-font-semibold'><i class='zc-li-outline ui-1-check-circle-08' aria-hidden='true'></i><span>Assigned reviews are within SLA</span></div>
    <% } %>
  </header>

  <section class='rw-kpi-grid' aria-label='Review performance summary'>
    <a class='rw-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between' href='#Page:Review_Workspace?view=queue' target='_parent'>
      <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><span class='zcs-font-14 zcs-font-medium zcs-color-secondary'>Assigned Active</span><span class='rw-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-1-eye-17' aria-hidden='true'></i></span></div>
      <strong class='rw-kpi-value zcs-font-bold'><%=activeCount%></strong>
    </a>
    <a class='rw-kpi rw-kpi-warning zcs-card zcs-flex zcs-direction-column zcs-justify-space-between' href='#Page:Review_Workspace?view=queue' target='_parent'>
      <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><span class='zcs-font-14 zcs-font-medium zcs-color-secondary'>Due Soon</span><span class='rw-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-2-time' aria-hidden='true'></i></span></div>
      <strong class='rw-kpi-value zcs-font-bold'><%=dueSoonCount%></strong>
    </a>
    <a class='rw-kpi rw-kpi-danger zcs-card zcs-flex zcs-direction-column zcs-justify-space-between' href='#Page:Review_Workspace?view=overdue' target='_parent'>
      <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><span class='zcs-font-14 zcs-font-medium zcs-color-secondary'>Overdue</span><span class='rw-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-3-alert' aria-hidden='true'></i></span></div>
      <strong class='rw-kpi-value zcs-font-bold'><%=overDueCount%></strong>
    </a>
    <a class='rw-kpi rw-kpi-success zcs-card zcs-flex zcs-direction-column zcs-justify-space-between' href='#Page:Review_Workspace?view=completed' target='_parent'>
      <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><span class='zcs-font-14 zcs-font-medium zcs-color-secondary'>Completed This Month</span><span class='rw-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-1-check-circle-08' aria-hidden='true'></i></span></div>
      <strong class='rw-kpi-value zcs-font-bold'><%=completedMonthCount%></strong>
    </a>
  </section>

  <section class='rw-tab-card zcs-card'>
    <nav aria-label='Review workspace views'>
      <ul class='zcs-horizontal-tabhead zcs-flex zcs-gap-12 zcs-px-10 zcs-py-0 zcs-m-0'>
        <li class='zcs-horizontal-tabitem <%if(selectedView == "queue"){%>zcs-horizontal-tabactive<%}%>'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium' href='#Page:Review_Workspace?view=queue' target='_parent' <%if(selectedView == "queue"){%>aria-current='page'<%}%>><i class='zc-li-outline ui-2-time' aria-hidden='true'></i><span class='rw-horizontal-tabtext zcs-font-15'>My Queue</span></a></li>
        <li class='zcs-horizontal-tabitem <%if(selectedView == "pipeline"){%>zcs-horizontal-tabactive<%}%>'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium' href='#Page:Review_Workspace?view=pipeline' target='_parent' <%if(selectedView == "pipeline"){%>aria-current='page'<%}%>><i class='zc-li-outline design-layout-11' aria-hidden='true'></i><span class='rw-horizontal-tabtext zcs-font-15'>Pipeline</span></a></li>
        <li class='zcs-horizontal-tabitem <%if(selectedView == "overdue"){%>zcs-horizontal-tabactive<%}%>'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium' href='#Page:Review_Workspace?view=overdue' target='_parent' <%if(selectedView == "overdue"){%>aria-current='page'<%}%>><i class='zc-li-outline ui-3-alert' aria-hidden='true'></i><span class='rw-horizontal-tabtext zcs-font-15'>Overdue</span></a></li>
        <li class='zcs-horizontal-tabitem <%if(selectedView == "calendar"){%>zcs-horizontal-tabactive<%}%>'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium' href='#Page:Review_Workspace?view=calendar' target='_parent' <%if(selectedView == "calendar"){%>aria-current='page'<%}%>><i class='zc-li-outline ui-1-calendar-60' aria-hidden='true'></i><span class='rw-horizontal-tabtext zcs-font-15'>Due Calendar</span></a></li>
        <li class='zcs-horizontal-tabitem <%if(selectedView == "feedback"){%>zcs-horizontal-tabactive<%}%>'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium' href='#Page:Review_Workspace?view=feedback' target='_parent' <%if(selectedView == "feedback"){%>aria-current='page'<%}%>><i class='zc-li-outline ui-2-chat-content' aria-hidden='true'></i><span class='rw-horizontal-tabtext zcs-font-15'>Feedback</span></a></li>
        <li class='zcs-horizontal-tabitem <%if(selectedView == "completed"){%>zcs-horizontal-tabactive<%}%>'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium' href='#Page:Review_Workspace?view=completed' target='_parent' <%if(selectedView == "completed"){%>aria-current='page'<%}%>><i class='zc-li-outline ui-1-check-circle-08' aria-hidden='true'></i><span class='rw-horizontal-tabtext zcs-font-15'>Completed</span></a></li>
      </ul>
    </nav>

    <div class='rw-tab-body'>
      <% if(selectedView == "queue") { %>
      <div class='zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-16 zcs-mb-12'>
        <div><h2 class='rw-section-heading zcs-font-semibold zcs-color-primary zcs-m-0'>Prioritized assigned work</h2><p class='rw-section-copy zcs-font-13 zcs-color-secondary zcs-mt-4 zcs-mb-0'>Earliest due work is first. Open a record to review uploads or URLs, inspect feedback, and use the blueprint transition available for its current stage.</p></div>
      </div>
      <% if(activeCount == 0) { %>
      <div class='rw-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'>
        <div class='zcs-p-20'><span class='rw-nodata-icon zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-font-24'><i class='zc-li-outline ui-1-check-circle-08' aria-hidden='true'></i></span><h3 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-12 zcs-mb-0'>Your review queue is clear</h3><p class='zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0'>There are no active documents assigned to you. Check Completed for recent work or Due Calendar for upcoming dates.</p></div>
      </div>
      <% } else { %>
      <div class='rw-priority-list' aria-label='Five earliest assigned reviews'>
        <% for each review in urgentReviews {
             rawTitle = ifnull(review.Document_Title,"Untitled document").toString();
             safeTitle = rawTitle.replaceAll("&","&amp;",true);
             safeTitle = safeTitle.replaceAll("<","&lt;",true);
             safeTitle = safeTitle.replaceAll(">","&gt;",true);
             safeTitle = safeTitle.replaceAll("\"","&quot;",true);
             safeTitle = safeTitle.replaceAll("'","&#39;",true);
             rawStage = ifnull(review.Stage,"Review Under Progress").toString();
             safeStage = rawStage.replaceAll("&","&amp;",true);
             safeStage = safeStage.replaceAll("<","&lt;",true);
             safeStage = safeStage.replaceAll(">","&gt;",true);
             safeStage = safeStage.replaceAll("\"","&quot;",true);
             safeStage = safeStage.replaceAll("'","&#39;",true);
             slaText = ifnull(review.SLA_Status,"On Track").toString();
             slaClass = "zcs-badge-blue";
             slaIcon = "ui-2-time";
             overdueClass = "";
             if(slaText == "Due Soon") { slaClass = "zcs-badge-yellow"; }
             if(slaText == "Overdue" || slaText == "Breached") { slaClass = "zcs-badge-red"; slaIcon = "ui-3-alert"; overdueClass = "rw-overdue"; }
             dueText = "No due date";
             if(review.Due_On != null) { dueText = review.Due_On.toString("dd MMM yyyy, hh:mm a"); }
             recordUrl = "#Report:All_Content_Documents?recLinkID=" + review.ID + "&viewLinkName=All_Content_Documents";
        %>
        <a class='rw-priority-card <%=overdueClass%> zcs-card' href='<%=recordUrl%>' target='_parent' aria-label='Open <%=safeTitle%> detail and blueprint transitions'>
          <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-sm zcs-px-10 zcs-py-2 <%=slaClass%>'><i class='zc-li-outline <%=slaIcon%>' aria-hidden='true'></i><span class='zcs-font-11 zcs-font-semibold'><%=slaText%></span></span><i class='zc-li-outline arrows-1-tail-right' aria-hidden='true'></i></div>
          <strong class='rw-priority-title zcs-font-15 zcs-font-semibold'><%=safeTitle%></strong>
          <div class='rw-priority-meta zcs-font-12'><i class='zc-li-outline ui-1-calendar-60' aria-hidden='true'></i> <%=dueText%></div>
          <div class='rw-priority-meta zcs-font-12'><i class='zc-li-outline loader-dots-06' aria-hidden='true'></i> <%=safeStage%></div>
          <span class='rw-priority-action zcs-font-12 zcs-font-semibold'>Open review and transitions</span>
        </a>
        <% } %>
      </div>
      <% } %>
      <div class='rw-report-shell'><div class='rw-report-embed' zc-component='report' zc-linkname='My_Reviews' zc-height='720px'></div></div>

      <% } else if(selectedView == "pipeline") { %>
      <h2 class='rw-section-heading zcs-font-semibold zcs-color-primary zcs-m-0'>Review pipeline</h2><p class='rw-section-copy zcs-font-13 zcs-color-secondary zcs-mt-4 zcs-mb-0'>Track assigned content by stage. Selecting a card opens its record detail, preserving blueprint actions and content assets.</p>
      <div class='rw-report-shell'><div class='rw-report-embed' zc-component='report' zc-linkname='Review_Pipeline' zc-criteria='Assigned_Reviewer == zoho.loginuser' zc-height='760px'></div></div>

      <% } else if(selectedView == "overdue") { %>
      <div class='rw-sla-banner zcs-flex zcs-align-items-center zcs-gap-12 zcs-px-16 zcs-py-12' role='status'><i class='zc-li-outline ui-3-alert zcs-font-20' aria-hidden='true'></i><div><strong class='zcs-font-15'><%=overDueCount%> assigned review<%if(overDueCount != 1){%>s<%}%> past SLA</strong><p class='zcs-font-13 zcs-mt-4 zcs-mb-0'>Open the most urgent record and complete the appropriate blueprint transition. Red SLA styling is paired with text and icons for accessibility.</p></div></div>
      <% if(overDueCount == 0) { %><div class='rw-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><span class='rw-nodata-icon zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-font-24'><i class='zc-li-outline ui-1-check-circle-08' aria-hidden='true'></i></span><h3 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-12 zcs-mb-0'>No overdue reviews</h3><p class='zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0'>All currently assigned reviews are within their SLA.</p></div></div><% } %>
      <div class='rw-report-shell'><div class='rw-report-embed' zc-component='report' zc-linkname='Overdue_Reviews' zc-criteria='Assigned_Reviewer == zoho.loginuser' zc-height='720px'></div></div>

      <% } else if(selectedView == "calendar") { %>
      <h2 class='rw-section-heading zcs-font-semibold zcs-color-primary zcs-m-0'>Due calendar</h2><p class='rw-section-copy zcs-font-13 zcs-color-secondary zcs-mt-4 zcs-mb-0'>Plan work by due date. Calendar events open the underlying content record and its files, URL, feedback, and transitions.</p>
      <div class='rw-report-shell'><div class='rw-report-embed' zc-component='report' zc-linkname='Content_Due_Calendar' zc-criteria='Assigned_Reviewer == zoho.loginuser' zc-height='760px'></div></div>

      <% } else if(selectedView == "feedback") { %>
      <div class='rw-info-banner zcs-flex zcs-align-items-center zcs-gap-12 zcs-px-16 zcs-py-12'><i class='zc-li-outline ui-2-chat-content zcs-font-20' aria-hidden='true'></i><div><strong class='zcs-font-15'>Feedback assigned to <%=zoho.loginuser%></strong><p class='zcs-font-13 zcs-mt-4 zcs-mb-0'>Open feedback appears first; the full history remains available below for review-cycle context and reference files.</p></div></div>
      <div class='rw-feedback-grid'>
        <div><h2 class='rw-section-heading zcs-font-semibold zcs-color-primary zcs-mt-20 zcs-mb-0'>Open feedback</h2><div class='rw-report-shell'><div class='rw-report-embed' zc-component='report' zc-linkname='Open_Feedback' zc-criteria='Reviewer_User == zoho.loginuser' zc-height='620px'></div></div></div>
        <div><h2 class='rw-section-heading zcs-font-semibold zcs-color-primary zcs-m-0'>All feedback history</h2><div class='rw-report-shell'><div class='rw-report-embed' zc-component='report' zc-linkname='All_Feedback' zc-criteria='Reviewer_User == zoho.loginuser' zc-height='620px'></div></div></div>
      </div>

      <% } else { %>
      <h2 class='rw-section-heading zcs-font-semibold zcs-color-primary zcs-m-0'>Completed reviews</h2><p class='rw-section-copy zcs-font-13 zcs-color-secondary zcs-mt-4 zcs-mb-0'>Documents assigned to you that reached Review Completed or Ready for Downstream. Open any record for its full blueprint history and assets.</p>
      <% if(completedReviews.count() == 0) { %><div class='rw-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><span class='rw-nodata-icon zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-font-24'><i class='zc-li-outline files-2-doc' aria-hidden='true'></i></span><h3 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-12 zcs-mb-0'>No completed reviews yet</h3><p class='zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0'>Completed and downstream-ready documents assigned to you will appear here.</p></div></div><% } %>
      <div class='rw-report-shell'><div class='rw-report-embed' zc-component='report' zc-linkname='All_Content_Documents' zc-criteria='Assigned_Reviewer == zoho.loginuser &amp;&amp; (Stage == &quot;Review Completed&quot; || Stage == &quot;Ready for Downstream&quot;)' zc-height='720px'></div></div>
      <% } %>
    </div>
  </section>
</div>