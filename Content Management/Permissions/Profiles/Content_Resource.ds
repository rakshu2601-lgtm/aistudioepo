"Content Resource"
{
    name = "Content Resource"
    type = Users_Permissions
    permissions = {Chat:true,Predefined:false,ApiAccess:false,PIIAccess:false,ePHIAccess:false}
    description = "Creates and maintains owned content, submits it for review, responds to feedback, and routes approved content."

    ModulePermissions
    {
        Products
        {
            enabled = Viewall,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Products={"View"}
            }
        }
        Session_Types
        {
            enabled = Viewall,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Session_Types={"View"}
            }
        }
        Document_Types
        {
            enabled = Viewall,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Document_Types={"View"}
            }
        }
        Team_Members
        {
            enabled = Viewall,View,Search
            allFieldsVisible = false
            ReportPermissions
            {
                All_Team_Members={"View"}
                Active_Reviewers={"View"}
            }
            FieldPermissions
            {
                Member_User{visibility:true,readonly:true}
                Email{visibility:true,readonly:true}
                Display_Name{visibility:true,readonly:true}
                Member_Roles{visibility:true,readonly:true}
                Product_Coverage{visibility:true,readonly:true}
                Reviewer_Capacity{visibility:false}
                Active{visibility:true,readonly:true}
            }
        }
        Holidays
        {
            enabled = Viewall,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Holidays={"View"}
                Holiday_Calendar={"View"}
            }
        }
        Downstream_Routes
        {
            enabled = Viewall,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Downstream_Routes={"View"}
            }
        }
        SLA_Policies
        {
            enabled = Viewall,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_SLA_Policies={"View"}
            }
        }
        Sessions
        {
            enabled = Create,Viewall,View,Edit,Search,read_comm,write_comm
            allFieldsVisible = true
            ReportPermissions
            {
                All_Sessions={"View","Edit"}
                Session_Calendar={"View","Edit"}
            }
        }
        Content_Documents
        {
            enabled = Create,View,Edit,Search,read_comm,write_comm
            allFieldsVisible = false
            ReportPermissions
            {
                My_Submissions={"View","Edit"}
                Review_Pipeline={"View"}
                Content_Due_Calendar={"View"}
            }
            FieldPermissions
            {
                Document_ID{visibility:true,readonly:true}
                Document_Title{visibility:true,readonly:false}
                Session{visibility:true,readonly:false}
                Product{visibility:true,readonly:true}
                Document_Type{visibility:true,readonly:false}
                Version_Label{visibility:true,readonly:false}
                Source_Files{visibility:true,readonly:false}
                Content_URL{visibility:true,readonly:false}
                Resource_User{visibility:true,readonly:false}
                Assignment_Mode{visibility:true,readonly:false}
                Assigned_Reviewer{visibility:true,readonly:false}
                Stage{visibility:true,readonly:true}
                Selected_SLA_Policy{visibility:true,readonly:true}
                Applied_SLA_Business_Days{visibility:true,readonly:true}
                Review_Cycle_Number{visibility:true,readonly:true}
                Review_Cycle_Type{visibility:true,readonly:true}
                Submitted_On{visibility:true,readonly:true}
                Due_On{visibility:true,readonly:true}
                Due_Soon_Reminder_On{visibility:true,readonly:true}
                SLA_Status{visibility:true,readonly:true}
                Review_Summary{visibility:true,readonly:true}
                Review_Attachment{visibility:true,readonly:true}
                Resource_Response{visibility:true,readonly:false}
                Final_Reviewer_Comments{visibility:true,readonly:true}
                Downstream_Route{visibility:true,readonly:false}
                Handoff_Notes{visibility:true,readonly:false}
                Final_Approved_On{visibility:true,readonly:true}
                Routed_On{visibility:true,readonly:true}
                Last_Status_Changed_On{visibility:true,readonly:true}
            }
        }
        Review_Feedback
        {
            enabled = Viewall,View,Edit,Search
            allFieldsVisible = false
            ReportPermissions
            {
                Open_Feedback={"View","Edit"}
            }
            FieldPermissions
            {
                Feedback_ID{visibility:true,readonly:true}
                Document{visibility:true,readonly:true}
                Review_Cycle_Number{visibility:true,readonly:true}
                Reviewer_User{visibility:true,readonly:true}
                Feedback_Category{visibility:true,readonly:true}
                Feedback_Comments{visibility:true,readonly:true}
                Reference_File{visibility:true,readonly:true}
                Feedback_Status{visibility:true,readonly:false}
                Resource_Response{visibility:true,readonly:false}
                Addressed_On{visibility:true,readonly:true}
                Closed_On{visibility:true,readonly:true}
            }
        }
        Content_Hub_Home
        {
            enabled = tab
        }
        Submission_Workspace
        {
            enabled = tab
        }
    }
}