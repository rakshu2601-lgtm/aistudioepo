			Advance_Challenge_Phase as "Advance Challenge Phase"
			{
			    type = functions
			    form = Challenge_Settings
			    execution type = for each record
			    description = "Safely advances the current challenge by one phase for administrators and judges."
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                is_authorized = false;
			                current_profile = thisapp.permissions.loginUserProfile();
			                if(current_profile == "Administrator" || current_profile == "Judge")
			                {
			                    is_authorized = true;
			                }
			                if(is_authorized == false)
			                {
			                    phase_result_message = "Only authorized administrators or judges may advance the challenge phase.";
			                }
			                else if(input.Current_Record != true)
			                {
			                    phase_result_message = "Only the current Challenge Settings record may be advanced.";
			                }
			                else if(input.Challenge_Status == "Results Published")
			                {
			                    phase_result_message = "Results Published is the final challenge phase.";
			                }
			                else if(Members[Is_Active == true && (Login_Email == null || Login_Email == "")].count() > 0)
			                {
			                    phase_result_message = "Map a login email for every active participant and judge before advancing the phase.";
			                }
			                else
			                {
			                    previous_status = input.Challenge_Status;
			                    next_status = "";
			                    if(previous_status == "Setup")
			                    {
			                        next_status = "Submission Open";
			                    }
			                    else if(previous_status == "Submission Open")
			                    {
			                        next_status = "Voting Open";
			                    }
			                    else if(previous_status == "Voting Open")
			                    {
			                        next_status = "Judging Open";
			                    }
			                    else if(previous_status == "Judging Open")
			                    {
			                        next_status = "Finalization";
			                    }
			                    else if(previous_status == "Finalization")
			                    {
			                        next_status = "Results Published";
			                    }
			                    if(next_status == "")
			                    {
			                        phase_result_message = "The current phase cannot be advanced.";
			                    }
			                    else
			                    {
			                        input.Challenge_Status = next_status;
			                        if(next_status == "Results Published")
			                        {
			                            input.Results_Visible_To_Participants = true;
			                        }
			                        insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.loginuser
			                            Event_Type = "Phase Change"
			                            Related_Form = "Challenge_Settings"
			                            Related_Record_ID = input.ID.toString()
			                            Event_Summary = "Challenge phase advanced from " + previous_status + " to " + next_status
			                            Before_Value = previous_status
			                            After_Value = next_status
			                            Severity = "Info"
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

			Bootstrap_Challenge_Roster as "Bootstrap Challenge Roster"
			{
			    type = form
			    form = Challenge_Settings
			    record event = on add
			    description = "Creates the approved initial participant and judge roster once when Members is empty."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Bootstrap_Roster == true && Members[ID != 0].count() == 0)
			                {
			                    participant_names = {"Surjil","Cedrick","Ilavarasi","Gokul","Vamsi","Silvanose","Lavanya","Derek","Richerd"};
			                    display_order = 1;
			                    for each participant_name in participant_names
			                    {
			                        insert into Members
			                        [
			                            Member_Name = participant_name
			                            Member_Type = "Participant"
			                            Is_Active = true
			                            Display_Order = display_order
			                        ];
			                        display_order = display_order + 1;
			                    }
			                    judge_names = {"Siddarth","Monica","Brandon"};
			                    for each judge_name in judge_names
			                    {
			                        insert into Members
			                        [
			                            Member_Name = judge_name
			                            Member_Type = "Judge"
			                            Is_Active = true
			                            Display_Order = display_order
			                        ];
			                        display_order = display_order + 1;
			                    }
			                }
			            )
			        }
			    }
			}

			Validate_Challenge_Phase_Transition as "Validate Challenge Phase Transition"
			{
			    type = form
			    form = Challenge_Settings
			    record event = on edit
			    description = "Enforces roster readiness and expected forward-only phase transitions."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(old.Challenge_Status != input.Challenge_Status)
			                {
			                    expected_status = "";
			                    if(old.Challenge_Status == "Setup")
			                    {
			                        expected_status = "Submission Open";
			                    }
			                    else if(old.Challenge_Status == "Submission Open")
			                    {
			                        expected_status = "Voting Open";
			                    }
			                    else if(old.Challenge_Status == "Voting Open")
			                    {
			                        expected_status = "Judging Open";
			                    }
			                    else if(old.Challenge_Status == "Judging Open")
			                    {
			                        expected_status = "Finalization";
			                    }
			                    else if(old.Challenge_Status == "Finalization")
			                    {
			                        expected_status = "Results Published";
			                    }
			                    if(input.Challenge_Status != expected_status)
			                    {
			                        alert "Challenge phases may only move forward by one expected phase.";
			                        cancel submit;
			                    }
			                    if(Members[Is_Active == true && (Login_Email == null || Login_Email == "")].count() > 0)
			                    {
			                        alert "Map a login email for every active participant and judge before changing phase.";
			                        cancel submit;
			                    }
			                    if(input.Challenge_Status == "Results Published")
			                    {
			                        input.Results_Visible_To_Participants = true;
			                    }
			                    insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuser
			                        Event_Type = "Phase Change"
			                        Related_Form = "Challenge_Settings"
			                        Related_Record_ID = input.ID.toString()
			                        Event_Summary = "Challenge phase changed from " + old.Challenge_Status + " to " + input.Challenge_Status
			                        Before_Value = old.Challenge_Status
			                        After_Value = input.Challenge_Status
			                        Severity = "Info"
			                    ];
			                }
			            )
			        }
			    }
			}

			Validate_Challenge_Settings as "Validate Challenge Settings"
			{
			    type = form
			    form = Challenge_Settings
			    record event = on add or edit
			    description = "Enforces a single current settings record, chronological windows, roster readiness, and forward-only phase transitions."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Current_Record == true && Challenge_Settings[Current_Record == true && ID != input.ID].count() > 0)
			                {
			                    alert "Only one Challenge Settings record can be marked current.";
			                    cancel submit;
			                }
			                if(input.Challenge_Start >= input.Challenge_End)
			                {
			                    alert "Challenge End must be after Challenge Start.";
			                    cancel submit;
			                }
			                if(input.Challenge_End > input.Voting_Opens)
			                {
			                    alert "Voting Opens must be on or after Challenge End.";
			                    cancel submit;
			                }
			                if(input.Voting_Opens >= input.Voting_Closes)
			                {
			                    alert "Voting Closes must be after Voting Opens.";
			                    cancel submit;
			                }
			                if(input.Voting_Closes > input.Judging_Closes)
			                {
			                    alert "Judging Closes must be on or after Voting Closes.";
			                    cancel submit;
			                }
			                if(input.Showcase_Date_Time != null && input.Showcase_Date_Time < input.Judging_Closes)
			                {
			                    alert "Showcase Date Time must be on or after Judging Closes.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Process_Final_Approval as "Process Final Approval"
			{
			    type = form
			    form = Final_Approvals
			    record event = on add
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                ranking_records = Final_Rankings[ID == input.Final_Ranking && Decision_Status == "Pending Consensus"];
			                audit_severity = "Info";
			                if(input.Decision == "Request Changes")
			                {
			                    audit_severity = "Warning";
			                }
			                insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuser
			                    Event_Type = "Approval"
			                    Related_Form = "Final_Approvals"
			                    Related_Record_ID = input.ID.toString()
			                    Event_Summary = input.Judge.Member_Name + " recorded " + input.Decision + " for final ranking version " + input.Final_Ranking.Ranking_Version
			                    Before_Value = "Pending Consensus"
			                    After_Value = input.Decision + ": " + input.Approval_Comment
			                    Severity = audit_severity
			                ];
			                if(ranking_records.count() == 1 && input.Decision == "Request Changes")
			                {
			                    update Final_Rankings[ID == input.Final_Ranking]
			                    [
			                        Decision_Status = "Draft"
			                        Published_At = null
			                    ];
			                }
			                else if(ranking_records.count() == 1 && input.Decision == "Approve")
			                {
			                    siddarth = Members[Member_Name == "Siddarth" && Member_Type == "Judge" && Is_Active == true];
			                    monica = Members[Member_Name == "Monica" && Member_Type == "Judge" && Is_Active == true];
			                    brandon = Members[Member_Name == "Brandon" && Member_Type == "Judge" && Is_Active == true];
			                    active_named_count = Members[Member_Type == "Judge" && Is_Active == true && (Member_Name == "Siddarth" || Member_Name == "Monica" || Member_Name == "Brandon")].count();
			                    siddarth_approved = 0;
			                    monica_approved = 0;
			                    brandon_approved = 0;
			                    if(siddarth.count() == 1)
			                    {
			                        siddarth_approved = Final_Approvals[Final_Ranking == input.Final_Ranking && Judge == siddarth.ID && Decision == "Approve"].count();
			                    }
			                    if(monica.count() == 1)
			                    {
			                        monica_approved = Final_Approvals[Final_Ranking == input.Final_Ranking && Judge == monica.ID && Decision == "Approve"].count();
			                    }
			                    if(brandon.count() == 1)
			                    {
			                        brandon_approved = Final_Approvals[Final_Ranking == input.Final_Ranking && Judge == brandon.ID && Decision == "Approve"].count();
			                    }
			                    distinct_approvers = Final_Approvals[Final_Ranking == input.Final_Ranking && Decision == "Approve"].distinct(Judge);
			                    if(active_named_count == 3 && siddarth.count() == 1 && monica.count() == 1 && brandon.count() == 1 && siddarth_approved == 1 && monica_approved == 1 && brandon_approved == 1 && distinct_approvers.size() == 3)
			                    {
			                        publish_time = zoho.currenttime;
			                        update Final_Rankings[ID == input.Final_Ranking]
			                        [
			                            Decision_Status = "Published"
			                            Published_At = publish_time
			                        ];
			                        current_settings = Challenge_Settings[Current_Record == true];
			                        if(current_settings.count() == 1)
			                        {
			                            update Challenge_Settings[ID == current_settings.ID]
			                            [
			                                Results_Visible_To_Participants = true
			                            ];
			                        }
			                        insert into Audit_Log
			                        [
			                            Event_Time = publish_time
			                            Actor_Email = zoho.loginuser
			                            Event_Type = "Publication"
			                            Related_Form = "Final_Rankings"
			                            Related_Record_ID = input.Final_Ranking.toString()
			                            Event_Summary = "Final ranking version " + input.Final_Ranking.Ranking_Version + " published after unanimous approval by Siddarth, Monica, and Brandon."
			                            Before_Value = "Pending Consensus"
			                            After_Value = "Published"
			                            Severity = "Critical"
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

			Resolve_Approval_Judge as "Resolve and Lock Approval Judge"
			{
			    type = form
			    form = Final_Approvals
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                judge_records = Members[Login_Email == zoho.loginuser && Member_Type == "Judge" && Is_Active == true && (Member_Name == "Siddarth" || Member_Name == "Monica" || Member_Name == "Brandon")];
			                if(judge_records.count() == 1)
			                {
			                    if(input.Judge == null)
			                    {
			                        input.Judge = judge_records.ID;
			                        input.Judge_Email = zoho.loginuser;
			                    }
			                    if(input.Judge != judge_records.ID || input.Judge_Email != zoho.loginuser)
			                    {
			                        alert "You cannot view or edit another judge's approval through this form.";
			                        disable Final_Ranking;
			                        disable Decision;
			                        disable Approval_Comment;
			                    }
			                }
			                else
			                {
			                    alert "No single active named consensus judge is mapped to your login.";
			                    disable Final_Ranking;
			                    disable Decision;
			                    disable Approval_Comment;
			                }
			                disable Judge;
			                disable Judge_Email;
			                disable Decided_At;
			            )
			        }
			    }
			}

			Validate_Final_Approval as "Validate Final Approval"
			{
			    type = form
			    form = Final_Approvals
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                judge_records = Members[Login_Email == zoho.loginuser && Member_Type == "Judge" && Is_Active == true && (Member_Name == "Siddarth" || Member_Name == "Monica" || Member_Name == "Brandon")];
			                if(judge_records.count() != 1 || input.Judge != judge_records.ID || input.Judge_Email != zoho.loginuser)
			                {
			                    alert "Approval identity must match one active mapped named judge and the logged-in user.";
			                    cancel submit;
			                }
			                ranking_records = Final_Rankings[ID == input.Final_Ranking && Decision_Status == "Pending Consensus"];
			                if(ranking_records.count() != 1)
			                {
			                    alert "The referenced ranking must be the unchanged version currently Pending Consensus.";
			                    cancel submit;
			                }
			                duplicate_count = Final_Approvals[Judge == input.Judge && Final_Ranking == input.Final_Ranking && ID != input.ID].count();
			                if(duplicate_count > 0)
			                {
			                    alert "This judge has already recorded a decision for this ranking version.";
			                    cancel submit;
			                }
			                if(input.Approval_Comment == null || input.Approval_Comment.trim() == "")
			                {
			                    alert "Provide an approval comment documenting your independent decision.";
			                    cancel submit;
			                }
			                input.Decided_At = zoho.currenttime;
			            )
			        }
			    }
			}

			Prepare_Final_Ranking as "Prepare Final Ranking"
			{
			    type = form
			    form = Final_Rankings
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.ID == null)
			                {
			                    input.Drafted_By = zoho.loginuser;
			                    input.Drafted_At = zoho.currenttime;
			                    input.Decision_Status = "Draft";
			                    input.Is_Current = true;
			                    disable Drafted_By;
			                    disable Drafted_At;
			                    disable Published_At;
			                }
			                else if(input.Decision_Status == "Published")
			                {
			                    disable Drafted_By;
			                    disable Drafted_At;
			                    disable Rank_1;
			                    disable Rank_2;
			                    disable Rank_3;
			                    disable Rank_4;
			                    disable Rank_5;
			                    disable Rank_6;
			                    disable Rank_7;
			                    disable Rank_8;
			                    disable Rank_9;
			                    disable Winner_Rationale;
			                    disable Ranking_Rationale;
			                    disable Decision_Status;
			                    disable Based_On_AI_Analysis;
			                    disable Published_At;
			                    disable Is_Current;
			                }
			                else
			                {
			                    disable Drafted_By;
			                    disable Drafted_At;
			                    disable Published_At;
			                }
			            )
			        }
			    }
			}

			Process_Final_Ranking as "Process Final Ranking Consensus"
			{
			    type = form
			    form = Final_Rankings
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_ranking = Final_Rankings[ID == input.ID];
			                current_ranking.Is_Current = true;
			                if(input.Decision_Status == "Pending Consensus")
			                {
			                    older_rankings = Final_Rankings[ID != input.ID && (Decision_Status == "Draft" || Decision_Status == "Pending Consensus")];
			                    for each older_ranking in older_rankings
			                    {
			                        older_ranking.Decision_Status = "Superseded";
			                        older_ranking.Is_Current = false;
			                        delete from Final_Approvals[Final_Ranking == older_ranking.ID];
			                    }
			                    delete from Final_Approvals[Final_Ranking == input.ID];
			                }
			                else if(input.Decision_Status == "Draft")
			                {
			                    delete from Final_Approvals[Final_Ranking == input.ID];
			                }
			            )
			        }
			    }
			}

			Validate_Final_Ranking as "Validate Final Ranking"
			{
			    type = form
			    form = Final_Rankings
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                judge = Members[Login_Email == zoho.loginuser && Member_Type == "Judge" && Is_Active == true];
			                if(judge.count() != 1 || input.Drafted_By != zoho.loginuser)
			                {
			                    alert "Only an active judge using their mapped login identity may draft a final ranking.";
			                    cancel submit;
			                }
			                if(input.ID == null && input.Decision_Status == "Published")
			                {
			                    alert "A ranking cannot be published directly. Unanimous approval is required.";
			                    cancel submit;
			                }
			                if(input.ID != null)
			                {
			                    prior_ranking = Final_Rankings[ID == input.ID];
			                    if(prior_ranking.count() == 1 && input.Decision_Status == "Published" && prior_ranking.Decision_Status != "Published")
			                    {
			                        alert "A ranking cannot be published directly. Publication is controlled by unanimous approvals.";
			                        cancel submit;
			                    }
			                    if(prior_ranking.count() == 1 && prior_ranking.Decision_Status == "Published")
			                    {
			                        alert "Published rankings are immutable.";
			                        cancel submit;
			                    }
			                    if(prior_ranking.count() == 1 && prior_ranking.Decision_Status == "Pending Consensus")
			                    {
			                        input.Decision_Status = "Draft";
			                    }
			                }
			                ranked_apps = List();
			                ranked_apps.add(input.Rank_1);
			                ranked_apps.add(input.Rank_2);
			                ranked_apps.add(input.Rank_3);
			                ranked_apps.add(input.Rank_4);
			                ranked_apps.add(input.Rank_5);
			                ranked_apps.add(input.Rank_6);
			                ranked_apps.add(input.Rank_7);
			                ranked_apps.add(input.Rank_8);
			                ranked_apps.add(input.Rank_9);
			                unique_apps = ranked_apps.distinct();
			                if(ranked_apps.size() != 9 || unique_apps.size() != 9)
			                {
			                    alert "Rank all nine applications exactly once; duplicate ranks are not allowed.";
			                    cancel submit;
			                }
			                submitted_apps = Applications[Submission_Status == "Submitted" || Submission_Status == "Locked"];
			                if(submitted_apps.count() != 9)
			                {
			                    alert "Finalization requires exactly nine submitted or locked applications.";
			                    cancel submit;
			                }
			                for each submitted_app in submitted_apps
			                {
			                    if(!ranked_apps.contains(submitted_app.ID))
			                    {
			                        alert "The ranking must cover the complete submitted application field exactly once.";
			                        cancel submit;
			                    }
			                }
			                input.Is_Current = true;
			                if(input.Drafted_At == null)
			                {
			                    input.Drafted_At = zoho.currenttime;
			                }
			            )
			        }
			    }
			}

			Finalize_Judge_Evaluation as "Finalize Judge Evaluation Total"
			{
			    type = form
			    form = Judge_Evaluations
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Weighted_Total = input.UI_Score * 1.5 + input.Navigation_Usability_Score * 1.5 + input.Core_Functionality_Score * 2 + input.Innovation_Score * 1.5 + input.Beyond_Creator_Proof_Score * 2 + input.Catalyst_Integrations_Score + input.Presentation_Score * 0.5;
			                if(input.Evaluation_Status == "Submitted" && input.Submitted_At == null)
			                {
			                    input.Submitted_At = zoho.currenttime;
			                }
			            )
			        }
			    }
			}

