	pages
	{
		page Judge_Command_Center
		{
					displayname = "Judge Command Center"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Command_Center' elementName='Command_Center'>\n\t\t\t\t\t<![CDATA[htmlpage Command_Center()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nsettings = Challenge_Settings[Current_Record == true];\nsubmittedApps = Applications[Submission_Status == &quot;Submitted&quot; || Submission_Status == &quot;Locked&quot;];\nsubmittedCount = submittedApps.count();\nballotCount = Participant_Ballots[Ballot_Status == &quot;Submitted&quot; || Ballot_Status == &quot;Locked&quot;].count();\nactiveParticipantCount = Members[Member_Type == &quot;Participant&quot; &amp;&amp; Is_Active == true].count();\nactiveJudgeCount = Members[Member_Type == &quot;Judge&quot; &amp;&amp; Is_Active == true].count();\nevaluationCount = Judge_Evaluations[Evaluation_Status == &quot;Submitted&quot; || Evaluation_Status == &quot;Locked&quot;].count();\nexpectedEvaluations = submittedCount * activeJudgeCount;\ncurrentJudge = Members[Member_Type == &quot;Judge&quot; &amp;&amp; Is_Active == true &amp;&amp; Login_Email == zoho.loginuser];\nmyEvaluationCount = Judge_Evaluations[(Evaluation_Status == &quot;Submitted&quot; || Evaluation_Status == &quot;Locked&quot;) &amp;&amp; Judge_Email == zoho.loginuser].count();\ncurrentRanking = Final_Rankings[Is_Current == true &amp;&amp; Decision_Status == &quot;Pending Consensus&quot;];\napprovalCount = 0;\nif(currentRanking.count() &gt; 0)\n{\n\tapprovalCount = Final_Approvals[Final_Ranking == currentRanking.ID &amp;&amp; Decision == &quot;Approve&quot;].count();\n}\naiConfig = AI_Settings[Is_Current == true];\nlatestAnalysis = AI_Analyses[Is_Latest == true];\nphase = &quot;Setup&quot;;\nchallengeTitle = &quot;Om.ai Beyond Limits Challenge&quot;;\ndeadlineText = &quot;Schedule pending&quot;;\nif(settings.count() &gt; 0)\n{\n\tphase = settings.Challenge_Status;\n\tchallengeTitle = settings.Challenge_Title;\n\tdeadlineText = settings.Judging_Closes.toString(&quot;dd MMM yyyy, hh:mm a&quot;);\n}\nballotReady = ballotCount == activeParticipantCount &amp;&amp; activeParticipantCount &gt; 0;\nevaluationsReady = evaluationCount == expectedEvaluations &amp;&amp; expectedEvaluations &gt; 0;\nanalysisReady = ballotReady &amp;&amp; evaluationsReady;\n%&gt;\n&lt;style&gt;\n/* zcs-global utility sheet, scoped page essentials */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff}.zcs-flex{display:flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-p-16{padding:1rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-md{border-radius:.375rem}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:14px}.zcs-button{min-height:36px;text-decoration:none}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}\n.jcc{font-family:Inter,Arial,sans-serif;color:var(--zcs_primary_text_color);background:linear-gradient(180deg,#080b21 0,#11183b 330px,#f4f6fb 330px);padding:24px;min-height:100vh;box-sizing:border-box}.hero{position:relative;overflow:hidden;color:#fff;padding:32px;border:1px solid rgba(255,255,255,.16);border-radius:24px;background:radial-gradient(circle at 85% 15%,rgba(90,224,255,.32),transparent 30%),linear-gradient(125deg,#202a78,#7135a8 55%,#087f8c);box-shadow:0 24px 60px rgba(2,8,35,.35)}.hero:after{content:&quot;&quot;;position:absolute;width:260px;height:260px;border:1px solid rgba(255,255,255,.18);border-radius:50%;right:-70px;top:-100px;animation:orbit 10s linear infinite}.eyebrow{letter-spacing:.14em;text-transform:uppercase;font-size:12px;font-weight:700;opacity:.82}.hero h1{font-size:clamp(28px,4vw,52px);line-height:1.03;margin:10px 0}.hero-meta{display:flex;gap:12px;flex-wrap:wrap;margin-top:20px}.glass{padding:10px 14px;border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.12);border-radius:12px;backdrop-filter:blur(8px)}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.actions .zcs-button{padding:9px 14px;border-radius:9px}.actions .light{background:#fff;color:#242d74}.actions .ghost{color:#fff;border:1px solid rgba(255,255,255,.45)}.kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:18px 0}.kpi{padding:18px;box-shadow:0 10px 30px rgba(19,31,71,.12)}.kpi .icon{width:38px;height:38px;border-radius:10px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color)}.value{font-size:28px;font-weight:750;margin-top:12px}.label{font-size:13px;color:var(--zcs_secondary_text_color)}.section-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.85fr);gap:16px;margin-top:16px}.panel{padding:20px;box-shadow:0 8px 24px rgba(26,38,78,.08)}.panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:16px}.panel h2{font-size:19px;margin:0}.muted{color:var(--zcs_secondary_text_color);font-size:13px}.zcs-table-wrapper{overflow:auto;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px}.zcs-table-wrapper table{width:100%;border-collapse:collapse;min-width:660px}.zcs-table-wrapper th,.zcs-table-wrapper td{padding:11px 12px;border-bottom:1px solid var(--zcs_tertiary_border_color);text-align:left;font-size:13px}.zcs-table-wrapper th{background:#f7f8fc;font-weight:650}.meter{height:8px;background:#e8ebf4;border-radius:99px;overflow:hidden}.meter&gt;span{display:block;height:100%;background:linear-gradient(90deg,var(--zcs_brand_color),#14b8a6);border-radius:inherit}.judge-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.judge-card{padding:14px;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.judge-name{font-weight:650}.status{display:inline-flex;align-items:center;gap:6px;font-size:12px;border-radius:99px;padding:4px 8px}.ok{background:#e8f8f1;color:#08734e}.warn{background:#fff4dd;color:#875100}.bad{background:#feeceb;color:#a42b28}.category-row{display:grid;grid-template-columns:150px 1fr 48px;gap:10px;align-items:center;margin:12px 0;font-size:13px}.prediction-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.prediction{padding:16px;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;background:linear-gradient(145deg,#fff,#f6f7ff)}.prediction h3{font-size:14px;color:var(--zcs_secondary_text_color);margin:0 0 8px}.winner{font-size:20px;font-weight:700}.feed{display:grid;gap:10px}.feed-item{padding:12px;border-left:3px solid var(--zcs_brand_color);background:#f8f9fd;border-radius:0 10px 10px 0}.warning{border:1px solid #e0a32e;background:#fff8e8;color:#694600;padding:13px;border-radius:10px;display:flex;gap:9px;margin-bottom:10px}.error{border-color:#da5a52;background:#fff0ef;color:#7c211d}.stepper{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.step{position:relative;text-align:center;padding:14px 8px;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.step .dot{width:30px;height:30px;border-radius:50%;margin:0 auto 8px;background:#e7e9f1;display:flex;align-items:center;justify-content:center}.step.approved .dot{background:#15966b;color:#fff}.empty{padding:28px;text-align:center;color:var(--zcs_secondary_text_color);border:1px dashed var(--zcs_tertiary_border_color);border-radius:12px}.skeleton{height:12px;border-radius:8px;background:linear-gradient(90deg,#eceef4,#f8f9fc,#eceef4);background-size:220% 100%;animation:shimmer 1.8s infinite}.variance{font-weight:650;color:#b0433d}.safe{color:#08734e}.score-link{font-weight:650;color:var(--zcs_brand_color);text-decoration:none}@keyframes orbit{to{transform:rotate(360deg)}}@keyframes shimmer{to{background-position:-220% 0}}@media(max-width:1000px){.kpis{grid-template-columns:repeat(2,1fr)}.section-grid{grid-template-columns:1fr}.prediction-grid{grid-template-columns:1fr}}@media(max-width:620px){.jcc{padding:12px}.hero{padding:22px}.kpis{grid-template-columns:1fr}.judge-grid,.stepper{grid-template-columns:1fr}.category-row{grid-template-columns:110px 1fr 42px}.actions .zcs-button{width:100%;box-sizing:border-box}}@media(prefers-reduced-motion:reduce){*{animation:none!important;scroll-behavior:auto!important}}\n&lt;/style&gt;\n&lt;div class=&quot;jcc&quot;&gt;\n\t&lt;section class=&quot;hero&quot; aria-labelledby=&quot;command-title&quot;&gt;\n\t\t&lt;div class=&quot;eyebrow&quot;&gt;Judge operations deck&lt;/div&gt;\n\t\t&lt;h1 id=&quot;command-title&quot;&gt;&lt;%=challengeTitle%&gt;&lt;/h1&gt;\n\t\t&lt;p&gt;Peer signal, independent scoring, explainable prediction, and unanimous consensus in one decision surface.&lt;/p&gt;\n\t\t&lt;div class=&quot;hero-meta&quot;&gt;\n\t\t\t&lt;div class=&quot;glass&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt; Phase: &lt;strong&gt;&lt;%=phase%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;glass&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-57&quot;&gt;&lt;/i&gt; Judging closes: &lt;strong&gt;&lt;%=deadlineText%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;glass&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-05&quot;&gt;&lt;/i&gt; Signed in: &lt;strong&gt;&lt;%=zoho.loginuser%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;nav class=&quot;actions&quot; aria-label=&quot;Judge actions&quot;&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-flex zcs-align-items-center zcs-gap-8 light&quot; href=&quot;#Form:AI_Analyses&quot;&gt;&lt;i class=&quot;zc-li-outline tech-ai&quot;&gt;&lt;/i&gt;&lt;span&gt;Run analysis&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-flex zcs-align-items-center zcs-gap-8 ghost&quot; href=&quot;#Report:My_Judge_Scores&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;&lt;span&gt;Open scorecards&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-flex zcs-align-items-center zcs-gap-8 ghost&quot; href=&quot;#Form:Final_Rankings&quot;&gt;&lt;i class=&quot;zc-li-outline design-list-bullet&quot;&gt;&lt;/i&gt;&lt;span&gt;Draft ranking&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-flex zcs-align-items-center zcs-gap-8 ghost&quot; href=&quot;#Report:My_Approval_Action&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span&gt;Approve consensus&lt;/span&gt;&lt;/a&gt;\n\t\t&lt;/nav&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;kpis&quot; aria-label=&quot;Challenge completion metrics&quot;&gt;\n\t\t&lt;article class=&quot;kpi zcs-card&quot;&gt;&lt;div class=&quot;icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-13&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;value&quot;&gt;&lt;%=submittedCount%&gt;/9&lt;/div&gt;&lt;div class=&quot;label&quot;&gt;Submitted applications&lt;/div&gt;&lt;/article&gt;\n\t\t&lt;article class=&quot;kpi zcs-card&quot;&gt;&lt;div class=&quot;icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-square-09&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;value&quot;&gt;&lt;%=ballotCount%&gt;/&lt;%=activeParticipantCount%&gt;&lt;/div&gt;&lt;div class=&quot;label&quot;&gt;Ballots complete&lt;/div&gt;&lt;/article&gt;\n\t\t&lt;article class=&quot;kpi zcs-card&quot;&gt;&lt;div class=&quot;icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline education-paper-diploma&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;value&quot;&gt;&lt;%=evaluationCount%&gt;/&lt;%=expectedEvaluations%&gt;&lt;/div&gt;&lt;div class=&quot;label&quot;&gt;Evaluations complete&lt;/div&gt;&lt;/article&gt;\n\t\t&lt;article class=&quot;kpi zcs-card&quot;&gt;&lt;div class=&quot;icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;value&quot;&gt;&lt;%=approvalCount%&gt;/3&lt;/div&gt;&lt;div class=&quot;label&quot;&gt;Consensus approvals&lt;/div&gt;&lt;/article&gt;\n\t&lt;/section&gt;\n\n\t&lt;% if(!analysisReady) { %&gt;&lt;div class=&quot;warning&quot;&gt;&lt;i class=&quot;zc-li-outline travel-info&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;Analysis is gated by incomplete data.&lt;/strong&gt; Complete all &lt;%=activeParticipantCount%&gt; ballots and &lt;%=expectedEvaluations%&gt; submitted evaluations before relying on a prediction.&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;\n\t&lt;% if(latestAnalysis.count() &gt; 0 &amp;&amp; latestAnalysis.Analysis_Status == &quot;Failed&quot;) { %&gt;&lt;div class=&quot;warning error&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;Latest AI run failed.&lt;/strong&gt; &lt;%=latestAnalysis.Failure_Message%&gt; Review the safe diagnostic and retry after service recovery.&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;\n\n\t&lt;div class=&quot;section-grid&quot;&gt;\n\t\t&lt;section class=&quot;panel zcs-card&quot;&gt;\n\t\t\t&lt;div class=&quot;panel-head&quot;&gt;&lt;div&gt;&lt;h2&gt;Judge score completion&lt;/h2&gt;&lt;div class=&quot;muted&quot;&gt;Independent submitted scorecards by named judge&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;score-link&quot; href=&quot;#Report:Scorecard_Progress&quot;&gt;Full progress&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;judge-grid&quot;&gt;\n\t\t\t&lt;% for each judge in Members[Member_Type == &quot;Judge&quot; &amp;&amp; Is_Active == true] sort by Display_Order asc { judgeDone = Judge_Evaluations[(Evaluation_Status == &quot;Submitted&quot; || Evaluation_Status == &quot;Locked&quot;) &amp;&amp; Judge == judge.ID].count(); judgePct = 0; if(submittedCount &gt; 0){judgePct = (judgeDone * 100) / submittedCount;} %&gt;\n\t\t\t\t&lt;article class=&quot;judge-card&quot;&gt;&lt;div class=&quot;judge-name&quot;&gt;&lt;%=judge.Member_Name%&gt;&lt;/div&gt;&lt;div class=&quot;muted&quot;&gt;&lt;%=judgeDone%&gt; of &lt;%=submittedCount%&gt; scorecards&lt;/div&gt;&lt;div class=&quot;meter&quot; aria-label=&quot;&lt;%=judgePct%&gt; percent complete&quot;&gt;&lt;span style=&quot;width:&lt;%=judgePct%&gt;%&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;status &lt;% if(judgeDone == submittedCount &amp;&amp; submittedCount &gt; 0){ %&gt;ok&lt;% } else { %&gt;warn&lt;% } %&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-small&quot;&gt;&lt;/i&gt;&lt;%=judgePct%&gt;% complete&lt;/div&gt;&lt;/article&gt;\n\t\t\t&lt;% } %&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;% if(currentJudge.count() == 0) { %&gt;&lt;div class=&quot;empty&quot;&gt;No active judge identity is mapped to this login. Ask an administrator to map the roster email.&lt;/div&gt;&lt;% } else { %&gt;&lt;p class=&quot;muted&quot;&gt;Your submitted coverage: &lt;strong&gt;&lt;%=myEvaluationCount%&gt; of &lt;%=submittedCount%&gt;&lt;/strong&gt;. &lt;a class=&quot;score-link&quot; href=&quot;#Form:Judge_Evaluations&quot;&gt;Add a scorecard&lt;/a&gt;&lt;/p&gt;&lt;% } %&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;aside class=&quot;panel zcs-card&quot;&gt;\n\t\t\t&lt;div class=&quot;panel-head&quot;&gt;&lt;div&gt;&lt;h2&gt;AI service&lt;/h2&gt;&lt;div class=&quot;muted&quot;&gt;Credential-safe operational status&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;% if(aiConfig.count() == 0) { %&gt;&lt;div class=&quot;empty&quot;&gt;No current AI configuration exists.&lt;/div&gt;&lt;% } else { %&gt;\n\t\t\t&lt;div class=&quot;status &lt;% if(aiConfig.Is_Enabled){ %&gt;ok&lt;% } else { %&gt;warn&lt;% } %&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline tech-robot&quot;&gt;&lt;/i&gt;&lt;% if(aiConfig.Is_Enabled){ %&gt;Enabled&lt;% } else { %&gt;Disabled&lt;% } %&gt;&lt;/div&gt;\n\t\t\t&lt;p&gt;&lt;strong&gt;Model:&lt;/strong&gt; &lt;%=aiConfig.Model_Name%&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Last test:&lt;/strong&gt; &lt;%=aiConfig.Last_Test_Status%&gt;&lt;/p&gt;&lt;p class=&quot;muted&quot;&gt;Endpoint credentials are intentionally never rendered on this page.&lt;/p&gt;&lt;a class=&quot;score-link&quot; href=&quot;#Report:AI_Service_Status&quot;&gt;Open service status&lt;/a&gt;\n\t\t\t&lt;% } %&gt;\n\t\t&lt;/aside&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;section-grid&quot;&gt;\n\t\t&lt;section class=&quot;panel zcs-card&quot;&gt;\n\t\t\t&lt;div class=&quot;panel-head&quot;&gt;&lt;div&gt;&lt;h2&gt;Application signal leaderboard&lt;/h2&gt;&lt;div class=&quot;muted&quot;&gt;Peer Borda points versus average judge weighted score&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;score-link&quot; href=&quot;#Report:Application_Score_Summary&quot;&gt;Score summary&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;% if(submittedCount == 0) { %&gt;&lt;div class=&quot;empty&quot;&gt;&lt;div class=&quot;skeleton&quot;&gt;&lt;/div&gt;&lt;p&gt;No submitted applications yet.&lt;/p&gt;&lt;/div&gt;&lt;% } else { %&gt;\n\t\t\t&lt;div class=&quot;zcs-table-wrapper&quot;&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Application&lt;/th&gt;&lt;th&gt;Peer Borda&lt;/th&gt;&lt;th&gt;Judge average&lt;/th&gt;&lt;th&gt;Variance flag&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t&lt;% for each app in submittedApps { borda = 0; for each ballot in Participant_Ballots[Ballot_Status == &quot;Submitted&quot; || Ballot_Status == &quot;Locked&quot;] { if(ballot.Rank_1 == app.ID){borda=borda+8;} if(ballot.Rank_2 == app.ID){borda=borda+7;} if(ballot.Rank_3 == app.ID){borda=borda+6;} if(ballot.Rank_4 == app.ID){borda=borda+5;} if(ballot.Rank_5 == app.ID){borda=borda+4;} if(ballot.Rank_6 == app.ID){borda=borda+3;} if(ballot.Rank_7 == app.ID){borda=borda+2;} if(ballot.Rank_8 == app.ID){borda=borda+1;} } appEvals = Judge_Evaluations[Application == app.ID &amp;&amp; (Evaluation_Status == &quot;Submitted&quot; || Evaluation_Status == &quot;Locked&quot;)]; avgScore = 0; spread = 0; if(appEvals.count() &gt; 0){avgScore=appEvals.avg(Weighted_Total);lowestScore=null;highestScore=null;for each appEval in appEvals{currentScore=appEval.Weighted_Total;if(lowestScore == null || currentScore &lt; lowestScore){lowestScore=currentScore;}if(highestScore == null || currentScore &gt; highestScore){highestScore=currentScore;}}if(lowestScore != null &amp;&amp; highestScore != null){spread=highestScore-lowestScore;}} %&gt;\n\t\t\t\t&lt;tr&gt;&lt;td&gt;&lt;strong&gt;&lt;%=app.App_Name%&gt;&lt;/strong&gt;&lt;div class=&quot;muted&quot;&gt;&lt;%=app.Tagline%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td&gt;&lt;%=borda%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=avgScore.round(1)%&gt;/100&lt;/td&gt;&lt;td class=&quot;&lt;% if(spread &gt;= 15){ %&gt;variance&lt;% } else { %&gt;safe&lt;% } %&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline &lt;% if(spread &gt;= 15){ %&gt;travel-info&lt;% } else { %&gt;ui-1-check-small&lt;% } %&gt;&quot;&gt;&lt;/i&gt; &lt;%=spread.round(1)%&gt; point spread&lt;/td&gt;&lt;/tr&gt;\n\t\t\t&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;aside class=&quot;panel zcs-card&quot;&gt;\n\t\t\t&lt;div class=&quot;panel-head&quot;&gt;&lt;div&gt;&lt;h2&gt;Category performance&lt;/h2&gt;&lt;div class=&quot;muted&quot;&gt;All submitted judge evaluations&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;% allEvals = Judge_Evaluations[Evaluation_Status == &quot;Submitted&quot; || Evaluation_Status == &quot;Locked&quot;]; if(allEvals.count() == 0) { %&gt;&lt;div class=&quot;empty&quot;&gt;Category bars appear after scorecards are submitted.&lt;/div&gt;&lt;% } else { uiAvg=allEvals.avg(UI_Score)*10; navAvg=allEvals.avg(Navigation_Usability_Score)*10; coreAvg=allEvals.avg(Core_Functionality_Score)*10; innovationAvg=allEvals.avg(Innovation_Score)*10; proofAvg=allEvals.avg(Beyond_Creator_Proof_Score)*10; integrationAvg=allEvals.avg(Catalyst_Integrations_Score)*10; presentationAvg=allEvals.avg(Presentation_Score)*10; labels={&quot;UI&quot;,&quot;Navigation&quot;,&quot;Core function&quot;,&quot;Innovation&quot;,&quot;Beyond Creator&quot;,&quot;Integrations&quot;,&quot;Presentation&quot;}; values={uiAvg,navAvg,coreAvg,innovationAvg,proofAvg,integrationAvg,presentationAvg}; for each index i in labels { %&gt;&lt;div class=&quot;category-row&quot;&gt;&lt;span&gt;&lt;%=labels.get(i)%&gt;&lt;/span&gt;&lt;div class=&quot;meter&quot;&gt;&lt;span style=&quot;width:&lt;%=values.get(i)%&gt;%&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;strong&gt;&lt;%=values.get(i).round(0)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;% } } %&gt;\n\t\t&lt;/aside&gt;\n\t&lt;/div&gt;\n\n\t&lt;section class=&quot;panel zcs-card&quot; style=&quot;margin-top:16px&quot;&gt;\n\t\t&lt;div class=&quot;panel-head&quot;&gt;&lt;div&gt;&lt;h2&gt;Latest AI predictions&lt;/h2&gt;&lt;div class=&quot;muted&quot;&gt;Recommendations remain advisory until unanimous approval&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;score-link&quot; href=&quot;#Report:AI_Analysis_History&quot;&gt;Analysis history&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;% if(latestAnalysis.count() == 0 || latestAnalysis.Analysis_Status != &quot;Completed&quot;) { %&gt;&lt;div class=&quot;empty&quot;&gt;&lt;i class=&quot;zc-li-outline tech-ai&quot;&gt;&lt;/i&gt;&lt;p&gt;No completed latest prediction is available. Run analysis when data is complete.&lt;/p&gt;&lt;/div&gt;&lt;% } else { teamConfidence=latestAnalysis.Team_Confidence; judgeConfidence=latestAnalysis.Judge_Confidence; overallConfidence=(teamConfidence+judgeConfidence)/2; %&gt;\n\t\t&lt;div class=&quot;prediction-grid&quot;&gt;\n\t\t\t&lt;article class=&quot;prediction&quot;&gt;&lt;h3&gt;Team winner&lt;/h3&gt;&lt;div class=&quot;winner&quot;&gt;&lt;%=latestAnalysis.Team_Vote_Predicted_Winner.App_Name%&gt;&lt;/div&gt;&lt;div class=&quot;meter&quot;&gt;&lt;span style=&quot;width:&lt;%=teamConfidence%&gt;%&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;muted&quot;&gt;&lt;%=teamConfidence.round(0)%&gt;% confidence&lt;/p&gt;&lt;div&gt;&lt;%=latestAnalysis.Team_Analysis%&gt;&lt;/div&gt;&lt;/article&gt;\n\t\t\t&lt;article class=&quot;prediction&quot;&gt;&lt;h3&gt;Judge winner&lt;/h3&gt;&lt;div class=&quot;winner&quot;&gt;&lt;%=latestAnalysis.Judge_Score_Predicted_Winner.App_Name%&gt;&lt;/div&gt;&lt;div class=&quot;meter&quot;&gt;&lt;span style=&quot;width:&lt;%=judgeConfidence%&gt;%&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;muted&quot;&gt;&lt;%=judgeConfidence.round(0)%&gt;% confidence&lt;/p&gt;&lt;div&gt;&lt;%=latestAnalysis.Judge_Analysis%&gt;&lt;/div&gt;&lt;/article&gt;\n\t\t\t&lt;article class=&quot;prediction&quot;&gt;&lt;h3&gt;Overall recommendation&lt;/h3&gt;&lt;div class=&quot;winner&quot;&gt;&lt;%=latestAnalysis.Overall_Recommended_Winner.App_Name%&gt;&lt;/div&gt;&lt;div class=&quot;meter&quot;&gt;&lt;span style=&quot;width:&lt;%=overallConfidence%&gt;%&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;muted&quot;&gt;Combined signal &lt;%=overallConfidence.round(0)%&gt;%&lt;/p&gt;&lt;div&gt;&lt;%=latestAnalysis.Consensus_And_Disagreement%&gt;&lt;/div&gt;&lt;/article&gt;\n\t\t&lt;/div&gt;&lt;% } %&gt;\n\t&lt;/section&gt;\n\n\t&lt;div class=&quot;section-grid&quot;&gt;\n\t\t&lt;section class=&quot;panel zcs-card&quot;&gt;\n\t\t\t&lt;div class=&quot;panel-head&quot;&gt;&lt;div&gt;&lt;h2&gt;Ballot explanation feed&lt;/h2&gt;&lt;div class=&quot;muted&quot;&gt;Judge-visible evidence behind first-choice rankings&lt;/div&gt;&lt;/div&gt;&lt;a class=&quot;score-link&quot; href=&quot;#Report:Ballot_Audit&quot;&gt;Open ballot audit&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;feed&quot;&gt;&lt;% feedCount=0; for each ballot in Participant_Ballots[Ballot_Status == &quot;Submitted&quot; || Ballot_Status == &quot;Locked&quot;] sort by Submitted_At desc { if(feedCount &lt; 5){ %&gt;&lt;article class=&quot;feed-item&quot;&gt;&lt;strong&gt;&lt;%=ballot.Voter.Member_Name%&gt; backed &lt;%=ballot.Rank_1.App_Name%&gt;&lt;/strong&gt;&lt;p&gt;&lt;%=ballot.Best_App_Explanation%&gt;&lt;/p&gt;&lt;div class=&quot;muted&quot;&gt;&lt;%=ballot.Submitted_At%&gt;&lt;/div&gt;&lt;/article&gt;&lt;% feedCount=feedCount+1; } } if(feedCount == 0){ %&gt;&lt;div class=&quot;empty&quot;&gt;No submitted ballot explanations are available.&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;aside class=&quot;panel zcs-card&quot;&gt;\n\t\t\t&lt;div class=&quot;panel-head&quot;&gt;&lt;div&gt;&lt;h2&gt;Consensus finalization&lt;/h2&gt;&lt;div class=&quot;muted&quot;&gt;All three judges must approve the unchanged ranking&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;stepper&quot;&gt;\n\t\t\t&lt;% names={&quot;Siddarth&quot;,&quot;Monica&quot;,&quot;Brandon&quot;}; for each name in names { approved=false; if(currentRanking.count() &gt; 0){approved=Final_Approvals[Final_Ranking == currentRanking.ID &amp;&amp; Judge.Member_Name == name &amp;&amp; Decision == &quot;Approve&quot;].count() &gt; 0;} %&gt;&lt;div class=&quot;step &lt;% if(approved){ %&gt;approved&lt;% } %&gt;&quot;&gt;&lt;div class=&quot;dot&quot;&gt;&lt;i class=&quot;zc-li-outline &lt;% if(approved){ %&gt;ui-1-check-small&lt;% } else { %&gt;ui-2-time&lt;% } %&gt;&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;strong&gt;&lt;%=name%&gt;&lt;/strong&gt;&lt;div class=&quot;muted&quot;&gt;&lt;% if(approved){ %&gt;Approved&lt;% } else { %&gt;Awaiting decision&lt;% } %&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;% if(currentRanking.count() == 0) { %&gt;&lt;div class=&quot;warning&quot; style=&quot;margin-top:14px&quot;&gt;&lt;i class=&quot;zc-li-outline travel-info&quot;&gt;&lt;/i&gt;&lt;span&gt;No current ranking is pending consensus. Draft and submit a ranking first.&lt;/span&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t\t&lt;div class=&quot;actions&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&quot; href=&quot;#Report:Consensus_Status&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span&gt;Review consensus&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;/aside&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Participant_Challenge_Hub
		{
					displayname = "Participant Challenge Hub"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Challenge_Hub_Experience' elementName='Challenge_Hub_Experience'>\n\t\t\t\t\t<![CDATA[htmlpage Challenge_Hub_Experience()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nloginEmail = zoho.loginuserid;\nmemberName = zoho.loginuser;\nmemberRows = Members[Login_Email == loginEmail &amp;&amp; Member_Type == &quot;Participant&quot; &amp;&amp; Is_Active == true];\nif(memberRows.count() &gt; 0)\n{\n\tmemberName = memberRows.Member_Name;\n}\nsettingsRows = Challenge_Settings[Current_Record == true];\nhasSettings = settingsRows.count() &gt; 0;\nphaseName = &quot;Setup&quot;;\nphaseIndex = 1;\nchallengeTitle = &quot;Om.ai Beyond Limits Challenge&quot;;\nannouncement = &quot;The challenge control record is being prepared. Check back soon for the official announcement and dates.&quot;;\ncountdownLabel = &quot;Challenge setup underway&quot;;\ncountdownValue = &quot;Dates pending&quot;;\nresultsVisible = false;\npresentationMinutes = 15;\nshowcaseText = &quot;To be announced&quot;;\nif(hasSettings)\n{\n\tphaseName = settingsRows.Challenge_Status;\n\tchallengeTitle = settingsRows.Challenge_Title;\n\tannouncement = settingsRows.Rules_And_Announcement;\n\tresultsVisible = settingsRows.Results_Visible_To_Participants;\n\tpresentationMinutes = settingsRows.Presentation_Minutes;\n\tif(settingsRows.Showcase_Date_Time != null)\n\t{\n\t\tshowcaseText = settingsRows.Showcase_Date_Time.toString(&quot;dd MMM yyyy, hh:mm a&quot;);\n\t}\n\ttargetDate = settingsRows.Challenge_End;\n\tcountdownLabel = &quot;Until submissions close&quot;;\n\tif(phaseName == &quot;Voting Open&quot;)\n\t{\n\t\tphaseIndex = 3;\n\t\ttargetDate = settingsRows.Voting_Closes;\n\t\tcountdownLabel = &quot;Until voting closes&quot;;\n\t}\n\telse if(phaseName == &quot;Judging Open&quot;)\n\t{\n\t\tphaseIndex = 4;\n\t\ttargetDate = settingsRows.Judging_Closes;\n\t\tcountdownLabel = &quot;Until judging closes&quot;;\n\t}\n\telse if(phaseName == &quot;Finalization&quot;)\n\t{\n\t\tphaseIndex = 5;\n\t\ttargetDate = settingsRows.Judging_Closes;\n\t\tcountdownLabel = &quot;Final consensus in progress&quot;;\n\t}\n\telse if(phaseName == &quot;Results Published&quot;)\n\t{\n\t\tphaseIndex = 6;\n\t\tcountdownLabel = &quot;Results are published&quot;;\n\t}\n\telse if(phaseName == &quot;Submission Open&quot;)\n\t{\n\t\tphaseIndex = 2;\n\t}\n\tif(phaseName != &quot;Results Published&quot;)\n\t{\n\t\tdaysLeft = zoho.currentdate.daysBetween(targetDate.toDate());\n\t\tif(daysLeft &lt; 0)\n\t\t{\n\t\t\tdaysLeft = 0;\n\t\t}\n\t\tcountdownValue = daysLeft + &quot; day(s) remaining&quot;;\n\t}\n\telse\n\t{\n\t\tcountdownValue = &quot;Reveal ready&quot;;\n\t}\n}\nmyApps = Applications[Created_By_Email == loginEmail];\nhasApp = myApps.count() &gt; 0;\nappName = &quot;Your app concept&quot;;\nappStatus = &quot;Not started&quot;;\nreadiness = 0;\nappActionUrl = &quot;#Form:Applications&quot;;\nappActionText = &quot;Create submission&quot;;\nappActionIcon = &quot;ui-1-simple-add&quot;;\nif(hasApp)\n{\n\tappName = myApps.App_Name;\n\tappStatus = myApps.Submission_Status;\n\tif(myApps.Readiness_Percent != null)\n\t{\n\t\treadiness = myApps.Readiness_Percent;\n\t}\n\tappActionUrl = &quot;#Form:Applications?recLinkID=&quot; + myApps.ID + &quot;&amp;viewLinkName=Application_Gallery&quot;;\n\tappActionText = &quot;Edit submission&quot;;\n\tappActionIcon = &quot;ui-1-edit-72&quot;;\n}\nmyBallots = Participant_Ballots[Voter_Email == loginEmail];\nhasBallot = myBallots.count() &gt; 0;\nballotStatus = &quot;Not started&quot;;\nballotDone = false;\nballotUrl = &quot;#Form:Participant_Ballots&quot;;\nif(hasBallot)\n{\n\tballotStatus = myBallots.Ballot_Status;\n\tballotUrl = &quot;#Form:Participant_Ballots?recLinkID=&quot; + myBallots.ID + &quot;&amp;viewLinkName=My_Ballot&quot;;\n\tif(ballotStatus == &quot;Submitted&quot; || ballotStatus == &quot;Locked&quot;)\n\t{\n\t\tballotDone = true;\n\t}\n}\nslots = Presentation_Slots[ID != 0] sort by Slot_Start asc;\n%&gt;\n&lt;style&gt;\n/* zcs-global utility subset used by this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color)}\n.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-direction-column{flex-direction:column}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-16{gap:1rem}.zcs-p-0{padding:0}.zcs-p-16{padding:1rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-half{border-radius:50%}.zcs-box-border{box-sizing:border-box}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-text-center{text-align:center}.zcs-relative{position:relative}.zcs-w-full{width:100%}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}\n.zcs-button{width:auto;min-width:5rem;min-height:36px;text-decoration:none}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}.zcs-button:focus{outline:3px solid #fff;outline-offset:2px}.zcs-button-icon{width:16px;max-height:16px}\n.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-green{background:#E4FCF3;border-color:#08764e;color:#08764e}.zcs-badge-blue{background:#E8EFFF;border-color:#174fbd;color:#174fbd}.zcs-badge-yellow{background:#FCF4E6;border-color:#895700;color:#895700}.zcs-badge-grey{background:#eee;border-color:#242424;color:#242424}\n.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}\n.zcs-toast{border:1px solid var(--zcs_brand_color);background:var(--zcs_component_hover_color)}\n.hub{font-family:Inter,Arial,sans-serif;background:linear-gradient(180deg,#f5f7ff 0,#fff 28%,#f7f8fc 100%);color:#14152d;padding:clamp(12px,2.4vw,32px);box-sizing:border-box;overflow:hidden}.hub *{box-sizing:border-box}.hero{position:relative;min-height:340px;border-radius:28px;padding:clamp(26px,5vw,64px);display:grid;grid-template-columns:minmax(0,1.5fr) minmax(260px,.7fr);gap:30px;align-items:center;color:#fff;overflow:hidden;background:radial-gradient(circle at 82% 15%,rgba(129,90,246,.72),transparent 26%),radial-gradient(circle at 10% 100%,rgba(0,202,211,.34),transparent 34%),linear-gradient(125deg,#11133c,#24206b 52%,#37196c)}.hero:before,.hero:after{content:&quot;&quot;;position:absolute;border:1px solid rgba(255,255,255,.18);border-radius:50%;animation:orbit 14s linear infinite}.hero:before{width:420px;height:420px;right:-150px;top:-205px}.hero:after{width:250px;height:250px;right:20px;top:-125px;animation-direction:reverse}.eyebrow{letter-spacing:.15em;text-transform:uppercase;font-size:12px;font-weight:800;color:#c9f9ff}.hero h1{font-size:clamp(36px,6vw,72px);line-height:.98;margin:14px 0 18px;max-width:760px}.hero p{font-size:clamp(16px,2vw,20px);line-height:1.55;max-width:680px;color:#e9eaff;margin:0}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}.hero .zcs-primary-button{background:#fff;color:#191548}.hero .zcs-primary-outline-button{border-color:#b9f8ff;background:transparent;color:#fff}.trophy-wrap{position:relative;display:flex;justify-content:center;align-items:center;min-height:230px}.trophy-halo{position:absolute;width:220px;height:220px;border-radius:50%;background:radial-gradient(circle,#ffe9a6 0,rgba(255,209,91,.24) 45%,transparent 70%);animation:breathe 3.8s ease-in-out infinite}.trophy{position:relative;font-size:118px;color:#ffd45d;filter:drop-shadow(0 20px 20px rgba(0,0,0,.3));animation:float 4s ease-in-out infinite}.personal{position:absolute;right:22px;top:20px}.countdown{position:absolute;right:clamp(18px,3vw,42px);bottom:clamp(18px,3vw,38px);background:rgba(8,10,38,.76);border:1px solid rgba(255,255,255,.24);backdrop-filter:blur(8px);border-radius:16px;padding:14px 18px;min-width:230px}.countdown strong{display:block;font-size:22px;margin-top:3px}.section{margin-top:28px}.section-head{display:flex;justify-content:space-between;gap:16px;align-items:end;margin-bottom:14px}.section h2{font-size:clamp(24px,3vw,34px);margin:0}.section-kicker{font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--zcs_brand_color)}.card{background:#fff;border:1px solid #e2e5ef;border-radius:18px;padding:22px;box-shadow:0 10px 30px rgba(25,27,61,.06)}.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:20px}.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.phase-shell{overflow-x:auto;padding:26px 18px 18px}.zcs-stepper-wrapper{min-width:760px}.zcs-stepper-wrapper ul{list-style:none;display:flex}.zcs-stepper{display:flex;flex-direction:column;align-items:center;gap:7px;text-align:center;position:relative}.zcs-stepper-status{width:36px;height:36px;background:#fff;border:2px solid #c8ccda;z-index:1}.zcs-stepper:not(:last-child):before{content:&quot;&quot;;position:absolute;top:18px;left:50%;width:100%;border-top:2px solid #c8ccda}.zcs-stepper.done .zcs-stepper-status,.zcs-stepper.active .zcs-stepper-status{background:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-stepper.done:not(:last-child):before{border-color:var(--zcs_brand_color)}.zcs-stepper.active .zcs-stepper-status{box-shadow:0 0 0 6px var(--zcs_component_hover_color);animation:breathe 2s ease-in-out infinite}.zcs-stepper-text{font-size:13px;font-weight:650}.announcement{font-size:15px;line-height:1.65;color:#35364b}.stealth-list{display:grid;gap:12px;margin:16px 0 0;padding:0;list-style:none}.stealth-list li{display:flex;gap:11px;align-items:flex-start}.stealth-list i{color:#5e35b1;margin-top:3px}.readiness-top{display:flex;justify-content:space-between;gap:14px;align-items:flex-start}.readiness-value{font-size:40px;font-weight:800;color:var(--zcs_brand_color)}.action-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.vote-lock{display:flex;gap:14px;align-items:center}.status-orb{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;background:#eef0f7;color:#555a70}.status-orb.done{background:#e4fcf3;color:#08764e}.schedule{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.slot{position:relative;overflow:hidden}.slot:before{content:&quot;&quot;;position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--zcs_brand_color)}.slot-time{font-size:13px;color:#62657a;font-weight:700}.slot h3{margin:8px 0 5px;font-size:18px}.slot-meta{color:#55586c;font-size:14px;line-height:1.5}.weights{display:grid;gap:12px}.weight-row{display:grid;grid-template-columns:minmax(150px,1fr) 3fr 44px;gap:12px;align-items:center;font-size:14px}.weight-track{height:9px;border-radius:9px;background:#edf0f7;overflow:hidden}.weight-fill{height:100%;background:linear-gradient(90deg,var(--zcs_brand_color),#6f67e8);border-radius:inherit}.catalyst{background:linear-gradient(120deg,#fff8e5,#fff 60%);border-color:#f1c44f;display:flex;gap:18px;align-items:center}.catalyst-icon{font-size:42px;color:#a96a00}.result-lock{position:relative;text-align:center;padding:40px 24px;background:linear-gradient(135deg,#17183f,#29225d);color:#fff;border:0}.result-lock i{font-size:42px;color:#ffd45d}.result-lock h2{margin:12px 0 8px}.result-lock p{color:#e6e6f5;max-width:600px;margin:0 auto 20px}.empty{text-align:center;padding:34px 20px;color:#5e6175}.empty i{display:block;font-size:38px;color:#8a8da0;margin-bottom:10px}@keyframes float{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-16px) rotate(2deg)}}@keyframes breathe{0%,100%{transform:scale(1);opacity:.78}50%{transform:scale(1.08);opacity:1}}@keyframes orbit{to{transform:rotate(360deg)}}@media(max-width:980px){.hero{grid-template-columns:1fr}.trophy-wrap{min-height:180px;justify-content:flex-end}.trophy{font-size:88px}.trophy-halo{width:170px;height:170px}.countdown{left:22px;right:auto}.grid-3,.schedule{grid-template-columns:repeat(2,1fr)}}@media(max-width:680px){.hub{padding:10px}.hero{border-radius:20px;padding:24px 20px 150px}.personal{position:static;margin-bottom:15px}.trophy-wrap{display:none}.countdown{left:20px;right:20px;bottom:22px}.grid-2,.grid-3,.schedule{grid-template-columns:1fr}.section-head{align-items:flex-start;flex-direction:column}.weight-row{grid-template-columns:1fr 44px}.weight-track{grid-column:1/3;grid-row:2}.catalyst{align-items:flex-start}.hero-actions .zcs-button{width:100%}}@media(prefers-reduced-motion:reduce){.hero:before,.hero:after,.trophy,.trophy-halo,.zcs-stepper.active .zcs-stepper-status{animation:none!important}.hub *{scroll-behavior:auto!important;transition:none!important}}\n&lt;/style&gt;\n&lt;main class=&quot;hub&quot;&gt;\n\t&lt;section class=&quot;hero&quot; aria-labelledby=&quot;challenge-title&quot;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;div class=&quot;personal zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-05&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=memberName%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;eyebrow&quot;&gt;Om.ai Beyond Limits&lt;/div&gt;\n\t\t\t&lt;h1 id=&quot;challenge-title&quot;&gt;&lt;%=challengeTitle%&gt;&lt;/h1&gt;\n\t\t\t&lt;p&gt;Build past the expected. Prove what is possible, protect the surprise, and prepare your fifteen-minute moment.&lt;/p&gt;\n\t\t\t&lt;div class=&quot;hero-actions&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&quot; href=&quot;&lt;%=appActionUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline &lt;%=appActionIcon%&gt;&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=appActionText%&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&quot; href=&quot;&lt;%=ballotUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-check-square-11&quot;&gt;&lt;/i&gt;&lt;span&gt;Complete ballot&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;trophy-wrap&quot; aria-hidden=&quot;true&quot;&gt;&lt;div class=&quot;trophy-halo&quot;&gt;&lt;/div&gt;&lt;i class=&quot;trophy zc-li-solid sport-trophy&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;countdown&quot; role=&quot;status&quot; aria-live=&quot;polite&quot;&gt;&lt;span&gt;&lt;%=countdownLabel%&gt;&lt;/span&gt;&lt;strong&gt;&lt;%=countdownValue%&gt;&lt;/strong&gt;&lt;small&gt;Server snapshot: &lt;%=zoho.currenttime.toString(&quot;dd MMM, hh:mm a&quot;)%&gt;&lt;/small&gt;&lt;/div&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;section&quot; aria-labelledby=&quot;journey-title&quot;&gt;&lt;div class=&quot;section-head&quot;&gt;&lt;div&gt;&lt;div class=&quot;section-kicker&quot;&gt;Your journey&lt;/div&gt;&lt;h2 id=&quot;journey-title&quot;&gt;Challenge phase&lt;/h2&gt;&lt;/div&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zc-li-outline loader-dots-06&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=phaseName%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;card phase-shell&quot;&gt;&lt;div class=&quot;zcs-stepper-wrapper&quot;&gt;&lt;ul class=&quot;zcs-flex zcs-p-0 zcs-m-0&quot;&gt;\n\t\t&lt;% phases = {&quot;Setup&quot;,&quot;Submission&quot;,&quot;Voting&quot;,&quot;Judging&quot;,&quot;Finalization&quot;,&quot;Results&quot;}; for each index i in phases { stepNo = i + 1; stepClass = &quot;&quot;; if(stepNo &lt; phaseIndex){stepClass=&quot;done&quot;;}else if(stepNo == phaseIndex){stepClass=&quot;active&quot;;} %&gt;\n\t\t\t&lt;li class=&quot;zcs-stepper zcs-col-common &lt;%=stepClass%&gt;&quot;&gt;&lt;div class=&quot;zcs-stepper-status zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half&quot;&gt;&lt;%if(stepNo &lt; phaseIndex){%&gt;&lt;i class=&quot;zc-li-outline ui-1-check-small&quot;&gt;&lt;/i&gt;&lt;%}else{%&gt;&lt;span&gt;&lt;%=stepNo%&gt;&lt;/span&gt;&lt;%}%&gt;&lt;/div&gt;&lt;span class=&quot;zcs-stepper-text&quot;&gt;&lt;%=phases.get(i)%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t&lt;% } %&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;section grid-2&quot; aria-label=&quot;Announcement and stealth rules&quot;&gt;\n\t\t&lt;article class=&quot;card&quot;&gt;&lt;div class=&quot;section-kicker&quot;&gt;Challenge announcement&lt;/div&gt;&lt;h2&gt;Mission briefing&lt;/h2&gt;&lt;div class=&quot;announcement&quot;&gt;&lt;%=announcement%&gt;&lt;/div&gt;&lt;/article&gt;\n\t\t&lt;article class=&quot;card&quot;&gt;&lt;div class=&quot;section-kicker&quot;&gt;Stealth mode&lt;/div&gt;&lt;h2&gt;Keep the reveal fair&lt;/h2&gt;&lt;ul class=&quot;stealth-list&quot;&gt;&lt;li&gt;&lt;i class=&quot;zc-li-outline ui-1-lock-circle&quot;&gt;&lt;/i&gt;&lt;span&gt;Do not share your app concept, screenshots, demo, or judging evidence with other participants before showcase.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;i class=&quot;zc-li-outline ui-1-eye-ban-18&quot;&gt;&lt;/i&gt;&lt;span&gt;Your ballot is private. This page shows only your completion status and never another participant&apos;s choices.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;i class=&quot;zc-li-outline users-multiple-19&quot;&gt;&lt;/i&gt;&lt;span&gt;Ask administrators about logistics without soliciting ranking commitments or coordinated votes.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/article&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;section grid-2&quot; aria-label=&quot;Personal progress&quot;&gt;\n\t\t&lt;article class=&quot;card&quot;&gt;&lt;div class=&quot;readiness-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;section-kicker&quot;&gt;My application&lt;/div&gt;&lt;h2&gt;&lt;%=appName%&gt;&lt;/h2&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled-outline &lt;%if(appStatus == &quot;Submitted&quot; || appStatus == &quot;Locked&quot;) {%&gt;zcs-badge-green&lt;%}else{%&gt;zcs-badge-yellow&lt;%}%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zc-li-outline &lt;%if(appStatus == &quot;Submitted&quot; || appStatus == &quot;Locked&quot;) {%&gt;ui-1-check-circle-08&lt;%}else{%&gt;ui-2-time&lt;%}%&gt;&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=appStatus%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;readiness-value&quot;&gt;&lt;%=readiness%&gt;%&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 zcs-mt-12&quot;&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=readiness%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&quot;zcs-flex zcs-justify-space-between zcs-font-12 zcs-font-medium zcs-m-0&quot;&gt;&lt;span&gt;Submission readiness&lt;/span&gt;&lt;span&gt;Target 100%&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;action-row&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&quot; href=&quot;&lt;%=appActionUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline &lt;%=appActionIcon%&gt;&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=appActionText%&gt;&lt;/span&gt;&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&quot; href=&quot;#Report:Application_Gallery&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-eye-17&quot;&gt;&lt;/i&gt;&lt;span&gt;View gallery&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;/article&gt;\n\t\t&lt;article class=&quot;card&quot;&gt;&lt;div class=&quot;section-kicker&quot;&gt;Private peer ballot&lt;/div&gt;&lt;h2&gt;Voting status&lt;/h2&gt;&lt;div class=&quot;vote-lock&quot;&gt;&lt;div class=&quot;status-orb &lt;%if(ballotDone){%&gt;done&lt;%}%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline &lt;%if(ballotDone){%&gt;ui-1-check-circle-08&lt;%}else{%&gt;ui-1-lock-circle&lt;%}%&gt;&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;strong&gt;&lt;%=ballotStatus%&gt;&lt;/strong&gt;&lt;p class=&quot;zcs-mt-8&quot;&gt;Rank all eight competing apps. Only your own status is shown here.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;action-row&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&quot; href=&quot;&lt;%=ballotUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-check-square-11&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%if(ballotDone){%&gt;Review my ballot&lt;%}else{%&gt;Complete ballot&lt;%}%&gt;&lt;/span&gt;&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&quot; href=&quot;#Report:Voting_Completion&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline business-chart-bar-32&quot;&gt;&lt;/i&gt;&lt;span&gt;Completion overview&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/article&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;section&quot; aria-labelledby=&quot;schedule-title&quot;&gt;&lt;div class=&quot;section-head&quot;&gt;&lt;div&gt;&lt;div class=&quot;section-kicker&quot;&gt;Showcase&lt;/div&gt;&lt;h2 id=&quot;schedule-title&quot;&gt;&lt;%=presentationMinutes%&gt;-minute presentation schedule&lt;/h2&gt;&lt;/div&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-grey zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=showcaseText%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;%if(slots.count() == 0){%&gt;&lt;div class=&quot;card empty&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60&quot;&gt;&lt;/i&gt;&lt;strong&gt;Schedule coming soon&lt;/strong&gt;&lt;p&gt;Presentation slots will appear here as soon as they are assigned.&lt;/p&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&quot; href=&quot;#Report:Presentation_Schedule&quot;&gt;Open schedule report&lt;/a&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&quot;schedule&quot;&gt;&lt;%for each slot in slots{%&gt;&lt;article class=&quot;card slot&quot;&gt;&lt;div class=&quot;slot-time&quot;&gt;&lt;%=slot.Slot_Start.toString(&quot;hh:mm a&quot;)%&gt; - &lt;%=slot.Slot_End.toString(&quot;hh:mm a&quot;)%&gt;&lt;/div&gt;&lt;h3&gt;&lt;%=slot.Application.App_Name%&gt;&lt;/h3&gt;&lt;div class=&quot;slot-meta&quot;&gt;&lt;%=slot.Presenter.Member_Name%&gt;&lt;%if(slot.Room_Or_Link != null &amp;&amp; slot.Room_Or_Link != &quot;&quot;) {%&gt;&lt;br&gt;&lt;%=slot.Room_Or_Link%&gt;&lt;%}%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-mt-12&quot;&gt;&lt;i class=&quot;zc-li-outline media-1-button-circle-play&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=slot.Presentation_Status%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/article&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%}%&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;section grid-2&quot; aria-label=&quot;Scoring guide&quot;&gt;&lt;article class=&quot;card&quot;&gt;&lt;div class=&quot;section-kicker&quot;&gt;How judging works&lt;/div&gt;&lt;h2&gt;Categories and weights&lt;/h2&gt;&lt;div class=&quot;weights&quot;&gt;&lt;% labels={&quot;UI quality&quot;,&quot;Navigation and usability&quot;,&quot;Core functionality&quot;,&quot;Innovation&quot;,&quot;Beyond-Creator proof&quot;,&quot;Catalyst and integrations&quot;,&quot;Presentation&quot;}; weights={15,15,20,15,20,10,5}; for each index w in labels { barWidth = weights.get(w) * 5; %&gt;&lt;div class=&quot;weight-row&quot;&gt;&lt;span&gt;&lt;%=labels.get(w)%&gt;&lt;/span&gt;&lt;div class=&quot;weight-track&quot;&gt;&lt;div class=&quot;weight-fill&quot; style=&quot;width:&lt;%=barWidth%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong&gt;&lt;%=weights.get(w)%&gt;%&lt;/strong&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/article&gt;\n\t\t&lt;article class=&quot;card catalyst&quot;&gt;&lt;i class=&quot;catalyst-icon zc-li-solid nature-energy&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;div class=&quot;section-kicker&quot;&gt;Catalyst bonus signal&lt;/div&gt;&lt;h2&gt;Connect beyond the baseline&lt;/h2&gt;&lt;p&gt;Thoughtful Catalyst use and meaningful integrations strengthen the integrations category. Demonstrate why the connection matters rather than adding technology for its own sake.&lt;/p&gt;&lt;div class=&quot;zcs-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm&quot;&gt;&lt;i class=&quot;zc-li-outline travel-info&quot;&gt;&lt;/i&gt;&lt;span&gt;Evidence and reliability matter more than the number of services connected.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/article&gt;&lt;/section&gt;\n\n\t&lt;section class=&quot;section&quot;&gt;&lt;article class=&quot;card result-lock&quot;&gt;&lt;i class=&quot;zc-li-solid &lt;%if(resultsVisible){%&gt;sport-trophy&lt;%}else{%&gt;ui-1-lock-circle&lt;%}%&gt;&quot;&gt;&lt;/i&gt;&lt;h2&gt;&lt;%if(resultsVisible){%&gt;The results stage is open&lt;%}else{%&gt;The final reveal is under lock&lt;%}%&gt;&lt;/h2&gt;&lt;p&gt;&lt;%if(resultsVisible){%&gt;Consensus is complete. Enter the published results experience to celebrate every finalist.&lt;%}else{%&gt;The leaderboard stays hidden until the controlled publication workflow enables Results Visible To Participants. No draft ranking or judge-only data is exposed here.&lt;%}%&gt;&lt;/p&gt;&lt;%if(resultsVisible){%&gt;&lt;a class=&quot;zcs-button zcs-primary-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&quot; href=&quot;#Page:Results_Stage&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span&gt;Enter results stage&lt;/span&gt;&lt;/a&gt;&lt;%}else{%&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-yellow zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span&gt;Awaiting unanimous publication&lt;/span&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/article&gt;&lt;/section&gt;\n&lt;/main&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Results_Stage
		{
					displayname = "Results Stage"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Results_Experience' elementName='Results_Experience'>\n\t\t\t\t\t<![CDATA[htmlpage Results_Experience()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nsettings = Challenge_Settings[Current_Record == true];\nviewer = Members[Login_Email == zoho.loginuser &amp;&amp; Is_Active == true];\nisJudge = viewer.count() &gt; 0 &amp;&amp; viewer.Member_Type == &quot;Judge&quot;;\npublishedRanks = Final_Rankings[Decision_Status == &quot;Published&quot; &amp;&amp; Is_Current == true] sort by Published_At desc;\nisPublished = publishedRanks.count() &gt; 0;\n%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;--zcs-border-color:var(--zcs_tertiary_border_color)}\n.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-w-full{width:100%}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-20{font-size:1.25rem}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-box-border{box-sizing:border-box}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-no-shrink{flex-shrink:0}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-toast{border-radius:8px}.zcs-info-toast{background:#e4f6fd;color:#024361}.zcs-warning-toast{background:#fef4e5;color:#663c01}.zcs-success-toast{background:#edf7ed;color:#1d4620}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#126f50}.zcs-badge-filled-outline.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#174eb8}.zcs-badge-filled-outline.zcs-badge-yellow{background:#fcf4e6;border-color:#c67e00;color:#805200}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color,#e8e8ef)}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color,#635bff)}\n.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color,#ddd);background:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper th{background:#f9fafe;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color,#ddd) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color,#ddd)}\n.results-stage{font-family:Inter,Lato,Arial,sans-serif;background:radial-gradient(circle at 50% 0,#302b63 0,#14142d 38%,#f4f5fa 38.1%);min-height:100vh;padding:clamp(16px,3vw,42px);color:#15162d;box-sizing:border-box}.stage-shell{max-width:1440px;margin:auto}.stage-hero{position:relative;overflow:hidden;isolation:isolate;min-height:390px;border-radius:28px;padding:clamp(28px,6vw,76px);display:flex;align-items:center;justify-content:center;text-align:center;color:#fff;background:linear-gradient(135deg,#17172f,#3d2d76 55%,#7857d8);box-shadow:0 30px 70px rgba(10,10,35,.32)}.stage-hero:before,.stage-hero:after{content:&quot;&quot;;position:absolute;z-index:-1;inset:-30%;background:conic-gradient(from 90deg at 50% 100%,transparent 0 39%,rgba(255,224,138,.25) 40% 44%,transparent 45% 55%,rgba(255,255,255,.16) 56% 60%,transparent 61%);animation:spotlight 9s ease-in-out infinite alternate}.stage-hero:after{transform:rotate(35deg);animation-delay:-3s}.eyebrow{text-transform:uppercase;letter-spacing:.18em;font-size:12px;font-weight:800;color:#f9d982}.winner-icon{font-size:50px;color:#f6c85f;display:block;margin-bottom:12px}.winner-name{font-size:clamp(42px,8vw,96px);line-height:.94;letter-spacing:-.055em;margin:8px 0 16px}.winner-tagline{font-size:clamp(17px,2vw,25px);max-width:800px;margin:0 auto;color:#eeecfa}.hero-rationale{max-width:900px;margin:25px auto 0;padding:18px 22px;border:1px solid rgba(255,255,255,.22);border-radius:16px;background:rgba(10,10,35,.25);line-height:1.65}.confetti{position:absolute;inset:0;pointer-events:none}.confetti i{position:absolute;top:-12%;width:8px;height:18px;background:#f6c85f;animation:fall 6s linear infinite}.confetti i:nth-child(2n){background:#59d4c7;animation-duration:7.4s}.confetti i:nth-child(3n){background:#e976b5;transform:rotate(45deg);animation-duration:5.3s}.confetti i:nth-child(1){left:7%}.confetti i:nth-child(2){left:18%;animation-delay:-2s}.confetti i:nth-child(3){left:29%;animation-delay:-4s}.confetti i:nth-child(4){left:41%;animation-delay:-1s}.confetti i:nth-child(5){left:54%;animation-delay:-5s}.confetti i:nth-child(6){left:68%;animation-delay:-3s}.confetti i:nth-child(7){left:79%;animation-delay:-1.5s}.confetti i:nth-child(8){left:91%;animation-delay:-4.5s}@keyframes fall{to{top:112%;transform:translateX(80px) rotate(540deg)}}@keyframes spotlight{to{transform:rotate(18deg) scale(1.08)}}\n.section{margin-top:28px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:14px}.section-head h2{font-size:clamp(23px,3vw,34px);margin:0;letter-spacing:-.03em}.section-head p{margin:0;color:#64657a}.podium{display:grid;grid-template-columns:repeat(3,1fr);align-items:end;gap:16px;min-height:380px}.podium-card{text-align:center;padding:24px 18px 0;border-radius:20px 20px 8px 8px;color:#fff;box-shadow:0 16px 34px rgba(23,23,47,.18)}.podium-card.first{min-height:340px;background:linear-gradient(160deg,#6d4bd2,#322568)}.podium-card.second{min-height:280px;background:linear-gradient(160deg,#68738f,#343b50)}.podium-card.third{min-height:235px;background:linear-gradient(160deg,#b06e46,#704129)}.podium-rank{font-size:54px;font-weight:900;line-height:1}.podium-card h3{font-size:clamp(20px,2.4vw,31px);margin:14px 0 8px}.podium-card p{color:rgba(255,255,255,.78);margin:0}.rank-grid,.analysis-grid,.evidence-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.rank-card{padding:20px;position:relative;overflow:hidden}.rank-number{font-size:12px;font-weight:800;letter-spacing:.13em;color:#6952b9;text-transform:uppercase}.rank-card h3{margin:8px 0 6px;font-size:21px}.rank-card p{margin:0;color:#66677b}.badges{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.analysis-card{padding:22px}.analysis-card h3{margin:10px 0 8px}.analysis-card .prediction{font-size:24px;font-weight:800;color:#322568}.metric-list{display:grid;gap:13px}.metric-label{display:flex;justify-content:space-between;gap:12px;font-size:13px;margin-bottom:5px}.comparison-key{display:flex;gap:16px;font-size:12px}.key-dot:before{content:&quot;&quot;;display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px;background:#6952b9}.key-dot.judge:before{background:#19a389}.compare-bars{min-width:210px}.peerbar,.judgebar{height:7px;border-radius:9px;background:#6952b9;margin:3px 0}.judgebar{background:#19a389}.consensus{display:flex;flex-wrap:wrap;gap:12px}.consensus-card{flex:1 1 220px;padding:18px;display:flex;align-items:center;gap:12px}.consensus-card i{font-size:25px;color:#16845f}.lock-stage{min-height:75vh;display:grid;place-items:center;background:radial-gradient(circle at 50% 20%,#3d2d76,#111126);border-radius:28px;color:#fff;padding:32px;text-align:center;box-sizing:border-box}.lock-card{max-width:680px}.lock-card&gt;i{font-size:56px;color:#f6c85f}.lock-card h1{font-size:clamp(38px,7vw,72px);letter-spacing:-.05em;margin:20px 0 12px}.lock-card p{font-size:18px;color:#cfcee2;line-height:1.65}.pulse{width:12px;height:12px;border-radius:50%;background:#f6c85f;box-shadow:0 0 0 0 rgba(246,200,95,.5);animation:pulse 2s infinite}@keyframes pulse{70%{box-shadow:0 0 0 16px rgba(246,200,95,0)}}.empty-note{padding:20px;border:1px dashed #b9bac7;border-radius:12px;color:#66677b;background:#fafaff}.tie-note{margin-top:12px}.presentation-list{display:grid;gap:10px}.presentation-item{padding:14px 16px;border-left:4px solid #6952b9;background:#f8f7ff;border-radius:8px}.print-only{display:none}\n@media(max-width:900px){.rank-grid,.analysis-grid,.evidence-grid{grid-template-columns:1fr 1fr}.podium{grid-template-columns:1fr;align-items:stretch;min-height:0}.podium-card,.podium-card.first,.podium-card.second,.podium-card.third{min-height:180px}.podium-card.first{order:-1}}@media(max-width:600px){.results-stage{padding:10px}.rank-grid,.analysis-grid,.evidence-grid{grid-template-columns:1fr}.stage-hero{border-radius:18px;min-height:430px}.section-head{display:block}.section-head p{margin-top:6px}}\n@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}.confetti{display:none}}\n@media print{.results-stage{background:#fff;padding:0}.stage-hero{background:#fff;color:#111;box-shadow:none;border:2px solid #111;min-height:0}.winner-tagline,.podium-card p{color:#333}.confetti{display:none}.podium-card{background:#fff!important;color:#111!important;border:1px solid #333;box-shadow:none;min-height:140px!important}.zcs-card{break-inside:avoid}.print-only{display:block}.section{break-inside:avoid}}\n&lt;/style&gt;\n&lt;div class=&quot;results-stage&quot;&gt;\n&lt;div class=&quot;stage-shell&quot;&gt;\n&lt;%\nif(!isPublished)\n{\n\t\tapprovalCount = Final_Approvals[Decision == &quot;Approve&quot;].count();\n%&gt;\n\t&lt;section class=&quot;lock-stage&quot; aria-labelledby=&quot;locked-title&quot;&gt;\n\t\t&lt;div class=&quot;lock-card&quot;&gt;\n\t\t\t&lt;i class=&quot;zc-li-outline ui-1-lock&quot; aria-hidden=&quot;true&quot;&gt;&lt;/i&gt;\n\t\t\t&lt;div class=&quot;zcs-inline-flex zcs-align-items-center zcs-gap-12 zcs-py-12&quot;&gt;&lt;span class=&quot;pulse&quot;&gt;&lt;/span&gt;&lt;span class=&quot;eyebrow&quot;&gt;&lt;%=if(isJudge,&quot;Locked judge preview&quot;,&quot;Awaiting unanimous consensus&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;h1 id=&quot;locked-title&quot;&gt;The result is under wraps.&lt;/h1&gt;\n\t\t\t&lt;p&gt;&lt;%=if(isJudge,&quot;The final stage is ready. Rankings remain concealed until Siddarth, Monica, and Brandon approve the same unchanged version.&quot;,&quot;Peer votes, judge evidence, and the final recommendation are being reconciled. The stage opens automatically after unanimous publication.&quot;)%&gt;&lt;/p&gt;\n\t\t\t&lt;div class=&quot;zcs-toast zcs-info-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-lh-body&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-toast-icon zc-li-outline travel-info&quot;&gt;&lt;/i&gt;&lt;p class=&quot;zcs-m-0&quot;&gt;Publication safeguard active. &lt;%=if(isJudge,approvalCount + &quot; approval record(s) are currently recorded.&quot;,&quot;No draft ranking or individual judge score is visible in this view.&quot;)%&gt;&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/section&gt;\n&lt;%\n}\nelse\n{\n\t\tranking = publishedRanks;\n\t\twinner = ranking.Rank_1;\n\t\twinnerEvals = Judge_Evaluations[Application == winner.ID &amp;&amp; (Evaluation_Status == &quot;Submitted&quot; || Evaluation_Status == &quot;Locked&quot;)];\n\t\twinnerUI = ifnull(winnerEvals.avg(UI_Score),0);\n\t\twinnerNav = ifnull(winnerEvals.avg(Navigation_Usability_Score),0);\n\t\twinnerCore = ifnull(winnerEvals.avg(Core_Functionality_Score),0);\n\t\twinnerInnovation = ifnull(winnerEvals.avg(Innovation_Score),0);\n\t\twinnerProof = ifnull(winnerEvals.avg(Beyond_Creator_Proof_Score),0);\n\t\twinnerIntegration = ifnull(winnerEvals.avg(Catalyst_Integrations_Score),0);\n\t\twinnerPresentation = ifnull(winnerEvals.avg(Presentation_Score),0);\n\t\taiRows = AI_Analyses[Is_Latest == true &amp;&amp; Analysis_Status == &quot;Completed&quot;] sort by Requested_At desc;\n%&gt;\n\t&lt;header class=&quot;stage-hero&quot; aria-labelledby=&quot;winner-title&quot;&gt;\n\t\t&lt;div class=&quot;confetti&quot; aria-hidden=&quot;true&quot;&gt;&lt;i&gt;&lt;/i&gt;&lt;i&gt;&lt;/i&gt;&lt;i&gt;&lt;/i&gt;&lt;i&gt;&lt;/i&gt;&lt;i&gt;&lt;/i&gt;&lt;i&gt;&lt;/i&gt;&lt;i&gt;&lt;/i&gt;&lt;i&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;span class=&quot;winner-icon zc-li-solid sport-trophy&quot; aria-hidden=&quot;true&quot;&gt;&lt;/span&gt;\n\t\t\t&lt;div class=&quot;eyebrow&quot;&gt;Om.ai Beyond Limits Challenge winner&lt;/div&gt;\n\t\t\t&lt;h1 class=&quot;winner-name&quot; id=&quot;winner-title&quot;&gt;&lt;%=winner.App_Name%&gt;&lt;/h1&gt;\n\t\t\t&lt;p class=&quot;winner-tagline&quot;&gt;&lt;%=winner.Tagline%&gt;&lt;/p&gt;\n\t\t\t&lt;div class=&quot;hero-rationale&quot;&gt;&lt;%=ranking.Winner_Rationale%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;badges zcs-justify-center&quot;&gt;\n\t\t\t\t&lt;% if(winner.Catalyst_Connected == true) { %&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-green zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-14&quot;&gt;Catalyst connected&lt;/span&gt;&lt;/span&gt;&lt;% } %&gt;\n\t\t\t\t&lt;% if(ifnull(winner.Other_Integrations,&quot;&quot;) != &quot;&quot;) { %&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-share-66&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-14&quot;&gt;Extended integrations&lt;/span&gt;&lt;/span&gt;&lt;% } %&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/header&gt;\n\n\t&lt;section class=&quot;section&quot; aria-labelledby=&quot;podium-title&quot;&gt;&lt;div class=&quot;section-head&quot;&gt;&lt;div&gt;&lt;h2 id=&quot;podium-title&quot;&gt;The podium&lt;/h2&gt;&lt;p&gt;The top three applications selected from the complete evidence set.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;podium&quot;&gt;\n\t\t\t&lt;article class=&quot;podium-card second&quot;&gt;&lt;div class=&quot;podium-rank&quot;&gt;2&lt;/div&gt;&lt;h3&gt;&lt;%=ranking.Rank_2.App_Name%&gt;&lt;/h3&gt;&lt;p&gt;&lt;%=ranking.Rank_2.Tagline%&gt;&lt;/p&gt;&lt;/article&gt;\n\t\t\t&lt;article class=&quot;podium-card first&quot;&gt;&lt;i class=&quot;zc-li-solid sport-trophy zcs-font-30&quot;&gt;&lt;/i&gt;&lt;div class=&quot;podium-rank&quot;&gt;1&lt;/div&gt;&lt;h3&gt;&lt;%=ranking.Rank_1.App_Name%&gt;&lt;/h3&gt;&lt;p&gt;&lt;%=ranking.Rank_1.Tagline%&gt;&lt;/p&gt;&lt;/article&gt;\n\t\t\t&lt;article class=&quot;podium-card third&quot;&gt;&lt;div class=&quot;podium-rank&quot;&gt;3&lt;/div&gt;&lt;h3&gt;&lt;%=ranking.Rank_3.App_Name%&gt;&lt;/h3&gt;&lt;p&gt;&lt;%=ranking.Rank_3.Tagline%&gt;&lt;/p&gt;&lt;/article&gt;\n\t\t&lt;/div&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;section&quot; aria-labelledby=&quot;ranking-title&quot;&gt;&lt;div class=&quot;section-head&quot;&gt;&lt;div&gt;&lt;h2 id=&quot;ranking-title&quot;&gt;Complete final ranking&lt;/h2&gt;&lt;p&gt;All nine finalists, in the unanimously published order.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;rank-grid&quot;&gt;\n\t\t\t&lt;article class=&quot;zcs-card rank-card&quot;&gt;&lt;div class=&quot;rank-number&quot;&gt;Place 1&lt;/div&gt;&lt;h3&gt;&lt;%=ranking.Rank_1.App_Name%&gt;&lt;/h3&gt;&lt;p&gt;&lt;%=ranking.Rank_1.Tagline%&gt;&lt;/p&gt;&lt;/article&gt;\n\t\t\t&lt;article class=&quot;zcs-card rank-card&quot;&gt;&lt;div class=&quot;rank-number&quot;&gt;Place 2&lt;/div&gt;&lt;h3&gt;&lt;%=ranking.Rank_2.App_Name%&gt;&lt;/h3&gt;&lt;p&gt;&lt;%=ranking.Rank_2.Tagline%&gt;&lt;/p&gt;&lt;/article&gt;\n\t\t\t&lt;article class=&quot;zcs-card rank-card&quot;&gt;&lt;div class=&quot;rank-number&quot;&gt;Place 3&lt;/div&gt;&lt;h3&gt;&lt;%=ranking.Rank_3.App_Name%&gt;&lt;/h3&gt;&lt;p&gt;&lt;%=ranking.Rank_3.Tagline%&gt;&lt;/p&gt;&lt;/article&gt;\n\t\t\t&lt;article class=&quot;zcs-card rank-card&quot;&gt;&lt;div class=&quot;rank-number&quot;&gt;Place 4&lt;/div&gt;&lt;h3&gt;&lt;%=ranking.Rank_4.App_Name%&gt;&lt;/h3&gt;&lt;p&gt;&lt;%=ranking.Rank_4.Tagline%&gt;&lt;/p&gt;&lt;/article&gt;\n\t\t\t&lt;article class=&quot;zcs-card rank-card&quot;&gt;&lt;div class=&quot;rank-number&quot;&gt;Place 5&lt;/div&gt;&lt;h3&gt;&lt;%=ranking.Rank_5.App_Name%&gt;&lt;/h3&gt;&lt;p&gt;&lt;%=ranking.Rank_5.Tagline%&gt;&lt;/p&gt;&lt;/article&gt;\n\t\t\t&lt;article class=&quot;zcs-card rank-card&quot;&gt;&lt;div class=&quot;rank-number&quot;&gt;Place 6&lt;/div&gt;&lt;h3&gt;&lt;%=ranking.Rank_6.App_Name%&gt;&lt;/h3&gt;&lt;p&gt;&lt;%=ranking.Rank_6.Tagline%&gt;&lt;/p&gt;&lt;/article&gt;\n\t\t\t&lt;article class=&quot;zcs-card rank-card&quot;&gt;&lt;div class=&quot;rank-number&quot;&gt;Place 7&lt;/div&gt;&lt;h3&gt;&lt;%=ranking.Rank_7.App_Name%&gt;&lt;/h3&gt;&lt;p&gt;&lt;%=ranking.Rank_7.Tagline%&gt;&lt;/p&gt;&lt;/article&gt;\n\t\t\t&lt;article class=&quot;zcs-card rank-card&quot;&gt;&lt;div class=&quot;rank-number&quot;&gt;Place 8&lt;/div&gt;&lt;h3&gt;&lt;%=ranking.Rank_8.App_Name%&gt;&lt;/h3&gt;&lt;p&gt;&lt;%=ranking.Rank_8.Tagline%&gt;&lt;/p&gt;&lt;/article&gt;\n\t\t\t&lt;article class=&quot;zcs-card rank-card&quot;&gt;&lt;div class=&quot;rank-number&quot;&gt;Place 9&lt;/div&gt;&lt;h3&gt;&lt;%=ranking.Rank_9.App_Name%&gt;&lt;/h3&gt;&lt;p&gt;&lt;%=ranking.Rank_9.Tagline%&gt;&lt;/p&gt;&lt;/article&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-toast zcs-info-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-lh-body tie-note&quot;&gt;&lt;i class=&quot;zc-li-outline travel-info&quot;&gt;&lt;/i&gt;&lt;p class=&quot;zcs-m-0&quot;&gt;Final positions reflect the published judge decision. Any source-data tie is resolved by the documented rationale and, when available, the AI tie-break explanation below.&lt;/p&gt;&lt;/div&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;section&quot; aria-labelledby=&quot;evidence-title&quot;&gt;&lt;div class=&quot;section-head&quot;&gt;&lt;div&gt;&lt;h2 id=&quot;evidence-title&quot;&gt;Evidence comparison&lt;/h2&gt;&lt;p&gt;Peer Borda support versus submitted judge weighted scores.&lt;/p&gt;&lt;/div&gt;&lt;div class=&quot;comparison-key&quot;&gt;&lt;span class=&quot;key-dot&quot;&gt;Peer&lt;/span&gt;&lt;span class=&quot;key-dot judge&quot;&gt;Judges&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&quot;&gt;Application&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&quot;&gt;Peer points&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&quot;&gt;Judge score&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&quot;&gt;Relative strength&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\nballotCount = Participant_Ballots[Ballot_Status == &quot;Submitted&quot; || Ballot_Status == &quot;Locked&quot;].count();\npeerMax = ballotCount * 8;\nfor each appRow in Applications[Submission_Status == &quot;Submitted&quot; || Submission_Status == &quot;Locked&quot;]\n{\n\t\tpeerPoints = Participant_Ballots[(Ballot_Status == &quot;Submitted&quot; || Ballot_Status == &quot;Locked&quot;) &amp;&amp; Rank_1 == appRow.ID].count() * 8;\n\t\tpeerPoints = peerPoints + Participant_Ballots[(Ballot_Status == &quot;Submitted&quot; || Ballot_Status == &quot;Locked&quot;) &amp;&amp; Rank_2 == appRow.ID].count() * 7;\n\t\tpeerPoints = peerPoints + Participant_Ballots[(Ballot_Status == &quot;Submitted&quot; || Ballot_Status == &quot;Locked&quot;) &amp;&amp; Rank_3 == appRow.ID].count() * 6;\n\t\tpeerPoints = peerPoints + Participant_Ballots[(Ballot_Status == &quot;Submitted&quot; || Ballot_Status == &quot;Locked&quot;) &amp;&amp; Rank_4 == appRow.ID].count() * 5;\n\t\tpeerPoints = peerPoints + Participant_Ballots[(Ballot_Status == &quot;Submitted&quot; || Ballot_Status == &quot;Locked&quot;) &amp;&amp; Rank_5 == appRow.ID].count() * 4;\n\t\tpeerPoints = peerPoints + Participant_Ballots[(Ballot_Status == &quot;Submitted&quot; || Ballot_Status == &quot;Locked&quot;) &amp;&amp; Rank_6 == appRow.ID].count() * 3;\n\t\tpeerPoints = peerPoints + Participant_Ballots[(Ballot_Status == &quot;Submitted&quot; || Ballot_Status == &quot;Locked&quot;) &amp;&amp; Rank_7 == appRow.ID].count() * 2;\n\t\tpeerPoints = peerPoints + Participant_Ballots[(Ballot_Status == &quot;Submitted&quot; || Ballot_Status == &quot;Locked&quot;) &amp;&amp; Rank_8 == appRow.ID].count();\n\t\tjudgeRows = Judge_Evaluations[Application == appRow.ID &amp;&amp; (Evaluation_Status == &quot;Submitted&quot; || Evaluation_Status == &quot;Locked&quot;)];\n\t\tjudgeAverage = ifnull(judgeRows.avg(Weighted_Total),0);\n\t\tpeerPercent = if(peerMax &gt; 0,(peerPoints * 100 / peerMax),0);\n%&gt;\n\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;strong&gt;&lt;%=appRow.App_Name%&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&quot;&gt;&lt;%=peerPoints%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&quot;&gt;&lt;%=judgeAverage.round(1)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;div class=&quot;compare-bars&quot; aria-label=&quot;Peer &lt;%=peerPercent%&gt; percent; judges &lt;%=judgeAverage%&gt; percent&quot;&gt;&lt;div class=&quot;peerbar&quot; style=&quot;width:&lt;%=peerPercent%&gt;%&quot;&gt;&lt;/div&gt;&lt;div class=&quot;judgebar&quot; style=&quot;width:&lt;%=judgeAverage%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;% } %&gt;\n\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;section&quot; aria-labelledby=&quot;strength-title&quot;&gt;&lt;div class=&quot;section-head&quot;&gt;&lt;div&gt;&lt;h2 id=&quot;strength-title&quot;&gt;Winner category strengths&lt;/h2&gt;&lt;p&gt;Average judge scores, rendered without client-side scripts.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% if(winnerEvals.count() &gt; 0) { %&gt;\n\t\t&lt;div class=&quot;zcs-card zcs-p-24 metric-list&quot;&gt;\n&lt;%\nlabels = {&quot;Interface&quot;,&quot;Navigation and usability&quot;,&quot;Core functionality&quot;,&quot;Innovation&quot;,&quot;Beyond Creator proof&quot;,&quot;Catalyst and integrations&quot;,&quot;Presentation&quot;};\nvalues = {winnerUI,winnerNav,winnerCore,winnerInnovation,winnerProof,winnerIntegration,winnerPresentation};\nfor each index c in labels\n{\n\t\tcategoryValue = values.get(c);\n%&gt;&lt;div class=&quot;zcs-progress-bar-wrapper&quot;&gt;&lt;div class=&quot;metric-label&quot;&gt;&lt;span&gt;&lt;%=labels.get(c)%&gt;&lt;/span&gt;&lt;strong&gt;&lt;%=categoryValue.round(1)%&gt; / 10&lt;/strong&gt;&lt;/div&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=categoryValue * 10%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t&lt;/div&gt;\n&lt;% } else { %&gt;&lt;div class=&quot;empty-note&quot;&gt;&lt;i class=&quot;zc-li-outline travel-info&quot;&gt;&lt;/i&gt; No submitted category analysis is available for the winner.&lt;/div&gt;&lt;% } %&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;section&quot; aria-labelledby=&quot;ai-title&quot;&gt;&lt;div class=&quot;section-head&quot;&gt;&lt;div&gt;&lt;h2 id=&quot;ai-title&quot;&gt;AI prediction lens&lt;/h2&gt;&lt;p&gt;Predictions support the human decision; they do not publish it.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% if(aiRows.count() &gt; 0) { ai = aiRows; %&gt;\n\t\t&lt;div class=&quot;analysis-grid&quot;&gt;\n\t\t\t&lt;article class=&quot;zcs-card analysis-card&quot;&gt;&lt;i class=&quot;zc-li-outline users-wm&quot; aria-hidden=&quot;true&quot;&gt;&lt;/i&gt;&lt;h3&gt;Team-vote prediction&lt;/h3&gt;&lt;div class=&quot;prediction&quot;&gt;&lt;%=ifnull(ai.Team_Vote_Predicted_Winner.App_Name,&quot;Not returned&quot;)%&gt;&lt;/div&gt;&lt;p&gt;&lt;%=ifnull(ai.Team_Analysis,&quot;No team analysis was returned.&quot;)%&gt;&lt;/p&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=ifnull(ai.Team_Confidence,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;small&gt;&lt;%=ifnull(ai.Team_Confidence,0)%&gt;% confidence&lt;/small&gt;&lt;/article&gt;\n\t\t\t&lt;article class=&quot;zcs-card analysis-card&quot;&gt;&lt;i class=&quot;zc-li-outline business-chart-bar-32&quot; aria-hidden=&quot;true&quot;&gt;&lt;/i&gt;&lt;h3&gt;Judge-score prediction&lt;/h3&gt;&lt;div class=&quot;prediction&quot;&gt;&lt;%=ifnull(ai.Judge_Score_Predicted_Winner.App_Name,&quot;Not returned&quot;)%&gt;&lt;/div&gt;&lt;p&gt;&lt;%=ifnull(ai.Judge_Analysis,&quot;No judge analysis was returned.&quot;)%&gt;&lt;/p&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=ifnull(ai.Judge_Confidence,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;small&gt;&lt;%=ifnull(ai.Judge_Confidence,0)%&gt;% confidence&lt;/small&gt;&lt;/article&gt;\n\t\t\t&lt;article class=&quot;zcs-card analysis-card&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot; aria-hidden=&quot;true&quot;&gt;&lt;/i&gt;&lt;h3&gt;Overall recommendation&lt;/h3&gt;&lt;div class=&quot;prediction&quot;&gt;&lt;%=ifnull(ai.Overall_Recommended_Winner.App_Name,&quot;Not returned&quot;)%&gt;&lt;/div&gt;&lt;p&gt;&lt;%=ifnull(ai.Consensus_And_Disagreement,&quot;No consensus analysis was returned.&quot;)%&gt;&lt;/p&gt;&lt;div class=&quot;zcs-toast zcs-info-toast zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12&quot;&gt;&lt;i class=&quot;zc-li-outline travel-info&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=ifnull(ai.Tie_Break_Explanation,&quot;No tie-break analysis was required or supplied.&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/article&gt;\n\t\t&lt;/div&gt;\n&lt;% } else { %&gt;&lt;div class=&quot;empty-note&quot;&gt;&lt;i class=&quot;zc-li-outline travel-info&quot;&gt;&lt;/i&gt; No completed latest AI analysis is available. The published human ranking remains authoritative.&lt;/div&gt;&lt;% } %&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;section&quot; aria-labelledby=&quot;consensus-title&quot;&gt;&lt;div class=&quot;section-head&quot;&gt;&lt;div&gt;&lt;h2 id=&quot;consensus-title&quot;&gt;Unanimous consensus&lt;/h2&gt;&lt;p&gt;Independent approval of this published ranking version.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;consensus&quot;&gt;\n&lt;%\njudgeNames = {&quot;Siddarth&quot;,&quot;Monica&quot;,&quot;Brandon&quot;};\nfor each judgeName in judgeNames\n{\n\t\tnamedJudge = Members[Member_Name == judgeName &amp;&amp; Member_Type == &quot;Judge&quot; &amp;&amp; Is_Active == true];\n\t\tapproved = Final_Approvals[Final_Ranking == ranking.ID &amp;&amp; Judge == namedJudge.ID &amp;&amp; Decision == &quot;Approve&quot;].count() &gt; 0;\n%&gt;&lt;article class=&quot;zcs-card consensus-card&quot;&gt;&lt;i class=&quot;zc-li-outline &lt;%=if(approved,&quot;ui-1-check-circle-08&quot;,&quot;ui-1-circle-remove&quot;)%&gt;&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;&lt;%=judgeName%&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-color-secondary zcs-font-14&quot;&gt;&lt;%=if(approved,&quot;Approved published version&quot;,&quot;Approval evidence missing&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/article&gt;&lt;% } %&gt;\n\t\t&lt;/div&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;section evidence-grid&quot; aria-label=&quot;Presentation and integration highlights&quot;&gt;\n\t\t&lt;article class=&quot;zcs-card zcs-p-24&quot;&gt;&lt;h2&gt;Presentation highlight&lt;/h2&gt;&lt;p&gt;&lt;%=winner.Presentation_Summary%&gt;&lt;/p&gt;&lt;div class=&quot;presentation-list&quot;&gt;&lt;% for each slot in Presentation_Slots[Application == winner.ID] { %&gt;&lt;div class=&quot;presentation-item&quot;&gt;&lt;strong&gt;&lt;%=slot.Presentation_Status%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span&gt;&lt;%=slot.Slot_Start%&gt; to &lt;%=slot.Slot_End%&gt;&lt;/span&gt;&lt;% if(ifnull(slot.Room_Or_Link,&quot;&quot;) != &quot;&quot;) { %&gt;&lt;br&gt;&lt;span&gt;&lt;%=slot.Room_Or_Link%&gt;&lt;/span&gt;&lt;% } %&gt;&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;&lt;/article&gt;\n\t\t&lt;article class=&quot;zcs-card zcs-p-24&quot;&gt;&lt;h2&gt;Beyond Creator evidence&lt;/h2&gt;&lt;div&gt;&lt;%=winner.Beyond_Creator_Capability%&gt;&lt;/div&gt;&lt;p&gt;&lt;strong&gt;Why it goes beyond:&lt;/strong&gt; &lt;%=winner.Why_Not_Feasible_In_Creator%&gt;&lt;/p&gt;&lt;/article&gt;\n\t\t&lt;article class=&quot;zcs-card zcs-p-24&quot;&gt;&lt;h2&gt;Integration profile&lt;/h2&gt;&lt;div class=&quot;badges&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%=if(winner.Catalyst_Connected,&quot;zcs-badge-green&quot;,&quot;zcs-badge-yellow&quot;)%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2&quot;&gt;&lt;i class=&quot;zc-li-outline &lt;%=if(winner.Catalyst_Connected,&quot;ui-1-check-circle-08&quot;,&quot;travel-info&quot;)%&gt;&quot;&gt;&lt;/i&gt;&lt;span&gt;Catalyst &lt;%=if(winner.Catalyst_Connected,&quot;connected&quot;,&quot;not declared&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;p&gt;&lt;%=ifnull(winner.Other_Integrations,&quot;No additional integrations were declared.&quot;)%&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Published:&lt;/strong&gt; &lt;%=ranking.Published_At%&gt;&lt;/p&gt;&lt;/article&gt;\n\t&lt;/section&gt;\n\t&lt;p class=&quot;print-only&quot;&gt;Official published results for &lt;%=if(settings.count() &gt; 0,settings.Challenge_Title,&quot;Om.ai Beyond Limits Challenge&quot;)%&gt;.&lt;/p&gt;\n&lt;% } %&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Process_AI_Analysis as "Process AI Analysis"
			{
			    type = form
			    form = AI_Analyses
			    record event = on add
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                try
			                {
			                    update AI_Analyses[ID != input.ID && Is_Latest == true]
			                    [
			                        Is_Latest = false
			                    ];
			                    submitted_apps = Applications[Submission_Status == "Submitted" || Submission_Status == "Locked"];
			                    active_participants = Members[Member_Type == "Participant" && Is_Active == true];
			                    active_judges = Members[Member_Type == "Judge" && Is_Active == true];
			                    submitted_ballots = Participant_Ballots[Ballot_Status == "Submitted" || Ballot_Status == "Locked"];
			                    submitted_scores = Judge_Evaluations[Evaluation_Status == "Submitted" || Evaluation_Status == "Locked"];
			                    expected_scores = submitted_apps.count() * active_judges.count();
			                    if(submitted_apps.count() == 0 || active_participants.count() == 0 || active_judges.count() == 0 || submitted_ballots.count() != active_participants.count() || submitted_scores.count() != expected_scores)
			                    {
			                        update AI_Analyses[ID == input.ID]
			                        [
			                            Analysis_Status = "Failed"
			                            Failure_Message = "Analysis was not run because submitted ballots or judge scorecards are incomplete."
			                        ];
			                    }
			                    else
			                    {
			                        app_evidence = List();
			                        for each app in submitted_apps
			                        {
			                            app_id = app.ID.toString();
			                            borda = 0;
			                            ranks = Map();
			                            ranks.put("rank_1",0);
			                            ranks.put("rank_2",0);
			                            ranks.put("rank_3",0);
			                            ranks.put("rank_4",0);
			                            ranks.put("rank_5",0);
			                            ranks.put("rank_6",0);
			                            ranks.put("rank_7",0);
			                            ranks.put("rank_8",0);
			                            peer_rationales = List();
			                            for each ballot in submitted_ballots
			                            {
			                                if(ballot.Rank_1 == app.ID) { borda = borda + 8; ranks.put("rank_1",ranks.get("rank_1") + 1); peer_rationales.add(ballot.Best_App_Explanation); }
			                                if(ballot.Rank_2 == app.ID) { borda = borda + 7; ranks.put("rank_2",ranks.get("rank_2") + 1); }
			                                if(ballot.Rank_3 == app.ID) { borda = borda + 6; ranks.put("rank_3",ranks.get("rank_3") + 1); }
			                                if(ballot.Rank_4 == app.ID) { borda = borda + 5; ranks.put("rank_4",ranks.get("rank_4") + 1); }
			                                if(ballot.Rank_5 == app.ID) { borda = borda + 4; ranks.put("rank_5",ranks.get("rank_5") + 1); }
			                                if(ballot.Rank_6 == app.ID) { borda = borda + 3; ranks.put("rank_6",ranks.get("rank_6") + 1); }
			                                if(ballot.Rank_7 == app.ID) { borda = borda + 2; ranks.put("rank_7",ranks.get("rank_7") + 1); }
			                                if(ballot.Rank_8 == app.ID) { borda = borda + 1; ranks.put("rank_8",ranks.get("rank_8") + 1); }
			                            }
			                            app_scores = Judge_Evaluations[Application == app.ID && (Evaluation_Status == "Submitted" || Evaluation_Status == "Locked")];
			                            total_weighted = 0.0;
			                            ui_total = 0.0;
			                            nav_total = 0.0;
			                            core_total = 0.0;
			                            innovation_total = 0.0;
			                            proof_total = 0.0;
			                            integration_total = 0.0;
			                            presentation_total = 0.0;
			                            for each score in app_scores
			                            {
			                                total_weighted = total_weighted + score.Weighted_Total;
			                                ui_total = ui_total + score.UI_Score;
			                                nav_total = nav_total + score.Navigation_Usability_Score;
			                                core_total = core_total + score.Core_Functionality_Score;
			                                innovation_total = innovation_total + score.Innovation_Score;
			                                proof_total = proof_total + score.Beyond_Creator_Proof_Score;
			                                integration_total = integration_total + score.Catalyst_Integrations_Score;
			                                presentation_total = presentation_total + score.Presentation_Score;
			                            }
			                            score_count = app_scores.count();
			                            weighted_average = total_weighted / score_count;
			                            variance_total = 0.0;
			                            for each score_for_variance in app_scores
			                            {
			                                variance_total = variance_total + ((score_for_variance.Weighted_Total - weighted_average) * (score_for_variance.Weighted_Total - weighted_average));
			                            }
			                            category_averages = Map();
			                            category_averages.put("ui",ui_total / score_count);
			                            category_averages.put("navigation_usability",nav_total / score_count);
			                            category_averages.put("core_functionality",core_total / score_count);
			                            category_averages.put("innovation",innovation_total / score_count);
			                            category_averages.put("beyond_creator_proof",proof_total / score_count);
			                            category_averages.put("catalyst_integrations",integration_total / score_count);
			                            category_averages.put("presentation",presentation_total / score_count);
			                            evidence = Map();
			                            evidence.put("application_id",app_id);
			                            evidence.put("app_name",app.App_Name);
			                            evidence.put("tagline",app.Tagline);
			                            evidence.put("problem_statement",app.Problem_Statement);
			                            evidence.put("beyond_creator_capability",app.Beyond_Creator_Capability);
			                            evidence.put("presentation_summary",app.Presentation_Summary);
			                            evidence.put("borda_points",borda);
			                            evidence.put("rank_distribution",ranks);
			                            evidence.put("peer_best_app_rationales",peer_rationales);
			                            evidence.put("judge_weighted_average",weighted_average);
			                            evidence.put("judge_weighted_variance",variance_total / score_count);
			                            evidence.put("category_averages",category_averages);
			                            app_evidence.add(evidence);
			                        }
			                        settings = AI_Settings[Is_Current == true && Is_Enabled == true];
			                        if(settings.count() != 1 || settings.API_Key == null || settings.API_Key == "")
			                        {
			                            update AI_Analyses[ID == input.ID]
			                            [
			                                Analysis_Status = "Failed"
			                                Failure_Message = "No complete, current, enabled AI configuration is available."
			                            ];
			                        }
			                        else
			                        {
			                            payload_evidence = Map();
			                            payload_evidence.put("applications",app_evidence);
			                            payload_evidence.put("ballot_count",submitted_ballots.count());
			                            payload_evidence.put("judge_count",active_judges.count());
			                            payload_evidence.put("required_output",{"team_vote_winner_app_name","judge_score_winner_app_name","overall_recommended_winner_app_name","team_confidence","judge_confidence","team_analysis","judge_analysis","consensus_and_disagreement","tie_break_explanation"});
			                            user_message = "Analyze only the supplied evidence. Return one JSON object using every required_output key. Winner values must exactly match an app_name. Confidence values must be numeric from 0 to 100. Do not invent facts. Evidence: " + payload_evidence.toString();
			                            messages = List();
			                            messages.add({"role":"system","content":settings.System_Prompt});
			                            messages.add({"role":"user","content":user_message});
			                            request_body = Map();
			                            request_body.put("model",settings.Model_Name);
			                            request_body.put("temperature",settings.Temperature);
			                            request_body.put("max_tokens",settings.Max_Tokens);
			                            request_body.put("response_format",{"type":"json_object"});
			                            request_body.put("messages",messages);
			                            endpoint = settings.Base_URL.toString();
			                            if(!endpoint.endsWith("/")) { endpoint = endpoint + "/"; }
			                            endpoint = endpoint + "chat/completions";
			                            headers = Map();
			                            headers.put("Content-Type","application/json");
			                            headers.put("Authorization","Bearer " + settings.API_Key);
			                            api_response = invokeUrl
			                            [
			                                url: endpoint
			                                type: POST
			                                headers: headers
			                                body: request_body.toString()
			                                detailed: true
			                            ];
			                            if(api_response.get("responseCode") < 200 || api_response.get("responseCode") >= 300)
			                            {
			                                update AI_Analyses[ID == input.ID]
			                                [
			                                    Analysis_Status = "Failed"
			                                    Failure_Message = "The AI service returned a non-success HTTP status."
			                                ];
			                            }
			                            else
			                            {
			                                response_body = api_response.get("responseText");
			                                choices = response_body.getJSON("choices");
			                                content = choices.get(0).get("message").get("content");
			                                team_name = content.getJSON("team_vote_winner_app_name");
			                                judge_name = content.getJSON("judge_score_winner_app_name");
			                                overall_name = content.getJSON("overall_recommended_winner_app_name");
			                                team_app = Applications[App_Name == team_name && (Submission_Status == "Submitted" || Submission_Status == "Locked")];
			                                judge_app = Applications[App_Name == judge_name && (Submission_Status == "Submitted" || Submission_Status == "Locked")];
			                                overall_app = Applications[App_Name == overall_name && (Submission_Status == "Submitted" || Submission_Status == "Locked")];
			                                team_confidence = content.getJSON("team_confidence");
			                                judge_confidence = content.getJSON("judge_confidence");
			                                if(team_app.count() != 1 || judge_app.count() != 1 || overall_app.count() != 1 || team_confidence == null || judge_confidence == null || team_confidence < 0 || team_confidence > 100 || judge_confidence < 0 || judge_confidence > 100)
			                                {
			                                    update AI_Analyses[ID == input.ID]
			                                    [
			                                        Analysis_Status = "Failed"
			                                        Failure_Message = "The AI response failed winner or confidence validation."
			                                        Full_AI_Response = content
			                                    ];
			                                }
			                                else
			                                {
			                                    update AI_Analyses[ID != input.ID && Is_Latest == true]
			                                    [
			                                        Is_Latest = false
			                                    ];
			                                    update AI_Analyses[ID == input.ID]
			                                    [
			                                        Analysis_Status = "Completed"
			                                        Team_Vote_Predicted_Winner = team_app.ID
			                                        Judge_Score_Predicted_Winner = judge_app.ID
			                                        Overall_Recommended_Winner = overall_app.ID
			                                        Team_Confidence = team_confidence
			                                        Judge_Confidence = judge_confidence
			                                        Team_Analysis = content.getJSON("team_analysis")
			                                        Judge_Analysis = content.getJSON("judge_analysis")
			                                        Consensus_And_Disagreement = content.getJSON("consensus_and_disagreement")
			                                        Tie_Break_Explanation = content.getJSON("tie_break_explanation")
			                                        Full_AI_Response = content
			                                        Failure_Message = ""
			                                        Is_Latest = true
			                                    ];
			                                    insert into Audit_Log
			                                    [
			                                        Event_Time = zoho.currenttime
			                                        Actor_Email = input.Requested_By
			                                        Event_Type = "AI Run"
			                                        Related_Form = "AI_Analyses"
			                                        Related_Record_ID = input.ID.toString()
			                                        Event_Summary = "Completed explainable AI analysis from complete peer and judge evidence."
			                                        Severity = "Info"
			                                    ]
			                                }
			                            }
			                        }
			                    }
			                }
			                catch(error)
			                {
			                    update AI_Analyses[ID == input.ID]
			                    [
			                        Analysis_Status = "Failed"
			                        Failure_Message = "The analysis could not be completed because the service response was unavailable or malformed."
			                    ];
			                }
			            )
			        }
			    }
			}

			Validate_AI_Analysis_Request as "Validate AI Analysis Request"
			{
			    type = form
			    form = AI_Analyses
			    record event = on add
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                judges = Members[Login_Email == zoho.loginuser && Member_Type == "Judge" && Is_Active == true];
			                if(judges.count() != 1)
			                {
			                    alert "Only an active, mapped judge can request AI analysis.";
			                    cancel submit;
			                }
			                input.Requested_By = zoho.loginuser;
			                input.Requested_At = zoho.currenttime;
			                input.Analysis_Status = "Queued";
			                input.Is_Latest = true;
			            )
			        }
			    }
			}

			Secure_AI_Settings_On_Load as "Secure AI Settings On Load"
			{
			    type = form
			    form = AI_Settings
			    record event = on add or edit
			    description = "Keeps the API credential administrator-only and protects workflow-maintained test diagnostics."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                if(current_profile != "Administrator")
			                {
			                    hide API_Key;
			                    disable API_Key;
			                }
			                disable Last_Tested_At;
			                disable Last_Test_Status;
			            )
			        }
			    }
			}

			Test_AI_Configuration as "Test AI Configuration"
			{
			    type = functions
			    form = AI_Settings
			    execution type = for each record
			    description = "Tests the current OpenAI-compatible chat-completions service without exposing its credential or response content."
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                if(current_profile != "Administrator" && current_profile != "Judge")
			                {
			                    test_result_message = "Only administrators or judges may test the AI configuration.";
			                }
			                else if(input.Is_Current != true)
			                {
			                    test_result_message = "Only the current AI configuration can be tested.";
			                }
			                else if(input.Is_Enabled != true)
			                {
			                    input.Last_Tested_At = zoho.currenttime;
			                    input.Last_Test_Status = "NOT TESTED: Current configuration is disabled.";
			                }
			                else if(input.Base_URL == null || input.Model_Name == null || input.API_Key == null || input.API_Key == "")
			                {
			                    input.Last_Tested_At = zoho.currenttime;
			                    input.Last_Test_Status = "NOT TESTED: Endpoint, model, or credential is missing.";
			                }
			                else
			                {
			                    endpoint = input.Base_URL.toString();
			                    if(endpoint.endsWith("/"))
			                    {
			                        endpoint = endpoint.subString(0,endpoint.length() - 1);
			                    }
			                    if(!endpoint.endsWith("/chat/completions"))
			                    {
			                        endpoint = endpoint + "/chat/completions";
			                    }
			                    headers_map = Map();
			                    headers_map.put("Content-Type","application/json");
			                    headers_map.put("Authorization","Bearer " + input.API_Key);
			                    system_message = Map();
			                    system_message.put("role","system");
			                    system_message.put("content",input.System_Prompt);
			                    user_message = Map();
			                    user_message.put("role","user");
			                    user_message.put("content","Reply with exactly OK. This is a configuration connectivity test; do not analyze challenge data.");
			                    message_list = List();
			                    message_list.add(system_message);
			                    message_list.add(user_message);
			                    request_body = Map();
			                    request_body.put("model",input.Model_Name);
			                    request_body.put("temperature",input.Temperature);
			                    request_body.put("max_tokens",10);
			                    request_body.put("messages",message_list);
			                    test_time = zoho.currenttime;
			                    try
			                    {
			                        api_response = invokeUrl
			                        [
			                            url: endpoint
			                            type: POST
			                            headers: headers_map
			                            body: request_body.toString()
			                            detailed: true
			                        ];
			                        response_code = api_response.get("responseCode");
			                        input.Last_Tested_At = test_time;
			                        if(response_code >= 200 && response_code < 300)
			                        {
			                            input.Last_Test_Status = "SUCCESS: Service responded with HTTP " + response_code.toString() + ".";
			                        }
			                        else
			                        {
			                            input.Last_Test_Status = "FAILED: Service returned HTTP " + response_code.toString() + ". Verify endpoint, model, credential, and provider access.";
			                        }
			                    }
			                    catch (test_error)
			                    {
			                        input.Last_Tested_At = test_time;
			                        input.Last_Test_Status = "FAILED: Network, timeout, TLS, or service error. Verify endpoint reachability and provider availability.";
			                    }
			                }
			            )
			        }
			    }
			}

			Validate_AI_Settings as "Validate AI Settings"
			{
			    type = form
			    form = AI_Settings
			    record event = on add or edit
			    description = "Restricts credential changes to administrators and enforces one current configuration."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                if(current_profile != "Administrator" && input.API_Key != null && input.API_Key != "")
			                {
			                    alert "Only administrators may supply or change the API key.";
			                    cancel submit;
			                }
			                if(input.Is_Current == true && AI_Settings[Is_Current == true && ID != input.ID].count() > 0)
			                {
			                    alert "Only one AI configuration can be current. Clear the existing current configuration first.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Applications_Catalyst_Guidance as "Show Integration Guidance"
			{
			    type = form
			    form = Applications
			    record event = on add or edit
			
			    on user input of Catalyst_Connected
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Catalyst_Connected == true)
			                {
			                    show Other_Integrations;
			                }
			                else
			                {
			                    hide Other_Integrations;
			                    input.Other_Integrations = "";
			                }
			            )
			        }
			    }
			}

			Applications_On_Load as "Prepare Application Submission"
			{
			    type = form
			    form = Applications
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                hide Submitted_At, Readiness_Percent, Created_By_Email;
			                if(input.Catalyst_Connected == true)
			                {
			                    show Other_Integrations;
			                }
			                else
			                {
			                    hide Other_Integrations;
			                }
			                loginMember = Members[Login_Email == zoho.loginuserid && Is_Active == true];
			                if(loginMember.ID != null && loginMember.Member_Type == "Participant")
			                {
			                    if(input.ID == null)
			                    {
			                        input.Participant = loginMember.ID;
			                        input.Created_By_Email = zoho.loginuserid;
			                    }
			                    disable Participant;
			                }
			                currentSettings = Challenge_Settings[Current_Record == true] sort by Modified_Time desc range from 0 to 0;
			                phaseClosed = false;
			                if(currentSettings.ID != null && currentSettings.Challenge_Status != "Submission Open" && currentSettings.Challenge_Status != "Setup")
			                {
			                    phaseClosed = true;
			                }
			                if(input.Submission_Status == "Locked" || phaseClosed == true)
			                {
			                    disable Participant, App_Name, Tagline, Problem_Statement, Core_Functionality, Beyond_Creator_Capability, Why_Not_Feasible_In_Creator, Evidence_URL, Demo_URL, Evidence_File, Catalyst_Connected, Other_Integrations, Presentation_Summary, Submission_Status;
			                }
			            )
			        }
			    }
			}

			Applications_On_Success as "Finalize Application Readiness"
			{
			    type = form
			    form = Applications
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                readiness = 0;
			                if(input.App_Name != null) { readiness = readiness + 8; }
			                if(input.Tagline != null) { readiness = readiness + 8; }
			                if(input.Problem_Statement != null) { readiness = readiness + 10; }
			                if(input.Core_Functionality != null) { readiness = readiness + 12; }
			                if(input.Beyond_Creator_Capability != null) { readiness = readiness + 14; }
			                if(input.Why_Not_Feasible_In_Creator != null) { readiness = readiness + 12; }
			                if(input.Presentation_Summary != null) { readiness = readiness + 12; }
			                if(input.Evidence_URL != null || input.Evidence_File != null) { readiness = readiness + 10; }
			                if(input.Demo_URL != null) { readiness = readiness + 8; }
			                if(input.Catalyst_Connected == true || input.Other_Integrations != null) { readiness = readiness + 6; }
			                submittedTime = input.Submitted_At;
			                if(input.Submission_Status == "Submitted" && submittedTime == null)
			                {
			                    submittedTime = zoho.currenttime;
			                }
			                currentApplication = Applications[ID == input.ID];
			                currentApplication.Submitted_At = submittedTime;
			                currentApplication.Readiness_Percent = readiness;
			            )
			        }
			    }
			}

			Applications_Validate as "Validate Application Submission"
			{
			    type = form
			    form = Applications
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                participantRecord = Members[ID == input.Participant && Member_Type == "Participant" && Is_Active == true];
			                if(participantRecord.ID == null)
			                {
			                    alert "Select an active participant from the official roster.";
			                    cancel submit;
			                }
			                if(zoho.loginuserid != zoho.adminuserid && participantRecord.Login_Email != zoho.loginuserid)
			                {
			                    alert "The application must belong to the active participant mapped to your login email.";
			                    cancel submit;
			                }
			                duplicateCount = Applications[Participant == input.Participant && ID != input.ID].count();
			                if(duplicateCount > 0)
			                {
			                    alert "Only one application is allowed per participant.";
			                    cancel submit;
			                }
			                currentSettings = Challenge_Settings[Current_Record == true] sort by Modified_Time desc range from 0 to 0;
			                if(input.Submission_Status == "Submitted")
			                {
			                    if(currentSettings.ID == null || currentSettings.Challenge_Status != "Submission Open" || zoho.currenttime < currentSettings.Challenge_Start || zoho.currenttime > currentSettings.Challenge_End)
			                    {
			                        alert "Submissions are accepted only while the challenge submission phase and date window are open.";
			                        cancel submit;
			                    }
			                    proofText = input.Beyond_Creator_Capability.toString();
			                    feasibilityText = input.Why_Not_Feasible_In_Creator.toString();
			                    if(proofText.length() < 100 || feasibilityText.length() < 100)
			                    {
			                        alert "For submission, provide meaningful proof narratives of at least 100 characters for the beyond-Creator capability and feasibility explanation.";
			                        cancel submit;
			                    }
			                    if(input.Evidence_URL == null && input.Demo_URL == null && input.Evidence_File == null)
			                    {
			                        alert "Add at least one evidence link, demo link, or evidence file before submitting.";
			                        cancel submit;
			                    }
			                }
			                if(input.Submission_Status == "Locked" && zoho.loginuserid != zoho.adminuserid)
			                {
			                    alert "Only an administrator-controlled process may lock an application.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

