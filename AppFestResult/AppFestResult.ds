		    (
		        type = text
		        displayname = "Member Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Member_Type
		    (
		        type = picklist
		        displayname = "Member Type"
		        values = {"Participant", "Judge"}
		        row = 1
		        column = 2
		        width = medium
		    )
