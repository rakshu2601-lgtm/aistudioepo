		            (
		                type = submit
		                displayname = "Update Ballot"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Presentation_Slots
		{
		    title
		    {
		        displayname = "Presentation Slots"
		        on add = "Schedule Presentation"
		        on edit = "Update Presentation Slot"
		    }
		    Main_Section
		    (
		        type = section
		        displayname = "Showcase Session"
		        row = 1
		        column = 0
		    )
		    must have Application
		    (
		        type = picklist
		        displayname = "Application"
		        values = Applications.ID
		        displayformat = [App_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Presenter
		    (
		        type = picklist
		        displayname = "Presenter"
		        values = Members[Member_Type == "Participant" && Is_Active == true].ID
		        displayformat = [Member_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Slot_Start
		    (
		        type = datetime
		        displayname = "Slot Start"
		        mins_displayinterval = 15
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Slot_End
		    (
		        type = datetime
		        displayname = "Slot End"
		        mins_displayinterval = 15
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Duration_Minutes
		    (
		        type = number
		        displayname = "Duration Minutes"
		        initial value = 15
		        row = 1
		        column = 1
		        width = medium
		    )
		    Room_Or_Link
		    (
		        type = text
		        displayname = "Room Or Link"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Presentation_Status
		    (
		        type = picklist
		        displayname = "Presentation Status"
		        values = {"Scheduled", "Ready", "Presenting", "Completed", "No Show"}
		        initial value = "Scheduled"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Judge_Notes
		    (
		        type = textarea
		        displayname = "Judge Notes"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Schedule"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Slot"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		default list AI_Analysis_History
		{
		    displayName = "AI Analysis History"
		    show all rows from AI_Analyses
		    (
		        Analysis_Run_ID
		        Requested_By
		        Requested_At
		        Analysis_Status
		        Team_Vote_Predicted_Winner
		        Judge_Score_Predicted_Winner
		        Overall_Recommended_Winner
		        Team_Confidence
		        Judge_Confidence
		        Is_Latest
		        Failure_Message
		    )
		    filters
		    (
		        Analysis_Status
		        Requested_At
		        Is_Latest
		    )
		    sort by
		    (
		        Requested_At descending
		    )
		}

		list Latest_AI_Prediction
		{
		    displayName = "Latest AI Prediction"
		    show all rows from AI_Analyses [Is_Latest == true && Analysis_Status == "Completed"]
		    (
		        Analysis_Run_ID
		        Requested_At
		        Team_Vote_Predicted_Winner
		        Team_Confidence
		        Team_Analysis
		        Judge_Score_Predicted_Winner
		        Judge_Confidence
		        Judge_Analysis
		        Overall_Recommended_Winner
		        Consensus_And_Disagreement
		        Tie_Break_Explanation
		    )
		    sort by
		    (
		        Requested_At descending
		    )
		}

		default list AI_Configuration
		{
		    displayName = "AI Configuration"
		    show all rows from AI_Settings
		    (
		        Setting_Name
		        Base_URL
		        Model_Name
		        Temperature
		        Max_Tokens
		        Is_Enabled
		        (
		            displaytrue = "Enabled"
		            displayfalse = "Disabled"
		        )
		        Is_Current
		        (
		            displaytrue = "Current"
		            displayfalse = "Inactive"
		        )
		        Last_Tested_At
		        Last_Test_Status
		    )
		}

		list AI_Service_Status
		{
		    displayName = "AI Service Status"
		    show all rows from AI_Settings [Is_Current == true]
		    (
		        Setting_Name
		        Base_URL
		        Model_Name
		        Is_Enabled
		        (
		            displaytrue = "Enabled"
		            displayfalse = "Disabled"
		        )
		        Is_Current
		        (
		            displaytrue = "Current"
		            displayfalse = "Inactive"
		        )
		        Last_Tested_At
		        Last_Test_Status
		        custom action "Test AI Configuration"
		        (
		            workflow = Test_AI_Configuration
		            show action for each record = true
		            column header = "Test AI Configuration"
		            success message = "AI service test completed; review the stored status."
		            condition = (Is_Current == true)
		            confirmation before execution
		            (
		                message for individual record = "Send a minimal connectivity test to the configured AI service?"
		                confirm button text = "Run Test"
		                cancel button text = "Cancel"
		            )
		        )
		    )
		}

		default list Application_Gallery
		{
		    displayName = "Application Gallery"
		    show all rows from Applications
		    (
		        App_Name
		        Tagline
		        Participant
		        Catalyst_Connected
		        Submission_Status
		        Readiness_Percent
		        Submitted_At
		    )
		    filters
		    (
		        Submission_Status
		        Catalyst_Connected
		    )
		    sort by
		    (
		        App_Name ascending
		    )
		    conditional formatting
		    (
		        "Draft Badge"
		        {
		            condition = (Submission_Status == "Draft")
		            fields = [Submission_Status]
		            format = "background-color:#FFF4CC;color:#7A5200;font-weight:bold"
		        }
		        "Submitted Badge"
		        {
		            condition = (Submission_Status == "Submitted")
		            fields = [Submission_Status]
		            format = "background-color:#DDF8EA;color:#086B43;font-weight:bold"
		        }
		        "Locked Badge"
		        {
		            condition = (Submission_Status == "Locked")
		            fields = [Submission_Status]
		            format = "background-color:#E8EAF0;color:#303746;font-weight:bold"
		        }
		    )
		}

		kanban Submission_Pipeline
		{
		    displayName = "Submission Pipeline"
		    show all rows from Applications
		    (
		        App_Name
		        Participant
		        Tagline
		        Submission_Status
		        Readiness_Percent
		        Catalyst_Connected
		    )
		    filters
		    (
		        Participant
		        Catalyst_Connected
		    )
		    sort by
		    (
		        Readiness_Percent descending
		    )
		    options
		    (
		        display field = Submission_Status
		        filter type = manual
		        sort order = custom
		        record count = enable
		    )
		}

		list Submitted_Applications
		{
		    displayName = "Submitted Applications"
		    show all rows from Applications [Submission_Status == "Submitted" || Submission_Status == "Locked"]
		    (
		        App_Name
		        Participant
		        Tagline
		        Catalyst_Connected
		        Other_Integrations
		        Demo_URL
		        Evidence_URL
		        Submission_Status
		        Submitted_At
		        Readiness_Percent
		    )
		    filters
		    (
		        Submission_Status
		        Catalyst_Connected
		    )
		    sort by
		    (
		        Submitted_At descending
		    )
		}

		default list Audit_Trail
		{
		    displayName = "Audit Trail"
		    show all rows from Audit_Log
		    (
		        Event_Time
		        Actor_Email
		        Event_Type
		        Related_Form
		        Related_Record_ID
		        Event_Summary
		        Before_Value
		        After_Value
		        Severity
		    )
		    filters
		    (
		        Event_Type
		        Actor_Email
		        Severity
		    )
		    sort by
		    (
		        Event_Time descending
		    )
		}

