		    (
		        type = checkbox
		        displayname = "Is Active"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Display_Order
		    (
		        type = number
		        displayname = "Display Order"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Identity_Display_Settings
		    (
		        type = section
		        displayname = "Identity And Display"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    unique Login_Email
		    (
		        type = email
		        displayname = "Login Email"
		        description
		        [
		            type = tooltip
		            message = "Used to match this member with zoho.loginuser in downstream workflows."
		        ]
		        row = 2
		        column = 1
		        width = medium
		    )
		    Profile_Color
		    (
		        type = text
		        displayname = "Profile Color"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Avatar
		    (
		        type = image
		        displayname = "Avatar"
		        source = file
		        aspect ratio = square
		        row = 2
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Add Member"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Save Changes"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Participant_Ballots
		{
		    title
		    {
		        displayname = "Participant Ballots"
		        on add = "Submit Participant Ballot"
		        on edit = "Review Participant Ballot"
		    }
		    success message = "Your ballot has been saved securely."
		    Main_Section
		    (
		        type = section
		        displayname = "Voter Identity"
		        row = 1
		        column = 0
