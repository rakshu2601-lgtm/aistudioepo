		    must have Rank_4
		    (
		        type = picklist
		        displayname = "Rank 4 (5 Points)"
		        values = Applications.ID
		        displayformat = [App_Name]
		        searchable = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Rank_5
		    (
		        type = picklist
		        displayname = "Rank 5 (4 Points)"
		        values = Applications.ID
		        displayformat = [App_Name]
		        searchable = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Rank_6
		    (
		        type = picklist
		        displayname = "Rank 6 (3 Points)"
		        values = Applications.ID
		        displayformat = [App_Name]
		        searchable = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Rank_7
		    (
		        type = picklist
		        displayname = "Rank 7 (2 Points)"
		        values = Applications.ID
		        displayformat = [App_Name]
		        searchable = true
		        row = 2
		        column = 1
		        width = medium
