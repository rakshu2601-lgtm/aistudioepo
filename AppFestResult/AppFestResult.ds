			Resolve_Judge_On_Load as "Resolve and Lock Judge Identity"
			{
			    type = form
			    form = Judge_Evaluations
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                judge_records = Members[Login_Email == zoho.loginuser && Member_Type == "Judge" && Is_Active == true];
			                if(judge_records.count() == 1)
			                {
			                    if(input.Judge == null)
			                    {
			                        input.Judge = judge_records.ID;
			                        input.Judge_Email = zoho.loginuser;
			                    }
			                    if(input.Judge != judge_records.ID || input.Judge_Email != zoho.loginuser)
			                    {
			                        alert "You cannot view or edit another judge's evaluation through this form.";
			                        disable Application;
			                        disable UI_Score;
			                        disable Navigation_Usability_Score;
			                        disable Core_Functionality_Score;
			                        disable Innovation_Score;
			                        disable Beyond_Creator_Proof_Score;
			                        disable Catalyst_Integrations_Score;
			                        disable Presentation_Score;
			                        disable Strengths;
			                        disable Risks_Concerns;
			                        disable Judge_Comments;
			                        disable Evaluation_Status;
			                    }
			                }
			                else
			                {
			                    alert "No single active judge account is mapped to your login.";
			                    disable Application;
			                    disable UI_Score;
			                    disable Navigation_Usability_Score;
			                    disable Core_Functionality_Score;
			                    disable Innovation_Score;
			                    disable Beyond_Creator_Proof_Score;
			                    disable Catalyst_Integrations_Score;
			                    disable Presentation_Score;
			                    disable Strengths;
			                    disable Risks_Concerns;
			                    disable Judge_Comments;
			                    disable Evaluation_Status;
			                }
			                disable Judge;
			                disable Judge_Email;
			                hide Weighted_Total;
			                disable Weighted_Total;
			                disable Submitted_At;
			                if(input.Evaluation_Status == "Submitted" || input.Evaluation_Status == "Locked")
			                {
			                    disable Application;
			                    disable UI_Score;
			                    disable Navigation_Usability_Score;
			                    disable Core_Functionality_Score;
			                    disable Innovation_Score;
			                    disable Beyond_Creator_Proof_Score;
			                    disable Catalyst_Integrations_Score;
			                    disable Presentation_Score;
			                    disable Strengths;
			                    disable Risks_Concerns;
			                    disable Judge_Comments;
			                    disable Evaluation_Status;
			                }
			            )
			        }
			    }
			}

			Validate_Judge_Evaluation as "Validate Judge Evaluation"
			{
			    type = form
			    form = Judge_Evaluations
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                invalid_score = input.UI_Score < 1 || input.UI_Score > 10 || input.Navigation_Usability_Score < 1 || input.Navigation_Usability_Score > 10 || input.Core_Functionality_Score < 1 || input.Core_Functionality_Score > 10 || input.Innovation_Score < 1 || input.Innovation_Score > 10 || input.Beyond_Creator_Proof_Score < 1 || input.Beyond_Creator_Proof_Score > 10 || input.Catalyst_Integrations_Score < 1 || input.Catalyst_Integrations_Score > 10 || input.Presentation_Score < 1 || input.Presentation_Score > 10;
			                if(invalid_score)
			                {
			                    alert "Every category score must be between 1 and 10.";
			                    cancel submit;
			                }
			                judge_records = Members[Login_Email == zoho.loginuser && Member_Type == "Judge" && Is_Active == true];
			                if(judge_records.count() != 1 || input.Judge != judge_records.ID || input.Judge_Email != zoho.loginuser)
			                {
			                    alert "Judge identity must match the single active judge mapped to the logged-in user.";
			                    cancel submit;
			                }
			                duplicate_count = Judge_Evaluations[Judge == input.Judge && Application == input.Application && ID != input.ID].count();
			                if(duplicate_count > 0)
			                {
			                    alert "Only one evaluation is allowed per judge and application.";
			                    cancel submit;
			                }
			                settings = Challenge_Settings[Current_Record == true];
			                if(settings.count() != 1 || settings.Challenge_Status != "Judging Open" || zoho.currenttime > settings.Judging_Closes)
			                {
			                    alert "Evaluations may be saved only while the judging phase and window are open.";
			                    cancel submit;
			                }
			                if(input.Evaluation_Status == "Submitted" && (input.Strengths == null || input.Strengths.trim() == "" || input.Risks_Concerns == null || input.Risks_Concerns.trim() == ""))
			                {
			                    alert "Strengths and risks/concerns are required before submission.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Audit_Roster_Change as "Audit Roster Change"
			{
			    type = form
			    form = Members
			    record event = on add or edit
			    description = "Records administrator changes to the official challenge roster."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                eventSummary = "Roster member saved: " + input.Member_Name + " (" + input.Member_Type + ")";
			                auditId = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuser
			                    Event_Type = "Roster Change"
			                    Related_Form = "Members"
			                    Related_Record_ID = input.ID.toString()
			                    Event_Summary = eventSummary
			                    After_Value = "Active=" + input.Is_Active + ", Email=" + ifnull(input.Login_Email, "Not mapped")
			                    Severity = "Info"
			                ];
			            )
			        }
			    }
			}

			Validate_Member_Add as "Validate Member Add"
			{
			    type = form
			    form = Members
			    record event = on add
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(!thisapp.permissions.adminEmailIds().contains(zoho.loginuser))
			                {
			                    alert "Only an application administrator can change the official roster.";
			                    cancel submit;
			                }
			                if(input.Is_Active == true && Members[Member_Name == input.Member_Name && Is_Active == true].count() > 0)
			                {
			                    alert(Member_Name, "An active member with this name already exists.");
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Validate_Member_Delete as "Validate Member Delete"
			{
			    type = form
			    form = Members
			    record event = on delete
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(!thisapp.permissions.adminEmailIds().contains(zoho.loginuser))
			                {
			                    alert "Only an application administrator can change the official roster.";
			                    cancel delete;
			                }
			            )
			        }
			    }
			}

			Validate_Member_Edit as "Validate Member Edit"
			{
			    type = form
			    form = Members
			    record event = on edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(!thisapp.permissions.adminEmailIds().contains(zoho.loginuser))
			                {
			                    alert "Only an application administrator can change the official roster.";
			                    cancel submit;
			                }
			                if(input.Is_Active == true && Members[Member_Name == input.Member_Name && Is_Active == true && ID != input.ID].count() > 0)
			                {
			                    alert(Member_Name, "An active member with this name already exists.");
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Lock_Submitted_Ballot as "Lock Submitted Ballot"
			{
			    type = form
			    form = Participant_Ballots
			    record event = on add or edit
			
			    on success
			    {
			        actions ( Ballot_Status == "Submitted" )
			        {
			            custom deluge script
			            (
			                update Participant_Ballots[ID == input.ID]
			                [
			                    Submitted_At = zoho.currenttime
			                    Ballot_Status = "Locked"
			                ];
			            )
			        }
			    }
			}

			Resolve_And_Secure_Ballot as "Resolve and Secure Ballot"
			{
			    type = form
			    form = Participant_Ballots
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                logged_in_member = Members[Login_Email == zoho.loginuser && Member_Type == "Participant" && Is_Active == true];
			                disable Voter;
			                disable Voter_Email;
			                disable Submitted_At;
			                disable Ballot_Status;
			                if(logged_in_member.count() == 1)
			                {
			                    input.Voter = logged_in_member.ID;
			                    input.Voter_Email = zoho.loginuser;
			                }
			                clear Rank_1;
			                clear Rank_2;
			                clear Rank_3;
			                clear Rank_4;
			                clear Rank_5;
			                clear Rank_6;
			                clear Rank_7;
			                clear Rank_8;
			                settings = Challenge_Settings[Current_Record == true];
			                voting_open = false;
			                if(settings.count() == 1 && settings.Challenge_Status == "Voting Open" && zoho.currenttime >= settings.Voting_Opens && zoho.currenttime <= settings.Voting_Closes)
			                {
			                    voting_open = true;
			                }
			                if(voting_open && input.Ballot_Status != "Submitted" && input.Ballot_Status != "Locked" && logged_in_member.count() == 1)
			                {
			                    eligible_apps = Applications[(Submission_Status == "Submitted" || Submission_Status == "Locked") && Participant != logged_in_member.ID];
			                    Rank_1:ui.add(eligible_apps.ID.getall());
			                    Rank_2:ui.add(eligible_apps.ID.getall());
			                    Rank_3:ui.add(eligible_apps.ID.getall());
			                    Rank_4:ui.add(eligible_apps.ID.getall());
			                    Rank_5:ui.add(eligible_apps.ID.getall());
			                    Rank_6:ui.add(eligible_apps.ID.getall());
			                    Rank_7:ui.add(eligible_apps.ID.getall());
			                    Rank_8:ui.add(eligible_apps.ID.getall());
			                    enable Rank_1;
			                    enable Rank_2;
			                    enable Rank_3;
			                    enable Rank_4;
			                    enable Rank_5;
			                    enable Rank_6;
			                    enable Rank_7;
			                    enable Rank_8;
			                    enable Best_App_Explanation;
			                }
			                else
			                {
			                    disable Rank_1;
			                    disable Rank_2;
			                    disable Rank_3;
			                    disable Rank_4;
			                    disable Rank_5;
			                    disable Rank_6;
			                    disable Rank_7;
			                    disable Rank_8;
			                    disable Best_App_Explanation;
			                }
			            )
			        }
			    }
			}

			Validate_Participant_Ballot as "Validate Participant Ballot"
			{
			    type = form
			    form = Participant_Ballots
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                voter_record = Members[ID == input.Voter && Login_Email == zoho.loginuser && Member_Type == "Participant" && Is_Active == true];
			                if(voter_record.count() != 1 || input.Voter_Email != zoho.loginuser)
			                {
			                    alert "Only an active participant may submit a ballot using their mapped login identity.";
			                    cancel submit;
			                }
			                settings = Challenge_Settings[Current_Record == true];
			                if(settings.count() != 1 || settings.Challenge_Status != "Voting Open" || zoho.currenttime < settings.Voting_Opens || zoho.currenttime > settings.Voting_Closes)
			                {
			                    alert "Ballots can only be submitted during the configured voting window.";
			                    cancel submit;
			                }
			                if(input.Ballot_Status == "Submitted" || input.Ballot_Status == "Locked")
			                {
			                    alert "A submitted ballot is locked and cannot be changed.";
			                    cancel submit;
			                }
			                duplicate_ballots = 0;
			                if(input.ID == null)
			                {
			                    duplicate_ballots = Participant_Ballots[Voter_Email == zoho.loginuser].count();
			                }
			                else
			                {
			                    duplicate_ballots = Participant_Ballots[Voter_Email == zoho.loginuser && ID != input.ID].count();
			                }
			                if(duplicate_ballots > 0)
			                {
			                    alert "Only one ballot is allowed per active participant.";
			                    cancel submit;
			                }
			                ranked_apps = List();
			                ranked_apps.add(input.Rank_1);
			                ranked_apps.add(input.Rank_2);
			                ranked_apps.add(input.Rank_3);
			                ranked_apps.add(input.Rank_4);
			                ranked_apps.add(input.Rank_5);
			                ranked_apps.add(input.Rank_6);
			                ranked_apps.add(input.Rank_7);
			                ranked_apps.add(input.Rank_8);
			                unique_apps = ranked_apps.distinct();
			                if(ranked_apps.size() != 8 || unique_apps.size() != 8)
			                {
			                    alert "Rank all eight competing applications exactly once; duplicate ranks are not allowed.";
			                    cancel submit;
			                }
			                own_apps = Applications[Participant == input.Voter && (Submission_Status == "Submitted" || Submission_Status == "Locked")];
			                for each own_app in own_apps
			                {
			                    if(ranked_apps.contains(own_app.ID))
			                    {
			                        alert "You cannot rank your own application.";
			                        cancel submit;
			                    }
			                }
			                eligible_apps = Applications[Participant != input.Voter && (Submission_Status == "Submitted" || Submission_Status == "Locked")];
			                if(eligible_apps.count() != 8)
			                {
			                    alert "Voting requires exactly eight submitted applications other than your own.";
			                    cancel submit;
			                }
			                for each eligible_app in eligible_apps
			                {
			                    if(!ranked_apps.contains(eligible_app.ID))
			                    {
			                        alert "Every other submitted application must appear exactly once in your ranking.";
			                        cancel submit;
			                    }
			                }
			                if(input.Best_App_Explanation == null || input.Best_App_Explanation.trim().length() < 40)
			                {
			                    alert(Best_App_Explanation,"Please provide a meaningful explanation of at least 40 characters for your first-ranked app.");
			                    cancel submit;
			                }
			                input.Ballot_Status = "Submitted";
			            )
			        }
			    }
			}

			Audit_Presentation_Status_Add as "Audit Initial Presentation Status"
			{
			    type = form
			    form = Presentation_Slots
			    record event = on add
			    description = "Writes the initial presentation status to the central audit trail after scheduling succeeds."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuser
			                    Event_Type = "Configuration"
			                    Related_Form = "Presentation_Slots"
			                    Related_Record_ID = input.ID.toString()
			                    Event_Summary = "Presentation slot scheduled with status " + input.Presentation_Status
			                    After_Value = input.Presentation_Status
			                    Severity = "Info"
			                ];
			            )
			        }
			    }
			}

			Audit_Presentation_Status_Edit as "Audit Presentation Status Change"
			{
			    type = form
			    form = Presentation_Slots
			    record event = on edit
			    description = "Writes presentation status changes to the central audit trail during validated edits."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(old.Presentation_Status != input.Presentation_Status)
			                {
			                    insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuser
			                        Event_Type = "Configuration"
			                        Related_Form = "Presentation_Slots"
			                        Related_Record_ID = input.ID.toString()
			                        Event_Summary = "Presentation status changed from " + old.Presentation_Status + " to " + input.Presentation_Status
			                        Before_Value = old.Presentation_Status
			                        After_Value = input.Presentation_Status
			                        Severity = "Info"
			                    ];
			                }
			            )
			        }
			    }
			}

			Compute_Slot_End as "Compute Presentation Slot End"
			{
			    type = form
			    form = Presentation_Slots
			    record event = on add or edit
			    description = "Computes the slot end from the current configured presentation duration."
			
			    on user input of Slot_Start
			    {
			        actions
			        {
			            custom deluge script
			            (
			                currentSettings = Challenge_Settings[Current_Record == true] sort by Modified_Time desc range from 0 to 0;
			                configuredMinutes = 15;
			                if(currentSettings.ID != null && currentSettings.Presentation_Minutes != null)
			                {
			                    configuredMinutes = currentSettings.Presentation_Minutes;
			                }
			                input.Duration_Minutes = configuredMinutes;
			                if(input.Slot_Start != null)
			                {
			                    input.Slot_End = input.Slot_Start.addMinutes(configuredMinutes);
			                }
			            )
			        }
			    }
			}

			Presentation_Slot_On_Load as "Prepare Presentation Slot"
			{
			    type = form
			    form = Presentation_Slots
			    record event = on add or edit
			    description = "Applies configured duration and participant-safe field visibility while leaving status and notes management to judges and administrators."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                currentSettings = Challenge_Settings[Current_Record == true] sort by Modified_Time desc range from 0 to 0;
			                if(currentSettings.ID != null && currentSettings.Presentation_Minutes != null)
			                {
			                    input.Duration_Minutes = currentSettings.Presentation_Minutes;
			                }
			                disable Duration_Minutes, Slot_End;
			                loginMember = Members[Login_Email == zoho.loginuser && Is_Active == true];
			                if(loginMember.ID != null && loginMember.Member_Type == "Participant")
			                {
			                    hide Judge_Notes;
			                    disable Application, Presenter, Slot_Start, Room_Or_Link, Presentation_Status;
			                }
			            )
			        }
			    }
			}

			Validate_Presentation_Slot as "Validate Presentation Slot"
			{
			    type = form
			    form = Presentation_Slots
			    record event = on add or edit
			    description = "Enforces configured duration, chronology, presenter ownership, and collision-free active showcase slots."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                currentSettings = Challenge_Settings[Current_Record == true] sort by Modified_Time desc range from 0 to 0;
			                if(currentSettings.ID == null || currentSettings.Presentation_Minutes == null || currentSettings.Presentation_Minutes <= 0)
			                {
			                    alert "Configure a positive presentation duration in the current Challenge Settings record before scheduling slots.";
			                    cancel submit;
			                }
			                configuredMinutes = currentSettings.Presentation_Minutes;
			                if(input.Duration_Minutes != configuredMinutes)
			                {
			                    alert "Duration Minutes must exactly match the configured presentation duration of " + configuredMinutes + " minutes.";
			                    cancel submit;
			                }
			                if(input.Slot_End <= input.Slot_Start)
			                {
			                    alert "Slot End must be after Slot Start.";
			                    cancel submit;
			                }
			                expectedEnd = input.Slot_Start.addMinutes(configuredMinutes);
			                if(input.Slot_End != expectedEnd)
			                {
			                    alert "Slot End must be exactly " + configuredMinutes + " minutes after Slot Start.";
			                    cancel submit;
			                }
			                applicationRecord = Applications[ID == input.Application];
			                if(applicationRecord.ID == null || applicationRecord.Participant != input.Presenter)
			                {
			                    alert "The presenter must be the participant who owns the selected application.";
			                    cancel submit;
			                }
			                if(input.Presentation_Status != "Completed" && input.Presentation_Status != "No Show")
			                {
			                    overlapCount = Presentation_Slots[ID != input.ID && Presentation_Status != "Completed" && Presentation_Status != "No Show" && Slot_Start < input.Slot_End && Slot_End > input.Slot_Start].count();
			                    if(overlapCount > 0)
			                    {
			                        alert "This session overlaps another active presentation slot.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}
		}
	}

