application "AppFestResult"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form AI_Analyses
		{
		    title
		    {
		        displayname = "AI Analyses"
		        on add = "Run AI Analysis"
		        on edit = "Review AI Analysis"
		    }
		    success message = "The AI analysis request has been processed."
		    Main_Section
		    (
		        type = section
		        displayname = "Analysis Request"
		        row = 1
		        column = 0
		    )
		    Analysis_Run_ID
		    (
		        type = autonumber
		        displayname = "Analysis Run ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Requested_By
		    (
		        type = email
		        displayname = "Requested By"
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Requested_At
		    (
		        type = datetime
		        displayname = "Requested At"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Analysis_Status
		    (
		        type = picklist
		        displayname = "Analysis Status"
		        values = {"Queued","Completed","Failed"}
		        initial value = "Queued"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Is_Latest
		    (
		        type = checkbox
		        displayname = "Latest Analysis"
		        initial value = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Winners_Section
		    (
		        type = section
		        displayname = "Predicted Winners"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Team_Vote_Predicted_Winner
		    (
		        type = picklist
		        displayname = "Team Vote Predicted Winner"
		        values = Applications.ID
		        displayformat = [App_Name]
		        searchable = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    Judge_Score_Predicted_Winner
		    (
		        type = picklist
		        displayname = "Judge Score Predicted Winner"
		        values = Applications.ID
		        displayformat = [App_Name]
		        searchable = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    Overall_Recommended_Winner
		    (
		        type = picklist
		        displayname = "Overall Recommended Winner"
		        values = Applications.ID
		        displayformat = [App_Name]
		        searchable = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    Team_Confidence
		    (
		        type = decimal
		        displayname = "Team Confidence"
		        decimalplace = 2
		        row = 2
		        column = 2
		        width = medium
		    )
		    Judge_Confidence
		    (
		        type = decimal
		        displayname = "Judge Confidence"
		        decimalplace = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    Explanation_Section
		    (
		        type = section
		        displayname = "Explainable Recommendation"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Team_Analysis
		    (
		        type = richtext
		        displayname = "Team Analysis"
		        height = 160px
		        toolbar = disable
		        row = 3
		        column = 1
		        width = medium
		    )
		    Judge_Analysis
		    (
		        type = richtext
		        displayname = "Judge Analysis"
		        height = 160px
		        toolbar = disable
		        row = 3
		        column = 2
		        width = medium
		    )
		    Consensus_And_Disagreement
		    (
		        type = richtext
		        displayname = "Consensus and Disagreement"
		        height = 160px
		        toolbar = disable
		        row = 3
		        column = 1
		        width = medium
		    )
		    Tie_Break_Explanation
		    (
		        type = richtext
		        displayname = "Tie-Break Explanation"
		        height = 160px
		        toolbar = disable
		        row = 3
		        column = 2
		        width = medium
		    )
		    Diagnostics_Section
		    (
		        type = section
		        displayname = "Response and Diagnostics"
		        visibility = true
		        row = 4
		        column = 1
		    )
		    Full_AI_Response
		    (
		        type = textarea
		        displayname = "Full AI Response"
		        height = 220px
		        row = 4
		        column = 1
		        width = medium
		    )
		    Failure_Message
		    (
		        type = textarea
		        displayname = "Failure Message"
		        height = 120px
		        row = 4
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Run Analysis"
		                tooltip = "Validate complete voting and judging data, then request an explainable prediction"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form AI_Settings
		{
		    title
		    {
		        displayname = "AI Settings"
		        on add = "New AI Configuration"
		        on edit = "Edit AI Configuration"
		    }
		    success message = "AI configuration saved securely."
		    Main_Section
		    (
		        type = section
		        displayname = "Service Configuration"
		        row = 1
		        column = 0
		    )
		    must have unique Setting_Name
		    (
		        type = text
		        displayname = "Setting Name"
		        initial value = "Default AI Configuration"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Base_URL
		    (
		        type = url
		        displayname = "Base URL"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Model_Name
		    (
		        type = text
		        displayname = "Model Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    API_Key
		    (
		        type = text
		        displayname = "API Key"
		        isencrypted = true
		        private = true
		        description [ type = tooltip  message = "Administrator-only secret. Supply it during secure service setup; it is never written to status diagnostics." ]
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Temperature
		    (
		        type = decimal
		        displayname = "Temperature"
		        decimalplace = 2
		        initial value = 0.2
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Max_Tokens
		    (
		        type = number
		        displayname = "Max Tokens"
		        initial value = 1800
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have System_Prompt
		    (
		        type = textarea
		        displayname = "System Prompt"
		        height = 160px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Status_Section
		    (
		        type = section
		        displayname = "Service Status"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Is_Enabled
		    (
		        type = checkbox
		        displayname = "Enabled"
		        initial value = false
		        row = 2
		        column = 1
		        width = medium
		    )
		    Is_Current
		    (
		        type = checkbox
		        displayname = "Current Configuration"
		        initial value = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    Last_Tested_At
		    (
		        type = datetime
		        displayname = "Last Tested At"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Last_Test_Status
		    (
		        type = text
		        displayname = "Last Test Status"
		        maxchar = 255
		        row = 2
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Configuration"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Configuration"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Applications
		{
		    displayname = "Applications"
		
		    Main_Section
		    (
		        type = section
		        displayname = "Application Concept"
		        row = 1
		        column = 0
		    )
		    must have Participant
		    (
		        type = picklist
		        displayname = "Participant"
		        values = Members[Member_Type == "Participant" && Is_Active == true].ID
		        displayformat = [Member_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique App_Name
		    (
		        type = text
		        displayname = "App Name"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Tagline
		    (
		        type = text
		        displayname = "Tagline"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Problem_Statement
		    (
		        type = textarea
		        displayname = "Problem Statement"
		        height = 140px
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Core_Functionality
		    (
		        type = richtext
		        displayname = "Core Functionality"
		        height = 220px
		        toolbar = enable
		        [
		            style, alignment, bullets-and-numbering, link, code, quote
		        ]
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Presentation_Summary
		    (
		        type = textarea
		        displayname = "Presentation Summary"
		        height = 160px
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Proof_And_Integrations
		    (
		        type = section
		        displayname = "Proof And Integrations"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Beyond_Creator_Capability
		    (
		        type = richtext
		        displayname = "Beyond Creator Capability"
		        height = 220px
		        toolbar = enable
		        [
		            style, alignment, bullets-and-numbering, link, code, quote
		        ]
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Why_Not_Feasible_In_Creator
		    (
		        type = textarea
		        displayname = "Why Not Feasible In Creator"
		        height = 160px
		        row = 2
		        column = 2
		        width = medium
		    )
		    Evidence_URL
		    (
		        type = url
		        displayname = "Evidence URL"
		        target = new window
		        enable = linkname, title
		        row = 2
		        column = 1
		        width = medium
		    )
		    Demo_URL
		    (
		        type = url
		        displayname = "Demo URL"
		        target = new window
		        enable = linkname, title
		        row = 2
		        column = 2
		        width = medium
		    )
		    Evidence_File
		    (
		        type = upload file
		        displayname = "Evidence File"
		        browse = local_drive, google_docs, zoho_docs
		        row = 2
		        column = 1
		        width = medium
		    )
		    Catalyst_Connected
		    (
		        type = checkbox
		        displayname = "Catalyst Connected"
		        initial value = false
		        row = 2
		        column = 2
		        width = medium
		    )
		    Other_Integrations
		    (
		        type = textarea
		        displayname = "Other Integrations"
		        description [ type = tooltip  message = "Describe connected services, APIs, data stores, or Om.ai/Catalyst integration details." ]
		        height = 120px
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Submission_Metadata
		    (
		        type = section
		        displayname = "Submission Readiness"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    must have Submission_Status
		    (
		        type = picklist
		        displayname = "Submission Status"
		        values = {"Draft","Submitted","Locked"}
		        initial value = "Draft"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Submitted_At
		    (
		        type = datetime
		        displayname = "Submitted At"
		        row = 3
		        column = 2
		        width = medium
		    )
		    Readiness_Percent
		    (
		        type = decimal
		        displayname = "Readiness Percent"
		        decimalplace = 2
		        row = 3
		        column = 1
		        width = medium
		    )
		    must have Created_By_Email
		    (
		        type = email
		        displayname = "Created By Email"
		        initial value = "${zoho.loginuserid}"
		        row = 3
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Application"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Clear"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Application"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Audit_Log
		{
		    title
		    {
		        displayname = "Audit Log"
		        on add = "Add Audit Event"
		        on edit = "Edit Audit Event"
		    }
		
		    Main_Section
		    (
		        type = section
		        displayname = "Audit Event Details"
		        row = 1
		        column = 0
		    )
		    must have Event_Time
		    (
		        type = datetime
		        displayname = "Event Time"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Actor_Email
		    (
		        type = email
		        displayname = "Actor Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Event_Type
		    (
		        type = picklist
		        displayname = "Event Type"
		        values = {"Roster Change", "Phase Change", "Application Submission", "Ballot Submission", "Judge Score", "AI Run", "Ranking Draft", "Approval", "Publication", "Configuration"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Related_Form
		    (
		        type = text
		        displayname = "Related Form"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Related_Record_ID
		    (
		        type = text
		        displayname = "Related Record ID"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Event_Summary
		    (
		        type = textarea
		        displayname = "Event Summary"
		        height = 120px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Before_Value
		    (
		        type = textarea
		        displayname = "Before Value"
		        height = 120px
		        row = 1
		        column = 1
		        width = medium
		    )
		    After_Value
		    (
		        type = textarea
		        displayname = "After Value"
		        height = 120px
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Severity
		    (
		        type = picklist
		        displayname = "Severity"
		        values = {"Info", "Warning", "Critical"}
		        initial value = "Info"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Challenge_Settings
		{
		    title
		    {
		        displayname = "Challenge Settings"
		        on add = "Create Challenge Settings"
		        on edit = "Edit Challenge Settings"
		    }
		    success message = "Challenge settings saved successfully."
		    Main_Section
		    (
		        type = section
		        displayname = "Challenge Control"
		        row = 1
		        column = 0
		    )
		    must have Challenge_Title
		    (
		        type = text
		        displayname = "Challenge Title"
		        initial value = "Om.ai Beyond Limits Challenge"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Challenge_Status
		    (
		        type = picklist
		        displayname = "Challenge Status"
		        values = {"Setup", "Submission Open", "Voting Open", "Judging Open", "Finalization", "Results Published"}
		        initial value = "Setup"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Challenge_Start
		    (
		        type = datetime
		        displayname = "Challenge Start"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Challenge_End
		    (
		        type = datetime
		        displayname = "Challenge End"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Voting_Opens
		    (
		        type = datetime
		        displayname = "Voting Opens"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Voting_Closes
		    (
		        type = datetime
		        displayname = "Voting Closes"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Judging_Closes
		    (
		        type = datetime
		        displayname = "Judging Closes"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Showcase_Date_Time
		    (
		        type = datetime
		        displayname = "Showcase Date Time"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Presentation_Minutes
		    (
		        type = number
		        displayname = "Presentation Minutes"
		        initial value = 15
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Rules_And_Announcement
		    (
		        type = richtext
		        displayname = "Rules And Announcement"
		        height = 240px
		        toolbar = enable
		        [
		            style, font-color, alignment, bullets-and-numbering, indent, link, table, quote,
		            font-size : {2, 3, 4, 5},
		            font-family : {"Arimo", "Lato", "Poppins"}
		        ]
		        row = 1
		        column = 2
		        width = medium
		    )
		    Bootstrap_Roster
		    (
		        type = checkbox
		        displayname = "Bootstrap Roster"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Results_Visible_To_Participants
		    (
		        type = checkbox
		        displayname = "Results Visible To Participants"
		        initial value = false
		        row = 1
		        column = 2
		        width = medium
		    )
		    Current_Record
		    (
		        type = checkbox
		        displayname = "Current Record"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Settings"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Settings"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Final_Approvals
		{
		    title
		    {
		        displayname = "Final Approvals"
		        on add = "Record Approval Decision"
		        on edit = "Review Approval Decision"
		    }
		    success message = "Your independent approval decision has been recorded."
		    Main_Section
		    (
		        type = section
		        displayname = "Consensus Decision"
		        row = 1
		        column = 0
		    )
		    must have Final_Ranking
		    (
		        type = picklist
		        displayname = "Final Ranking"
		        values = Final_Rankings.ID
		        displayformat = [Ranking_Version]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Judge
		    (
		        type = picklist
		        displayname = "Judge"
		        values = Members[Member_Type == "Judge" && Is_Active == true].ID
		        displayformat = [Member_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Judge_Email
		    (
		        type = email
		        displayname = "Judge Email"
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Decision
		    (
		        type = picklist
		        displayname = "Decision"
		        values = {"Approve","Request Changes"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Approval_Comment
		    (
		        type = textarea
		        displayname = "Approval Comment"
		        height = 120px
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Decided_At
		    (
		        type = datetime
		        displayname = "Decided At"
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Record Decision"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Clear"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Decision"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Final_Rankings
		{
		    displayname = "Final Rankings"
		    success message = "Final ranking saved successfully."
		
		    Main_Section
		    (
		        type = section
		        displayname = "Ranking Details"
		        row = 1
		        column = 0
		    )
		    Ranking_Version
		    (
		        type = autonumber
		        displayname = "Ranking Version"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Drafted_By
		    (
		        type = email
		        displayname = "Drafted By"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Drafted_At
		    (
		        type = datetime
		        displayname = "Drafted At"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Rank_1
		    (
		        type = picklist
		        displayname = "1st Place"
		        values = Applications.ID
		        displayformat = [App_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Rank_2
		    (
		        type = picklist
		        displayname = "2nd Place"
		        values = Applications.ID
		        displayformat = [App_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Rank_3
		    (
		        type = picklist
		        displayname = "3rd Place"
		        values = Applications.ID
		        displayformat = [App_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Rank_4
		    (
		        type = picklist
		        displayname = "4th Place"
		        values = Applications.ID
		        displayformat = [App_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Rank_5
		    (
		        type = picklist
		        displayname = "5th Place"
		        values = Applications.ID
		        displayformat = [App_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Rank_6
		    (
		        type = picklist
		        displayname = "6th Place"
		        values = Applications.ID
		        displayformat = [App_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Rank_7
		    (
		        type = picklist
		        displayname = "7th Place"
		        values = Applications.ID
		        displayformat = [App_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Rank_8
		    (
		        type = picklist
		        displayname = "8th Place"
		        values = Applications.ID
		        displayformat = [App_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Rank_9
		    (
		        type = picklist
		        displayname = "9th Place"
		        values = Applications.ID
		        displayformat = [App_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Decision_Section
		    (
		        type = section
		        displayname = "Decision Rationale"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Winner_Rationale
		    (
		        type = richtext
		        displayname = "Winner Rationale"
		        height = 180px
		        toolbar = enable
		        [
		            style, alignment, bullets-and-numbering, link, remove-formatting,
		            font-size : {2,3,4,5},
		            font-family : {"Lato","Poppins"}
		        ]
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Ranking_Rationale
		    (
		        type = richtext
		        displayname = "Full Ranking Rationale"
		        height = 220px
		        toolbar = enable
		        [
		            style, alignment, bullets-and-numbering, link, remove-formatting,
		            font-size : {2,3,4,5},
		            font-family : {"Lato","Poppins"}
		        ]
		        row = 2
		        column = 2
		        width = medium
		    )
		
		    Consensus_Section
		    (
		        type = section
		        displayname = "Consensus Status"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    must have Decision_Status
		    (
		        type = picklist
		        displayname = "Decision Status"
		        values = {"Draft","Pending Consensus","Published","Superseded"}
		        initial value = "Draft"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Based_On_AI_Analysis
		    (
		        type = picklist
		        displayname = "Based On AI Analysis"
		        values = AI_Analyses.ID
		        displayformat = [Analysis_Run_ID]
		        searchable = true
		        row = 3
		        column = 2
		        width = medium
		    )
		    Published_At
		    (
		        type = datetime
		        displayname = "Published At"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Is_Current
		    (
		        type = checkbox
		        displayname = "Current Ranking"
		        initial value = true
		        row = 3
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Ranking"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Ranking"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Judge_Evaluations
		{
		    title
		    {
		        displayname = "Judge Evaluations"
		        on add = "New Judge Evaluation"
		        on edit = "Edit Judge Evaluation"
		    }
		    success message = "Evaluation saved successfully."
		    Main_Section
		    (
		        type = section
		        displayname = "Evaluation Identity"
		        row = 1
		        column = 0
		    )
		    must have Judge
		    (
		        type = picklist
		        displayname = "Judge"
		        values = Members.ID
		        displayformat = [Member_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Judge_Email
		    (
		        type = email
		        displayname = "Judge Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Application
		    (
		        type = picklist
		        displayname = "Application"
		        values = Applications.ID
		        displayformat = [App_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Scores_Section
		    (
		        type = section
		        displayname = "Category Scores"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have UI_Score
		    (
		        type = decimal
		        displayname = "UI Score (1-10)"
		        decimalplace = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Navigation_Usability_Score
		    (
		        type = decimal
		        displayname = "Navigation / Usability Score (1-10)"
		        decimalplace = 2
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Core_Functionality_Score
		    (
		        type = decimal
		        displayname = "Core Functionality Score (1-10)"
		        decimalplace = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Innovation_Score
		    (
		        type = decimal
		        displayname = "Innovation Score (1-10)"
		        decimalplace = 2
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Beyond_Creator_Proof_Score
		    (
		        type = decimal
		        displayname = "Beyond-Creator Proof Score (1-10)"
		        decimalplace = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Catalyst_Integrations_Score
		    (
		        type = decimal
		        displayname = "Catalyst / Integrations Score (1-10)"
		        decimalplace = 2
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Presentation_Score
		    (
		        type = decimal
		        displayname = "Presentation Score (1-10)"
		        decimalplace = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    Weighted_Total
		    (
		        type = decimal
		        displayname = "Weighted Total (out of 100)"
		        decimalplace = 2
		        row = 2
		        column = 2
		        width = medium
		    )
		    Narrative_Section
		    (
		        type = section
		        displayname = "Narrative Assessment"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    must have Strengths
		    (
		        type = textarea
		        displayname = "Strengths"
		        height = 120px
		        row = 3
		        column = 1
		        width = medium
		    )
		    must have Risks_Concerns
		    (
		        type = textarea
		        displayname = "Risks / Concerns"
		        height = 120px
		        row = 3
		        column = 2
		        width = medium
		    )
		    Judge_Comments
		    (
		        type = textarea
		        displayname = "Judge Comments"
		        height = 120px
		        row = 3
		        column = 1
		        width = medium
		    )
		    Status_Section
		    (
		        type = section
		        displayname = "Submission Status"
		        visibility = true
		        row = 4
		        column = 1
		    )
		    must have Evaluation_Status
		    (
		        type = picklist
		        displayname = "Evaluation Status"
		        values = {"Draft", "Submitted", "Locked"}
		        initial value = "Draft"
		        row = 4
		        column = 1
		        width = medium
		    )
		    Submitted_At
		    (
		        type = datetime
		        displayname = "Submitted At"
		        row = 4
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Evaluation"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Clear"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Evaluation"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Members
		{
		    title
		    {
		        on add = "Add Member"
		        on edit = "Edit Member"
		    }
		    success message = "Member saved successfully."
		    Main_Section
		    (
		        type = section
		        displayname = "Roster Details"
		        row = 1
		        column = 0
		    )
