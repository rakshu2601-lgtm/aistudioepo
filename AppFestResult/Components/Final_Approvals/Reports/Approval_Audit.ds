list Approval_Audit
{
    displayName = "Approval Audit"
    show all rows from Final_Approvals
    (
        Final_Ranking
        Judge
        Judge_Email
        Decision
        Approval_Comment
        Decided_At
    )
    filters
    (
        Final_Ranking
        Judge
        Decision
        Decided_At
    )
    sort by
    (
        Decided_At descending
    )
}
