Validate_Audit_Log_Delete as "Validate Audit Log Delete"
{
    type = form
    form = Audit_Log
    record event = on delete
    description = "Prevents deletion from the immutable audit history."

    on validate
    {
        actions
        {
            custom deluge script
            (
                alert "Audit events are immutable and cannot be deleted.";
                cancel delete;
            )
        }
    }
}
