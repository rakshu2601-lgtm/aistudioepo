form Audit_Log
{
    title
    {
        displayname = "Audit Log"
        on add = "Add Audit Event"
        on edit = "Edit Audit Event"
    }

    Main_Section
    (
        type = section
        displayname = "Audit Event Details"
        row = 1
        column = 0
    )
    must have Event_Time
    (
        type = datetime
        displayname = "Event Time"
        row = 1
        column = 1
        width = medium
    )
    must have Actor_Email
    (
        type = email
        displayname = "Actor Email"
        row = 1
        column = 2
        width = medium
    )
    must have Event_Type
    (
        type = picklist
        displayname = "Event Type"
        values = {"Roster Change", "Phase Change", "Application Submission", "Ballot Submission", "Judge Score", "AI Run", "Ranking Draft", "Approval", "Publication", "Configuration"}
        row = 1
        column = 1
        width = medium
    )
    must have Related_Form
    (
        type = text
        displayname = "Related Form"
        row = 1
        column = 2
        width = medium
    )
    Related_Record_ID
    (
        type = text
        displayname = "Related Record ID"
        row = 1
        column = 1
        width = medium
    )
    must have Event_Summary
    (
        type = textarea
        displayname = "Event Summary"
        height = 120px
        row = 1
        column = 2
        width = medium
    )
    Before_Value
    (
        type = textarea
        displayname = "Before Value"
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    After_Value
    (
        type = textarea
        displayname = "After Value"
        height = 120px
        row = 1
        column = 2
        width = medium
    )
    must have Severity
    (
        type = picklist
        displayname = "Severity"
        values = {"Info", "Warning", "Critical"}
        initial value = "Info"
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
