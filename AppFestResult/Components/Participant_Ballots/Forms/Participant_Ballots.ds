form Participant_Ballots
{
    title
    {
        displayname = "Participant Ballots"
        on add = "Submit Participant Ballot"
        on edit = "Review Participant Ballot"
    }
    success message = "Your ballot has been saved securely."
    Main_Section
    (
        type = section
        displayname = "Voter Identity"
        row = 1
        column = 0
    )
    must have Voter
    (
        type = picklist
        displayname = "Voter"
        values = Members.ID
        displayformat = [Member_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have unique Voter_Email
    (
        type = email
        displayname = "Voter Email"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    Rankings_Section
    (
        type = section
        displayname = "App Rankings"
        visibility = true
        row = 2
        column = 1
    )
    must have Rank_1
    (
        type = picklist
        displayname = "Rank 1 (8 Points)"
        values = Applications.ID
        displayformat = [App_Name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    must have Rank_2
    (
        type = picklist
        displayname = "Rank 2 (7 Points)"
        values = Applications.ID
        displayformat = [App_Name]
        searchable = true
        row = 2
        column = 2
        width = medium
    )
    must have Rank_3
    (
        type = picklist
        displayname = "Rank 3 (6 Points)"
        values = Applications.ID
        displayformat = [App_Name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    must have Rank_4
    (
        type = picklist
        displayname = "Rank 4 (5 Points)"
        values = Applications.ID
        displayformat = [App_Name]
        searchable = true
        row = 2
        column = 2
        width = medium
    )
    must have Rank_5
    (
        type = picklist
        displayname = "Rank 5 (4 Points)"
        values = Applications.ID
        displayformat = [App_Name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    must have Rank_6
    (
        type = picklist
        displayname = "Rank 6 (3 Points)"
        values = Applications.ID
        displayformat = [App_Name]
        searchable = true
        row = 2
        column = 2
        width = medium
    )
    must have Rank_7
    (
        type = picklist
        displayname = "Rank 7 (2 Points)"
        values = Applications.ID
        displayformat = [App_Name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    must have Rank_8
    (
        type = picklist
        displayname = "Rank 8 (1 Point)"
        values = Applications.ID
        displayformat = [App_Name]
        searchable = true
        row = 2
        column = 2
        width = medium
    )
    must have Best_App_Explanation
    (
        type = textarea
        displayname = "Why Is Your Best App Best?"
        height = 120px
        row = 2
        column = 1
        width = medium
    )
    Submission_Section
    (
        type = section
        displayname = "Ballot Submission"
        visibility = true
        row = 3
        column = 1
    )
    Submitted_At
    (
        type = datetime
        displayname = "Submitted At"
        row = 3
        column = 1
        width = medium
    )
    must have Ballot_Status
    (
        type = picklist
        displayname = "Ballot Status"
        values = {"Draft","Submitted","Locked"}
        initial value = "Draft"
        row = 3
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Ballot"
                tooltip = "Validate and securely save this ballot"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Ballot"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}