Validate_Challenge_Phase_Transition as "Validate Challenge Phase Transition"
{
    type = form
    form = Challenge_Settings
    record event = on edit
    description = "Enforces roster readiness and expected forward-only phase transitions."

    on validate
    {
        actions
        {
            custom deluge script
            (
                if(old.Challenge_Status != input.Challenge_Status)
                {
                    expected_status = "";
                    if(old.Challenge_Status == "Setup")
                    {
                        expected_status = "Submission Open";
                    }
                    else if(old.Challenge_Status == "Submission Open")
                    {
                        expected_status = "Voting Open";
                    }
                    else if(old.Challenge_Status == "Voting Open")
                    {
                        expected_status = "Judging Open";
                    }
                    else if(old.Challenge_Status == "Judging Open")
                    {
                        expected_status = "Finalization";
                    }
                    else if(old.Challenge_Status == "Finalization")
                    {
                        expected_status = "Results Published";
                    }
                    if(input.Challenge_Status != expected_status)
                    {
                        alert "Challenge phases may only move forward by one expected phase.";
                        cancel submit;
                    }
                    if(Members[Is_Active == true && (Login_Email == null || Login_Email == "")].count() > 0)
                    {
                        alert "Map a login email for every active participant and judge before changing phase.";
                        cancel submit;
                    }
                    if(input.Challenge_Status == "Results Published")
                    {
                        input.Results_Visible_To_Participants = true;
                    }
                    insert into Audit_Log
                    [
                        Event_Time = zoho.currenttime
                        Actor_Email = zoho.loginuser
                        Event_Type = "Phase Change"
                        Related_Form = "Challenge_Settings"
                        Related_Record_ID = input.ID.toString()
                        Event_Summary = "Challenge phase changed from " + old.Challenge_Status + " to " + input.Challenge_Status
                        Before_Value = old.Challenge_Status
                        After_Value = input.Challenge_Status
                        Severity = "Info"
                    ];
                }
            )
        }
    }
}