form AI_Settings
{
    title
    {
        displayname = "AI Settings"
        on add = "New AI Configuration"
        on edit = "Edit AI Configuration"
    }
    success message = "AI configuration saved securely."
    Main_Section
    (
        type = section
        displayname = "Service Configuration"
        row = 1
        column = 0
    )
    must have unique Setting_Name
    (
        type = text
        displayname = "Setting Name"
        initial value = "Default AI Configuration"
        row = 1
        column = 1
        width = medium
    )
    must have Base_URL
    (
        type = url
        displayname = "Base URL"
        row = 1
        column = 2
        width = medium
    )
    must have Model_Name
    (
        type = text
        displayname = "Model Name"
        row = 1
        column = 1
        width = medium
    )
    API_Key
    (
        type = text
        displayname = "API Key"
        isencrypted = true
        private = true
        description [ type = tooltip  message = "Administrator-only secret. Supply it during secure service setup; it is never written to status diagnostics." ]
        row = 1
        column = 2
        width = medium
    )
    must have Temperature
    (
        type = decimal
        displayname = "Temperature"
        decimalplace = 2
        initial value = 0.2
        row = 1
        column = 1
        width = medium
    )
    must have Max_Tokens
    (
        type = number
        displayname = "Max Tokens"
        initial value = 1800
        row = 1
        column = 2
        width = medium
    )
    must have System_Prompt
    (
        type = textarea
        displayname = "System Prompt"
        height = 160px
        row = 1
        column = 1
        width = medium
    )
    Status_Section
    (
        type = section
        displayname = "Service Status"
        visibility = true
        row = 2
        column = 1
    )
    Is_Enabled
    (
        type = checkbox
        displayname = "Enabled"
        initial value = false
        row = 2
        column = 1
        width = medium
    )
    Is_Current
    (
        type = checkbox
        displayname = "Current Configuration"
        initial value = true
        row = 2
        column = 2
        width = medium
    )
    Last_Tested_At
    (
        type = datetime
        displayname = "Last Tested At"
        row = 2
        column = 1
        width = medium
    )
    Last_Test_Status
    (
        type = text
        displayname = "Last Test Status"
        maxchar = 255
        row = 2
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Configuration"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Configuration"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}