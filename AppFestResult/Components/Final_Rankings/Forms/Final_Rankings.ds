form Final_Rankings
{
    displayname = "Final Rankings"
    success message = "Final ranking saved successfully."

    Main_Section
    (
        type = section
        displayname = "Ranking Details"
        row = 1
        column = 0
    )
    Ranking_Version
    (
        type = autonumber
        displayname = "Ranking Version"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Drafted_By
    (
        type = email
        displayname = "Drafted By"
        row = 1
        column = 1
        width = medium
    )
    must have Drafted_At
    (
        type = datetime
        displayname = "Drafted At"
        row = 1
        column = 2
        width = medium
    )
    must have Rank_1
    (
        type = picklist
        displayname = "1st Place"
        values = Applications.ID
        displayformat = [App_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Rank_2
    (
        type = picklist
        displayname = "2nd Place"
        values = Applications.ID
        displayformat = [App_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Rank_3
    (
        type = picklist
        displayname = "3rd Place"
        values = Applications.ID
        displayformat = [App_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Rank_4
    (
        type = picklist
        displayname = "4th Place"
        values = Applications.ID
        displayformat = [App_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Rank_5
    (
        type = picklist
        displayname = "5th Place"
        values = Applications.ID
        displayformat = [App_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Rank_6
    (
        type = picklist
        displayname = "6th Place"
        values = Applications.ID
        displayformat = [App_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Rank_7
    (
        type = picklist
        displayname = "7th Place"
        values = Applications.ID
        displayformat = [App_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Rank_8
    (
        type = picklist
        displayname = "8th Place"
        values = Applications.ID
        displayformat = [App_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Rank_9
    (
        type = picklist
        displayname = "9th Place"
        values = Applications.ID
        displayformat = [App_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )

    Decision_Section
    (
        type = section
        displayname = "Decision Rationale"
        visibility = true
        row = 2
        column = 1
    )
    must have Winner_Rationale
    (
        type = richtext
        displayname = "Winner Rationale"
        height = 180px
        toolbar = enable
        [
            style, alignment, bullets-and-numbering, link, remove-formatting,
            font-size : {2,3,4,5},
            font-family : {"Lato","Poppins"}
        ]
        row = 2
        column = 1
        width = medium
    )
    must have Ranking_Rationale
    (
        type = richtext
        displayname = "Full Ranking Rationale"
        height = 220px
        toolbar = enable
        [
            style, alignment, bullets-and-numbering, link, remove-formatting,
            font-size : {2,3,4,5},
            font-family : {"Lato","Poppins"}
        ]
        row = 2
        column = 2
        width = medium
    )

    Consensus_Section
    (
        type = section
        displayname = "Consensus Status"
        visibility = true
        row = 3
        column = 1
    )
    must have Decision_Status
    (
        type = picklist
        displayname = "Decision Status"
        values = {"Draft","Pending Consensus","Published","Superseded"}
        initial value = "Draft"
        row = 3
        column = 1
        width = medium
    )
    Based_On_AI_Analysis
    (
        type = picklist
        displayname = "Based On AI Analysis"
        values = AI_Analyses.ID
        displayformat = [Analysis_Run_ID]
        searchable = true
        row = 3
        column = 2
        width = medium
    )
    Published_At
    (
        type = datetime
        displayname = "Published At"
        row = 3
        column = 1
        width = medium
    )
    Is_Current
    (
        type = checkbox
        displayname = "Current Ranking"
        initial value = true
        row = 3
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Ranking"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Ranking"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}