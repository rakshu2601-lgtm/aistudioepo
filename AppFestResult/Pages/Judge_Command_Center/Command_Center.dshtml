<%
settings = Challenge_Settings[Current_Record == true];
submittedApps = Applications[Submission_Status == "Submitted" || Submission_Status == "Locked"];
submittedCount = submittedApps.count();
ballotCount = Participant_Ballots[Ballot_Status == "Submitted" || Ballot_Status == "Locked"].count();
activeParticipantCount = Members[Member_Type == "Participant" && Is_Active == true].count();
activeJudgeCount = Members[Member_Type == "Judge" && Is_Active == true].count();
evaluationCount = Judge_Evaluations[Evaluation_Status == "Submitted" || Evaluation_Status == "Locked"].count();
expectedEvaluations = submittedCount * activeJudgeCount;
currentJudge = Members[Member_Type == "Judge" && Is_Active == true && Login_Email == zoho.loginuser];
myEvaluationCount = Judge_Evaluations[(Evaluation_Status == "Submitted" || Evaluation_Status == "Locked") && Judge_Email == zoho.loginuser].count();
currentRanking = Final_Rankings[Is_Current == true && Decision_Status == "Pending Consensus"];
approvalCount = 0;
if(currentRanking.count() > 0)
{
  approvalCount = Final_Approvals[Final_Ranking == currentRanking.ID && Decision == "Approve"].count();
}
aiConfig = AI_Settings[Is_Current == true];
latestAnalysis = AI_Analyses[Is_Latest == true];
phase = "Setup";
challengeTitle = "Om.ai Beyond Limits Challenge";
deadlineText = "Schedule pending";
if(settings.count() > 0)
{
  phase = settings.Challenge_Status;
  challengeTitle = settings.Challenge_Title;
  deadlineText = settings.Judging_Closes.toString("dd MMM yyyy, hh:mm a");
}
ballotReady = ballotCount == activeParticipantCount && activeParticipantCount > 0;
evaluationsReady = evaluationCount == expectedEvaluations && expectedEvaluations > 0;
analysisReady = ballotReady && evaluationsReady;
%>
<style>
/* zcs-global utility sheet, scoped page essentials */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff}.zcs-flex{display:flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-p-16{padding:1rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-md{border-radius:.375rem}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:14px}.zcs-button{min-height:36px;text-decoration:none}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}
.jcc{font-family:Inter,Arial,sans-serif;color:var(--zcs_primary_text_color);background:linear-gradient(180deg,#080b21 0,#11183b 330px,#f4f6fb 330px);padding:24px;min-height:100vh;box-sizing:border-box}.hero{position:relative;overflow:hidden;color:#fff;padding:32px;border:1px solid rgba(255,255,255,.16);border-radius:24px;background:radial-gradient(circle at 85% 15%,rgba(90,224,255,.32),transparent 30%),linear-gradient(125deg,#202a78,#7135a8 55%,#087f8c);box-shadow:0 24px 60px rgba(2,8,35,.35)}.hero:after{content:"";position:absolute;width:260px;height:260px;border:1px solid rgba(255,255,255,.18);border-radius:50%;right:-70px;top:-100px;animation:orbit 10s linear infinite}.eyebrow{letter-spacing:.14em;text-transform:uppercase;font-size:12px;font-weight:700;opacity:.82}.hero h1{font-size:clamp(28px,4vw,52px);line-height:1.03;margin:10px 0}.hero-meta{display:flex;gap:12px;flex-wrap:wrap;margin-top:20px}.glass{padding:10px 14px;border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.12);border-radius:12px;backdrop-filter:blur(8px)}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.actions .zcs-button{padding:9px 14px;border-radius:9px}.actions .light{background:#fff;color:#242d74}.actions .ghost{color:#fff;border:1px solid rgba(255,255,255,.45)}.kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:18px 0}.kpi{padding:18px;box-shadow:0 10px 30px rgba(19,31,71,.12)}.kpi .icon{width:38px;height:38px;border-radius:10px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color)}.value{font-size:28px;font-weight:750;margin-top:12px}.label{font-size:13px;color:var(--zcs_secondary_text_color)}.section-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.85fr);gap:16px;margin-top:16px}.panel{padding:20px;box-shadow:0 8px 24px rgba(26,38,78,.08)}.panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:16px}.panel h2{font-size:19px;margin:0}.muted{color:var(--zcs_secondary_text_color);font-size:13px}.zcs-table-wrapper{overflow:auto;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px}.zcs-table-wrapper table{width:100%;border-collapse:collapse;min-width:660px}.zcs-table-wrapper th,.zcs-table-wrapper td{padding:11px 12px;border-bottom:1px solid var(--zcs_tertiary_border_color);text-align:left;font-size:13px}.zcs-table-wrapper th{background:#f7f8fc;font-weight:650}.meter{height:8px;background:#e8ebf4;border-radius:99px;overflow:hidden}.meter>span{display:block;height:100%;background:linear-gradient(90deg,var(--zcs_brand_color),#14b8a6);border-radius:inherit}.judge-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.judge-card{padding:14px;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.judge-name{font-weight:650}.status{display:inline-flex;align-items:center;gap:6px;font-size:12px;border-radius:99px;padding:4px 8px}.ok{background:#e8f8f1;color:#08734e}.warn{background:#fff4dd;color:#875100}.bad{background:#feeceb;color:#a42b28}.category-row{display:grid;grid-template-columns:150px 1fr 48px;gap:10px;align-items:center;margin:12px 0;font-size:13px}.prediction-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.prediction{padding:16px;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;background:linear-gradient(145deg,#fff,#f6f7ff)}.prediction h3{font-size:14px;color:var(--zcs_secondary_text_color);margin:0 0 8px}.winner{font-size:20px;font-weight:700}.feed{display:grid;gap:10px}.feed-item{padding:12px;border-left:3px solid var(--zcs_brand_color);background:#f8f9fd;border-radius:0 10px 10px 0}.warning{border:1px solid #e0a32e;background:#fff8e8;color:#694600;padding:13px;border-radius:10px;display:flex;gap:9px;margin-bottom:10px}.error{border-color:#da5a52;background:#fff0ef;color:#7c211d}.stepper{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.step{position:relative;text-align:center;padding:14px 8px;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.step .dot{width:30px;height:30px;border-radius:50%;margin:0 auto 8px;background:#e7e9f1;display:flex;align-items:center;justify-content:center}.step.approved .dot{background:#15966b;color:#fff}.empty{padding:28px;text-align:center;color:var(--zcs_secondary_text_color);border:1px dashed var(--zcs_tertiary_border_color);border-radius:12px}.skeleton{height:12px;border-radius:8px;background:linear-gradient(90deg,#eceef4,#f8f9fc,#eceef4);background-size:220% 100%;animation:shimmer 1.8s infinite}.variance{font-weight:650;color:#b0433d}.safe{color:#08734e}.score-link{font-weight:650;color:var(--zcs_brand_color);text-decoration:none}@keyframes orbit{to{transform:rotate(360deg)}}@keyframes shimmer{to{background-position:-220% 0}}@media(max-width:1000px){.kpis{grid-template-columns:repeat(2,1fr)}.section-grid{grid-template-columns:1fr}.prediction-grid{grid-template-columns:1fr}}@media(max-width:620px){.jcc{padding:12px}.hero{padding:22px}.kpis{grid-template-columns:1fr}.judge-grid,.stepper{grid-template-columns:1fr}.category-row{grid-template-columns:110px 1fr 42px}.actions .zcs-button{width:100%;box-sizing:border-box}}@media(prefers-reduced-motion:reduce){*{animation:none!important;scroll-behavior:auto!important}}
</style>
<div class="jcc">
  <section class="hero" aria-labelledby="command-title">
    <div class="eyebrow">Judge operations deck</div>
    <h1 id="command-title"><%=challengeTitle%></h1>
    <p>Peer signal, independent scoring, explainable prediction, and unanimous consensus in one decision surface.</p>
    <div class="hero-meta">
      <div class="glass"><i class="zc-li-outline ui-2-time"></i> Phase: <strong><%=phase%></strong></div>
      <div class="glass"><i class="zc-li-outline ui-1-calendar-57"></i> Judging closes: <strong><%=deadlineText%></strong></div>
      <div class="glass"><i class="zc-li-outline users-single-05"></i> Signed in: <strong><%=zoho.loginuser%></strong></div>
    </div>
    <nav class="actions" aria-label="Judge actions">
      <a class="zcs-button zcs-flex zcs-align-items-center zcs-gap-8 light" href="#Form:AI_Analyses"><i class="zc-li-outline tech-ai"></i><span>Run analysis</span></a>
      <a class="zcs-button zcs-flex zcs-align-items-center zcs-gap-8 ghost" href="#Report:My_Judge_Scores"><i class="zc-li-outline ui-1-edit-72"></i><span>Open scorecards</span></a>
      <a class="zcs-button zcs-flex zcs-align-items-center zcs-gap-8 ghost" href="#Form:Final_Rankings"><i class="zc-li-outline design-list-bullet"></i><span>Draft ranking</span></a>
      <a class="zcs-button zcs-flex zcs-align-items-center zcs-gap-8 ghost" href="#Report:My_Approval_Action"><i class="zc-li-outline ui-1-check-circle-08"></i><span>Approve consensus</span></a>
    </nav>
  </section>

  <section class="kpis" aria-label="Challenge completion metrics">
    <article class="kpi zcs-card"><div class="icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline files-folder-13"></i></div><div class="value"><%=submittedCount%>/9</div><div class="label">Submitted applications</div></article>
    <article class="kpi zcs-card"><div class="icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-check-square-09"></i></div><div class="value"><%=ballotCount%>/<%=activeParticipantCount%></div><div class="label">Ballots complete</div></article>
    <article class="kpi zcs-card"><div class="icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline education-paper-diploma"></i></div><div class="value"><%=evaluationCount%>/<%=expectedEvaluations%></div><div class="label">Evaluations complete</div></article>
    <article class="kpi zcs-card"><div class="icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div class="value"><%=approvalCount%>/3</div><div class="label">Consensus approvals</div></article>
  </section>

  <% if(!analysisReady) { %><div class="warning"><i class="zc-li-outline travel-info"></i><div><strong>Analysis is gated by incomplete data.</strong> Complete all <%=activeParticipantCount%> ballots and <%=expectedEvaluations%> submitted evaluations before relying on a prediction.</div></div><% } %>
  <% if(latestAnalysis.count() > 0 && latestAnalysis.Analysis_Status == "Failed") { %><div class="warning error"><i class="zc-li-outline ui-1-circle-remove"></i><div><strong>Latest AI run failed.</strong> <%=latestAnalysis.Failure_Message%> Review the safe diagnostic and retry after service recovery.</div></div><% } %>

  <div class="section-grid">
    <section class="panel zcs-card">
      <div class="panel-head"><div><h2>Judge score completion</h2><div class="muted">Independent submitted scorecards by named judge</div></div><a class="score-link" href="#Report:Scorecard_Progress">Full progress</a></div>
      <div class="judge-grid">
      <% for each judge in Members[Member_Type == "Judge" && Is_Active == true] sort by Display_Order asc { judgeDone = Judge_Evaluations[(Evaluation_Status == "Submitted" || Evaluation_Status == "Locked") && Judge == judge.ID].count(); judgePct = 0; if(submittedCount > 0){judgePct = (judgeDone * 100) / submittedCount;} %>
        <article class="judge-card"><div class="judge-name"><%=judge.Member_Name%></div><div class="muted"><%=judgeDone%> of <%=submittedCount%> scorecards</div><div class="meter" aria-label="<%=judgePct%> percent complete"><span style="width:<%=judgePct%>%"></span></div><div class="status <% if(judgeDone == submittedCount && submittedCount > 0){ %>ok<% } else { %>warn<% } %>"><i class="zc-li-outline ui-1-check-small"></i><%=judgePct%>% complete</div></article>
      <% } %>
      </div>
      <% if(currentJudge.count() == 0) { %><div class="empty">No active judge identity is mapped to this login. Ask an administrator to map the roster email.</div><% } else { %><p class="muted">Your submitted coverage: <strong><%=myEvaluationCount%> of <%=submittedCount%></strong>. <a class="score-link" href="#Form:Judge_Evaluations">Add a scorecard</a></p><% } %>
    </section>

    <aside class="panel zcs-card">
      <div class="panel-head"><div><h2>AI service</h2><div class="muted">Credential-safe operational status</div></div></div>
      <% if(aiConfig.count() == 0) { %><div class="empty">No current AI configuration exists.</div><% } else { %>
      <div class="status <% if(aiConfig.Is_Enabled){ %>ok<% } else { %>warn<% } %>"><i class="zc-li-outline tech-robot"></i><% if(aiConfig.Is_Enabled){ %>Enabled<% } else { %>Disabled<% } %></div>
      <p><strong>Model:</strong> <%=aiConfig.Model_Name%></p><p><strong>Last test:</strong> <%=aiConfig.Last_Test_Status%></p><p class="muted">Endpoint credentials are intentionally never rendered on this page.</p><a class="score-link" href="#Report:AI_Service_Status">Open service status</a>
      <% } %>
    </aside>
  </div>

  <div class="section-grid">
    <section class="panel zcs-card">
      <div class="panel-head"><div><h2>Application signal leaderboard</h2><div class="muted">Peer Borda points versus average judge weighted score</div></div><a class="score-link" href="#Report:Application_Score_Summary">Score summary</a></div>
      <% if(submittedCount == 0) { %><div class="empty"><div class="skeleton"></div><p>No submitted applications yet.</p></div><% } else { %>
      <div class="zcs-table-wrapper"><table><thead><tr><th>Application</th><th>Peer Borda</th><th>Judge average</th><th>Variance flag</th></tr></thead><tbody>
      <% for each app in submittedApps { borda = 0; for each ballot in Participant_Ballots[Ballot_Status == "Submitted" || Ballot_Status == "Locked"] { if(ballot.Rank_1 == app.ID){borda=borda+8;} if(ballot.Rank_2 == app.ID){borda=borda+7;} if(ballot.Rank_3 == app.ID){borda=borda+6;} if(ballot.Rank_4 == app.ID){borda=borda+5;} if(ballot.Rank_5 == app.ID){borda=borda+4;} if(ballot.Rank_6 == app.ID){borda=borda+3;} if(ballot.Rank_7 == app.ID){borda=borda+2;} if(ballot.Rank_8 == app.ID){borda=borda+1;} } appEvals = Judge_Evaluations[Application == app.ID && (Evaluation_Status == "Submitted" || Evaluation_Status == "Locked")]; avgScore = 0; spread = 0; if(appEvals.count() > 0){avgScore=appEvals.avg(Weighted_Total);lowestScore=null;highestScore=null;for each appEval in appEvals{currentScore=appEval.Weighted_Total;if(lowestScore == null || currentScore < lowestScore){lowestScore=currentScore;}if(highestScore == null || currentScore > highestScore){highestScore=currentScore;}}if(lowestScore != null && highestScore != null){spread=highestScore-lowestScore;}} %>
        <tr><td><strong><%=app.App_Name%></strong><div class="muted"><%=app.Tagline%></div></td><td><%=borda%></td><td><%=avgScore.round(1)%>/100</td><td class="<% if(spread >= 15){ %>variance<% } else { %>safe<% } %>"><i class="zc-li-outline <% if(spread >= 15){ %>travel-info<% } else { %>ui-1-check-small<% } %>"></i> <%=spread.round(1)%> point spread</td></tr>
      <% } %></tbody></table></div><% } %>
    </section>

    <aside class="panel zcs-card">
      <div class="panel-head"><div><h2>Category performance</h2><div class="muted">All submitted judge evaluations</div></div></div>
      <% allEvals = Judge_Evaluations[Evaluation_Status == "Submitted" || Evaluation_Status == "Locked"]; if(allEvals.count() == 0) { %><div class="empty">Category bars appear after scorecards are submitted.</div><% } else { uiAvg=allEvals.avg(UI_Score)*10; navAvg=allEvals.avg(Navigation_Usability_Score)*10; coreAvg=allEvals.avg(Core_Functionality_Score)*10; innovationAvg=allEvals.avg(Innovation_Score)*10; proofAvg=allEvals.avg(Beyond_Creator_Proof_Score)*10; integrationAvg=allEvals.avg(Catalyst_Integrations_Score)*10; presentationAvg=allEvals.avg(Presentation_Score)*10; labels={"UI","Navigation","Core function","Innovation","Beyond Creator","Integrations","Presentation"}; values={uiAvg,navAvg,coreAvg,innovationAvg,proofAvg,integrationAvg,presentationAvg}; for each index i in labels { %><div class="category-row"><span><%=labels.get(i)%></span><div class="meter"><span style="width:<%=values.get(i)%>%"></span></div><strong><%=values.get(i).round(0)%></strong></div><% } } %>
    </aside>
  </div>

  <section class="panel zcs-card" style="margin-top:16px">
    <div class="panel-head"><div><h2>Latest AI predictions</h2><div class="muted">Recommendations remain advisory until unanimous approval</div></div><a class="score-link" href="#Report:AI_Analysis_History">Analysis history</a></div>
    <% if(latestAnalysis.count() == 0 || latestAnalysis.Analysis_Status != "Completed") { %><div class="empty"><i class="zc-li-outline tech-ai"></i><p>No completed latest prediction is available. Run analysis when data is complete.</p></div><% } else { teamConfidence=latestAnalysis.Team_Confidence; judgeConfidence=latestAnalysis.Judge_Confidence; overallConfidence=(teamConfidence+judgeConfidence)/2; %>
    <div class="prediction-grid">
      <article class="prediction"><h3>Team winner</h3><div class="winner"><%=latestAnalysis.Team_Vote_Predicted_Winner.App_Name%></div><div class="meter"><span style="width:<%=teamConfidence%>%"></span></div><p class="muted"><%=teamConfidence.round(0)%>% confidence</p><div><%=latestAnalysis.Team_Analysis%></div></article>
      <article class="prediction"><h3>Judge winner</h3><div class="winner"><%=latestAnalysis.Judge_Score_Predicted_Winner.App_Name%></div><div class="meter"><span style="width:<%=judgeConfidence%>%"></span></div><p class="muted"><%=judgeConfidence.round(0)%>% confidence</p><div><%=latestAnalysis.Judge_Analysis%></div></article>
      <article class="prediction"><h3>Overall recommendation</h3><div class="winner"><%=latestAnalysis.Overall_Recommended_Winner.App_Name%></div><div class="meter"><span style="width:<%=overallConfidence%>%"></span></div><p class="muted">Combined signal <%=overallConfidence.round(0)%>%</p><div><%=latestAnalysis.Consensus_And_Disagreement%></div></article>
    </div><% } %>
  </section>

  <div class="section-grid">
    <section class="panel zcs-card">
      <div class="panel-head"><div><h2>Ballot explanation feed</h2><div class="muted">Judge-visible evidence behind first-choice rankings</div></div><a class="score-link" href="#Report:Ballot_Audit">Open ballot audit</a></div>
      <div class="feed"><% feedCount=0; for each ballot in Participant_Ballots[Ballot_Status == "Submitted" || Ballot_Status == "Locked"] sort by Submitted_At desc { if(feedCount < 5){ %><article class="feed-item"><strong><%=ballot.Voter.Member_Name%> backed <%=ballot.Rank_1.App_Name%></strong><p><%=ballot.Best_App_Explanation%></p><div class="muted"><%=ballot.Submitted_At%></div></article><% feedCount=feedCount+1; } } if(feedCount == 0){ %><div class="empty">No submitted ballot explanations are available.</div><% } %></div>
    </section>

    <aside class="panel zcs-card">
      <div class="panel-head"><div><h2>Consensus finalization</h2><div class="muted">All three judges must approve the unchanged ranking</div></div></div>
      <div class="stepper">
      <% names={"Siddarth","Monica","Brandon"}; for each name in names { approved=false; if(currentRanking.count() > 0){approved=Final_Approvals[Final_Ranking == currentRanking.ID && Judge.Member_Name == name && Decision == "Approve"].count() > 0;} %><div class="step <% if(approved){ %>approved<% } %>"><div class="dot"><i class="zc-li-outline <% if(approved){ %>ui-1-check-small<% } else { %>ui-2-time<% } %>"></i></div><strong><%=name%></strong><div class="muted"><% if(approved){ %>Approved<% } else { %>Awaiting decision<% } %></div></div><% } %>
      </div>
      <% if(currentRanking.count() == 0) { %><div class="warning" style="margin-top:14px"><i class="zc-li-outline travel-info"></i><span>No current ranking is pending consensus. Draft and submit a ranking first.</span></div><% } %>
      <div class="actions"><a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md" href="#Report:Consensus_Status"><i class="zc-li-outline ui-1-check-circle-08"></i><span>Review consensus</span></a></div>
    </aside>
  </div>
</div>