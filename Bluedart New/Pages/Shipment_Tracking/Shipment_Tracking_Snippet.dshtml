<%
shipment_rows = Shipment_Requests[ID == input.Shipment_ID];
shipment_found = shipment_rows.count(ID) > 0;
current_profile = thisapp.permissions.loginUserProfile();
is_internal = current_profile == "Logistics_Administrator" || current_profile == "Operations_Manager" || current_profile == "Hub_Supervisor" || current_profile == "Hub_Operator" || current_profile == "Field_Agent" || current_profile == "Finance_Officer";
authorized = false;
is_customer = false;
if(shipment_found)
{
    shipment = shipment_rows;
    owner_email = ifnull(shipment.Customer.Portal_Login_Email,"").trim();
    fallback_email = ifnull(shipment.Customer.Email_ID,"").trim();
    is_customer = owner_email == zoho.loginuserid || fallback_email == zoho.loginuserid;
    authorized = is_customer || is_internal;
}
if(shipment_found && authorized)
{
    shipment_id = shipment.ID;
    status = ifnull(shipment.Shipment_Status,"Booked");
    visible_events = Shipment_Tracking_Events[Shipment == shipment_id] sort by Event_Time desc;
    if(is_customer)
    {
        visible_events = Shipment_Tracking_Events[Shipment == shipment_id && Customer_Visible == true] sort by Event_Time desc;
    }

    booked_reached = true;
    picked_reached = Shipment_Tracking_Events[Shipment == shipment_id && Event_Status == "Picked Up"].count(ID) > 0;
    transit_reached = Shipment_Tracking_Events[Shipment == shipment_id && (Event_Status == "In Transit" || Event_Status == "Inbound at Branch Station" || Event_Status == "Bagged & Dispatched to Origin Hub" || Event_Status == "Sorted at Origin Hub" || Event_Status == "Arrived at Destination Hub" || Event_Status == "At Delivery Hub")].count(ID) > 0;
    ofd_reached = Shipment_Tracking_Events[Shipment == shipment_id && Event_Status == "Out For Delivery (OFD)"].count(ID) > 0;
    delivered_reached = Shipment_Tracking_Events[Shipment == shipment_id && Event_Status == "Delivered"].count(ID) > 0 || status == "Delivered";
    if(status == "Picked Up") { picked_reached = true; }
    if(status == "Inbound at Branch Station" || status == "Bagged & Dispatched to Origin Hub" || status == "Sorted at Origin Hub" || status == "In Transit" || status == "Arrived at Destination Hub" || status == "At Delivery Hub") { picked_reached = true; transit_reached = true; }
    if(status == "Out For Delivery (OFD)") { picked_reached = true; transit_reached = true; ofd_reached = true; }
    if(delivered_reached) { picked_reached = true; transit_reached = true; ofd_reached = true; }
    current_step = 1;
    if(picked_reached) { current_step = 2; }
    if(transit_reached) { current_step = 3; }
    if(ofd_reached) { current_step = 4; }
    if(delivered_reached) { current_step = 5; }
    progress_percent = current_step * 20;

    origin_name = "Assignment pending";
    if(shipment.Origin_Sorting_Hub != null) { origin_name = shipment.Origin_Sorting_Hub.Hub_Name; }
    else if(shipment.Collection_Center != null) { origin_name = shipment.Collection_Center.Hub_Name; }
    destination_name = "Assignment pending";
    if(shipment.Destination_Hub != null) { destination_name = shipment.Destination_Hub.Hub_Name; }
    else if(shipment.Destination_Sorting_Hub != null) { destination_name = shipment.Destination_Sorting_Hub.Hub_Name; }
    current_hub_name = "In network transit";
    if(shipment.Current_Hub != null) { current_hub_name = shipment.Current_Hub.Hub_Name; }
    else
    {
        hub_context = Shipment_Tracking_Events[Shipment == shipment_id && Hub != null] sort by Event_Time desc range from 0 to 0;
        if(hub_context.count(ID) > 0) { current_hub_name = hub_context.Hub.Hub_Name; }
    }

    manifest_number = "Not currently manifested";
    manifest_status = "Not available";
    manifest_event = Shipment_Tracking_Events[Shipment == shipment_id && Manifest != null] sort by Event_Time desc range from 0 to 0;
    if(manifest_event.count(ID) > 0)
    {
        manifest_number = manifest_event.Manifest.Manifest_Number;
        manifest_status = manifest_event.Manifest.Manifest_Status;
    }
    bag_number = "Not currently bagged";
    bag_status = "Not available";
    bag_event = Shipment_Tracking_Events[Shipment == shipment_id && Bag != null] sort by Event_Time desc range from 0 to 0;
    if(bag_event.count(ID) > 0)
    {
        bag_number = bag_event.Bag.Bag_Number;
        bag_status = bag_event.Bag.Bag_Status;
    }

    payment_badge = "zcs-badge-yellow";
    payment_icon = "ui-2-time";
    if(shipment.Payment_Status == "Paid" || shipment.Payment_Status == "Not Required") { payment_badge = "zcs-badge-green"; payment_icon = "ui-1-check-circle-08"; }
    else if(shipment.Payment_Status == "Failed") { payment_badge = "zcs-badge-red"; payment_icon = "ui-1-circle-remove"; }
    status_badge = "zcs-badge-blue";
    status_icon = "loader-dots-06";
    if(delivered_reached) { status_badge = "zcs-badge-green"; status_icon = "ui-1-check-circle-08"; }
    else if(status == "Delivery Failed - NDR" || status == "Credit Hold" || status == "Return to Origin" || status == "Cancelled") { status_badge = "zcs-badge-orange"; status_icon = "travel-info"; }

    exception_event = Shipment_Tracking_Events[Shipment == shipment_id && Event_Status == "Exception"] sort by Event_Time desc range from 0 to 0;
    has_exception = exception_event.count(ID) > 0;
    if(is_customer)
    {
        exception_event = Shipment_Tracking_Events[Shipment == shipment_id && Event_Status == "Exception" && Customer_Visible == true] sort by Event_Time desc range from 0 to 0;
        has_exception = exception_event.count(ID) > 0;
    }

    ofd_item = Delivery_Run_Sheet_Items[Shipment == shipment_id && Delivery_Status == "Out For Delivery"] sort by Stop_Sequence asc range from 0 to 0;
    latest_latitude = null;
    latest_longitude = null;
    latest_location_at = null;
    stops_remaining = null;
    if(ofd_item.count(ID) > 0)
    {
        if(ofd_item.Agent_Latitude != null && ofd_item.Agent_Longitude != null)
        {
            latest_latitude = ofd_item.Agent_Latitude;
            latest_longitude = ofd_item.Agent_Longitude;
            latest_location_at = ofd_item.Arrived_At;
        }
        stops_remaining = Delivery_Run_Sheet_Items[Delivery_Run_Sheet == ofd_item.Delivery_Run_Sheet && Stop_Sequence > ofd_item.Stop_Sequence && (Delivery_Status == "Assigned" || Delivery_Status == "Out For Delivery")].count(ID);
        if(latest_latitude == null || latest_longitude == null)
        {
            run_record = Delivery_Run_Sheets[ID == ofd_item.Delivery_Run_Sheet];
            if(run_record.count(ID) > 0)
            {
                assigned_agent = Operations_Users[ID == run_record.Assigned_Agent && Active == true];
                if(assigned_agent.count(ID) > 0 && assigned_agent.Current_Latitude != null && assigned_agent.Current_Longitude != null)
                {
                    latest_latitude = assigned_agent.Current_Latitude;
                    latest_longitude = assigned_agent.Current_Longitude;
                    latest_location_at = assigned_agent.Last_Location_At;
                }
            }
        }
    }
    if(status == "Out For Delivery (OFD)" && (latest_latitude == null || latest_longitude == null))
    {
        location_event = Shipment_Tracking_Events[Shipment == shipment_id && Event_Status == "Out For Delivery (OFD)" && Latitude != null && Longitude != null] sort by Event_Time desc range from 0 to 0;
        if(location_event.count(ID) > 0)
        {
            latest_latitude = location_event.Latitude;
            latest_longitude = location_event.Longitude;
            latest_location_at = location_event.Event_Time;
        }
    }
    map_url = "";
    if(latest_latitude != null && latest_longitude != null) { map_url = "https://www.google.com/maps/search/?api=1&query=" + latest_latitude + "," + latest_longitude; }

    delivered_item = Delivery_Run_Sheet_Items[Shipment == shipment_id && Delivery_Status == "Delivered"] sort by Completed_At desc range from 0 to 0;
    delivered_recipient = "Not recorded";
    delivered_at = null;
    proof_type = "Electronic proof";
    epod_url = ifnull(shipment.EPOD_Download_URL,"");
    if(delivered_item.count(ID) > 0)
    {
        delivered_recipient = ifnull(delivered_item.Recipient_Name,"Not recorded");
        delivered_at = delivered_item.Completed_At;
        proof_type = ifnull(delivered_item.Proof_Type,"Electronic proof");
        if(epod_url == "") { epod_url = ifnull(delivered_item.EPOD_URL,""); }
    }
    expected_text = "Delivery estimate pending";
    if(shipment.Expected_Delivery_Date != null) { expected_text = shipment.Expected_Delivery_Date.toString("dd-MMM-yyyy"); }
    tracking_report = if(is_customer,"Customer_Tracking_Events","Shipment_Timeline");
%>
<style>
/* zcs-global.css: page-scoped, deduplicated utilities used by this page */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#F3F3F4;--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-row-wrap{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-col-2{flex:0 0 16.666%;max-width:16.666%}.zcs-col-10{flex:0 0 83.333%;max-width:83.333%}.zcs-col-12{flex:0 0 100%;max-width:100%}.zcs-gap-0{gap:0}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-gap-32{gap:2rem}.zcs-p-0{padding:0}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-px-60{padding-left:3.75rem;padding-right:3.75rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-20{padding-top:1.25rem;padding-bottom:1.25rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-5{margin-top:.3125rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mb-0{margin-bottom:0}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-color-white{color:#fff}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-no-shrink{flex-shrink:0}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}
/* ZCS component CSS: card-fleet-trip-summary-card, stepper-in-progress, timeline-timeline-advanced, badge-badge-with-icon, button-primary-button, label-value-key-value-with-icon, banner-outline-banner-with-icon, no-data-no-data-text-only */
.zcs-page{min-height:100%;background:var(--zcs-page-bg-color);font-family:Arial,sans-serif}.tracking-shell{max-width:1440px;margin:0 auto}.awb-header{background:linear-gradient(125deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));color:var(--zcs_brand_foreground_color);border:0}.awb-header .zcs-color-primary,.awb-header .zcs-color-tertiary{color:var(--zcs_brand_foreground_color)}.control-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(310px,1fr);gap:20px}.context-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.section-title{border-bottom:1px solid var(--zcs_tertiary_border_color);padding-bottom:12px}.route-band{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px}.route-node:last-child{text-align:right}.route-line{height:1px;min-width:80px;background:var(--zcs_tertiary_border_color)}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}.zcs-stepper-status{width:32px;height:32px;background:var(--zcs_brand_color);border:4px solid var(--zcs-white-color)}.zcs-stepper-count{display:none}.zcs-stepper-icon.zcs-stepper-failed{display:none}.zcs-stepper-level{display:none}.zcs-stepper:not(:last-child):before{content:'';width:100%;height:1px;border-top:1px solid var(--zcs_brand_color);box-sizing:border-box;position:absolute;top:15px;left:50%}.zcs-stepper-active .zcs-stepper-status{border:1px solid var(--zcs_brand_color);outline:4px solid var(--zcs-white-color);background:var(--zcs-white-color)}.zcs-stepper-active .zcs-stepper-count{display:flex;border:0;color:var(--zcs_brand_color)}.zcs-stepper-active .zcs-stepper-icon{display:none}.zcs-stepper-active .zcs-stepper-text{font-weight:500;color:var(--zcs_brand_color)}.zcs-stepper-active:before,.zcs-stepper-active~.zcs-stepper:before{border-color:var(--zcs_tertiary_border_color)}.zcs-stepper-active~.zcs-stepper .zcs-stepper-status{background:var(--zcs-white-color)}.zcs-stepper-active~.zcs-stepper .zcs-stepper-count{display:flex}.zcs-stepper-active~.zcs-stepper .zcs-stepper-icon{display:none}.zcs-stepper-active~.zcs-stepper .zcs-stepper-text{color:var(--zcs_tertiary_text_color)}.zcs-tl-indicator{width:60px;left:16.666%}.zcs-tl-dot{width:12px;height:12px;background:var(--zcs_brand_color);border:1px solid #fff;box-shadow:0 2px 6px #C4DEE4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:'';position:absolute;width:1px;height:calc(100% + 32px);background:#E1E1E1;top:5px}.zcs-badge{width:auto;border:1px solid}.zcs-badge-green{background:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-red{background:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-yellow{background:#FCF4E6;border-color:#FAAE13;color:#9a6700}.zcs-badge-blue{background:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-orange{background:#F8F0EB;border-color:#F4660C;color:#F4660C}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-button:hover{filter:brightness(.96)}.zcs-outline-toast{border:1px solid}.zcs-theme-toast{background:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color)}.zcs-warning-toast{background:#fef4e5;color:#663c01;border-color:#edb25b}.map-ready{min-height:190px;background:linear-gradient(145deg,var(--zcs_component_hover_color),#fff);border:1px dashed var(--zcs_brand_color);overflow:hidden}.map-grid{background-image:linear-gradient(var(--zcs_tertiary_border_color) 1px,transparent 1px),linear-gradient(90deg,var(--zcs_tertiary_border_color) 1px,transparent 1px);background-size:28px 28px}.integration-note{border-top:1px solid var(--zcs_tertiary_border_color);padding-top:10px}.timeline-empty{min-height:180px}.amount{font-variant-numeric:tabular-nums}.epod-card{border-left:4px solid var(--zcs_brand_color)}
@media(max-width:992px){.control-grid{grid-template-columns:1fr}.context-grid{grid-template-columns:1fr 1fr}.zcs-tl-li{flex-direction:column}.zcs-tl-indicator{left:0}.zcs-tl-time{text-align:left;padding:0 60px;margin-bottom:12px}.zcs-tl-li>div:last-child{max-width:100%;padding-left:60px;padding-right:0}}
@media(max-width:575px){.tracking-shell{padding:16px}.awb-header{align-items:flex-start;flex-direction:column}.context-grid{grid-template-columns:1fr}.route-band{grid-template-columns:1fr}.route-node:last-child{text-align:left}.route-line{display:none}.zcs-stepper-wrapper ul{flex-direction:column;gap:24px}.zcs-stepper-wrapper ul .zcs-stepper{flex-direction:row;gap:16px}.zcs-stepper:not(:last-child):before{width:1px;height:100%;border-left:1px solid var(--zcs_brand_color);border-top:0;left:15px}.zcs-button{width:100%}.zcs-tl-time{padding-left:44px}.zcs-tl-li>div:last-child{padding-left:44px}}
</style>
<div class='zcs-page zcs-wh-full'>
  <div class='tracking-shell zcs-flex zcs-direction-column zcs-gap-20 zcs-px-24 zcs-py-24 zcs-box-border'>
    <section class='awb-header zcs-card zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-20 zcs-p-24 zcs-box-border'>
      <div class='zcs-flex zcs-direction-column zcs-gap-6'>
        <p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Live shipment control tower</p>
        <h1 class='zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>AWB <%=shipment.AWB_Number%></h1>
        <p class='zcs-font-14 zcs-color-tertiary zcs-m-0'><%=shipment.Pickup_Pincode%> to <%=shipment.Delivery_Pincode%> | <%=shipment.Transport_Mode%></p>
      </div>
      <div class='zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-10'>
        <span class='zcs-badge <%=status_badge%> zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border'><i class='zc-li-outline <%=status_icon%>'></i><span class='zcs-font-14'><%=status%></span></span>
        <span class='zcs-badge <%=payment_badge%> zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border'><i class='zc-li-outline <%=payment_icon%>'></i><span class='zcs-font-14'><%=shipment.Payment_Type%>: <%=shipment.Payment_Status%></span></span>
      </div>
    </section>

    <% if(has_exception) { %>
    <div class='zcs-toast zcs-outline-toast zcs-warning-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14'>
      <i class='zcs-no-shrink zcs-lh-body zc-li-outline travel-info'></i>
      <p class='zcs-m-0'><strong>Delivery update:</strong> This shipment needs attention. Our operations team is working on the next safe movement. Customer-facing tracking intentionally excludes internal exception notes.</p>
    </div>
    <% } %>

    <section class='zcs-card zcs-flex zcs-direction-column zcs-gap-20 zcs-p-24 zcs-box-border'>
      <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-row-wrap'>
        <div><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Shipment milestones</h2><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Built from shipment tracking events</p></div>
        <strong class='zcs-font-14 zcs-color-theme'><%=progress_percent%>% complete</strong>
      </div>
      <div class='zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6'><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=progress_percent%>%;'></div></div></div>
      <div class='zcs-stepper-wrapper'>
        <ul class='zcs-flex zcs-gap-8 zcs-p-0 zcs-m-0'>
          <% milestone_names = {"Booked","Picked Up","In Transit","Out For Delivery","Delivered"}; for each index i in milestone_names { step_number = i + 1; active_class = if(step_number == current_step,"zcs-stepper-active",""); %>
          <li class='zcs-stepper <%=active_class%> zcs-col-common zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-4 zcs-text-center zcs-relative'>
            <div class='zcs-stepper-status zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-text-center zcs-relative zcs-box-border'>
              <h6 class='zcs-stepper-count zcs-col-common zcs-w-full zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-12 zcs-font-semibold zcs-color-tertiary zcs-m-0'><%=step_number%></h6>
              <i class='zcs-stepper-icon zcs-stepper-passed zcs-font-18 zcs-font-bold zcs-color-white zc-li-outline ui-1-check-small'></i>
              <i class='zcs-stepper-icon zcs-stepper-failed zcs-font-18 zcs-color-white zc-li-outline ui-1-circle-remove'></i>
              <span class='zcs-stepper-level zcs-rounded-half'></span>
            </div>
            <span class='zcs-stepper-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=milestone_names.get(i)%></span>
          </li>
          <% } %>
        </ul>
      </div>
    </section>

    <div class='control-grid'>
      <div class='zcs-flex zcs-direction-column zcs-gap-20'>
        <section class='zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border'>
          <div class='section-title zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-row-wrap'>
            <div><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Detailed event timeline</h2><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'><%=visible_events.count(ID)%> visible updates</p></div>
            <a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-13' href='#Report:<%=tracking_report%>?Shipment=<%=shipment_id%>'><i class='zc-li-outline arrows-2-time'></i><span>Open tracking report</span></a>
          </div>
          <% if(visible_events.count(ID) > 0) { %>
          <div class='zcs-timeline-wrapper'><ul class='zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0'>
            <% for each event in visible_events { event_message = ifnull(event.Event_Description,"Shipment status updated."); if(is_customer && event.Event_Status == "Exception") { event_message = "A delivery update needs attention. Our team is working on it."; } event_hub = "Network update"; if(event.Hub != null) { event_hub = event.Hub.Hub_Name; } %>
            <li class='zcs-tl-li zcs-row zcs-gap-0 zcs-relative'>
              <div class='zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute'><span class='zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative'></span></div>
              <span class='zcs-col-2 zcs-tl-time zcs-font-13 zcs-color-tertiary zcs-text-right'><%=if(event.Event_Time != null,event.Event_Time.toString("dd-MMM-yyyy HH:mm"),"Time pending")%></span>
              <div class='zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border'>
                <div class='zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8'><h3 class='zcs-font-16 zcs-font-medium zcs-color-primary zcs-m-0'><%=event.Event_Status%></h3><span class='zcs-badge zcs-badge-blue zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><%=event_hub%></span></div>
                <p class='zcs-font-14 zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0'><%=event_message%></p>
                <% if(event.Manifest != null || event.Bag != null) { %><p class='zcs-font-12 zcs-color-tertiary zcs-mt-8 zcs-mx-0 zcs-mb-0'><%=if(event.Manifest != null,"Manifest " + event.Manifest.Manifest_Number,"")%><%=if(event.Manifest != null && event.Bag != null," | ","")%><%=if(event.Bag != null,"Bag " + event.Bag.Bag_Number,"")%></p><% } %>
              </div>
            </li>
            <% } %>
          </ul></div>
          <% } else { %>
          <div class='zcs-nodata-wrapper timeline-empty zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><i class='zc-li-outline arrows-2-time zcs-font-30 zcs-color-theme'></i><h3 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-mb-0'>No tracking updates available yet</h3></div></div>
          <% } %>
        </section>
      </div>

      <aside class='zcs-flex zcs-direction-column zcs-gap-20'>
        <section class='zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border'>
          <h2 class='section-title zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Delivery summary</h2>
          <div class='zcs-labelvalue-wrapper'><ul class='zcs-row zcs-p-0 zcs-m-0'>
            <li class='zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12 zcs-px-12 zcs-py-10 zcs-box-border'><label class='zcs-font-13 zcs-color-tertiary'>Expected delivery</label><div class='zcs-flex zcs-gap-8'><i class='zc-li-outline ui-2-time zcs-color-primary'></i><strong class='zcs-font-14 zcs-color-primary'><%=expected_text%></strong></div></li>
            <li class='zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12 zcs-px-12 zcs-py-10 zcs-box-border'><label class='zcs-font-13 zcs-color-tertiary'>Amount and payment</label><div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><span class='amount zcs-font-16 zcs-font-semibold zcs-color-primary'>INR <%=ifnull(shipment.Total_Payable,0).round(2)%></span><span class='zcs-badge <%=payment_badge%> zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><%=shipment.Payment_Status%></span></div></li>
            <li class='zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12 zcs-px-12 zcs-py-10 zcs-box-border'><label class='zcs-font-13 zcs-color-tertiary'>Package</label><div class='zcs-flex zcs-gap-8'><i class='zc-li-outline box-3d-50 zcs-color-primary'></i><span class='zcs-font-14 zcs-color-primary'><%=shipment.Package_Count%> package(s), <%=ifnull(shipment.Billable_Weight_Kg,0)%> kg billable</span></div></li>
          </ul></div>
        </section>

        <section class='zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border'>
          <h2 class='section-title zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Hub and custody context</h2>
          <div class='route-band'><div class='route-node'><span class='zcs-font-12 zcs-color-tertiary'>Origin</span><p class='zcs-font-14 zcs-font-medium zcs-color-primary zcs-m-0'><%=origin_name%></p></div><div class='route-line'></div><div class='route-node'><span class='zcs-font-12 zcs-color-tertiary'>Destination</span><p class='zcs-font-14 zcs-font-medium zcs-color-primary zcs-m-0'><%=destination_name%></p></div></div>
          <div class='context-grid'>
            <div class='zcs-card zcs-flex zcs-direction-column zcs-gap-6 zcs-p-16 zcs-box-border'><i class='zc-li-outline location-pin zcs-font-20 zcs-color-theme'></i><span class='zcs-font-12 zcs-color-tertiary'>Current hub</span><strong class='zcs-font-14 zcs-color-primary'><%=current_hub_name%></strong></div>
            <div class='zcs-card zcs-flex zcs-direction-column zcs-gap-6 zcs-p-16 zcs-box-border'><i class='zc-li-outline transport-delivery-fast zcs-font-20 zcs-color-theme'></i><span class='zcs-font-12 zcs-color-tertiary'>Manifest</span><strong class='zcs-font-14 zcs-color-primary'><%=manifest_number%></strong><small class='zcs-font-12 zcs-color-tertiary'><%=manifest_status%></small></div>
            <div class='zcs-card zcs-flex zcs-direction-column zcs-gap-6 zcs-p-16 zcs-box-border'><i class='zc-li-outline box-3d-50 zcs-font-20 zcs-color-theme'></i><span class='zcs-font-12 zcs-color-tertiary'>Bag</span><strong class='zcs-font-14 zcs-color-primary'><%=bag_number%></strong><small class='zcs-font-12 zcs-color-tertiary'><%=bag_status%></small></div>
          </div>
        </section>

        <% if(status == "Out For Delivery (OFD)") { %>
        <section class='zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border'>
          <div><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Out for delivery</h2><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Latest available field update</p></div>
          <% if(latest_latitude != null && latest_longitude != null) { %>
          <div class='map-ready map-grid zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-lg zcs-p-20 zcs-box-border' data-latitude='<%=latest_latitude%>' data-longitude='<%=latest_longitude%>'>
            <i class='zc-li-solid location-pin zcs-font-30 zcs-color-theme'></i><strong class='zcs-font-14 zcs-color-primary'><%=latest_latitude%>, <%=latest_longitude%></strong><span class='zcs-font-12 zcs-color-tertiary'><%=if(latest_location_at != null,"Updated " + latest_location_at.toString("dd-MMM-yyyy HH:mm"),"Latest recorded position")%></span>
            <a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md zcs-font-13' href='<%=map_url%>' target='_blank'><i class='zc-li-outline business-globe'></i><span>Open map</span></a>
          </div>
          <% } else { %><div class='zcs-toast zcs-outline-toast zcs-theme-toast zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm'><i class='zc-li-outline location-pin'></i><p class='zcs-font-14 zcs-m-0'>A live position has not been received. Shipment milestones remain available.</p></div><% } %>
          <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><span class='zcs-font-14 zcs-color-tertiary'>Stops remaining</span><strong class='zcs-font-20 zcs-color-primary'><%=if(stops_remaining != null,stops_remaining,"Not available")%></strong></div>
          <p class='integration-note zcs-font-12 zcs-color-tertiary zcs-m-0'>This panel is native map-widget-ready. Continuous background tracking remains an integration point and is not inferred when a fresh location is unavailable.</p>
        </section>
        <% } %>

        <% if(delivered_reached) { %>
        <section class='epod-card zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border'>
          <div class='zcs-flex zcs-align-items-center zcs-gap-10'><i class='zc-li-outline ui-1-check-circle-08 zcs-font-24 zcs-color-theme'></i><div><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Delivered</h2><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'><%=if(delivered_at != null,delivered_at.toString("dd-MMM-yyyy HH:mm"),"Delivery timestamp pending")%></p></div></div>
          <div class='zcs-labelvalue-wrapper'><ul class='zcs-row zcs-p-0 zcs-m-0'><li class='zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12 zcs-py-10'><label class='zcs-font-13 zcs-color-tertiary'>Received by</label><div class='zcs-flex zcs-gap-8'><i class='zc-li-outline users-single-05 zcs-color-primary'></i><strong class='zcs-font-14 zcs-color-primary'><%=delivered_recipient%></strong></div></li><li class='zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12 zcs-py-10'><label class='zcs-font-13 zcs-color-tertiary'>Proof type</label><div class='zcs-flex zcs-gap-8'><i class='zc-li-outline files-3-pdf zcs-color-primary'></i><span class='zcs-font-14 zcs-color-primary'><%=proof_type%></span></div></li></ul></div>
          <% if(epod_url != "") { %><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14' href='<%=epod_url%>' target='_blank'><i class='zcs-button-icon zc-li-outline files-3-pdf'></i><span>Download ePOD</span></a><% } else { %><div class='zcs-toast zcs-outline-toast zcs-theme-toast zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm'><i class='zc-li-outline ui-2-time'></i><p class='zcs-font-14 zcs-m-0'>The ePOD file is being finalized. Delivery confirmation remains recorded.</p></div><% } %>
        </section>
        <% } %>
      </aside>
    </div>
  </div>
</div>
<%
}
else
{
%>
<style>
:root{--zcs-page-bg-color:#F3F3F4;--zcs-white-color:#fff}.zcs-page{min-height:100%;padding:24px;box-sizing:border-box;background:var(--zcs-page-bg-color);font-family:Arial,sans-serif}.zcs-card{max-width:680px;margin:60px auto;padding:32px;text-align:center;background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;color:var(--zcs_primary_text_color)}.zcs-card i{font-size:32px;color:var(--zcs_brand_color)}
</style>
<div class='zcs-page'><div class='zcs-card'><i class='zc-li-outline ui-1-lock'></i><h2>Shipment unavailable</h2><p>The shipment could not be shown. Customer access requires the signed-in email to match the shipment owner; internal access follows the assigned Creator profile and record permissions.</p></div></div>
<%
}
%>