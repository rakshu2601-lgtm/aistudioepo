<%
profileName = thisapp.permissions.loginUserProfile();
isFieldAgent = profileName == "Field_Agent";
isSupportAdmin = profileName == "Logistics_Administrator" || profileName == "Administrator";
isAllowed = isFieldAgent || isSupportAdmin;
agentRows = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
agentFound = agentRows.count(ID) > 0;
if(isAllowed && agentFound)
{
    agent = agentRows;
    agentId = agent.ID;
    effectiveHubId = agent.Home_Hub;
    isDeputed = false;
    deputationActive = agent.Deputed_Hub != null && (agent.Deputation_Start_Date == null || agent.Deputation_Start_Date <= zoho.currentdate) && (agent.Deputation_End_Date == null || agent.Deputation_End_Date >= zoho.currentdate);
    if(deputationActive)
    {
        effectiveHubId = agent.Deputed_Hub;
        isDeputed = true;
    }
    hubName = "Hub not assigned";
    if(effectiveHubId != null)
    {
        effectiveHub = Hubs[ID == effectiveHubId];
        if(effectiveHub.count(ID) > 0)
        {
            hubName = ifnull(effectiveHub.Hub_Name,"Hub");
        }
    }

    pickupRuns = Pickup_Run_Sheets[Assigned_Agent == agentId && Run_Date == zoho.currentdate && Status != "Draft" && Status != "Cancelled"];
    deliveryRuns = Delivery_Run_Sheets[Assigned_Agent == agentId && Run_Date == zoho.currentdate && DRS_Status != "Draft" && DRS_Status != "Cancelled"];
    pickupTasks = Pickup_Run_Sheet_Items[Pickup_Run_Sheet.Assigned_Agent == agentId && Pickup_Run_Sheet.Run_Date == zoho.currentdate && Pickup_Run_Sheet.Status != "Draft" && Pickup_Run_Sheet.Status != "Cancelled"] sort by Stop_Sequence asc;
    deliveryTasks = Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Assigned_Agent == agentId && Delivery_Run_Sheet.Run_Date == zoho.currentdate && Delivery_Run_Sheet.DRS_Status != "Draft" && Delivery_Run_Sheet.DRS_Status != "Cancelled"] sort by Stop_Sequence asc;

    pickupTotal = pickupTasks.count(ID);
    deliveryTotal = deliveryTasks.count(ID);
    pickupCompleted = Pickup_Run_Sheet_Items[Pickup_Run_Sheet.Assigned_Agent == agentId && Pickup_Run_Sheet.Run_Date == zoho.currentdate && Stop_Status == "Picked Up"].count(ID);
    deliveryCompleted = Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Assigned_Agent == agentId && Delivery_Run_Sheet.Run_Date == zoho.currentdate && Delivery_Status == "Delivered"].count(ID);
    pickupRemaining = Pickup_Run_Sheet_Items[Pickup_Run_Sheet.Assigned_Agent == agentId && Pickup_Run_Sheet.Run_Date == zoho.currentdate && (Stop_Status == "Assigned" || Stop_Status == "Arrived")].count(ID);
    deliveryRemaining = Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Assigned_Agent == agentId && Delivery_Run_Sheet.Run_Date == zoho.currentdate && (Delivery_Status == "Assigned" || Delivery_Status == "Out For Delivery")].count(ID);
    pickupFailed = Pickup_Run_Sheet_Items[Pickup_Run_Sheet.Assigned_Agent == agentId && Pickup_Run_Sheet.Run_Date == zoho.currentdate && Stop_Status == "Failed"].count(ID);
    deliveryFailed = Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Assigned_Agent == agentId && Delivery_Run_Sheet.Run_Date == zoho.currentdate && Delivery_Status == "Failed"].count(ID);
    pickupFailedNotes = Pickup_Run_Sheet_Items[Pickup_Run_Sheet.Assigned_Agent == agentId && Pickup_Run_Sheet.Run_Date == zoho.currentdate && Stop_Status == "Failed" && (Failure_Reason == null || Failure_Reason == "")].count(ID);
    deliveryFailedNotes = Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Assigned_Agent == agentId && Delivery_Run_Sheet.Run_Date == zoho.currentdate && Delivery_Status == "Failed" && (NDR_Notes == null || NDR_Notes == "")].count(ID);
    totalCompleted = pickupCompleted + deliveryCompleted;
    totalRemaining = pickupRemaining + deliveryRemaining;
    totalTasks = pickupTotal + deliveryTotal;
    completionPercent = 0;
    if(totalTasks > 0)
    {
        completionPercent = ((totalCompleted * 100.0) / totalTasks).round(0);
        if(completionPercent > 100)
        {
            completionPercent = 100;
        }
    }

    vehicleNames = List();
    plannedLoad = 0.0;
    for each pickupRun in pickupRuns
    {
        plannedLoad = plannedLoad + ifnull(pickupRun.Total_Planned_Weight_Kg,0);
        if(pickupRun.Vehicle != null && !vehicleNames.contains(pickupRun.Vehicle.Vehicle_Number))
        {
            vehicleNames.add(pickupRun.Vehicle.Vehicle_Number);
        }
    }
    for each deliveryRun in deliveryRuns
    {
        if(deliveryRun.Vehicle != null && !vehicleNames.contains(deliveryRun.Vehicle.Vehicle_Number))
        {
            vehicleNames.add(deliveryRun.Vehicle.Vehicle_Number);
        }
    }
    for each deliveryLoadItem in deliveryTasks
    {
        plannedLoad = plannedLoad + ifnull(deliveryLoadItem.Shipment.Billable_Weight_Kg,0);
    }
    vehicleLabel = "Not assigned";
    if(vehicleNames.size() > 0)
    {
        vehicleLabel = vehicleNames.toString(", ");
    }
    maxLoad = ifnull(agent.Maximum_Daily_Load_Kg,0);
    loadPercent = 0;
    if(maxLoad > 0)
    {
        loadPercent = ((plannedLoad / maxLoad) * 100).round(0);
        if(loadPercent > 100)
        {
            loadPercent = 100;
        }
    }

    codCollected = ifnull(Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Assigned_Agent == agentId && Delivery_Run_Sheet.Run_Date == zoho.currentdate && Delivery_Status == "Delivered"].sum(COD_Collected),0);
    remittances = COD_Remittances[Agent == agentId && Remittance_Date == zoho.currentdate];
    remittanceStatus = "Not generated";
    remittanceClass = "zcs-badge-grey";
    remittanceExpected = 0;
    remittanceSubmitted = 0;
    hasShortfall = false;
    allConfirmed = true;
    for each remittance in remittances
    {
        remittanceExpected = remittanceExpected + ifnull(remittance.Expected_Amount,0);
        remittanceSubmitted = remittanceSubmitted + ifnull(remittance.Submitted_Amount,0);
        if(remittance.Remittance_Status == "Shortfall")
        {
            hasShortfall = true;
        }
        if(remittance.Remittance_Status != "Confirmed")
        {
            allConfirmed = false;
        }
    }
    if(remittances.count(ID) > 0)
    {
        if(hasShortfall)
        {
            remittanceStatus = "Shortfall";
            remittanceClass = "zcs-badge-red";
        }
        else if(allConfirmed)
        {
            remittanceStatus = "Confirmed";
            remittanceClass = "zcs-badge-green";
        }
        else
        {
            remittanceStatus = "Pending";
            remittanceClass = "zcs-badge-yellow";
        }
    }
%>
<style>
/* zcs-global utility sheet, included once for Agent_Dashboard. */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#f3f3f4;--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_teritiary_text_color);font-size:16px;line-height:1.5}.zcs-flex,.zcs-row{display:flex}.zcs-row{flex-wrap:wrap}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-row-wrap{flex-wrap:wrap}.zcs-no-shrink{flex-shrink:0}.zcs-col-common{flex:1 1 0}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-half{border-radius:50%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-color-green{color:#179e6c}.zcs-color-red{color:#fe455d}.zcs-color-yellow{color:#b8770d}.zcs-text-center{text-align:center}.zcs-text-left{text-align:left}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-list-none{list-style:none}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}
/* ZCS component CSS: card-fleets-driver-info-3-btns, card-fleet-trip-summary-card, card-fleets-performance-metrics, badge-filled-badge, button-full-size-button, no-data-no-data-text-only, banner-status-banner. */
.zcs-button{width:auto;min-width:5rem;min-height:48px}.zcs-fw-button{width:100%}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color);border:1px solid var(--zcs_brand_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-icon{width:18px;max-height:18px}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-theme{background:var(--zcs_brand_color);color:#fff}.zcs-badge-green{background:#179e6c;color:#fff}.zcs-badge-red{background:#fe455d;color:#fff}.zcs-badge-grey{background:#242424;color:#fff}.zcs-badge-yellow{background:#faae13;color:#fff}.zcs-badge-blue{background:#2a6ffc;color:#fff}.zcs-badge-orange{background:#f4660c;color:#fff}.zcs-success-toast{background:#edf7ed;color:#1d4620}.zcs-info-toast{background:#e4f6fd;color:#024361}.zcs-warning-toast{background:#fef4e5;color:#663c01}.zcs-error-toast{background:#feedec;color:#5f2120}
.agent-dashboard{background:var(--zcs-page-bg-color);min-height:100%;padding:16px;font-family:Arial,sans-serif}.agent-shell{max-width:1180px;margin:0 auto}.agent-header{background:linear-gradient(120deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));color:var(--zcs_brand_foreground_color);border-radius:16px}.agent-header .zcs-color-primary,.agent-header .zcs-color-secondary,.agent-header .zcs-color-tertiary{color:inherit}.agent-avatar{width:52px;height:52px;background:var(--zcs_brand_foreground_color);color:var(--zcs_brand_color);font-size:24px}.summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.summary-card{min-height:112px}.summary-icon{width:38px;height:38px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:18px}.dashboard-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(280px,1fr);gap:16px}.task-card{border-left:4px solid var(--zcs_brand_color)}.task-card.delivery{border-left-color:#179e6c}.task-top{border-bottom:1px solid var(--zcs_tertiary_border_color);padding-bottom:10px}.sequence{width:38px;height:38px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-weight:700}.task-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}.task-address{min-height:42px}.section-title{border-bottom:1px solid var(--zcs_tertiary_border_color);padding-bottom:10px}.metric-list li:not(:last-child){border-bottom:1px solid var(--zcs_tertiary_border_color);padding-bottom:12px}.sticky-side{position:sticky;top:12px}.security-card{border-left:4px solid #fe455d}.empty-state{min-height:120px}.location-line{word-break:break-word}.compact-progress{min-width:150px}.touch-report{min-height:52px}.failed-link{text-decoration:underline}.meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 14px}.payment-cod{color:#663c01}
@media(max-width:900px){.summary-grid{grid-template-columns:repeat(2,1fr)}.dashboard-grid{grid-template-columns:1fr}.sticky-side{position:static}}
@media(max-width:576px){.agent-dashboard{padding:10px}.agent-header{padding:16px}.agent-header-main{align-items:flex-start}.summary-grid{grid-template-columns:repeat(2,1fr);gap:8px}.summary-card{padding:12px;min-height:104px}.task-card{padding:14px}.task-actions{grid-template-columns:1fr}.zcs-button{min-height:50px}.meta-grid{grid-template-columns:1fr}.hide-phone{display:none}.agent-name{font-size:1.25rem}.compact-progress{width:100%}}
</style>
<div class='agent-dashboard zcs-box-border'>
  <div class='agent-shell zcs-flex zcs-direction-column zcs-gap-16'>
    <div class='agent-header zcs-flex zcs-direction-column zcs-gap-16 zcs-p-24 zcs-box-border'>
      <div class='agent-header-main zcs-flex zcs-align-items-center zcs-justify-space-between zcs-row-wrap zcs-gap-16'>
        <div class='zcs-flex zcs-align-items-center zcs-gap-12 zcs-col-common'>
          <div class='agent-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-no-shrink'><i class='zc-li-outline users-single-05'></i></div>
          <div class='zcs-col-common zcs-ellipsis'>
            <p class='zcs-font-13 zcs-m-0'>Field day view · <%=zoho.currentdate%></p>
            <h2 class='agent-name zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-m-0'><%=agent.Employee_Name%></h2>
            <p class='zcs-font-13 zcs-m-0'><%=if(isDeputed,"Deputed hub","Home hub")%>: <%=hubName%> · Role: <%=ifnull(agent.Agent_Role,"Not Applicable")%></p>
          </div>
        </div>
        <div class='compact-progress zcs-flex zcs-direction-column zcs-gap-6'>
          <div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=completionPercent%>%;'></div></div>
          <p class='zcs-font-13 zcs-m-0'><strong><%=completionPercent%>%</strong> of assigned stops completed</p>
        </div>
      </div>
      <div class='zcs-flex zcs-align-items-center zcs-gap-8 zcs-row-wrap zcs-font-13'>
        <span><i class='zc-li-outline transport-car-simple zcs-mt-4'></i> <%=ifnull(agent.Vehicle_Type,"Vehicle not specified")%>: <%=vehicleLabel%></span>
        <span class='hide-phone'>·</span>
        <span><i class='zc-li-outline location-pin-copy'></i> Last location: <%=ifnull(agent.Last_Location_At,"Not updated")%></span>
      </div>
    </div>

    <% if(pickupFailedNotes + deliveryFailedNotes > 0) { %>
    <div class='zcs-warning-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14'>
      <i class='zcs-no-shrink zc-li-outline ui-3-alert'></i>
      <div><strong>Notes required:</strong> <%=pickupFailedNotes + deliveryFailedNotes%> failed task(s) still need failure notes. Open the affected task before ending the shift.</div>
    </div>
    <% } %>

    <div class='summary-grid'>
      <div class='summary-card zcs-card zcs-flex zcs-direction-column zcs-gap-8 zcs-p-16 zcs-box-border'>
        <div class='summary-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline ui-1-check-circle-08'></i></div>
        <div><span class='zcs-font-24 zcs-font-bold zcs-color-primary'><%=totalCompleted%></span><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Completed stops</p></div>
      </div>
      <div class='summary-card zcs-card zcs-flex zcs-direction-column zcs-gap-8 zcs-p-16 zcs-box-border'>
        <div class='summary-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline ui-2-time'></i></div>
        <div><span class='zcs-font-24 zcs-font-bold zcs-color-primary'><%=totalRemaining%></span><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Remaining stops</p></div>
      </div>
      <div class='summary-card zcs-card zcs-flex zcs-direction-column zcs-gap-8 zcs-p-16 zcs-box-border'>
        <div class='summary-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline finance-money-coins'></i></div>
        <div><span class='zcs-font-22 zcs-font-bold zcs-color-primary'>₹<%=codCollected%></span><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>COD collected</p></div>
      </div>
      <div class='summary-card zcs-card zcs-flex zcs-direction-column zcs-gap-8 zcs-p-16 zcs-box-border'>
        <div class='summary-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline transport-delivery-fast'></i></div>
        <div><span class='zcs-font-24 zcs-font-bold zcs-color-primary'><%=pickupTotal%> / <%=deliveryTotal%></span><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Pickup / delivery</p></div>
      </div>
    </div>

    <div class='dashboard-grid'>
      <main class='zcs-flex zcs-direction-column zcs-gap-20'>
        <section class='zcs-flex zcs-direction-column zcs-gap-12'>
          <div class='section-title zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
            <div><h3 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Today's pickup stops</h3><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'><%=pickupCompleted%> completed · <%=pickupRemaining%> remaining · <%=pickupFailed%> failed</p></div>
            <a class='zcs-font-13 zcs-color-theme' href='#Report:My_Pickup_Tasks'>View report</a>
          </div>
          <% if(pickupTotal == 0) { %>
          <div class='zcs-card zcs-nodata-wrapper empty-state zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><i class='zc-li-outline transport-delivery-fast zcs-font-24 zcs-color-theme'></i><h5 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-8 zcs-mb-0'>No pickup stops assigned today</h5></div></div>
          <% } else { for each pickupTask in pickupTasks {
              pickupStatus = ifnull(pickupTask.Stop_Status,"Assigned");
              pickupBadge = "zcs-badge-blue";
              if(pickupStatus == "Picked Up") { pickupBadge = "zcs-badge-green"; }
              else if(pickupStatus == "Failed") { pickupBadge = "zcs-badge-red"; }
              else if(pickupStatus == "Cancelled") { pickupBadge = "zcs-badge-grey"; }
              else if(pickupStatus == "Arrived") { pickupBadge = "zcs-badge-orange"; }
              pickupAddress = ifnull(pickupTask.Shipment.Pickup_Address.address_line_1,"");
              pickupCity = ifnull(pickupTask.Shipment.Pickup_Address.district_city,"");
              pickupLat = pickupTask.Shipment.Pickup_Address.latitude;
              pickupLon = pickupTask.Shipment.Pickup_Address.longitude;
              pickupDestination = encodeURL(ifnull(pickupTask.Shipment.Pickup_Pincode,""));
              if(pickupLat != null && pickupLon != null) { pickupDestination = pickupLat + "," + pickupLon; }
              pickupMapUrl = "https://www.google.com/maps/dir/?api=1&amp;destination=" + pickupDestination;
              pickupOpenUrl = "#Report:My_Pickup_Tasks?ID=" + pickupTask.ID + "&amp;zc_LoadIn=dialog&amp;zc_Header=true";
              pickupActionLabel = if(pickupStatus == "Arrived","Complete pickup","Open pickup");
          %>
          <article class='task-card zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border'>
            <div class='task-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-10'>
              <div class='zcs-flex zcs-align-items-center zcs-gap-10 zcs-col-common zcs-ellipsis'><div class='sequence zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-no-shrink'><%=pickupTask.Stop_Sequence%></div><div class='zcs-col-common zcs-ellipsis'><strong class='zcs-font-15 zcs-color-primary'>AWB <%=pickupTask.Shipment.AWB_Number%></strong><p class='zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-ellipsis'><%=pickupTask.Shipment.Sender_Name%></p></div></div>
              <div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 <%=pickupBadge%>'><span class='zcs-font-12'><%=pickupStatus%></span></div>
            </div>
            <div class='task-address zcs-flex zcs-gap-8'><i class='zc-li-outline location-pin-copy zcs-color-theme zcs-mt-4'></i><div><p class='zcs-font-14 zcs-color-primary zcs-m-0'><%=pickupAddress%><%=if(pickupAddress != "" && pickupCity != "",", ","")%><%=pickupCity%></p><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Pincode <%=pickupTask.Shipment.Pickup_Pincode%> · <%=ifnull(pickupTask.Shipment.Package_Count,1)%> package(s)</p></div></div>
            <div class='zcs-flex zcs-align-items-center zcs-gap-8 zcs-row-wrap'><div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-badge-theme'><span class='zcs-font-12'>OTP / signature proof</span></div><% if(pickupStatus == "Failed" && (pickupTask.Failure_Reason == null || pickupTask.Failure_Reason == "")) { %><span class='zcs-font-12 zcs-color-red'><i class='zc-li-outline ui-3-alert'></i> Failure note required</span><% } %></div>
            <div class='task-actions'><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-10 zcs-rounded-md zcs-box-border zcs-font-14' href='<%=pickupMapUrl%>' target='_blank'><i class='zcs-button-icon zc-li-outline location-pin-copy'></i><span>Navigate</span></a><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-10 zcs-rounded-md zcs-box-border zcs-font-14' href='<%=pickupOpenUrl%>'><i class='zcs-button-icon zc-li-outline ui-1-check-circle-08'></i><span><%=pickupActionLabel%></span></a></div>
          </article>
          <% } } %>
        </section>

        <section class='zcs-flex zcs-direction-column zcs-gap-12'>
          <div class='section-title zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
            <div><h3 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Today's delivery stops</h3><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'><%=deliveryCompleted%> delivered · <%=deliveryRemaining%> remaining · <%=deliveryFailed%> failed</p></div>
            <a class='zcs-font-13 zcs-color-theme' href='#Report:My_Delivery_Tasks'>View report</a>
          </div>
          <% if(deliveryTotal == 0) { %>
          <div class='zcs-card zcs-nodata-wrapper empty-state zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><i class='zc-li-outline location-pin-copy zcs-font-24 zcs-color-theme'></i><h5 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-8 zcs-mb-0'>No delivery stops assigned today</h5></div></div>
          <% } else { for each deliveryTask in deliveryTasks {
              deliveryStatus = ifnull(deliveryTask.Delivery_Status,"Assigned");
              deliveryBadge = "zcs-badge-blue";
              if(deliveryStatus == "Delivered") { deliveryBadge = "zcs-badge-green"; }
              else if(deliveryStatus == "Failed" || deliveryStatus == "RTO") { deliveryBadge = "zcs-badge-red"; }
              deliveryAddress = ifnull(deliveryTask.Shipment.Delivery_Address.address_line_1,"");
              deliveryCity = ifnull(deliveryTask.Shipment.Delivery_Address.district_city,"");
              deliveryLat = deliveryTask.Shipment.Delivery_Address.latitude;
              deliveryLon = deliveryTask.Shipment.Delivery_Address.longitude;
              deliveryDestination = encodeURL(ifnull(deliveryTask.Shipment.Delivery_Pincode,""));
              if(deliveryLat != null && deliveryLon != null) { deliveryDestination = deliveryLat + "," + deliveryLon; }
              deliveryMapUrl = "https://www.google.com/maps/dir/?api=1&amp;destination=" + deliveryDestination;
              deliveryOpenUrl = "#Report:My_Delivery_Tasks?ID=" + deliveryTask.ID + "&amp;zc_LoadIn=dialog&amp;zc_Header=true";
              paymentLabel = ifnull(deliveryTask.Shipment.Payment_Type,"Not specified");
              paymentBadge = "zcs-badge-theme";
              if(paymentLabel == "COD") { paymentLabel = "COD ₹" + ifnull(deliveryTask.Shipment.COD_Amount,0); paymentBadge = "zcs-badge-yellow"; }
              else if(paymentLabel == "Prepaid") { paymentBadge = "zcs-badge-green"; }
              proofLabel = ifnull(deliveryTask.Proof_Type,"Proof required");
          %>
          <article class='task-card delivery zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border'>
            <div class='task-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-10'>
              <div class='zcs-flex zcs-align-items-center zcs-gap-10 zcs-col-common zcs-ellipsis'><div class='sequence zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-no-shrink'><%=deliveryTask.Stop_Sequence%></div><div class='zcs-col-common zcs-ellipsis'><strong class='zcs-font-15 zcs-color-primary'>AWB <%=deliveryTask.Shipment.AWB_Number%></strong><p class='zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-ellipsis'><%=deliveryTask.Shipment.Recipient_Name%></p></div></div>
              <div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 <%=deliveryBadge%>'><span class='zcs-font-12'><%=deliveryStatus%></span></div>
            </div>
            <div class='task-address zcs-flex zcs-gap-8'><i class='zc-li-outline location-pin-copy zcs-color-green zcs-mt-4'></i><div><p class='zcs-font-14 zcs-color-primary zcs-m-0'><%=deliveryAddress%><%=if(deliveryAddress != "" && deliveryCity != "",", ","")%><%=deliveryCity%></p><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Pincode <%=deliveryTask.Shipment.Delivery_Pincode%> · Attempt <%=ifnull(deliveryTask.Attempt_Number,1)%></p></div></div>
            <div class='zcs-flex zcs-align-items-center zcs-gap-8 zcs-row-wrap'><div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 <%=paymentBadge%>'><span class='zcs-font-12'><%=paymentLabel%></span></div><div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-badge-theme'><span class='zcs-font-12'><%=proofLabel%></span></div><% if(deliveryStatus == "Failed" && (deliveryTask.NDR_Notes == null || deliveryTask.NDR_Notes == "")) { %><span class='zcs-font-12 zcs-color-red'><i class='zc-li-outline ui-3-alert'></i> NDR note required</span><% } %></div>
            <div class='task-actions'><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-10 zcs-rounded-md zcs-box-border zcs-font-14' href='<%=deliveryMapUrl%>' target='_blank'><i class='zcs-button-icon zc-li-outline location-pin-copy'></i><span>Navigate</span></a><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-10 zcs-rounded-md zcs-box-border zcs-font-14' href='<%=deliveryOpenUrl%>'><i class='zcs-button-icon zc-li-outline ui-1-check-circle-08'></i><span>Deliver / update</span></a></div>
          </article>
          <% } } %>
        </section>
      </main>

      <aside class='zcs-flex zcs-direction-column zcs-gap-16'>
        <div class='sticky-side zcs-flex zcs-direction-column zcs-gap-16'>
          <div class='zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border'>
            <h3 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Vehicle and load</h3>
            <ul class='metric-list zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0 zcs-list-none'>
              <li class='zcs-flex zcs-justify-space-between zcs-gap-8'><span class='zcs-font-13 zcs-color-tertiary'>Vehicle</span><strong class='zcs-font-13 zcs-color-primary zcs-text-left'><%=vehicleLabel%></strong></li>
              <li class='zcs-flex zcs-justify-space-between zcs-gap-8'><span class='zcs-font-13 zcs-color-tertiary'>Vehicle type</span><strong class='zcs-font-13 zcs-color-primary'><%=ifnull(agent.Vehicle_Type,"Not set")%></strong></li>
              <li class='zcs-flex zcs-justify-space-between zcs-gap-8'><span class='zcs-font-13 zcs-color-tertiary'>Planned load</span><strong class='zcs-font-13 zcs-color-primary'><%=plannedLoad.round(2)%> kg</strong></li>
              <li class='zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6'><p class='zcs-flex zcs-justify-space-between zcs-font-13 zcs-m-0'><span class='zcs-color-tertiary'>Daily load limit</span><span class='zcs-color-primary'><%=if(maxLoad > 0,maxLoad + " kg","Not set")%></span></p><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=loadPercent%>%;'></div></div></li>
            </ul>
          </div>

          <div class='zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border'>
            <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><h3 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>COD remittance</h3><div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 <%=remittanceClass%>'><span class='zcs-font-12'><%=remittanceStatus%></span></div></div>
            <div class='meta-grid'><div><p class='zcs-font-12 zcs-color-tertiary zcs-m-0'>Collected</p><strong class='zcs-font-20 zcs-color-primary'>₹<%=codCollected%></strong></div><div><p class='zcs-font-12 zcs-color-tertiary zcs-m-0'>Submitted</p><strong class='zcs-font-20 zcs-color-primary'>₹<%=remittanceSubmitted%></strong></div></div>
            <p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Expected remittance: ₹<%=remittanceExpected%>. Cash confirmation is handled by the authorized hub or finance user.</p>
          </div>

          <div class='zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border'>
            <h3 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Location status</h3>
            <div class='zcs-flex zcs-gap-10'><i class='zc-li-outline location-pin-copy zcs-color-theme zcs-mt-4'></i><div class='location-line'><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Last update</p><strong class='zcs-font-14 zcs-color-primary'><%=ifnull(agent.Last_Location_At,"Not updated")%></strong><p class='zcs-font-12 zcs-color-tertiary zcs-m-0'><%=if(agent.Current_Latitude != null && agent.Current_Longitude != null,agent.Current_Latitude + ", " + agent.Current_Longitude,"Coordinates unavailable")%></p></div></div>
            <% if(agent.Current_Latitude != null && agent.Current_Longitude != null) { currentMapUrl = "https://www.google.com/maps/search/?api=1&amp;query=" + agent.Current_Latitude + "," + agent.Current_Longitude; %><a class='zcs-button zcs-primary-outline-button zcs-fw-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-10 zcs-rounded-md zcs-box-border zcs-font-14' href='<%=currentMapUrl%>' target='_blank'><i class='zc-li-outline location-pin-copy'></i><span>View last location</span></a><% } %>
          </div>

          <% if(pickupFailed + deliveryFailed > 0) { %>
          <div class='zcs-error-toast zcs-flex zcs-direction-column zcs-gap-10 zcs-p-16 zcs-rounded-sm zcs-box-border'>
            <div class='zcs-flex zcs-gap-8'><i class='zc-li-outline ui-3-alert'></i><strong class='zcs-font-14'>Failed tasks: <%=pickupFailed + deliveryFailed%></strong></div>
            <p class='zcs-font-13 zcs-m-0'>Every failed pickup needs a failure reason. Every failed delivery needs an NDR reason and notes.</p>
            <div class='zcs-flex zcs-gap-12 zcs-row-wrap'><% if(pickupFailed > 0) { %><a class='failed-link zcs-font-13' href='#Report:My_Pickup_Tasks'>Pickup failures</a><% } %><% if(deliveryFailed > 0) { %><a class='failed-link zcs-font-13' href='#Report:My_Delivery_Tasks'>Delivery failures</a><% } %></div>
          </div>
          <% } %>
        </div>
      </aside>
    </div>
  </div>
</div>
<% } else { %>
<style>
:root{--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-white-color:#fff}.zcs-flex{display:flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-gap-8{gap:.5rem}.zcs-p-24{padding:1.5rem}.zcs-box-border{box-sizing:border-box}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-24{font-size:1.5rem}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-red{color:#fe455d}.zcs-m-0{margin:0}.security-wrap{min-height:360px;background:#f3f3f4;padding:16px}.security-card{max-width:560px;border-left:4px solid #fe455d;text-align:center}
</style>
<div class='security-wrap zcs-flex zcs-align-items-center zcs-justify-center zcs-box-border'><div class='security-card zcs-card zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-8 zcs-p-24 zcs-box-border'><i class='zc-li-outline users-single-05 zcs-font-24 zcs-color-red'></i><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'><%=if(!isAllowed,"Access restricted","Agent profile not found")%></h2><p class='zcs-font-14 zcs-color-primary zcs-m-0'><%=if(!isAllowed,"This page is limited to Field Agent and support administrator profiles.","No active Operations Users record matches the current login email. No task data has been loaded.")%></p></div></div>
<% } %>