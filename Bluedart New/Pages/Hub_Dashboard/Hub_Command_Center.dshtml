<%
profileName = thisapp.permissions.loginUserProfile();
networkRole = profileName == "Logistics_Administrator" || profileName == "Administrator" || profileName == "Operations_Manager";
hubRole = profileName == "Hub_Supervisor" || profileName == "Hub_Operator";
allowed = networkRole || hubRole;
userRec = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
hubId = 0;
hubName = "Select a hub";
hubCode = "";
if(hubRole && userRec.count(ID) > 0)
{
    deputationActive = userRec.Deputed_Hub != null && (userRec.Deputation_Start_Date == null || userRec.Deputation_Start_Date <= zoho.currentdate) && (userRec.Deputation_End_Date == null || userRec.Deputation_End_Date >= zoho.currentdate);
    if(deputationActive)
    {
        hubId = userRec.Deputed_Hub;
    }
    else if(userRec.Home_Hub != null)
    {
        hubId = userRec.Home_Hub;
    }
}
else if(networkRole && input.Hub_ID != null && input.Hub_ID > 0)
{
    selectedHub = Hubs[ID == input.Hub_ID && Active == true];
    if(selectedHub.count(ID) > 0)
    {
        hubId = selectedHub.ID;
    }
}
if(hubId > 0)
{
    hubRec = Hubs[ID == hubId && Active == true];
    if(hubRec.count(ID) > 0)
    {
        hubName = ifnull(hubRec.Hub_Name,"Hub");
        hubCode = ifnull(hubRec.Hub_ID,"");
    }
    else
    {
        hubId = 0;
    }
}
%>
<style>
/* ZCS global utilities used by this page; included once. */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;--zcs-page-bg-color:#f3f3f4;--zcs-thead-color:#f9fafe}
.zcs-flex,.zcs-row{display:flex}.zcs-row{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-row-wrap{flex-wrap:wrap}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-half{border-radius:50%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-color-red{color:#fe455d}.zcs-color-green{color:#179e6c}.zcs-color-yellow{color:#b8770d}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-overflow-auto{overflow:auto}.zcs-list-none{list-style:none}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.zcs-button{width:auto;min-height:36px;text-decoration:none}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color);border:1px solid var(--zcs_brand_color)}.zcs-primary-outline-button{background:#fff;color:var(--zcs_brand_color);border:1px solid var(--zcs_brand_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}
.hub-dashboard{background:var(--zcs-page-bg-color);padding:16px;min-height:100%;font-family:Arial,sans-serif}.hub-header{background:linear-gradient(115deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));color:var(--zcs_brand_foreground_color);border-radius:14px}.hub-header .zcs-color-primary,.hub-header .zcs-color-secondary{color:inherit}.hub-selector{max-width:100%;overflow:auto}.hub-selector a{white-space:nowrap;text-decoration:none}.hub-selector .active-hub{background:var(--zcs_brand_foreground_color);color:var(--zcs_brand_color)}.dashboard-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:16px}.span-12{grid-column:span 12}.span-8{grid-column:span 8}.span-7{grid-column:span 7}.span-6{grid-column:span 6}.span-5{grid-column:span 5}.span-4{grid-column:span 4}.kpi-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}.kpi-card{min-height:118px}.kpi-icon{width:38px;height:38px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:18px}.section-title{border-bottom:1px solid var(--zcs_tertiary_border_color)}.zcs-badge{width:auto;border:1px solid}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#179e6c}.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#fe455d}.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#a06309}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#2a6ffc}.zcs-badge-theme{background:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color)}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}.work-chart{height:215px}.work-bars{height:155px;border-bottom:1px solid var(--zcs_tertiary_border_color)}.work-bar-group{flex:1;min-width:54px;height:100%}.work-bar{width:28px;min-height:3px;background:var(--zcs_brand_color);border-radius:6px 6px 0 0}.work-bar.delivery{background:#179e6c}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;min-width:620px}.zcs-table-wrapper th{background:var(--zcs-thead-color);top:0}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tr:hover td{background:#f9fafe}.zcs-tl-li{list-style:none;padding-left:26px}.zcs-tl-dot{width:12px;height:12px;background:var(--zcs_brand_color);left:0;top:5px}.zcs-tl-li:not(:last-child):before{content:"";position:absolute;left:5px;top:16px;width:1px;height:calc(100% + 10px);background:#e1e1e1}.quick-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.zcs-quick-action-item{list-style:none}.zcs-quick-action-link{text-decoration:none}.zcs-quick-action-item:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover a{color:var(--zcs_brand_color)}.queue-scroll{max-height:330px}.empty-state{min-height:120px}.cod-amount{font-size:2rem}.security-banner{border-left:4px solid #fe455d;background:#fde3e6}.agent-load-item:not(:last-child){border-bottom:1px solid var(--zcs_tertiary_border_color)}
@media(max-width:1100px){.kpi-grid{grid-template-columns:repeat(3,1fr)}.span-8,.span-7,.span-6,.span-5,.span-4{grid-column:span 12}}
@media(max-width:700px){.hub-dashboard{padding:10px}.kpi-grid{grid-template-columns:repeat(2,1fr)}.quick-grid{grid-template-columns:repeat(2,1fr)}.hub-header{align-items:flex-start}.hub-header>.zcs-flex{width:100%}}
</style>
<div class='hub-dashboard zcs-box-border'>
<% if(!allowed) { %>
    <div class='zcs-card security-banner zcs-p-24 zcs-box-border'>
        <h5 class='zcs-font-18 zcs-font-semibold zcs-color-red zcs-m-0'>Access restricted</h5>
        <p class='zcs-font-14 zcs-color-primary zcs-mb-0'>This command center is limited to hub operations and network operations profiles.</p>
    </div>
<% } else if(hubRole && (userRec.count(ID) == 0 || hubId == 0)) { %>
    <div class='zcs-card security-banner zcs-p-24 zcs-box-border'>
        <h5 class='zcs-font-18 zcs-font-semibold zcs-color-red zcs-m-0'>Hub mapping required</h5>
        <p class='zcs-font-14 zcs-color-primary zcs-mb-0'>No active home or deputed hub is mapped to your Operations Users record. No operational data has been loaded.</p>
    </div>
<% } else if(networkRole && hubId == 0) { %>
    <div class='hub-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-row-wrap zcs-gap-16 zcs-p-24 zcs-box-border'>
        <div>
            <h3 class='zcs-font-24 zcs-font-semibold zcs-m-0'>Hub Command Center</h3>
            <p class='zcs-font-14 zcs-mt-4 zcs-mb-0'>Select an active hub to load operational data. No network-wide totals are shown on this page.</p>
        </div>
    </div>
    <div class='zcs-card zcs-p-20 zcs-mt-8 zcs-box-border'>
        <h5 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Active hubs</h5>
        <div class='hub-selector zcs-flex zcs-row-wrap zcs-gap-8 zcs-mt-8'>
        <% for each hubOption in Hubs[Active == true] sort by Hub_Name asc { %>
            <a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14' href='#Page:Hub_Dashboard?Hub_ID=<%=hubOption.ID%>'>
                <i class='zc-li-outline location-pin'></i><span><%=hubOption.Hub_Name%></span>
            </a>
        <% } %>
        </div>
    </div>
<% } else {
    todayPickupItems = Pickup_Run_Sheet_Items[Pickup_Run_Sheet.Hub == hubId && Pickup_Run_Sheet.Run_Date == zoho.currentdate && Stop_Status == "Picked Up"];
    inboundAWBs = Shipment_Requests[Current_Hub == hubId && (Shipment_Status == "Inbound at Branch Station" || Shipment_Status == "Arrived at Destination Hub")];
    openBags = Logistics_Bags[Origin_Hub == hubId && Bag_Status == "Open"];
    outboundManifests = Manifests[Origin_Hub == hubId && (Manifest_Status == "Closed" || Manifest_Status == "In Transit")];
    atDeliveryHub = Shipment_Requests[Destination_Hub == hubId && Shipment_Status == "At Delivery Hub"];
    ofdShipments = Shipment_Requests[Destination_Hub == hubId && Shipment_Status == "Out For Delivery (OFD)"];
    ndrShipments = Shipment_Requests[Destination_Hub == hubId && Shipment_Status == "Delivery Failed - NDR"];
    openExceptions = Shipment_Exceptions[Reporting_Hub == hubId && Exception_Status != "Resolved"];
    activeHubShipments = Shipment_Requests[Current_Hub == hubId && Shipment_Status != "Delivered" && Shipment_Status != "Cancelled"];
    dailyCapacity = ifnull(hubRec.Daily_Capacity,0);
    capacityPct = 0;
    if(dailyCapacity > 0)
    {
        capacityPct = (activeHubShipments.count(ID) * 100.0 / dailyCapacity).round(1);
        if(capacityPct > 100) { capacityPct = 100; }
    }
    pickupAssigned = Pickup_Run_Sheet_Items[Pickup_Run_Sheet.Hub == hubId && Pickup_Run_Sheet.Run_Date == zoho.currentdate && Stop_Status == "Assigned"].count(ID);
    pickupArrived = Pickup_Run_Sheet_Items[Pickup_Run_Sheet.Hub == hubId && Pickup_Run_Sheet.Run_Date == zoho.currentdate && Stop_Status == "Arrived"].count(ID);
    pickupDone = todayPickupItems.count(ID);
    pickupFailed = Pickup_Run_Sheet_Items[Pickup_Run_Sheet.Hub == hubId && Pickup_Run_Sheet.Run_Date == zoho.currentdate && Stop_Status == "Failed"].count(ID);
    deliveryAssigned = Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Hub == hubId && Delivery_Run_Sheet.Run_Date == zoho.currentdate && Delivery_Status == "Assigned"].count(ID);
    deliveryOFD = Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Hub == hubId && Delivery_Run_Sheet.Run_Date == zoho.currentdate && Delivery_Status == "Out For Delivery"].count(ID);
    deliveryDone = Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Hub == hubId && Delivery_Run_Sheet.Run_Date == zoho.currentdate && Delivery_Status == "Delivered"].count(ID);
    deliveryFailed = Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Hub == hubId && Delivery_Run_Sheet.Run_Date == zoho.currentdate && Delivery_Status == "Failed"].count(ID);
    workloadMax = pickupAssigned;
    for each workValue in {pickupArrived,pickupDone,pickupFailed,deliveryAssigned,deliveryOFD,deliveryDone,deliveryFailed}
    {
        if(workValue > workloadMax) { workloadMax = workValue; }
    }
    if(workloadMax < 1) { workloadMax = 1; }
    codPending = COD_Remittances[Hub == hubId && (Remittance_Status == "Pending" || Remittance_Status == "Shortfall")];
    codAmount = ifnull(codPending.sum(Expected_Amount),0);
    hubAgents = Operations_Users[Active == true && Application_Role == "Field Agent" && ((Deputed_Hub == hubId && (Deputation_Start_Date == null || Deputation_Start_Date <= zoho.currentdate) && (Deputation_End_Date == null || Deputation_End_Date >= zoho.currentdate)) || (Home_Hub == hubId && (Deputed_Hub == null || (Deputation_Start_Date != null && Deputation_Start_Date > zoho.currentdate) || (Deputation_End_Date != null && Deputation_End_Date < zoho.currentdate))))];
%>
    <div class='hub-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-row-wrap zcs-gap-16 zcs-p-24 zcs-box-border'>
        <div>
            <div class='zcs-flex zcs-align-items-center zcs-gap-10'>
                <i class='zc-li-outline location-pin zcs-font-22'></i>
                <h3 class='zcs-font-24 zcs-font-semibold zcs-m-0'><%=hubName%></h3>
                <span class='zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><%=hubCode%></span>
            </div>
            <p class='zcs-font-14 zcs-mt-4 zcs-mb-0'>Operational command center for <%=zoho.currentdate.toString("dd-MMM-yyyy")%>. Data and actions are scoped to this hub.</p>
        </div>
        <% if(networkRole) { %>
        <div class='hub-selector zcs-flex zcs-gap-8'>
            <% for each hubOption in Hubs[Active == true] sort by Hub_Name asc { %>
            <a class='zcs-button zcs-flex zcs-align-items-center zcs-px-12 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-13 <%=if(hubOption.ID == hubId,"active-hub","zcs-primary-outline-button")%>' href='#Page:Hub_Dashboard?Hub_ID=<%=hubOption.ID%>'><%=hubOption.Hub_Name%></a>
            <% } %>
        </div>
        <% } %>
    </div>

    <div class='kpi-grid zcs-mt-8'>
    <%
    kpiLabels = {"Today's pickups","Inbound AWBs","Open bags","Outbound manifests","At delivery hub","Out for delivery","NDR","Open exceptions","Capacity utilization"};
    kpiValues = {todayPickupItems.count(ID),inboundAWBs.count(ID),openBags.count(ID),outboundManifests.count(ID),atDeliveryHub.count(ID),ofdShipments.count(ID),ndrShipments.count(ID),openExceptions.count(ID),capacityPct + "%"};
    kpiIcons = {"transportation-box-delivery","arrows-1-log-in","files-folder","transportation-truck","location-pin","transportation-bike","ui-3-alert","ui-2-notification","business-chart-bar-32"};
    for each index kpiIndex in kpiLabels
    {
    %>
        <div class='zcs-card kpi-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border'>
            <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'>
                <span class='zcs-font-13 zcs-color-tertiary'><%=kpiLabels.get(kpiIndex)%></span>
                <span class='kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline <%=kpiIcons.get(kpiIndex)%>'></i></span>
            </div>
            <strong class='zcs-font-30 zcs-color-primary'><%=kpiValues.get(kpiIndex)%></strong>
        </div>
    <% } %>
    </div>

    <div class='dashboard-grid zcs-mt-8'>
        <section class='zcs-card span-8 zcs-p-20 zcs-box-border'>
            <div class='section-title zcs-flex zcs-align-items-center zcs-justify-space-between zcs-py-12'>
                <h5 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Pickup and delivery workload</h5>
                <div class='zcs-flex zcs-gap-12 zcs-font-12'><span class='zcs-color-theme'>Pickup</span><span class='zcs-color-green'>Delivery</span></div>
            </div>
            <div class='work-chart zcs-flex zcs-direction-column zcs-justify-center zcs-mt-8'>
                <div class='work-bars zcs-flex zcs-align-items-center zcs-gap-12'>
                <%
                workLabels = {"Assigned","In progress","Completed","Failed"};
                pickupValues = {pickupAssigned,pickupArrived,pickupDone,pickupFailed};
                deliveryValues = {deliveryAssigned,deliveryOFD,deliveryDone,deliveryFailed};
                for each index workIndex in workLabels
                {
                    pickupHeight = (pickupValues.get(workIndex) * 100.0 / workloadMax).round(0);
                    deliveryHeight = (deliveryValues.get(workIndex) * 100.0 / workloadMax).round(0);
                %>
                    <div class='work-bar-group zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between'>
                        <div class='zcs-flex zcs-align-items-center zcs-gap-6 zcs-h-full'>
                            <div class='work-bar' title='Pickup <%=pickupValues.get(workIndex)%>' style='height:<%=pickupHeight%>%'></div>
                            <div class='work-bar delivery' title='Delivery <%=deliveryValues.get(workIndex)%>' style='height:<%=deliveryHeight%>%'></div>
                        </div>
                        <span class='zcs-font-12 zcs-color-tertiary zcs-text-center'><%=workLabels.get(workIndex)%></span>
                    </div>
                <% } %>
                </div>
            </div>
        </section>

        <aside class='zcs-card span-4 zcs-p-20 zcs-box-border'>
            <div class='section-title zcs-py-12'><h5 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Quick actions</h5></div>
            <ul class='quick-grid zcs-p-0 zcs-mt-8'>
                <li class='zcs-quick-action-item zcs-card zcs-p-12 zcs-box-border'><a class='zcs-quick-action-link zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary zcs-text-center' href='#Form:Pickup_Run_Sheets?Hub=<%=hubId%>&zc_LoadIn=dialog'><i class='zc-li-outline ui-1-calendar-date zcs-font-22'></i><span>Generate PRS</span></a></li>
                <li class='zcs-quick-action-item zcs-card zcs-p-12 zcs-box-border'><a class='zcs-quick-action-link zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary zcs-text-center' href='#Form:Logistics_Bags?Origin_Hub=<%=hubId%>&zc_LoadIn=dialog'><i class='zc-li-outline shopping-bag zcs-font-22'></i><span>Create Bag</span></a></li>
                <li class='zcs-quick-action-item zcs-card zcs-p-12 zcs-box-border'><a class='zcs-quick-action-link zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary zcs-text-center' href='#Form:Manifests?Origin_Hub=<%=hubId%>&zc_LoadIn=dialog'><i class='zc-li-outline files-2-doc zcs-font-22'></i><span>Create Manifest</span></a></li>
                <li class='zcs-quick-action-item zcs-card zcs-p-12 zcs-box-border'><a class='zcs-quick-action-link zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary zcs-text-center' href='#Report:Last_Mile_Dispatcher?Hub=<%=hubId%>'><i class='zc-li-outline location-map zcs-font-22'></i><span>Auto-Cluster DRS</span></a></li>
                <li class='zcs-quick-action-item zcs-card zcs-p-12 zcs-box-border'><a class='zcs-quick-action-link zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary zcs-text-center' href='#Report:All_Manifests?Destination_Hub=<%=hubId%>'><i class='zc-li-outline arrows-1-log-in zcs-font-22'></i><span>Receive Manifest</span></a></li>
                <li class='zcs-quick-action-item zcs-card zcs-p-12 zcs-box-border'><a class='zcs-quick-action-link zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary zcs-text-center' href='#Report:COD_Pending_Remittance?Hub=<%=hubId%>'><i class='zc-li-outline business-coins zcs-font-22'></i><span>Confirm COD</span></a></li>
            </ul>
        </aside>

        <section class='zcs-card span-7 zcs-p-20 zcs-box-border'>
            <div class='section-title zcs-flex zcs-align-items-center zcs-justify-space-between zcs-py-12'><h5 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Manifest arrival and departure timeline</h5><a class='zcs-font-13 zcs-color-theme' href='#Report:In_Transit_Manifests?Origin_Hub=<%=hubId%>'>View manifests</a></div>
            <div class='zcs-timeline-wrapper zcs-mt-8'>
                <ul class='zcs-flex zcs-direction-column zcs-gap-20 zcs-p-0 zcs-m-0'>
                <% timelineCount = 0; for each manifestRow in Manifests[(Origin_Hub == hubId || Destination_Hub == hubId) && Manifest_Status != "Cancelled" && Manifest_Status != "Draft"] sort by Expected_Arrival_Time asc { if(timelineCount < 8) { timelineCount = timelineCount + 1; movement = if(manifestRow.Origin_Hub == hubId,"Departure","Arrival"); eventTime = if(movement == "Departure",manifestRow.Departure_Time,manifestRow.Expected_Arrival_Time); %>
                    <li class='zcs-tl-li zcs-relative'>
                        <span class='zcs-tl-dot zcs-rounded-half zcs-absolute'></span>
                        <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'>
                            <strong class='zcs-font-15 zcs-color-primary'><%=movement%> · <%=manifestRow.Manifest_Number%></strong>
                            <span class='zcs-badge zcs-badge-blue zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><%=manifestRow.Manifest_Status%></span>
                        </div>
                        <p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'><%=ifnull(eventTime,"Time pending")%> · <%=manifestRow.Origin_Hub%> to <%=manifestRow.Destination_Hub%></p>
                    </li>
                <% } } if(timelineCount == 0) { %><li class='zcs-list-none zcs-text-center zcs-color-tertiary zcs-p-20'>No active manifest movements for this hub.</li><% } %>
                </ul>
            </div>
        </section>

        <section class='zcs-card span-5 zcs-p-20 zcs-box-border'>
            <div class='section-title zcs-flex zcs-align-items-center zcs-justify-space-between zcs-py-12'><h5 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Agent availability and load</h5><span class='zcs-badge zcs-badge-theme zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><%=hubAgents.count(ID)%> active</span></div>
            <div class='zcs-flex zcs-direction-column'>
            <% agentCount = 0; for each agent in Operations_Users[Active == true && Application_Role == "Field Agent" && ((Deputed_Hub == hubId && (Deputation_Start_Date == null || Deputation_Start_Date <= zoho.currentdate) && (Deputation_End_Date == null || Deputation_End_Date >= zoho.currentdate)) || (Home_Hub == hubId && (Deputed_Hub == null || (Deputation_Start_Date != null && Deputation_Start_Date > zoho.currentdate) || (Deputation_End_Date != null && Deputation_End_Date < zoho.currentdate))))] sort by Employee_ID asc { if(agentCount < 8) { agentCount = agentCount + 1; activePickupRuns = Pickup_Run_Sheets[Hub == hubId && Run_Date == zoho.currentdate && Assigned_Agent == agent.ID && (Status == "Released" || Status == "In Progress")]; activeDeliveryRuns = Delivery_Run_Sheets[Hub == hubId && Run_Date == zoho.currentdate && Assigned_Agent == agent.ID && (DRS_Status == "Released" || DRS_Status == "In Progress")]; plannedWeight = ifnull(Pickup_Run_Sheets[Hub == hubId && Run_Date == zoho.currentdate && Assigned_Agent == agent.ID].sum(Total_Planned_Weight_Kg),0); maxLoad = ifnull(agent.Maximum_Daily_Load_Kg,0); loadPct = 0; if(maxLoad > 0) { loadPct = (plannedWeight * 100.0 / maxLoad).round(0); if(loadPct > 100) { loadPct = 100; } } isAvailable = activePickupRuns.count(ID) + activeDeliveryRuns.count(ID) == 0; %>
                <div class='agent-load-item zcs-py-12'>
                    <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'>
                        <div><strong class='zcs-font-14 zcs-color-primary'><%=agent.Employee_ID%></strong><div class='zcs-font-12 zcs-color-tertiary'><%=agent.Agent_Role%> · <%=ifnull(agent.Assigned_Beat,"Unassigned beat")%></div></div>
                        <span class='zcs-badge <%=if(isAvailable,"zcs-badge-green","zcs-badge-blue")%> zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><%=if(isAvailable,"Available","Assigned")%></span>
                    </div>
                    <div class='zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 zcs-mt-8'><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=loadPct%>%'></div></div><p class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-font-12 zcs-color-tertiary zcs-m-0'><span>Pickup load</span><span><%=plannedWeight%> / <%=maxLoad%> kg</span></p></div>
                </div>
            <% } } if(agentCount == 0) { %><div class='empty-state zcs-flex zcs-align-items-center zcs-justify-center zcs-color-tertiary zcs-font-14'>No active field agents mapped to this hub.</div><% } %>
            </div>
        </section>

        <section class='zcs-card span-4 zcs-p-20 zcs-box-border'>
            <div class='section-title zcs-py-12'><h5 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Pincode and zone distribution</h5></div>
            <div class='zcs-table-wrapper zcs-rounded-sm zcs-mt-8'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13'>Pincode</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13'>Zone</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13'>Service</th></tr></thead><tbody>
            <% mappingCount = 0; for each mapping in Hub_Pincode_Mapping[Primary_Collection_Center == hubId && Active == true] sort by Service_Zone asc { if(mappingCount < 10) { mappingCount = mappingCount + 1; %><tr><td class='zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary'><%=mapping.Pincode%></td><td class='zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary'><%=mapping.Service_Zone%></td><td class='zcs-px-16 zcs-py-8 zcs-font-13'><span class='zcs-badge <%=if(mapping.Serviceability == "Serviceable","zcs-badge-green","zcs-badge-yellow")%> zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><%=mapping.Serviceability%></span></td></tr><% } } if(mappingCount == 0) { %><tr><td colspan='3' class='zcs-p-20 zcs-text-center zcs-color-tertiary'>No active pincode mappings.</td></tr><% } %>
            </tbody></table></div>
        </section>

        <section class='zcs-card span-4 zcs-p-20 zcs-box-border'>
            <div class='section-title zcs-py-12'><h5 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>COD pending</h5></div>
            <div class='zcs-flex zcs-direction-column zcs-gap-16 zcs-mt-8'>
                <div class='zcs-flex zcs-align-items-center zcs-justify-space-between'><div><div class='zcs-font-13 zcs-color-tertiary'>Expected remittance</div><strong class='cod-amount zcs-color-primary'>INR <%=codAmount%></strong></div><span class='kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline business-coins'></i></span></div>
                <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-font-14'><span class='zcs-color-tertiary'>Pending / shortfall records</span><strong class='zcs-color-primary'><%=codPending.count(ID)%></strong></div>
                <a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14' href='#Report:COD_Pending_Remittance?Hub=<%=hubId%>'><i class='zc-li-outline ui-1-check-circle-08'></i><span>Open confirmation queue</span></a>
            </div>
        </section>

        <section class='zcs-card span-4 zcs-p-20 zcs-box-border'>
            <div class='section-title zcs-py-12'><h5 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Capacity utilization</h5></div>
            <div class='zcs-flex zcs-direction-column zcs-gap-16 zcs-mt-8'>
                <div class='zcs-flex zcs-align-items-center zcs-justify-space-between'><strong class='cod-amount zcs-color-primary'><%=capacityPct%>%</strong><span class='zcs-badge <%=if(capacityPct >= 90,"zcs-badge-red",if(capacityPct >= 70,"zcs-badge-yellow","zcs-badge-green"))%> zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><%=if(capacityPct >= 90,"Critical",if(capacityPct >= 70,"Watch","Healthy"))%></span></div>
                <div class='zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6'><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=capacityPct%>%'></div></div><p class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-font-12 zcs-color-tertiary zcs-m-0'><span>Active hub AWBs</span><span><%=activeHubShipments.count(ID)%> / <%=dailyCapacity%></span></p></div>
                <p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Utilization is based only on shipments whose current hub is <%=hubName%>.</p>
            </div>
        </section>

        <section class='zcs-card span-6 zcs-p-20 zcs-box-border'>
            <div class='section-title zcs-flex zcs-align-items-center zcs-justify-space-between zcs-py-12'><h5 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Exception queue</h5><a class='zcs-font-13 zcs-color-theme' href='#Report:Shipment_Exception_Queue?Reporting_Hub=<%=hubId%>'>Open queue</a></div>
            <div class='zcs-table-wrapper queue-scroll zcs-rounded-sm zcs-mt-8'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13'>Exception</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13'>Type</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13'>Severity</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13'>Status</th></tr></thead><tbody>
            <% exceptionCount = 0; for each exceptionRow in Shipment_Exceptions[Reporting_Hub == hubId && Exception_Status != "Resolved"] sort by Reported_At desc { if(exceptionCount < 6) { exceptionCount = exceptionCount + 1; severityClass = if(exceptionRow.Severity == "Critical" || exceptionRow.Severity == "High","zcs-badge-red",if(exceptionRow.Severity == "Medium","zcs-badge-yellow","zcs-badge-blue")); %><tr><td class='zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary'><%=exceptionRow.Exception_Number%></td><td class='zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary'><%=exceptionRow.Exception_Type%></td><td class='zcs-px-16 zcs-py-8'><span class='zcs-badge <%=severityClass%> zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><%=exceptionRow.Severity%></span></td><td class='zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary'><%=exceptionRow.Exception_Status%></td></tr><% } } if(exceptionCount == 0) { %><tr><td colspan='4' class='zcs-p-20 zcs-text-center zcs-color-tertiary'>No open exceptions for this hub.</td></tr><% } %>
            </tbody></table></div>
        </section>

        <section class='zcs-card span-6 zcs-p-20 zcs-box-border'>
            <div class='section-title zcs-flex zcs-align-items-center zcs-justify-space-between zcs-py-12'><h5 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>NDR action queue</h5><a class='zcs-font-13 zcs-color-theme' href='#Report:NDR_Instruction_Action_Queue?Shipment.Destination_Hub=<%=hubId%>'>Open queue</a></div>
            <div class='zcs-table-wrapper queue-scroll zcs-rounded-sm zcs-mt-8'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13'>NDR</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13'>AWB</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13'>Reason</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13'>Status</th></tr></thead><tbody>
            <% ndrCount = 0; for each ndrRow in NDR_Instructions[Shipment.Destination_Hub == hubId && NDR_Status != "RTO" && NDR_Status != "Added to Next DRS"] sort by Submitted_At desc { if(ndrCount < 6) { ndrCount = ndrCount + 1; %><tr><td class='zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary'><%=ndrRow.NDR_ID%></td><td class='zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary'><%=ndrRow.Shipment.AWB_Number%></td><td class='zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary'><%=ifnull(ndrRow.Failure_Reason,"Awaiting details")%></td><td class='zcs-px-16 zcs-py-8'><span class='zcs-badge zcs-badge-yellow zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><%=ndrRow.NDR_Status%></span></td></tr><% } } if(ndrCount == 0) { %><tr><td colspan='4' class='zcs-p-20 zcs-text-center zcs-color-tertiary'>No pending NDR instructions for this hub.</td></tr><% } %>
            </tbody></table></div>
        </section>
    </div>
<% } %>
</div>