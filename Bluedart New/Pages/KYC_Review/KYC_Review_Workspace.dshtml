<%
current_profile = thisapp.permissions.loginUserProfile();
customer_rows = Customers[ID == input.Customer_ID];
customer_found = customer_rows.count(ID) > 0;
authorized_profile = current_profile == "KYC_Reviewer" || current_profile == "Logistics_Administrator";
authorized = false;
if(customer_found && authorized_profile)
{
    customer = customer_rows;
    authorized = customer.Customer_Type == "Corporate" || customer.Customer_Type == "Wholesale";
}
if(authorized)
{
    customer_id = customer.ID;
    documents = Customer_KYC_Documents[Customer == customer_id] sort by KYC_Document_ID asc;
    required_count = Customer_KYC_Documents[Customer == customer_id && Required_For_Onboarding == true].count(ID);
    received_count = Customer_KYC_Documents[Customer == customer_id && Required_For_Onboarding == true && Uploaded_File != null].count(ID);
    verified_count = Customer_KYC_Documents[Customer == customer_id && Required_For_Onboarding == true && Review_Status == "Verified"].count(ID);
    queried_count = Customer_KYC_Documents[Customer == customer_id && Review_Status == "Query"].count(ID);
    pending_count = Customer_KYC_Documents[Customer == customer_id && Required_For_Onboarding == true && Review_Status != "Verified"].count(ID);
    progress_percent = 0;
    if(required_count > 0)
    {
        progress_percent = ((verified_count * 100.0) / required_count).round(0);
    }
    approval_ready = required_count > 0 && pending_count == 0;
    rate_card_name = "Not assigned";
    if(customer.Assigned_Rate_Card != null)
    {
        rate_card_name = customer.Assigned_Rate_Card.Rate_Card_Name;
    }
    submitted_text = "Not submitted";
    if(customer.KYC_Submitted_On != null)
    {
        submitted_text = customer.KYC_Submitted_On.toString("dd-MMM-yyyy HH:mm");
    }
    verified_date_text = "Captured on approval";
    if(customer.KYC_Verified_Date != null)
    {
        verified_date_text = customer.KYC_Verified_Date.toString("dd-MMM-yyyy");
    }
    expiry_date_text = "Captured on approval";
    if(customer.KYC_Expiry_Date != null)
    {
        expiry_date_text = customer.KYC_Expiry_Date.toString("dd-MMM-yyyy");
    }
    customer_edit_url = "#Form:Customers?recLinkID=" + customer_id + "&viewLinkName=Verification_Pending&zc_LoadIn=dialog";
    approval_report_url = "#Report:Verification_Pending?ID=" + customer_id;
    document_report_url = "#Report:KYC_Review_Queue?Customer=" + customer_id;
    base_url = "https://creatorapp.zoho.com/" + zoho.adminuser + "/" + zoho.appname + "/";
    document_queue_embed = base_url + "report-embed/KYC_Review_Queue/?zc_Header=false&zc_Footer=false&zc_AddRec=false&zc_EditRec=true&zc_DelRec=false&zc_DuplRec=false&zc_Print=false&zc_Export=false&Customer=" + customer_id;
    customer_queue_embed = base_url + "report-embed/Verification_Pending/?zc_Header=false&zc_Footer=false&zc_AddRec=false&zc_EditRec=true&zc_DelRec=false&zc_DuplRec=false&zc_Print=false&zc_Export=false&ID=" + customer_id;
%>
<style>
/* zcs-global.css: page-scoped utility subset, loaded once for this page. */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-row-wrap{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-col-6{flex:0 0 50%;max-width:50%}.zcs-col-12{flex:0 0 100%;max-width:100%}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-15{padding-left:.9375rem;padding-right:.9375rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mb-0{margin-bottom:0}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-color-white{color:#fff}.zcs-text-center{text-align:center}.zcs-text-left{text-align:left}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-overflow-hidden{overflow:hidden}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}
/* ZCS components: header-heading-with-actions, card-template-default, progress-bar-range-bar-with-texts, badge-filled-outlined-badge, button-button-group, label-value-key-value-parallel, notes-notes-simple, no-data-no-data-text-only. */
.kyc-page{min-height:100%;background:var(--zcs-page-bg-color);font-family:Arial,sans-serif}.kyc-shell{max-width:1540px;margin:0 auto}.zcs-page-header{background:#fff;border-bottom:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.review-layout{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(390px,.85fr);gap:20px}.summary-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.summary-tile{background:#F9FAFE;border:1px solid var(--zcs_tertiary_border_color)}.section-heading{border-bottom:1px solid var(--zcs_tertiary_border_color);padding-bottom:12px}.zcs-labelvalue-wrapper.zcs-labelvalue-with-bg{background:#F9FAFE}.zcs-labelvalue-wrapper ul{list-style:none}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}.zcs-badge{width:auto;border:1px solid}.zcs-badge-green{background:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-red{background:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-grey{background:#e8e8e8;border-color:#626262;color:#242424}.zcs-badge-yellow{background:#FCF4E6;border-color:#FAAE13;color:#9a6700}.zcs-badge-blue{background:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-orange{background:#F8F0EB;border-color:#F4660C;color:#F4660C}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-button:hover{filter:brightness(.96)}.zcs-button-disabled{border:1px solid var(--zcs_tertiary_border_color);background:#f4f4f5;color:var(--zcs_tertiary_text_color);cursor:not-allowed;opacity:.75}.document-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.zcs-template-card{width:100%;min-height:300px;overflow:hidden}.zcs-card-header{border-bottom:1px solid var(--zcs_tertiary_border_color)}.zcs-template-card-badge{top:0;right:0;background:var(--zcs_brand_color);border-bottom-left-radius:32px}.zcs-card-content{padding-bottom:62px}.zcs-card-footer{left:0;bottom:0;background:#F9FAFE;border-top:1px solid var(--zcs_tertiary_border_color)}.metadata{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.metadata-item{min-width:0}.review-note{background:#F9FAFE;border-left:3px solid var(--zcs_brand_color)}.query-note{border-left-color:#F4660C}.workflow-frame{width:100%;height:330px;border:1px solid var(--zcs_tertiary_border_color);border-radius:8px;background:#fff}.decision-frame{height:250px}.sticky-controls{position:sticky;top:12px}.flag-list{list-style:none}.flag-item{border-top:1px solid var(--zcs_tertiary_border_color)}.flag-item:first-child{border-top:0}.zcs-notes-text a:hover{text-decoration:underline}.status-band{border-left:4px solid var(--zcs_brand_color)}
@media(max-width:1120px){.review-layout{grid-template-columns:1fr}.sticky-controls{position:static}.summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.kyc-shell{padding:16px}.zcs-page-header{padding:16px;align-items:flex-start;flex-direction:column}.zcs-page-header>div:last-child{width:100%;flex-wrap:wrap}.zcs-button{width:100%}.document-grid,.summary-grid{grid-template-columns:1fr}.metadata{grid-template-columns:1fr}.zcs-col-sm-12{flex:0 0 100%;max-width:100%}.workflow-frame{height:420px}}
</style>
<div class='kyc-page zcs-wh-full'>
  <div class='kyc-shell zcs-flex zcs-direction-column zcs-gap-20 zcs-px-24 zcs-py-24 zcs-box-border'>
    <div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-24 zcs-box-border'>
      <div class='zcs-flex zcs-direction-column zcs-gap-6'>
        <p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>KYC review workspace</p>
        <div class='zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-10'><h1 class='zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'><%=ifnull(customer.Company_Name,"Business customer")%></h1><span class='zcs-badge zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13'><%=customer.Customer_Type%></span><span class='zcs-badge zcs-badge-yellow zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13'><%=customer.Onboarding_Status%></span></div>
        <p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Customer <%=customer.Customer_ID%> | Submitted <%=submitted_text%></p>
      </div>
      <div class='zcs-flex zcs-align-items-center zcs-gap-12'>
        <a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14' href='<%=customer_edit_url%>'><i class='zcs-button-icon zc-li-outline ui-1-edit-72'></i><span>Set approval terms</span></a>
        <a class='zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14' href='<%=document_report_url%>'><i class='zcs-button-icon zc-li-outline files-3-search'></i><span>Open review queue</span></a>
      </div>
    </div>

    <section class='status-band zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border'>
      <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-row-wrap'><div><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Required-document progress</h2><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'><%=received_count%> received, <%=verified_count%> verified, <%=required_count%> required</p></div><strong class='zcs-font-20 zcs-color-theme'><%=progress_percent%>%</strong></div>
      <div class='zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6'><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=progress_percent%>%;'></div></div><p class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-m-0'><span class='zcs-color-primary'>Verified versus required</span><span class='zcs-color-primary'><%=verified_count%> / <%=required_count%></span></p></div>
    </section>

    <div class='summary-grid'>
      <section class='summary-tile zcs-rounded-xl zcs-p-16 zcs-box-border'><i class='zc-li-outline users-single-05 zcs-font-22 zcs-color-theme'></i><p class='zcs-font-12 zcs-color-tertiary zcs-mt-8 zcs-mx-0 zcs-mb-0'>Customer</p><strong class='zcs-font-15 zcs-color-primary'><%=customer.Full_Name%></strong><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'><%=customer.Email_ID%></p></section>
      <section class='summary-tile zcs-rounded-xl zcs-p-16 zcs-box-border'><i class='zc-li-outline business-building zcs-font-22 zcs-color-theme'></i><p class='zcs-font-12 zcs-color-tertiary zcs-mt-8 zcs-mx-0 zcs-mb-0'>Company identifiers</p><strong class='zcs-font-15 zcs-color-primary'>GSTIN <%=ifnull(customer.GSTIN,"Not supplied")%></strong><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>PAN <%=ifnull(customer.PAN_Number,"Not supplied")%></p></section>
      <section class='summary-tile zcs-rounded-xl zcs-p-16 zcs-box-border'><i class='zc-li-outline business-coins zcs-font-22 zcs-color-theme'></i><p class='zcs-font-12 zcs-color-tertiary zcs-mt-8 zcs-mx-0 zcs-mb-0'>Credit request</p><strong class='zcs-font-15 zcs-color-primary'>INR <%=ifnull(customer.Requested_Credit_Limit,0).round(2)%></strong><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Outstanding INR <%=ifnull(customer.Outstanding_Balance,0).round(2)%></p></section>
    </div>

    <div class='review-layout'>
      <main class='zcs-flex zcs-direction-column zcs-gap-20'>
        <section class='zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border'>
          <div class='section-heading zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-row-wrap'><div><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Document checklist</h2><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Each file opens through an authenticated Creator record; no public file URL is exposed.</p></div><span class='zcs-badge <%=if(queried_count > 0,"zcs-badge-orange","zcs-badge-green")%> zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13'><%=queried_count%> flagged</span></div>
          <% if(documents.count(ID) > 0) { %>
          <div class='document-grid'>
            <% for each doc in documents {
                doc_status = ifnull(doc.Review_Status,"Pending Upload");
                status_class = "zcs-badge-yellow";
                status_icon = "ui-2-time";
                if(doc_status == "Verified") { status_class = "zcs-badge-green"; status_icon = "ui-1-check-circle-08"; }
                else if(doc_status == "Query") { status_class = "zcs-badge-orange"; status_icon = "travel-info"; }
                else if(doc_status == "Pending Verification") { status_class = "zcs-badge-blue"; status_icon = "files-3-search"; }
                else if(doc_status == "Pending Upload") { status_class = "zcs-badge-grey"; status_icon = "arrows-2-file-upload-86"; }
                required_text = if(doc.Required_For_Onboarding,"Required","Optional");
                uploaded_text = "Not uploaded";
                if(doc.Uploaded_On != null) { uploaded_text = doc.Uploaded_On.toString("dd-MMM-yyyy HH:mm"); }
                expiry_text = "Not required / not supplied";
                if(doc.Expiry_Date != null) { expiry_text = doc.Expiry_Date.toString("dd-MMM-yyyy"); }
                doc_edit_url = "#Form:Customer_KYC_Documents?recLinkID=" + doc.ID + "&viewLinkName=KYC_Review_Queue&zc_LoadIn=dialog";
                doc_queue_url = "#Report:KYC_Review_Queue?KYC_Document_ID=" + doc.KYC_Document_ID;
            %>
            <article class='zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative'>
              <div class='zcs-card-header zcs-p-16 zcs-box-border zcs-relative'><h3 class='zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'><%=doc.Document_Type.Document_Name%></h3><span class='zcs-template-card-badge zcs-px-16 zcs-py-4 zcs-box-border zcs-font-11 zcs-color-white zcs-absolute'><%=required_text%></span></div>
              <div class='zcs-card-content zcs-col-common zcs-p-16 zcs-box-border'>
                <div class='zcs-flex zcs-direction-column zcs-gap-12'>
                  <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><span class='zcs-badge <%=status_class%> zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13'><i class='zc-li-outline <%=status_icon%>'></i><%=doc_status%></span><span class='zcs-font-12 zcs-color-tertiary'>Version <%=doc.File_Version%></span></div>
                  <div class='metadata'>
                    <div class='metadata-item'><span class='zcs-font-12 zcs-color-tertiary'>Document number</span><p class='zcs-font-14 zcs-font-medium zcs-color-primary zcs-m-0'><%=ifnull(doc.Document_Number,"Not supplied")%></p></div>
                    <div class='metadata-item'><span class='zcs-font-12 zcs-color-tertiary'>Expiry</span><p class='zcs-font-14 zcs-font-medium zcs-color-primary zcs-m-0'><%=expiry_text%></p></div>
                    <div class='metadata-item'><span class='zcs-font-12 zcs-color-tertiary'>Uploaded</span><p class='zcs-font-14 zcs-font-medium zcs-color-primary zcs-m-0'><%=uploaded_text%></p></div>
                    <div class='metadata-item'><span class='zcs-font-12 zcs-color-tertiary'>Reviewed by</span><p class='zcs-font-14 zcs-font-medium zcs-color-primary zcs-m-0'><%=ifnull(doc.Reviewed_By_Email,"Not reviewed")%></p></div>
                  </div>
                  <div class='review-note <%=if(doc_status == "Query","query-note","")%> zcs-p-12 zcs-rounded-md zcs-box-border'><span class='zcs-font-12 zcs-color-tertiary'>Reviewer remarks</span><p class='zcs-font-14 zcs-color-primary zcs-m-0'><%=ifnull(doc.Review_Remarks,"No reviewer remarks")%></p></div>
                </div>
              </div>
              <div class='zcs-card-footer zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-10 zcs-p-10 zcs-box-border zcs-absolute'>
                <a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-13' href='<%=doc_edit_url%>'><i class='zc-li-outline arrows-2-file-download-87'></i><span>Secure preview / download</span></a>
                <% if(doc_status == "Pending Verification") { %><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-13' href='<%=doc_queue_url%>'><i class='zc-li-outline files-3-search'></i><span>Run Verify / Query</span></a><% } %>
              </div>
            </article>
            <% } %>
          </div>
          <% } else { %><div class='zcs-nodata-wrapper zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><i class='zc-li-outline files-3-search zcs-font-24 zcs-color-theme'></i><h3 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-mb-0'>No KYC checklist records exist</h3></div></div><% } %>
        </section>

        <section class='zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border'>
          <div class='section-heading'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Pending document workflows</h2><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Enter reviewer remarks through Secure preview / download before selecting Query. Verify and Query execute the permitted KYC Review Queue report workflows.</p></div>
          <iframe class='workflow-frame' src='<%=document_queue_embed%>' title='Filtered KYC document workflow queue'></iframe>
        </section>
      </main>

      <aside class='sticky-controls zcs-flex zcs-direction-column zcs-gap-20'>
        <section class='zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border'>
          <div class='section-heading zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><div><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Approval and activation</h2><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Final values are captured on the customer before the report workflow activates the account.</p></div><i class='zc-li-outline ui-1-check-circle-08 zcs-font-24 zcs-color-theme'></i></div>
          <div class='zcs-labelvalue-wrapper zcs-labelvalue-with-bg zcs-rounded-xl zcs-px-15 zcs-py-10 zcs-box-border'><ul class='zcs-row zcs-p-0 zcs-m-0'>
            <li class='zcs-row zcs-gap-8 zcs-col-12 zcs-px-15 zcs-py-10 zcs-box-border'><label class='zcs-col-6 zcs-font-14 zcs-color-tertiary'>Assigned rate card</label><span class='zcs-col-6 zcs-font-14 zcs-font-medium zcs-color-primary'><%=rate_card_name%></span></li>
            <li class='zcs-row zcs-gap-8 zcs-col-12 zcs-px-15 zcs-py-10 zcs-box-border'><label class='zcs-col-6 zcs-font-14 zcs-color-tertiary'>Approved credit limit</label><span class='zcs-col-6 zcs-font-14 zcs-font-medium zcs-color-primary'>INR <%=ifnull(customer.Approved_Credit_Limit,0).round(2)%></span></li>
            <li class='zcs-row zcs-gap-8 zcs-col-12 zcs-px-15 zcs-py-10 zcs-box-border'><label class='zcs-col-6 zcs-font-14 zcs-color-tertiary'>Payment terms</label><span class='zcs-col-6 zcs-font-14 zcs-font-medium zcs-color-primary'><%=customer.Payment_Terms%></span></li>
            <li class='zcs-row zcs-gap-8 zcs-col-12 zcs-px-15 zcs-py-10 zcs-box-border'><label class='zcs-col-6 zcs-font-14 zcs-color-tertiary'>KYC verified date</label><span class='zcs-col-6 zcs-font-14 zcs-font-medium zcs-color-primary'><%=verified_date_text%></span></li>
            <li class='zcs-row zcs-gap-8 zcs-col-12 zcs-px-15 zcs-py-10 zcs-box-border'><label class='zcs-col-6 zcs-font-14 zcs-color-tertiary'>KYC expiry</label><span class='zcs-col-6 zcs-font-14 zcs-font-medium zcs-color-primary'><%=expiry_date_text%></span></li>
          </ul></div>
          <a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14' href='<%=customer_edit_url%>'><i class='zcs-button-icon zc-li-outline ui-1-edit-72'></i><span>Set approval terms</span></a>
          <% if(approval_ready) { %><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14' href='<%=approval_report_url%>'><i class='zcs-button-icon zc-li-outline ui-1-check-circle-08'></i><span>Open enabled Approve action</span></a><% } else { %><span class='zcs-button zcs-button-disabled zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14'><i class='zcs-button-icon zc-li-outline ui-1-lock'></i><span>Approve disabled: <%=pending_count%> required item(s) not verified</span></span><% } %>
          <div class='zcs-notes-wrapper'><p class='zcs-notes-text zcs-m-0 zcs-font-13 zcs-color-primary'><span class='zcs-font-medium zcs-color-tertiary'>Control:</span> The Approve report workflow re-checks every required item, stamps verification and expiry, writes Audit_Log and Communication_Log, and only then activates the customer.</p></div>
        </section>

        <section class='zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border'>
          <div class='section-heading'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Flagged items for customer query</h2><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>The customer-level Query action is available only after one or more documents have Query status with remarks.</p></div>
          <% if(queried_count > 0) { %><ul class='flag-list zcs-flex zcs-direction-column zcs-p-0 zcs-m-0'>
            <% for each flagged in Customer_KYC_Documents[Customer == customer_id && Review_Status == "Query"] sort by Reviewed_On desc { %><li class='flag-item zcs-flex zcs-direction-column zcs-gap-4 zcs-py-10'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><strong class='zcs-font-14 zcs-color-primary'><%=flagged.Document_Type.Document_Name%></strong><span class='zcs-badge zcs-badge-orange zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'>Query</span></div><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'><%=ifnull(flagged.Review_Remarks,"Remarks required")%></p></li><% } %>
          </ul><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14' href='<%=approval_report_url%>'><i class='zc-li-outline travel-info'></i><span>Open customer Query action</span></a><% } else { %><div class='zcs-nodata-wrapper zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-16'><h3 class='zcs-font-16 zcs-font-medium zcs-color-primary zcs-m-0'>No flagged items</h3><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Save document remarks, then run Query from the filtered document workflow queue.</p></div></div><% } %>
        </section>

        <section class='zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border'>
          <div class='section-heading'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Customer decision workflow</h2><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Approve and customer Query execute from the filtered Verification Pending report.</p></div>
          <iframe class='workflow-frame decision-frame' src='<%=customer_queue_embed%>' title='Filtered customer KYC decision workflow'></iframe>
        </section>
      </aside>
    </div>
  </div>
</div>
<%
}
else
{
%>
<style>
:root{--zcs-page-bg-color:#F3F3F4;--zcs-white-color:#fff}.kyc-denied{min-height:100%;padding:24px;box-sizing:border-box;background:var(--zcs-page-bg-color);font-family:Arial,sans-serif}.kyc-denied-card{max-width:680px;margin:60px auto;padding:32px;text-align:center;background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;color:var(--zcs_primary_text_color)}.kyc-denied-card i{font-size:32px;color:var(--zcs_brand_color)}
</style>
<div class='kyc-denied'><div class='kyc-denied-card'><i class='zc-li-outline ui-1-lock'></i><h2>KYC review unavailable</h2><p>Direct access was denied. The signed-in profile must be KYC_Reviewer or Logistics_Administrator, the Customer_ID must resolve to an existing record, and the customer must be Corporate or Wholesale.</p></div></div>
<%
}
%>