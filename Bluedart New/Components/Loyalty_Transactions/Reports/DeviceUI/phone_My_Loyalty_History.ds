report My_Loyalty_History
{
    quickview
    (
        layout ( type = -1 datablock1 ( layout type = -1 fields ( Transaction_Date Transaction_Type Points Points_Status Expiry_Date ) ) )
        menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) )
        action ( on tap ( View Record ) on long press ( Edit Delete Duplicate View Record ) on left swipe ( Delete ) on right swipe ( Edit ) )
    )
    detailview
    (
        layout ( type = 1 datablock1 ( layout type = -2 fields ( Loyalty_Transaction_ID Shipment Transaction_Type Points Amount_Equivalent Transaction_Date Expiry_Date Points_Status Applied_Tier Reference Notes ) ) )
        menu ( header ( Edit Duplicate Delete ) )
    )
}