form Audit_Log
{
    title
    {
        displayname = "Audit Log"
        on add = "Record Audit Event"
        on edit = "Review Audit Event"
    }
    success message = "Audit event recorded"

    Event_Identity
    (
        type = section
        displayname = "Event Identity"
        row = 1
        column = 0
    )
    Audit_ID
    (
        type = autonumber
        displayname = "Audit ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Event_Time
    (
        type = datetime
        displayname = "Event Time"
        initial value = "${zoho.currenttime}"
        row = 1
        column = 1
        width = medium
    )
    must have Actor_Email
    (
        type = email
        displayname = "Actor Email"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    must have Actor_Profile
    (
        type = text
        displayname = "Actor Profile"
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    must have Action_Name
    (
        type = text
        displayname = "Action Name"
        maxchar = 150
        row = 1
        column = 2
        width = medium
    )
    must have Module_Name
    (
        type = text
        displayname = "Module Name"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    must have Record_ID
    (
        type = text
        displayname = "Record ID"
        maxchar = 100
        row = 1
        column = 2
        width = medium
    )

    Evidence_Details
    (
        type = section
        displayname = "Evidence Details"
        visibility = true
        row = 2
        column = 1
    )
    Before_Data
    (
        type = textarea
        displayname = "Before Data"
        height = 120px
        isencrypted = true
        row = 2
        column = 1
        width = medium
    )
    After_Data
    (
        type = textarea
        displayname = "After Data"
        height = 120px
        isencrypted = true
        row = 2
        column = 2
        width = medium
    )
    must have Source
    (
        type = picklist
        displayname = "Source"
        values = {"Form Workflow","Report Action","Schedule","Payment","Integration","Admin Correction"}
        row = 2
        column = 1
        width = medium
    )
    must have Severity
    (
        type = picklist
        displayname = "Severity"
        values = {"Info","Warning","Critical"}
        initial value = "Info"
        row = 2
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Record Event"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Event"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}