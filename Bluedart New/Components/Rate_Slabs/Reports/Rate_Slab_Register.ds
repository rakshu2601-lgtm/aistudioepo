default list Rate_Slab_Register
{
    displayName = "Rate Slabs"
    show all rows from Rate_Slabs
    (
        Rate_Card
        Slab_Name
        Service_Zone
        Minimum_Weight_Kg
        Maximum_Weight_Kg
        Minimum_Distance_Km
        Maximum_Distance_Km
        Base_Rate
        Additional_Kg_Rate
        Active
    )
    filters
    (
        Rate_Card
        Service_Zone
        Active
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Rate_Card ascending
    )
    sort by
    (
        Minimum_Weight_Kg ascending
        Minimum_Distance_Km ascending
    )
}