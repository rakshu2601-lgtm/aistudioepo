form Rate_Slabs
{
    title
    {
        displayname = "Rate Slabs"
        on add = "Add Rate Slab"
        on edit = "Edit Rate Slab"
    }
    success message = "Rate slab saved successfully"
    Slab_Identity
    (
        type = section
        displayname = "Slab Identity"
        row = 1
        column = 0
    )
    must have Rate_Card
    (
        type = picklist
        displayname = "Rate Card"
        values = Rate_Cards[Status != "Expired"].ID
        displayformat = [Rate_Card_Name]
        searchable = true
        sortorder = ascending
        row = 1
        column = 1
        width = medium
    )
    must have Slab_Name
    (
        type = text
        displayname = "Slab Name"
        row = 1
        column = 2
        width = medium
    )
    Service_Zone
    (
        type = text
        displayname = "Service Zone"
        row = 1
        column = 1
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 2
        width = medium
    )
    Weight_and_Distance_Bands
    (
        type = section
        displayname = "Weight and Distance Bands"
        visibility = true
        row = 2
        column = 1
    )
    must have Minimum_Weight_Kg
    (
        type = decimal
        displayname = "Minimum Weight (Kg)"
        decimalplace = 3
        row = 2
        column = 1
        width = medium
    )
    must have Maximum_Weight_Kg
    (
        type = decimal
        displayname = "Maximum Weight (Kg)"
        decimalplace = 3
        row = 2
        column = 2
        width = medium
    )
    must have Minimum_Distance_Km
    (
        type = decimal
        displayname = "Minimum Distance (Km)"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    must have Maximum_Distance_Km
    (
        type = decimal
        displayname = "Maximum Distance (Km)"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Charges
    (
        type = section
        displayname = "Charges"
        visibility = true
        row = 3
        column = 1
    )
    must have Base_Rate
    (
        type = INR
        displayname = "Base Rate"
        format = commadotindian
        decimalplace = 2
        maxchar = 12
        row = 3
        column = 1
        width = medium
    )
    must have Additional_Kg_Rate
    (
        type = INR
        displayname = "Additional Kg Rate"
        format = commadotindian
        decimalplace = 2
        maxchar = 12
        initial value = 0
        row = 3
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Slab"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Slab"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}