form Customers
{
    title
    {
        displayname = "Customers"
        on add = "Onboard Customer"
        on edit = "Update Customer"
    }
    success message = "Customer profile saved successfully"
    Customer_Identity
    (
        type = section
        displayname = "Customer Identity"
        row = 1
        column = 0
    )
    Customer_ID
    (
        type = autonumber
        displayname = "Customer ID"
        start index = 100001
        row = 1
        column = 1
        width = medium
    )
    must have Registration_Source
    (
        type = radiobuttons
        displayname = "Registration Source"
        values = {"Customer Portal","Employee"}
        layout = 2
        row = 1
        column = 2
        width = medium
    )
    must have Customer_Type
    (
        type = radiobuttons
        displayname = "Customer Type"
        values = {"Retail","Corporate","Wholesale"}
        layout = 3
        row = 1
        column = 1
        width = medium
    )
    must have Full_Name
    (
        type = name
        displayname = "Full Name"
        personal data = true
        prefix
        (
            type = prefix
            displayname = "Title"
            value = {"Mr.","Ms.","Mrs.","Dr."}
        )
        first_name
        (
            type = first_name
            displayname = "First Name"
        )
        last_name
        (
            type = last_name
            displayname = "Last Name"
        )
        suffix
        (
            type = suffix
            displayname = "Suffix"
            visibility = false
        )
        row = 1
        column = 2
        width = medium
    )
    must have Mobile_Number
    (
        type = phonenumber
        displayname = "Mobile Number"
        allowedcountries = {in}
        defaultcountry = "in"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    must have unique Email_ID
    (
        type = email
        displayname = "Email ID"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    unique Portal_Login_Email
    (
        type = email
        displayname = "Portal Login Email"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    must have Primary_Address
    (
        type = address
        displayname = "Primary Address"
        capture_coordinates = true
        adjust_using_map = true
        personal data = true
        address_line_1
        (
            type = address_line_1
            displayname = "Address Line 1"
        )
        address_line_2
        (
            type = address_line_2
            displayname = "Address Line 2"
        )
        district_city
        (
            type = district_city
            displayname = "City / District"
        )
        state_province
        (
            type = state_province
            displayname = "State"
        )
        postal_Code
        (
            type = postal_Code
            displayname = "Pincode"
        )
        country
        (
            type = country
            displayname = "Country"
        )
        latitude
        (
            type = latitude
            displayname = "Latitude"
            visibility = false
        )
        longitude
        (
            type = longitude
            displayname = "Longitude"
            visibility = false
        )
        row = 1
        column = 2
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    Business_Details
    (
        type = section
        displayname = "Corporate / Wholesale Details"
        visibility = true
        row = 2
        column = 1
    )
    Company_Name
    (
        type = text
        displayname = "Company Name"
        row = 2
        column = 1
        width = medium
    )
    GSTIN
    (
        type = text
        displayname = "GSTIN"
        isencrypted = true
        row = 2
        column = 2
        width = medium
    )
    PAN_Number
    (
        type = text
        displayname = "PAN Number"
        isencrypted = true
        row = 2
        column = 1
        width = medium
    )
    Contact_Person_Name
    (
        type = name
        displayname = "Contact Person Name"
        personal data = true
        prefix
        (
            type = prefix
            displayname = "Title"
            value = {"Mr.","Ms.","Mrs.","Dr."}
        )
        first_name
        (
            type = first_name
            displayname = "First Name"
        )
        last_name
        (
            type = last_name
            displayname = "Last Name"
        )
        suffix
        (
            type = suffix
            displayname = "Suffix"
            visibility = false
        )
        row = 2
        column = 2
        width = medium
    )
    Contact_Person_Email
    (
        type = email
        displayname = "Contact Person Email"
        personal data = true
        row = 2
        column = 1
        width = medium
    )
    Contact_Person_Phone
    (
        type = phonenumber
        displayname = "Contact Person Phone"
        allowedcountries = {in}
        defaultcountry = "in"
        personal data = true
        row = 2
        column = 2
        width = medium
    )
    Credit_and_Pricing
    (
        type = section
        displayname = "Credit and Pricing"
        visibility = true
        row = 3
        column = 1
    )
    Requested_Credit_Limit
    (
        type = INR
        displayname = "Requested Credit Limit"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        initial value = 0
        row = 3
        column = 1
        width = medium
    )
    Approved_Credit_Limit
    (
        type = INR
        displayname = "Approved Credit Limit"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        initial value = 0
        row = 3
        column = 2
        width = medium
    )
    must have Payment_Terms
    (
        type = picklist
        displayname = "Payment Terms"
        values = {"Prepaid","Net 15","Net 30"}
        initial value = "Prepaid"
        row = 3
        column = 1
        width = medium
    )
    Assigned_Rate_Card
    (
        type = picklist
        displayname = "Assigned Rate Card"
        values = Rate_Cards.ID
        displayformat = [Rate_Card_Name]
        sortorder = ascending
        row = 3
        column = 2
        width = medium
    )
    Default_Collection_Center
    (
        type = picklist
        displayname = "Default Collection Center"
        values = Hubs[Hub_Type == "Collection Center" && Active == true].ID
        displayformat = [Hub_Name]
        sortorder = ascending
        row = 3
        column = 1
        width = medium
    )
    Verification_and_Portal
    (
        type = section
        displayname = "Verification and Portal Access"
        visibility = true
        row = 4
        column = 1
    )
    Mobile_OTP_Verified
    (
        type = checkbox
        displayname = "Mobile OTP Verified"
        initial value = false
        row = 4
        column = 1
        width = medium
    )
    Email_OTP_Verified
    (
        type = checkbox
        displayname = "Email OTP Verified"
        initial value = false
        row = 4
        column = 2
        width = medium
    )
    OTP_Verified_At
    (
        type = datetime
        displayname = "OTP Verified At"
        row = 4
        column = 1
        width = medium
    )
    must have Onboarding_Status
    (
        type = picklist
        displayname = "Onboarding Status"
        values = {"Registration Pending","KYC Pending","Pending Verification","Action Required","Active","KYC Expired","Suspended"}
        initial value = "Registration Pending"
        row = 4
        column = 2
        width = medium
    )
    KYC_Submitted_On
    (
        type = datetime
        displayname = "KYC Submitted On"
        row = 4
        column = 1
        width = medium
    )
    KYC_Verified_Date
    (
        type = date
        displayname = "KYC Verified Date"
        row = 4
        column = 2
        width = medium
    )
    KYC_Expiry_Date
    (
        type = date
        displayname = "KYC Expiry Date"
        row = 4
        column = 1
        width = medium
    )
    must have Portal_Access_Status
    (
        type = picklist
        displayname = "Portal Access Status"
        values = {"Not Invited","Invitation Sent","Active","Disabled"}
        initial value = "Not Invited"
        row = 4
        column = 2
        width = medium
    )
    Loyalty_and_Account
    (
        type = section
        displayname = "Loyalty and Account"
        visibility = true
        row = 5
        column = 1
    )
    Current_Loyalty_Points
    (
        type = decimal
        displayname = "Current Loyalty Points"
        decimalplace = 2
        initial value = 0
        row = 5
        column = 1
        width = medium
    )
    Lifetime_Loyalty_Points
    (
        type = decimal
        displayname = "Lifetime Loyalty Points"
        decimalplace = 2
        initial value = 0
        row = 5
        column = 2
        width = medium
    )
    Current_Loyalty_Tier
    (
        type = picklist
        displayname = "Current Loyalty Tier"
        values = {"None","Silver","Gold","Platinum"}
        initial value = "None"
        row = 5
        column = 1
        width = medium
    )
    Quarterly_Eligible_Spend
    (
        type = INR
        displayname = "Quarterly Eligible Spend"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        initial value = 0
        row = 5
        column = 2
        width = medium
    )
    Loyalty_Tier_Last_Reviewed_At
    (
        type = datetime
        displayname = "Loyalty Tier Last Reviewed At"
        row = 5
        column = 1
        width = medium
    )
    Outstanding_Balance
    (
        type = INR
        displayname = "Outstanding Balance"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        initial value = 0
        row = 5
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit Registration"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Profile"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
    blueprint components
    {
        stages = {"KYC Pending","Pending Verification","Action Required","Active","KYC Expired"}
    }
}