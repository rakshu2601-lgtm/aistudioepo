Customers_On_Validate as "Validate Customer Registration"
{
    type = form
    form = Customers
    record event = on add or edit
    description = "Validates India business identifiers, OTP activation, credit, pricing, and portal ownership"

    on validate
    {
        actions
        {
            custom deluge script
            (
                is_portal = thisapp.portal.isUserInProfile("Customer_Portal");
                if(is_portal == true)
                {
                    if(input.ID != null && input.Portal_Login_Email != zoho.loginuserid && input.Email_ID != zoho.loginuserid)
                    {
                        alert "You cannot update another customer's profile.";
                        cancel submit;
                    }
                    if(input.ID == null && input.Email_ID != zoho.loginuserid)
                    {
                        alert "Use the email address associated with your portal login.";
                        cancel submit;
                    }
                }
                if(input.Customer_Type == "Corporate" || input.Customer_Type == "Wholesale")
                {
                    if(ifnull(input.Company_Name,"").trim() == "" || ifnull(input.GSTIN,"").trim() == "" || ifnull(input.PAN_Number,"").trim() == "" || input.Contact_Person_Name.first_name == null || ifnull(input.Contact_Person_Email,"").trim() == "" || input.Contact_Person_Phone == null)
                    {
                        alert "Company, GSTIN, PAN, and complete contact-person details are required for corporate and wholesale customers.";
                        cancel submit;
                    }
                    normalized_gstin = input.GSTIN.toUpperCase().replaceAll(" ","");
                    normalized_pan = input.PAN_Number.toUpperCase().replaceAll(" ","");
                    if(!normalized_gstin.matches("[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]"))
                    {
                        alert "Enter a valid 15-character Indian GSTIN.";
                        cancel submit;
                    }
                    if(!normalized_pan.matches("[A-Z]{5}[0-9]{4}[A-Z]"))
                    {
                        alert "Enter a valid 10-character PAN.";
                        cancel submit;
                    }
                    input.GSTIN = normalized_gstin;
                    input.PAN_Number = normalized_pan;
                    if(ifnull(input.Requested_Credit_Limit,0) < 0 || ifnull(input.Approved_Credit_Limit,0) < 0)
                    {
                        alert "Requested and approved credit limits cannot be negative.";
                        cancel submit;
                    }
                }
                else
                {
                    if(input.Payment_Terms != "Prepaid" || ifnull(input.Approved_Credit_Limit,0) != 0)
                    {
                        alert "Retail customers must remain prepaid with a zero approved credit limit.";
                        cancel submit;
                    }
                    if(input.Onboarding_Status == "Active" && (input.Mobile_OTP_Verified != true || input.Email_OTP_Verified != true))
                    {
                        alert "Both mobile and email OTP verification are required before retail activation.";
                        cancel submit;
                    }
                }
                if(input.Assigned_Rate_Card != null)
                {
                    rate_card = Rate_Cards[ID == input.Assigned_Rate_Card];
                    if(rate_card.Status != "Published" || (rate_card.Customer_Type != input.Customer_Type && rate_card.Customer_Type != "All"))
                    {
                        alert "Select a published rate card applicable to this customer type.";
                        cancel submit;
                    }
                }
                if(input.Default_Collection_Center != null)
                {
                    hub = Hubs[ID == input.Default_Collection_Center];
                    if(hub.Active != true || hub.Hub_Type != "Collection Center")
                    {
                        alert "Default Collection Center must be an active collection center.";
                        cancel submit;
                    }
                }
                if(input.Primary_Address.postal_Code != null && !input.Primary_Address.postal_Code.matches("[0-9]{6}"))
                {
                    alert "Primary address pincode must contain exactly six digits.";
                    cancel submit;
                }
            )
        }
    }
}