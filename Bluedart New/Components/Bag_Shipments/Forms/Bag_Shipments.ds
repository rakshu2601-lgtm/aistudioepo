form Bag_Shipments
{
    title
    {
        displayname = "Bag Shipments"
        on add = "Scan Shipment into Bag"
        on edit = "View Bag Shipment"
    }
    success message = "Bag shipment saved successfully"
    Bag_Assignment
    (
        type = section
        displayname = "Bag Assignment"
        row = 1
        column = 0
    )
    must have Bag
    (
        type = picklist
        displayname = "Bag"
        values = Logistics_Bags.ID
        displayformat = [Bag_Number]
        searchable = true
        sortorder = ascending
        row = 1
        column = 1
        width = medium
    )
    must have Shipment
    (
        type = picklist
        displayname = "Shipment"
        values = Shipment_Requests.ID
        displayformat = [AWB_Number]
        searchable = true
        sortorder = ascending
        row = 1
        column = 2
        width = medium
    )
    must have Scan_Status
    (
        type = picklist
        displayname = "Scan Status"
        values = {"Loaded","Received","Missing","Damaged","Removed"}
        initial value = "Loaded"
        row = 1
        column = 1
        width = medium
    )
    Scan_Custody
    (
        type = section
        displayname = "Scan Custody"
        visibility = true
        row = 2
        column = 1
    )
    Scanned_At
    (
        type = datetime
        displayname = "Scanned At"
        row = 2
        column = 1
        width = medium
    )
    Scanned_By_Email
    (
        type = email
        displayname = "Scanned By Email"
        personal data = true
        row = 2
        column = 2
        width = medium
    )
    Received_At
    (
        type = datetime
        displayname = "Received At"
        row = 2
        column = 1
        width = medium
    )
    Exception_Notes
    (
        type = textarea
        displayname = "Exception Notes"
        height = 100px
        row = 2
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Scan into Bag"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Save"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}