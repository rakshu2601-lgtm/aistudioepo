Bag_Shipments_On_Success as "Recalculate Bag after Scan"
{
    type = form
    form = Bag_Shipments
    record event = on add
    description = "Recalculates open-bag totals and audits every loaded AWB scan"

    on success
    {
        actions
        {
            custom deluge script
            (
                shipment_count = 0;
                total_weight = 0.0;
                for each bag_item in Bag_Shipments[Bag == input.Bag && Scan_Status == "Loaded"]
                {
                    shipment_count = shipment_count + 1;
                    shipment_record = Shipment_Requests[ID == bag_item.Shipment];
                    total_weight = total_weight + ifnull(shipment_record.Billable_Weight_Kg,0);
                }
                bag_record = Logistics_Bags[ID == input.Bag];
                bag_record.Total_Shipments = shipment_count;
                bag_record.Total_Weight_Kg = total_weight;
                audit_id = insert into Audit_Log
                [
                    Event_Time = zoho.currenttime
                    Actor_Email = zoho.loginuserid
                    Actor_Profile = thisapp.permissions.loginUserProfile()
                    Action_Name = "Load Shipment into Bag"
                    Module_Name = "Bag Shipments"
                    Record_ID = input.ID.toString()
                    After_Data = "Bag=" + input.Bag + "; Shipment=" + input.Shipment + "; Status=Loaded"
                    Source = "Form Workflow"
                    Severity = "Critical"
                ];
            )
        }
    }
}