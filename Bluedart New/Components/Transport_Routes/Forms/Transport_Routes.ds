form Transport_Routes
{
    title
    {
        displayname = "Transport Routes"
        on add = "Add Transport Route"
        on edit = "Edit Transport Route"
    }
    success message = "Transport route saved successfully"
    Route_Identity
    (
        type = section
        displayname = "Route Identity"
        row = 1
        column = 0
    )
    must have unique Route_ID
    (
        type = text
        displayname = "Route ID"
        row = 1
        column = 1
        width = medium
    )
    must have Route_Name
    (
        type = text
        displayname = "Route Name"
        row = 1
        column = 2
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    Lane_Details
    (
        type = section
        displayname = "Lane Details"
        visibility = true
        row = 2
        column = 1
    )
    must have Origin_Sorting_Hub
    (
        type = picklist
        displayname = "Origin Sorting Hub"
        values = Hubs[Hub_Type == "Sorting Hub" && Active == true].ID
        displayformat = [Hub_Name]
        searchable = true
        sortorder = ascending
        row = 2
        column = 1
        width = medium
    )
    must have Destination_Sorting_Hub
    (
        type = picklist
        displayname = "Destination Sorting Hub"
        values = Hubs[Hub_Type == "Sorting Hub" && Active == true].ID
        displayformat = [Hub_Name]
        searchable = true
        sortorder = ascending
        row = 2
        column = 2
        width = medium
    )
    must have Transport_Mode
    (
        type = radiobuttons
        displayname = "Transport Mode"
        values = {"Air","Surface"}
        layout = 2
        row = 2
        column = 1
        width = medium
    )
    Capacity_and_Transit
    (
        type = section
        displayname = "Capacity and Transit"
        visibility = true
        row = 3
        column = 1
    )
    must have Distance_Km
    (
        type = decimal
        displayname = "Distance (Km)"
        decimalplace = 2
        row = 3
        column = 1
        width = medium
    )
    must have Estimated_Transit_Hours
    (
        type = decimal
        displayname = "Estimated Transit Hours"
        decimalplace = 2
        row = 3
        column = 2
        width = medium
    )
    must have Daily_Capacity_Kg
    (
        type = decimal
        displayname = "Daily Capacity (Kg)"
        decimalplace = 2
        row = 3
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Route"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Route"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}