form Delivery_Run_Sheets
{
    title
    {
        displayname = "Delivery Run Sheets"
        on add = "Plan Delivery Run"
        on edit = "Edit Delivery Run"
    }
    success message = "Delivery run sheet saved successfully"
    Run_Identity
    (
        type = section
        displayname = "Run Identity"
        row = 1
        column = 0
    )
    DRS_Number
    (
        type = autonumber
        displayname = "DRS Number"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Hub
    (
        type = picklist
        displayname = "Hub"
        values = Hubs[Hub_Type == "Collection Center" && Active == true].ID
        displayformat = [Hub_Name]
        searchable = true
        sortorder = ascending
        row = 1
        column = 1
        width = medium
    )
    must have Assigned_Agent
    (
        type = picklist
        displayname = "Assigned Agent"
        values = Operations_Users[Active == true && Application_Role == "Field Agent" && (Agent_Role == "Delivery" || Agent_Role == "Both")].ID
        displayformat = [Employee_Name.first_name]
        searchable = true
        sortorder = ascending
        row = 1
        column = 2
        width = medium
    )
    must have Run_Date
    (
        type = date
        displayname = "Run Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    must have Delivery_Zone
    (
        type = text
        displayname = "Delivery Zone"
        row = 1
        column = 2
        width = medium
    )
    Vehicle
    (
        type = picklist
        displayname = "Vehicle"
        values = Vehicles[Active == true && Status == "Available"].ID
        displayformat = [Vehicle_Number]
        searchable = true
        sortorder = ascending
        row = 1
        column = 1
        width = medium
    )
    must have DRS_Status
    (
        type = picklist
        displayname = "DRS Status"
        values = {"Draft","Released","In Progress","Completed","Cancelled"}
        initial value = "Draft"
        row = 1
        column = 2
        width = medium
    )
    Run_Progress
    (
        type = section
        displayname = "Run Progress"
        visibility = true
        row = 2
        column = 1
    )
    Planned_Stop_Count
    (
        type = number
        displayname = "Planned Stop Count"
        initial value = 0
        row = 2
        column = 1
        width = medium
    )
    Delivered_Count
    (
        type = number
        displayname = "Delivered Count"
        initial value = 0
        row = 2
        column = 2
        width = medium
    )
    Failed_Count
    (
        type = number
        displayname = "Failed Count"
        initial value = 0
        row = 2
        column = 1
        width = medium
    )
    Expected_COD_Amount
    (
        type = INR
        displayname = "Expected COD Amount"
        format = commadotindian
        decimalplace = 2
        initial value = 0
        row = 2
        column = 2
        width = medium
    )
    Collected_COD_Amount
    (
        type = INR
        displayname = "Collected COD Amount"
        format = commadotindian
        decimalplace = 2
        initial value = 0
        row = 2
        column = 1
        width = medium
    )
    Released_At
    (
        type = datetime
        displayname = "Released At"
        row = 2
        column = 2
        width = medium
    )
    Completed_At
    (
        type = datetime
        displayname = "Completed At"
        row = 2
        column = 1
        width = medium
    )
    Supervisor_Details
    (
        type = section
        displayname = "Supervisor Details"
        visibility = true
        row = 3
        column = 1
    )
    Supervisor_Notes
    (
        type = textarea
        displayname = "Supervisor Notes"
        height = 100px
        row = 3
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Draft"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Draft"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}