Delivery_Run_Sheets_On_Load as "Prepare Delivery Run Planner"
{
    type = form
    form = Delivery_Run_Sheets
    record event = on add or edit
    description = "Sets the supervisor hub, filters delivery resources, and locks workflow-controlled run data"

    on load
    {
        actions
        {
            custom deluge script
            (
                disable DRS_Status, Planned_Stop_Count, Delivered_Count, Failed_Count, Expected_COD_Amount, Collected_COD_Amount, Released_At, Completed_At;
                current_profile = thisapp.permissions.loginUserProfile();
                if(input.ID == null && current_profile == "Hub_Supervisor")
                {
                    logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
                    if(logged_user.count(ID) > 0)
                    {
                        deputation_active = logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= input.Run_Date) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= input.Run_Date);
                        input.Hub = if(deputation_active == true,logged_user.Deputed_Hub,logged_user.Home_Hub);
                    }
                }
                clear Assigned_Agent;
                clear Vehicle;
                if(input.Hub != null && input.Run_Date != null)
                {
                    eligible_agents = Operations_Users[Active == true && Application_Role == "Field Agent" && (Agent_Role == "Delivery" || Agent_Role == "Both") && ((Deputed_Hub == input.Hub && (Deputation_Start_Date == null || Deputation_Start_Date <= input.Run_Date) && (Deputation_End_Date == null || Deputation_End_Date >= input.Run_Date)) || (Home_Hub == input.Hub && (Deputed_Hub == null || (Deputation_Start_Date != null && Deputation_Start_Date > input.Run_Date) || (Deputation_End_Date != null && Deputation_End_Date < input.Run_Date))))];
                    Assigned_Agent:ui.add(eligible_agents.ID.getall());
                    eligible_vehicles = Vehicles[Owning_Hub == input.Hub && Active == true && (Status == "Available" || ID == input.Vehicle)];
                    Vehicle:ui.add(eligible_vehicles.ID.getall());
                }
                if(input.ID != null && input.DRS_Status != "Draft")
                {
                    disable Hub, Assigned_Agent, Run_Date, Delivery_Zone, Vehicle, Supervisor_Notes;
                }
            )
        }
    }
}