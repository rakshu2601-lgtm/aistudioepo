list Pickup_Queue
{
    displayName = "Pickup Queue"
    show all rows from Shipment_Requests [Shipment_Status == "Booked" && ((Collection_Center == Operations_Users[Work_Email == zoho.loginuserid && Active == true && Deputed_Hub is not null && (Deputation_Start_Date is null || Deputation_Start_Date <= zoho.currentdate) && (Deputation_End_Date is null || Deputation_End_Date >= zoho.currentdate)].Deputed_Hub) || (Collection_Center == Operations_Users[Work_Email == zoho.loginuserid && Active == true && (Deputed_Hub is null || Deputation_Start_Date > zoho.currentdate || Deputation_End_Date < zoho.currentdate)].Home_Hub))]
    (
        AWB_Number
        Booked_On
        Customer
        Sender_Name
        Sender_Phone
        Pickup_Address
        Pickup_Pincode
        Package_Count
        Billable_Weight_Kg
        Collection_Center
        Expected_Delivery_Date
        Shipment_Status
    )
    filters
    (
        Customer
        Pickup_Pincode
        Collection_Center
        Expected_Delivery_Date
        Shipment_Status
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Collection_Center ascending
    )
    sort by
    (
        Booked_On ascending
    )
}