list Delivery_Queue
{
    displayName = "Delivery Queue"
    show all rows from Shipment_Requests [(Shipment_Status == "At Delivery Hub" || Shipment_Status == "Delivery Failed - NDR") && ((Destination_Hub == Operations_Users[Work_Email == zoho.loginuserid && Active == true && Deputed_Hub is not null && (Deputation_Start_Date is null || Deputation_Start_Date <= zoho.currentdate) && (Deputation_End_Date is null || Deputation_End_Date >= zoho.currentdate)].Deputed_Hub) || (Destination_Hub == Operations_Users[Work_Email == zoho.loginuserid && Active == true && (Deputed_Hub is null || Deputation_Start_Date > zoho.currentdate || Deputation_End_Date < zoho.currentdate)].Home_Hub))]
    (
        AWB_Number
        Customer
        Recipient_Name
        Recipient_Phone
        Delivery_Address
        Delivery_Pincode
        Payment_Type
        COD_Amount
        Destination_Hub
        NDR_Attempt_Count
        Expected_Delivery_Date
        Shipment_Status
    )
    filters
    (
        Customer
        Delivery_Pincode
        Payment_Type
        Destination_Hub
        Expected_Delivery_Date
        Shipment_Status
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Destination_Hub ascending
    )
    sort by
    (
        Expected_Delivery_Date ascending
    )
}