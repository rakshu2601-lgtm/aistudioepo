form Shipment_Requests
{
    title
    {
        displayname = "Shipment Requests"
        on add = "Book Shipment"
        on edit = "Update Shipment"
    }
    success message = "Shipment request saved successfully"
    Booking_and_Customer
    (
        type = section
        displayname = "Booking and Customer"
        row = 1
        column = 0
    )
    AWB_Number
    (
        type = autonumber
        displayname = "AWB Number"
        start index = 100000001
        row = 1
        column = 1
        width = medium
    )
    must have Booking_Source
    (
        type = radiobuttons
        displayname = "Booking Source"
        values = {"Customer Portal","Employee","Field Agent"}
        layout = 3
        row = 1
        column = 2
        width = medium
    )
    must have Customer
    (
        type = picklist
        displayname = "Customer"
        values = Customers[Active == true].ID
        displayformat = [Full_Name.first_name]
        searchable = true
        sortorder = ascending
        row = 1
        column = 1
        width = medium
    )
    Sender_Details
    (
        type = section
        displayname = "Sender Details"
        visibility = true
        row = 2
        column = 1
    )
    must have Sender_Name
    (
        type = text
        displayname = "Sender Name"
        personal data = true
        row = 2
        column = 1
        width = medium
    )
    must have Sender_Phone
    (
        type = phonenumber
        displayname = "Sender Phone"
        allowedcountries = {in}
        defaultcountry = "in"
        personal data = true
        row = 2
        column = 2
        width = medium
    )
    Sender_Email
    (
        type = email
        displayname = "Sender Email"
        personal data = true
        row = 2
        column = 1
        width = medium
    )
    must have Pickup_Address
    (
        type = address
        displayname = "Pickup Address"
        capture_coordinates = true
        adjust_using_map = true
        personal data = true
        address_line_1
        (
            type = address_line_1
            displayname = "Address Line 1"
        )
        address_line_2
        (
            type = address_line_2
            displayname = "Address Line 2"
        )
        district_city
        (
            type = district_city
            displayname = "City / District"
        )
        state_province
        (
            type = state_province
            displayname = "State"
        )
        postal_Code
        (
            type = postal_Code
            displayname = "Pincode"
        )
        country
        (
            type = country
            displayname = "Country"
        )
        latitude
        (
            type = latitude
            displayname = "Latitude"
            visibility = false
        )
        longitude
        (
            type = longitude
            displayname = "Longitude"
            visibility = false
        )
        row = 2
        column = 2
        width = medium
    )
    must have Pickup_Pincode
    (
        type = text
        displayname = "Pickup Pincode"
        maxchar = 6
        row = 2
        column = 1
        width = medium
    )
    Recipient_Details
    (
        type = section
        displayname = "Recipient Details"
        visibility = true
        row = 3
        column = 1
    )
    must have Recipient_Name
    (
        type = text
        displayname = "Recipient Name"
        personal data = true
        row = 3
        column = 1
        width = medium
    )
    must have Recipient_Phone
    (
        type = phonenumber
        displayname = "Recipient Phone"
        allowedcountries = {in}
        defaultcountry = "in"
        personal data = true
        row = 3
        column = 2
        width = medium
    )
    Recipient_Email
    (
        type = email
        displayname = "Recipient Email"
        personal data = true
        row = 3
        column = 1
        width = medium
    )
    must have Delivery_Address
    (
        type = address
        displayname = "Delivery Address"
        capture_coordinates = true
        adjust_using_map = true
        personal data = true
        address_line_1
        (
            type = address_line_1
            displayname = "Address Line 1"
        )
        address_line_2
        (
            type = address_line_2
            displayname = "Address Line 2"
        )
        district_city
        (
            type = district_city
            displayname = "City / District"
        )
        state_province
        (
            type = state_province
            displayname = "State"
        )
        postal_Code
        (
            type = postal_Code
            displayname = "Pincode"
        )
        country
        (
            type = country
            displayname = "Country"
        )
        latitude
        (
            type = latitude
            displayname = "Latitude"
            visibility = false
        )
        longitude
        (
            type = longitude
            displayname = "Longitude"
            visibility = false
        )
        row = 3
        column = 2
        width = medium
    )
    must have Delivery_Pincode
    (
        type = text
        displayname = "Delivery Pincode"
        maxchar = 6
        row = 3
        column = 1
        width = medium
    )
    Package_Details
    (
        type = section
        displayname = "Package Details"
        visibility = true
        row = 4
        column = 1
    )
    must have Package_Count
    (
        type = number
        displayname = "Package Count"
        initial value = 1
        row = 4
        column = 1
        width = medium
    )
    must have Contents_Description
    (
        type = textarea
        displayname = "Contents Description"
        height = 100px
        row = 4
        column = 2
        width = medium
    )
    must have Declared_Value
    (
        type = INR
        displayname = "Declared Value"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 4
        column = 1
        width = medium
    )
    must have Transport_Mode
    (
        type = radiobuttons
        displayname = "Transport Mode"
        values = {"Air","Surface"}
        layout = 2
        row = 4
        column = 2
        width = medium
    )
    must have Length_Cm
    (
        type = decimal
        displayname = "Length (Cm)"
        decimalplace = 2
        row = 4
        column = 1
        width = medium
    )
    must have Width_Cm
    (
        type = decimal
        displayname = "Width (Cm)"
        decimalplace = 2
        row = 4
        column = 2
        width = medium
    )
    must have Height_Cm
    (
        type = decimal
        displayname = "Height (Cm)"
        decimalplace = 2
        row = 4
        column = 1
        width = medium
    )
    must have Actual_Weight_Kg
    (
        type = decimal
        displayname = "Actual Weight (Kg)"
        decimalplace = 3
        row = 4
        column = 2
        width = medium
    )
    Volumetric_Weight_Kg
    (
        type = decimal
        displayname = "Volumetric Weight (Kg)"
        decimalplace = 3
        initial value = 0
        row = 4
        column = 1
        width = medium
    )
    Billable_Weight_Kg
    (
        type = decimal
        displayname = "Billable Weight (Kg)"
        decimalplace = 3
        initial value = 0
        row = 4
        column = 2
        width = medium
    )
    Rating_Details
    (
        type = section
        displayname = "Rating Details"
        visibility = true
        row = 5
        column = 1
    )
    Rated_Distance_Km
    (
        type = decimal
        displayname = "Rated Distance (Km)"
        decimalplace = 2
        initial value = 0
        row = 5
        column = 1
        width = medium
    )
    Applied_Rate_Card
    (
        type = picklist
        displayname = "Applied Rate Card"
        values = Rate_Cards.ID
        displayformat = [Rate_Card_Name]
        row = 5
        column = 2
        width = medium
    )
    Applied_Rate_Slab
    (
        type = picklist
        displayname = "Applied Rate Slab"
        values = Rate_Slabs.ID
        displayformat = [Slab_Name]
        row = 5
        column = 1
        width = medium
    )
    Base_Rate
    (
        type = INR
        displayname = "Base Rate"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        initial value = 0
        row = 5
        column = 2
        width = medium
    )
    Fuel_Surcharge
    (
        type = INR
        displayname = "Fuel Surcharge"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        initial value = 0
        row = 5
        column = 1
        width = medium
    )
    COD_Handling_Fee
    (
        type = INR
        displayname = "COD Handling Fee"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        initial value = 0
        row = 5
        column = 2
        width = medium
    )
    GST_Amount
    (
        type = INR
        displayname = "GST Amount"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        initial value = 0
        row = 5
        column = 1
        width = medium
    )
    Gross_Amount
    (
        type = INR
        displayname = "Gross Amount"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        initial value = 0
        row = 5
        column = 2
        width = medium
    )
    Payment_and_Redemption
    (
        type = section
        displayname = "Payment and Redemption"
        visibility = true
        row = 6
        column = 1
    )
    Loyalty_Points_Redeemed
    (
        type = decimal
        displayname = "Loyalty Points Redeemed"
        decimalplace = 2
        initial value = 0
        row = 6
        column = 1
        width = medium
    )
    Loyalty_Redemption_Amount
    (
        type = INR
        displayname = "Loyalty Redemption Amount"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        initial value = 0
        row = 6
        column = 2
        width = medium
    )
    Total_Payable
    (
        type = INR
        displayname = "Total Payable"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        initial value = 0
        row = 6
        column = 1
        width = medium
    )
    must have Payment_Type
    (
        type = radiobuttons
        displayname = "Payment Type"
        values = {"Prepaid","COD","Credit"}
        layout = 3
        initial value = "Prepaid"
        row = 6
        column = 2
        width = medium
    )
    COD_Amount
    (
        type = INR
        displayname = "COD Amount"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        initial value = 0
        row = 6
        column = 1
        width = medium
    )
    must have Payment_Status
    (
        type = picklist
        displayname = "Payment Status"
        values = {"Not Required","Pending","Paid","Failed","Refunded"}
        initial value = "Pending"
        row = 6
        column = 2
        width = medium
    )
    must have Credit_Check_Status
    (
        type = picklist
        displayname = "Credit Check Status"
        values = {"Not Applicable","Passed","Hold","KYC Blocked"}
        initial value = "Not Applicable"
        row = 6
        column = 1
        width = medium
    )
    Routing_Details
    (
        type = section
        displayname = "Routing Details"
        visibility = true
        row = 7
        column = 1
    )
    Collection_Center
    (
        type = picklist
        displayname = "Collection Center"
        values = Hubs[Hub_Type == "Collection Center"].ID
        displayformat = [Hub_Name]
        row = 7
        column = 1
        width = medium
    )
    Origin_Sorting_Hub
    (
        type = picklist
        displayname = "Origin Sorting Hub"
        values = Hubs[Hub_Type == "Sorting Hub"].ID
        displayformat = [Hub_Name]
        row = 7
        column = 2
        width = medium
    )
    Destination_Sorting_Hub
    (
        type = picklist
        displayname = "Destination Sorting Hub"
        values = Hubs[Hub_Type == "Sorting Hub"].ID
        displayformat = [Hub_Name]
        row = 7
        column = 1
        width = medium
    )
    Destination_Hub
    (
        type = picklist
        displayname = "Destination Hub"
        values = Hubs[Hub_Type == "Collection Center"].ID
        displayformat = [Hub_Name]
        row = 7
        column = 2
        width = medium
    )
    Current_Hub
    (
        type = picklist
        displayname = "Current Hub"
        values = Hubs.ID
        displayformat = [Hub_Name]
        row = 7
        column = 1
        width = medium
    )
    Shipment_Lifecycle
    (
        type = section
        displayname = "Shipment Lifecycle"
        visibility = true
        row = 8
        column = 1
    )
    must have Shipment_Status
    (
        type = picklist
        displayname = "Shipment Status"
        values = {"Credit Hold","Booked - Hub Assignment Pending","Booked","Picked Up","Inbound at Branch Station","Bagged & Dispatched to Origin Hub","Sorted at Origin Hub","In Transit","Arrived at Destination Hub","At Delivery Hub","Out For Delivery (OFD)","Delivered","Delivery Failed - NDR","Return to Origin","Cancelled"}
        initial value = "Booked"
        row = 8
        column = 1
        width = medium
    )
    Booked_On
    (
        type = datetime
        displayname = "Booked On"
        row = 8
        column = 2
        width = medium
    )
    Expected_Delivery_Date
    (
        type = date
        displayname = "Expected Delivery Date"
        row = 8
        column = 1
        width = medium
    )
    NDR_Attempt_Count
    (
        type = number
        displayname = "NDR Attempt Count"
        initial value = 0
        row = 8
        column = 2
        width = medium
    )
    Loyalty_Awarded
    (
        type = checkbox
        displayname = "Loyalty Awarded"
        initial value = false
        row = 8
        column = 1
        width = medium
    )
    EPOD_Details
    (
        type = section
        displayname = "Electronic Proof of Delivery"
        visibility = true
        row = 9
        column = 1
    )
    EPOD_WorkDrive_File_ID
    (
        type = text
        displayname = "ePOD WorkDrive File ID"
        row = 9
        column = 1
        width = medium
    )
    EPOD_Download_URL
    (
        type = url
        displayname = "ePOD Download URL"
        target = new window
        enable = linkname, title
        row = 9
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Confirm Booking"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Shipment"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}