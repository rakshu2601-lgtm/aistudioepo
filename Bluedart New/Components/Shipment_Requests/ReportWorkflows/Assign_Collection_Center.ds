Assign_Collection_Center as "Assign Collection Center"
{
    type = functions
    form = Shipment_Requests
    execution type = for each record
    description = "Assigns the configured primary collection and destination hubs after profile, serviceability, cutoff, and capacity checks"

    on start
    {
        actions
        {
            on click
            (
                current_profile = thisapp.permissions.loginUserProfile();
                if(input.Shipment_Status != "Booked - Hub Assignment Pending")
                {
                    info "This shipment is no longer awaiting hub assignment.";
                }
                else
                {
                    pickup_map = Hub_Pincode_Mapping[Pincode == input.Pickup_Pincode && Active == true && Serviceability != "Non-Serviceable"];
                    delivery_map = Hub_Pincode_Mapping[Pincode == input.Delivery_Pincode && Active == true && Serviceability != "Non-Serviceable"];
                    if(pickup_map.count(ID) == 0 || delivery_map.count(ID) == 0)
                    {
                        info "Active serviceability mappings are required for both pincodes.";
                    }
                    else
                    {
                        origin_hub = Hubs[ID == pickup_map.Primary_Collection_Center && Active == true];
                        destination_hub = Hubs[ID == delivery_map.Primary_Collection_Center && Active == true];
                        if(origin_hub.count(ID) == 0 || destination_hub.count(ID) == 0)
                        {
                            info "The configured primary collection or destination hub is inactive.";
                        }
                        else
                        {
                            todays_load = Shipment_Requests[Collection_Center == origin_hub.ID && Booked_On >= zoho.currentdate && Shipment_Status != "Cancelled"].count(ID);
                            after_cutoff = zoho.currenttime.getHour() > origin_hub.Cut_Off_Time.getHour() || (zoho.currenttime.getHour() == origin_hub.Cut_Off_Time.getHour() && zoho.currenttime.getMinutes() > origin_hub.Cut_Off_Time.getMinutes());
                            if(todays_load >= origin_hub.Daily_Capacity || after_cutoff == true)
                            {
                                info "The primary collection center is at capacity or past cutoff. Use Reassign Alternate Hub.";
                            }
                            else
                            {
                                input.Collection_Center = origin_hub.ID;
                                input.Origin_Sorting_Hub = origin_hub.Parent_Sorting_Hub;
                                input.Destination_Hub = destination_hub.ID;
                                input.Destination_Sorting_Hub = destination_hub.Parent_Sorting_Hub;
                                input.Current_Hub = origin_hub.ID;
                                input.Shipment_Status = "Booked";
                                tracking_id = insert into Shipment_Tracking_Events
                                [
                                    Shipment = input.ID
                                    Event_Time = zoho.currenttime
                                    Event_Status = "Booked"
                                    Hub = origin_hub.ID
                                    Event_Description = "Shipment assigned to the configured primary collection center."
                                    Source = "System"
                                    Customer_Visible = true
                                    Created_By_Email = zoho.loginuserid
                                ];
                                audit_id = insert into Audit_Log
                                [
                                    Event_Time = zoho.currenttime
                                    Actor_Email = zoho.loginuserid
                                    Actor_Profile = current_profile
                                    Action_Name = "Assign Collection Center"
                                    Module_Name = "Shipment Requests"
                                    Record_ID = input.ID.toString()
                                    Before_Data = "Status=Booked - Hub Assignment Pending"
                                    After_Data = "Status=Booked; Collection Center=" + origin_hub.Hub_Name + "; Destination Hub=" + destination_hub.Hub_Name
                                    Source = "Report Action"
                                    Severity = "Warning"
                                ];
                            }
                        }
                    }
                }
            )
        }
    }
}