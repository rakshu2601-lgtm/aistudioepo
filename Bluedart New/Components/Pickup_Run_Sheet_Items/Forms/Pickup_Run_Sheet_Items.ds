form Pickup_Run_Sheet_Items
{
    title
    {
        displayname = "Pickup Run Sheet Items"
        on add = "Add Pickup Stop"
        on edit = "Update Pickup Stop"
    }
    success message = "Pickup stop saved successfully"
    Stop_Assignment
    (
        type = section
        displayname = "Stop Assignment"
        row = 1
        column = 0
    )
    must have Pickup_Run_Sheet
    (
        type = picklist
        displayname = "Pickup Run Sheet"
        values = Pickup_Run_Sheets.ID
        displayformat = [PRS_Number]
        searchable = true
        sortorder = ascending
        row = 1
        column = 1
        width = medium
    )
    must have Shipment
    (
        type = picklist
        displayname = "Shipment"
        values = Shipment_Requests[Shipment_Status == "Booked"].ID
        displayformat = [AWB_Number]
        searchable = true
        sortorder = ascending
        row = 1
        column = 2
        width = medium
    )
    must have Stop_Sequence
    (
        type = number
        displayname = "Stop Sequence"
        row = 1
        column = 1
        width = medium
    )
    must have Stop_Status
    (
        type = picklist
        displayname = "Stop Status"
        values = {"Assigned","Arrived","Picked Up","Failed","Cancelled"}
        initial value = "Assigned"
        row = 1
        column = 2
        width = medium
    )
    Pickup_Execution
    (
        type = section
        displayname = "Pickup Execution"
        visibility = true
        row = 2
        column = 1
    )
    Arrived_At
    (
        type = datetime
        displayname = "Arrived At"
        row = 2
        column = 1
        width = medium
    )
    Physical_Weight_Kg
    (
        type = decimal
        displayname = "Physical Weight (Kg)"
        decimalplace = 3
        row = 2
        column = 2
        width = medium
    )
    Revised_Charge
    (
        type = INR
        displayname = "Revised Charge"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 2
        column = 1
        width = medium
    )
    Customer_Approved_Revised_Charge
    (
        type = checkbox
        displayname = "Customer Approved Revised Charge"
        initial value = false
        row = 2
        column = 2
        width = medium
    )
    Pickup_OTP
    (
        type = text
        displayname = "Pickup OTP"
        maxchar = 8
        isencrypted = true
        personal data = true
        row = 2
        column = 1
        width = medium
    )
    Pickup_Signature
    (
        type = signature
        displayname = "Pickup Signature"
        personal data = true
        row = 2
        column = 2
        width = medium
    )
    Pickup_Outcome
    (
        type = section
        displayname = "Pickup Outcome"
        visibility = true
        row = 3
        column = 1
    )
    Failure_Reason
    (
        type = textarea
        displayname = "Failure Reason"
        height = 100px
        row = 3
        column = 1
        width = medium
    )
    Completed_At
    (
        type = datetime
        displayname = "Completed At"
        row = 3
        column = 2
        width = medium
    )
    Agent_Latitude
    (
        type = decimal
        displayname = "Agent Latitude"
        decimalplace = 6
        row = 3
        column = 1
        width = medium
    )
    Agent_Longitude
    (
        type = decimal
        displayname = "Agent Longitude"
        decimalplace = 6
        row = 3
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Add Stop"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Save Pickup Details"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}