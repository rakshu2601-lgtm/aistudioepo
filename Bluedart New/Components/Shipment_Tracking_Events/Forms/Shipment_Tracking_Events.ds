form Shipment_Tracking_Events
{
    title
    {
        displayname = "Shipment Tracking Events"
        on add = "Add Tracking Event"
        on edit = "Correct Tracking Event"
    }
    success message = "Shipment tracking event saved successfully"
    Event_Identity
    (
        type = section
        displayname = "Event Identity"
        row = 1
        column = 0
    )
    Tracking_Event_ID
    (
        type = autonumber
        displayname = "Tracking Event ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Shipment
    (
        type = picklist
        displayname = "Shipment"
        values = Shipment_Requests.ID
        displayformat = [AWB_Number]
        searchable = true
        sortorder = ascending
        row = 1
        column = 1
        width = medium
    )
    must have Event_Time
    (
        type = datetime
        displayname = "Event Time"
        initial value = "${zoho.currenttime}"
        row = 1
        column = 2
        width = medium
    )
    must have Event_Status
    (
        type = picklist
        displayname = "Event Status"
        values = {"Credit Hold","Booked - Hub Assignment Pending","Booked","Picked Up","Inbound at Branch Station","Bagged & Dispatched to Origin Hub","Sorted at Origin Hub","In Transit","Arrived at Destination Hub","At Delivery Hub","Out For Delivery (OFD)","Delivered","Delivery Failed - NDR","Return to Origin","Cancelled","Information","Exception"}
        row = 1
        column = 1
        width = medium
    )
    must have Source
    (
        type = picklist
        displayname = "Source"
        values = {"Booking","Pickup Scan","Hub Scan","Bag","Manifest","Delivery","NDR","RTO","System"}
        row = 1
        column = 2
        width = medium
    )
    Location_and_Custody
    (
        type = section
        displayname = "Location and Custody"
        visibility = true
        row = 2
        column = 1
    )
    Hub
    (
        type = picklist
        displayname = "Hub"
        values = Hubs.ID
        displayformat = [Hub_Name]
        searchable = true
        sortorder = ascending
        row = 2
        column = 1
        width = medium
    )
    Manifest
    (
        type = picklist
        displayname = "Manifest"
        values = Manifests.ID
        displayformat = [Manifest_Number]
        searchable = true
        sortorder = ascending
        row = 2
        column = 2
        width = medium
    )
    Bag
    (
        type = picklist
        displayname = "Bag"
        values = Logistics_Bags.ID
        displayformat = [Bag_Number]
        searchable = true
        sortorder = ascending
        row = 2
        column = 1
        width = medium
    )
    Agent
    (
        type = picklist
        displayname = "Agent"
        values = Operations_Users[Active == true].ID
        displayformat = [Employee_Name.first_name]
        searchable = true
        sortorder = ascending
        row = 2
        column = 2
        width = medium
    )
    Latitude
    (
        type = decimal
        displayname = "Latitude"
        decimalplace = 6
        row = 2
        column = 1
        width = medium
    )
    Longitude
    (
        type = decimal
        displayname = "Longitude"
        decimalplace = 6
        row = 2
        column = 2
        width = medium
    )
    Event_Details
    (
        type = section
        displayname = "Event Details"
        visibility = true
        row = 3
        column = 1
    )
    must have Event_Description
    (
        type = textarea
        displayname = "Event Description"
        height = 100px
        row = 3
        column = 1
        width = medium
    )
    Customer_Visible
    (
        type = checkbox
        displayname = "Customer Visible"
        initial value = true
        row = 3
        column = 2
        width = medium
    )
    Created_By_Email
    (
        type = email
        displayname = "Created By Email"
        personal data = true
        row = 3
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Add Event"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Save Correction"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}