default list COD_Remittance_Register
{
    displayName = "COD Remittances"
    show all rows from COD_Remittances
    (
        Remittance_Number
        Delivery_Run_Sheet
        Agent
        Hub
        Remittance_Date
        Expected_Amount
        Submitted_Amount
        Shortfall_Amount
        Remittance_Status
        Cashier_Email
        Confirmed_At
        Customer_Payout_Due_Date
        Notes
        custom action "Confirm Remittance"
        (
            workflow = Confirm_COD_Remittance
            show action for each record = true
            column header = "Confirm Remittance"
            success message = "COD remittance confirmation evaluated"
            condition = (Remittance_Status == "Pending" || Remittance_Status == "Shortfall")
            confirmation before execution
            (
                message for individual record = "Confirm the submitted cash against delivered COD items?"
                confirm button text = "Confirm Cash"
                cancel button text = "Cancel"
            )
        )
    )
    filters
    (
        Agent
        Hub
        Remittance_Date
        Remittance_Status
    )
    sort by
    (
        Remittance_Date descending
        Remittance_Number descending
    )
}
