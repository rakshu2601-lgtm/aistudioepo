list My_Payments
{
    displayName = "My Payments"
    show all rows from Payment_Transactions [Customer_Login_Email == zoho.loginuserid]
    (
        Payment_Transaction_ID
        Shipment
        Invoice
        Gateway
        Amount
        Payment_Method
        Payment_Status
        Initiated_At
        Completed_At
    )
    filters
    (
        Gateway
        Payment_Method
        Payment_Status
        Initiated_At
    )
    sort by
    (
        Initiated_At descending
        Payment_Transaction_ID descending
    )
    conditional formatting
    (
        "Payment Confirmed"
        {
            condition = (Payment_Status == "Success")
            fields = [Payment_Transaction_ID, Amount, Payment_Status, Completed_At]
            format = "background-color:#DCFCE7;color:#166534"
        }
        "Payment Failed"
        {
            condition = (Payment_Status == "Failed")
            fields = [Payment_Transaction_ID, Amount, Payment_Status, Completed_At]
            format = "background-color:#FEE2E2;color:#991B1B"
        }
    )
}