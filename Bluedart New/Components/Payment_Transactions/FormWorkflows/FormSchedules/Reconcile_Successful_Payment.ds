Reconcile_Successful_Payment as "Reconcile Successful Payment"
{
    type = schedule
    form = Payment_Transactions[Payment_Status == "Success"]
    start = after 1 minutes from Completed_At
    time zone = "Asia/Kolkata"
    description = "Completes idempotent ledger, invoice, shipment, communication, and audit processing after a native payment success event"

    on start
    {
        actions
        {
            on load
            (
                customer_record = Customers[ID == input.Customer];
                invoice_record = Invoices[ID == input.Invoice];
                shipment_record = Shipment_Requests[ID == input.Shipment];
                references_valid = customer_record.count(ID) > 0 && invoice_record.count(ID) > 0 && shipment_record.count(ID) > 0 && invoice_record.Customer == customer_record.ID && invoice_record.Shipment == shipment_record.ID && shipment_record.Customer == customer_record.ID;
                if(references_valid == false)
                {
                    input.Payment_Status = "Failed";
                    input.Gateway_Response_Summary = "Provider reported success, but internal customer, invoice, or shipment references failed reconciliation.";
                    input.Failure_Reason = "Internal reference validation failed; no ledger payment was posted.";
                    if(Audit_Log[Module_Name == "Payment Transactions" && Record_ID == input.ID.toString() && Action_Name == "Reject Payment Reconciliation"].count(ID) == 0)
                    {
                        audit_id = insert into Audit_Log
                        [
                            Event_Time = zoho.currenttime
                            Actor_Email = zoho.adminuserid
                            Actor_Profile = "Payment Gateway"
                            Action_Name = "Reject Payment Reconciliation"
                            Module_Name = "Payment Transactions"
                            Record_ID = input.ID.toString()
                            Before_Data = "Provider event=Success; Status=Initiated"
                            After_Data = "Status=Failed; Ledger posting=Blocked"
                            Source = "Payment"
                            Severity = "Critical"
                        ];
                    }
                }
                else
                {
                    payment_reference = if(ifnull(input.Gateway_Payment_ID,"").trim() != "",input.Gateway_Payment_ID,"CREATOR-PAY-" + input.ID);
                    existing_payment_ledger = Account_Ledger[Payment_Reference == payment_reference && Transaction_Type == "Payment"];
                    if(existing_payment_ledger.count(ID) == 0)
                    {
                        ledger_id = insert into Account_Ledger
                        [
                            Customer = customer_record.ID
                            Shipment = shipment_record.ID
                            Invoice = invoice_record.ID
                            Transaction_Type = "Payment"
                            Amount = input.Amount
                            Transaction_Date = zoho.currenttime
                            Ledger_Status = "Settled"
                            Ageing_Bucket = "Not Applicable"
                            Payment_Reference = payment_reference
                            Notes = "Payment posted only after Zoho Creator received the native payment success event."
                            Posted_By_Email = zoho.adminuserid
                            Customer_Login_Email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID)
                        ];
                        input.Ledger_Entry = ledger_id;
                    }
                    else
                    {
                        input.Ledger_Entry = existing_payment_ledger.ID;
                    }
                    input.Gateway_Payment_ID = payment_reference;
                    input.Gateway_Response_Summary = "Verified by Zoho Creator native payment success event; sensitive provider response data was not stored.";
                    input.Failure_Reason = "";
                    verified_paid_total = ifnull(Account_Ledger[Invoice == invoice_record.ID && Transaction_Type == "Payment"].sum(Amount),0);
                    if(verified_paid_total + 0.01 >= ifnull(invoice_record.Invoice_Total,0))
                    {
                        invoice_record.Invoice_Status = "Paid";
                        shipment_record.Payment_Status = "Paid";
                    }
                    else
                    {
                        invoice_record.Invoice_Status = "Part Paid";
                        shipment_record.Payment_Status = "Pending";
                    }
                    for each debit_record in Account_Ledger[Invoice == invoice_record.ID && Transaction_Type == "Debit"]
                    {
                        debit_record.Ledger_Status = if(verified_paid_total + 0.01 >= debit_record.Amount,"Settled","Partially Settled");
                        debit_record.Notes = ifnull(debit_record.Notes,"") + " | Verified payments total INR " + verified_paid_total + ".";
                    }
                    recalculated_outstanding = thisapp.Recalculate_Customer_Outstanding(customer_record.ID);
                    if(customer_record.Onboarding_Status == "Active" && (customer_record.KYC_Expiry_Date == null || customer_record.KYC_Expiry_Date >= zoho.currentdate))
                    {
                        projected_exposure = recalculated_outstanding;
                        held_shipments = Shipment_Requests[Customer == customer_record.ID && Shipment_Status == "Credit Hold" && Credit_Check_Status == "Hold"] sort by Booked_On range from 0 to 199;
                        for each held_shipment in held_shipments
                        {
                            proposed_exposure = projected_exposure + ifnull(held_shipment.Total_Payable,0);
                            if(proposed_exposure <= ifnull(customer_record.Approved_Credit_Limit,0))
                            {
                                held_shipment.Credit_Check_Status = "Passed";
                                held_shipment.Shipment_Status = if(held_shipment.Collection_Center == null,"Booked - Hub Assignment Pending","Booked");
                                projected_exposure = proposed_exposure;
                                tracking_id = insert into Shipment_Tracking_Events
                                [
                                    Shipment = held_shipment.ID
                                    Event_Time = zoho.currenttime
                                    Event_Status = held_shipment.Shipment_Status
                                    Hub = held_shipment.Current_Hub
                                    Event_Description = "Credit hold released after verified payment reduced account exposure."
                                    Source = "Account Ledger"
                                    Customer_Visible = true
                                    Created_By_Email = zoho.adminuserid
                                ];
                            }
                        }
                    }
                    recipient_email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID);
                    confirmation_summary = "Payment transaction " + input.ID + " was verified for INR " + input.Amount + "; reference " + payment_reference + ".";
                    if(Communication_Log[Customer == customer_record.ID && Template_Code == "PAYMENT_CONFIRMED" && Message_Summary == confirmation_summary].count(ID) == 0)
                    {
                        communication_id = insert into Communication_Log
                        [
                            Customer = customer_record.ID
                            Shipment = shipment_record.ID
                            Recipient = recipient_email
                            Channel = "Email"
                            Template_Code = "PAYMENT_CONFIRMED"
                            Subject = "Payment confirmed for invoice INV-" + invoice_record.Invoice_Number
                            Message_Summary = confirmation_summary
                            Provider = "Zoho Mail"
                            Communication_Status = "Sent"
                            Attempt_Count = 1
                            Last_Attempt_At = zoho.currenttime
                        ];
                        sendmail
                        [
                            from: zoho.adminuserid
                            to: recipient_email
                            subject: "Payment confirmed for invoice INV-" + invoice_record.Invoice_Number
                            message: "We verified your payment of INR " + input.Amount + " for AWB " + shipment_record.AWB_Number + ". Payment reference: " + payment_reference + "."
                        ]
                    }
                    if(Audit_Log[Module_Name == "Payment Transactions" && Record_ID == input.ID.toString() && Action_Name == "Verify Payment"].count(ID) == 0)
                    {
                        audit_id = insert into Audit_Log
                        [
                            Event_Time = zoho.currenttime
                            Actor_Email = zoho.adminuserid
                            Actor_Profile = "Payment Gateway"
                            Action_Name = "Verify Payment"
                            Module_Name = "Payment Transactions"
                            Record_ID = input.ID.toString()
                            Before_Data = "Status=Initiated; Invoice Status=" + invoice_record.Invoice_Status
                            After_Data = "Status=Success; Reference=" + payment_reference + "; Paid total=" + verified_paid_total + "; Outstanding=" + recalculated_outstanding
                            Source = "Payment"
                            Severity = "Critical"
                        ];
                    }
                }
            )
        }
    }
}
