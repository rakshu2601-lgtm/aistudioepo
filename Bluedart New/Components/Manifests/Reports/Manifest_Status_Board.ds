kanban Manifest_Status_Board
{
    displayName = "Manifest Status Board"
    show all rows from Manifests
    (
        Manifest_Number
        Manifest_Type
        Origin_Hub
        Destination_Hub
        Vehicle
        Driver
        Departure_Time
        Expected_Arrival_Time
        Manifest_Status
        Total_Bags
        Total_Shipments
        Total_Weight_Kg
    )
    filters
    (
        Manifest_Type
        Origin_Hub
        Destination_Hub
        Vehicle
        Driver
        Departure_Time
        Manifest_Status
    )
    sort by
    (
        Departure_Time descending
    )
    options
    (
        display field = Manifest_Status
        filter type = manual
        sort order = custom
        record count = enable
    )
}