Manifests_Origin_Hub_Input as "Refresh Manifest Resources"
{
    type = form
    form = Manifests
    record event = on add or edit
    description = "Refreshes compatible destinations, vehicles, and drivers for the selected origin hub"

    on user input of Origin_Hub
    {
        actions
        {
            custom deluge script
            (
                clear Destination_Hub;
                clear Route;
                clear Vehicle;
                clear Driver;
                if(input.Manifest_Type == "Feeder" && input.Origin_Hub != null)
                {
                    origin_record = Hubs[ID == input.Origin_Hub];
                    Destination_Hub:ui.add(Hubs[ID == origin_record.Parent_Sorting_Hub && Active == true].ID.getall());
                }
                else if(input.Manifest_Type == "Linehaul")
                {
                    Destination_Hub:ui.add(Hubs[Hub_Type == "Sorting Hub" && Active == true && ID != input.Origin_Hub].ID.getall());
                }
                else if(input.Manifest_Type == "Delivery Feeder" && input.Origin_Hub != null)
                {
                    Destination_Hub:ui.add(Hubs[Hub_Type == "Collection Center" && Parent_Sorting_Hub == input.Origin_Hub && Active == true].ID.getall());
                }
                else
                {
                    Destination_Hub:ui.add(Hubs[Active == true && ID != input.Origin_Hub].ID.getall());
                }
                if(input.Origin_Hub != null)
                {
                    Vehicle:ui.add(Vehicles[Owning_Hub == input.Origin_Hub && Active == true && Status == "Available"].ID.getall());
                    Driver:ui.add(Operations_Users[Active == true && Application_Role == "Field Agent" && ((Deputed_Hub == input.Origin_Hub && (Deputation_Start_Date == null || Deputation_Start_Date <= zoho.currentdate) && (Deputation_End_Date == null || Deputation_End_Date >= zoho.currentdate)) || (Home_Hub == input.Origin_Hub && (Deputed_Hub == null || (Deputation_Start_Date != null && Deputation_Start_Date > zoho.currentdate) || (Deputation_End_Date != null && Deputation_End_Date < zoho.currentdate))))].ID.getall());
                }
            )
        }
    }
}