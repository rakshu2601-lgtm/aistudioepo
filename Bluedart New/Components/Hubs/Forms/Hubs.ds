form Hubs
{
    title
    {
        displayname = "Hub Master"
        on add = "Add Hub"
        on edit = "Edit Hub"
    }
    success message = "Hub saved successfully"
    Hub_Identity
    (
        type = section
        displayname = "Hub Identity"
        row = 1
        column = 0
    )
    must have unique Hub_ID
    (
        type = text
        displayname = "Hub ID"
        row = 1
        column = 1
        width = medium
    )
    must have Hub_Name
    (
        type = text
        displayname = "Hub Name"
        row = 1
        column = 2
        width = medium
    )
    must have Hub_Type
    (
        type = radiobuttons
        displayname = "Hub Type"
        values = {"Collection Center","Sorting Hub"}
        layout = 2
        row = 1
        column = 1
        width = medium
    )
    Parent_Sorting_Hub
    (
        type = picklist
        displayname = "Parent Sorting Hub"
        values = Hubs.ID
        displayformat = [Hub_Name]
        sortorder = ascending
        row = 1
        column = 2
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    Location_Details
    (
        type = section
        displayname = "Location Details"
        visibility = true
        row = 2
        column = 1
    )
    must have Hub_Address
    (
        type = address
        displayname = "Hub Address"
        capture_coordinates = true
        adjust_using_map = true
        address_line_1
        (
            type = address_line_1
            displayname = "Address Line 1"
        )
        address_line_2
        (
            type = address_line_2
            displayname = "Address Line 2"
        )
        district_city
        (
            type = district_city
            displayname = "City / District"
        )
        state_province
        (
            type = state_province
            displayname = "State"
        )
        postal_Code
        (
            type = postal_Code
            displayname = "Pincode"
        )
        country
        (
            type = country
            displayname = "Country"
        )
        latitude
        (
            type = latitude
            displayname = "Latitude"
            visibility = false
        )
        longitude
        (
            type = longitude
            displayname = "Longitude"
            visibility = false
        )
        row = 2
        column = 1
        width = medium
    )
    Latitude
    (
        type = decimal
        displayname = "Latitude"
        decimalplace = 6
        row = 2
        column = 2
        width = medium
    )
    Longitude
    (
        type = decimal
        displayname = "Longitude"
        decimalplace = 6
        row = 2
        column = 2
        width = medium
    )
    Operating_Details
    (
        type = section
        displayname = "Operating Details"
        visibility = true
        row = 3
        column = 1
    )
    must have Operating_Start_Time
    (
        type = time
        displayname = "Operating Start Time"
        row = 3
        column = 1
        width = medium
    )
    must have Operating_End_Time
    (
        type = time
        displayname = "Operating End Time"
        row = 3
        column = 2
        width = medium
    )
    must have Cut_Off_Time
    (
        type = time
        displayname = "Cut-off Time"
        row = 3
        column = 1
        width = medium
    )
    must have Daily_Capacity
    (
        type = number
        displayname = "Daily Capacity"
        row = 3
        column = 2
        width = medium
    )
    Contact_Details
    (
        type = section
        displayname = "Contact Details"
        visibility = true
        row = 4
        column = 1
    )
    Contact_Name
    (
        type = text
        displayname = "Contact Name"
        row = 4
        column = 1
        width = medium
    )
    Contact_Email
    (
        type = email
        displayname = "Contact Email"
        row = 4
        column = 2
        width = medium
    )
    Contact_Phone
    (
        type = phonenumber
        displayname = "Contact Phone"
        allowedcountries = {in}
        defaultcountry = "in"
        row = 4
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Hub"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Hub"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}