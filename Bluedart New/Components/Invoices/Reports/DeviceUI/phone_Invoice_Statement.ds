report Invoice_Statement
{
    quickview
    (
        layout ( type = -1 datablock1 ( layout type = -1 fields ( Invoice_Number Invoice_Date Invoice_Total Due_Date Invoice_Status "Issue Invoice" "Pay Now" "Void Invoice" ) ) )
        menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) )
        action ( on tap ( View Record ) on long press ( Edit Delete Duplicate View Record ) on left swipe ( Delete ) on right swipe ( Edit ) )
    )
    detailview
    (
        layout ( type = 1 datablock1 ( layout type = -2 fields ( Invoice_Number Shipment Customer Invoice_Date Invoice_Total Payment_Terms Due_Date Invoice_Status Invoice_Download_URL "Issue Invoice" "Pay Now" "Void Invoice" ) ) )
        menu ( header ( Edit Duplicate Delete ) )
    )
}