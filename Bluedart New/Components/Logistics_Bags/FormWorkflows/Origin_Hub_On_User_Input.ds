Logistics_Bags_Origin_Hub_Input as "Refresh Bag Destinations"
{
    type = form
    form = Logistics_Bags
    record event = on add or edit
    description = "Refreshes compatible destination choices when the origin hub changes"

    on user input of Origin_Hub
    {
        actions
        {
            custom deluge script
            (
                clear Destination_Hub;
                if(input.Bag_Type == "Feeder" && input.Origin_Hub != null)
                {
                    origin_record = Hubs[ID == input.Origin_Hub];
                    Destination_Hub:ui.add(Hubs[ID == origin_record.Parent_Sorting_Hub && Active == true].ID.getall());
                }
                else if(input.Bag_Type == "Master")
                {
                    Destination_Hub:ui.add(Hubs[Hub_Type == "Sorting Hub" && Active == true && ID != input.Origin_Hub].ID.getall());
                }
                else if(input.Bag_Type == "Delivery Feeder" && input.Origin_Hub != null)
                {
                    Destination_Hub:ui.add(Hubs[Hub_Type == "Collection Center" && Parent_Sorting_Hub == input.Origin_Hub && Active == true].ID.getall());
                }
                else
                {
                    Destination_Hub:ui.add(Hubs[Active == true && ID != input.Origin_Hub].ID.getall());
                }
            )
        }
    }
}