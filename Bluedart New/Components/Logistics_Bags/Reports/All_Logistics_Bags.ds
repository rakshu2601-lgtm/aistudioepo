default list All_Logistics_Bags
{
    displayName = "All Logistics Bags"
    show all rows from Logistics_Bags
    (
        Bag_Number
        Bag_Type
        Origin_Hub
        Destination_Hub
        Seal_Code
        Bag_Status
        Total_Shipments
        Total_Weight_Kg
        Created_At
        Sealed_At
        Dispatched_At
        Received_At
        Created_By_Email
        Notes
        custom action "Close & Seal"
        (
            workflow = Close_Seal_All_Logistics_Bags
            show action for each record = true
            column header = "Close & Seal"
            success message = "Bag seal evaluated"
            condition = (Bag_Status == "Open")
        )
        custom action "Dispatch Bag"
        (
            workflow = Dispatch_Bag
            show action for each record = true
            column header = "Dispatch"
            success message = "Bag dispatch evaluated"
            condition = (Bag_Status == "Sealed")
            confirmation before execution
            (
                message for individual record = "Dispatch this sealed bag and update all loaded shipments?"
                confirm button text = "Dispatch Bag"
                cancel button text = "Cancel"
            )
        )
        custom action "Receive Bag"
        (
            workflow = Receive_Bag
            show action for each record = true
            column header = "Receive"
            success message = "Bag receipt evaluated"
            condition = (Bag_Status == "Dispatched")
        )
        custom action "Unseal Bag"
        (
            workflow = Unseal_Bag
            show action for each record = true
            column header = "Unseal"
            success message = "Bag unsealing evaluated"
            condition = (Bag_Status == "Received")
        )
        custom action "Report Seal Exception"
        (
            workflow = Report_Bag_Seal_Exception
            show action for each record = true
            column header = "Exception"
            success message = "Bag exception evaluated"
            condition = (Bag_Status == "Dispatched" || Bag_Status == "Received")
        )
    )
    filters
    (
        Bag_Type
        Origin_Hub
        Destination_Hub
        Bag_Status
        Created_At
    )
    sort by
    (
        Created_At descending
    )
}