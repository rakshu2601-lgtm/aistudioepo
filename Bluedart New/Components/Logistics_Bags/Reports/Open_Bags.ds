list Open_Bags
{
    displayName = "Open Bags"
    show all rows from Logistics_Bags [Bag_Status == "Open"]
    (
        Bag_Number
        Bag_Type
        Origin_Hub
        Destination_Hub
        Total_Shipments
        Total_Weight_Kg
        Created_At
        Notes
        custom action "Close & Seal"
        (
            workflow = Close_Seal_Bag
            show action for each record = true
            column header = "Close & Seal"
            success message = "Bag seal evaluated"
            condition = (Bag_Status == "Open")
        )
    )
    filters
    (
        Bag_Type
        Origin_Hub
        Destination_Hub
        Created_At
    )
    sort by
    (
        Created_At descending
    )
}