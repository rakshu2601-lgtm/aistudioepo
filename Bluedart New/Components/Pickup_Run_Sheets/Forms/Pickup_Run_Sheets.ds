form Pickup_Run_Sheets
{
    title
    {
        displayname = "Pickup Run Sheets"
        on add = "Plan Pickup Run"
        on edit = "Edit Pickup Run"
    }
    success message = "Pickup run sheet saved successfully"
    Run_Identity
    (
        type = section
        displayname = "Run Identity"
        row = 1
        column = 0
    )
    PRS_Number
    (
        type = autonumber
        displayname = "PRS Number"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Hub
    (
        type = picklist
        displayname = "Hub"
        values = Hubs[Active == true].ID
        displayformat = [Hub_Name]
        searchable = true
        sortorder = ascending
        row = 1
        column = 1
        width = medium
    )
    must have Assigned_Agent
    (
        type = picklist
        displayname = "Assigned Agent"
        values = Operations_Users[Active == true && Application_Role == "Field Agent" && (Agent_Role == "Pickup" || Agent_Role == "Both")].ID
        displayformat = [Employee_Name.first_name]
        searchable = true
        sortorder = ascending
        row = 1
        column = 2
        width = medium
    )
    must have Run_Date
    (
        type = date
        displayname = "Run Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    must have Beat_Name
    (
        type = text
        displayname = "Beat Name"
        row = 1
        column = 2
        width = medium
    )
    Vehicle
    (
        type = picklist
        displayname = "Vehicle"
        values = Vehicles[Active == true && Status == "Available"].ID
        displayformat = [Vehicle_Number]
        searchable = true
        sortorder = ascending
        row = 1
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Draft","Released","In Progress","Completed","Cancelled"}
        initial value = "Draft"
        row = 1
        column = 2
        width = medium
    )
    Run_Progress
    (
        type = section
        displayname = "Run Progress"
        visibility = true
        row = 2
        column = 1
    )
    Planned_Stop_Count
    (
        type = number
        displayname = "Planned Stop Count"
        initial value = 0
        row = 2
        column = 1
        width = medium
    )
    Completed_Stop_Count
    (
        type = number
        displayname = "Completed Stop Count"
        initial value = 0
        row = 2
        column = 2
        width = medium
    )
    Total_Planned_Weight_Kg
    (
        type = decimal
        displayname = "Total Planned Weight (Kg)"
        decimalplace = 3
        initial value = 0
        row = 2
        column = 1
        width = medium
    )
    Released_At
    (
        type = datetime
        displayname = "Released At"
        row = 2
        column = 2
        width = medium
    )
    Completed_At
    (
        type = datetime
        displayname = "Completed At"
        row = 2
        column = 1
        width = medium
    )
    Notes
    (
        type = section
        displayname = "Supervisor Notes"
        visibility = true
        row = 3
        column = 1
    )
    Supervisor_Notes
    (
        type = textarea
        displayname = "Supervisor Notes"
        height = 100px
        row = 3
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Draft"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Draft"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}