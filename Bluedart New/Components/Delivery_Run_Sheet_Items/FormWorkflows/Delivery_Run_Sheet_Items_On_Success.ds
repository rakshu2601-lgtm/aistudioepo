Delivery_Run_Sheet_Items_On_Success as "Reconcile Delivery Run Stop Totals"
{
    type = form
    form = Delivery_Run_Sheet_Items
    record event = on add or edit
    description = "Refreshes delivery run aggregates and audits delivery stop assignment or evidence updates"

    on success
    {
        actions
        {
            custom deluge script
            (
                run_record = Delivery_Run_Sheets[ID == input.Delivery_Run_Sheet];
                planned_count = 0;
                delivered_count = 0;
                failed_count = 0;
                expected_cod = 0.0;
                collected_cod = 0.0;
                for each run_item in Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.Delivery_Run_Sheet]
                {
                    planned_count = planned_count + 1;
                    shipment_record = Shipment_Requests[ID == run_item.Shipment];
                    if(shipment_record.Payment_Type == "COD")
                    {
                        expected_cod = expected_cod + ifnull(shipment_record.COD_Amount,0);
                    }
                    if(run_item.Delivery_Status == "Delivered")
                    {
                        delivered_count = delivered_count + 1;
                        collected_cod = collected_cod + ifnull(run_item.COD_Collected,0);
                    }
                    else if(run_item.Delivery_Status == "Failed" || run_item.Delivery_Status == "RTO")
                    {
                        failed_count = failed_count + 1;
                    }
                }
                run_record.Planned_Stop_Count = planned_count;
                run_record.Delivered_Count = delivered_count;
                run_record.Failed_Count = failed_count;
                run_record.Expected_COD_Amount = expected_cod;
                run_record.Collected_COD_Amount = collected_cod;
                current_profile = thisapp.permissions.loginUserProfile();
                audit_id = insert into Audit_Log
                [
                    Event_Time = zoho.currenttime
                    Actor_Email = zoho.loginuserid
                    Actor_Profile = current_profile
                    Action_Name = "Save Delivery Stop"
                    Module_Name = "Delivery Run Sheet Items"
                    Record_ID = input.ID.toString()
                    After_Data = "Run=" + input.Delivery_Run_Sheet + "; Shipment=" + input.Shipment + "; Stop=" + input.Stop_Sequence + "; Status=" + input.Delivery_Status + "; Attempt=" + input.Attempt_Number
                    Source = "Form Workflow"
                    Severity = "Info"
                ];
            )
        }
    }
}
