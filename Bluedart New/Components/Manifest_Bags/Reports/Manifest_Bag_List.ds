default list Manifest_Bag_List
{
    displayName = "Manifest Bag List"
    show all rows from Manifest_Bags
    (
        Manifest
        Manifest_Type
        Bag
        Load_Status
        Loaded_At
        Received_At
        Seal_Verified
        Exception_Photo
        Exception_Notes
        custom action "Load Bag"
        (
            workflow = Load_Manifest_Bag
            show action for each record = true
            column header = "Load Bag"
            success message = "Bag loading evaluated"
            condition = (Load_Status == "Expected")
        )
        custom action "Receive Bag"
        (
            workflow = Receive_Bag_Manifest_Bag_List
            show action for each record = true
            column header = "Receive Bag"
            success message = "Bag receipt evaluated"
            condition = (Load_Status == "Loaded")
        )
        custom action "Mark Missing"
        (
            workflow = Mark_Missing_Manifest_Bag_List
            show action for each record = true
            column header = "Mark Missing"
            success message = "Missing-bag reconciliation evaluated"
            condition = (Load_Status == "Loaded")
            confirmation before execution
            (
                message for individual record = "Mark this expected bag missing? A photo and notes must already be attached."
                confirm button text = "Mark Missing"
                cancel button text = "Cancel"
            )
        )
        custom action "Mark Damaged"
        (
            workflow = Mark_Damaged_Manifest_Bag_List
            show action for each record = true
            column header = "Mark Damaged"
            success message = "Damaged-bag reconciliation evaluated"
            condition = (Load_Status == "Loaded")
        )
        custom action "Mark Short"
        (
            workflow = Mark_Short_Manifest_Bag_List
            show action for each record = true
            column header = "Mark Short"
            success message = "Short-bag reconciliation evaluated"
            condition = (Load_Status == "Loaded")
        )
    )
    filters
    (
        Manifest
        Manifest_Type
        Bag
        Load_Status
        Loaded_At
        Received_At
        Seal_Verified
    )
    sort by
    (
        Loaded_At descending
    )
}