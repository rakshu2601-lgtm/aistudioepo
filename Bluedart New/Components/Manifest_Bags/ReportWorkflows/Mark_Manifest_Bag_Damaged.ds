Mark_Manifest_Bag_Damaged as "Mark Damaged - Expected Master Bags"
{
    type = functions
    form = Manifest_Bags
    execution type = for each record
    description = "Records a damaged bag with mandatory evidence and quarantines the manifest"

    on start
    {
        actions
        {
            on click
            (
                current_profile = "POC Process User";
                manifest_record = Manifests[ID == input.Manifest];
                bag_record = Logistics_Bags[ID == input.Bag];
                logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
                deputation_active = logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate);
                effective_hub = logged_user.Home_Hub;
                if(deputation_active == true)
                {
                    effective_hub = logged_user.Deputed_Hub;
                }
                authorised = logged_user.count(ID) > 0 && effective_hub == manifest_record.Destination_Hub;
                if(authorised == false)
                {
                    info "Only an active operations user at the destination hub can report a damaged bag.";
                }
                else if((manifest_record.Manifest_Status != "Arrived" && manifest_record.Manifest_Status != "Exception") || input.Load_Status != "Loaded")
                {
                    info "Only an unresolved loaded bag on an arrived manifest can be marked damaged.";
                }
                else if(input.Exception_Photo == null || ifnull(input.Exception_Notes,"").trim() == "")
                {
                    info "Edit this checklist row and attach an exception photo and notes before marking the bag damaged.";
                }
                else
                {
                    input.Load_Status = "Damaged";
                    input.Received_At = zoho.currenttime;
                    bag_record.Bag_Status = "Exception";
                    manifest_record.Manifest_Status = "Exception";
                    exception_id = insert into Shipment_Exceptions
                    [
                        Bag = input.Bag
                        Manifest = input.Manifest
                        Exception_Type = "Damaged"
                        Severity = "High"
                        Reporting_Hub = manifest_record.Destination_Hub
                        Reported_By_Email = zoho.loginuserid
                        Reported_At = zoho.currenttime
                        Evidence_Photo = input.Exception_Photo
                        Notes = input.Exception_Notes
                        Exception_Status = "Open"
                    ];
                    audit_id = insert into Audit_Log
                    [
                        Event_Time = zoho.currenttime
                        Actor_Email = zoho.loginuserid
                        Actor_Profile = current_profile
                        Action_Name = "Mark Manifest Bag Damaged"
                        Module_Name = "Manifest Bags"
                        Record_ID = input.ID.toString()
                        Before_Data = "Status=Loaded"
                        After_Data = "Status=Damaged; Manifest=Exception; Exception=" + exception_id
                        Source = "Report Action"
                        Severity = "Critical"
                    ];
                }
            )
        }
    }
}