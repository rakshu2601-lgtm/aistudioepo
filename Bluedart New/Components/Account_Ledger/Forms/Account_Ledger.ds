form Account_Ledger
{
    title
    {
        displayname = "Account Ledger"
        on add = "Post Ledger Entry"
        on edit = "Review Ledger Entry"
    }
    success message = "Ledger entry saved successfully"

    Ledger_Identity
    (
        type = section
        displayname = "Ledger Identity"
        row = 1
        column = 0
    )
    Ledger_Entry_ID
    (
        type = autonumber
        displayname = "Ledger Entry ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Customer
    (
        type = picklist
        displayname = "Customer"
        values = Customers.ID
        displayformat = [Customer_ID]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Shipment
    (
        type = picklist
        displayname = "Shipment"
        values = Shipment_Requests.ID
        displayformat = [AWB_Number]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Invoice
    (
        type = picklist
        displayname = "Invoice"
        values = Invoices.ID
        displayformat = [Invoice_Number]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Transaction_Type
    (
        type = picklist
        displayname = "Transaction Type"
        values = {"Debit","Credit","Payment","COD Settlement","Rebate","Refund","Adjustment"}
        row = 1
        column = 2
        width = medium
    )

    Amount_and_Status
    (
        type = section
        displayname = "Amount and Status"
        visibility = true
        row = 2
        column = 1
    )
    must have Amount
    (
        type = INR
        displayname = "Amount"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 2
        column = 1
        width = medium
    )
    must have Transaction_Date
    (
        type = datetime
        displayname = "Transaction Date"
        initial value = "${zoho.currenttime}"
        row = 2
        column = 2
        width = medium
    )
    Due_Date
    (
        type = date
        displayname = "Due Date"
        row = 2
        column = 1
        width = medium
    )
    must have Ledger_Status
    (
        type = picklist
        displayname = "Ledger Status"
        values = {"Open","Partially Settled","Settled","Overdue"}
        initial value = "Open"
        row = 2
        column = 2
        width = medium
    )
    must have Ageing_Bucket
    (
        type = picklist
        displayname = "Ageing Bucket"
        values = {"Current","1-30 Days","31-60 Days","61-90 Days","90+ Days","Not Applicable"}
        initial value = "Not Applicable"
        row = 2
        column = 1
        width = medium
    )

    Reference_and_Ownership
    (
        type = section
        displayname = "Reference and Ownership"
        visibility = true
        row = 3
        column = 1
    )
    Payment_Reference
    (
        type = text
        displayname = "Payment Reference"
        maxchar = 100
        row = 3
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 100px
        row = 3
        column = 2
        width = medium
    )
    Posted_By_Email
    (
        type = email
        displayname = "Posted By Email"
        row = 3
        column = 1
        width = medium
    )
    Customer_Login_Email
    (
        type = email
        displayname = "Customer Login Email"
        personal data = true
        row = 3
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Post Entry"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Status"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}