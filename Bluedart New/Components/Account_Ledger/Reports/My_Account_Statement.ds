list My_Account_Statement
{
    displayName = "My Account Statement"
    show all rows from Account_Ledger [Customer_Login_Email == zoho.loginuserid]
    (
        Ledger_Entry_ID
        Shipment
        Invoice
        Transaction_Type
        Amount
        (
            display = total
        )
        Transaction_Date
        Due_Date
        Ledger_Status
        Ageing_Bucket
        Payment_Reference
        Notes
        Customer_Login_Email
    )
    filters
    (
        Transaction_Type
        Transaction_Date
        Due_Date
        Ledger_Status
        Ageing_Bucket
        "Open Entries" : (Ledger_Status == "Open" || Ledger_Status == "Partially Settled" || Ledger_Status == "Overdue")
    )
    sort by
    (
        Transaction_Date descending
        Ledger_Entry_ID descending
    )
    conditional formatting
    (
        "Payment Due"
        {
            condition = (Ledger_Status == "Overdue")
            fields = [Invoice, Amount, Due_Date, Ledger_Status, Ageing_Bucket]
            format = "background-color:#FFF1F2;color:#9F1239;font-weight:bold"
        }
    )
}