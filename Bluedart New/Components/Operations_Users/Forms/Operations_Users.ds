form Operations_Users
{
    title
    {
        displayname = "Operations Users"
        on add = "Add Operations User"
        on edit = "Edit Operations User"
    }
    success message = "Operations user saved successfully"
    Employee_Identity
    (
        type = section
        displayname = "Employee Identity"
        row = 1
        column = 0
    )
    must have unique Employee_ID
    (
        type = text
        displayname = "Employee ID"
        row = 1
        column = 1
        width = medium
    )
    must have Employee_Name
    (
        type = name
        displayname = "Employee Name"
        personal data = true
        prefix
        (
            type = prefix
            displayname = "Title"
            value = {"Mr.","Ms.","Mrs.","Dr."}
        )
        first_name
        (
            type = first_name
            displayname = "First Name"
        )
        last_name
        (
            type = last_name
            displayname = "Last Name"
        )
        suffix
        (
            type = suffix
            displayname = "Suffix"
            visibility = false
        )
        row = 1
        column = 2
        width = medium
    )
    must have unique Work_Email
    (
        type = email
        displayname = "Work Email"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    must have Mobile_Number
    (
        type = phonenumber
        displayname = "Mobile Number"
        allowedcountries = {in}
        defaultcountry = "in"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    Role_and_Hub
    (
        type = section
        displayname = "Role and Hub"
        visibility = true
        row = 2
        column = 1
    )
    must have Application_Role
    (
        type = picklist
        displayname = "Application Role"
        values = {"Operations Manager","KYC Reviewer","Hub Supervisor","Hub Operator","Field Agent","Finance Officer"}
        row = 2
        column = 1
        width = medium
    )
    Home_Hub
    (
        type = picklist
        displayname = "Home Hub"
        values = Hubs[Active == true].ID
        displayformat = [Hub_Name]
        searchable = true
        sortorder = ascending
        row = 2
        column = 2
        width = medium
    )
    Agent_Assignment
    (
        type = section
        displayname = "Agent Assignment"
        visibility = true
        row = 3
        column = 1
    )
    must have Agent_Role
    (
        type = picklist
        displayname = "Agent Role"
        values = {"Pickup","Delivery","Both","Not Applicable"}
        initial value = "Not Applicable"
        row = 3
        column = 1
        width = medium
    )
    Assigned_Beat
    (
        type = text
        displayname = "Assigned Beat"
        row = 3
        column = 2
        width = medium
    )
    Assigned_Pincodes
    (
        type = textarea
        displayname = "Assigned Pincodes"
        height = 100px
        row = 3
        column = 1
        width = medium
    )
    Vehicle_Type
    (
        type = picklist
        displayname = "Vehicle Type"
        values = {"Bike","Van","Truck","Other"}
        row = 3
        column = 2
        width = medium
    )
    Maximum_Daily_Load_Kg
    (
        type = decimal
        displayname = "Maximum Daily Load (Kg)"
        decimalplace = 2
        row = 3
        column = 1
        width = medium
    )
    Deputation_and_Location
    (
        type = section
        displayname = "Deputation and Location"
        visibility = true
        row = 4
        column = 1
    )
    Deputed_Hub
    (
        type = picklist
        displayname = "Deputed Hub"
        values = Hubs[Active == true].ID
        displayformat = [Hub_Name]
        searchable = true
        sortorder = ascending
        row = 4
        column = 1
        width = medium
    )
    Deputation_Start_Date
    (
        type = date
        displayname = "Deputation Start Date"
        row = 4
        column = 2
        width = medium
    )
    Deputation_End_Date
    (
        type = date
        displayname = "Deputation End Date"
        row = 4
        column = 1
        width = medium
    )
    Current_Latitude
    (
        type = decimal
        displayname = "Current Latitude"
        decimalplace = 6
        row = 4
        column = 2
        width = medium
    )
    Current_Longitude
    (
        type = decimal
        displayname = "Current Longitude"
        decimalplace = 6
        row = 4
        column = 1
        width = medium
    )
    Last_Location_At
    (
        type = datetime
        displayname = "Last Location At"
        mins_displayinterval = 5
        row = 4
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save User"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update User"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}