			Loyalty_Tiers_On_Validate as "Validate Loyalty Tier"
			{
			    type = form
			    form = Loyalty_Tiers
			    record event = on add or edit
			    description = "Validates ordered, non-overlapping quarterly qualification bands and nonnegative benefits"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                existing_tier = Loyalty_Tiers[ID == input.ID];
			                if(current_profile != "Logistics_Administrator" && current_profile != "Finance_Officer")
			                {
			                    alert "Only Logistics Administrators and Finance Officers can maintain loyalty tiers.";
			                    cancel submit;
			                }
			                else if(ifnull(input.Minimum_Quarterly_Spend,0) < 0 || (input.Maximum_Quarterly_Spend != null && input.Maximum_Quarterly_Spend < 0) || ifnull(input.Points_Multiplier,0) < 0 || ifnull(input.Credit_Rebate_Percent,0) < 0)
			                {
			                    alert "Spend thresholds, point multipliers, and rebate percentages cannot be negative.";
			                    cancel submit;
			                }
			                else if(input.Maximum_Quarterly_Spend != null && input.Maximum_Quarterly_Spend < input.Minimum_Quarterly_Spend)
			                {
			                    alert "Maximum quarterly spend cannot be lower than minimum quarterly spend.";
			                    cancel submit;
			                }
			                else if(input.Credit_Rebate_Percent > 100)
			                {
			                    alert "Credit rebate percent cannot exceed 100.";
			                    cancel submit;
			                }
			                else if(ifnull(input.Display_Order,0) <= 0)
			                {
			                    alert "Display order must be greater than zero.";
			                    cancel submit;
			                }
			                else if(input.ID != null && existing_tier.Tier_Name != input.Tier_Name)
			                {
			                    alert "Tier name is immutable after creation.";
			                    cancel submit;
			                }
			                else if((input.Tier_Name == "Silver" && input.Display_Order != 1) || (input.Tier_Name == "Gold" && input.Display_Order != 2) || (input.Tier_Name == "Platinum" && input.Display_Order != 3))
			                {
			                    alert "Use display order 1 for Silver, 2 for Gold, and 3 for Platinum.";
			                    cancel submit;
			                }
			                else if(input.Active == true)
			                {
			                    overlap_count = 0;
			                    order_conflict_count = 0;
			                    for each candidate in Loyalty_Tiers[ID != input.ID && Active == true]
			                    {
			                        scope_overlaps = candidate.Applies_To == input.Applies_To || candidate.Applies_To == "All" || input.Applies_To == "All" || candidate.Applies_To == "Both" || input.Applies_To == "Both";
			                        if(scope_overlaps == true)
			                        {
			                            band_overlaps = (candidate.Maximum_Quarterly_Spend == null || candidate.Maximum_Quarterly_Spend >= input.Minimum_Quarterly_Spend) && (input.Maximum_Quarterly_Spend == null || candidate.Minimum_Quarterly_Spend <= input.Maximum_Quarterly_Spend);
			                            order_conflicts = candidate.Display_Order == input.Display_Order || (candidate.Display_Order < input.Display_Order && candidate.Minimum_Quarterly_Spend > input.Minimum_Quarterly_Spend) || (candidate.Display_Order > input.Display_Order && candidate.Minimum_Quarterly_Spend < input.Minimum_Quarterly_Spend);
			                            if(band_overlaps == true)
			                            {
			                                overlap_count = overlap_count + 1;
			                            }
			                            if(order_conflicts == true)
			                            {
			                                order_conflict_count = order_conflict_count + 1;
			                            }
			                        }
			                    }
			                    if(overlap_count > 0)
			                    {
			                        alert "This active qualification band overlaps another tier applicable to the same customer scope.";
			                        cancel submit;
			                    }
			                    else if(order_conflict_count > 0)
			                    {
			                        alert "Active tier spend thresholds must increase in Silver, Gold, and Platinum display order.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Loyalty_Transactions_On_Delete as "Protect Loyalty Ledger"
			{
			    type = form
			    form = Loyalty_Transactions
			    record event = on delete
			    description = "Prevents deletion of posted loyalty transactions"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                alert "Posted loyalty transactions are immutable and cannot be deleted.";
			                cancel delete;
			            )
			        }
			    }
			}

			Loyalty_Transactions_On_Load as "Secure Loyalty Transaction Load"
			{
			    type = form
			    form = Loyalty_Transactions
			    record event = on add or edit
			    description = "Protects system posting fields and restricts manual entry to authorised adjustments"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Transaction_Date, Expiry_Date, Points_Status, Applied_Tier, Posted_By_Email, Customer_Login_Email;
			                is_portal = thisapp.portal.isUserInProfile("Customer_Portal");
			                current_profile = thisapp.permissions.loginUserProfile();
			                if(is_portal == true)
			                {
			                    disable Customer, Shipment, Transaction_Type, Points, Amount_Equivalent, Reference, Notes;
			                    alert "Loyalty transactions are posted through shipments and authorised finance workflows.";
			                }
			                else if(input.ID != null)
			                {
			                    disable Customer, Shipment, Transaction_Type, Points, Amount_Equivalent, Reference, Notes;
			                }
			                else if(current_profile == "Logistics_Administrator" || current_profile == "Finance_Officer")
			                {
			                    input.Transaction_Type = "Adjust";
			                    disable Transaction_Type, Shipment, Amount_Equivalent;
			                    input.Points_Status = "Available";
			                }
			                else
			                {
			                    disable Customer, Shipment, Transaction_Type, Points, Amount_Equivalent, Reference, Notes;
			                    alert "Only Logistics Administrators and Finance Officers can post manual loyalty adjustments.";
			                }
			            )
			        }
			    }
			}

			Loyalty_Transactions_On_Success as "Post Loyalty Adjustment"
			{
			    type = form
			    form = Loyalty_Transactions
			    record event = on add
			    description = "Updates customer balances for authorised direct adjustments and records audit evidence"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                if(input.Transaction_Type == "Adjust")
			                {
			                    customer_record = Customers[ID == input.Customer];
			                    customer_record.Current_Loyalty_Points = ifnull(customer_record.Current_Loyalty_Points,0) + input.Points;
			                    if(input.Points > 0)
			                    {
			                        customer_record.Lifetime_Loyalty_Points = ifnull(customer_record.Lifetime_Loyalty_Points,0) + input.Points;
			                    }
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuserid
			                        Actor_Profile = current_profile
			                        Action_Name = "Adjust Loyalty Points"
			                        Module_Name = "Loyalty Transactions"
			                        Record_ID = input.ID.toString()
			                        Before_Data = "Customer balance before adjustment=" + (ifnull(customer_record.Current_Loyalty_Points,0) - input.Points)
			                        After_Data = "Points=" + input.Points + "; Customer balance=" + customer_record.Current_Loyalty_Points + "; Reference=" + input.Reference
			                        Source = "Admin Correction"
			                        Severity = "Critical"
			                    ];
			                }
			            )
			        }
			    }
			}

			Loyalty_Transactions_On_Validate as "Validate Loyalty Transaction"
			{
			    type = form
			    form = Loyalty_Transactions
			    record event = on add or edit
			    description = "Enforces immutable posting, ownership, signs, balances, value, expiry, and duplicate controls"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                is_portal = thisapp.portal.isUserInProfile("Customer_Portal");
			                if(input.ID != null)
			                {
			                    alert "Posted loyalty transactions are immutable.";
			                    cancel submit;
			                }
			                else if(is_portal == true)
			                {
			                    alert "Use shipment booking to redeem loyalty points. Direct portal posting is not allowed.";
			                    cancel submit;
			                }
			                else
			                {
			                    customer_record = Customers[ID == input.Customer];
			                    if(customer_record.count(ID) == 0)
			                    {
			                        alert "Select a valid customer.";
			                        cancel submit;
			                    }
			                    else
			                    {
			                        input.Posted_By_Email = zoho.loginuserid;
			                        input.Customer_Login_Email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID);
			                        input.Transaction_Date = zoho.currenttime;
			                        config_record = App_Configuration[Active == true] range from 0 to 0;
			                        point_value = if(config_record.count(ID) > 0,config_record.Loyalty_Redemption_Value_Per_Point,1);
			                        if(input.Transaction_Type != "Rebate")
			                        {
			                            input.Amount_Equivalent = (ifnull(input.Points,0).abs() * point_value).round(2);
			                        }
			                        if(input.Transaction_Type == "Earn")
			                        {
			                            shipment_record = Shipment_Requests[ID == input.Shipment];
			                            if(input.Shipment == null || shipment_record.count(ID) == 0 || shipment_record.Customer != input.Customer || shipment_record.Shipment_Status != "Delivered" || ifnull(input.Points,0) <= 0)
			                            {
			                                alert "Earn entries require positive points and a delivered shipment for the same customer.";
			                                cancel submit;
			                            }
			                            else if(Loyalty_Transactions[Shipment == input.Shipment && Transaction_Type == "Earn"].count(ID) > 0)
			                            {
			                                alert "Loyalty points have already been earned for this shipment.";
			                                cancel submit;
			                            }
			                            else
			                            {
			                                input.Points_Status = "Available";
			                                expiry_months = if(config_record.count(ID) > 0,config_record.Points_Expiry_Months,12);
			                                if(input.Expiry_Date == null)
			                                {
			                                    input.Expiry_Date = zoho.currentdate.addMonth(expiry_months);
			                                }
			                            }
			                        }
			                        else if(input.Transaction_Type == "Redeem")
			                        {
			                            requested_points = 0 - input.Points;
			                            shipment_record = Shipment_Requests[ID == input.Shipment];
			                            if(input.Shipment == null || shipment_record.count(ID) == 0 || shipment_record.Customer != input.Customer || input.Points >= 0 || requested_points > ifnull(customer_record.Current_Loyalty_Points,0))
			                            {
			                                alert "Redeem entries require a shipment, negative points, matching ownership, and sufficient available balance.";
			                                cancel submit;
			                            }
			                            else if(Loyalty_Transactions[Shipment == input.Shipment && Transaction_Type == "Redeem"].count(ID) > 0)
			                            {
			                                alert "Points have already been redeemed for this shipment.";
			                                cancel submit;
			                            }
			                            else
			                            {
			                                input.Points_Status = "Consumed";
			                                input.Expiry_Date = null;
			                            }
			                        }
			                        else if(input.Transaction_Type == "Expire")
			                        {
			                            if(ifnull(input.Points,0) >= 0 || (0 - input.Points) > ifnull(customer_record.Current_Loyalty_Points,0))
			                            {
			                                alert "Expiry entries require negative points that do not exceed the current balance.";
			                                cancel submit;
			                            }
			                            input.Points_Status = "Expired";
			                            input.Expiry_Date = null;
			                        }
			                        else if(input.Transaction_Type == "Reverse")
			                        {
			                            if(ifnull(input.Points,0) == 0 || input.Shipment == null)
			                            {
			                                alert "Reversal entries require non-zero points and a related shipment.";
			                                cancel submit;
			                            }
			                            input.Points_Status = if(input.Points > 0,"Available","Consumed");
			                            if(input.Points > 0 && input.Expiry_Date == null)
			                            {
			                                expiry_months = if(config_record.count(ID) > 0,config_record.Points_Expiry_Months,12);
			                                input.Expiry_Date = zoho.currentdate.addMonth(expiry_months);
			                            }
			                        }
			                        else if(input.Transaction_Type == "Adjust")
			                        {
			                            if(current_profile != "Logistics_Administrator" && current_profile != "Finance_Officer")
			                            {
			                                alert "Only Logistics Administrators and Finance Officers can post adjustments.";
			                                cancel submit;
			                            }
			                            else if(ifnull(input.Points,0) == 0 || ifnull(input.Reference,"").trim() == "" || ifnull(input.Notes,"").trim() == "")
			                            {
			                                alert "Non-zero points, a reference, and explanatory notes are required for an adjustment.";
			                                cancel submit;
			                            }
			                            else if(input.Points < 0 && (0 - input.Points) > ifnull(customer_record.Current_Loyalty_Points,0))
			                            {
			                                alert "A negative adjustment cannot exceed the customer's current loyalty balance.";
			                                cancel submit;
			                            }
			                            else
			                            {
			                                input.Points_Status = if(input.Points > 0,"Available","Consumed");
			                                if(input.Points > 0)
			                                {
			                                    expiry_months = if(config_record.count(ID) > 0,config_record.Points_Expiry_Months,12);
			                                    input.Expiry_Date = zoho.currentdate.addMonth(expiry_months);
			                                }
			                                else
			                                {
			                                    input.Expiry_Date = null;
			                                }
			                            }
			                        }
			                        else if(input.Transaction_Type == "Rebate")
			                        {
			                            if(current_profile != "Logistics_Administrator" && current_profile != "Finance_Officer")
			                            {
			                                alert "Only authorised finance workflows can post rebates.";
			                                cancel submit;
			                            }
			                            else if(input.Points != 0 || input.Amount_Equivalent <= 0)
			                            {
			                                alert "A rebate uses zero points and a positive amount equivalent.";
			                                cancel submit;
			                            }
			                            else
			                            {
			                                input.Points_Status = "Not Applicable";
			                                input.Expiry_Date = null;
			                            }
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Manifest_Bags_On_Delete as "Protect Manifest Bag Evidence"
			{
			    type = form
			    form = Manifest_Bags
			    record event = on delete
			    description = "Prevents deletion of manifest bag custody and reconciliation evidence"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                alert "Manifest bag checklist records cannot be deleted. Cancel the unused draft manifest instead.";
			                cancel delete;
			            )
			        }
			    }
			}

			Manifest_Bags_On_Load as "Secure Manifest Bag Checklist"
			{
			    type = form
			    form = Manifest_Bags
			    record event = on add or edit
			    description = "Filters draft trip bags and protects custody-controlled checklist fields"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Manifest_Type, Load_Status, Loaded_At, Received_At, Seal_Verified, Exception_Photo, Exception_Notes;
			                if(input.ID == null)
			                {
			                    clear Manifest;
			                    Manifest:ui.add(Manifests[Manifest_Status == "Draft"].ID.getall());
			                    clear Bag;
			                }
			                else
			                {
			                    disable Manifest, Bag;
			                    manifest_record = Manifests[ID == input.Manifest];
			                    if((manifest_record.Manifest_Status == "Arrived" || manifest_record.Manifest_Status == "Exception") && input.Load_Status == "Loaded")
			                    {
			                        enable Seal_Verified, Exception_Photo, Exception_Notes;
			                    }
			                }
			            )
			        }
			    }
			}

			Manifest_Bags_On_Success as "Audit Manifest Bag Checklist"
			{
			    type = form
			    form = Manifest_Bags
			    record event = on add or edit
			    description = "Audits expected-bag creation and destination evidence preparation"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = thisapp.permissions.loginUserProfile()
			                    Action_Name = "Save Manifest Bag Checklist"
			                    Module_Name = "Manifest Bags"
			                    Record_ID = input.ID.toString()
			                    After_Data = "Manifest=" + input.Manifest + "; Bag=" + input.Bag + "; Status=" + input.Load_Status + "; Seal Verified=" + input.Seal_Verified
			                    Source = "Form Workflow"
			                    Severity = "Critical"
			                ];
			            )
			        }
			    }
			}

			Manifest_Bags_On_Validate as "Validate Manifest Bag Checklist"
			{
			    type = form
			    form = Manifest_Bags
			    record event = on add or edit
			    description = "Enforces hub authority, route compatibility, uniqueness, capacity, and controlled evidence editing"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                authorised_profile = current_profile == "Logistics_Administrator" || current_profile == "Operations_Manager" || current_profile == "Hub_Supervisor" || current_profile == "Hub_Operator";
			                if(authorised_profile == false)
			                {
			                    alert "You are not authorised to maintain manifest bag checklists.";
			                    cancel submit;
			                }
			                manifest_record = Manifests[ID == input.Manifest];
			                if(manifest_record.count(ID) == 0)
			                {
			                    alert "Select a valid manifest.";
			                    cancel submit;
			                }
			                logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                deputation_active = logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate);
			                effective_hub = logged_user.Home_Hub;
			                if(deputation_active == true)
			                {
			                    effective_hub = logged_user.Deputed_Hub;
			                }
			                if(input.ID == null)
			                {
			                    if(manifest_record.Manifest_Status != "Draft")
			                    {
			                        alert "Expected bags can be added only while the manifest is in Draft status.";
			                        cancel submit;
			                    }
			                    if((current_profile == "Hub_Supervisor" || current_profile == "Hub_Operator") && (logged_user.count(ID) == 0 || effective_hub != manifest_record.Origin_Hub))
			                    {
			                        alert "Hub users can add expected bags only at their effective origin hub.";
			                        cancel submit;
			                    }
			                    bag_record = Logistics_Bags[ID == input.Bag && Bag_Status == "Sealed"];
			                    if(bag_record.count(ID) == 0)
			                    {
			                        alert "Only a sealed bag can be added to a draft manifest.";
			                        cancel submit;
			                    }
			                    expected_bag_type = if(manifest_record.Manifest_Type == "Linehaul","Master",manifest_record.Manifest_Type);
			                    if(bag_record.Bag_Type != expected_bag_type || bag_record.Origin_Hub != manifest_record.Origin_Hub || bag_record.Destination_Hub != manifest_record.Destination_Hub)
			                    {
			                        alert "The bag type, origin, and destination must match the manifest movement leg.";
			                        cancel submit;
			                    }
			                    duplicate_link = Manifest_Bags[Manifest == input.Manifest && Bag == input.Bag];
			                    other_active_link = Manifest_Bags[Bag == input.Bag && (Load_Status == "Expected" || Load_Status == "Loaded")];
			                    if(duplicate_link.count(ID) > 0 || other_active_link.count(ID) > 0)
			                    {
			                        alert "This bag is already linked to this or another active manifest checklist.";
			                        cancel submit;
			                    }
			                    bag_count = 1;
			                    shipment_count = ifnull(bag_record.Total_Shipments,0);
			                    total_weight = ifnull(bag_record.Total_Weight_Kg,0);
			                    for each manifest_bag in Manifest_Bags[Manifest == input.Manifest && (Load_Status == "Expected" || Load_Status == "Loaded")]
			                    {
			                        linked_bag = Logistics_Bags[ID == manifest_bag.Bag];
			                        bag_count = bag_count + 1;
			                        shipment_count = shipment_count + ifnull(linked_bag.Total_Shipments,0);
			                        total_weight = total_weight + ifnull(linked_bag.Total_Weight_Kg,0);
			                    }
			                    vehicle_record = Vehicles[ID == manifest_record.Vehicle && Active == true];
			                    if(bag_count > 100 || shipment_count > 1000)
			                    {
			                        alert "A manifest cannot exceed 100 bags or 1,000 shipments. Split this trip.";
			                        cancel submit;
			                    }
			                    if(vehicle_record.count(ID) == 0 || total_weight > vehicle_record.Capacity_Kg)
			                    {
			                        alert "The selected vehicle does not have capacity for this expected bag set.";
			                        cancel submit;
			                    }
			                    input.Manifest_Type = manifest_record.Manifest_Type;
			                    input.Load_Status = "Expected";
			                    input.Loaded_At = null;
			                    input.Received_At = null;
			                    input.Seal_Verified = false;
			                    input.Exception_Photo = null;
			                    input.Exception_Notes = "";
			                }
			                else
			                {
			                    existing_record = Manifest_Bags[ID == input.ID];
			                    if(existing_record.Manifest != input.Manifest || existing_record.Bag != input.Bag || existing_record.Manifest_Type != input.Manifest_Type || existing_record.Load_Status != input.Load_Status || existing_record.Loaded_At != input.Loaded_At || existing_record.Received_At != input.Received_At)
			                    {
			                        alert "Manifest, bag, movement type, status, and custody timestamps are controlled by operational actions.";
			                        cancel submit;
			                    }
			                    if(manifest_record.Manifest_Status != "Arrived" && manifest_record.Manifest_Status != "Exception")
			                    {
			                        alert "Seal confirmation and exception evidence can be prepared only after manifest arrival.";
			                        cancel submit;
			                    }
			                    if(input.Load_Status != "Loaded")
			                    {
			                        alert "Terminal reconciliation evidence cannot be altered from this form.";
			                        cancel submit;
			                    }
			                    if((current_profile == "Hub_Supervisor" || current_profile == "Hub_Operator") && (logged_user.count(ID) == 0 || effective_hub != manifest_record.Destination_Hub))
			                    {
			                        alert "Hub users can prepare reconciliation evidence only at their effective destination hub.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Manifest_On_User_Input as "Filter Bags for Manifest"
			{
			    type = form
			    form = Manifest_Bags
			    record event = on add or edit
			    description = "Offers only sealed bags matching the selected draft manifest route and movement type"
			
			    on user input of Manifest
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Bag = null;
			                clear Bag;
			                manifest_record = Manifests[ID == input.Manifest && Manifest_Status == "Draft"];
			                if(manifest_record.count(ID) > 0)
			                {
			                    expected_bag_type = if(manifest_record.Manifest_Type == "Linehaul","Master",manifest_record.Manifest_Type);
			                    eligible_bags = Logistics_Bags[Bag_Status == "Sealed" && Bag_Type == expected_bag_type && Origin_Hub == manifest_record.Origin_Hub && Destination_Hub == manifest_record.Destination_Hub].ID.getall();
			                    Bag:ui.add(eligible_bags);
			                }
			            )
			        }
			    }
			}

			Departure_Time_On_User_Input as "Calculate Manifest Arrival"
			{
			    type = form
			    form = Manifests
			    record event = on add or edit
			    description = "Calculates expected arrival from the selected route transit time"
			
			    on user input of Departure_Time
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Departure_Time != null && input.Route != null)
			                {
			                    route_record = Transport_Routes[ID == input.Route && Active == true];
			                    input.Expected_Arrival_Time = input.Departure_Time.addHour(route_record.Estimated_Transit_Hours.round(0));
			                }
			            )
			        }
			    }
			}

			Destination_Hub_On_User_Input as "Filter Manifest Routes"
			{
			    type = form
			    form = Manifests
			    record event = on add or edit
			    description = "Filters active linehaul routes for the selected hub pair"
			
			    on user input of Destination_Hub
			    {
			        actions
			        {
			            custom deluge script
			            (
			                clear Route;
			                if(input.Manifest_Type == "Linehaul" && input.Origin_Hub != null && input.Destination_Hub != null)
			                {
			                    Route:ui.add(Transport_Routes[Origin_Sorting_Hub == input.Origin_Hub && Destination_Sorting_Hub == input.Destination_Hub && Active == true].ID.getall());
			                }
			            )
			        }
			    }
			}

			Manifest_Type_On_User_Input as "Filter Manifest Destination"
			{
			    type = form
			    form = Manifests
			    record event = on add or edit
			    description = "Filters destination hubs and route requirements by trip type"
			
			    on user input of Manifest_Type
			    {
			        actions
			        {
			            custom deluge script
			            (
			                clear Destination_Hub;
			                clear Route;
			                if(input.Manifest_Type == "Feeder" && input.Origin_Hub != null)
			                {
			                    origin_record = Hubs[ID == input.Origin_Hub];
			                    Destination_Hub:ui.add(Hubs[ID == origin_record.Parent_Sorting_Hub && Active == true].ID.getall());
			                }
			                else if(input.Manifest_Type == "Linehaul")
			                {
			                    Destination_Hub:ui.add(Hubs[Hub_Type == "Sorting Hub" && Active == true && ID != input.Origin_Hub].ID.getall());
			                }
			                else if(input.Manifest_Type == "Delivery Feeder" && input.Origin_Hub != null)
			                {
			                    Destination_Hub:ui.add(Hubs[Hub_Type == "Collection Center" && Parent_Sorting_Hub == input.Origin_Hub && Active == true].ID.getall());
			                }
			                else
			                {
			                    Destination_Hub:ui.add(Hubs[Active == true && ID != input.Origin_Hub].ID.getall());
			                }
			            )
			        }
			    }
			}

			Manifests_On_Delete as "Block Manifest Deletion"
			{
			    type = form
			    form = Manifests
			    record event = on delete
			    description = "Preserves the manifest custody trail by blocking deletion"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                alert "Manifests cannot be deleted. Cancel an unused draft through the controlled action.";
			                cancel delete;
			            )
			        }
			    }
			}

			Manifests_On_Load as "Prepare Manifest"
			{
			    type = form
			    form = Manifests
			    record event = on add or edit
			    description = "Defaults the effective origin hub, filters trip resources, and locks custody-controlled data"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Manifest_Status, Actual_Arrival_Time, Total_Bags, Total_Shipments, Total_Weight_Kg, Manifest_Barcode, Created_By_Email;
			                current_profile = thisapp.permissions.loginUserProfile();
			                logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                if(input.ID == null && (current_profile == "Hub_Supervisor" || current_profile == "Hub_Operator") && logged_user.count(ID) > 0)
			                {
			                    deputation_active = logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate);
			                    input.Origin_Hub = if(deputation_active == true,logged_user.Deputed_Hub,logged_user.Home_Hub);
			                }
			                if(input.ID == null)
			                {
			                    clear Route;
			                    clear Vehicle;
			                    clear Driver;
			                    if(input.Origin_Hub != null)
			                    {
			                        Vehicle:ui.add(Vehicles[Owning_Hub == input.Origin_Hub && Active == true && Status == "Available"].ID.getall());
			                        Driver:ui.add(Operations_Users[Active == true && Application_Role == "Field Agent" && ((Deputed_Hub == input.Origin_Hub && (Deputation_Start_Date == null || Deputation_Start_Date <= zoho.currentdate) && (Deputation_End_Date == null || Deputation_End_Date >= zoho.currentdate)) || (Home_Hub == input.Origin_Hub && (Deputed_Hub == null || (Deputation_Start_Date != null && Deputation_Start_Date > zoho.currentdate) || (Deputation_End_Date != null && Deputation_End_Date < zoho.currentdate))))].ID.getall());
			                    }
			                    if(input.Origin_Hub != null && input.Destination_Hub != null && input.Manifest_Type == "Linehaul")
			                    {
			                        Route:ui.add(Transport_Routes[Origin_Sorting_Hub == input.Origin_Hub && Destination_Sorting_Hub == input.Destination_Hub && Active == true].ID.getall());
			                    }
			                }
			                if(input.ID != null && input.Manifest_Status != "Draft")
			                {
			                    disable Manifest_Type, Origin_Hub, Destination_Hub, Route, Vehicle, Driver, Departure_Time, Expected_Arrival_Time, Vehicle_Seal_Code, Notes;
			                }
			            )
			        }
			    }
			}

			Manifests_On_Success as "Audit Manifest Save"
			{
			    type = form
			    form = Manifests
			    record event = on add or edit
			    description = "Audits manifest creation and permitted draft changes"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                action_name = "Save Manifest";
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = current_profile
			                    Action_Name = action_name
			                    Module_Name = "Manifests"
			                    Record_ID = input.ID.toString()
			                    Before_Data = "Draft manifest data"
			                    After_Data = "Type=" + input.Manifest_Type + "; Origin=" + input.Origin_Hub + "; Destination=" + input.Destination_Hub + "; Vehicle=" + input.Vehicle
			                    Source = "Form Workflow"
			                    Severity = "High"
			                ];
			            )
			        }
			    }
			}

			Manifests_On_Validate as "Validate Manifest"
			{
			    type = form
			    form = Manifests
			    record event = on add or edit
			    description = "Validates manifest topology, route, resources, timing, capacity prerequisites, and protected state"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                authorised = current_profile == "Logistics_Administrator" || current_profile == "Operations_Manager" || current_profile == "Hub_Supervisor" || current_profile == "Hub_Operator";
			                if(authorised == false)
			                {
			                    alert "You are not authorised to create or edit manifests.";
			                    cancel submit;
			                }
			                origin_record = Hubs[ID == input.Origin_Hub && Active == true];
			                destination_record = Hubs[ID == input.Destination_Hub && Active == true];
			                if(origin_record.count(ID) == 0 || destination_record.count(ID) == 0 || input.Origin_Hub == input.Destination_Hub)
			                {
			                    alert "Select different active origin and destination hubs.";
			                    cancel submit;
			                }
			                if(input.Manifest_Type == "Feeder" && (origin_record.Hub_Type != "Collection Center" || destination_record.ID != origin_record.Parent_Sorting_Hub))
			                {
			                    alert "A feeder manifest must move from a collection center to its parent sorting hub.";
			                    cancel submit;
			                }
			                if(input.Manifest_Type == "Linehaul" && (origin_record.Hub_Type != "Sorting Hub" || destination_record.Hub_Type != "Sorting Hub"))
			                {
			                    alert "A linehaul manifest must move between sorting hubs.";
			                    cancel submit;
			                }
			                if(input.Manifest_Type == "Delivery Feeder" && (origin_record.Hub_Type != "Sorting Hub" || destination_record.Hub_Type != "Collection Center" || destination_record.Parent_Sorting_Hub != origin_record.ID))
			                {
			                    alert "A delivery feeder manifest must move from a sorting hub to one of its collection centers.";
			                    cancel submit;
			                }
			                if(input.Manifest_Type == "Linehaul")
			                {
			                    route_record = Transport_Routes[ID == input.Route && Active == true && Origin_Sorting_Hub == input.Origin_Hub && Destination_Sorting_Hub == input.Destination_Hub];
			                    if(route_record.count(ID) == 0)
			                    {
			                        alert "Select an active route matching the linehaul hub pair.";
			                        cancel submit;
			                    }
			                }
			                else if(input.Route != null)
			                {
			                    alert "A transport route is used only for linehaul manifests.";
			                    cancel submit;
			                }
			                vehicle_record = Vehicles[ID == input.Vehicle && Active == true && Owning_Hub == input.Origin_Hub];
			                if(vehicle_record.count(ID) == 0)
			                {
			                    alert "Select an active vehicle owned by the origin hub.";
			                    cancel submit;
			                }
			                if(vehicle_record.Status != "Available" && (input.ID == null || Manifests[ID == input.ID].Vehicle != input.Vehicle))
			                {
			                    alert "The selected vehicle is not available.";
			                    cancel submit;
			                }
			                if(input.Manifest_Type == "Linehaul")
			                {
			                    required_mode = if(route_record.Transport_Mode == "Air","Air Support","Surface");
			                    if(vehicle_record.Transport_Mode != required_mode)
			                    {
			                        alert "The selected vehicle transport mode is not compatible with the route.";
			                        cancel submit;
			                    }
			                }
			                if(input.Driver != null)
			                {
			                    driver_record = Operations_Users[ID == input.Driver && Active == true && Application_Role == "Field Agent"];
			                    if(driver_record.count(ID) == 0)
			                    {
			                        alert "Select an active field agent as driver.";
			                        cancel submit;
			                    }
			                    driver_deputation_active = driver_record.Deputed_Hub != null && (driver_record.Deputation_Start_Date == null || driver_record.Deputation_Start_Date <= zoho.currentdate) && (driver_record.Deputation_End_Date == null || driver_record.Deputation_End_Date >= zoho.currentdate);
			                    driver_hub = if(driver_deputation_active == true,driver_record.Deputed_Hub,driver_record.Home_Hub);
			                    if(driver_hub != input.Origin_Hub)
			                    {
			                        alert "The selected driver is not effective at the origin hub.";
			                        cancel submit;
			                    }
			                }
			                if(input.Departure_Time != null && input.Expected_Arrival_Time != null && input.Expected_Arrival_Time <= input.Departure_Time)
			                {
			                    alert "Expected arrival must be later than departure.";
			                    cancel submit;
			                }
			                if(input.ID != null && input.Total_Weight_Kg > vehicle_record.Capacity_Kg)
			                {
			                    alert "Manifest weight exceeds the selected vehicle capacity.";
			                    cancel submit;
			                }
			                if(current_profile == "Hub_Supervisor" || current_profile == "Hub_Operator")
			                {
			                    logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                    deputation_active = logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate);
			                    effective_hub = logged_user.Home_Hub;
			                    if(deputation_active == true)
			                    {
			                        effective_hub = logged_user.Deputed_Hub;
			                    }
			                    if(logged_user.count(ID) == 0 || effective_hub != input.Origin_Hub)
			                    {
			                        alert "Hub users can create or edit manifests only for their effective hub.";
			                        cancel submit;
			                    }
			                }
			                if(input.ID == null)
			                {
			                    input.Manifest_Status = "Draft";
			                    input.Total_Bags = 0;
			                    input.Total_Shipments = 0;
			                    input.Total_Weight_Kg = 0;
			                    input.Actual_Arrival_Time = null;
			                    input.Created_By_Email = zoho.loginuserid;
			                }
			                else
			                {
			                    previous_record = Manifests[ID == input.ID];
			                    if(previous_record.Manifest_Status != "Draft")
			                    {
			                        alert "Closed or dispatched manifests can be changed only through controlled custody actions.";
			                        cancel submit;
			                    }
			                    if(input.Manifest_Status != previous_record.Manifest_Status || input.Total_Bags != previous_record.Total_Bags || input.Total_Shipments != previous_record.Total_Shipments || input.Total_Weight_Kg != previous_record.Total_Weight_Kg || input.Actual_Arrival_Time != previous_record.Actual_Arrival_Time || input.Created_By_Email != previous_record.Created_By_Email)
			                    {
			                        alert "Manifest status, totals, arrival, and creator details are system controlled.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Manifests_Origin_Hub_Input as "Refresh Manifest Resources"
			{
			    type = form
			    form = Manifests
			    record event = on add or edit
			    description = "Refreshes compatible destinations, vehicles, and drivers for the selected origin hub"
			
			    on user input of Origin_Hub
			    {
			        actions
			        {
			            custom deluge script
			            (
			                clear Destination_Hub;
			                clear Route;
			                clear Vehicle;
			                clear Driver;
			                if(input.Manifest_Type == "Feeder" && input.Origin_Hub != null)
			                {
			                    origin_record = Hubs[ID == input.Origin_Hub];
			                    Destination_Hub:ui.add(Hubs[ID == origin_record.Parent_Sorting_Hub && Active == true].ID.getall());
			                }
			                else if(input.Manifest_Type == "Linehaul")
			                {
			                    Destination_Hub:ui.add(Hubs[Hub_Type == "Sorting Hub" && Active == true && ID != input.Origin_Hub].ID.getall());
			                }
			                else if(input.Manifest_Type == "Delivery Feeder" && input.Origin_Hub != null)
			                {
			                    Destination_Hub:ui.add(Hubs[Hub_Type == "Collection Center" && Parent_Sorting_Hub == input.Origin_Hub && Active == true].ID.getall());
			                }
			                else
			                {
			                    Destination_Hub:ui.add(Hubs[Active == true && ID != input.Origin_Hub].ID.getall());
			                }
			                if(input.Origin_Hub != null)
			                {
			                    Vehicle:ui.add(Vehicles[Owning_Hub == input.Origin_Hub && Active == true && Status == "Available"].ID.getall());
			                    Driver:ui.add(Operations_Users[Active == true && Application_Role == "Field Agent" && ((Deputed_Hub == input.Origin_Hub && (Deputation_Start_Date == null || Deputation_Start_Date <= zoho.currentdate) && (Deputation_End_Date == null || Deputation_End_Date >= zoho.currentdate)) || (Home_Hub == input.Origin_Hub && (Deputed_Hub == null || (Deputation_Start_Date != null && Deputation_Start_Date > zoho.currentdate) || (Deputation_End_Date != null && Deputation_End_Date < zoho.currentdate))))].ID.getall());
			                }
			            )
			        }
			    }
			}

			Route_On_User_Input as "Apply Manifest Route"
			{
			    type = form
			    form = Manifests
			    record event = on add or edit
			    description = "Filters vehicles by route mode and derives the expected arrival time"
			
			    on user input of Route
			    {
			        actions
			        {
			            custom deluge script
			            (
			                clear Vehicle;
			                if(input.Route != null && input.Origin_Hub != null)
			                {
			                    route_record = Transport_Routes[ID == input.Route && Active == true];
			                    required_mode = if(route_record.Transport_Mode == "Air","Air Support","Surface");
			                    Vehicle:ui.add(Vehicles[Owning_Hub == input.Origin_Hub && Active == true && Status == "Available" && Transport_Mode == required_mode].ID.getall());
			                    if(input.Departure_Time != null)
			                    {
			                        input.Expected_Arrival_Time = input.Departure_Time.addHour(route_record.Estimated_Transit_Hours.round(0));
			                    }
			                }
			                else if(input.Origin_Hub != null)
			                {
			                    Vehicle:ui.add(Vehicles[Owning_Hub == input.Origin_Hub && Active == true && Status == "Available"].ID.getall());
			                }
			            )
			        }
			    }
			}

			NDR_Instructions_On_Load as "Secure NDR Instruction Load"
			{
			    type = form
			    form = NDR_Instructions
			    record event = on add or edit
			    description = "Locks system-controlled NDR identity, token, timestamps, and status fields"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Customer, Customer_Login_Email, Shipment, Delivery_Run_Item, Secure_Token, Failure_Reason, Submitted_At, NDR_Status, Supervisor_Notes;
			                if(input.ID == null)
			                {
			                    hide Recipient_Instruction, Reschedule_Date, Updated_Delivery_Address;
			                    disable Recipient_Instruction, Reschedule_Date, Updated_Delivery_Address;
			                }
			                else
			                {
			                    show Recipient_Instruction;
			                    disable Recipient_Instruction, Reschedule_Date, Updated_Delivery_Address;
			                    if(input.Recipient_Instruction == "Reschedule Delivery")
			                    {
			                        show Reschedule_Date;
			                        hide Updated_Delivery_Address;
			                    }
			                    else if(input.Recipient_Instruction == "Update Delivery Address")
			                    {
			                        hide Reschedule_Date;
			                        show Updated_Delivery_Address;
			                    }
			                    else
			                    {
			                        hide Reschedule_Date, Updated_Delivery_Address;
			                    }
			                }
			            )
			        }
			    }
			}

			NDR_Instructions_On_Validate as "Validate NDR Instruction"
			{
			    type = form
			    form = NDR_Instructions
			    record event = on add or edit
			    description = "Prevents direct creation and protects secure NDR records from unauthorised edits"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                existing_instruction = NDR_Instructions[ID == input.ID];
			                authorised = current_profile == "Logistics_Administrator" || current_profile == "Operations_Manager" || current_profile == "Hub_Supervisor";
			                if(input.ID == null)
			                {
			                    alert "NDR records are created only by the failed-delivery workflow.";
			                    cancel submit;
			                }
			                else if(authorised == false)
			                {
			                    alert "You are not authorised to edit this NDR instruction.";
			                    cancel submit;
			                }
			                else if(existing_instruction.Customer != input.Customer || existing_instruction.Customer_Login_Email != input.Customer_Login_Email || existing_instruction.Shipment != input.Shipment || existing_instruction.Delivery_Run_Item != input.Delivery_Run_Item || existing_instruction.Secure_Token != input.Secure_Token || existing_instruction.Failure_Reason != input.Failure_Reason || existing_instruction.Submitted_At != input.Submitted_At || existing_instruction.Recipient_Instruction != input.Recipient_Instruction || existing_instruction.Reschedule_Date != input.Reschedule_Date || existing_instruction.Updated_Delivery_Address != input.Updated_Delivery_Address || existing_instruction.NDR_Status != input.NDR_Status)
			                {
			                    alert "Use the secure response form and controlled report actions to change NDR lifecycle data.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			NDR_Response_On_Load as "Load Secure NDR Response"
			{
			    type = form
			    form = NDR_Response
			    record event = on add
			    description = "Validates the secure token before exposing recipient response controls"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                hide Reschedule_Date, Updated_Delivery_Address;
			                token_value = ifnull(input.Secure_Token,"").trim();
			                if(token_value == "")
			                {
			                    hide Recipient_Instruction, Reschedule_Date, Updated_Delivery_Address;
			                    disable Recipient_Instruction, Reschedule_Date, Updated_Delivery_Address;
			                    alert "This secure delivery instruction link is incomplete.";
			                }
			                else
			                {
			                    ndr_record = NDR_Instructions[Secure_Token == token_value];
			                    token_valid = ndr_record.count(ID) > 0 && ndr_record.NDR_Status == "Awaiting Instruction" && ndr_record.Submitted_At == null && ndr_record.Added_Time.addDay(2) >= zoho.currenttime;
			                    if(token_valid == false)
			                    {
			                        hide Recipient_Instruction, Reschedule_Date, Updated_Delivery_Address;
			                        disable Recipient_Instruction, Reschedule_Date, Updated_Delivery_Address;
			                        alert "This secure delivery instruction link is invalid, expired, or already used. Contact customer support for assistance.";
			                    }
			                    else
			                    {
			                        disable Secure_Token;
			                        show Recipient_Instruction;
			                        enable Recipient_Instruction;
			                    }
			                }
			            )
			        }
			    }
			}

			Recipient_Instruction_On_User_Input as "Show NDR Response Fields"
			{
			    type = form
			    form = NDR_Response
			    record event = on add
			    description = "Shows only the response field required by the selected recipient instruction"
			
			    on user input of Recipient_Instruction
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Recipient_Instruction == "Reschedule Delivery")
			                {
			                    show Reschedule_Date;
			                    hide Updated_Delivery_Address;
			                    input.Updated_Delivery_Address.address_line_1 = "";
			                    input.Updated_Delivery_Address.address_line_2 = "";
			                    input.Updated_Delivery_Address.district_city = "";
			                    input.Updated_Delivery_Address.state_province = "";
			                    input.Updated_Delivery_Address.postal_Code = "";
			                    input.Updated_Delivery_Address.country = "";
			                }
			                else if(input.Recipient_Instruction == "Update Delivery Address")
			                {
			                    hide Reschedule_Date;
			                    show Updated_Delivery_Address;
			                    input.Reschedule_Date = null;
			                }
			                else
			                {
			                    hide Reschedule_Date, Updated_Delivery_Address;
			                    input.Reschedule_Date = null;
			                    input.Updated_Delivery_Address.address_line_1 = "";
			                    input.Updated_Delivery_Address.address_line_2 = "";
			                    input.Updated_Delivery_Address.district_city = "";
			                    input.Updated_Delivery_Address.state_province = "";
			                    input.Updated_Delivery_Address.postal_Code = "";
			                    input.Updated_Delivery_Address.country = "";
			                }
			            )
			        }
			    }
			}

			Submit_NDR_Response as "Submit Secure NDR Response"
			{
			    type = form
			    form = NDR_Response
			    button = Submit_Response
			    description = "Validates an expiring one-time token and securely records the recipient's delivery instruction"
			
			    on click
			    {
			        actions
			        {
			            on click
			            (
			                token_value = ifnull(input.Secure_Token,"").trim();
			                ndr_record = NDR_Instructions[Secure_Token == token_value];
			                token_valid = token_value != "" && ndr_record.count(ID) > 0 && ndr_record.NDR_Status == "Awaiting Instruction" && ndr_record.Submitted_At == null && ndr_record.Added_Time.addDay(2) >= zoho.currenttime;
			                validation_message = "";
			                if(token_valid == false)
			                {
			                    validation_message = "This secure delivery instruction link is invalid, expired, or already used.";
			                }
			                else if(input.Recipient_Instruction == null)
			                {
			                    validation_message = "Select a delivery instruction.";
			                }
			                else if(input.Recipient_Instruction == "Reschedule Delivery" && (input.Reschedule_Date == null || input.Reschedule_Date <= zoho.currentdate))
			                {
			                    validation_message = "Select a reschedule date after today.";
			                }
			                else if(input.Recipient_Instruction == "Update Delivery Address" && (ifnull(input.Updated_Delivery_Address.address_line_1,"").trim() == "" || ifnull(input.Updated_Delivery_Address.district_city,"").trim() == "" || ifnull(input.Updated_Delivery_Address.state_province,"").trim() == "" || ifnull(input.Updated_Delivery_Address.postal_Code,"").trim() == "" || input.Updated_Delivery_Address.postal_Code.matches("^[1-9][0-9]{5}$") == false || ifnull(input.Updated_Delivery_Address.country,"").trim() == ""))
			                {
			                    validation_message = "Enter a complete Indian delivery address with a valid six-digit pincode.";
			                }
			                if(validation_message != "")
			                {
			                    alert validation_message;
			                }
			                else
			                {
			                    shipment_record = Shipment_Requests[ID == ndr_record.Shipment];
			                    destination_hub = Hubs[ID == shipment_record.Destination_Hub];
			                    customer_record = Customers[ID == shipment_record.Customer];
			                    ndr_record.Recipient_Instruction = input.Recipient_Instruction;
			                    ndr_record.Reschedule_Date = input.Reschedule_Date;
			                    if(input.Recipient_Instruction == "Update Delivery Address")
			                    {
			                        ndr_record.Updated_Delivery_Address.address_line_1 = input.Updated_Delivery_Address.address_line_1;
			                        ndr_record.Updated_Delivery_Address.address_line_2 = input.Updated_Delivery_Address.address_line_2;
			                        ndr_record.Updated_Delivery_Address.district_city = input.Updated_Delivery_Address.district_city;
			                        ndr_record.Updated_Delivery_Address.state_province = input.Updated_Delivery_Address.state_province;
			                        ndr_record.Updated_Delivery_Address.postal_Code = input.Updated_Delivery_Address.postal_Code;
			                        ndr_record.Updated_Delivery_Address.country = input.Updated_Delivery_Address.country;
			                    }
			                    ndr_record.Submitted_At = zoho.currenttime;
			                    ndr_record.NDR_Status = "New";
			                    if(ifnull(destination_hub.Contact_Email,"").trim() != "")
			                    {
			                        sendmail
			                        [
			                            from: zoho.adminuserid
			                            to: destination_hub.Contact_Email
			                            subject: "New NDR instruction for AWB " + shipment_record.AWB_Number
			                            message: "A recipient submitted: " + input.Recipient_Instruction + ". Review the NDR Action Queue before replanning delivery."
			                        ]
			                    }
			                    communication_id = insert into Communication_Log
			                    [
			                        Customer = customer_record.ID
			                        Shipment = shipment_record.ID
			                        Recipient = if(ifnull(destination_hub.Contact_Email,"").trim() != "",destination_hub.Contact_Email,zoho.adminuserid)
			                        Channel = "Email"
			                        Template_Code = "NDR_RESPONSE_RECEIVED"
			                        Subject = "NDR response received for AWB " + shipment_record.AWB_Number
			                        Message_Summary = "Recipient selected " + input.Recipient_Instruction + "."
			                        Provider = "Zoho Mail"
			                        Communication_Status = if(ifnull(destination_hub.Contact_Email,"").trim() != "","Sent","Skipped")
			                        Attempt_Count = if(ifnull(destination_hub.Contact_Email,"").trim() != "",1,0)
			                        Last_Attempt_At = zoho.currenttime
			                    ];
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = if(ifnull(zoho.loginuserid,"").trim() != "",zoho.loginuserid,"Secure Recipient Link")
			                        Actor_Profile = "External Recipient"
			                        Action_Name = "Submit NDR Instruction"
			                        Module_Name = "NDR Instructions"
			                        Record_ID = ndr_record.ID.toString()
			                        Before_Data = "Status=Awaiting Instruction"
			                        After_Data = "Status=New; Instruction=" + input.Recipient_Instruction
			                        Source = "Secure Stateless Form"
			                        Severity = "Critical"
			                    ];
			                    alert "Your delivery instruction has been submitted securely. This one-time link is now closed.";
			                }
			            )
			        }
			    }
			}

			Application_Role_On_User_Input as "Update Fields for Application Role"
			{
			    type = form
			    form = Operations_Users
			    record event = on add or edit
			    description = "Updates agent and hub assignment fields when the role changes"
			
			    on user input of Application_Role
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Application_Role == "Field Agent")
			                {
			                    show Agent_Role, Assigned_Beat, Assigned_Pincodes, Vehicle_Type, Maximum_Daily_Load_Kg, Current_Latitude, Current_Longitude, Last_Location_At;
			                    enable Agent_Role, Assigned_Beat, Assigned_Pincodes, Vehicle_Type, Maximum_Daily_Load_Kg;
			                    if(input.Work_Email != null && input.Work_Email.toLowerCase() == zoho.loginuserid.toLowerCase())
			                    {
			                        enable Current_Latitude, Current_Longitude;
			                    }
			                    else
			                    {
			                        disable Current_Latitude, Current_Longitude;
			                    }
			                    disable Last_Location_At;
			                }
			                else
			                {
			                    input.Agent_Role = "Not Applicable";
			                    input.Assigned_Beat = "";
			                    input.Assigned_Pincodes = "";
			                    input.Vehicle_Type = null;
			                    input.Maximum_Daily_Load_Kg = null;
			                    hide Agent_Role, Assigned_Beat, Assigned_Pincodes, Vehicle_Type, Maximum_Daily_Load_Kg, Current_Latitude, Current_Longitude, Last_Location_At;
			                }
			                if(input.Application_Role in {"Hub Supervisor","Hub Operator","Field Agent"})
			                {
			                    show Home_Hub, Deputed_Hub, Deputation_Start_Date, Deputation_End_Date;
			                }
			                else
			                {
			                    input.Home_Hub = null;
			                    input.Deputed_Hub = null;
			                    input.Deputation_Start_Date = null;
			                    input.Deputation_End_Date = null;
			                    hide Home_Hub, Deputed_Hub, Deputation_Start_Date, Deputation_End_Date;
			                }
			            )
			        }
			    }
			}

			Current_Latitude_On_User_Input as "Stamp Latitude Update"
			{
			    type = form
			    form = Operations_Users
			    record event = on add or edit
			    description = "Stamps the time when an agent updates latitude"
			
