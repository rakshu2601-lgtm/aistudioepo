		        row = 5
		        column = 1
		        width = medium
		    )
		    Outstanding_Balance
		    (
		        type = INR
		        displayname = "Outstanding Balance"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        initial value = 0
		        row = 5
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit Registration"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Profile"
		            )
		            Cancel
		            (
