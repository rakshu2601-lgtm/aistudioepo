		        Delivery_Address
		        Delivery_Pincode
		        Payment_Type
		        COD_Amount
		        Destination_Hub
		        NDR_Attempt_Count
		        Expected_Delivery_Date
		        Shipment_Status
		    )
		    filters
		    (
		        Customer
		        Delivery_Pincode
		        Payment_Type
		        Destination_Hub
		        Expected_Delivery_Date
		        Shipment_Status
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Destination_Hub ascending
		    )
		    sort by
		    (
		        Expected_Delivery_Date ascending
		    )
		}

		list My_Shipments
