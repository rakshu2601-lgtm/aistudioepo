			                        Actor_Email = zoho.adminuserid
			                        Actor_Profile = "System Schedule"
			                        Action_Name = "Expire Customer KYC"
			                        Module_Name = "Customers"
			                        Record_ID = input.ID.toString()
			                        Before_Data = "Status=Active"
			                        After_Data = "Status=KYC Expired"
			                        Source = "Schedule"
			                        Severity = "Warning"
			                    ];
			                }
			            )
			        }
			    }
			}

			Mark_Overdue_Invoices_Daily as "Mark Overdue Invoices Daily"
			{
			    type = schedule
			    start = "2026-01-01 03:00:00"
			    frequency = daily
			    time zone = "Asia/Kolkata"
			    description = "Marks due open invoices and their receivables overdue in bounded daily batches"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                overdue_invoices = Invoices[(Invoice_Status == "Issued" || Invoice_Status == "Part Paid") && Due_Date < zoho.currentdate] range from 0 to 199;
			                for each invoice_record in overdue_invoices
			                {
			                    prior_status = invoice_record.Invoice_Status;
			                    invoice_record.Invoice_Status = "Overdue";
			                    for each ledger_record in Account_Ledger[Invoice == invoice_record.ID && Ledger_Status != "Settled"]
			                    {
			                        ledger_record.Ledger_Status = "Overdue";
			                    }
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.adminuserid
			                        Actor_Profile = "System"
			                        Action_Name = "Mark Invoice Overdue"
			                        Module_Name = "Invoices"
			                        Record_ID = invoice_record.ID.toString()
			                        Before_Data = "Status=" + prior_status
			                        After_Data = "Status=Overdue; Due Date=" + invoice_record.Due_Date
			                        Source = "Schedule"
			                        Severity = "Warning"
			                    ];
			                }
			            )
			        }
			    }
			}

			Retry_Invoice_Document_Archive_Daily as "Retry Invoice Document Archive Daily"
			{
			    type = schedule
			    start = "2026-01-01 03:30:00"
			    frequency = daily
			    time zone = "Asia/Kolkata"
			    description = "Flags issued invoices whose WorkDrive archive still needs deployment configuration"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                pending_invoices = Invoices[Invoice_Status != "Draft" && Invoice_Status != "Void" && (Invoice_WorkDrive_File_ID == null || Invoice_WorkDrive_File_ID == "PENDING-WORKDRIVE-CONFIGURATION")] range from 0 to 199;
			                for each invoice_record in pending_invoices
			                {
			                    if(Audit_Log[Module_Name == "Invoices" && Record_ID == invoice_record.ID.toString() && Action_Name == "Invoice Archive Pending" && Event_Time >= zoho.currentdate].count(ID) == 0)
