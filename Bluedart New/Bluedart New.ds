	        section Hub_Actions { displayname = "Hub Actions" icon = "shopping-bag-17" report Unassigned_Orders {} report Open_Bags {} report In_Transit_Bags {} report Bag_Contents {} report Manifest_Bag_List {} report Expected_Master_Bags {} }
	    }
	    space Hub_Supervisor_Space
	    {
	        displayname = "Hub Supervisor" icon = "users-multiple-11"
	        section Supervisor_Actions { displayname = "Planning & Exceptions" icon = "business-agenda" report Today_Pickup_Planner {} report Pickup_Run_Register {} report Last_Mile_Dispatcher {} report NDR_Instruction_Action_Queue {} report Shipment_Exception_Queue {} }
	    }
	    space Operations_Manager_Space
	    {
	        displayname = "Operations Manager" icon = "business-strategy"
	        section Operations_Actions { displayname = "Network Operations" icon = "business-chart-bar-33" report All_Logistics_Bags {} report All_Manifests {} report Critical_Exceptions {} report Exception_Status_Board {} }
	    }
	    space Finance_Officer_Space
	    {
	        displayname = "Finance Officer" icon = "business-wallet-43"
	        section Finance_Actions { displayname = "Finance Actions" icon = "business-money-coins" report COD_Pending_Remittance {} report COD_Remittance_Register {} report Invoice_Statement {} report Payment_Transaction_Register {} report Failed_Payments {} }
	    }
	    space Logistics_Administrator_Space
	    {
	        displayname = "Logistics Administrator" icon = "business-hammer"
	        section Admin_Dashboard_Section { displayname = "Admin Dashboard" icon = "business-chart-bar-33" page Admin_Dashboard { icon = "business-chart-pie-36" } }
	        section Admin_Actions { displayname = "Audit & Configuration" icon = "business-connect" report App_Configurations {} report Audit_Log_Report {} report Critical_Audit_Events {} }
	        section SharedAnalytics_Section { type = shared_user_report_section displayname = "Reports" icon = "business-chart-bar-33" }
	    }
	    preference { icon { style = outline show = {space,section,component} } }
	}
	customize
	{
	    layout = twocolumncard
	    font = "lato"
	    style = "3"
	    color options
	    {
	        name = "BlueDart Accessible"
	        brand color = "#0756A3"
	        type = "custom"
	        dark mode color = "#72B7FF"
	    }
	    logo
	    {
	        preference = "app_icon"
	    }
	}
	}

	connections
	{
	    zoho_workdrive
	    (
	        displayname = "Zoho WorkDrive"
	        connector = zoho_workdrive
	        permissions = {"upload_file"}
	    )
	}
}
