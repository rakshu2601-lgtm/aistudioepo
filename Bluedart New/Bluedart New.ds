		            displayname = "State"
		        )
		        postal_Code
		        (
		            type = postal_Code
		            displayname = "Pincode"
		        )
		        country
		        (
		            type = country
		            displayname = "Country"
		        )
		        latitude
		        (
		            type = latitude
		            displayname = "Latitude"
		            visibility = false
		        )
		        longitude
		        (
		            type = longitude
		            displayname = "Longitude"
		            visibility = false
		        )
		        row = 2
		        column = 1
		        width = medium
		    )
		    Latitude
		    (
		        type = decimal
		        displayname = "Latitude"
		        decimalplace = 6
		        row = 2
		        column = 2
		        width = medium
		    )
		    Longitude
		    (
		        type = decimal
		        displayname = "Longitude"
		        decimalplace = 6
		        row = 2
		        column = 2
		        width = medium
		    )
		    Operating_Details
		    (
		        type = section
		        displayname = "Operating Details"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    must have Operating_Start_Time
		    (
		        type = time
		        displayname = "Operating Start Time"
		        row = 3
		        column = 1
		        width = medium
		    )
		    must have Operating_End_Time
		    (
		        type = time
		        displayname = "Operating End Time"
		        row = 3
		        column = 2
		        width = medium
		    )
		    must have Cut_Off_Time
		    (
		        type = time
		        displayname = "Cut-off Time"
		        row = 3
		        column = 1
		        width = medium
		    )
