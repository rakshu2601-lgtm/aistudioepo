		        row = 5
		        column = 1
		        width = medium
		    )
		    Quarterly_Eligible_Spend
		    (
		        type = INR
		        displayname = "Quarterly Eligible Spend"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        initial value = 0
		        row = 5
		        column = 2
		        width = medium
		    )
		    Loyalty_Tier_Last_Reviewed_At
		    (
		        type = datetime
