			Expire_Loyalty_Points_Daily as "Expire Loyalty Points Daily"
			{
			    type = schedule
			    start = "2025-01-01 01:00:00"
			    frequency = daily
			    time zone = "Asia/Kolkata"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                config_record = App_Configuration[Active == true] range from 0 to 0;
			                point_value = if(config_record.count(ID) > 0,config_record.Loyalty_Redemption_Value_Per_Point,1);
			                for each earning_record in Loyalty_Transactions[Points_Status == "Available" && Expiry_Date < zoho.currentdate && Points > 0] range from 0 to 199
			                {
			                    customer_record = Customers[ID == earning_record.Customer];
			                    expiring_points = earning_record.Points;
			                    unexpired_positive_points = Loyalty_Transactions[Customer == earning_record.Customer && Points_Status == "Available" && Expiry_Date >= zoho.currentdate && Points > 0].sum(Points);
			                    if(unexpired_positive_points == null)
			                    {
			                        unexpired_positive_points = 0;
			                    }
			                    maximum_expirable = ifnull(customer_record.Current_Loyalty_Points,0) - unexpired_positive_points;
			                    if(maximum_expirable < 0)
			                    {
			                        maximum_expirable = 0;
			                    }
			                    if(expiring_points > maximum_expirable)
			                    {
			                        expiring_points = maximum_expirable;
			                    }
			                    earning_record.Points_Status = "Expired";
			                    expiry_reference = "Expiry of loyalty transaction " + earning_record.Loyalty_Transaction_ID;
			                    existing_expiry = Loyalty_Transactions[Reference == expiry_reference];
			                    if(expiring_points > 0 && existing_expiry.count(ID) == 0)
			                    {
			                        expiry_id = insert into Loyalty_Transactions
			                        [
			                            Customer = earning_record.Customer
			                            Shipment = earning_record.Shipment
			                            Transaction_Type = "Expire"
			                            Points = 0 - expiring_points
			                            Amount_Equivalent = (expiring_points * point_value).round(2)
			                            Transaction_Date = zoho.currenttime
			                            Points_Status = "Expired"
			                            Applied_Tier = earning_record.Applied_Tier
			                            Reference = expiry_reference
			                            Notes = "Scheduled expiry of available loyalty points"
			                            Posted_By_Email = zoho.adminuserid
			                            Customer_Login_Email = earning_record.Customer_Login_Email
			                        ];
			                        customer_record.Current_Loyalty_Points = ifnull(customer_record.Current_Loyalty_Points,0) - expiring_points;
			                        audit_id = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.adminuserid
			                            Actor_Profile = "Scheduled Workflow"
			                            Action_Name = "Expire Loyalty Points"
			                            Module_Name = "Loyalty Transactions"
			                            Record_ID = expiry_id.toString()
			                            Before_Data = "Available points=" + (ifnull(customer_record.Current_Loyalty_Points,0) + expiring_points)
			                            After_Data = "Expired points=" + expiring_points + "; Available points=" + customer_record.Current_Loyalty_Points
			                            Source = "Schedule"
			                            Severity = "Warning"
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

			Recalculate_Loyalty_Tiers_Quarterly as "Recalculate Loyalty Tiers Quarterly"
			{
			    type = schedule
			    start = "2025-01-01 02:00:00"
			    frequency = daily
			    time zone = "Asia/Kolkata"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                current_month = zoho.currentdate.getMonth();
			                is_quarter_start = zoho.currentdate.getDay() == 1 && (current_month == 1 || current_month == 4 || current_month == 7 || current_month == 10);
			                quarter_start = zoho.currentdate.toStartOfMonth();
			                review_cutoff = quarter_start.addDay(-1);
			                if(is_quarter_start == true)
			                {
			                    for each customer_record in Customers[Active == true && (Customer_Type == "Corporate" || Customer_Type == "Wholesale") && (Loyalty_Tier_Last_Reviewed_At == null || Loyalty_Tier_Last_Reviewed_At < review_cutoff)] range from 0 to 199
			                    {
			                        prior_tier = customer_record.Current_Loyalty_Tier;
			                        eligible_spend = ifnull(customer_record.Quarterly_Eligible_Spend,0);
			                        qualifying_tier = Loyalty_Tiers[Active == true && (Applies_To == customer_record.Customer_Type || Applies_To == "Both" || Applies_To == "All") && Minimum_Quarterly_Spend <= eligible_spend && (Maximum_Quarterly_Spend == null || Maximum_Quarterly_Spend >= eligible_spend)] sort by Display_Order desc range from 0 to 0;
			                        new_tier = "None";
			                        if(qualifying_tier.count(ID) > 0)
			                        {
			                            new_tier = qualifying_tier.Tier_Name;
			                        }
			                        customer_record.Current_Loyalty_Tier = new_tier;
			                        customer_record.Quarterly_Eligible_Spend = 0;
			                        customer_record.Loyalty_Tier_Last_Reviewed_At = zoho.currenttime;
			                        if(prior_tier != new_tier)
			                        {
			                            recipient_email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID);
			                            communication_id = insert into Communication_Log
			                            [
			                                Customer = customer_record.ID
			                                Recipient = recipient_email
			                                Channel = "Email"
			                                Template_Code = "LOYALTY_TIER_CHANGED"
			                                Subject = "Your loyalty tier is now " + new_tier
			                                Message_Summary = "Quarterly qualification completed using eligible spend of INR " + eligible_spend + ". Tier changed from " + prior_tier + " to " + new_tier + "."
			                                Provider = "Zoho Mail"
			                                Communication_Status = "Sent"
			                                Attempt_Count = 1
			                                Last_Attempt_At = zoho.currenttime
			                            ];
			                            sendmail
			                            [
			                                from: zoho.adminuserid
			                                to: recipient_email
			                                subject: "Your loyalty tier is now " + new_tier
			                                message: "Your quarterly loyalty review is complete. Eligible spend: INR " + eligible_spend + ". Previous tier: " + prior_tier + ". Current tier: " + new_tier + "."
			                            ]
			                        }
			                        audit_id = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.adminuserid
			                            Actor_Profile = "Scheduled Workflow"
			                            Action_Name = "Recalculate Loyalty Tier"
			                            Module_Name = "Customers"
			                            Record_ID = customer_record.ID.toString()
			                            Before_Data = "Tier=" + prior_tier + "; Quarterly spend=" + eligible_spend
			                            After_Data = "Tier=" + new_tier + "; Quarterly spend reset to 0"
			                            Source = "Schedule"
			                            Severity = "Info"
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

			Reconcile_Failed_Payment as "Reconcile Failed Payment"
			{
			    type = schedule
			    form = Payment_Transactions[Payment_Status == "Failed"]
			    start = after 1 minutes from Completed_At
			    time zone = "Asia/Kolkata"
			    description = "Completes idempotent customer communication and audit processing after a native payment failure event"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                customer_record = Customers[ID == input.Customer];
			                shipment_record = Shipment_Requests[ID == input.Shipment];
			                if(customer_record.count(ID) > 0)
			                {
			                    recipient_email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID);
			                    failure_summary = "Payment transaction " + input.ID + " failed for INR " + input.Amount + "; order " + input.Gateway_Order_ID + ".";
			                    if(Communication_Log[Customer == customer_record.ID && Template_Code == "PAYMENT_FAILED" && Message_Summary == failure_summary].count(ID) == 0)
			                    {
			                        communication_id = insert into Communication_Log
			                        [
			                            Customer = customer_record.ID
			                            Shipment = input.Shipment
			                            Recipient = recipient_email
			                            Channel = "Email"
			                            Template_Code = "PAYMENT_FAILED"
			                            Subject = "Payment could not be confirmed"
			                            Message_Summary = failure_summary
			                            Provider = "Zoho Mail"
			                            Communication_Status = "Sent"
			                            Attempt_Count = 1
			                            Last_Attempt_At = zoho.currenttime
			                        ];
			                        sendmail
			                        [
			                            from: zoho.adminuserid
			                            to: recipient_email
			                            subject: "Payment could not be confirmed"
			                            message: "Your payment of INR " + input.Amount + " could not be confirmed. No paid status or ledger payment was posted. You may retry from the invoice."
			                        ]
			                    }
			                }
			                if(Audit_Log[Module_Name == "Payment Transactions" && Record_ID == input.ID.toString() && Action_Name == "Record Payment Failure"].count(ID) == 0)
			                {
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.adminuserid
			                        Actor_Profile = "Payment Gateway"
			                        Action_Name = "Record Payment Failure"
			                        Module_Name = "Payment Transactions"
			                        Record_ID = input.ID.toString()
			                        Before_Data = "Status=Initiated; Order=" + input.Gateway_Order_ID
			                        After_Data = "Status=Failed; Ledger posting=None"
			                        Source = "Payment"
			                        Severity = "Warning"
			                    ];
			                }
			            )
			        }
			    }
			}

			Reconcile_Successful_Payment as "Reconcile Successful Payment"
			{
			    type = schedule
			    form = Payment_Transactions[Payment_Status == "Success"]
			    start = after 1 minutes from Completed_At
			    time zone = "Asia/Kolkata"
			    description = "Completes idempotent ledger, invoice, shipment, communication, and audit processing after a native payment success event"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                customer_record = Customers[ID == input.Customer];
			                invoice_record = Invoices[ID == input.Invoice];
			                shipment_record = Shipment_Requests[ID == input.Shipment];
			                references_valid = customer_record.count(ID) > 0 && invoice_record.count(ID) > 0 && shipment_record.count(ID) > 0 && invoice_record.Customer == customer_record.ID && invoice_record.Shipment == shipment_record.ID && shipment_record.Customer == customer_record.ID;
			                if(references_valid == false)
			                {
			                    input.Payment_Status = "Failed";
			                    input.Gateway_Response_Summary = "Provider reported success, but internal customer, invoice, or shipment references failed reconciliation.";
			                    input.Failure_Reason = "Internal reference validation failed; no ledger payment was posted.";
			                    if(Audit_Log[Module_Name == "Payment Transactions" && Record_ID == input.ID.toString() && Action_Name == "Reject Payment Reconciliation"].count(ID) == 0)
			                    {
			                        audit_id = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.adminuserid
			                            Actor_Profile = "Payment Gateway"
			                            Action_Name = "Reject Payment Reconciliation"
			                            Module_Name = "Payment Transactions"
			                            Record_ID = input.ID.toString()
			                            Before_Data = "Provider event=Success; Status=Initiated"
			                            After_Data = "Status=Failed; Ledger posting=Blocked"
			                            Source = "Payment"
			                            Severity = "Critical"
			                        ];
			                    }
			                }
			                else
			                {
			                    payment_reference = if(ifnull(input.Gateway_Payment_ID,"").trim() != "",input.Gateway_Payment_ID,"CREATOR-PAY-" + input.ID);
			                    existing_payment_ledger = Account_Ledger[Payment_Reference == payment_reference && Transaction_Type == "Payment"];
			                    if(existing_payment_ledger.count(ID) == 0)
			                    {
			                        ledger_id = insert into Account_Ledger
			                        [
			                            Customer = customer_record.ID
			                            Shipment = shipment_record.ID
			                            Invoice = invoice_record.ID
			                            Transaction_Type = "Payment"
			                            Amount = input.Amount
			                            Transaction_Date = zoho.currenttime
			                            Ledger_Status = "Settled"
			                            Ageing_Bucket = "Not Applicable"
			                            Payment_Reference = payment_reference
			                            Notes = "Payment posted only after Zoho Creator received the native payment success event."
			                            Posted_By_Email = zoho.adminuserid
			                            Customer_Login_Email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID)
			                        ];
			                        input.Ledger_Entry = ledger_id;
			                    }
			                    else
			                    {
			                        input.Ledger_Entry = existing_payment_ledger.ID;
			                    }
			                    input.Gateway_Payment_ID = payment_reference;
			                    input.Gateway_Response_Summary = "Verified by Zoho Creator native payment success event; sensitive provider response data was not stored.";
			                    input.Failure_Reason = "";
			                    verified_paid_total = ifnull(Account_Ledger[Invoice == invoice_record.ID && Transaction_Type == "Payment"].sum(Amount),0);
			                    if(verified_paid_total + 0.01 >= ifnull(invoice_record.Invoice_Total,0))
			                    {
			                        invoice_record.Invoice_Status = "Paid";
			                        shipment_record.Payment_Status = "Paid";
			                    }
			                    else
			                    {
			                        invoice_record.Invoice_Status = "Part Paid";
			                        shipment_record.Payment_Status = "Pending";
			                    }
			                    for each debit_record in Account_Ledger[Invoice == invoice_record.ID && Transaction_Type == "Debit"]
			                    {
			                        debit_record.Ledger_Status = if(verified_paid_total + 0.01 >= debit_record.Amount,"Settled","Partially Settled");
			                        debit_record.Notes = ifnull(debit_record.Notes,"") + " | Verified payments total INR " + verified_paid_total + ".";
			                    }
			                    recalculated_outstanding = thisapp.Recalculate_Customer_Outstanding(customer_record.ID);
			                    if(customer_record.Onboarding_Status == "Active" && (customer_record.KYC_Expiry_Date == null || customer_record.KYC_Expiry_Date >= zoho.currentdate))
			                    {
			                        projected_exposure = recalculated_outstanding;
			                        held_shipments = Shipment_Requests[Customer == customer_record.ID && Shipment_Status == "Credit Hold" && Credit_Check_Status == "Hold"] sort by Booked_On range from 0 to 199;
			                        for each held_shipment in held_shipments
			                        {
			                            proposed_exposure = projected_exposure + ifnull(held_shipment.Total_Payable,0);
			                            if(proposed_exposure <= ifnull(customer_record.Approved_Credit_Limit,0))
			                            {
			                                held_shipment.Credit_Check_Status = "Passed";
			                                held_shipment.Shipment_Status = if(held_shipment.Collection_Center == null,"Booked - Hub Assignment Pending","Booked");
			                                projected_exposure = proposed_exposure;
			                                tracking_id = insert into Shipment_Tracking_Events
			                                [
			                                    Shipment = held_shipment.ID
			                                    Event_Time = zoho.currenttime
			                                    Event_Status = held_shipment.Shipment_Status
			                                    Hub = held_shipment.Current_Hub
			                                    Event_Description = "Credit hold released after verified payment reduced account exposure."
			                                    Source = "Account Ledger"
			                                    Customer_Visible = true
			                                    Created_By_Email = zoho.adminuserid
			                                ];
			                            }
			                        }
			                    }
			                    recipient_email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID);
			                    confirmation_summary = "Payment transaction " + input.ID + " was verified for INR " + input.Amount + "; reference " + payment_reference + ".";
			                    if(Communication_Log[Customer == customer_record.ID && Template_Code == "PAYMENT_CONFIRMED" && Message_Summary == confirmation_summary].count(ID) == 0)
			                    {
			                        communication_id = insert into Communication_Log
			                        [
			                            Customer = customer_record.ID
			                            Shipment = shipment_record.ID
			                            Recipient = recipient_email
			                            Channel = "Email"
			                            Template_Code = "PAYMENT_CONFIRMED"
			                            Subject = "Payment confirmed for invoice INV-" + invoice_record.Invoice_Number
			                            Message_Summary = confirmation_summary
			                            Provider = "Zoho Mail"
			                            Communication_Status = "Sent"
			                            Attempt_Count = 1
			                            Last_Attempt_At = zoho.currenttime
			                        ];
			                        sendmail
			                        [
			                            from: zoho.adminuserid
			                            to: recipient_email
			                            subject: "Payment confirmed for invoice INV-" + invoice_record.Invoice_Number
			                            message: "We verified your payment of INR " + input.Amount + " for AWB " + shipment_record.AWB_Number + ". Payment reference: " + payment_reference + "."
			                        ]
			                    }
			                    if(Audit_Log[Module_Name == "Payment Transactions" && Record_ID == input.ID.toString() && Action_Name == "Verify Payment"].count(ID) == 0)
			                    {
			                        audit_id = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.adminuserid
			                            Actor_Profile = "Payment Gateway"
			                            Action_Name = "Verify Payment"
			                            Module_Name = "Payment Transactions"
			                            Record_ID = input.ID.toString()
			                            Before_Data = "Status=Initiated; Invoice Status=" + invoice_record.Invoice_Status
			                            After_Data = "Status=Success; Reference=" + payment_reference + "; Paid total=" + verified_paid_total + "; Outstanding=" + recalculated_outstanding
			                            Source = "Payment"
			                            Severity = "Critical"
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}
		}

		functions
		{
			Mark_Bag_Shipment_Damaged as "Mark Bag Shipment Damaged"
			{
			    type = functions
			    form = Bag_Shipments
			    execution type = for each record
			    description = "Records damage found during destination reconciliation and opens an exception"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = "POC Process User";
			                bag_record = Logistics_Bags[ID == input.Bag];
			                logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                deputation_active = logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate);
			                effective_hub = logged_user.Home_Hub;
			                if(deputation_active == true)
			                {
			                    effective_hub = logged_user.Deputed_Hub;
			                }
			                authorised = logged_user.count(ID) > 0 && effective_hub == bag_record.Destination_Hub;
			                if(authorised == false)
			                {
			                    info "Only an active operations user at the destination hub can reconcile this AWB.";
			                }
			                else if((bag_record.Bag_Status != "Received" && bag_record.Bag_Status != "Exception") || input.Scan_Status != "Loaded")
			                {
			                    info "The bag must be received or quarantined and the AWB must still be awaiting reconciliation.";
			                }
			                else
			                {
			                    notes = ifnull(input.Exception_Notes,"").trim();
			                    if(notes == "")
			                    {
			                        notes = "Shipment damage was observed during destination bag reconciliation. Evidence must be attached during investigation.";
			                    }
			                    input.Scan_Status = "Damaged";
			                    input.Received_At = zoho.currenttime;
			                    input.Exception_Notes = notes;
			                    bag_record.Bag_Status = "Exception";
			                    shipment_record = Shipment_Requests[ID == input.Shipment];
			                    shipment_record.Current_Hub = bag_record.Destination_Hub;
			                    exception_id = insert into Shipment_Exceptions
			                    [
			                        Shipment = input.Shipment
			                        Bag = input.Bag
			                        Exception_Type = "Damaged"
			                        Severity = "High"
			                        Reporting_Hub = bag_record.Destination_Hub
			                        Reported_By_Email = zoho.loginuserid
			                        Reported_At = zoho.currenttime
			                        Notes = notes
			                        Exception_Status = "Open"
			                    ];
			                    tracking_id = insert into Shipment_Tracking_Events
			                    [
			                        Shipment = input.Shipment
			                        Event_Time = zoho.currenttime
			                        Event_Status = "Exception"
			                        Hub = bag_record.Destination_Hub
			                        Bag = input.Bag
			                        Event_Description = "Shipment condition requires operational review following bag reconciliation."
			                        Source = "Bag"
			                        Customer_Visible = true
			                        Created_By_Email = zoho.loginuserid
			                    ];
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuserid
			                        Actor_Profile = current_profile
			                        Action_Name = "Mark Bag Shipment Damaged"
			                        Module_Name = "Bag Shipments"
			                        Record_ID = input.ID.toString()
			                        Before_Data = "Status=Loaded"
			                        After_Data = "Status=Damaged; Exception=" + exception_id + "; Hub=" + bag_record.Destination_Hub
			                        Source = "Report Action"
			                        Severity = "Critical"
			                    ];
			                }
			            )
			        }
			    }
			}

			Mark_Bag_Shipment_Missing as "Mark Bag Shipment Missing"
			{
			    type = functions
			    form = Bag_Shipments
			    execution type = for each record
			    description = "Marks an expected AWB missing during destination reconciliation and opens an exception"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = "POC Process User";
			                bag_record = Logistics_Bags[ID == input.Bag];
			                logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                deputation_active = logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate);
			                effective_hub = logged_user.Home_Hub;
			                if(deputation_active == true)
			                {
			                    effective_hub = logged_user.Deputed_Hub;
			                }
			                authorised = logged_user.count(ID) > 0 && effective_hub == bag_record.Destination_Hub;
			                if(authorised == false)
			                {
			                    info "Only an active operations user at the destination hub can reconcile this AWB.";
			                }
			                else if((bag_record.Bag_Status != "Received" && bag_record.Bag_Status != "Exception") || input.Scan_Status != "Loaded")
			                {
			                    info "The bag must be received or quarantined and the AWB must still be awaiting reconciliation.";
			                }
			                else
			                {
			                    notes = ifnull(input.Exception_Notes,"").trim();
			                    if(notes == "")
			                    {
			                        notes = "Expected AWB was not found during destination bag reconciliation. Evidence must be attached during investigation.";
			                    }
			                    input.Scan_Status = "Missing";
			                    input.Exception_Notes = notes;
			                    bag_record.Bag_Status = "Exception";
			                    exception_id = insert into Shipment_Exceptions
			                    [
			                        Shipment = input.Shipment
			                        Bag = input.Bag
			                        Exception_Type = "Missing"
			                        Severity = "High"
			                        Reporting_Hub = bag_record.Destination_Hub
			                        Reported_By_Email = zoho.loginuserid
			                        Reported_At = zoho.currenttime
			                        Notes = notes
			                        Exception_Status = "Open"
			                    ];
			                    tracking_id = insert into Shipment_Tracking_Events
			                    [
			                        Shipment = input.Shipment
			                        Event_Time = zoho.currenttime
			                        Event_Status = "Exception"
			                        Hub = bag_record.Destination_Hub
			                        Bag = input.Bag
			                        Event_Description = "Shipment is under operational review following bag reconciliation."
			                        Source = "Bag"
			                        Customer_Visible = true
			                        Created_By_Email = zoho.loginuserid
			                    ];
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuserid
			                        Actor_Profile = current_profile
			                        Action_Name = "Mark Bag Shipment Missing"
			                        Module_Name = "Bag Shipments"
			                        Record_ID = input.ID.toString()
			                        Before_Data = "Status=Loaded"
			                        After_Data = "Status=Missing; Exception=" + exception_id
			                        Source = "Report Action"
			                        Severity = "Critical"
			                    ];
			                }
			            )
			        }
			    }
			}

			Mark_Bag_Shipment_Received as "Mark Bag Shipment Received"
			{
			    type = functions
			    form = Bag_Shipments
			    execution type = for each record
			    description = "Confirms physical receipt of an expected AWB and advances its hub milestone"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = "POC Process User";
			                bag_record = Logistics_Bags[ID == input.Bag];
			                logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                deputation_active = logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate);
			                effective_hub = logged_user.Home_Hub;
			                if(deputation_active == true)
			                {
			                    effective_hub = logged_user.Deputed_Hub;
			                }
			                authorised = logged_user.count(ID) > 0 && effective_hub == bag_record.Destination_Hub;
			                if(authorised == false)
			                {
			                    info "Only an active operations user at the destination hub can reconcile this AWB.";
			                }
			                else if((bag_record.Bag_Status != "Received" && bag_record.Bag_Status != "Exception") || input.Scan_Status != "Loaded")
			                {
			                    info "The bag must be received or quarantined and the AWB must still be awaiting reconciliation.";
			                }
			                else
			                {
			                    milestone = "Arrived at Destination Hub";
			                    if(bag_record.Bag_Type == "Feeder")
			                    {
			                        milestone = "Sorted at Origin Hub";
			                    }
			                    else if(bag_record.Bag_Type == "Delivery Feeder")
			                    {
			                        milestone = "At Delivery Hub";
			                    }
			                    else if(bag_record.Bag_Type == "Return")
			                    {
			                        milestone = "Return to Origin";
			                    }
			                    input.Scan_Status = "Received";
			                    input.Received_At = zoho.currenttime;
			                    input.Exception_Notes = "";
			                    shipment_record = Shipment_Requests[ID == input.Shipment];
			                    shipment_record.Shipment_Status = milestone;
			                    shipment_record.Current_Hub = bag_record.Destination_Hub;
			                    tracking_id = insert into Shipment_Tracking_Events
			                    [
			                        Shipment = input.Shipment
			                        Event_Time = zoho.currenttime
			                        Event_Status = milestone
			                        Hub = bag_record.Destination_Hub
			                        Bag = input.Bag
			                        Event_Description = "Shipment reconciled as received from the " + bag_record.Bag_Type + " bag."
			                        Source = "Bag"
			                        Customer_Visible = true
			                        Created_By_Email = zoho.loginuserid
			                    ];
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuserid
			                        Actor_Profile = current_profile
			                        Action_Name = "Mark Bag Shipment Received"
			                        Module_Name = "Bag Shipments"
			                        Record_ID = input.ID.toString()
			                        Before_Data = "Status=Loaded"
			                        After_Data = "Status=Received; Milestone=" + milestone + "; Hub=" + bag_record.Destination_Hub
			                        Source = "Report Action"
			                        Severity = "Critical"
			                    ];
			                }
			            )
			        }
			    }
			}

			Remove_Bag_Shipment as "Remove Shipment from Bag"
			{
			    type = functions
			    form = Bag_Shipments
			    execution type = for each record
			    description = "Removes an AWB from an open bag while preserving scan evidence and recalculating totals"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = "POC Process User";
			                bag_record = Logistics_Bags[ID == input.Bag];
			                logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                deputation_active = logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate);
			                effective_hub = logged_user.Home_Hub;
			                if(deputation_active == true)
			                {
			                    effective_hub = logged_user.Deputed_Hub;
			                }
			                authorised = logged_user.count(ID) > 0 && effective_hub == bag_record.Origin_Hub;
			                if(authorised == false)
			                {
			                    info "Only an active operations user at the origin hub can remove this AWB.";
			                }
			                else if(bag_record.Bag_Status != "Open" || input.Scan_Status != "Loaded")
			                {
			                    info "An AWB can be removed only while its bag is open and the scan is loaded.";
			                }
			                else
			                {
			                    input.Scan_Status = "Removed";
			                    input.Exception_Notes = "Removed from the open bag by " + zoho.loginuserid + " on " + zoho.currenttime;
			                    shipment_count = 0;
			                    total_weight = 0.0;
			                    for each remaining_item in Bag_Shipments[Bag == input.Bag && Scan_Status == "Loaded" && ID != input.ID]
			                    {
			                        shipment_count = shipment_count + 1;
			                        shipment_record = Shipment_Requests[ID == remaining_item.Shipment];
			                        total_weight = total_weight + ifnull(shipment_record.Billable_Weight_Kg,0);
			                    }
			                    bag_record.Total_Shipments = shipment_count;
			                    bag_record.Total_Weight_Kg = total_weight;
			                    tracking_id = insert into Shipment_Tracking_Events
			                    [
			                        Shipment = input.Shipment
			                        Event_Time = zoho.currenttime
			                        Event_Status = "Information"
			                        Hub = bag_record.Origin_Hub
			                        Bag = input.Bag
			                        Event_Description = "Shipment was removed from an open bag before sealing."
			                        Source = "Bag"
			                        Customer_Visible = false
			                        Created_By_Email = zoho.loginuserid
			                    ];
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuserid
			                        Actor_Profile = current_profile
			                        Action_Name = "Remove Shipment from Bag"
			                        Module_Name = "Bag Shipments"
			                        Record_ID = input.ID.toString()
			                        Before_Data = "Status=Loaded"
			                        After_Data = "Status=Removed; BagShipments=" + shipment_count + "; BagWeight=" + total_weight
			                        Source = "Report Action"
			                        Severity = "Critical"
			                    ];
			                }
			            )
			        }
			    }
			}

			Confirm_COD_Pending_Remittance as "Confirm Remittance - COD Pending"
			{
			    type = functions
			    form = COD_Remittances
			    execution type = for each record
			    description = "Confirms cashier custody, flags shortfalls, calculates payout due date, and posts COD settlement credits"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = "POC Process User";
			                current_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                effective_hub = if(current_user.count(ID) > 0 && current_user.Deputed_Hub != null && (current_user.Deputation_Start_Date == null || current_user.Deputation_Start_Date <= input.Remittance_Date) && (current_user.Deputation_End_Date == null || current_user.Deputation_End_Date >= input.Remittance_Date),current_user.Deputed_Hub,current_user.Home_Hub);
			                authorised = current_user.count(ID) > 0 && effective_hub == input.Hub;
			                run_record = Delivery_Run_Sheets[ID == input.Delivery_Run_Sheet];
			                expected_amount = 0.0;
			                for each delivered_item in Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.Delivery_Run_Sheet && Delivery_Status == "Delivered"]
			                {
			                    shipment_record = Shipment_Requests[ID == delivered_item.Shipment];
			                    if(shipment_record.count(ID) > 0 && shipment_record.Payment_Type == "COD")
			                    {
			                        expected_amount = expected_amount + ifnull(shipment_record.COD_Amount,0);
			                    }
			                }
			                submitted_amount = ifnull(input.Submitted_Amount,0);
			                shortfall_amount = expected_amount - submitted_amount;
			                assigned_agent = Operations_Users[ID == input.Agent];
			                if(authorised == false)
			                {
			                    info "Only Finance or an authorised operations supervisor can confirm COD cash.";
			                }
			                else if(input.Remittance_Status == "Confirmed")
			                {
			                    info "This COD remittance is already confirmed.";
			                }
			                else if(run_record.count(ID) == 0 || run_record.DRS_Status != "Completed" || run_record.Assigned_Agent != input.Agent || run_record.Hub != input.Hub)
			                {
			                    info "The remittance no longer matches a completed delivery run.";
			                }
			                else if(expected_amount <= 0 || submitted_amount < 0 || submitted_amount > expected_amount)
			                {
			                    info "Submitted cash must be between zero and the delivered COD total.";
			                }
			                else
			                {
			                    prior_status = input.Remittance_Status;
			                    input.Expected_Amount = expected_amount;
			                    input.Shortfall_Amount = shortfall_amount;
			                    input.Cashier_Email = zoho.loginuserid;
			                    input.Confirmed_At = zoho.currenttime;
			                    if(shortfall_amount > 0.01)
			                    {
			                        input.Remittance_Status = "Shortfall";
			                        input.Customer_Payout_Due_Date = null;
			                        input.Notes = ifnull(input.Notes,"") + "\nCashier identified an INR " + shortfall_amount + " shortfall on " + zoho.currenttime + ".";
			                        if(assigned_agent.count(ID) > 0)
			                        {
			                            sendmail
			                            [
			                                from: zoho.adminuserid
			                                to: assigned_agent.Work_Email
			                                subject: "COD cash shortfall: DRS " + run_record.DRS_Number
			                                message: "Finance identified a COD cash shortfall of INR " + shortfall_amount + ". Submit the balance and update the remittance record."
			                            ]
			                            communication_id = insert into Communication_Log
			                            [
			                                Recipient = assigned_agent.Work_Email
			                                Channel = "Email"
			                                Template_Code = "COD_SHORTFALL"
			                                Subject = "COD cash shortfall: DRS " + run_record.DRS_Number
			                                Message_Summary = "Agent notified of INR " + shortfall_amount + " COD shortfall."
			                                Provider = "Zoho Mail"
			                                Communication_Status = "Sent"
			                                Attempt_Count = 1
			                                Last_Attempt_At = zoho.currenttime
			                            ];
			                        }
			                        audit_id = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.loginuserid
			                            Actor_Profile = current_profile
			                            Action_Name = "Confirm COD Shortfall"
			                            Module_Name = "COD Remittances"
			                            Record_ID = input.ID.toString()
			                            Before_Data = "Status=" + prior_status + "; Expected=" + expected_amount + "; Submitted=" + submitted_amount
			                            After_Data = "Status=Shortfall; Shortfall=" + shortfall_amount
			                            Source = "Report Action"
			                            Severity = "Critical"
			                        ];
			                    }
			                    else
			                    {
			                        config_record = App_Configuration[Active == true] range from 0 to 0;
			                        payout_cycle = if(config_record.count(ID) > 0,config_record.COD_Payout_Cycle,"T+2");
			                        payout_due_date = if(payout_cycle == "Weekly",zoho.currentdate.toStartOfWeek().addDay(8),zoho.currentdate.addBusinessDay(2));
			                        input.Remittance_Status = "Confirmed";
			                        input.Shortfall_Amount = 0;
			                        input.Customer_Payout_Due_Date = payout_due_date;
			                        for each delivered_item in Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.Delivery_Run_Sheet && Delivery_Status == "Delivered" && COD_Collected > 0]
			                        {
			                            shipment_record = Shipment_Requests[ID == delivered_item.Shipment];
			                            customer_record = Customers[ID == shipment_record.Customer];
			                            payment_reference = "COD-" + input.Remittance_Number + "-" + shipment_record.AWB_Number;
			                            if(Account_Ledger[Payment_Reference == payment_reference].count(ID) == 0)
			                            {
			                                ledger_id = insert into Account_Ledger
			                                [
			                                    Customer = shipment_record.Customer
			                                    Shipment = shipment_record.ID
			                                    Transaction_Type = "COD Settlement"
			                                    Amount = delivered_item.COD_Collected
			                                    Transaction_Date = zoho.currenttime
			                                    Due_Date = payout_due_date
			                                    Ledger_Status = "Open"
			                                    Payment_Reference = payment_reference
			                                    Notes = "COD confirmed from DRS " + run_record.DRS_Number + "."
			                                    Posted_By_Email = zoho.loginuserid
			                                    Customer_Login_Email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID)
			                                ];
			                            }
			                            thisapp.Recalculate_Customer_Outstanding(shipment_record.Customer);
			                        }
			                        if(assigned_agent.count(ID) > 0)
			                        {
			                            sendmail
			                            [
			                                from: zoho.adminuserid
			                                to: assigned_agent.Work_Email
			                                subject: "COD cash confirmed: DRS " + run_record.DRS_Number
			                                message: "Finance confirmed COD cash of INR " + expected_amount + ". Customer payout is due on " + payout_due_date + "."
			                            ]
			                        }
			                        audit_id = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.loginuserid
			                            Actor_Profile = current_profile
			                            Action_Name = "Confirm COD Remittance"
			                            Module_Name = "COD Remittances"
			                            Record_ID = input.ID.toString()
			                            Before_Data = "Status=" + prior_status + "; Expected=" + expected_amount + "; Submitted=" + submitted_amount
			                            After_Data = "Status=Confirmed; Payout Cycle=" + payout_cycle + "; Payout Due=" + payout_due_date
			                            Source = "Report Action"
			                            Severity = "Critical"
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

			Confirm_COD_Remittance as "Confirm Remittance - COD Remittances"
			{
