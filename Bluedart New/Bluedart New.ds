			Communication_Log_On_Load as "Protect Communication Outcome"
			{
			    type = form
			    form = Communication_Log
			    record event = on add or edit
			    description = "Protects provider outcome fields and keeps customer portal users out of the internal queue"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Communication_Status, Attempt_Count, Last_Attempt_At, Provider_Message_ID, Failure_Reason;
			                if(thisapp.permissions.loginUserProfile() == "Customer_Portal")
			                {
			                    alert "Communication delivery records are available only to authorised internal teams.";
			                    openUrl("#Page:Customer_Dashboard","same window");
			                }
			                if(input.ID != null && ifnull(input.Attempt_Count,0) > 0)
			                {
			                    disable Customer, Shipment, Recipient, Channel, Template_Code, Subject, Message_Summary, Provider;
			                }
			            )
			        }
			    }
			}

			Communication_Log_On_Success as "Audit Communication Queue"
			{
			    type = form
			    form = Communication_Log
			    record event = on add
			    description = "Records evidence whenever a new communication is queued or logged"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = if(ifnull(zoho.loginuserid,"").trim() != "",zoho.loginuserid,zoho.adminuserid)
			                    Actor_Profile = if(ifnull(zoho.loginuserid,"").trim() != "",thisapp.permissions.loginUserProfile(),"System")
			                    Action_Name = "Record Communication"
			                    Module_Name = "Communication Log"
			                    Record_ID = input.ID.toString()
			                    After_Data = "Channel=" + input.Channel + "; Template=" + input.Template_Code + "; Status=" + input.Communication_Status + "; Provider=" + input.Provider
			                    Source = "Form Workflow"
			                    Severity = if(input.Communication_Status == "Failed","Warning","Info")
			                ];
			            )
			        }
			    }
			}

			Communication_Log_On_Validate as "Validate Communication Queue"
			{
			    type = form
			    form = Communication_Log
			    record event = on add or edit
			    description = "Validates queue ownership, channel addressing, and immutable provider outcomes"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(ifnull(input.Attempt_Count,0) < 0)
			                {
			                    alert "Attempt count cannot be negative.";
			                    cancel submit;
			                }
			                if(input.Channel == "Email" && input.Recipient.matches("[a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+)*@(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?\\.)+[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?") == false)
			                {
			                    alert "Enter a valid email recipient for an email communication.";
			                    cancel submit;
			                }
			                if(input.ID == null)
			                {
			                    input.Attempt_Count = ifnull(input.Attempt_Count,0);
			                    if(input.Communication_Status == "Queued")
			                    {
			                        input.Last_Attempt_At = null;
			                        input.Provider_Message_ID = "";
			                        input.Failure_Reason = "";
			                    }
			                    else if(input.Attempt_Count == 0)
			                    {
			                        input.Attempt_Count = 1;
			                        input.Last_Attempt_At = zoho.currenttime;
			                    }
			                }
			                else
			                {
			                    existing_record = Communication_Log[ID == input.ID];
			                    if(existing_record.count(ID) > 0 && ifnull(existing_record.Attempt_Count,0) > 0 && (input.Recipient != existing_record.Recipient || input.Channel != existing_record.Channel || input.Template_Code != existing_record.Template_Code || input.Provider != existing_record.Provider || input.Subject != existing_record.Subject || input.Message_Summary != existing_record.Message_Summary))
			                    {
			                        alert "Attempted communications are immutable. Queue a new communication instead.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Customer_KYC_Documents_On_Load as "Secure KYC Document Form"
			{
			    type = form
			    form = Customer_KYC_Documents
			    record event = on add or edit
			    description = "Locks system and review fields, enforces portal ownership, and unlocks only pending or queried uploads"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Customer, Document_Type, Required_For_Onboarding, File_Version, Review_Status, Uploaded_On, Reviewed_By_Email, Reviewed_On, Locked_After_Verification;
			                is_portal = thisapp.portal.isUserInProfile("Customer_Portal");
			                if(is_portal == true)
			                {
			                    disable Review_Remarks;
			                    customer_record = Customers[ID == input.Customer];
			                    owner_match = customer_record.Email_ID == zoho.loginuserid || customer_record.Portal_Login_Email == zoho.loginuserid;
			                    if(owner_match == false)
			                    {
			                        disable Document_Number, Expiry_Date, Uploaded_File;
			                        alert "You are not authorised to access this KYC document.";
			                        openUrl("#Page:Customer_Dashboard","same window");
			                    }
			                    else if(input.Review_Status == "Pending Upload" || input.Review_Status == "Query")
			                    {
			                        enable Document_Number, Expiry_Date, Uploaded_File;
			                    }
			                    else
			                    {
			                        disable Document_Number, Expiry_Date, Uploaded_File;
			                    }
			                }
			                else
			                {
			                    disable Document_Number, Expiry_Date, Uploaded_File;
			                    enable Review_Remarks;
			                }
			                if(input.Review_Status == "Verified" || input.Locked_After_Verification == true)
			                {
			                    disable Document_Number, Expiry_Date, Uploaded_File, Review_Remarks;
			                }
			            )
			        }
			    }
			}

			Customer_KYC_Documents_On_Success as "Recompute Customer KYC Progress"
			{
			    type = form
			    form = Customer_KYC_Documents
			    record event = on add or edit
			    description = "Moves the parent customer to verification when every required checklist item is uploaded and audits the document save"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                customer_record = Customers[ID == input.Customer];
			                required_count = Customer_KYC_Documents[Customer == input.Customer && Required_For_Onboarding == true].count(ID);
			                incomplete_count = Customer_KYC_Documents[Customer == input.Customer && Required_For_Onboarding == true && Review_Status != "Pending Verification" && Review_Status != "Verified"].count(ID);
			                if(required_count > 0 && incomplete_count == 0 && customer_record.Onboarding_Status != "Active")
			                {
			                    customer_record.Onboarding_Status = "Pending Verification";
			                    customer_record.KYC_Submitted_On = zoho.currenttime;
			                    communication_id = insert into Communication_Log
			                    [
			                        Customer = customer_record.ID
			                        Recipient = customer_record.Email_ID
			                        Channel = "Portal Notification"
			                        Template_Code = "KYC_SUBMITTED"
			                        Subject = "KYC submitted for verification"
			                        Message_Summary = "All required KYC checklist items are uploaded and awaiting review."
			                        Provider = "Other"
			                        Communication_Status = "Queued"
			                        Attempt_Count = 0
			                    ];
			                }
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = "KYC Document Management"
			                    Action_Name = "Save KYC Document"
			                    Module_Name = "Customer_KYC_Documents"
			                    Record_ID = input.ID.toString()
			                    After_Data = "Customer=" + input.Customer + "; Document Type=" + input.Document_Type + "; Version=" + input.File_Version + "; Status=" + input.Review_Status
			                    Source = "Form Workflow"
			                    Severity = "Info"
			                ];
			            )
			        }
			    }
			}

			Customer_KYC_Documents_On_Validate as "Validate KYC Document"
			{
			    type = form
			    form = Customer_KYC_Documents
			    record event = on add or edit
			    description = "Validates document ownership, preset requirements, upload format and size, versioning, and verified-record locks"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                customer_record = Customers[ID == input.Customer];
			                document_type = KYC_Document_Types[ID == input.Document_Type];
			                duplicate_count = Customer_KYC_Documents[Customer == input.Customer && Document_Type == input.Document_Type && ID != input.ID].count(ID);
			                if(duplicate_count > 0)
			                {
			                    alert "This customer already has a checklist item for the selected document type.";
			                    cancel submit;
			                }
			                is_portal = thisapp.portal.isUserInProfile("Customer_Portal");
			                if(is_portal == true && customer_record.Email_ID != zoho.loginuserid && customer_record.Portal_Login_Email != zoho.loginuserid)
			                {
			                    alert "You cannot update another customer's KYC document.";
			                    cancel submit;
			                }
			                previous_record = Customer_KYC_Documents[ID == input.ID];
			                if(input.ID != null && previous_record.Review_Status == "Verified")
			                {
			                    alert "Verified documents are locked. An authorised reviewer must request re-KYC before replacement.";
			                    cancel submit;
			                }
			                file_changed = input.ID == null || previous_record.Uploaded_File != input.Uploaded_File;
			                if(is_portal == true && input.ID != null && file_changed == false)
			                {
			                    if(previous_record.Customer != input.Customer || previous_record.Document_Type != input.Document_Type || previous_record.Required_For_Onboarding != input.Required_For_Onboarding || previous_record.File_Version != input.File_Version || previous_record.Review_Status != input.Review_Status || previous_record.Uploaded_On != input.Uploaded_On || previous_record.Reviewed_By_Email != input.Reviewed_By_Email || previous_record.Reviewed_On != input.Reviewed_On || previous_record.Locked_After_Verification != input.Locked_After_Verification || previous_record.Review_Remarks != input.Review_Remarks)
			                    {
			                        alert "Review, version, ownership, and system fields are managed by authorised workflows.";
			                        cancel submit;
			                    }
			                }
			                if(file_changed == true && input.ID != null && previous_record.Review_Status != "Pending Upload" && previous_record.Review_Status != "Query")
			                {
			                    alert "Only documents in Pending Upload or Query status can be uploaded again.";
			                    cancel submit;
			                }
			                if(document_type.Document_Number_Required == true && ifnull(input.Document_Number,"").trim() == "")
			                {
			                    alert "Document number is required for this KYC document type.";
			                    cancel submit;
			                }
			                if(document_type.Expiry_Date_Required == true && input.Expiry_Date == null)
			                {
			                    alert "Expiry date is required for this KYC document type.";
			                    cancel submit;
			                }
			                if(input.Expiry_Date != null && input.Expiry_Date < zoho.currentdate)
			                {
			                    alert "An expired document cannot be submitted for KYC verification.";
			                    cancel submit;
			                }
			                if(input.Uploaded_File != null)
			                {
			                    file_name = input.Uploaded_File.actualname;
			                    extension_position = file_name.lastIndexOf(".");
			                    if(extension_position < 0)
			                    {
			                        alert "The uploaded file must include a PDF, JPG, or JPEG extension.";
			                        cancel submit;
			                    }
			                    file_extension = file_name.subText(extension_position + 1,file_name.length()).toLowerCase();
			                    configured_extensions = "," + document_type.Accepted_File_Types.toLowerCase().replaceAll(" ","") + ",";
			                    if(file_extension != "pdf" && file_extension != "jpg" && file_extension != "jpeg")
			                    {
			                        alert "Only PDF, JPG, and JPEG files are supported.";
			                        cancel submit;
			                    }
			                    if(configured_extensions.contains("," + file_extension + ",") == false)
			                    {
			                        alert "This file extension is not enabled for the selected document type.";
			                        cancel submit;
			                    }
			                }
			                if(file_changed == true && input.Uploaded_File != null)
			                {
			                    if(input.ID != null && previous_record.Uploaded_File != null)
			                    {
			                        input.File_Version = ifnull(previous_record.File_Version,1) + 1;
			                    }
			                    else
			                    {
			                        input.File_Version = 1;
			                    }
			                    input.Uploaded_On = zoho.currenttime;
			                    input.Review_Status = "Pending Verification";
			                    input.Review_Remarks = "";
			                    input.Reviewed_By_Email = null;
			                    input.Reviewed_On = null;
			                    input.Locked_After_Verification = false;
			                }
			            )
			        }
			    }
			}

			Customer_Portal_On_Validate as "Protect Customer System Fields"
			{
			    type = form
			    form = Customers
			    record event = on edit
			    description = "Prevents portal owners from changing approval, financial, lifecycle, and ownership fields through direct requests"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(thisapp.portal.isUserInProfile("Customer_Portal") == true)
			                {
			                    if(old.Portal_Login_Email != zoho.loginuserid && old.Email_ID != zoho.loginuserid)
			                    {
			                        alert "You cannot update another customer's record.";
			                        cancel submit;
			                    }
			                    if(old.Registration_Source != input.Registration_Source || old.Customer_Type != input.Customer_Type || old.Email_ID != input.Email_ID || old.Portal_Login_Email != input.Portal_Login_Email || old.Active != input.Active || old.Approved_Credit_Limit != input.Approved_Credit_Limit || old.Payment_Terms != input.Payment_Terms || old.Assigned_Rate_Card != input.Assigned_Rate_Card || old.Default_Collection_Center != input.Default_Collection_Center || old.Mobile_OTP_Verified != input.Mobile_OTP_Verified || old.Email_OTP_Verified != input.Email_OTP_Verified || old.OTP_Verified_At != input.OTP_Verified_At || old.Onboarding_Status != input.Onboarding_Status || old.KYC_Submitted_On != input.KYC_Submitted_On || old.KYC_Verified_Date != input.KYC_Verified_Date || old.KYC_Expiry_Date != input.KYC_Expiry_Date || old.Portal_Access_Status != input.Portal_Access_Status || old.Current_Loyalty_Points != input.Current_Loyalty_Points || old.Lifetime_Loyalty_Points != input.Lifetime_Loyalty_Points || old.Current_Loyalty_Tier != input.Current_Loyalty_Tier || old.Quarterly_Eligible_Spend != input.Quarterly_Eligible_Spend || old.Outstanding_Balance != input.Outstanding_Balance)
			                    {
			                        alert "Approval, pricing, KYC status, loyalty, and financial fields are managed by authorised workflows.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Customer_Type_On_User_Input as "Configure Customer Type Fields"
			{
			    type = form
			    form = Customers
			    record event = on add or edit
			    description = "Shows business and credit fields only for corporate and wholesale customers"
			
			    on user input of Customer_Type
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Customer_Type == "Corporate" || input.Customer_Type == "Wholesale")
			                {
			                    show Company_Name, GSTIN, PAN_Number, Contact_Person_Name, Contact_Person_Email, Contact_Person_Phone, Requested_Credit_Limit;
			                    enable Company_Name, GSTIN, PAN_Number, Contact_Person_Name, Contact_Person_Email, Contact_Person_Phone, Requested_Credit_Limit;
			                }
			                else
			                {
			                    input.Company_Name = "";
			                    input.GSTIN = "";
			                    input.PAN_Number = "";
			                    input.Contact_Person_Email = "";
			                    input.Contact_Person_Phone = "";
			                    input.Requested_Credit_Limit = 0;
			                    input.Approved_Credit_Limit = 0;
			                    input.Payment_Terms = "Prepaid";
			                    hide Company_Name, GSTIN, PAN_Number, Contact_Person_Name, Contact_Person_Email, Contact_Person_Phone, Requested_Credit_Limit;
			                }
			            )
			        }
			    }
			}

			Customers_On_Load as "Secure and Configure Customer Form"
			{
			    type = form
			    form = Customers
			    record event = on add or edit
			    description = "Configures customer-type fields and enforces portal ownership at form load"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Customer_Type == "Corporate" || input.Customer_Type == "Wholesale")
			                {
			                    show Company_Name, GSTIN, PAN_Number, Contact_Person_Name, Contact_Person_Email, Contact_Person_Phone, Requested_Credit_Limit;
			                }
			                else
			                {
			                    hide Company_Name, GSTIN, PAN_Number, Contact_Person_Name, Contact_Person_Email, Contact_Person_Phone, Requested_Credit_Limit;
			                }
			                disable OTP_Verified_At, KYC_Submitted_On, KYC_Verified_Date, KYC_Expiry_Date, Current_Loyalty_Points, Lifetime_Loyalty_Points, Current_Loyalty_Tier, Quarterly_Eligible_Spend, Loyalty_Tier_Last_Reviewed_At, Outstanding_Balance;
			                if(input.Portal_Access_Status == "Active" || input.Portal_Access_Status == "Invitation Sent")
			                {
			                    disable Portal_Login_Email;
			                }
			                is_portal = thisapp.portal.isUserInProfile("Customer_Portal");
			                if(is_portal == true)
			                {
			                    if(input.ID == null)
			                    {
			                        input.Registration_Source = "Customer Portal";
			                        input.Email_ID = zoho.loginuserid;
			                        input.Portal_Login_Email = zoho.loginuserid;
			                    }
			                    disable Mobile_OTP_Verified, Email_OTP_Verified;
			                    owner_match = input.ID == null || input.Email_ID == zoho.loginuserid || input.Portal_Login_Email == zoho.loginuserid;
			                    if(owner_match == false)
			                    {
			                        disable Registration_Source, Customer_Type, Full_Name, Mobile_Number, Email_ID, Portal_Login_Email, Primary_Address, Active, Company_Name, GSTIN, PAN_Number, Contact_Person_Name, Contact_Person_Email, Contact_Person_Phone, Requested_Credit_Limit, Approved_Credit_Limit, Payment_Terms, Assigned_Rate_Card, Default_Collection_Center, Onboarding_Status, Portal_Access_Status;
			                        alert "You are not authorised to access this customer record.";
			                        openUrl("#Page:Customer_Dashboard","same window");
			                    }
			                    else
			                    {
			                        disable Registration_Source, Customer_Type, Email_ID, Portal_Login_Email, Active, Approved_Credit_Limit, Payment_Terms, Assigned_Rate_Card, Default_Collection_Center, Onboarding_Status, Portal_Access_Status;
			                    }
			                }
			            )
			        }
			    }
			}

			Customers_On_Success as "Initialize Customer Lifecycle"
			{
			    type = form
			    form = Customers
			    record event = on add
			    description = "Initializes customer status and KYC requests, provisions portal access, and audits onboarding"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                customer_record = Customers[ID == input.ID];
			                if(customer_record.Portal_Login_Email == null)
			                {
			                    customer_record.Portal_Login_Email = customer_record.Email_ID;
			                }
			                if(customer_record.Customer_Type == "Retail")
			                {
			                    customer_record.Payment_Terms = "Prepaid";
			                    customer_record.Requested_Credit_Limit = 0;
			                    customer_record.Approved_Credit_Limit = 0;
			                    if(customer_record.Mobile_OTP_Verified == true && customer_record.Email_OTP_Verified == true)
			                    {
			                        customer_record.Onboarding_Status = "Active";
			                        if(customer_record.OTP_Verified_At == null)
			                        {
			                            customer_record.OTP_Verified_At = zoho.currenttime;
			                        }
			                        retail_cards = Rate_Cards[Customer_Type == "Retail" && Default_For_Retail == true && Status == "Published"];
			                        if(retail_cards.count() > 0)
			                        {
			                            customer_record.Assigned_Rate_Card = retail_cards.ID;
			                        }
			                    }
			                }
			                else
			                {
			                    if(customer_record.Onboarding_Status == "Registration Pending")
			                    {
			                        customer_record.Onboarding_Status = "KYC Pending";
			                    }
			                    for each document_type in KYC_Document_Types[Active == true && (Applies_To == customer_record.Customer_Type || Applies_To == "Both")]
			                    {
			                        should_request = document_type.Mandatory_By_Default;
			                        if(document_type.Conditional_On_Credit_Threshold == true && customer_record.Requested_Credit_Limit >= document_type.Credit_Threshold)
			                        {
			                            should_request = true;
			                        }
			                        existing_document_count = Customer_KYC_Documents[Customer == customer_record.ID && Document_Type == document_type.ID].count();
			                        if(should_request == true && existing_document_count == 0)
			                        {
			                            kyc_document_id = insert into Customer_KYC_Documents
			                            [
			                                Customer = customer_record.ID
			                                Document_Type = document_type.ID
			                                Required_For_Onboarding = true
			                                File_Version = 1
			                                Review_Status = "Pending Upload"
			                            ];
			                        }
			                    }
			                }
			                if(customer_record.Portal_Access_Status == "Not Invited")
			                {
			                    portal_result = thisapp.portal.assignUserInProfile(customer_record.Email_ID,"Customer_Portal");
			                    if(customer_record.Registration_Source == "Employee")
			                    {
			                        customer_record.Portal_Access_Status = "Invitation Sent";
			                    }
			                    else
			                    {
			                        customer_record.Portal_Access_Status = "Active";
			                    }
			                    communication_id = insert into Communication_Log
			                    [
			                        Customer = customer_record.ID
			                        Recipient = customer_record.Email_ID
			                        Channel = "Email"
			                        Template_Code = "CUSTOMER_PORTAL_INVITATION"
			                        Subject = "Your logistics customer portal access"
			                        Message_Summary = "Portal access was provisioned for customer onboarding and self-service."
			                        Provider = "Zoho Mail"
			                        Communication_Status = "Sent"
			                        Attempt_Count = 1
			                        Last_Attempt_At = zoho.currenttime
			                    ];
			                    sendmail
			                    [
			                        from: zoho.adminuserid
			                        to: customer_record.Email_ID
			                        subject: "Your logistics customer portal access"
			                        message: "Your customer portal profile is ready. Sign in to complete onboarding, upload KYC documents when required, book shipments, and manage loyalty rewards."
			                    ]
			                }
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = "Customer Onboarding"
			                    Action_Name = "Save Customer"
			                    Module_Name = "Customers"
			                    Record_ID = input.ID.toString()
			                    After_Data = "Customer Type=" + customer_record.Customer_Type + "; Status=" + customer_record.Onboarding_Status + "; Portal=" + customer_record.Portal_Access_Status
			                    Source = "Form Workflow"
			                    Severity = "Info"
			                ];
			            )
			        }
			    }
			}

			Customers_On_Validate as "Validate Customer Registration"
			{
			    type = form
			    form = Customers
			    record event = on add or edit
			    description = "Validates India business identifiers, OTP activation, credit, pricing, and portal ownership"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                is_portal = thisapp.portal.isUserInProfile("Customer_Portal");
			                if(is_portal == true)
			                {
			                    if(input.ID != null && input.Portal_Login_Email != zoho.loginuserid && input.Email_ID != zoho.loginuserid)
			                    {
			                        alert "You cannot update another customer's profile.";
			                        cancel submit;
			                    }
			                    if(input.ID == null && input.Email_ID != zoho.loginuserid)
			                    {
			                        alert "Use the email address associated with your portal login.";
			                        cancel submit;
			                    }
			                }
			                if(input.Customer_Type == "Corporate" || input.Customer_Type == "Wholesale")
			                {
			                    if(ifnull(input.Company_Name,"").trim() == "" || ifnull(input.GSTIN,"").trim() == "" || ifnull(input.PAN_Number,"").trim() == "" || input.Contact_Person_Name.first_name == null || ifnull(input.Contact_Person_Email,"").trim() == "" || input.Contact_Person_Phone == null)
			                    {
			                        alert "Company, GSTIN, PAN, and complete contact-person details are required for corporate and wholesale customers.";
			                        cancel submit;
			                    }
			                    normalized_gstin = input.GSTIN.toUpperCase().replaceAll(" ","");
			                    normalized_pan = input.PAN_Number.toUpperCase().replaceAll(" ","");
			                    if(!normalized_gstin.matches("[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]"))
			                    {
			                        alert "Enter a valid 15-character Indian GSTIN.";
			                        cancel submit;
			                    }
			                    if(!normalized_pan.matches("[A-Z]{5}[0-9]{4}[A-Z]"))
			                    {
			                        alert "Enter a valid 10-character PAN.";
			                        cancel submit;
			                    }
			                    input.GSTIN = normalized_gstin;
			                    input.PAN_Number = normalized_pan;
			                    if(ifnull(input.Requested_Credit_Limit,0) < 0 || ifnull(input.Approved_Credit_Limit,0) < 0)
			                    {
			                        alert "Requested and approved credit limits cannot be negative.";
			                        cancel submit;
			                    }
			                }
			                else
			                {
			                    if(input.Payment_Terms != "Prepaid" || ifnull(input.Approved_Credit_Limit,0) != 0)
			                    {
			                        alert "Retail customers must remain prepaid with a zero approved credit limit.";
			                        cancel submit;
			                    }
			                    if(input.Onboarding_Status == "Active" && (input.Mobile_OTP_Verified != true || input.Email_OTP_Verified != true))
			                    {
			                        alert "Both mobile and email OTP verification are required before retail activation.";
			                        cancel submit;
			                    }
			                }
			                if(input.Assigned_Rate_Card != null)
			                {
			                    rate_card = Rate_Cards[ID == input.Assigned_Rate_Card];
			                    if(rate_card.Status != "Published" || (rate_card.Customer_Type != input.Customer_Type && rate_card.Customer_Type != "All"))
			                    {
			                        alert "Select a published rate card applicable to this customer type.";
			                        cancel submit;
			                    }
			                }
			                if(input.Default_Collection_Center != null)
			                {
			                    hub = Hubs[ID == input.Default_Collection_Center];
			                    if(hub.Active != true || hub.Hub_Type != "Collection Center")
			                    {
			                        alert "Default Collection Center must be an active collection center.";
			                        cancel submit;
			                    }
			                }
			                if(input.Primary_Address.postal_Code != null && !input.Primary_Address.postal_Code.matches("[0-9]{6}"))
			                {
			                    alert "Primary address pincode must contain exactly six digits.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Customers_Retail_Activation_On_Success as "Activate Verified Retail Customer"
			{
			    type = form
			    form = Customers[Customer_Type == "Retail" && Mobile_OTP_Verified == true && Email_OTP_Verified == true && Onboarding_Status != "Active"]
			    record event = on edit
			    description = "Activates a retail customer after both OTP checks and applies the published default retail rate card"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                customer_record = Customers[ID == input.ID];
			                retail_cards = Rate_Cards[Customer_Type == "Retail" && Default_For_Retail == true && Status == "Published"];
			                customer_record.Onboarding_Status = "Active";
			                customer_record.OTP_Verified_At = zoho.currenttime;
			                customer_record.Payment_Terms = "Prepaid";
			                customer_record.Requested_Credit_Limit = 0;
			                customer_record.Approved_Credit_Limit = 0;
			                if(retail_cards.count() > 0)
			                {
			                    customer_record.Assigned_Rate_Card = retail_cards.ID;
			                }
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = thisapp.permissions.loginUserProfile()
			                    Action_Name = "Activate Retail Customer"
			                    Module_Name = "Customers"
			                    Record_ID = input.ID.toString()
			                    Before_Data = "Status=" + input.Onboarding_Status
			                    After_Data = "Status=Active; Mobile OTP=true; Email OTP=true"
			                    Source = "Form Workflow"
			                    Severity = "Info"
			                ];
			                communication_id = insert into Communication_Log
			                [
			                    Customer = input.ID
			                    Recipient = input.Email_ID
			                    Channel = "Email"
			                    Template_Code = "RETAIL_ACCOUNT_ACTIVATED"
			                    Subject = "Your logistics account is active"
			                    Message_Summary = "Retail customer activated after mobile and email OTP verification."
			                    Provider = "Zoho Mail"
			                    Communication_Status = "Sent"
			                    Attempt_Count = 1
			                    Last_Attempt_At = zoho.currenttime
			                ];
			                sendmail
			                [
			                    from: zoho.adminuserid
			                    to: input.Email_ID
			                    subject: "Your logistics account is active"
			                    message: "Your mobile number and email address are verified. You can now book and track shipments in the customer portal."
			                ]
			            )
			        }
			    }
			}

			Delivery_Run_Sheet_Items_On_Delete as "Protect Delivery Stop Deletion"
			{
			    type = form
			    form = Delivery_Run_Sheet_Items
			    record event = on delete
			    description = "Allows deletion only while the parent delivery run is still a draft"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                run_record = Delivery_Run_Sheets[ID == input.Delivery_Run_Sheet];
			                if(current_profile != "Logistics_Administrator" && current_profile != "Operations_Manager" && current_profile != "Hub_Supervisor")
			                {
			                    alert "Only authorised operations planners can remove delivery stops.";
			                    cancel delete;
			                }
			                if(run_record.count(ID) == 0 || run_record.DRS_Status != "Draft")
			                {
			                    alert "Delivery stops can be removed only from draft runs.";
			                    cancel delete;
			                }
			            )
			        }
			    }
			}

			Delivery_Run_Sheet_Items_On_Load as "Secure Delivery Stop"
			{
			    type = form
			    form = Delivery_Run_Sheet_Items
			    record event = on add or edit
			    description = "Locks assignment and workflow-controlled fields and restricts evidence capture to the assigned delivery agent"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Delivery_Status, Arrived_At, Completed_At, Attempt_Number, EPOD_WorkDrive_File_ID, EPOD_URL;
			                current_profile = thisapp.permissions.loginUserProfile();
			                if(input.ID != null)
			                {
			                    run_record = Delivery_Run_Sheets[ID == input.Delivery_Run_Sheet];
			                    assigned_agent = Operations_Users[ID == run_record.Assigned_Agent];
			                    disable Delivery_Run_Sheet, Shipment, Stop_Sequence;
			                    assigned_agent_active = current_profile == "Field_Agent" && assigned_agent.count(ID) > 0 && assigned_agent.Work_Email == zoho.loginuserid && (run_record.DRS_Status == "Released" || run_record.DRS_Status == "In Progress");
			                    if(assigned_agent_active == true && input.Delivery_Status == "Out For Delivery")
			                    {
			                        enable Proof_Type, Recipient_OTP, Recipient_Signature, Delivery_Photo, Recipient_Name, COD_Collected, NDR_Reason, NDR_Notes, Agent_Latitude, Agent_Longitude;
			                    }
			                    else
			                    {
			                        disable Proof_Type, Recipient_OTP, Recipient_Signature, Delivery_Photo, Recipient_Name, COD_Collected, NDR_Reason, NDR_Notes, Agent_Latitude, Agent_Longitude;
			                    }
			                    if(input.Delivery_Status == "Delivered" || input.Delivery_Status == "Failed" || input.Delivery_Status == "RTO")
			                    {
			                        disable Proof_Type, Recipient_OTP, Recipient_Signature, Delivery_Photo, Recipient_Name, COD_Collected, NDR_Reason, NDR_Notes, Agent_Latitude, Agent_Longitude;
			                    }
			                }
			                else
			                {
			                    disable Proof_Type, Recipient_OTP, Recipient_Signature, Delivery_Photo, Recipient_Name, COD_Collected, NDR_Reason, NDR_Notes, Agent_Latitude, Agent_Longitude;
			                }
			            )
			        }
			    }
			}

			Delivery_Run_Sheet_Items_On_Success as "Reconcile Delivery Run Stop Totals"
			{
			    type = form
			    form = Delivery_Run_Sheet_Items
			    record event = on add or edit
			    description = "Refreshes delivery run aggregates and audits delivery stop assignment or evidence updates"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                run_record = Delivery_Run_Sheets[ID == input.Delivery_Run_Sheet];
			                planned_count = 0;
			                delivered_count = 0;
			                failed_count = 0;
			                expected_cod = 0.0;
			                collected_cod = 0.0;
			                for each run_item in Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.Delivery_Run_Sheet]
			                {
			                    planned_count = planned_count + 1;
			                    shipment_record = Shipment_Requests[ID == run_item.Shipment];
			                    if(shipment_record.Payment_Type == "COD")
			                    {
			                        expected_cod = expected_cod + ifnull(shipment_record.COD_Amount,0);
			                    }
			                    if(run_item.Delivery_Status == "Delivered")
			                    {
			                        delivered_count = delivered_count + 1;
			                        collected_cod = collected_cod + ifnull(run_item.COD_Collected,0);
			                    }
			                    else if(run_item.Delivery_Status == "Failed" || run_item.Delivery_Status == "RTO")
			                    {
			                        failed_count = failed_count + 1;
			                    }
			                }
			                run_record.Planned_Stop_Count = planned_count;
			                run_record.Delivered_Count = delivered_count;
			                run_record.Failed_Count = failed_count;
			                run_record.Expected_COD_Amount = expected_cod;
			                run_record.Collected_COD_Amount = collected_cod;
			                current_profile = thisapp.permissions.loginUserProfile();
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = current_profile
			                    Action_Name = "Save Delivery Stop"
			                    Module_Name = "Delivery Run Sheet Items"
			                    Record_ID = input.ID.toString()
			                    After_Data = "Run=" + input.Delivery_Run_Sheet + "; Shipment=" + input.Shipment + "; Stop=" + input.Stop_Sequence + "; Status=" + input.Delivery_Status + "; Attempt=" + input.Attempt_Number
			                    Source = "Form Workflow"
			                    Severity = "Info"
			                ];
			            )
			        }
			    }
			}

			Delivery_Run_Sheet_Items_On_Validate as "Validate Delivery Stop"
			{
			    type = form
			    form = Delivery_Run_Sheet_Items
			    record event = on add or edit
			    description = "Validates delivery assignment uniqueness, hub custody, assigned-agent access, evidence values, and protected workflow state"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                run_record = Delivery_Run_Sheets[ID == input.Delivery_Run_Sheet];
			                shipment_record = Shipment_Requests[ID == input.Shipment];
			                if(run_record.count(ID) == 0 || shipment_record.count(ID) == 0)
			                {
			                    alert "Select a valid delivery run and shipment.";
			                    cancel submit;
			                }
			                if(input.Stop_Sequence <= 0)
			                {
			                    alert "Stop sequence must be greater than zero.";
			                    cancel submit;
			                }
			                duplicate_sequence = Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.Delivery_Run_Sheet && Stop_Sequence == input.Stop_Sequence && ID != input.ID].count(ID);
			                if(duplicate_sequence > 0)
			                {
			                    alert "This stop sequence is already used in the delivery run.";
			                    cancel submit;
			                }
			                duplicate_active = Delivery_Run_Sheet_Items[Shipment == input.Shipment && ID != input.ID && (Delivery_Status == "Assigned" || Delivery_Status == "Out For Delivery")].count(ID);
			                if(duplicate_active > 0)
			                {
			                    alert "This shipment is already assigned to an active delivery run.";
			                    cancel submit;
			                }
			                if(run_record.Hub != shipment_record.Destination_Hub || run_record.Hub != shipment_record.Current_Hub)
			                {
			                    alert "The shipment must be in custody at this delivery run's hub.";
			                    cancel submit;
			                }
			                if(input.ID == null)
			                {
			                    if(current_profile != "Logistics_Administrator" && current_profile != "Operations_Manager" && current_profile != "Hub_Supervisor")
			                    {
			                        alert "Only authorised operations planners can add delivery stops.";
			                        cancel submit;
			                    }
			                    if(run_record.DRS_Status != "Draft" || shipment_record.Shipment_Status != "At Delivery Hub")
			                    {
			                        alert "Delivery stops can be added only to draft runs for shipments at the delivery hub.";
			                        cancel submit;
			                    }
			                    input.Delivery_Status = "Assigned";
			                    input.Arrived_At = null;
			                    input.Completed_At = null;
			                    input.Attempt_Number = ifnull(shipment_record.NDR_Attempt_Count,0);
			                    input.COD_Collected = 0;
			                    input.EPOD_WorkDrive_File_ID = null;
			                    input.EPOD_URL = null;
			                }
			                else
			                {
			                    previous_record = Delivery_Run_Sheet_Items[ID == input.ID];
			                    assigned_agent = Operations_Users[ID == run_record.Assigned_Agent];
			                    if(current_profile == "Field_Agent" && (assigned_agent.count(ID) == 0 || assigned_agent.Work_Email != zoho.loginuserid))
			                    {
			                        alert "You cannot update another agent's delivery stop.";
			                        cancel submit;
			                    }
			                    if(current_profile != "Field_Agent" && current_profile != "Logistics_Administrator" && current_profile != "Operations_Manager" && current_profile != "Hub_Supervisor")
			                    {
			                        alert "You are not authorised to update delivery stops.";
			                        cancel submit;
			                    }
			                    if(previous_record.Delivery_Status == "Delivered" || previous_record.Delivery_Status == "Failed" || previous_record.Delivery_Status == "RTO")
			                    {
			                        alert "Terminal delivery stops are locked.";
			                        cancel submit;
			                    }
			                    if(input.Delivery_Run_Sheet != previous_record.Delivery_Run_Sheet || input.Shipment != previous_record.Shipment || input.Stop_Sequence != previous_record.Stop_Sequence || input.Delivery_Status != previous_record.Delivery_Status || input.Arrived_At != previous_record.Arrived_At || input.Completed_At != previous_record.Completed_At || input.Attempt_Number != previous_record.Attempt_Number || input.EPOD_WorkDrive_File_ID != previous_record.EPOD_WorkDrive_File_ID || input.EPOD_URL != previous_record.EPOD_URL)
			                    {
			                        alert "Assignment, status, milestone, attempt, and ePOD fields are managed by delivery actions.";
			                        cancel submit;
			                    }
			                }
			                if(input.Agent_Latitude != null && (input.Agent_Latitude < -90 || input.Agent_Latitude > 90))
			                {
			                    alert "Agent latitude must be between -90 and 90.";
			                    cancel submit;
			                }
			                if(input.Agent_Longitude != null && (input.Agent_Longitude < -180 || input.Agent_Longitude > 180))
			                {
			                    alert "Agent longitude must be between -180 and 180.";
			                    cancel submit;
			                }
			                if(ifnull(input.COD_Collected,0) < 0)
			                {
			                    alert "COD collected cannot be negative.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Delivery_Run_Sheets_On_Delete as "Protect Delivery Run Sheet"
			{
			    type = form
			    form = Delivery_Run_Sheets
			    record event = on delete
			    description = "Prevents deletion of released runs and runs with stop or custody records"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.DRS_Status != "Draft" || Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.ID].count(ID) > 0)
			                {
			                    alert "A delivery run with stops or operational history cannot be deleted. Cancel it through controlled operations instead.";
			                    cancel delete;
			                }
			            )
			        }
			    }
			}

			Delivery_Run_Sheets_On_Load as "Prepare Delivery Run Planner"
			{
			    type = form
			    form = Delivery_Run_Sheets
			    record event = on add or edit
			    description = "Sets the supervisor hub, filters delivery resources, and locks workflow-controlled run data"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable DRS_Status, Planned_Stop_Count, Delivered_Count, Failed_Count, Expected_COD_Amount, Collected_COD_Amount, Released_At, Completed_At;
			                current_profile = thisapp.permissions.loginUserProfile();
			                if(input.ID == null && current_profile == "Hub_Supervisor")
			                {
			                    logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                    if(logged_user.count(ID) > 0)
			                    {
			                        deputation_active = logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= input.Run_Date) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= input.Run_Date);
			                        input.Hub = if(deputation_active == true,logged_user.Deputed_Hub,logged_user.Home_Hub);
			                    }
			                }
			                clear Assigned_Agent;
			                clear Vehicle;
			                if(input.Hub != null && input.Run_Date != null)
			                {
			                    eligible_agents = Operations_Users[Active == true && Application_Role == "Field Agent" && (Agent_Role == "Delivery" || Agent_Role == "Both") && ((Deputed_Hub == input.Hub && (Deputation_Start_Date == null || Deputation_Start_Date <= input.Run_Date) && (Deputation_End_Date == null || Deputation_End_Date >= input.Run_Date)) || (Home_Hub == input.Hub && (Deputed_Hub == null || (Deputation_Start_Date != null && Deputation_Start_Date > input.Run_Date) || (Deputation_End_Date != null && Deputation_End_Date < input.Run_Date))))];
			                    Assigned_Agent:ui.add(eligible_agents.ID.getall());
			                    eligible_vehicles = Vehicles[Owning_Hub == input.Hub && Active == true && (Status == "Available" || ID == input.Vehicle)];
			                    Vehicle:ui.add(eligible_vehicles.ID.getall());
			                }
			                if(input.ID != null && input.DRS_Status != "Draft")
			                {
			                    disable Hub, Assigned_Agent, Run_Date, Delivery_Zone, Vehicle, Supervisor_Notes;
			                }
			            )
			        }
			    }
			}

			Delivery_Run_Sheets_On_Success as "Audit Delivery Run Sheet"
			{
			    type = form
			    form = Delivery_Run_Sheets
			    record event = on add or edit
			    description = "Audits creation and controlled draft updates of delivery run sheets"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                action_name = if(input.DRS_Status == "Draft","Save Delivery Run Draft","Update Delivery Run");
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = current_profile
			                    Action_Name = action_name
			                    Module_Name = "Delivery Run Sheets"
			                    Record_ID = input.ID.toString()
			                    Before_Data = ""
			                    After_Data = "DRS=" + input.DRS_Number + "; Hub=" + input.Hub + "; Agent=" + input.Assigned_Agent + "; Zone=" + input.Delivery_Zone + "; Status=" + input.DRS_Status
			                    Source = "Form Workflow"
			                    Severity = "Info"
			                ];
			            )
			        }
			    }
			}

			Delivery_Run_Sheets_On_Validate as "Validate Delivery Run Sheet"
			{
			    type = form
			    form = Delivery_Run_Sheets
			    record event = on add or edit
			    description = "Validates hub scope, delivery resources, protected totals, dates, and shared daily capacity"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                if(current_profile != "Logistics_Administrator" && current_profile != "Operations_Manager" && current_profile != "Hub_Supervisor")
			                {
			                    alert "Only authorised operations planners can create or edit delivery run sheets.";
			                    cancel submit;
			                }
			                if(input.Run_Date < zoho.currentdate)
			                {
			                    alert "A delivery run cannot be planned for a past date.";
			                    cancel submit;
			                }
			                selected_hub = Hubs[ID == input.Hub && Hub_Type == "Collection Center" && Active == true];
			                if(selected_hub.count(ID) == 0)
			                {
			                    alert "Select an active collection center or delivery hub.";
			                    cancel submit;
			                }
			                logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                if(current_profile == "Hub_Supervisor")
			                {
			                    supervisor_deputation_active = logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= input.Run_Date) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= input.Run_Date);
			                    supervisor_hub = if(supervisor_deputation_active == true,logged_user.Deputed_Hub,logged_user.Home_Hub);
			                    if(logged_user.count(ID) == 0 || supervisor_hub != input.Hub)
			                    {
			                        alert "Hub supervisors can plan delivery runs only for their effective home or deputed hub.";
			                        cancel submit;
			                    }
			                }
			                agent_record = Operations_Users[ID == input.Assigned_Agent && Active == true && Application_Role == "Field Agent" && (Agent_Role == "Delivery" || Agent_Role == "Both")];
			                if(agent_record.count(ID) == 0)
			                {
			                    alert "Select an active delivery-capable field agent.";
			                    cancel submit;
			                }
			                agent_deputation_active = agent_record.Deputed_Hub != null && (agent_record.Deputation_Start_Date == null || agent_record.Deputation_Start_Date <= input.Run_Date) && (agent_record.Deputation_End_Date == null || agent_record.Deputation_End_Date >= input.Run_Date);
			                agent_hub = if(agent_deputation_active == true,agent_record.Deputed_Hub,agent_record.Home_Hub);
			                if(agent_hub != input.Hub)
			                {
			                    alert "The assigned agent is not effective at the selected hub on the run date.";
			                    cancel submit;
			                }
			                previous_record = Delivery_Run_Sheets[ID == input.ID];
			                if(input.ID != null)
			                {
			                    if(previous_record.DRS_Status != "Draft")
			                    {
			                        alert "Released delivery runs cannot be edited from the form.";
			                        cancel submit;
			                    }
			                    if(input.DRS_Status != previous_record.DRS_Status || input.Planned_Stop_Count != previous_record.Planned_Stop_Count || input.Delivered_Count != previous_record.Delivered_Count || input.Failed_Count != previous_record.Failed_Count || input.Expected_COD_Amount != previous_record.Expected_COD_Amount || input.Collected_COD_Amount != previous_record.Collected_COD_Amount || input.Released_At != previous_record.Released_At || input.Completed_At != previous_record.Completed_At)
			                    {
			                        alert "Run status, timestamps, COD, and progress totals are managed by operational workflows.";
			                        cancel submit;
			                    }
			                }
			                planned_count = 0;
			                delivered_count = 0;
			                failed_count = 0;
			                planned_weight = 0.0;
			                expected_cod = 0.0;
			                collected_cod = 0.0;
			                if(input.ID != null)
			                {
			                    for each run_item in Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.ID]
			                    {
			                        planned_count = planned_count + 1;
			                        shipment_record = Shipment_Requests[ID == run_item.Shipment];
			                        planned_weight = planned_weight + ifnull(shipment_record.Billable_Weight_Kg,0);
			                        if(shipment_record.Payment_Type == "COD")
			                        {
			                            expected_cod = expected_cod + ifnull(shipment_record.COD_Amount,0);
			                        }
			                        if(run_item.Delivery_Status == "Delivered")
			                        {
			                            delivered_count = delivered_count + 1;
			                            collected_cod = collected_cod + ifnull(run_item.COD_Collected,0);
			                        }
			                        else if(run_item.Delivery_Status == "Failed" || run_item.Delivery_Status == "RTO")
			                        {
			                            failed_count = failed_count + 1;
			                        }
			                    }
			                }
			                input.Planned_Stop_Count = planned_count;
			                input.Delivered_Count = delivered_count;
			                input.Failed_Count = failed_count;
			                input.Expected_COD_Amount = expected_cod;
			                input.Collected_COD_Amount = collected_cod;
			                other_agent_weight = 0.0;
			                for each pickup_run in Pickup_Run_Sheets[Assigned_Agent == input.Assigned_Agent && Run_Date == input.Run_Date && Status != "Cancelled"]
			                {
			                    other_agent_weight = other_agent_weight + ifnull(pickup_run.Total_Planned_Weight_Kg,0);
			                }
			                for each other_run in Delivery_Run_Sheets[Assigned_Agent == input.Assigned_Agent && Run_Date == input.Run_Date && ID != input.ID && DRS_Status != "Cancelled"]
			                {
			                    for each other_item in Delivery_Run_Sheet_Items[Delivery_Run_Sheet == other_run.ID]
			                    {
			                        other_shipment = Shipment_Requests[ID == other_item.Shipment];
			                        other_agent_weight = other_agent_weight + ifnull(other_shipment.Billable_Weight_Kg,0);
			                    }
			                }
			                if(agent_record.Maximum_Daily_Load_Kg != null && agent_record.Maximum_Daily_Load_Kg > 0 && other_agent_weight + planned_weight > agent_record.Maximum_Daily_Load_Kg)
			                {
			                    alert "The assigned agent's combined pickup and delivery load would exceed the daily limit.";
			                    cancel submit;
			                }
			                if(input.Vehicle != null)
			                {
			                    vehicle_record = Vehicles[ID == input.Vehicle && Active == true && Owning_Hub == input.Hub];
			                    if(vehicle_record.count(ID) == 0)
			                    {
			                        alert "Select an active vehicle owned by the delivery hub.";
			                        cancel submit;
			                    }
			                    if(vehicle_record.Status != "Available" && (input.ID == null || previous_record.Vehicle != input.Vehicle))
			                    {
			                        alert "The selected vehicle is not available.";
			                        cancel submit;
			                    }
			                    duplicate_delivery_run = Delivery_Run_Sheets[Vehicle == input.Vehicle && Run_Date == input.Run_Date && ID != input.ID && DRS_Status != "Cancelled"].count(ID);
			                    duplicate_pickup_run = Pickup_Run_Sheets[Vehicle == input.Vehicle && Run_Date == input.Run_Date && Status != "Cancelled"].count(ID);
			                    if(duplicate_delivery_run > 0 || duplicate_pickup_run > 0)
			                    {
			                        alert "The selected vehicle is already planned for another run on this date.";
			                        cancel submit;
			                    }
			                    if(planned_weight > vehicle_record.Capacity_Kg)
			                    {
			                        alert "The planned shipment weight exceeds the selected vehicle capacity.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Delivery_Runs_Hub_Input as "Filter Delivery Resources by Hub"
			{
			    type = form
			    form = Delivery_Run_Sheets
			    record event = on add or edit
			    description = "Limits delivery agents and vehicles to resources effectively assigned to the selected hub"
			
			    on user input of Hub
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Assigned_Agent = null;
			                input.Vehicle = null;
			                clear Assigned_Agent;
			                clear Vehicle;
			                if(input.Hub != null && input.Run_Date != null)
			                {
			                    eligible_agents = Operations_Users[Active == true && Application_Role == "Field Agent" && (Agent_Role == "Delivery" || Agent_Role == "Both") && ((Deputed_Hub == input.Hub && (Deputation_Start_Date == null || Deputation_Start_Date <= input.Run_Date) && (Deputation_End_Date == null || Deputation_End_Date >= input.Run_Date)) || (Home_Hub == input.Hub && (Deputed_Hub == null || (Deputation_Start_Date != null && Deputation_Start_Date > input.Run_Date) || (Deputation_End_Date != null && Deputation_End_Date < input.Run_Date))))];
			                    Assigned_Agent:ui.add(eligible_agents.ID.getall());
			                    eligible_vehicles = Vehicles[Owning_Hub == input.Hub && Active == true && Status == "Available"];
			                    Vehicle:ui.add(eligible_vehicles.ID.getall());
			                }
			            )
			        }
			    }
			}

