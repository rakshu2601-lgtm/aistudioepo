		        searchable = true
		        sortorder = ascending
		        row = 2
		        column = 2
		        width = medium
		    )
		    Latitude
		    (
		        type = decimal
		        displayname = "Latitude"
		        decimalplace = 6
		        row = 2
		        column = 1
		        width = medium
		    )
		    Longitude
		    (
		        type = decimal
		        displayname = "Longitude"
		        decimalplace = 6
		        row = 2
		        column = 2
		        width = medium
		    )
		    Event_Details
		    (
		        type = section
		        displayname = "Event Details"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    must have Event_Description
		    (
		        type = textarea
		        displayname = "Event Description"
		        height = 100px
		        row = 3
		        column = 1
		        width = medium
		    )
		    Customer_Visible
		    (
		        type = checkbox
		        displayname = "Customer Visible"
		        initial value = true
		        row = 3
		        column = 2
		        width = medium
		    )
		    Created_By_Email
		    (
		        type = email
		        displayname = "Created By Email"
		        personal data = true
		        row = 3
		        column = 1
		        width = medium
		    )
