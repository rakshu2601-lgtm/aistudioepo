		    Loyalty_Awarded
		    (
		        type = checkbox
		        displayname = "Loyalty Awarded"
		        initial value = false
		        row = 8
		        column = 1
		        width = medium
		    )
		    EPOD_Details
		    (
		        type = section
		        displayname = "Electronic Proof of Delivery"
		        visibility = true
