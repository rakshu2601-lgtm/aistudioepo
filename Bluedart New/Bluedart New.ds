			                                to: assigned_agent.Work_Email
			                                subject: "COD cash shortfall: DRS " + run_record.DRS_Number
			                                message: "Finance identified a COD cash shortfall of INR " + shortfall_amount + ". Submit the balance and update the remittance record."
			                            ]
			                            communication_id = insert into Communication_Log
			                            [
			                                Recipient = assigned_agent.Work_Email
			                                Channel = "Email"
			                                Template_Code = "COD_SHORTFALL"
			                                Subject = "COD cash shortfall: DRS " + run_record.DRS_Number
			                                Message_Summary = "Agent notified of INR " + shortfall_amount + " COD shortfall."
			                                Provider = "Zoho Mail"
			                                Communication_Status = "Sent"
			                                Attempt_Count = 1
			                                Last_Attempt_At = zoho.currenttime
			                            ];
			                        }
			                        audit_id = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.loginuserid
			                            Actor_Profile = current_profile
			                            Action_Name = "Confirm COD Shortfall"
			                            Module_Name = "COD Remittances"
			                            Record_ID = input.ID.toString()
			                            Before_Data = "Status=" + prior_status + "; Expected=" + expected_amount + "; Submitted=" + submitted_amount
			                            After_Data = "Status=Shortfall; Shortfall=" + shortfall_amount
			                            Source = "Report Action"
			                            Severity = "Critical"
			                        ];
			                    }
			                    else
			                    {
			                        config_record = App_Configuration[Active == true] range from 0 to 0;
			                        payout_cycle = if(config_record.count(ID) > 0,config_record.COD_Payout_Cycle,"T+2");
			                        payout_due_date = if(payout_cycle == "Weekly",zoho.currentdate.toStartOfWeek().addDay(8),zoho.currentdate.addBusinessDay(2));
			                        input.Remittance_Status = "Confirmed";
			                        input.Shortfall_Amount = 0;
			                        input.Customer_Payout_Due_Date = payout_due_date;
			                        for each delivered_item in Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.Delivery_Run_Sheet && Delivery_Status == "Delivered" && COD_Collected > 0]
			                        {
			                            shipment_record = Shipment_Requests[ID == delivered_item.Shipment];
			                            customer_record = Customers[ID == shipment_record.Customer];
			                            payment_reference = "COD-" + input.Remittance_Number + "-" + shipment_record.AWB_Number;
			                            if(Account_Ledger[Payment_Reference == payment_reference].count(ID) == 0)
			                            {
			                                ledger_id = insert into Account_Ledger
			                                [
			                                    Customer = shipment_record.Customer
			                                    Shipment = shipment_record.ID
			                                    Transaction_Type = "COD Settlement"
			                                    Amount = delivered_item.COD_Collected
			                                    Transaction_Date = zoho.currenttime
			                                    Due_Date = payout_due_date
			                                    Ledger_Status = "Open"
			                                    Payment_Reference = payment_reference
			                                    Notes = "COD confirmed from DRS " + run_record.DRS_Number + "."
			                                    Posted_By_Email = zoho.loginuserid
			                                    Customer_Login_Email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID)
			                                ];
			                            }
			                            thisapp.Recalculate_Customer_Outstanding(shipment_record.Customer);
			                        }
			                        if(assigned_agent.count(ID) > 0)
			                        {
			                            sendmail
			                            [
			                                from: zoho.adminuserid
			                                to: assigned_agent.Work_Email
			                                subject: "COD cash confirmed: DRS " + run_record.DRS_Number
			                                message: "Finance confirmed COD cash of INR " + expected_amount + ". Customer payout is due on " + payout_due_date + "."
			                            ]
			                        }
			                        audit_id = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.loginuserid
			                            Actor_Profile = current_profile
			                            Action_Name = "Confirm COD Remittance"
			                            Module_Name = "COD Remittances"
			                            Record_ID = input.ID.toString()
			                            Before_Data = "Status=" + prior_status + "; Expected=" + expected_amount + "; Submitted=" + submitted_amount
			                            After_Data = "Status=Confirmed; Payout Cycle=" + payout_cycle + "; Payout Due=" + payout_due_date
			                            Source = "Report Action"
			                            Severity = "Critical"
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

			Query_KYC_Document as "Query KYC Document"
			{
			    type = functions
			    form = Customer_KYC_Documents
			    execution type = for each record
			    description = "Returns an uploaded KYC document for customer correction with mandatory reviewer remarks"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                if(input.Review_Status != "Pending Verification")
			                {
			                    info "Only a document awaiting verification can be queried.";
			                }
			                else if(ifnull(input.Review_Remarks,"").trim() == "")
			                {
			                    info "Enter review remarks before querying this document.";
			                }
			                else
			                {
			                    input.Review_Status = "Query";
			                    input.Reviewed_By_Email = zoho.loginuserid;
			                    input.Reviewed_On = zoho.currenttime;
			                    input.Locked_After_Verification = false;
			                    customer_record = Customers[ID == input.Customer];
			                    queried_count = Customer_KYC_Documents[Customer == input.Customer && Review_Status == "Query" && ID != input.ID].count(ID) + 1;
			                    customer_record.Onboarding_Status = "Action Required";
			                    communication_id = insert into Communication_Log
			                    [
			                        Customer = customer_record.ID
			                        Recipient = customer_record.Email_ID
			                        Channel = "Email"
			                        Template_Code = "KYC_DOCUMENT_QUERY"
			                        Subject = "KYC document correction required"
			                        Message_Summary = "Document " + input.Document_Type + " requires correction: " + input.Review_Remarks
			                        Provider = "Zoho Mail"
			                        Communication_Status = "Sent"
			                        Attempt_Count = 1
			                        Last_Attempt_At = zoho.currenttime
			                    ];
			                    sendmail
			                    [
			                        from: zoho.adminuserid
			                        to: customer_record.Email_ID
			                        subject: "KYC document correction required"
			                        message: "A KYC document requires correction. Sign in to the customer portal to review the remarks and upload a corrected version."
			                    ]
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuserid
			                        Actor_Profile = "POC Process User"
			                        Action_Name = "Query KYC Document"
			                        Module_Name = "Customer_KYC_Documents"
			                        Record_ID = input.ID.toString()
			                        Before_Data = "Status=Pending Verification"
			                        After_Data = "Status=Query; Queried Documents=" + queried_count + "; Remarks=" + input.Review_Remarks
			                        Source = "Report Action"
			                        Severity = "Warning"
			                    ];
			                }
			            )
			        }
			    }
			}

			Verify_KYC_Document as "Verify"
			{
			    type = functions
			    form = Customer_KYC_Documents
			    execution type = for each record
			    description = "Verifies and locks an uploaded KYC document for authorised KYC staff"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                if(input.Review_Status != "Pending Verification" || input.Uploaded_File == null)
			                {
			                    info "Only an uploaded document awaiting verification can be verified.";
			                }
			                else
			                {
			                    input.Review_Status = "Verified";
			                    input.Reviewed_By_Email = zoho.loginuserid;
			                    input.Reviewed_On = zoho.currenttime;
			                    input.Locked_After_Verification = true;
			                    customer_record = Customers[ID == input.Customer];
			                    remaining_count = Customer_KYC_Documents[Customer == input.Customer && Required_For_Onboarding == true && Review_Status != "Verified" && ID != input.ID].count(ID);
			                    communication_summary = "KYC document " + input.Document_Type + " has been verified.";
			                    if(remaining_count == 0)
			                    {
			                        communication_summary = "All required KYC documents are verified and the customer is ready for final approval.";
			                    }
			                    communication_id = insert into Communication_Log
			                    [
			                        Customer = customer_record.ID
			                        Recipient = customer_record.Email_ID
			                        Channel = "Portal Notification"
			                        Template_Code = "KYC_DOCUMENT_VERIFIED"
			                        Subject = "KYC document verified"
			                        Message_Summary = communication_summary
			                        Provider = "Other"
			                        Communication_Status = "Queued"
			                        Attempt_Count = 0
			                    ];
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuserid
			                        Actor_Profile = "POC Process User"
			                        Action_Name = "Verify KYC Document"
			                        Module_Name = "Customer_KYC_Documents"
			                        Record_ID = input.ID.toString()
			                        Before_Data = "Status=Pending Verification"
			                        After_Data = "Status=Verified; Version=" + input.File_Version + "; Required Remaining=" + remaining_count
			                        Source = "Report Action"
			                        Severity = "Warning"
			                    ];
			                }
			            )
			        }
			    }
			}

			Approve_Customer_KYC as "Approve"
			{
			    type = functions
			    form = Customers
			    execution type = for each record
			    description = "Activates a business customer only when every required KYC document is verified"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                if(input.Onboarding_Status != "Pending Verification")
			                {
			                    info "Only customers pending verification can be approved.";
			                }
			                else
			                {
			                    required_count = Customer_KYC_Documents[Customer == input.ID && Required_For_Onboarding == true].count();
			                    unverified_count = Customer_KYC_Documents[Customer == input.ID && Required_For_Onboarding == true && Review_Status != "Verified"].count();
			                    if(required_count == 0 || unverified_count > 0)
			                    {
			                        info "Approval is blocked until every required KYC document is uploaded and verified.";
			                    }
			                    else
			                    {
			                        input.Onboarding_Status = "Active";
			                        input.KYC_Verified_Date = zoho.currentdate;
			                        input.KYC_Expiry_Date = zoho.currentdate.addYear(1);
			                        input.Approved_Credit_Limit = input.Requested_Credit_Limit;
			                        input.Portal_Access_Status = "Active";
			                        audit_id = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.loginuserid
			                            Actor_Profile = "POC Process User"
			                            Action_Name = "Approve Customer KYC"
			                            Module_Name = "Customers"
			                            Record_ID = input.ID.toString()
			                            Before_Data = "Status=Pending Verification"
			                            After_Data = "Status=Active; KYC Expiry=" + input.KYC_Expiry_Date + "; Approved Credit=" + input.Approved_Credit_Limit
			                            Source = "Report Action"
			                            Severity = "Warning"
			                        ];
			                        communication_id = insert into Communication_Log
			                        [
			                            Customer = input.ID
			                            Recipient = input.Email_ID
			                            Channel = "Email"
			                            Template_Code = "KYC_APPROVED"
			                            Subject = "KYC approved and account activated"
			                            Message_Summary = "KYC was approved and the customer account is active."
			                            Provider = "Zoho Mail"
			                            Communication_Status = "Sent"
			                            Attempt_Count = 1
			                            Last_Attempt_At = zoho.currenttime
			                        ];
			                        sendmail
			                        [
			                            from: zoho.adminuserid
			                            to: input.Email_ID
			                            subject: "KYC approved and account activated"
			                            message: "Your KYC documents have been approved. Your logistics account is now active."
			                        ]
			                    }
			                }
			            )
			        }
			    }
			}

			Query_Customer_KYC as "Query Customer KYC"
			{
			    type = functions
			    form = Customers
			    execution type = for each record
			    description = "Moves a customer to Action Required after one or more documents receive query remarks"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                if(input.Onboarding_Status != "Pending Verification")
			                {
			                    info "Only customers pending verification can be queried.";
			                }
			                else
			                {
			                    queried_count = Customer_KYC_Documents[Customer == input.ID && Review_Status == "Query"].count();
			                    if(queried_count == 0)
			                    {
			                        info "Query at least one KYC document and provide review remarks before using this action.";
			                    }
			                    else
			                    {
			                        input.Onboarding_Status = "Action Required";
			                        audit_id = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.loginuserid
			                            Actor_Profile = "POC Process User"
			                            Action_Name = "Query Customer KYC"
			                            Module_Name = "Customers"
			                            Record_ID = input.ID.toString()
			                            Before_Data = "Status=Pending Verification"
			                            After_Data = "Status=Action Required; Queried Documents=" + queried_count
			                            Source = "Report Action"
			                            Severity = "Warning"
			                        ];
			                        communication_id = insert into Communication_Log
			                        [
			                            Customer = input.ID
			                            Recipient = input.Email_ID
			                            Channel = "Email"
			                            Template_Code = "KYC_ACTION_REQUIRED"
			                            Subject = "KYC document correction required"
			                            Message_Summary = "One or more KYC documents require correction; review remarks are available in the portal."
			                            Provider = "Zoho Mail"
			                            Communication_Status = "Sent"
			                            Attempt_Count = 1
			                            Last_Attempt_At = zoho.currenttime
			                        ];
			                        sendmail
			                        [
			                            from: zoho.adminuserid
			                            to: input.Email_ID
			                            subject: "KYC document correction required"
			                            message: "One or more KYC documents need correction. Sign in to the customer portal, review the remarks, and upload a corrected version."
			                        ]
			                    }
			                }
			            )
			        }
			    }
			}

			View_Customer_KYC as "View KYC"
			{
			    type = functions
			    form = Customers
			    execution type = for each record
			    description = "Opens the secure KYC review workspace for the selected customer"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                openUrl("#Page:KYC_Review?Customer_ID=" + input.ID,"same window");
			            )
			        }
			    }
			}

			Deliver_Shipment as "Deliver Shipment - My Delivery Tasks"
			{
			    type = functions
			    form = Delivery_Run_Sheet_Items
			    execution type = for each record
			    description = "Validates proof, COD, recipient, and location; completes delivery; generates ePOD; and posts one-time loyalty"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                run_record = Delivery_Run_Sheets[ID == input.Delivery_Run_Sheet];
			                assigned_agent = Operations_Users[ID == run_record.Assigned_Agent];
			                authorised = assigned_agent.count(ID) > 0 && assigned_agent.Work_Email == zoho.loginuserid || Operations_Users[Work_Email == zoho.loginuserid && Active == true].count(ID) > 0;
			                shipment_record = Shipment_Requests[ID == input.Shipment];
			                if(authorised == false)
			                {
			                    info "Only the assigned agent or an active operations user can complete delivery.";
			                }
			                else if(input.Delivery_Status != "Out For Delivery" || shipment_record.Shipment_Status != "Out For Delivery (OFD)" || (run_record.DRS_Status != "Released" && run_record.DRS_Status != "In Progress"))
			                {
			                    info "The shipment and stop must both be out for delivery on an active run.";
			                }
			                else if(input.Arrived_At == null)
			                {
			                    info "Mark arrival before completing delivery.";
			                }
			                else if(ifnull(input.Recipient_Name,"").trim() == "")
			                {
			                    info "Recipient name is required for delivery proof.";
			                }
			                else if(input.Agent_Latitude == null || input.Agent_Longitude == null)
			                {
			                    info "Agent latitude and longitude are required for delivery completion.";
			                }
			                else
			                {
			                    proof_count = 0;
			                    if(ifnull(input.Recipient_OTP,"").trim() != "")
			                    {
			                        proof_count = proof_count + 1;
			                    }
			                    if(input.Recipient_Signature != null)
			                    {
			                        proof_count = proof_count + 1;
			                    }
			                    if(input.Delivery_Photo != null)
			                    {
			                        proof_count = proof_count + 1;
			                    }
			                    proof_valid = proof_count == 1 && ((input.Proof_Type == "OTP" && ifnull(input.Recipient_OTP,"").trim() != "") || (input.Proof_Type == "Signature" && input.Recipient_Signature != null) || (input.Proof_Type == "Photo" && input.Delivery_Photo != null));
			                    if(proof_valid == false)
			                    {
			                        info "Capture exactly one proof item and select its matching OTP, signature, or photo proof type.";
			                    }
			                    else
			                    {
			                        expected_cod = if(shipment_record.Payment_Type == "COD",ifnull(shipment_record.COD_Amount,0),0);
			                        cod_valid = (ifnull(input.COD_Collected,0) - expected_cod).abs() <= 0.01;
			                        if(cod_valid == false)
			                        {
			                            info "COD collected must exactly match the shipment COD amount of INR " + expected_cod + ".";
			                        }
			                        else
			                        {
			                            customer_record = Customers[ID == shipment_record.Customer];
			                            prior_shipment_status = shipment_record.Shipment_Status;
			                            input.Delivery_Status = "Delivered";
			                            input.Completed_At = zoho.currenttime;
			                            input.Attempt_Number = ifnull(shipment_record.NDR_Attempt_Count,0) + 1;
			                            input.NDR_Reason = null;
			                            input.NDR_Notes = null;
			                            shipment_record.Shipment_Status = "Delivered";
			                            shipment_record.Current_Hub = run_record.Hub;
			                            tracking_id = insert into Shipment_Tracking_Events
			                            [
			                                Shipment = shipment_record.ID
			                                Event_Time = zoho.currenttime
			                                Event_Status = "Delivered"
			                                Hub = run_record.Hub
			                                Agent = assigned_agent.ID
			                                Latitude = input.Agent_Latitude
			                                Longitude = input.Agent_Longitude
			                                Event_Description = "Shipment delivered to " + input.Recipient_Name + " with " + input.Proof_Type + " proof."
			                                Source = "Delivery"
			                                Customer_Visible = true
			                                Created_By_Email = zoho.loginuserid
			                            ];
			                            loyalty_points = 0.0;
			                            loyalty_reference = "No active loyalty rule matched";
			                            if(shipment_record.Loyalty_Awarded != true && Loyalty_Transactions[Shipment == shipment_record.ID && Transaction_Type == "Earn"].count(ID) == 0)
			                            {
			                                rule_record = Loyalty_Rules[Status == "Active" && Effective_From <= zoho.currentdate && (Effective_To == null || Effective_To >= zoho.currentdate) && (Customer_Type == customer_record.Customer_Type || Customer_Type == "All") && (Transport_Mode == shipment_record.Transport_Mode || Transport_Mode == "Any") && Minimum_Shipment_Amount <= shipment_record.Total_Payable] sort by Minimum_Shipment_Amount desc range from 0 to 0;
			                                if(rule_record.count(ID) > 0)
			                                {
			                                    tier_multiplier = 1.0;
			                                    if(customer_record.Current_Loyalty_Tier != "None")
			                                    {
			                                        tier_record = Loyalty_Tiers[Tier_Name == customer_record.Current_Loyalty_Tier && Active == true];
			                                        if(tier_record.count(ID) > 0)
			                                        {
			                                            tier_multiplier = ifnull(tier_record.Points_Multiplier,1);
			                                        }
			                                    }
			                                    loyalty_points = (shipment_record.Total_Payable * rule_record.Points_Per_INR * tier_multiplier).round(2);
			                                    if(rule_record.Maximum_Points_Per_Shipment != null && rule_record.Maximum_Points_Per_Shipment > 0 && loyalty_points > rule_record.Maximum_Points_Per_Shipment)
			                                    {
			                                        loyalty_points = rule_record.Maximum_Points_Per_Shipment;
			                                    }
			                                    if(loyalty_points > 0)
			                                    {
			                                        config_record = App_Configuration[Active == true] range from 0 to 0;
			                                        expiry_months = if(rule_record.Points_Expiry_Months != null && rule_record.Points_Expiry_Months > 0,rule_record.Points_Expiry_Months,if(config_record.count(ID) > 0,config_record.Points_Expiry_Months,12));
			                                        point_value = if(config_record.count(ID) > 0,config_record.Loyalty_Redemption_Value_Per_Point,1);
			                                        loyalty_id = insert into Loyalty_Transactions
			                                        [
			                                            Customer = customer_record.ID
			                                            Shipment = shipment_record.ID
			                                            Transaction_Type = "Earn"
			                                            Points = loyalty_points
			                                            Amount_Equivalent = (loyalty_points * point_value).round(2)
			                                            Transaction_Date = zoho.currenttime
			                                            Expiry_Date = zoho.currentdate.addMonth(expiry_months)
			                                            Points_Status = "Available"
			                                            Applied_Tier = customer_record.Current_Loyalty_Tier
			                                            Reference = "Delivered AWB " + shipment_record.AWB_Number
			                                            Notes = "Points earned after confirmed delivery using rule " + rule_record.Rule_Name
			                                            Posted_By_Email = zoho.loginuserid
			                                            Customer_Login_Email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID)
			                                        ];
			                                        customer_record.Current_Loyalty_Points = ifnull(customer_record.Current_Loyalty_Points,0) + loyalty_points;
			                                        customer_record.Lifetime_Loyalty_Points = ifnull(customer_record.Lifetime_Loyalty_Points,0) + loyalty_points;
			                                        customer_record.Quarterly_Eligible_Spend = ifnull(customer_record.Quarterly_Eligible_Spend,0) + shipment_record.Total_Payable;
			                                        shipment_record.Loyalty_Awarded = true;
			                                        loyalty_reference = "Earned " + loyalty_points + " points";
			                                    }
			                                }
			                            }
			                            epod_html = "<html><body style='font-family:Arial,sans-serif;color:#1f2937'><h1>Electronic Proof of Delivery</h1><table style='border-collapse:collapse;width:100%'><tr><td><b>AWB</b></td><td>" + shipment_record.AWB_Number + "</td></tr><tr><td><b>DRS</b></td><td>" + run_record.DRS_Number + "</td></tr><tr><td><b>Delivered At</b></td><td>" + input.Completed_At + "</td></tr><tr><td><b>Recipient</b></td><td>" + input.Recipient_Name + "</td></tr><tr><td><b>Proof Type</b></td><td>" + input.Proof_Type + "</td></tr><tr><td><b>COD Collected</b></td><td>INR " + input.COD_Collected + "</td></tr><tr><td><b>Agent</b></td><td>" + assigned_agent.Employee_Name.first_name + "</td></tr><tr><td><b>Coordinates</b></td><td>" + input.Agent_Latitude + ", " + input.Agent_Longitude + "</td></tr></table><p>This system-generated ePOD is backed by the delivery evidence retained in the logistics application.</p></body></html>";
			                            epod_pdf = zoho.file.convertToPDF(epod_html);
			                            epod_file_name = "EPOD_" + shipment_record.AWB_Number + ".pdf";
			                            epod_pdf.setFileName(epod_file_name);
			                            workdrive_uploaded = false;
			                            try
			                            {
			                                workdrive_response = zoho.workdrive.uploadFile(epod_pdf,"CONFIGURE_EPOD_FOLDER_ID",encodeUrl(epod_file_name),true,"zoho_workdrive");
			                                if(workdrive_response.containKey("data"))
			                                {
			                                    workdrive_data = workdrive_response.get("data");
			                                    if(workdrive_data.size() > 0)
			                                    {
			                                        workdrive_attributes = workdrive_data.get(0).get("attributes");
			                                        workdrive_resource_id = workdrive_attributes.get("resource_id");
			                                        input.EPOD_WorkDrive_File_ID = workdrive_resource_id;
			                                        input.EPOD_URL = "https://workdrive.zoho.com/open/" + workdrive_resource_id;
			                                        shipment_record.EPOD_WorkDrive_File_ID = workdrive_resource_id;
			                                        shipment_record.EPOD_Download_URL = input.EPOD_URL;
			                                        workdrive_uploaded = true;
			                                    }
			                                }
			                            }
			                            catch (workdrive_error)
			                            {
			                                input.EPOD_WorkDrive_File_ID = "PENDING-WORKDRIVE-CONFIGURATION";
			                                shipment_record.EPOD_WorkDrive_File_ID = input.EPOD_WorkDrive_File_ID;
			                            }
			                            delivered_count = Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.Delivery_Run_Sheet && ID != input.ID && Delivery_Status == "Delivered"].count(ID) + 1;
			                            failed_count = Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.Delivery_Run_Sheet && ID != input.ID && (Delivery_Status == "Failed" || Delivery_Status == "RTO")].count(ID);
			                            collected_cod = ifnull(input.COD_Collected,0);
			                            for each delivered_item in Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.Delivery_Run_Sheet && ID != input.ID && Delivery_Status == "Delivered"]
			                            {
			                                collected_cod = collected_cod + ifnull(delivered_item.COD_Collected,0);
			                            }
			                            run_record.Delivered_Count = delivered_count;
			                            run_record.Failed_Count = failed_count;
			                            run_record.Collected_COD_Amount = collected_cod;
			                            run_record.DRS_Status = "In Progress";
			                            recipient_email = if(ifnull(shipment_record.Recipient_Email,"").trim() != "",shipment_record.Recipient_Email,customer_record.Email_ID);
			                            communication_id = insert into Communication_Log
			                            [
			                                Customer = customer_record.ID
			                                Shipment = shipment_record.ID
			                                Recipient = recipient_email
			                                Channel = "Email"
			                                Template_Code = "SHIPMENT_DELIVERED"
			                                Subject = "Shipment delivered: AWB " + shipment_record.AWB_Number
			                                Message_Summary = "Shipment delivered successfully. ePOD generated; WorkDrive archive status: " + if(workdrive_uploaded == true,"Archived","Pending configuration") + "."
			                                Provider = "Zoho Mail"
			                                Communication_Status = "Sent"
			                                Attempt_Count = 1
			                                Last_Attempt_At = zoho.currenttime
			                            ];
			                            sendmail
			                            [
			                                from: zoho.adminuserid
			                                to: recipient_email
			                                subject: "Shipment delivered: AWB " + shipment_record.AWB_Number
			                                message: "Your shipment was delivered successfully to " + input.Recipient_Name + ". " + loyalty_reference + ". The electronic proof of delivery is attached."
			                                Attachments : file : epod_pdf
			                            ]
			                            audit_id = insert into Audit_Log
			                            [
			                                Event_Time = zoho.currenttime
			                                Actor_Email = zoho.loginuserid
			                                Actor_Profile = current_profile
			                                Action_Name = "Deliver Shipment"
			                                Module_Name = "Delivery Run Sheet Items"
			                                Record_ID = input.ID.toString()
			                                Before_Data = "Stop=Out For Delivery; Shipment=" + prior_shipment_status
			                                After_Data = "Stop=Delivered; Shipment=Delivered; Proof=" + input.Proof_Type + "; COD=" + input.COD_Collected + "; " + loyalty_reference + "; WorkDrive Archived=" + workdrive_uploaded
			                                Source = "Report Action"
			                                Severity = "Critical"
			                            ];
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Deliver_Shipment_Delivery_Run_Items as "Deliver Shipment - Delivery Run Items"
			{
			    type = functions
			    form = Delivery_Run_Sheet_Items
			    execution type = for each record
			    description = "Validates proof, COD, recipient, and location; completes delivery; generates ePOD; and posts one-time loyalty"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                run_record = Delivery_Run_Sheets[ID == input.Delivery_Run_Sheet];
			                assigned_agent = Operations_Users[ID == run_record.Assigned_Agent];
			                authorised = assigned_agent.count(ID) > 0 && assigned_agent.Work_Email == zoho.loginuserid || Operations_Users[Work_Email == zoho.loginuserid && Active == true].count(ID) > 0;
			                shipment_record = Shipment_Requests[ID == input.Shipment];
			                if(authorised == false)
			                {
			                    info "Only the assigned agent or an active operations user can complete delivery.";
			                }
			                else if(input.Delivery_Status != "Out For Delivery" || shipment_record.Shipment_Status != "Out For Delivery (OFD)" || (run_record.DRS_Status != "Released" && run_record.DRS_Status != "In Progress"))
			                {
			                    info "The shipment and stop must both be out for delivery on an active run.";
			                }
			                else if(input.Arrived_At == null)
			                {
			                    info "Mark arrival before completing delivery.";
			                }
			                else if(ifnull(input.Recipient_Name,"").trim() == "")
			                {
			                    info "Recipient name is required for delivery proof.";
			                }
			                else if(input.Agent_Latitude == null || input.Agent_Longitude == null)
			                {
			                    info "Agent latitude and longitude are required for delivery completion.";
			                }
			                else
			                {
			                    proof_count = 0;
			                    if(ifnull(input.Recipient_OTP,"").trim() != "")
			                    {
			                        proof_count = proof_count + 1;
			                    }
			                    if(input.Recipient_Signature != null)
			                    {
			                        proof_count = proof_count + 1;
			                    }
			                    if(input.Delivery_Photo != null)
			                    {
			                        proof_count = proof_count + 1;
			                    }
			                    proof_valid = proof_count == 1 && ((input.Proof_Type == "OTP" && ifnull(input.Recipient_OTP,"").trim() != "") || (input.Proof_Type == "Signature" && input.Recipient_Signature != null) || (input.Proof_Type == "Photo" && input.Delivery_Photo != null));
			                    if(proof_valid == false)
			                    {
			                        info "Capture exactly one proof item and select its matching OTP, signature, or photo proof type.";
			                    }
			                    else
			                    {
			                        expected_cod = if(shipment_record.Payment_Type == "COD",ifnull(shipment_record.COD_Amount,0),0);
			                        cod_valid = (ifnull(input.COD_Collected,0) - expected_cod).abs() <= 0.01;
			                        if(cod_valid == false)
			                        {
			                            info "COD collected must exactly match the shipment COD amount of INR " + expected_cod + ".";
			                        }
			                        else
			                        {
			                            customer_record = Customers[ID == shipment_record.Customer];
			                            prior_shipment_status = shipment_record.Shipment_Status;
			                            input.Delivery_Status = "Delivered";
			                            input.Completed_At = zoho.currenttime;
			                            input.Attempt_Number = ifnull(shipment_record.NDR_Attempt_Count,0) + 1;
			                            input.NDR_Reason = null;
			                            input.NDR_Notes = null;
			                            shipment_record.Shipment_Status = "Delivered";
			                            shipment_record.Current_Hub = run_record.Hub;
			                            tracking_id = insert into Shipment_Tracking_Events
			                            [
			                                Shipment = shipment_record.ID
			                                Event_Time = zoho.currenttime
			                                Event_Status = "Delivered"
			                                Hub = run_record.Hub
			                                Agent = assigned_agent.ID
			                                Latitude = input.Agent_Latitude
			                                Longitude = input.Agent_Longitude
			                                Event_Description = "Shipment delivered to " + input.Recipient_Name + " with " + input.Proof_Type + " proof."
			                                Source = "Delivery"
			                                Customer_Visible = true
			                                Created_By_Email = zoho.loginuserid
			                            ];
			                            loyalty_points = 0.0;
			                            loyalty_reference = "No active loyalty rule matched";
			                            if(shipment_record.Loyalty_Awarded != true && Loyalty_Transactions[Shipment == shipment_record.ID && Transaction_Type == "Earn"].count(ID) == 0)
			                            {
			                                rule_record = Loyalty_Rules[Status == "Active" && Effective_From <= zoho.currentdate && (Effective_To == null || Effective_To >= zoho.currentdate) && (Customer_Type == customer_record.Customer_Type || Customer_Type == "All") && (Transport_Mode == shipment_record.Transport_Mode || Transport_Mode == "Any") && Minimum_Shipment_Amount <= shipment_record.Total_Payable] sort by Minimum_Shipment_Amount desc range from 0 to 0;
			                                if(rule_record.count(ID) > 0)
			                                {
			                                    tier_multiplier = 1.0;
			                                    if(customer_record.Current_Loyalty_Tier != "None")
			                                    {
			                                        tier_record = Loyalty_Tiers[Tier_Name == customer_record.Current_Loyalty_Tier && Active == true];
			                                        if(tier_record.count(ID) > 0)
			                                        {
			                                            tier_multiplier = ifnull(tier_record.Points_Multiplier,1);
			                                        }
			                                    }
			                                    loyalty_points = (shipment_record.Total_Payable * rule_record.Points_Per_INR * tier_multiplier).round(2);
			                                    if(rule_record.Maximum_Points_Per_Shipment != null && rule_record.Maximum_Points_Per_Shipment > 0 && loyalty_points > rule_record.Maximum_Points_Per_Shipment)
			                                    {
			                                        loyalty_points = rule_record.Maximum_Points_Per_Shipment;
			                                    }
			                                    if(loyalty_points > 0)
			                                    {
			                                        config_record = App_Configuration[Active == true] range from 0 to 0;
			                                        expiry_months = if(rule_record.Points_Expiry_Months != null && rule_record.Points_Expiry_Months > 0,rule_record.Points_Expiry_Months,if(config_record.count(ID) > 0,config_record.Points_Expiry_Months,12));
			                                        point_value = if(config_record.count(ID) > 0,config_record.Loyalty_Redemption_Value_Per_Point,1);
			                                        loyalty_id = insert into Loyalty_Transactions
			                                        [
			                                            Customer = customer_record.ID
			                                            Shipment = shipment_record.ID
			                                            Transaction_Type = "Earn"
			                                            Points = loyalty_points
			                                            Amount_Equivalent = (loyalty_points * point_value).round(2)
			                                            Transaction_Date = zoho.currenttime
			                                            Expiry_Date = zoho.currentdate.addMonth(expiry_months)
			                                            Points_Status = "Available"
			                                            Applied_Tier = customer_record.Current_Loyalty_Tier
			                                            Reference = "Delivered AWB " + shipment_record.AWB_Number
			                                            Notes = "Points earned after confirmed delivery using rule " + rule_record.Rule_Name
			                                            Posted_By_Email = zoho.loginuserid
			                                            Customer_Login_Email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID)
			                                        ];
			                                        customer_record.Current_Loyalty_Points = ifnull(customer_record.Current_Loyalty_Points,0) + loyalty_points;
			                                        customer_record.Lifetime_Loyalty_Points = ifnull(customer_record.Lifetime_Loyalty_Points,0) + loyalty_points;
			                                        customer_record.Quarterly_Eligible_Spend = ifnull(customer_record.Quarterly_Eligible_Spend,0) + shipment_record.Total_Payable;
			                                        shipment_record.Loyalty_Awarded = true;
			                                        loyalty_reference = "Earned " + loyalty_points + " points";
			                                    }
			                                }
			                            }
			                            epod_html = "<html><body style='font-family:Arial,sans-serif;color:#1f2937'><h1>Electronic Proof of Delivery</h1><table style='border-collapse:collapse;width:100%'><tr><td><b>AWB</b></td><td>" + shipment_record.AWB_Number + "</td></tr><tr><td><b>DRS</b></td><td>" + run_record.DRS_Number + "</td></tr><tr><td><b>Delivered At</b></td><td>" + input.Completed_At + "</td></tr><tr><td><b>Recipient</b></td><td>" + input.Recipient_Name + "</td></tr><tr><td><b>Proof Type</b></td><td>" + input.Proof_Type + "</td></tr><tr><td><b>COD Collected</b></td><td>INR " + input.COD_Collected + "</td></tr><tr><td><b>Agent</b></td><td>" + assigned_agent.Employee_Name.first_name + "</td></tr><tr><td><b>Coordinates</b></td><td>" + input.Agent_Latitude + ", " + input.Agent_Longitude + "</td></tr></table><p>This system-generated ePOD is backed by the delivery evidence retained in the logistics application.</p></body></html>";
			                            epod_pdf = zoho.file.convertToPDF(epod_html);
			                            epod_file_name = "EPOD_" + shipment_record.AWB_Number + ".pdf";
			                            epod_pdf.setFileName(epod_file_name);
			                            workdrive_uploaded = false;
			                            try
			                            {
			                                workdrive_response = zoho.workdrive.uploadFile(epod_pdf,"CONFIGURE_EPOD_FOLDER_ID",encodeUrl(epod_file_name),true,"zoho_workdrive");
			                                if(workdrive_response.containKey("data"))
			                                {
			                                    workdrive_data = workdrive_response.get("data");
			                                    if(workdrive_data.size() > 0)
			                                    {
			                                        workdrive_attributes = workdrive_data.get(0).get("attributes");
			                                        workdrive_resource_id = workdrive_attributes.get("resource_id");
			                                        input.EPOD_WorkDrive_File_ID = workdrive_resource_id;
			                                        input.EPOD_URL = "https://workdrive.zoho.com/open/" + workdrive_resource_id;
			                                        shipment_record.EPOD_WorkDrive_File_ID = workdrive_resource_id;
			                                        shipment_record.EPOD_Download_URL = input.EPOD_URL;
			                                        workdrive_uploaded = true;
			                                    }
			                                }
			                            }
			                            catch (workdrive_error)
			                            {
			                                input.EPOD_WorkDrive_File_ID = "PENDING-WORKDRIVE-CONFIGURATION";
			                                shipment_record.EPOD_WorkDrive_File_ID = input.EPOD_WorkDrive_File_ID;
			                            }
			                            delivered_count = Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.Delivery_Run_Sheet && ID != input.ID && Delivery_Status == "Delivered"].count(ID) + 1;
			                            failed_count = Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.Delivery_Run_Sheet && ID != input.ID && (Delivery_Status == "Failed" || Delivery_Status == "RTO")].count(ID);
			                            collected_cod = ifnull(input.COD_Collected,0);
			                            for each delivered_item in Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.Delivery_Run_Sheet && ID != input.ID && Delivery_Status == "Delivered"]
			                            {
			                                collected_cod = collected_cod + ifnull(delivered_item.COD_Collected,0);
			                            }
			                            run_record.Delivered_Count = delivered_count;
			                            run_record.Failed_Count = failed_count;
			                            run_record.Collected_COD_Amount = collected_cod;
			                            run_record.DRS_Status = "In Progress";
			                            recipient_email = if(ifnull(shipment_record.Recipient_Email,"").trim() != "",shipment_record.Recipient_Email,customer_record.Email_ID);
			                            communication_id = insert into Communication_Log
			                            [
			                                Customer = customer_record.ID
			                                Shipment = shipment_record.ID
			                                Recipient = recipient_email
			                                Channel = "Email"
			                                Template_Code = "SHIPMENT_DELIVERED"
			                                Subject = "Shipment delivered: AWB " + shipment_record.AWB_Number
			                                Message_Summary = "Shipment delivered successfully. ePOD generated; WorkDrive archive status: " + if(workdrive_uploaded == true,"Archived","Pending configuration") + "."
			                                Provider = "Zoho Mail"
			                                Communication_Status = "Sent"
			                                Attempt_Count = 1
			                                Last_Attempt_At = zoho.currenttime
			                            ];
			                            sendmail
			                            [
			                                from: zoho.adminuserid
			                                to: recipient_email
			                                subject: "Shipment delivered: AWB " + shipment_record.AWB_Number
			                                message: "Your shipment was delivered successfully to " + input.Recipient_Name + ". " + loyalty_reference + ". The electronic proof of delivery is attached."
			                                Attachments : file : epod_pdf
			                            ]
			                            audit_id = insert into Audit_Log
			                            [
			                                Event_Time = zoho.currenttime
			                                Actor_Email = zoho.loginuserid
			                                Actor_Profile = current_profile
			                                Action_Name = "Deliver Shipment"
			                                Module_Name = "Delivery Run Sheet Items"
			                                Record_ID = input.ID.toString()
			                                Before_Data = "Stop=Out For Delivery; Shipment=" + prior_shipment_status
			                                After_Data = "Stop=Delivered; Shipment=Delivered; Proof=" + input.Proof_Type + "; COD=" + input.COD_Collected + "; " + loyalty_reference + "; WorkDrive Archived=" + workdrive_uploaded
			                                Source = "Report Action"
			                                Severity = "Critical"
			                            ];
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Fail_Delivery as "Failed Delivery - My Delivery Tasks"
			{
			    type = functions
			    form = Delivery_Run_Sheet_Items
			    execution type = for each record
			    description = "Captures NDR evidence, increments attempts, creates a secure instruction request, notifies the recipient, and applies RTO policy"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                run_record = Delivery_Run_Sheets[ID == input.Delivery_Run_Sheet];
			                assigned_agent = Operations_Users[ID == run_record.Assigned_Agent];
			                authorised = assigned_agent.count(ID) > 0 && assigned_agent.Work_Email == zoho.loginuserid || Operations_Users[Work_Email == zoho.loginuserid && Active == true].count(ID) > 0;
			                shipment_record = Shipment_Requests[ID == input.Shipment];
			                if(authorised == false)
			                {
			                    info "Only the assigned agent or an active operations user can record a failed delivery.";
			                }
			                else if(input.Delivery_Status != "Out For Delivery" || shipment_record.Shipment_Status != "Out For Delivery (OFD)" || (run_record.DRS_Status != "Released" && run_record.DRS_Status != "In Progress"))
			                {
			                    info "Only an out-for-delivery shipment on an active run can be failed.";
			                }
			                else if(input.Arrived_At == null)
			                {
			                    info "Mark arrival before recording a delivery failure.";
			                }
			                else if(input.NDR_Reason == null || ifnull(input.NDR_Notes,"").trim() == "")
			                {
			                    info "Select an NDR reason and enter internal failure notes.";
			                }
			                else if(input.Agent_Latitude == null || input.Agent_Longitude == null)
			                {
			                    info "Agent latitude and longitude are required for a failed delivery.";
			                }
			                else
			                {
			                    customer_record = Customers[ID == shipment_record.Customer];
			                    config_record = App_Configuration[Active == true] range from 0 to 0;
			                    maximum_attempts = if(config_record.count(ID) > 0,config_record.Maximum_NDR_Attempts,3);
			                    next_attempt = ifnull(shipment_record.NDR_Attempt_Count,0) + 1;
			                    rto_required = input.NDR_Reason == "Refused COD" || next_attempt >= maximum_attempts;
			                    input.Attempt_Number = next_attempt;
			                    input.Completed_At = zoho.currenttime;
			                    input.Proof_Type = null;
			                    input.Recipient_OTP = null;
			                    input.Delivery_Photo = null;
			                    input.Recipient_Name = null;
			                    input.COD_Collected = 0;
			                    shipment_record.NDR_Attempt_Count = next_attempt;
			                    if(rto_required == true)
			                    {
			                        input.Delivery_Status = "RTO";
			                        shipment_record.Shipment_Status = "Return to Origin";
			                    }
			                    else
			                    {
			                        input.Delivery_Status = "Failed";
			                        shipment_record.Shipment_Status = "Delivery Failed - NDR";
			                    }
			                    token_source = shipment_record.ID + "|" + input.ID + "|" + zoho.currenttime + "|" + randomNumber(100000,999999);
			                    secure_token = zoho.encryption.md5(token_source);
			                    ndr_status = if(rto_required == true,"RTO","Awaiting Instruction");
			                    ndr_id = insert into NDR_Instructions
			                    [
			                        Customer = customer_record.ID
			                        Customer_Login_Email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID)
			                        Shipment = shipment_record.ID
			                        Delivery_Run_Item = input.ID
			                        Secure_Token = secure_token
			                        Failure_Reason = input.NDR_Reason
			                        Submitted_At = null
			                        NDR_Status = ndr_status
			                        Supervisor_Notes = "Attempt " + next_attempt + " recorded by " + zoho.loginuserid + ". Internal agent notes are retained on the delivery stop."
			                    ];
			                    ndr_link = zoho.appuri + "form-perma/NDR_Response?Secure_Token=" + encodeUrl(secure_token);
			                    event_status = if(rto_required == true,"Return to Origin","Delivery Failed - NDR");
			                    tracking_id = insert into Shipment_Tracking_Events
			                    [
			                        Shipment = shipment_record.ID
			                        Event_Time = zoho.currenttime
			                        Event_Status = event_status
			                        Hub = run_record.Hub
			                        Agent = assigned_agent.ID
			                        Latitude = input.Agent_Latitude
			                        Longitude = input.Agent_Longitude
			                        Event_Description = if(rto_required == true,"Delivery could not be completed and the shipment entered return-to-origin processing.","Delivery could not be completed. Recipient instruction is awaited for the next attempt.")
			                        Source = if(rto_required == true,"RTO","NDR")
			                        Customer_Visible = true
			                        Created_By_Email = zoho.loginuserid
			                    ];
			                    recipient_email = if(ifnull(shipment_record.Recipient_Email,"").trim() != "",shipment_record.Recipient_Email,customer_record.Email_ID);
			                    communication_id = insert into Communication_Log
			                    [
			                        Customer = customer_record.ID
			                        Shipment = shipment_record.ID
			                        Recipient = recipient_email
			                        Channel = "Email"
			                        Template_Code = if(rto_required == true,"SHIPMENT_RTO_INITIATED","SHIPMENT_NDR_ACTION_REQUIRED")
			                        Subject = if(rto_required == true,"Shipment returning to origin: AWB " + shipment_record.AWB_Number,"Delivery action required: AWB " + shipment_record.AWB_Number)
			                        Message_Summary = if(rto_required == true,"Delivery attempts ended under the configured RTO policy.","Recipient was sent a secure NDR instruction link after failed delivery attempt " + next_attempt + ".")
			                        Provider = "Zoho Mail"
			                        Communication_Status = "Sent"
			                        Attempt_Count = 1
			                        Last_Attempt_At = zoho.currenttime
			                    ];
			                    if(rto_required == true)
			                    {
			                        sendmail
			                        [
			                            from: zoho.adminuserid
			                            to: recipient_email
			                            subject: "Shipment returning to origin: AWB " + shipment_record.AWB_Number
			                            message: "Delivery could not be completed after attempt " + next_attempt + ". The shipment is now entering return-to-origin processing."
			                        ]
			                    }
			                    else
			                    {
			                        sendmail
			                        [
			                            from: zoho.adminuserid
			                            to: recipient_email
			                            subject: "Delivery action required: AWB " + shipment_record.AWB_Number
			                            message: "We could not complete delivery attempt " + next_attempt + ". Use this secure link to reschedule, update the address, or request local-office hold: " + ndr_link
			                        ]
			                    }
			                    delivered_count = Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.Delivery_Run_Sheet && ID != input.ID && Delivery_Status == "Delivered"].count(ID);
			                    failed_count = Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.Delivery_Run_Sheet && ID != input.ID && (Delivery_Status == "Failed" || Delivery_Status == "RTO")].count(ID) + 1;
			                    collected_cod = 0.0;
			                    for each delivered_item in Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.Delivery_Run_Sheet && ID != input.ID && Delivery_Status == "Delivered"]
			                    {
			                        collected_cod = collected_cod + ifnull(delivered_item.COD_Collected,0);
			                    }
			                    run_record.Delivered_Count = delivered_count;
			                    run_record.Failed_Count = failed_count;
			                    run_record.Collected_COD_Amount = collected_cod;
			                    run_record.DRS_Status = "In Progress";
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuserid
			                        Actor_Profile = current_profile
			                        Action_Name = "Record Failed Delivery"
			                        Module_Name = "Delivery Run Sheet Items"
			                        Record_ID = input.ID.toString()
			                        Before_Data = "Stop=Out For Delivery; Shipment=Out For Delivery (OFD)"
			                        After_Data = "Stop=" + input.Delivery_Status + "; Shipment=" + shipment_record.Shipment_Status + "; NDR Reason=" + input.NDR_Reason + "; Attempt=" + next_attempt + "; NDR ID=" + ndr_id
			                        Source = "Report Action"
			                        Severity = "Critical"
			                    ];
			                }
			            )
			        }
			    }
			}

			Fail_Delivery_Delivery_Run_Items as "Failed Delivery - Delivery Run Items"
			{
			    type = functions
			    form = Delivery_Run_Sheet_Items
			    execution type = for each record
			    description = "Captures NDR evidence, increments attempts, creates a secure instruction request, notifies the recipient, and applies RTO policy"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                run_record = Delivery_Run_Sheets[ID == input.Delivery_Run_Sheet];
			                assigned_agent = Operations_Users[ID == run_record.Assigned_Agent];
			                authorised = assigned_agent.count(ID) > 0 && assigned_agent.Work_Email == zoho.loginuserid || Operations_Users[Work_Email == zoho.loginuserid && Active == true].count(ID) > 0;
			                shipment_record = Shipment_Requests[ID == input.Shipment];
			                if(authorised == false)
			                {
			                    info "Only the assigned agent or an active operations user can record a failed delivery.";
			                }
			                else if(input.Delivery_Status != "Out For Delivery" || shipment_record.Shipment_Status != "Out For Delivery (OFD)" || (run_record.DRS_Status != "Released" && run_record.DRS_Status != "In Progress"))
			                {
			                    info "Only an out-for-delivery shipment on an active run can be failed.";
			                }
			                else if(input.Arrived_At == null)
			                {
			                    info "Mark arrival before recording a delivery failure.";
			                }
			                else if(input.NDR_Reason == null || ifnull(input.NDR_Notes,"").trim() == "")
			                {
			                    info "Select an NDR reason and enter internal failure notes.";
			                }
			                else if(input.Agent_Latitude == null || input.Agent_Longitude == null)
			                {
			                    info "Agent latitude and longitude are required for a failed delivery.";
			                }
			                else
			                {
			                    customer_record = Customers[ID == shipment_record.Customer];
			                    config_record = App_Configuration[Active == true] range from 0 to 0;
			                    maximum_attempts = if(config_record.count(ID) > 0,config_record.Maximum_NDR_Attempts,3);
			                    next_attempt = ifnull(shipment_record.NDR_Attempt_Count,0) + 1;
			                    rto_required = input.NDR_Reason == "Refused COD" || next_attempt >= maximum_attempts;
			                    input.Attempt_Number = next_attempt;
			                    input.Completed_At = zoho.currenttime;
			                    input.Proof_Type = null;
			                    input.Recipient_OTP = null;
			                    input.Delivery_Photo = null;
			                    input.Recipient_Name = null;
			                    input.COD_Collected = 0;
			                    shipment_record.NDR_Attempt_Count = next_attempt;
			                    if(rto_required == true)
			                    {
			                        input.Delivery_Status = "RTO";
			                        shipment_record.Shipment_Status = "Return to Origin";
			                    }
			                    else
			                    {
			                        input.Delivery_Status = "Failed";
			                        shipment_record.Shipment_Status = "Delivery Failed - NDR";
			                    }
			                    token_source = shipment_record.ID + "|" + input.ID + "|" + zoho.currenttime + "|" + randomNumber(100000,999999);
			                    secure_token = zoho.encryption.md5(token_source);
			                    ndr_status = if(rto_required == true,"RTO","Awaiting Instruction");
			                    ndr_id = insert into NDR_Instructions
			                    [
			                        Customer = customer_record.ID
			                        Customer_Login_Email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID)
			                        Shipment = shipment_record.ID
			                        Delivery_Run_Item = input.ID
			                        Secure_Token = secure_token
			                        Failure_Reason = input.NDR_Reason
			                        Submitted_At = null
			                        NDR_Status = ndr_status
			                        Supervisor_Notes = "Attempt " + next_attempt + " recorded by " + zoho.loginuserid + ". Internal agent notes are retained on the delivery stop."
			                    ];
			                    ndr_link = zoho.appuri + "form-perma/NDR_Response?Secure_Token=" + encodeUrl(secure_token);
			                    event_status = if(rto_required == true,"Return to Origin","Delivery Failed - NDR");
			                    tracking_id = insert into Shipment_Tracking_Events
			                    [
			                        Shipment = shipment_record.ID
			                        Event_Time = zoho.currenttime
			                        Event_Status = event_status
			                        Hub = run_record.Hub
			                        Agent = assigned_agent.ID
			                        Latitude = input.Agent_Latitude
			                        Longitude = input.Agent_Longitude
			                        Event_Description = if(rto_required == true,"Delivery could not be completed and the shipment entered return-to-origin processing.","Delivery could not be completed. Recipient instruction is awaited for the next attempt.")
			                        Source = if(rto_required == true,"RTO","NDR")
			                        Customer_Visible = true
			                        Created_By_Email = zoho.loginuserid
			                    ];
			                    recipient_email = if(ifnull(shipment_record.Recipient_Email,"").trim() != "",shipment_record.Recipient_Email,customer_record.Email_ID);
			                    communication_id = insert into Communication_Log
			                    [
			                        Customer = customer_record.ID
			                        Shipment = shipment_record.ID
			                        Recipient = recipient_email
			                        Channel = "Email"
			                        Template_Code = if(rto_required == true,"SHIPMENT_RTO_INITIATED","SHIPMENT_NDR_ACTION_REQUIRED")
			                        Subject = if(rto_required == true,"Shipment returning to origin: AWB " + shipment_record.AWB_Number,"Delivery action required: AWB " + shipment_record.AWB_Number)
			                        Message_Summary = if(rto_required == true,"Delivery attempts ended under the configured RTO policy.","Recipient was sent a secure NDR instruction link after failed delivery attempt " + next_attempt + ".")
			                        Provider = "Zoho Mail"
			                        Communication_Status = "Sent"
			                        Attempt_Count = 1
			                        Last_Attempt_At = zoho.currenttime
			                    ];
			                    if(rto_required == true)
			                    {
			                        sendmail
			                        [
			                            from: zoho.adminuserid
			                            to: recipient_email
			                            subject: "Shipment returning to origin: AWB " + shipment_record.AWB_Number
			                            message: "Delivery could not be completed after attempt " + next_attempt + ". The shipment is now entering return-to-origin processing."
			                        ]
			                    }
			                    else
			                    {
			                        sendmail
			                        [
			                            from: zoho.adminuserid
			                            to: recipient_email
			                            subject: "Delivery action required: AWB " + shipment_record.AWB_Number
			                            message: "We could not complete delivery attempt " + next_attempt + ". Use this secure link to reschedule, update the address, or request local-office hold: " + ndr_link
			                        ]
			                    }
			                    delivered_count = Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.Delivery_Run_Sheet && ID != input.ID && Delivery_Status == "Delivered"].count(ID);
			                    failed_count = Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.Delivery_Run_Sheet && ID != input.ID && (Delivery_Status == "Failed" || Delivery_Status == "RTO")].count(ID) + 1;
			                    collected_cod = 0.0;
			                    for each delivered_item in Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.Delivery_Run_Sheet && ID != input.ID && Delivery_Status == "Delivered"]
			                    {
			                        collected_cod = collected_cod + ifnull(delivered_item.COD_Collected,0);
			                    }
			                    run_record.Delivered_Count = delivered_count;
			                    run_record.Failed_Count = failed_count;
			                    run_record.Collected_COD_Amount = collected_cod;
			                    run_record.DRS_Status = "In Progress";
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuserid
			                        Actor_Profile = current_profile
			                        Action_Name = "Record Failed Delivery"
			                        Module_Name = "Delivery Run Sheet Items"
			                        Record_ID = input.ID.toString()
			                        Before_Data = "Stop=Out For Delivery; Shipment=Out For Delivery (OFD)"
			                        After_Data = "Stop=" + input.Delivery_Status + "; Shipment=" + shipment_record.Shipment_Status + "; NDR Reason=" + input.NDR_Reason + "; Attempt=" + next_attempt + "; NDR ID=" + ndr_id
			                        Source = "Report Action"
			                        Severity = "Critical"
			                    ];
			                }
			            )
			        }
			    }
			}

			Mark_Arrived_Delivery_Run_Items as "Mark Arrived - Delivery Run Items"
			{
			    type = functions
			    form = Delivery_Run_Sheet_Items
			    execution type = for each record
			    description = "Stamps last-mile arrival and agent location without changing the out-for-delivery state"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                run_record = Delivery_Run_Sheets[ID == input.Delivery_Run_Sheet];
			                assigned_agent = Operations_Users[ID == run_record.Assigned_Agent];
			                authorised = assigned_agent.count(ID) > 0 && assigned_agent.Work_Email == zoho.loginuserid || Operations_Users[Work_Email == zoho.loginuserid && Active == true].count(ID) > 0;
			                if(authorised == false)
			                {
			                    info "Only the assigned agent or an active operations user can mark arrival.";
			                }
			                else if(input.Delivery_Status != "Out For Delivery" || (run_record.DRS_Status != "Released" && run_record.DRS_Status != "In Progress"))
			                {
			                    info "Only an out-for-delivery stop on an active run can be marked arrived.";
			                }
			                else if(input.Arrived_At != null)
			                {
			                    info "Arrival has already been recorded for this stop.";
			                }
			                else
			                {
			                    if(input.Agent_Latitude == null)
			                    {
			                        input.Agent_Latitude = assigned_agent.Current_Latitude;
			                    }
			                    if(input.Agent_Longitude == null)
			                    {
			                        input.Agent_Longitude = assigned_agent.Current_Longitude;
			                    }
			                    if(input.Agent_Latitude == null || input.Agent_Longitude == null)
			                    {
			                        info "Agent location is required before marking arrival.";
			                    }
			                    else
			                    {
			                        input.Arrived_At = zoho.currenttime;
			                        run_record.DRS_Status = "In Progress";
			                        tracking_id = insert into Shipment_Tracking_Events
			                        [
			                            Shipment = input.Shipment
			                            Event_Time = zoho.currenttime
			                            Event_Status = "Information"
			                            Hub = run_record.Hub
			                            Agent = assigned_agent.ID
			                            Latitude = input.Agent_Latitude
			                            Longitude = input.Agent_Longitude
			                            Event_Description = "Delivery agent arrived at the recipient location."
			                            Source = "Delivery"
			                            Customer_Visible = true
			                            Created_By_Email = zoho.loginuserid
			                        ];
			                        audit_id = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.loginuserid
			                            Actor_Profile = current_profile
			                            Action_Name = "Mark Delivery Arrived"
			                            Module_Name = "Delivery Run Sheet Items"
			                            Record_ID = input.ID.toString()
			                            Before_Data = "Arrival not recorded"
			                            After_Data = "Arrived At=" + input.Arrived_At + "; Latitude=" + input.Agent_Latitude + "; Longitude=" + input.Agent_Longitude
			                            Source = "Report Action"
			                            Severity = "Info"
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

