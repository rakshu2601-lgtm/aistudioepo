		    Expiry_Date
		    (
		        type = date
		        displayname = "Expiry Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		
		    Posting_Details
		    (
		        type = section
		        displayname = "Posting Details"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    must have Points_Status
		    (
		        type = picklist
		        displayname = "Points Status"
		        values = {"Available","Consumed","Expired","Not Applicable"}
		        row = 3
		        column = 1
		        width = medium
		    )
		    must have Applied_Tier
		    (
		        type = picklist
		        displayname = "Applied Tier"
		        values = {"None","Silver","Gold","Platinum"}
		        initial value = "None"
		        row = 3
		        column = 2
		        width = medium
		    )
		    Reference
		    (
		        type = text
		        displayname = "Reference"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 3
		        column = 2
		        width = medium
		    )
		    Posted_By_Email
		    (
		        type = email
		        displayname = "Posted By Email"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Customer_Login_Email
		    (
		        type = email
		        displayname = "Customer Login Email"
		        personal data = true
		        row = 3
		        column = 2
		        width = medium
		    )
		
		    actions
