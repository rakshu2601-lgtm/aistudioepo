			    description = "Stamps the time when an agent updates longitude"
			
			    on user input of Current_Longitude
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Application_Role == "Field Agent" && input.Work_Email != null && input.Work_Email.toLowerCase() == zoho.loginuserid.toLowerCase())
			                {
			                    input.Last_Location_At = zoho.currenttime;
			                }
			            )
			        }
			    }
			}

			Operations_Users_On_Load as "Configure Operations User Fields"
			{
			    type = form
			    form = Operations_Users
			    record event = on add or edit
			    description = "Shows role-relevant fields and protects agent location fields"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Application_Role == "Field Agent")
			                {
			                    show Agent_Role, Assigned_Beat, Assigned_Pincodes, Vehicle_Type, Maximum_Daily_Load_Kg, Current_Latitude, Current_Longitude, Last_Location_At;
			                    if(input.Work_Email != null && input.Work_Email.toLowerCase() == zoho.loginuserid.toLowerCase())
			                    {
			                        enable Current_Latitude, Current_Longitude;
			                    }
			                    else
			                    {
			                        disable Current_Latitude, Current_Longitude;
			                    }
			                    disable Last_Location_At;
			                }
			                else
			                {
			                    hide Agent_Role, Assigned_Beat, Assigned_Pincodes, Vehicle_Type, Maximum_Daily_Load_Kg, Current_Latitude, Current_Longitude, Last_Location_At;
			                }
			                if(input.Application_Role in {"Hub Supervisor","Hub Operator","Field Agent"})
			                {
			                    show Home_Hub, Deputed_Hub, Deputation_Start_Date, Deputation_End_Date;
			                }
			                else
			                {
			                    hide Home_Hub, Deputed_Hub, Deputation_Start_Date, Deputation_End_Date;
			                }
			            )
			        }
			    }
			}

			Operations_Users_On_Success as "Audit Operations User"
			{
			    type = form
			    form = Operations_Users
			    record event = on add or edit
			    description = "Audits operations user and hub assignment changes"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = "Operations Administration"
			                    Action_Name = "Save Operations User"
			                    Module_Name = "Operations Users"
			                    Record_ID = input.ID.toString()
			                    After_Data = "Employee ID=" + input.Employee_ID + "; Role=" + input.Application_Role + "; Home Hub ID=" + input.Home_Hub + "; Active=" + input.Active
			                    Source = "Form Workflow"
			                    Severity = "Info"
			                ];
			            )
			        }
			    }
			}

			Operations_Users_On_Validate as "Validate Operations User"
			{
			    type = form
			    form = Operations_Users
			    record event = on add or edit
			    description = "Validates hub scope, agent capacity, deputation dates, and location coordinates"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                hub_scoped_roles = {"Hub Supervisor","Hub Operator","Field Agent"};
			                if(input.Application_Role in hub_scoped_roles && input.Home_Hub == null)
			                {
			                    alert "Home Hub is required for hub-scoped users.";
			                    cancel submit;
			                }
			                if(input.Application_Role == "Field Agent")
			                {
			                    if(input.Agent_Role == null || input.Agent_Role == "Not Applicable")
			                    {
			                        alert "Select Pickup, Delivery, or Both as the agent role.";
			                        cancel submit;
			                    }
			                    if(ifnull(input.Maximum_Daily_Load_Kg,0) <= 0)
			                    {
			                        alert "Maximum daily load must be greater than zero for field agents.";
			                        cancel submit;
			                    }
			                }
			                else if(input.Agent_Role != "Not Applicable")
			                {
			                    alert "Agent Role must be Not Applicable for non-agent users.";
			                    cancel submit;
			                }
			                has_deputed_hub = input.Deputed_Hub != null;
			                has_deputation_start = input.Deputation_Start_Date != null;
			                has_deputation_end = input.Deputation_End_Date != null;
			                if((has_deputed_hub || has_deputation_start || has_deputation_end) && !(has_deputed_hub && has_deputation_start && has_deputation_end))
			                {
			                    alert "Deputed Hub, Deputation Start Date, and Deputation End Date must be provided together.";
			                    cancel submit;
			                }
			                if(has_deputed_hub)
			                {
			                    if(input.Deputed_Hub == input.Home_Hub)
			                    {
			                        alert "Deputed Hub must differ from Home Hub.";
			                        cancel submit;
			                    }
			                    if(input.Deputation_End_Date < input.Deputation_Start_Date)
			                    {
			                        alert "Deputation End Date cannot be before the start date.";
			                        cancel submit;
			                    }
			                }
			                has_latitude = input.Current_Latitude != null;
			                has_longitude = input.Current_Longitude != null;
			                if(has_latitude != has_longitude)
			                {
			                    alert "Latitude and longitude must be provided together.";
			                    cancel submit;
			                }
			                if(has_latitude && (input.Current_Latitude < -90 || input.Current_Latitude > 90 || input.Current_Longitude < -180 || input.Current_Longitude > 180))
			                {
			                    alert "Enter valid latitude and longitude coordinates.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Payment_Transactions_On_Delete as "Protect Payment Evidence"
			{
			    type = form
			    form = Payment_Transactions
			    record event = on delete
			    description = "Prohibits deletion of payment initiation and reconciliation evidence"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                alert "Payment transactions cannot be deleted. Preserve provider and accounting evidence.";
			                cancel delete;
			            )
			        }
			    }
			}

			Payment_Transactions_On_Load as "Protect Payment Transaction"
			{
			    type = form
			    form = Payment_Transactions
			    record event = on add or edit
			    description = "Keeps gateway and reconciliation fields read-only and redirects portal customers to invoice payment actions"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Customer, Shipment, Invoice, Ledger_Entry, Gateway, Gateway_Order_ID, Gateway_Payment_ID, Amount, Payment_Method, Payment_Status, Initiated_At, Completed_At, Gateway_Response_Summary, Failure_Reason, Customer_Login_Email;
			                if(thisapp.portal.isUserInProfile("Customer_Portal") == true && input.ID == null)
			                {
			                    alert "Start payments from the Pay Now action on an eligible invoice.";
			                    openUrl("#Report:Invoice_Statement","same window");
			                }
			            )
			        }
			    }
			}

			Payment_Transactions_On_Success as "Record Payment Initiation"
			{
			    type = form
			    form = Payment_Transactions
			    record event = on add
			    description = "Audits payment initiation without treating browser navigation as payment success"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(Audit_Log[Module_Name == "Payment Transactions" && Record_ID == input.ID.toString() && Action_Name == "Initiate Payment"].count(ID) == 0)
			                {
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuserid
			                        Actor_Profile = thisapp.permissions.loginUserProfile()
			                        Action_Name = "Initiate Payment"
			                        Module_Name = "Payment Transactions"
			                        Record_ID = input.ID.toString()
			                        After_Data = "Status=Initiated; Gateway=" + input.Gateway + "; Order=" + input.Gateway_Order_ID + "; Amount=" + input.Amount
			                        Source = "Payment"
			                        Severity = "Info"
			                    ];
			                }
			            )
			        }
			    }
			}

			Payment_Transactions_On_Validate as "Validate Payment Transaction"
			{
			    type = form
			    form = Payment_Transactions
			    record event = on add or edit
			    description = "Accepts initiation records only and protects all gateway reconciliation values from direct editing"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                customer_record = Customers[ID == input.Customer];
			                if(customer_record.count(ID) == 0)
			                {
			                    alert "Select a valid customer.";
			                    cancel submit;
			                }
			                else
			                {
			                    if(ifnull(input.Amount,0) <= 0)
			                    {
			                        alert "Payment amount must be greater than zero.";
			                        cancel submit;
			                    }
			                    if(input.Invoice != null)
			                    {
			                        invoice_record = Invoices[ID == input.Invoice];
			                        if(invoice_record.count(ID) == 0 || invoice_record.Customer != customer_record.ID || (input.Shipment != null && invoice_record.Shipment != input.Shipment))
			                        {
			                            alert "The invoice does not match the selected customer and shipment.";
			                            cancel submit;
			                        }
			                        else if(invoice_record.Invoice_Status == "Draft" || invoice_record.Invoice_Status == "Paid" || invoice_record.Invoice_Status == "Void")
			                        {
			                            alert "Payments may be initiated only for issued, part-paid, or overdue invoices.";
			                            cancel submit;
			                        }
			                        else
			                        {
			                            verified_paid_total = ifnull(Account_Ledger[Invoice == invoice_record.ID && Transaction_Type == "Payment"].sum(Amount),0);
			                            remaining_due = (ifnull(invoice_record.Invoice_Total,0) - verified_paid_total).round(2);
			                            if(remaining_due <= 0 || input.Amount > remaining_due + 0.01)
			                            {
			                                alert "Payment amount exceeds the verified remaining invoice balance.";
			                                cancel submit;
			                            }
			                        }
			                    }
			                    if(input.Shipment != null)
			                    {
			                        shipment_record = Shipment_Requests[ID == input.Shipment];
			                        if(shipment_record.count(ID) == 0 || shipment_record.Customer != customer_record.ID)
			                        {
			                            alert "The shipment does not belong to the selected customer.";
			                            cancel submit;
			                        }
			                    }
			                    if(input.ID == null)
			                    {
			                        if(input.Payment_Status != "Initiated" || input.Ledger_Entry != null || ifnull(input.Gateway_Payment_ID,"").trim() != "" || input.Completed_At != null)
			                        {
			                            alert "A new transaction must begin in Initiated status without settlement references.";
			                            cancel submit;
			                        }
			                        input.Initiated_At = zoho.currenttime;
			                        input.Gateway_Response_Summary = "Payment initiated; awaiting a verified provider result.";
			                        input.Failure_Reason = "";
			                        input.Customer_Login_Email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID);
			                    }
			                    else
			                    {
			                        stored_record = Payment_Transactions[ID == input.ID];
			                        if(input.Customer != stored_record.Customer || input.Shipment != stored_record.Shipment || input.Invoice != stored_record.Invoice || input.Ledger_Entry != stored_record.Ledger_Entry || input.Gateway != stored_record.Gateway || input.Gateway_Order_ID != stored_record.Gateway_Order_ID || input.Gateway_Payment_ID != stored_record.Gateway_Payment_ID || input.Amount != stored_record.Amount || input.Payment_Method != stored_record.Payment_Method || input.Payment_Status != stored_record.Payment_Status || input.Initiated_At != stored_record.Initiated_At || input.Completed_At != stored_record.Completed_At || input.Gateway_Response_Summary != stored_record.Gateway_Response_Summary || input.Failure_Reason != stored_record.Failure_Reason || input.Customer_Login_Email != stored_record.Customer_Login_Email)
			                        {
			                            alert "Payment transactions are immutable outside verified payment and refund workflows.";
			                            cancel submit;
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Physical_Weight_Kg_On_User_Input as "Recalculate Pickup Charge"
			{
			    type = form
			    form = Pickup_Run_Sheet_Items
			    record event = on add or edit
			    description = "Calculates the revised shipment payable amount from the physical pickup weight"
			
			    on user input of Physical_Weight_Kg
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Revised_Charge = 0;
			                input.Customer_Approved_Revised_Charge = false;
			                if(input.Shipment != null && ifnull(input.Physical_Weight_Kg,0) > 0)
			                {
			                    shipment_record = Shipment_Requests[ID == input.Shipment];
			                    quote = thisapp.Calculate_Shipment_Quote(shipment_record.Customer,shipment_record.Pickup_Pincode,shipment_record.Delivery_Pincode,shipment_record.Transport_Mode,shipment_record.Length_Cm,shipment_record.Width_Cm,shipment_record.Height_Cm,input.Physical_Weight_Kg,shipment_record.Payment_Type,shipment_record.Loyalty_Points_Redeemed);
			                    if(quote.get("valid") == true)
			                    {
			                        input.Revised_Charge = quote.get("total_payable");
			                    }
			                    else
			                    {
			                        alert quote.get("message");
			                    }
			                }
			            )
			        }
			    }
			}

			Pickup_Run_Sheet_Items_On_Load as "Secure Pickup Stop"
			{
			    type = form
			    form = Pickup_Run_Sheet_Items
			    record event = on add or edit
			    description = "Locks assignment and derived fields while allowing only the assigned agent to capture pickup evidence"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Stop_Status, Arrived_At, Revised_Charge, Completed_At;
			                current_profile = thisapp.permissions.loginUserProfile();
			                if(input.ID != null)
			                {
			                    run_record = Pickup_Run_Sheets[ID == input.Pickup_Run_Sheet];
			                    assigned_agent = Operations_Users[ID == run_record.Assigned_Agent];
			                    disable Pickup_Run_Sheet, Shipment, Stop_Sequence;
			                    if(current_profile == "Field_Agent" && assigned_agent.Work_Email == zoho.loginuserid && (run_record.Status == "Released" || run_record.Status == "In Progress"))
			                    {
			                        enable Physical_Weight_Kg, Customer_Approved_Revised_Charge, Pickup_OTP, Pickup_Signature, Failure_Reason, Agent_Latitude, Agent_Longitude;
			                    }
			                    else
			                    {
			                        disable Physical_Weight_Kg, Customer_Approved_Revised_Charge, Pickup_OTP, Pickup_Signature, Failure_Reason, Agent_Latitude, Agent_Longitude;
			                    }
			                    if(input.Stop_Status == "Picked Up" || input.Stop_Status == "Failed" || input.Stop_Status == "Cancelled")
			                    {
			                        disable Physical_Weight_Kg, Customer_Approved_Revised_Charge, Pickup_OTP, Pickup_Signature, Failure_Reason, Agent_Latitude, Agent_Longitude;
			                    }
			                }
			            )
			        }
			    }
			}

			Pickup_Run_Sheet_Items_On_Success as "Reconcile Pickup Run Stop Totals"
			{
			    type = form
			    form = Pickup_Run_Sheet_Items
			    record event = on add or edit
			    description = "Refreshes pickup run aggregates and audits pickup stop assignment or evidence updates"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                run_record = Pickup_Run_Sheets[ID == input.Pickup_Run_Sheet];
			                planned_count = 0;
			                completed_count = 0;
			                planned_weight = 0.0;
			                for each run_item in Pickup_Run_Sheet_Items[Pickup_Run_Sheet == input.Pickup_Run_Sheet]
			                {
			                    if(run_item.Stop_Status != "Cancelled")
			                    {
			                        planned_count = planned_count + 1;
			                        shipment_record = Shipment_Requests[ID == run_item.Shipment];
			                        planned_weight = planned_weight + ifnull(shipment_record.Billable_Weight_Kg,0);
			                        if(run_item.Stop_Status == "Picked Up" || run_item.Stop_Status == "Failed")
			                        {
			                            completed_count = completed_count + 1;
			                        }
			                    }
			                }
			                run_record.Planned_Stop_Count = planned_count;
			                run_record.Completed_Stop_Count = completed_count;
			                run_record.Total_Planned_Weight_Kg = planned_weight;
			                current_profile = thisapp.permissions.loginUserProfile();
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = current_profile
			                    Action_Name = "Save Pickup Stop"
			                    Module_Name = "Pickup Run Sheet Items"
			                    Record_ID = input.ID.toString()
			                    After_Data = "Run=" + input.Pickup_Run_Sheet + "; Shipment=" + input.Shipment + "; Stop=" + input.Stop_Sequence + "; Status=" + input.Stop_Status + "; Physical Weight=" + input.Physical_Weight_Kg
			                    Source = "Form Workflow"
			                    Severity = "Info"
			                ];
			            )
			        }
			    }
			}

			Pickup_Run_Sheet_Items_On_Validate as "Validate Pickup Stop"
			{
			    type = form
			    form = Pickup_Run_Sheet_Items
			    record event = on add or edit
			    description = "Validates assignment uniqueness, hub ownership, agent access, physical rerating, and protected stop state"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                run_record = Pickup_Run_Sheets[ID == input.Pickup_Run_Sheet];
			                shipment_record = Shipment_Requests[ID == input.Shipment];
			                if(run_record.count(ID) == 0 || shipment_record.count(ID) == 0)
			                {
			                    alert "Select a valid pickup run and shipment.";
			                    cancel submit;
			                }
			                if(input.Stop_Sequence <= 0)
			                {
			                    alert "Stop sequence must be greater than zero.";
			                    cancel submit;
			                }
			                duplicate_sequence = Pickup_Run_Sheet_Items[Pickup_Run_Sheet == input.Pickup_Run_Sheet && Stop_Sequence == input.Stop_Sequence && ID != input.ID].count(ID);
			                if(duplicate_sequence > 0)
			                {
			                    alert "This stop sequence is already used in the pickup run.";
			                    cancel submit;
			                }
			                duplicate_active = Pickup_Run_Sheet_Items[Shipment == input.Shipment && ID != input.ID && Stop_Status != "Picked Up" && Stop_Status != "Failed" && Stop_Status != "Cancelled"].count(ID);
			                if(duplicate_active > 0)
			                {
			                    alert "This shipment is already assigned to an active pickup run.";
			                    cancel submit;
			                }
			                if(run_record.Hub != shipment_record.Collection_Center)
			                {
			                    alert "The shipment collection center must match the pickup run hub.";
			                    cancel submit;
			                }
			                if(input.ID == null)
			                {
			                    if(current_profile != "Logistics_Administrator" && current_profile != "Operations_Manager" && current_profile != "Hub_Supervisor")
			                    {
			                        alert "Only authorised operations planners can add pickup stops.";
			                        cancel submit;
			                    }
			                    if(run_record.Status != "Draft" || shipment_record.Shipment_Status != "Booked")
			                    {
			                        alert "Pickup stops can be added only to draft runs for booked shipments.";
			                        cancel submit;
			                    }
			                    input.Stop_Status = "Assigned";
			                    input.Arrived_At = null;
			                    input.Completed_At = null;
			                }
			                else
			                {
			                    previous_record = Pickup_Run_Sheet_Items[ID == input.ID];
			                    assigned_agent = Operations_Users[ID == run_record.Assigned_Agent];
			                    if(current_profile == "Field_Agent" && assigned_agent.Work_Email != zoho.loginuserid)
			                    {
			                        alert "You cannot update another agent's pickup stop.";
			                        cancel submit;
			                    }
			                    if(current_profile != "Field_Agent" && current_profile != "Logistics_Administrator" && current_profile != "Operations_Manager" && current_profile != "Hub_Supervisor")
			                    {
			                        alert "You are not authorised to update pickup stops.";
			                        cancel submit;
			                    }
			                    if(previous_record.Stop_Status == "Picked Up" || previous_record.Stop_Status == "Failed" || previous_record.Stop_Status == "Cancelled")
			                    {
			                        alert "Terminal pickup stops are locked.";
			                        cancel submit;
			                    }
			                    if(input.Pickup_Run_Sheet != previous_record.Pickup_Run_Sheet || input.Shipment != previous_record.Shipment || input.Stop_Sequence != previous_record.Stop_Sequence || input.Stop_Status != previous_record.Stop_Status || input.Arrived_At != previous_record.Arrived_At || input.Completed_At != previous_record.Completed_At)
			                    {
			                        alert "Assignment, status, and milestone timestamps are managed by pickup actions.";
			                        cancel submit;
			                    }
			                }
			                if(input.Agent_Latitude != null && (input.Agent_Latitude < -90 || input.Agent_Latitude > 90))
			                {
			                    alert "Agent latitude must be between -90 and 90.";
			                    cancel submit;
			                }
			                if(input.Agent_Longitude != null && (input.Agent_Longitude < -180 || input.Agent_Longitude > 180))
			                {
			                    alert "Agent longitude must be between -180 and 180.";
			                    cancel submit;
			                }
			                if(input.Physical_Weight_Kg != null)
			                {
			                    if(input.Physical_Weight_Kg <= 0)
			                    {
			                        alert "Physical weight must be greater than zero.";
			                        cancel submit;
			                    }
			                    quote = thisapp.Calculate_Shipment_Quote(shipment_record.Customer,shipment_record.Pickup_Pincode,shipment_record.Delivery_Pincode,shipment_record.Transport_Mode,shipment_record.Length_Cm,shipment_record.Width_Cm,shipment_record.Height_Cm,input.Physical_Weight_Kg,shipment_record.Payment_Type,shipment_record.Loyalty_Points_Redeemed);
			                    if(quote.get("valid") != true)
			                    {
			                        alert quote.get("message");
			                        cancel submit;
			                    }
			                    input.Revised_Charge = quote.get("total_payable");
			                    if((input.Revised_Charge - shipment_record.Total_Payable).abs() > 0.01 && input.Customer_Approved_Revised_Charge != true)
			                    {
			                        alert "Customer approval is required before saving a changed pickup charge.";
			                        cancel submit;
			                    }
			                }
			                else
			                {
			                    input.Revised_Charge = 0;
			                    input.Customer_Approved_Revised_Charge = false;
			                }
			            )
			        }
			    }
			}

			Pickup_Runs_Hub_Input as "Filter Pickup Resources by Hub"
			{
			    type = form
			    form = Pickup_Run_Sheets
			    record event = on add or edit
			    description = "Limits pickup agents and vehicles to resources effectively assigned to the selected hub"
			
			    on user input of Hub
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Assigned_Agent = null;
			                input.Vehicle = null;
			                clear Assigned_Agent;
			                clear Vehicle;
			                if(input.Hub != null && input.Run_Date != null)
			                {
			                    eligible_agents = Operations_Users[Active == true && Application_Role == "Field Agent" && (Agent_Role == "Pickup" || Agent_Role == "Both") && ((Deputed_Hub == input.Hub && (Deputation_Start_Date == null || Deputation_Start_Date <= input.Run_Date) && (Deputation_End_Date == null || Deputation_End_Date >= input.Run_Date)) || (Home_Hub == input.Hub && (Deputed_Hub == null || (Deputation_Start_Date != null && Deputation_Start_Date > input.Run_Date) || (Deputation_End_Date != null && Deputation_End_Date < input.Run_Date))))];
			                    Assigned_Agent:ui.add(eligible_agents.ID.getall());
			                    eligible_vehicles = Vehicles[Owning_Hub == input.Hub && Active == true && Status == "Available"];
			                    Vehicle:ui.add(eligible_vehicles.ID.getall());
			                }
			            )
			        }
			    }
			}

			Pickup_Run_Sheets_On_Load as "Prepare Pickup Run Planner"
			{
			    type = form
			    form = Pickup_Run_Sheets
			    record event = on add or edit
			    description = "Sets the supervisor hub, filters eligible agents and vehicles, and locks derived and released run data"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Status, Planned_Stop_Count, Completed_Stop_Count, Total_Planned_Weight_Kg, Released_At, Completed_At;
			                current_profile = thisapp.permissions.loginUserProfile();
			                if(input.ID == null && current_profile == "Hub_Supervisor")
			                {
			                    logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                    if(logged_user.count(ID) > 0)
			                    {
			                        deputation_active = logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= input.Run_Date) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= input.Run_Date);
			                        if(deputation_active == true)
			                        {
			                            input.Hub = logged_user.Deputed_Hub;
			                        }
			                        else
			                        {
			                            input.Hub = logged_user.Home_Hub;
			                        }
			                    }
			                }
			                clear Assigned_Agent;
			                clear Vehicle;
			                if(input.Hub != null && input.Run_Date != null)
			                {
			                    eligible_agents = Operations_Users[Active == true && Application_Role == "Field Agent" && (Agent_Role == "Pickup" || Agent_Role == "Both") && ((Deputed_Hub == input.Hub && (Deputation_Start_Date == null || Deputation_Start_Date <= input.Run_Date) && (Deputation_End_Date == null || Deputation_End_Date >= input.Run_Date)) || (Home_Hub == input.Hub && (Deputed_Hub == null || (Deputation_Start_Date != null && Deputation_Start_Date > input.Run_Date) || (Deputation_End_Date != null && Deputation_End_Date < input.Run_Date))))];
			                    Assigned_Agent:ui.add(eligible_agents.ID.getall());
			                    eligible_vehicles = Vehicles[Owning_Hub == input.Hub && Active == true && (Status == "Available" || ID == input.Vehicle)];
			                    Vehicle:ui.add(eligible_vehicles.ID.getall());
			                }
			                if(input.ID != null && input.Status != "Draft")
			                {
			                    disable Hub, Assigned_Agent, Run_Date, Beat_Name, Vehicle, Supervisor_Notes;
			                }
			            )
			        }
			    }
			}

			Pickup_Run_Sheets_On_Success as "Audit Pickup Run Planning"
			{
			    type = form
			    form = Pickup_Run_Sheets
			    record event = on add or edit
			    description = "Audits creation and draft updates of pickup run plans"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = current_profile
			                    Action_Name = "Save Pickup Run Sheet"
			                    Module_Name = "Pickup Run Sheets"
			                    Record_ID = input.ID.toString()
			                    After_Data = "PRS=" + input.PRS_Number + "; Hub=" + input.Hub + "; Agent=" + input.Assigned_Agent + "; Run Date=" + input.Run_Date + "; Status=" + input.Status
			                    Source = "Form Workflow"
			                    Severity = "Info"
			                ];
			            )
			        }
			    }
			}

			Pickup_Run_Sheets_On_Validate as "Validate Pickup Run Sheet"
			{
			    type = form
			    form = Pickup_Run_Sheets
			    record event = on add or edit
			    description = "Validates hub scope, resource eligibility, dates, protected fields, and daily load capacity"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                if(current_profile != "Logistics_Administrator" && current_profile != "Operations_Manager" && current_profile != "Hub_Supervisor")
			                {
			                    alert "Only authorised operations planners can create or edit pickup run sheets.";
			                    cancel submit;
			                }
			                if(input.Run_Date < zoho.currentdate)
			                {
			                    alert "A pickup run cannot be planned for a past date.";
			                    cancel submit;
			                }
			                logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                if(current_profile == "Hub_Supervisor")
			                {
			                    supervisor_deputation_active = logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= input.Run_Date) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= input.Run_Date);
			                    supervisor_hub = if(supervisor_deputation_active == true,logged_user.Deputed_Hub,logged_user.Home_Hub);
			                    if(logged_user.count(ID) == 0 || supervisor_hub != input.Hub)
			                    {
			                        alert "Hub supervisors can plan pickup runs only for their effective home or deputed hub.";
			                        cancel submit;
			                    }
			                }
			                agent_record = Operations_Users[ID == input.Assigned_Agent && Active == true && Application_Role == "Field Agent" && (Agent_Role == "Pickup" || Agent_Role == "Both")];
			                if(agent_record.count(ID) == 0)
			                {
			                    alert "Select an active pickup-capable field agent.";
			                    cancel submit;
			                }
			                agent_deputation_active = agent_record.Deputed_Hub != null && (agent_record.Deputation_Start_Date == null || agent_record.Deputation_Start_Date <= input.Run_Date) && (agent_record.Deputation_End_Date == null || agent_record.Deputation_End_Date >= input.Run_Date);
			                agent_hub = if(agent_deputation_active == true,agent_record.Deputed_Hub,agent_record.Home_Hub);
			                if(agent_hub != input.Hub)
			                {
			                    alert "The assigned agent is not effective at the selected hub on the run date.";
			                    cancel submit;
			                }
			                previous_record = Pickup_Run_Sheets[ID == input.ID];
			                if(input.ID != null)
			                {
			                    if(previous_record.Status != "Draft")
			                    {
			                        alert "Released pickup runs cannot be edited from the form.";
			                        cancel submit;
			                    }
			                    if(input.Status != previous_record.Status || input.Planned_Stop_Count != previous_record.Planned_Stop_Count || input.Completed_Stop_Count != previous_record.Completed_Stop_Count || input.Total_Planned_Weight_Kg != previous_record.Total_Planned_Weight_Kg || input.Released_At != previous_record.Released_At || input.Completed_At != previous_record.Completed_At)
			                    {
			                        alert "Run status, timestamps, and progress totals are managed by operational workflows.";
			                        cancel submit;
			                    }
			                }
			                planned_count = 0;
			                completed_count = 0;
			                planned_weight = 0.0;
			                if(input.ID != null)
			                {
			                    for each run_item in Pickup_Run_Sheet_Items[Pickup_Run_Sheet == input.ID]
			                    {
			                        if(run_item.Stop_Status != "Cancelled")
			                        {
			                            planned_count = planned_count + 1;
			                            shipment_record = Shipment_Requests[ID == run_item.Shipment];
			                            planned_weight = planned_weight + ifnull(shipment_record.Billable_Weight_Kg,0);
			                            if(run_item.Stop_Status == "Picked Up" || run_item.Stop_Status == "Failed")
			                            {
			                                completed_count = completed_count + 1;
			                            }
			                        }
			                    }
			                }
			                input.Planned_Stop_Count = planned_count;
			                input.Completed_Stop_Count = completed_count;
			                input.Total_Planned_Weight_Kg = planned_weight;
			                other_agent_weight = 0.0;
			                for each other_run in Pickup_Run_Sheets[Assigned_Agent == input.Assigned_Agent && Run_Date == input.Run_Date && ID != input.ID && Status != "Cancelled"]
			                {
			                    other_agent_weight = other_agent_weight + ifnull(other_run.Total_Planned_Weight_Kg,0);
			                }
			                if(agent_record.Maximum_Daily_Load_Kg != null && agent_record.Maximum_Daily_Load_Kg > 0 && other_agent_weight + planned_weight > agent_record.Maximum_Daily_Load_Kg)
			                {
			                    alert "The assigned agent's maximum daily load would be exceeded.";
			                    cancel submit;
			                }
			                if(input.Vehicle != null)
			                {
			                    vehicle_record = Vehicles[ID == input.Vehicle && Active == true && Owning_Hub == input.Hub];
			                    if(vehicle_record.count(ID) == 0)
			                    {
			                        alert "Select an active vehicle owned by the pickup hub.";
			                        cancel submit;
			                    }
			                    if(vehicle_record.Status != "Available" && (input.ID == null || previous_record.Vehicle != input.Vehicle))
			                    {
			                        alert "The selected vehicle is not available.";
			                        cancel submit;
			                    }
			                    duplicate_vehicle_run = Pickup_Run_Sheets[Vehicle == input.Vehicle && Run_Date == input.Run_Date && ID != input.ID && Status != "Cancelled"].count(ID);
			                    if(duplicate_vehicle_run > 0)
			                    {
			                        alert "The selected vehicle is already planned for another run on this date.";
			                        cancel submit;
			                    }
			                    if(planned_weight > vehicle_record.Capacity_Kg)
			                    {
			                        alert "The planned shipment weight exceeds the selected vehicle capacity.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Pickup_Runs_Date_Input as "Refresh Pickup Resources by Date"
			{
			    type = form
			    form = Pickup_Run_Sheets
			    record event = on add or edit
			    description = "Refreshes temporary deputation eligibility when the planned run date changes"
			
			    on user input of Run_Date
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Assigned_Agent = null;
			                input.Vehicle = null;
			                clear Assigned_Agent;
			                clear Vehicle;
			                if(input.Hub != null && input.Run_Date != null)
			                {
			                    eligible_agents = Operations_Users[Active == true && Application_Role == "Field Agent" && (Agent_Role == "Pickup" || Agent_Role == "Both") && ((Deputed_Hub == input.Hub && (Deputation_Start_Date == null || Deputation_Start_Date <= input.Run_Date) && (Deputation_End_Date == null || Deputation_End_Date >= input.Run_Date)) || (Home_Hub == input.Hub && (Deputed_Hub == null || (Deputation_Start_Date != null && Deputation_Start_Date > input.Run_Date) || (Deputation_End_Date != null && Deputation_End_Date < input.Run_Date))))];
			                    Assigned_Agent:ui.add(eligible_agents.ID.getall());
			                    eligible_vehicles = Vehicles[Owning_Hub == input.Hub && Active == true && Status == "Available"];
			                    Vehicle:ui.add(eligible_vehicles.ID.getall());
			                }
			            )
			        }
			    }
			}

			Rate_Cards_On_Success as "Audit Rate Card"
			{
			    type = form
			    form = Rate_Cards
			    record event = on add or edit
			    description = "Audits rate policy, publishing, and expiry changes"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                audit_severity = "Info";
			                if(input.Status == "Published" || input.Status == "Expired")
			                {
			                    audit_severity = "Warning";
			                }
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = "Pricing Administration"
			                    Action_Name = "Save Rate Card"
			                    Module_Name = "Rate Cards"
			                    Record_ID = input.ID.toString()
			                    After_Data = "Rate Card=" + input.Rate_Card_ID + "; Customer Type=" + input.Customer_Type + "; Mode=" + input.Transport_Mode + "; Status=" + input.Status
			                    Source = "Form Workflow"
			                    Severity = audit_severity
			                ];
			            )
			        }
			    }
			}

			Rate_Cards_On_Validate as "Validate Rate Card"
			{
			    type = form
			    form = Rate_Cards
			    record event = on add or edit
			    description = "Validates pricing policy, effective dates, and retail default uniqueness"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(ifnull(input.Fuel_Surcharge_Percent,-1) < 0 || ifnull(input.COD_Handling_Fee,-1) < 0 || ifnull(input.GST_Percent,-1) < 0 || ifnull(input.Contract_Discount_Percent,-1) < 0)
			                {
			                    alert "Surcharges, fees, taxes, and discounts cannot be negative.";
			                    cancel submit;
			                }
			                if(input.Fuel_Surcharge_Percent > 100 || input.GST_Percent > 100 || input.Contract_Discount_Percent > 100)
			                {
			                    alert "Percentage values cannot exceed 100.";
			                    cancel submit;
			                }
			                if(ifnull(input.Volumetric_Divisor,0) <= 0)
			                {
			                    alert "Volumetric divisor must be greater than zero.";
			                    cancel submit;
			                }
			                if(input.Effective_To != null && input.Effective_To < input.Effective_From)
			                {
			                    alert "Effective To cannot be before Effective From.";
			                    cancel submit;
			                }
			                if(input.Default_For_Retail == true && input.Customer_Type not in {"Retail","All"})
			                {
			                    alert "Only Retail or All customer rate cards can be the retail default.";
			                    cancel submit;
			                }
			                if(input.Default_For_Retail == true && input.Status == "Published")
			                {
			                    published_default_count = Rate_Cards[Default_For_Retail == true && Status == "Published" && ID != input.ID].count();
			                    if(published_default_count > 0)
			                    {
			                        alert "Only one published retail default rate card is allowed.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Rate_Slabs_On_Success as "Audit Rate Slab"
			{
			    type = form
			    form = Rate_Slabs
			    record event = on add or edit
			    description = "Audits rate slab band and charge changes"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = "Pricing Administration"
			                    Action_Name = "Save Rate Slab"
			                    Module_Name = "Rate Slabs"
			                    Record_ID = input.ID.toString()
			                    After_Data = "Rate Card ID=" + input.Rate_Card + "; Slab=" + input.Slab_Name + "; Weight=" + input.Minimum_Weight_Kg + "-" + input.Maximum_Weight_Kg + "; Distance=" + input.Minimum_Distance_Km + "-" + input.Maximum_Distance_Km + "; Active=" + input.Active
			                    Source = "Form Workflow"
			                    Severity = "Info"
			                ];
			            )
			        }
			    }
			}

			Rate_Slabs_On_Validate as "Validate Rate Slab"
			{
			    type = form
			    form = Rate_Slabs
			    record event = on add or edit
			    description = "Validates slab bounds, charges, parent compatibility, and overlapping active bands"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(ifnull(input.Minimum_Weight_Kg,-1) < 0 || ifnull(input.Minimum_Distance_Km,-1) < 0)
			                {
			                    alert "Minimum weight and distance cannot be negative.";
			                    cancel submit;
			                }
			                if(input.Maximum_Weight_Kg <= input.Minimum_Weight_Kg)
			                {
			                    alert "Maximum weight must be greater than minimum weight.";
			                    cancel submit;
			                }
			                if(input.Maximum_Distance_Km <= input.Minimum_Distance_Km)
			                {
			                    alert "Maximum distance must be greater than minimum distance.";
			                    cancel submit;
			                }
			                if(ifnull(input.Base_Rate,-1) < 0 || ifnull(input.Additional_Kg_Rate,-1) < 0)
			                {
			                    alert "Base and additional kilogram rates cannot be negative.";
			                    cancel submit;
			                }
			                parent_rate_card = Rate_Cards[ID == input.Rate_Card];
			                if(parent_rate_card.Status == "Expired")
			                {
			                    alert "Rate slabs cannot be added to an expired rate card.";
			                    cancel submit;
			                }
			                if(input.Active == true)
			                {
			                    overlapping_slabs = Rate_Slabs[Rate_Card == input.Rate_Card && Service_Zone == input.Service_Zone && Active == true && ID != input.ID && Minimum_Weight_Kg <= input.Maximum_Weight_Kg && Maximum_Weight_Kg >= input.Minimum_Weight_Kg && Minimum_Distance_Km <= input.Maximum_Distance_Km && Maximum_Distance_Km >= input.Minimum_Distance_Km].count();
			                    if(overlapping_slabs > 0)
			                    {
			                        alert "This active weight and distance band overlaps another slab for the same rate card and service zone.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

