		        Vehicle_Type
		        Owning_Hub
		        Status
		        Active
		    )
		    options
		    (
		        display type = month
		        week start day = monday
		        display field = Vehicle_Number
		        start date = Registration_Expiry
		        end date = Insurance_Expiry
		        default date
		        (
		            day = Today
		            month = Currentmonth
		            year = Currentyear
		        )
		    )
		    conditional formatting
		    (
		        "Inactive Vehicle"
		        {
		            condition = (Status == "Inactive")
		            fields = [Vehicle_Number, Status]
		            format = "background-color:#F3F4F6;color:#4B5563"
		        }
		    )
		}
	}

	pages
	{
		page Admin_Dashboard
		{
					displayname = "Admin Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Admin_Network_Control_Tower' elementName='Admin_Network_Control_Tower'>\n\t\t\t\t\t<![CDATA[htmlpage Admin_Network_Control_Tower()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nprofileName = thisapp.permissions.loginUserProfile();\nisAdmin = profileName == &quot;Logistics_Administrator&quot; || profileName == &quot;Administrator&quot;;\nisOperations = profileName == &quot;Operations_Manager&quot;;\nallowed = isAdmin || isOperations;\nif(allowed)\n{\n\t\ttodayStart = zoho.currentdate;\n\t\ttomorrowStart = zoho.currentdate.addDay(1);\n\t\tmonthStart = zoho.currentdate.subDay(29);\n\n\t\tactiveRetail = Customers[Active == true &amp;&amp; Onboarding_Status == &quot;Active&quot; &amp;&amp; Customer_Type == &quot;Retail&quot;].count(ID);\n\t\tactiveCorporate = Customers[Active == true &amp;&amp; Onboarding_Status == &quot;Active&quot; &amp;&amp; Customer_Type == &quot;Corporate&quot;].count(ID);\n\t\tactiveWholesale = Customers[Active == true &amp;&amp; Onboarding_Status == &quot;Active&quot; &amp;&amp; Customer_Type == &quot;Wholesale&quot;].count(ID);\n\t\tactiveCustomers = activeRetail + activeCorporate + activeWholesale;\n\t\tpendingKYC = Customers[Active == true &amp;&amp; (Onboarding_Status == &quot;KYC Pending&quot; || Onboarding_Status == &quot;Pending Verification&quot; || Onboarding_Status == &quot;Action Required&quot;)].count(ID);\n\t\ttodayBookings = Shipment_Requests[Booked_On &gt;= todayStart &amp;&amp; Booked_On &lt; tomorrowStart].count(ID);\n\t\ttodayRevenue = ifnull(Invoices[Invoice_Date == zoho.currentdate &amp;&amp; Invoice_Status != &quot;Void&quot;].sum(Invoice_Total),0);\n\t\tunassignedShipments = Shipment_Requests[Shipment_Status == &quot;Booked - Hub Assignment Pending&quot;].count(ID);\n\t\tinTransitShipments = Shipment_Requests[Shipment_Status == &quot;In Transit&quot;].count(ID);\n\t\tdeliveredToday = Shipment_Tracking_Events[Event_Status == &quot;Delivered&quot; &amp;&amp; Event_Time &gt;= todayStart &amp;&amp; Event_Time &lt; tomorrowStart].count(ID);\n\t\tndrShipments = Shipment_Requests[Shipment_Status == &quot;Delivery Failed - NDR&quot;].count(ID);\n\t\trtoShipments = Shipment_Requests[Shipment_Status == &quot;Return to Origin&quot;].count(ID);\n\t\tcodPendingAmount = ifnull(COD_Remittances[Remittance_Status == &quot;Pending&quot; || Remittance_Status == &quot;Shortfall&quot;].sum(Expected_Amount),0);\n\t\tcodPendingCount = COD_Remittances[Remittance_Status == &quot;Pending&quot; || Remittance_Status == &quot;Shortfall&quot;].count(ID);\n\t\tcriticalExceptions = Shipment_Exceptions[Severity == &quot;Critical&quot; &amp;&amp; Exception_Status != &quot;Resolved&quot;].count(ID);\n\t\tloyaltyIssued = ifnull(Loyalty_Transactions[Transaction_Type == &quot;Earn&quot; &amp;&amp; Transaction_Date &gt;= monthStart].sum(Points),0);\n\t\tloyaltyRedeemedRaw = ifnull(Loyalty_Transactions[Transaction_Type == &quot;Redeem&quot; &amp;&amp; Transaction_Date &gt;= monthStart].sum(Points),0);\n\t\tloyaltyRedeemed = if(loyaltyRedeemedRaw &lt; 0,0 - loyaltyRedeemedRaw,loyaltyRedeemedRaw);\n\n\t\tbookedStatus = Shipment_Requests[Shipment_Status == &quot;Booked&quot; || Shipment_Status == &quot;Picked Up&quot; || Shipment_Status == &quot;Inbound at Branch Station&quot; || Shipment_Status == &quot;Sorted at Origin Hub&quot;].count(ID);\n\t\tlinehaulStatus = Shipment_Requests[Shipment_Status == &quot;Bagged &amp; Dispatched to Origin Hub&quot; || Shipment_Status == &quot;In Transit&quot; || Shipment_Status == &quot;Arrived at Destination Hub&quot;].count(ID);\n\t\tlastMileStatus = Shipment_Requests[Shipment_Status == &quot;At Delivery Hub&quot; || Shipment_Status == &quot;Out For Delivery (OFD)&quot; || Shipment_Status == &quot;Delivery Failed - NDR&quot;].count(ID);\n\t\tcompletedStatus = Shipment_Requests[Shipment_Status == &quot;Delivered&quot;].count(ID);\n\t\tstatusTotal = bookedStatus + linehaulStatus + lastMileStatus + completedStatus;\n\t\tstatusP1 = if(statusTotal &gt; 0,(bookedStatus * 100.0) / statusTotal,0);\n\t\tstatusP2 = if(statusTotal &gt; 0,(linehaulStatus * 100.0) / statusTotal,0);\n\t\tstatusP3 = if(statusTotal &gt; 0,(lastMileStatus * 100.0) / statusTotal,0);\n\t\tstatusP4 = if(statusTotal &gt; 0,(completedStatus * 100.0) / statusTotal,0);\n\n\t\tairCount = Shipment_Requests[Transport_Mode == &quot;Air&quot;].count(ID);\n\t\tsurfaceCount = Shipment_Requests[Transport_Mode == &quot;Surface&quot;].count(ID);\n\t\tmodeTotal = airCount + surfaceCount;\n\t\tairP = if(modeTotal &gt; 0,(airCount * 100.0) / modeTotal,0);\n\t\tsurfaceP = if(modeTotal &gt; 0,(surfaceCount * 100.0) / modeTotal,0);\n\n\t\tcustomerTotal = activeCustomers;\n\t\tretailP = if(customerTotal &gt; 0,(activeRetail * 100.0) / customerTotal,0);\n\t\tcorporateP = if(customerTotal &gt; 0,(activeCorporate * 100.0) / customerTotal,0);\n\t\twholesaleP = if(customerTotal &gt; 0,(activeWholesale * 100.0) / customerTotal,0);\n\n\t\ttierSilver = Customers[Active == true &amp;&amp; Current_Loyalty_Tier == &quot;Silver&quot;].count(ID);\n\t\ttierGold = Customers[Active == true &amp;&amp; Current_Loyalty_Tier == &quot;Gold&quot;].count(ID);\n\t\ttierPlatinum = Customers[Active == true &amp;&amp; Current_Loyalty_Tier == &quot;Platinum&quot;].count(ID);\n\t\ttierNone = Customers[Active == true &amp;&amp; Current_Loyalty_Tier == &quot;None&quot;].count(ID);\n\t\ttierTotal = tierSilver + tierGold + tierPlatinum + tierNone;\n\t\ttierP1 = if(tierTotal &gt; 0,(tierSilver * 100.0) / tierTotal,0);\n\t\ttierP2 = if(tierTotal &gt; 0,(tierGold * 100.0) / tierTotal,0);\n\t\ttierP3 = if(tierTotal &gt; 0,(tierPlatinum * 100.0) / tierTotal,0);\n\t\ttierP4 = if(tierTotal &gt; 0,(tierNone * 100.0) / tierTotal,0);\n\n\t\tdeliveredAll = Shipment_Requests[Shipment_Status == &quot;Delivered&quot;].count(ID);\n\t\tfailedAll = Shipment_Requests[Shipment_Status == &quot;Delivery Failed - NDR&quot; || Shipment_Status == &quot;Return to Origin&quot;].count(ID);\n\t\tdeliveryOutcomeTotal = deliveredAll + failedAll;\n\t\tdeliverySuccess = if(deliveryOutcomeTotal &gt; 0,(deliveredAll * 100.0) / deliveryOutcomeTotal,0);\n\t\tndrRate = if(deliveryOutcomeTotal &gt; 0,(ndrShipments * 100.0) / deliveryOutcomeTotal,0);\n\t\trtoRate = if(deliveryOutcomeTotal &gt; 0,(rtoShipments * 100.0) / deliveryOutcomeTotal,0);\n\n\t\trevD6Date = zoho.currentdate.subDay(6);\n\t\trevD5Date = zoho.currentdate.subDay(5);\n\t\trevD4Date = zoho.currentdate.subDay(4);\n\t\trevD3Date = zoho.currentdate.subDay(3);\n\t\trevD2Date = zoho.currentdate.subDay(2);\n\t\trevD1Date = zoho.currentdate.subDay(1);\n\t\trevD0Date = zoho.currentdate;\n\t\trevD6 = ifnull(Invoices[Invoice_Date == revD6Date &amp;&amp; Invoice_Status != &quot;Void&quot;].sum(Invoice_Total),0);\n\t\trevD5 = ifnull(Invoices[Invoice_Date == revD5Date &amp;&amp; Invoice_Status != &quot;Void&quot;].sum(Invoice_Total),0);\n\t\trevD4 = ifnull(Invoices[Invoice_Date == revD4Date &amp;&amp; Invoice_Status != &quot;Void&quot;].sum(Invoice_Total),0);\n\t\trevD3 = ifnull(Invoices[Invoice_Date == revD3Date &amp;&amp; Invoice_Status != &quot;Void&quot;].sum(Invoice_Total),0);\n\t\trevD2 = ifnull(Invoices[Invoice_Date == revD2Date &amp;&amp; Invoice_Status != &quot;Void&quot;].sum(Invoice_Total),0);\n\t\trevD1 = ifnull(Invoices[Invoice_Date == revD1Date &amp;&amp; Invoice_Status != &quot;Void&quot;].sum(Invoice_Total),0);\n\t\trevD0 = ifnull(Invoices[Invoice_Date == revD0Date &amp;&amp; Invoice_Status != &quot;Void&quot;].sum(Invoice_Total),0);\n\t\tmaxRevenue = revD6;\n\t\tif(revD5 &gt; maxRevenue){maxRevenue = revD5;}\n\t\tif(revD4 &gt; maxRevenue){maxRevenue = revD4;}\n\t\tif(revD3 &gt; maxRevenue){maxRevenue = revD3;}\n\t\tif(revD2 &gt; maxRevenue){maxRevenue = revD2;}\n\t\tif(revD1 &gt; maxRevenue){maxRevenue = revD1;}\n\t\tif(revD0 &gt; maxRevenue){maxRevenue = revD0;}\n\t\trevH6 = if(maxRevenue &gt; 0,(revD6 * 100.0) / maxRevenue,0);\n\t\trevH5 = if(maxRevenue &gt; 0,(revD5 * 100.0) / maxRevenue,0);\n\t\trevH4 = if(maxRevenue &gt; 0,(revD4 * 100.0) / maxRevenue,0);\n\t\trevH3 = if(maxRevenue &gt; 0,(revD3 * 100.0) / maxRevenue,0);\n\t\trevH2 = if(maxRevenue &gt; 0,(revD2 * 100.0) / maxRevenue,0);\n\t\trevH1 = if(maxRevenue &gt; 0,(revD1 * 100.0) / maxRevenue,0);\n\t\trevH0 = if(maxRevenue &gt; 0,(revD0 * 100.0) / maxRevenue,0);\n\n\t\tactiveHubs = Hubs[Active == true] sort by Daily_Capacity desc;\n\t\trecentManifests = Manifests[ID != 0] sort by Departure_Time desc;\n\t\tverificationQueue = Customers[Active == true &amp;&amp; Onboarding_Status == &quot;Pending Verification&quot;] sort by KYC_Submitted_On asc;\n\t\texpiryQueue = Customers[Active == true &amp;&amp; Customer_Type != &quot;Retail&quot; &amp;&amp; KYC_Expiry_Date != null &amp;&amp; KYC_Expiry_Date &lt;= zoho.currentdate.addDay(30)] sort by KYC_Expiry_Date asc;\n\t\trecentCriticalAudits = Audit_Log[Severity == &quot;Critical&quot;] sort by Event_Time desc;\n\n\t\trouteActive = Transport_Routes[Active == true].count(ID);\n\t\tmanifestDraft = Manifests[Manifest_Status == &quot;Draft&quot; || Manifest_Status == &quot;Closed&quot;].count(ID);\n\t\tmanifestTransit = Manifests[Manifest_Status == &quot;In Transit&quot;].count(ID);\n\t\tmanifestExceptions = Manifests[Manifest_Status == &quot;Exception&quot;].count(ID);\n\n\t\topenCredit = ifnull(Account_Ledger[Ledger_Status == &quot;Open&quot; || Ledger_Status == &quot;Partially Settled&quot;].sum(Amount),0);\n\t\toverdueCredit = ifnull(Account_Ledger[Ledger_Status == &quot;Overdue&quot;].sum(Amount),0);\n\t\tageingCurrent = ifnull(Account_Ledger[Ageing_Bucket == &quot;Current&quot; &amp;&amp; Ledger_Status != &quot;Settled&quot;].sum(Amount),0);\n\t\tageing30 = ifnull(Account_Ledger[Ageing_Bucket == &quot;1-30 Days&quot; &amp;&amp; Ledger_Status != &quot;Settled&quot;].sum(Amount),0);\n\t\tageing60 = ifnull(Account_Ledger[Ageing_Bucket == &quot;31-60 Days&quot; &amp;&amp; Ledger_Status != &quot;Settled&quot;].sum(Amount),0);\n\t\tageing90 = ifnull(Account_Ledger[(Ageing_Bucket == &quot;61-90 Days&quot; || Ageing_Bucket == &quot;90+ Days&quot;) &amp;&amp; Ledger_Status != &quot;Settled&quot;].sum(Amount),0);\n\t\tageingTotal = ageingCurrent + ageing30 + ageing60 + ageing90;\n\t\tageingCurrentP = if(ageingTotal &gt; 0,(ageingCurrent * 100.0) / ageingTotal,0);\n\t\tageing30P = if(ageingTotal &gt; 0,(ageing30 * 100.0) / ageingTotal,0);\n\t\tageing60P = if(ageingTotal &gt; 0,(ageing60 * 100.0) / ageingTotal,0);\n\t\tageing90P = if(ageingTotal &gt; 0,(ageing90 * 100.0) / ageingTotal,0);\n}\n%&gt;\n&lt;style&gt;\n/* ZCS global utility sheet, included once for this page. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#f3f3f4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;--zcs-thead-color:#f9fafe;--donut-pi:3.1416;--donut-r:62;--donut-c:389.6}\n.zcs-flex,.zcs-row{display:flex}.zcs-row{flex-wrap:wrap}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-align-items-end{align-items:flex-end}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-row-wrap{flex-wrap:wrap}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-8{padding-left:.5rem;padding-right:.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mb-0{margin-bottom:0}.zcs-mb-8{margin-bottom:.5rem}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-half{border-radius:50%}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-color-green{color:#179e6c}.zcs-color-red{color:#fe455d}.zcs-color-yellow{color:#a06309}.zcs-color-blue{color:#2a6ffc}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-overflow-auto{overflow:auto}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-list-none{list-style:none}.zcs-cursor-pointer{cursor:pointer}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.zcs-page-container{background:var(--zcs-page-bg-color)}a{text-decoration:none}\n.admin-dashboard{min-height:100%;padding:18px;font-family:Arial,sans-serif}.admin-header{background:linear-gradient(112deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));color:var(--zcs_brand_foreground_color);border-radius:16px;overflow:hidden}.admin-header .zcs-color-primary,.admin-header .zcs-color-secondary{color:inherit}.header-actions a{border:1px solid var(--zcs_brand_foreground_color);color:var(--zcs_brand_foreground_color);min-height:36px}.header-actions a:hover{background:var(--zcs_brand_foreground_color);color:var(--zcs_brand_color)}.kpi-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px}.kpi-card{min-height:120px}.kpi-card:hover{border-color:var(--zcs_brand_color)}.kpi-icon{width:38px;height:38px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:18px}.dashboard-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:16px}.span-12{grid-column:span 12}.span-8{grid-column:span 8}.span-7{grid-column:span 7}.span-6{grid-column:span 6}.span-5{grid-column:span 5}.span-4{grid-column:span 4}.span-3{grid-column:span 3}.section-head{border-bottom:1px solid var(--zcs_tertiary_border_color)}.metric-note{white-space:nowrap}.security-banner{border-left:4px solid #fe455d;background:#fde3e6}.scope-banner{border-left:4px solid #2a6ffc;background:#e8efff}.zcs-badge{width:auto;border:1px solid}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#179e6c}.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#fe455d}.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#a06309}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#2a6ffc}.zcs-badge-theme{background:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}\n.chart-card{min-height:330px}.zcs-donut-chart-wrapper{min-height:230px}.zcs-donut-chart{width:166px;height:166px}.zcs-donut-chart svg{width:166px;height:166px;transform:rotate(-90deg)}.zcs-donut-chart circle{cx:83;cy:83;r:62;fill:transparent;stroke-width:18}.zcs-donut-chart circle:nth-child(1){stroke:#fece56;stroke-dasharray:calc(var(--a1)*var(--donut-c)/100) var(--donut-c);stroke-dashoffset:0}.zcs-donut-chart circle:nth-child(2){stroke:#36a2eb;stroke-dasharray:calc(var(--a2)*var(--donut-c)/100) var(--donut-c);stroke-dashoffset:calc(-1*var(--a1)*var(--donut-c)/100)}.zcs-donut-chart circle:nth-child(3){stroke:#ff6283;stroke-dasharray:calc(var(--a3)*var(--donut-c)/100) var(--donut-c);stroke-dashoffset:calc(-1*(var(--a1) + var(--a2))*var(--donut-c)/100)}.zcs-donut-chart circle:nth-child(4){stroke:#28cc97;stroke-dasharray:calc(var(--a4)*var(--donut-c)/100) var(--donut-c);stroke-dashoffset:calc(-1*(var(--a1) + var(--a2) + var(--a3))*var(--donut-c)/100)}.zcs-donut-chart-name{width:92px;left:37px;top:64px}.zcs-legend-wrapper li{list-style:none}.legend-dot{width:10px;height:10px}.legend-yellow{background:#fece56}.legend-blue{background:#36a2eb}.legend-red{background:#ff6283}.legend-green{background:#28cc97}\n.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color)}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}.performance-list li{list-style:none}.revenue-chart{height:220px;border-bottom:1px solid var(--zcs_tertiary_border_color)}.revenue-bar-wrap{height:100%;min-width:48px}.revenue-bar{width:28px;min-height:3px;background:var(--zcs_brand_color);border-radius:6px 6px 0 0}.hub-chart{height:260px}.hub-bars{height:190px;border-bottom:1px solid var(--zcs_tertiary_border_color);overflow-x:auto}.hub-bar-group{height:100%;min-width:84px}.hub-bar{width:22px;min-height:2px;border-radius:5px 5px 0 0}.hub-bar.load{background:#36a2eb}.hub-bar.capacity{background:#e5e7ef;height:100%}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;min-width:620px}.zcs-table-wrapper thead{top:0}.zcs-table-wrapper th{background:var(--zcs-thead-color);box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tbody tr:hover td{background:#f9fafe}.queue-scroll{max-height:355px}.zcs-tl-li{list-style:none;padding-left:26px}.zcs-tl-dot{width:12px;height:12px;background:var(--zcs_brand_color);left:0;top:5px}.zcs-tl-li:not(:last-child):before{content:&quot;&quot;;position:absolute;left:5px;top:16px;width:1px;height:calc(100% + 12px);background:#e1e1e1}.quick-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.zcs-quick-action-item{list-style:none}.zcs-quick-action-item:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover a{color:var(--zcs_brand_color)}.leader-row:not(:last-child){border-bottom:1px solid var(--zcs_tertiary_border_color)}.empty-state{min-height:100px}\n@media(max-width:1250px){.kpi-grid{grid-template-columns:repeat(4,1fr)}.span-8,.span-7,.span-6,.span-5,.span-4,.span-3{grid-column:span 12}}@media(max-width:820px){.kpi-grid{grid-template-columns:repeat(2,1fr)}.admin-dashboard{padding:10px}.admin-header{align-items:flex-start}.quick-grid{grid-template-columns:repeat(2,1fr)}.chart-card{min-height:auto}.zcs-donut-chart-wrapper{flex-direction:column}}@media(max-width:480px){.kpi-grid,.quick-grid{grid-template-columns:1fr}}\n&lt;/style&gt;\n&lt;div class=&apos;admin-dashboard zcs-page-container zcs-box-border&apos;&gt;\n&lt;% if(!allowed) { %&gt;\n\t&lt;div class=&apos;zcs-card security-banner zcs-p-24 zcs-box-border&apos;&gt;\n\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-red zcs-m-0&apos;&gt;Access restricted&lt;/h5&gt;\n\t\t&lt;p class=&apos;zcs-font-14 zcs-color-primary zcs-mb-0&apos;&gt;The network control tower is limited to Logistics Administrator and Operations Manager profiles.&lt;/p&gt;\n\t&lt;/div&gt;\n&lt;% } else { %&gt;\n\t&lt;div class=&apos;admin-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-row-wrap zcs-gap-16 zcs-p-24 zcs-box-border&apos;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-bar-32 zcs-font-24&apos;&gt;&lt;/i&gt;&lt;h1 class=&apos;zcs-font-24 zcs-font-semibold zcs-m-0&apos;&gt;Network control tower&lt;/h1&gt;&lt;/div&gt;\n\t\t\t&lt;p class=&apos;zcs-font-14 zcs-mt-8 zcs-mb-0&apos;&gt;India network overview for &lt;%=zoho.loginuser%&gt; · &lt;%=zoho.currentdate%&gt;&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;header-actions zcs-flex zcs-row-wrap zcs-gap-8&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Report:All_Shipments&apos;&gt;&lt;i class=&apos;zc-li-outline transport-truck-front&apos;&gt;&lt;/i&gt;All shipments&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Report:Shipment_Exception_Queue&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt;Exception queue&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;% if(isOperations) { %&gt;\n\t&lt;div class=&apos;zcs-card scope-banner zcs-flex zcs-align-items-start zcs-gap-10 zcs-p-12 zcs-box-border zcs-mt-12&apos;&gt;\n\t\t&lt;i class=&apos;zc-li-outline ui-1-lock-circle-open zcs-color-blue zcs-font-18&apos;&gt;&lt;/i&gt;&lt;p class=&apos;zcs-font-13 zcs-color-primary zcs-m-0&apos;&gt;Operational network scope is active. Detailed KYC, credit ageing, and critical audit evidence are shown only to the Logistics Administrator profile.&lt;/p&gt;\n\t&lt;/div&gt;\n\t&lt;% } %&gt;\n\n\t&lt;div class=&apos;kpi-grid zcs-mt-12&apos;&gt;\n\t\t&lt;a href=&apos;#Report:All_Customers&apos; class=&apos;kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline users-multiple-19&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;R &lt;%=activeRetail%&gt; · C &lt;%=activeCorporate%&gt; · W &lt;%=activeWholesale%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;strong class=&apos;zcs-font-24 zcs-color-primary&apos;&gt;&lt;%=activeCustomers%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Active customers by type&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a href=&apos;#Report:Verification_Pending&apos; class=&apos;kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-file-search&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;strong class=&apos;zcs-font-24 zcs-color-primary&apos;&gt;&lt;%=pendingKYC%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Pending KYC&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a href=&apos;#Report:All_Shipments&apos; class=&apos;kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-delivery-fast&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;strong class=&apos;zcs-font-24 zcs-color-primary&apos;&gt;&lt;%=todayBookings%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Today&apos;s bookings&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a href=&apos;#Report:Invoice_Statement&apos; class=&apos;kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline business-money-coins&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;strong class=&apos;zcs-font-20 zcs-color-primary&apos;&gt;INR &lt;%=todayRevenue.round(0)%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Today&apos;s revenue&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a href=&apos;#Report:Unassigned_Orders&apos; class=&apos;kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline location-pin&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;strong class=&apos;zcs-font-24 zcs-color-primary&apos;&gt;&lt;%=unassignedShipments%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Unassigned shipments&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a href=&apos;#Report:All_Shipments&apos; class=&apos;kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-refresh-69&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;strong class=&apos;zcs-font-24 zcs-color-primary&apos;&gt;&lt;%=inTransitShipments%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;In-transit shipments&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a href=&apos;#Report:Delivered_Shipments&apos; class=&apos;kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;strong class=&apos;zcs-font-24 zcs-color-primary&apos;&gt;&lt;%=deliveredToday%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Delivered today&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a href=&apos;#Report:NDR_Instruction_Action_Queue&apos; class=&apos;kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-4-restore&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;strong class=&apos;zcs-font-24 zcs-color-primary&apos;&gt;&lt;%=ndrShipments + rtoShipments%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;NDR / RTO · &lt;%=ndrShipments%&gt; / &lt;%=rtoShipments%&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a href=&apos;#Report:COD_Pending_Remittance&apos; class=&apos;kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline business-cash-register&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;strong class=&apos;zcs-font-20 zcs-color-primary&apos;&gt;INR &lt;%=codPendingAmount.round(0)%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;COD pending · &lt;%=codPendingCount%&gt; remittances&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a href=&apos;#Report:Critical_Exceptions&apos; class=&apos;kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;strong class=&apos;zcs-font-24 zcs-color-red&apos;&gt;&lt;%=criticalExceptions%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Open critical exceptions&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a href=&apos;#Report:Loyalty_Transaction_Ledger&apos; class=&apos;kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-favourite-31&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;strong class=&apos;zcs-font-20 zcs-color-primary&apos;&gt;&lt;%=loyaltyIssued.round(0)%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Loyalty issued · 30 days&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a href=&apos;#Report:Loyalty_Transaction_Ledger&apos; class=&apos;kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-tag-sale&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;strong class=&apos;zcs-font-20 zcs-color-primary&apos;&gt;&lt;%=loyaltyRedeemed.round(0)%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Loyalty redeemed · 30 days&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;dashboard-grid zcs-mt-12&apos;&gt;\n\t\t&lt;section class=&apos;span-4 zcs-card chart-card zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-justify-space-between zcs-gap-8 zcs-py-8&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Shipment status&lt;/h2&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;Current network flow&lt;/p&gt;&lt;/div&gt;&lt;a href=&apos;#Report:Shipment_Status_Board&apos; class=&apos;zcs-font-13 zcs-color-theme&apos;&gt;Open board&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-donut-chart-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-12&apos; style=&apos;--a1:&lt;%=statusP1%&gt;;--a2:&lt;%=statusP2%&gt;;--a3:&lt;%=statusP3%&gt;;--a4:&lt;%=statusP4%&gt;&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-donut-chart zcs-flex zcs-align-items-center zcs-justify-center zcs-relative&apos;&gt;&lt;svg class=&apos;zcs-rounded-half&apos;&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;/svg&gt;&lt;h6 class=&apos;zcs-donut-chart-name zcs-font-14 zcs-font-medium zcs-color-primary zcs-m-0 zcs-absolute zcs-text-center&apos;&gt;&lt;%=statusTotal%&gt;&lt;br&gt;shipments&lt;/h6&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-legend-wrapper&apos;&gt;&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-10 zcs-p-0 zcs-m-0&apos;&gt;&lt;li class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;legend-dot legend-yellow zcs-rounded-half&apos;&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-13 zcs-color-primary&apos;&gt;Booked &lt;%=bookedStatus%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;legend-dot legend-blue zcs-rounded-half&apos;&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-13 zcs-color-primary&apos;&gt;Linehaul &lt;%=linehaulStatus%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;legend-dot legend-red zcs-rounded-half&apos;&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-13 zcs-color-primary&apos;&gt;Last mile &lt;%=lastMileStatus%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;legend-dot legend-green zcs-rounded-half&apos;&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-13 zcs-color-primary&apos;&gt;Delivered &lt;%=completedStatus%&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;span-4 zcs-card chart-card zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-justify-space-between zcs-gap-8 zcs-py-8&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Transport mode&lt;/h2&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;Booking mix&lt;/p&gt;&lt;/div&gt;&lt;a href=&apos;#Report:All_Shipments&apos; class=&apos;zcs-font-13 zcs-color-theme&apos;&gt;View shipments&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-donut-chart-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-12&apos; style=&apos;--a1:&lt;%=airP%&gt;;--a2:&lt;%=surfaceP%&gt;;--a3:0;--a4:0&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-donut-chart zcs-flex zcs-align-items-center zcs-justify-center zcs-relative&apos;&gt;&lt;svg class=&apos;zcs-rounded-half&apos;&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;/svg&gt;&lt;h6 class=&apos;zcs-donut-chart-name zcs-font-14 zcs-font-medium zcs-color-primary zcs-m-0 zcs-absolute zcs-text-center&apos;&gt;&lt;%=modeTotal%&gt;&lt;br&gt;bookings&lt;/h6&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-legend-wrapper&apos;&gt;&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&apos;&gt;&lt;li class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;legend-dot legend-yellow zcs-rounded-half&apos;&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-13 zcs-color-primary&apos;&gt;Air &lt;%=airCount%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;legend-dot legend-blue zcs-rounded-half&apos;&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-13 zcs-color-primary&apos;&gt;Surface &lt;%=surfaceCount%&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;span-4 zcs-card chart-card zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-justify-space-between zcs-gap-8 zcs-py-8&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Delivery success rate&lt;/h2&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;Delivered against terminal exceptions&lt;/p&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-green zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm zcs-font-13&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&amp;nbsp;&lt;%=deliverySuccess.round(1)%&gt;%&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;ul class=&apos;performance-list zcs-flex zcs-direction-column zcs-gap-24 zcs-p-0 zcs-mt-12 zcs-mb-0&apos;&gt;\n\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-8&apos;&gt;&lt;p class=&apos;zcs-flex zcs-justify-space-between zcs-font-14 zcs-color-primary zcs-m-0&apos;&gt;&lt;span&gt;Successful delivery&lt;/span&gt;&lt;span&gt;&lt;%=deliverySuccess.round(1)%&gt;%&lt;/span&gt;&lt;/p&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=deliverySuccess%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-8&apos;&gt;&lt;p class=&apos;zcs-flex zcs-justify-space-between zcs-font-14 zcs-color-primary zcs-m-0&apos;&gt;&lt;span&gt;NDR share&lt;/span&gt;&lt;span&gt;&lt;%=ndrRate.round(1)%&gt;%&lt;/span&gt;&lt;/p&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=ndrRate%&gt;%;background:#faae13&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-8&apos;&gt;&lt;p class=&apos;zcs-flex zcs-justify-space-between zcs-font-14 zcs-color-primary zcs-m-0&apos;&gt;&lt;span&gt;RTO share&lt;/span&gt;&lt;span&gt;&lt;%=rtoRate.round(1)%&gt;%&lt;/span&gt;&lt;/p&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=rtoRate%&gt;%;background:#fe455d&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t&lt;/ul&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;span-7 zcs-card chart-card zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-justify-space-between zcs-gap-8 zcs-py-8&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Revenue trend&lt;/h2&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;Issued invoice value · last seven days&lt;/p&gt;&lt;/div&gt;&lt;a href=&apos;#Report:Invoice_Statement&apos; class=&apos;zcs-font-13 zcs-color-theme&apos;&gt;Invoice statement&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;revenue-chart zcs-flex zcs-align-items-end zcs-justify-space-between zcs-gap-12 zcs-px-12 zcs-mt-12&apos;&gt;\n\t\t\t\t&lt;div class=&apos;revenue-bar-wrap zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;zcs-font-11 zcs-color-tertiary&apos;&gt;&lt;%=revD6.round(0)%&gt;&lt;/span&gt;&lt;div class=&apos;revenue-bar&apos; style=&apos;height:&lt;%=revH6%&gt;%&apos;&gt;&lt;/div&gt;&lt;span class=&apos;zcs-font-11 zcs-color-primary&apos;&gt;&lt;%=revD6Date.toString(&quot;dd-MMM&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;revenue-bar-wrap zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;zcs-font-11 zcs-color-tertiary&apos;&gt;&lt;%=revD5.round(0)%&gt;&lt;/span&gt;&lt;div class=&apos;revenue-bar&apos; style=&apos;height:&lt;%=revH5%&gt;%&apos;&gt;&lt;/div&gt;&lt;span class=&apos;zcs-font-11 zcs-color-primary&apos;&gt;&lt;%=revD5Date.toString(&quot;dd-MMM&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;revenue-bar-wrap zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;zcs-font-11 zcs-color-tertiary&apos;&gt;&lt;%=revD4.round(0)%&gt;&lt;/span&gt;&lt;div class=&apos;revenue-bar&apos; style=&apos;height:&lt;%=revH4%&gt;%&apos;&gt;&lt;/div&gt;&lt;span class=&apos;zcs-font-11 zcs-color-primary&apos;&gt;&lt;%=revD4Date.toString(&quot;dd-MMM&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;revenue-bar-wrap zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;zcs-font-11 zcs-color-tertiary&apos;&gt;&lt;%=revD3.round(0)%&gt;&lt;/span&gt;&lt;div class=&apos;revenue-bar&apos; style=&apos;height:&lt;%=revH3%&gt;%&apos;&gt;&lt;/div&gt;&lt;span class=&apos;zcs-font-11 zcs-color-primary&apos;&gt;&lt;%=revD3Date.toString(&quot;dd-MMM&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;revenue-bar-wrap zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;zcs-font-11 zcs-color-tertiary&apos;&gt;&lt;%=revD2.round(0)%&gt;&lt;/span&gt;&lt;div class=&apos;revenue-bar&apos; style=&apos;height:&lt;%=revH2%&gt;%&apos;&gt;&lt;/div&gt;&lt;span class=&apos;zcs-font-11 zcs-color-primary&apos;&gt;&lt;%=revD2Date.toString(&quot;dd-MMM&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;revenue-bar-wrap zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;zcs-font-11 zcs-color-tertiary&apos;&gt;&lt;%=revD1.round(0)%&gt;&lt;/span&gt;&lt;div class=&apos;revenue-bar&apos; style=&apos;height:&lt;%=revH1%&gt;%&apos;&gt;&lt;/div&gt;&lt;span class=&apos;zcs-font-11 zcs-color-primary&apos;&gt;&lt;%=revD1Date.toString(&quot;dd-MMM&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;revenue-bar-wrap zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;zcs-font-11 zcs-color-tertiary&apos;&gt;&lt;%=revD0.round(0)%&gt;&lt;/span&gt;&lt;div class=&apos;revenue-bar&apos; style=&apos;height:&lt;%=revH0%&gt;%&apos;&gt;&lt;/div&gt;&lt;span class=&apos;zcs-font-11 zcs-color-primary&apos;&gt;Today&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;span-5 zcs-card chart-card zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-justify-space-between zcs-gap-8 zcs-py-8&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Customer type&lt;/h2&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;Active customer mix&lt;/p&gt;&lt;/div&gt;&lt;a href=&apos;#Report:All_Customers&apos; class=&apos;zcs-font-13 zcs-color-theme&apos;&gt;Customer directory&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-donut-chart-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-12&apos; style=&apos;--a1:&lt;%=retailP%&gt;;--a2:&lt;%=corporateP%&gt;;--a3:&lt;%=wholesaleP%&gt;;--a4:0&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-donut-chart zcs-flex zcs-align-items-center zcs-justify-center zcs-relative&apos;&gt;&lt;svg class=&apos;zcs-rounded-half&apos;&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;/svg&gt;&lt;h6 class=&apos;zcs-donut-chart-name zcs-font-14 zcs-font-medium zcs-color-primary zcs-m-0 zcs-absolute zcs-text-center&apos;&gt;&lt;%=activeCustomers%&gt;&lt;br&gt;active&lt;/h6&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-legend-wrapper&apos;&gt;&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-10 zcs-p-0 zcs-m-0&apos;&gt;&lt;li class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;legend-dot legend-yellow zcs-rounded-half&apos;&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-13 zcs-color-primary&apos;&gt;Retail &lt;%=activeRetail%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;legend-dot legend-blue zcs-rounded-half&apos;&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-13 zcs-color-primary&apos;&gt;Corporate &lt;%=activeCorporate%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;legend-dot legend-red zcs-rounded-half&apos;&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-13 zcs-color-primary&apos;&gt;Wholesale &lt;%=activeWholesale%&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;span-8 zcs-card chart-card zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-justify-space-between zcs-gap-8 zcs-py-8&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Hub throughput and capacity&lt;/h2&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;Current shipment load against daily capacity&lt;/p&gt;&lt;/div&gt;&lt;a href=&apos;#Report:Hub_Capacity&apos; class=&apos;zcs-font-13 zcs-color-theme&apos;&gt;Capacity report&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;hub-chart zcs-mt-12&apos;&gt;&lt;div class=&apos;hub-bars zcs-flex zcs-align-items-end zcs-gap-16 zcs-px-12&apos;&gt;\n\t\t\t&lt;% hubChartCount = 0; for each hub in activeHubs { if(hubChartCount &lt; 8) { hubChartCount = hubChartCount + 1; hubLoad = Shipment_Requests[Current_Hub == hub.ID &amp;&amp; Shipment_Status != &quot;Delivered&quot; &amp;&amp; Shipment_Status != &quot;Cancelled&quot;].count(ID); hubCap = ifnull(hub.Daily_Capacity,0); hubUtil = if(hubCap &gt; 0,(hubLoad * 100.0) / hubCap,0); hubDisplayUtil = if(hubUtil &gt; 100,100,hubUtil); %&gt;\n\t\t\t\t&lt;div class=&apos;hub-bar-group zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;zcs-font-11 zcs-color-tertiary&apos;&gt;&lt;%=hubUtil.round(0)%&gt;%&lt;/span&gt;&lt;div class=&apos;zcs-flex zcs-align-items-end zcs-gap-4 zcs-col-common&apos;&gt;&lt;div class=&apos;hub-bar load&apos; style=&apos;height:&lt;%=hubDisplayUtil%&gt;%&apos;&gt;&lt;/div&gt;&lt;div class=&apos;hub-bar capacity&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-font-11 zcs-color-primary zcs-text-center&apos;&gt;&lt;%=hub.Hub_ID%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;% } } %&gt;\n\t\t\t&lt;/div&gt;&lt;div class=&apos;zcs-flex zcs-justify-center zcs-gap-16 zcs-mt-8&apos;&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;i class=&apos;zc-li-solid ui-1-circle&apos; style=&apos;color:#36a2eb&apos;&gt;&lt;/i&gt; Current load&lt;/span&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;i class=&apos;zc-li-solid ui-1-circle&apos; style=&apos;color:#e5e7ef&apos;&gt;&lt;/i&gt; Capacity&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;span-4 zcs-card chart-card zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-justify-space-between zcs-gap-8 zcs-py-8&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Loyalty tier mix&lt;/h2&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;Active customer tier distribution&lt;/p&gt;&lt;/div&gt;&lt;a href=&apos;#Report:Loyalty_Tiers&apos; class=&apos;zcs-font-13 zcs-color-theme&apos;&gt;Tier rules&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-donut-chart-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-12&apos; style=&apos;--a1:&lt;%=tierP1%&gt;;--a2:&lt;%=tierP2%&gt;;--a3:&lt;%=tierP3%&gt;;--a4:&lt;%=tierP4%&gt;&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-donut-chart zcs-flex zcs-align-items-center zcs-justify-center zcs-relative&apos;&gt;&lt;svg class=&apos;zcs-rounded-half&apos;&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;/svg&gt;&lt;h6 class=&apos;zcs-donut-chart-name zcs-font-14 zcs-font-medium zcs-color-primary zcs-m-0 zcs-absolute zcs-text-center&apos;&gt;&lt;%=tierTotal%&gt;&lt;br&gt;customers&lt;/h6&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-legend-wrapper&apos;&gt;&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-8 zcs-p-0 zcs-m-0&apos;&gt;&lt;li class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;legend-dot legend-yellow zcs-rounded-half&apos;&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-13 zcs-color-primary&apos;&gt;Silver &lt;%=tierSilver%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;legend-dot legend-blue zcs-rounded-half&apos;&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-13 zcs-color-primary&apos;&gt;Gold &lt;%=tierGold%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;legend-dot legend-red zcs-rounded-half&apos;&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-13 zcs-color-primary&apos;&gt;Platinum &lt;%=tierPlatinum%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;legend-dot legend-green zcs-rounded-half&apos;&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-13 zcs-color-primary&apos;&gt;None &lt;%=tierNone%&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;span-7 zcs-card zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-justify-space-between zcs-gap-8 zcs-py-8&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Route and manifest activity&lt;/h2&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;&lt;%=routeActive%&gt; active routes · &lt;%=manifestTransit%&gt; manifests in transit&lt;/p&gt;&lt;/div&gt;&lt;a href=&apos;#Report:All_Manifests&apos; class=&apos;zcs-font-13 zcs-color-theme&apos;&gt;All manifests&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-row-wrap zcs-gap-8 zcs-mt-12&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-theme zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm zcs-font-13&apos;&gt;Draft / closed &lt;%=manifestDraft%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-blue zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm zcs-font-13&apos;&gt;In transit &lt;%=manifestTransit%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-red zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm zcs-font-13&apos;&gt;Exception &lt;%=manifestExceptions%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative zcs-mt-12&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13 zcs-font-medium&apos;&gt;Manifest&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13 zcs-font-medium&apos;&gt;Lane&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13 zcs-font-medium&apos;&gt;Departure&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13 zcs-font-medium&apos;&gt;Status&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-13 zcs-font-medium&apos;&gt;Shipments&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t&lt;% manifestCount = 0; for each manifest in recentManifests { if(manifestCount &lt; 6) { manifestCount = manifestCount + 1; manifestBadge = &quot;zcs-badge-theme&quot;; if(manifest.Manifest_Status == &quot;In Transit&quot;){manifestBadge = &quot;zcs-badge-blue&quot;;} else if(manifest.Manifest_Status == &quot;Exception&quot;){manifestBadge = &quot;zcs-badge-red&quot;;} else if(manifest.Manifest_Status == &quot;Reconciled&quot; || manifest.Manifest_Status == &quot;Arrived&quot;){manifestBadge = &quot;zcs-badge-green&quot;;} %&gt;\n\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary&apos;&gt;&lt;%=manifest.Manifest_Number%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary&apos;&gt;&lt;%=manifest.Origin_Hub.Hub_ID%&gt; to &lt;%=manifest.Destination_Hub.Hub_ID%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-tertiary&apos;&gt;&lt;%=ifnull(manifest.Departure_Time,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;zcs-badge &lt;%=manifestBadge%&gt; zcs-inline-flex zcs-px-8 zcs-py-2 zcs-rounded-sm zcs-font-12&apos;&gt;&lt;%=manifest.Manifest_Status%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-13 zcs-color-primary&apos;&gt;&lt;%=ifnull(manifest.Total_Shipments,0)%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t&lt;% } } if(manifestCount == 0) { %&gt;&lt;tr&gt;&lt;td colspan=&apos;5&apos; class=&apos;zcs-p-24 zcs-text-center zcs-font-13 zcs-color-tertiary&apos;&gt;No manifest activity is available.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;span-5 zcs-card zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-justify-space-between zcs-gap-8 zcs-py-8&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Hub leaderboard&lt;/h2&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;Lowest utilization leads available capacity&lt;/p&gt;&lt;/div&gt;&lt;a href=&apos;#Report:All_Hubs&apos; class=&apos;zcs-font-13 zcs-color-theme&apos;&gt;Hub directory&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-mt-8&apos;&gt;\n\t\t\t&lt;% leaderCount = 0; for each leaderHub in activeHubs { if(leaderCount &lt; 6) { leaderCount = leaderCount + 1; leaderLoad = Shipment_Requests[Current_Hub == leaderHub.ID &amp;&amp; Shipment_Status != &quot;Delivered&quot; &amp;&amp; Shipment_Status != &quot;Cancelled&quot;].count(ID); leaderCap = ifnull(leaderHub.Daily_Capacity,0); leaderUtil = if(leaderCap &gt; 0,(leaderLoad * 100.0) / leaderCap,0); leaderDisplay = if(leaderUtil &gt; 100,100,leaderUtil); %&gt;\n\t\t\t\t&lt;div class=&apos;leader-row zcs-flex zcs-align-items-center zcs-gap-12 zcs-py-12&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-theme zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-12&apos; style=&apos;width:28px;height:28px&apos;&gt;&lt;%=leaderCount%&gt;&lt;/span&gt;&lt;div class=&apos;zcs-col-common&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;span class=&apos;zcs-font-13 zcs-font-medium zcs-color-primary&apos;&gt;&lt;%=leaderHub.Hub_Name%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;%=leaderLoad%&gt; / &lt;%=leaderCap%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm zcs-mt-4&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=leaderDisplay%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong class=&apos;zcs-font-13 zcs-color-primary&apos;&gt;&lt;%=leaderUtil.round(0)%&gt;%&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;% } } %&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;% if(isAdmin) { %&gt;\n\t\t&lt;section class=&apos;span-6 zcs-card zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-justify-space-between zcs-gap-8 zcs-py-8&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;KYC verification queue&lt;/h2&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;Submitted customers awaiting review&lt;/p&gt;&lt;/div&gt;&lt;a href=&apos;#Report:Verification_Pending&apos; class=&apos;zcs-font-13 zcs-color-theme&apos;&gt;Open queue&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper queue-scroll zcs-rounded-sm zcs-box-border zcs-relative zcs-mt-12&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Customer&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Type&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Submitted&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-13&apos;&gt;Credit request&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t&lt;% verifyCount = 0; for each customerKyc in verificationQueue { if(verifyCount &lt; 6) { verifyCount = verifyCount + 1; %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary&apos;&gt;&lt;a class=&apos;zcs-color-theme&apos; href=&apos;#Page:KYC_Review?Customer_ID=&lt;%=customerKyc.ID%&gt;&apos;&gt;&lt;%=ifnull(customerKyc.Company_Name,customerKyc.Email_ID)%&gt;&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary&apos;&gt;&lt;%=customerKyc.Customer_Type%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-tertiary&apos;&gt;&lt;%=ifnull(customerKyc.KYC_Submitted_On,&quot;Not stamped&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-13 zcs-color-primary&apos;&gt;INR &lt;%=ifnull(customerKyc.Requested_Credit_Limit,0).round(0)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } } if(verifyCount == 0) { %&gt;&lt;tr&gt;&lt;td colspan=&apos;4&apos; class=&apos;zcs-p-24 zcs-text-center zcs-font-13 zcs-color-tertiary&apos;&gt;No customers are waiting for KYC verification.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;span-6 zcs-card zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-justify-space-between zcs-gap-8 zcs-py-8&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;KYC expiry queue&lt;/h2&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;Expired or expiring in 30 days&lt;/p&gt;&lt;/div&gt;&lt;a href=&apos;#Report:KYC_Expiry_Alert&apos; class=&apos;zcs-font-13 zcs-color-theme&apos;&gt;Expiry report&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper queue-scroll zcs-rounded-sm zcs-box-border zcs-relative zcs-mt-12&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Customer&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Type&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Expiry&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t&lt;% expiryCount = 0; for each expiryCustomer in expiryQueue { if(expiryCount &lt; 6) { expiryCount = expiryCount + 1; expiryBadge = if(expiryCustomer.KYC_Expiry_Date &lt; zoho.currentdate,&quot;zcs-badge-red&quot;,&quot;zcs-badge-yellow&quot;); %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary&apos;&gt;&lt;%=ifnull(expiryCustomer.Company_Name,expiryCustomer.Email_ID)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary&apos;&gt;&lt;%=expiryCustomer.Customer_Type%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary&apos;&gt;&lt;%=expiryCustomer.KYC_Expiry_Date%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;zcs-badge &lt;%=expiryBadge%&gt; zcs-inline-flex zcs-px-8 zcs-py-2 zcs-rounded-sm zcs-font-12&apos;&gt;&lt;%=if(expiryCustomer.KYC_Expiry_Date &lt; zoho.currentdate,&quot;Expired&quot;,&quot;Expiring&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } } if(expiryCount == 0) { %&gt;&lt;tr&gt;&lt;td colspan=&apos;4&apos; class=&apos;zcs-p-24 zcs-text-center zcs-font-13 zcs-color-tertiary&apos;&gt;No KYC expiries require attention.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;span-7 zcs-card zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-justify-space-between zcs-gap-8 zcs-py-8&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Credit utilization and ageing&lt;/h2&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;Open exposure INR &lt;%=openCredit.round(0)%&gt; · overdue INR &lt;%=overdueCredit.round(0)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;a href=&apos;#Report:Ledger_Ageing&apos; class=&apos;zcs-font-13 zcs-color-theme&apos;&gt;Ageing report&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;ul class=&apos;performance-list zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-mt-12 zcs-mb-0&apos;&gt;\n\t\t\t\t&lt;li&gt;&lt;p class=&apos;zcs-flex zcs-justify-space-between zcs-font-13 zcs-color-primary zcs-m-0&apos;&gt;&lt;span&gt;Current&lt;/span&gt;&lt;span&gt;INR &lt;%=ageingCurrent.round(0)%&gt;&lt;/span&gt;&lt;/p&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm zcs-mt-4&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=ageingCurrentP%&gt;%;background:#179e6c&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t&lt;li&gt;&lt;p class=&apos;zcs-flex zcs-justify-space-between zcs-font-13 zcs-color-primary zcs-m-0&apos;&gt;&lt;span&gt;1–30 days&lt;/span&gt;&lt;span&gt;INR &lt;%=ageing30.round(0)%&gt;&lt;/span&gt;&lt;/p&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm zcs-mt-4&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=ageing30P%&gt;%;background:#36a2eb&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t&lt;li&gt;&lt;p class=&apos;zcs-flex zcs-justify-space-between zcs-font-13 zcs-color-primary zcs-m-0&apos;&gt;&lt;span&gt;31–60 days&lt;/span&gt;&lt;span&gt;INR &lt;%=ageing60.round(0)%&gt;&lt;/span&gt;&lt;/p&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm zcs-mt-4&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=ageing60P%&gt;%;background:#faae13&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t&lt;li&gt;&lt;p class=&apos;zcs-flex zcs-justify-space-between zcs-font-13 zcs-color-primary zcs-m-0&apos;&gt;&lt;span&gt;61+ days&lt;/span&gt;&lt;span&gt;INR &lt;%=ageing90.round(0)%&gt;&lt;/span&gt;&lt;/p&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm zcs-mt-4&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=ageing90P%&gt;%;background:#fe455d&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t&lt;/ul&gt;&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-mt-12&apos;&gt;&lt;a class=&apos;zcs-badge zcs-badge-theme zcs-inline-flex zcs-px-10 zcs-py-6 zcs-rounded-sm zcs-font-13&apos; href=&apos;#Report:Credit_Utilization&apos;&gt;Credit utilization&lt;/a&gt;&lt;a class=&apos;zcs-badge zcs-badge-red zcs-inline-flex zcs-px-10 zcs-py-6 zcs-rounded-sm zcs-font-13&apos; href=&apos;#Report:Overdue_Invoices&apos;&gt;Overdue invoices&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;span-5 zcs-card zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-justify-space-between zcs-gap-8 zcs-py-8&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Recent critical audit feed&lt;/h2&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;Privileged and custody-sensitive activity&lt;/p&gt;&lt;/div&gt;&lt;a href=&apos;#Report:Critical_Audit_Events&apos; class=&apos;zcs-font-13 zcs-color-theme&apos;&gt;Critical audit&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-timeline-wrapper queue-scroll zcs-overflow-auto zcs-mt-12&apos;&gt;&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-20 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t&lt;% auditCount = 0; for each auditEvent in recentCriticalAudits { if(auditCount &lt; 6) { auditCount = auditCount + 1; %&gt;&lt;li class=&apos;zcs-tl-li zcs-relative&apos;&gt;&lt;span class=&apos;zcs-tl-dot zcs-rounded-half zcs-absolute&apos;&gt;&lt;/span&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;strong class=&apos;zcs-font-13 zcs-color-primary&apos;&gt;&lt;%=auditEvent.Action_Name%&gt;&lt;/strong&gt;&lt;span class=&apos;zcs-font-11 zcs-color-tertiary&apos;&gt;&lt;%=auditEvent.Event_Time%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-mt-4 zcs-mb-0&apos;&gt;&lt;%=auditEvent.Module_Name%&gt; · &lt;%=auditEvent.Actor_Email%&gt;&lt;/p&gt;&lt;/li&gt;&lt;% } } if(auditCount == 0) { %&gt;&lt;li class=&apos;zcs-p-24 zcs-text-center zcs-font-13 zcs-color-tertiary&apos;&gt;No critical audit events are available.&lt;/li&gt;&lt;% } %&gt;\n\t\t\t&lt;/ul&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t\t&lt;% } %&gt;\n\n\t\t&lt;section class=&apos;span-12 zcs-quick-actions-wrapper zcs-card zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-justify-space-between zcs-gap-8 zcs-py-8&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Quick links&lt;/h2&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;Master setup and network exception queues&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;h3 class=&apos;zcs-font-14 zcs-font-semibold zcs-color-primary zcs-mt-12 zcs-mb-8&apos;&gt;Exception queues&lt;/h3&gt;\n\t\t\t&lt;ul class=&apos;quick-grid zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:Unassigned_Orders&apos;&gt;&lt;i class=&apos;zc-li-outline location-pin&apos;&gt;&lt;/i&gt;Unassigned orders&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:Shipment_Exception_Queue&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt;Shipment exceptions&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:Critical_Exceptions&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;Critical exceptions&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:NDR_Instruction_Action_Queue&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-4-restore&apos;&gt;&lt;/i&gt;NDR action queue&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:NDR_RTO_Pending&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-left&apos;&gt;&lt;/i&gt;RTO pending&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:COD_Pending_Remittance&apos;&gt;&lt;i class=&apos;zc-li-outline business-cash-register&apos;&gt;&lt;/i&gt;COD pending&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;% if(isAdmin) { %&gt;&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:Failed_Payments&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;Failed payments&lt;/a&gt;&lt;/li&gt;&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:Failed_Communications&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-email&apos;&gt;&lt;/i&gt;Failed communications&lt;/a&gt;&lt;/li&gt;&lt;% } %&gt;\n\t\t\t&lt;/ul&gt;\n\t\t\t&lt;% if(isAdmin) { %&gt;\n\t\t\t&lt;h3 class=&apos;zcs-font-14 zcs-font-semibold zcs-color-primary zcs-mt-12 zcs-mb-8&apos;&gt;Master setup&lt;/h3&gt;\n\t\t\t&lt;ul class=&apos;quick-grid zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:App_Configurations&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-settings-gear-63&apos;&gt;&lt;/i&gt;App configuration&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:All_Hubs&apos;&gt;&lt;i class=&apos;zc-li-outline buildings-1-office&apos;&gt;&lt;/i&gt;Hubs&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:Pincode_Mappings&apos;&gt;&lt;i class=&apos;zc-li-outline location-map-big&apos;&gt;&lt;/i&gt;Pincode mapping&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:All_Transport_Routes&apos;&gt;&lt;i class=&apos;zc-li-outline location-road&apos;&gt;&lt;/i&gt;Transport routes&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:All_Vehicles&apos;&gt;&lt;i class=&apos;zc-li-outline transport-truck-front&apos;&gt;&lt;/i&gt;Vehicles&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:Operations_User_Directory&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-05&apos;&gt;&lt;/i&gt;Operations users&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:All_Rate_Cards&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-credit-card&apos;&gt;&lt;/i&gt;Rate cards&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:Rate_Slab_Register&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-bar-32&apos;&gt;&lt;/i&gt;Rate slabs&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:KYC_Document_Type_Mapping&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-doc&apos;&gt;&lt;/i&gt;KYC document types&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:Loyalty_Rule_Register&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-favourite-31&apos;&gt;&lt;/i&gt;Loyalty rules&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:Loyalty_Tier_Register&apos;&gt;&lt;i class=&apos;zc-li-outline business-award-49&apos;&gt;&lt;/i&gt;Loyalty tiers&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary&apos; href=&apos;#Report:Audit_Log_Report&apos;&gt;&lt;i class=&apos;zc-li-outline files-3-check&apos;&gt;&lt;/i&gt;Audit log&lt;/a&gt;&lt;/li&gt;\n\t\t\t&lt;/ul&gt;\n\t\t\t&lt;% } %&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;% } %&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Agent_Dashboard
		{
					displayname = "Agent Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Agent_Day_View' elementName='Agent_Day_View'>\n\t\t\t\t\t<![CDATA[htmlpage Agent_Day_View()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nprofileName = thisapp.permissions.loginUserProfile();\nisFieldAgent = profileName == &quot;Field_Agent&quot;;\nisSupportAdmin = profileName == &quot;Logistics_Administrator&quot; || profileName == &quot;Administrator&quot;;\nisAllowed = isFieldAgent || isSupportAdmin;\nagentRows = Operations_Users[Work_Email == zoho.loginuserid &amp;&amp; Active == true];\nagentFound = agentRows.count(ID) &gt; 0;\nif(isAllowed &amp;&amp; agentFound)\n{\n\t\tagent = agentRows;\n\t\tagentId = agent.ID;\n\t\teffectiveHubId = agent.Home_Hub;\n\t\tisDeputed = false;\n\t\tdeputationActive = agent.Deputed_Hub != null &amp;&amp; (agent.Deputation_Start_Date == null || agent.Deputation_Start_Date &lt;= zoho.currentdate) &amp;&amp; (agent.Deputation_End_Date == null || agent.Deputation_End_Date &gt;= zoho.currentdate);\n\t\tif(deputationActive)\n\t\t{\n\t\t\t\teffectiveHubId = agent.Deputed_Hub;\n\t\t\t\tisDeputed = true;\n\t\t}\n\t\thubName = &quot;Hub not assigned&quot;;\n\t\tif(effectiveHubId != null)\n\t\t{\n\t\t\t\teffectiveHub = Hubs[ID == effectiveHubId];\n\t\t\t\tif(effectiveHub.count(ID) &gt; 0)\n\t\t\t\t{\n\t\t\t\t\t\thubName = ifnull(effectiveHub.Hub_Name,&quot;Hub&quot;);\n\t\t\t\t}\n\t\t}\n\n\t\tpickupRuns = Pickup_Run_Sheets[Assigned_Agent == agentId &amp;&amp; Run_Date == zoho.currentdate &amp;&amp; Status != &quot;Draft&quot; &amp;&amp; Status != &quot;Cancelled&quot;];\n\t\tdeliveryRuns = Delivery_Run_Sheets[Assigned_Agent == agentId &amp;&amp; Run_Date == zoho.currentdate &amp;&amp; DRS_Status != &quot;Draft&quot; &amp;&amp; DRS_Status != &quot;Cancelled&quot;];\n\t\tpickupTasks = Pickup_Run_Sheet_Items[Pickup_Run_Sheet.Assigned_Agent == agentId &amp;&amp; Pickup_Run_Sheet.Run_Date == zoho.currentdate &amp;&amp; Pickup_Run_Sheet.Status != &quot;Draft&quot; &amp;&amp; Pickup_Run_Sheet.Status != &quot;Cancelled&quot;] sort by Stop_Sequence asc;\n\t\tdeliveryTasks = Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Assigned_Agent == agentId &amp;&amp; Delivery_Run_Sheet.Run_Date == zoho.currentdate &amp;&amp; Delivery_Run_Sheet.DRS_Status != &quot;Draft&quot; &amp;&amp; Delivery_Run_Sheet.DRS_Status != &quot;Cancelled&quot;] sort by Stop_Sequence asc;\n\n\t\tpickupTotal = pickupTasks.count(ID);\n\t\tdeliveryTotal = deliveryTasks.count(ID);\n\t\tpickupCompleted = Pickup_Run_Sheet_Items[Pickup_Run_Sheet.Assigned_Agent == agentId &amp;&amp; Pickup_Run_Sheet.Run_Date == zoho.currentdate &amp;&amp; Stop_Status == &quot;Picked Up&quot;].count(ID);\n\t\tdeliveryCompleted = Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Assigned_Agent == agentId &amp;&amp; Delivery_Run_Sheet.Run_Date == zoho.currentdate &amp;&amp; Delivery_Status == &quot;Delivered&quot;].count(ID);\n\t\tpickupRemaining = Pickup_Run_Sheet_Items[Pickup_Run_Sheet.Assigned_Agent == agentId &amp;&amp; Pickup_Run_Sheet.Run_Date == zoho.currentdate &amp;&amp; (Stop_Status == &quot;Assigned&quot; || Stop_Status == &quot;Arrived&quot;)].count(ID);\n\t\tdeliveryRemaining = Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Assigned_Agent == agentId &amp;&amp; Delivery_Run_Sheet.Run_Date == zoho.currentdate &amp;&amp; (Delivery_Status == &quot;Assigned&quot; || Delivery_Status == &quot;Out For Delivery&quot;)].count(ID);\n\t\tpickupFailed = Pickup_Run_Sheet_Items[Pickup_Run_Sheet.Assigned_Agent == agentId &amp;&amp; Pickup_Run_Sheet.Run_Date == zoho.currentdate &amp;&amp; Stop_Status == &quot;Failed&quot;].count(ID);\n\t\tdeliveryFailed = Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Assigned_Agent == agentId &amp;&amp; Delivery_Run_Sheet.Run_Date == zoho.currentdate &amp;&amp; Delivery_Status == &quot;Failed&quot;].count(ID);\n\t\tpickupFailedNotes = Pickup_Run_Sheet_Items[Pickup_Run_Sheet.Assigned_Agent == agentId &amp;&amp; Pickup_Run_Sheet.Run_Date == zoho.currentdate &amp;&amp; Stop_Status == &quot;Failed&quot; &amp;&amp; (Failure_Reason == null || Failure_Reason == &quot;&quot;)].count(ID);\n\t\tdeliveryFailedNotes = Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Assigned_Agent == agentId &amp;&amp; Delivery_Run_Sheet.Run_Date == zoho.currentdate &amp;&amp; Delivery_Status == &quot;Failed&quot; &amp;&amp; (NDR_Notes == null || NDR_Notes == &quot;&quot;)].count(ID);\n\t\ttotalCompleted = pickupCompleted + deliveryCompleted;\n\t\ttotalRemaining = pickupRemaining + deliveryRemaining;\n\t\ttotalTasks = pickupTotal + deliveryTotal;\n\t\tcompletionPercent = 0;\n\t\tif(totalTasks &gt; 0)\n\t\t{\n\t\t\t\tcompletionPercent = ((totalCompleted * 100.0) / totalTasks).round(0);\n\t\t\t\tif(completionPercent &gt; 100)\n\t\t\t\t{\n\t\t\t\t\t\tcompletionPercent = 100;\n\t\t\t\t}\n\t\t}\n\n\t\tvehicleNames = List();\n\t\tplannedLoad = 0.0;\n\t\tfor each pickupRun in pickupRuns\n\t\t{\n\t\t\t\tplannedLoad = plannedLoad + ifnull(pickupRun.Total_Planned_Weight_Kg,0);\n\t\t\t\tif(pickupRun.Vehicle != null &amp;&amp; !vehicleNames.contains(pickupRun.Vehicle.Vehicle_Number))\n\t\t\t\t{\n\t\t\t\t\t\tvehicleNames.add(pickupRun.Vehicle.Vehicle_Number);\n\t\t\t\t}\n\t\t}\n\t\tfor each deliveryRun in deliveryRuns\n\t\t{\n\t\t\t\tif(deliveryRun.Vehicle != null &amp;&amp; !vehicleNames.contains(deliveryRun.Vehicle.Vehicle_Number))\n\t\t\t\t{\n\t\t\t\t\t\tvehicleNames.add(deliveryRun.Vehicle.Vehicle_Number);\n\t\t\t\t}\n\t\t}\n\t\tfor each deliveryLoadItem in deliveryTasks\n\t\t{\n\t\t\t\tplannedLoad = plannedLoad + ifnull(deliveryLoadItem.Shipment.Billable_Weight_Kg,0);\n\t\t}\n\t\tvehicleLabel = &quot;Not assigned&quot;;\n\t\tif(vehicleNames.size() &gt; 0)\n\t\t{\n\t\t\t\tvehicleLabel = vehicleNames.toString(&quot;, &quot;);\n\t\t}\n\t\tmaxLoad = ifnull(agent.Maximum_Daily_Load_Kg,0);\n\t\tloadPercent = 0;\n\t\tif(maxLoad &gt; 0)\n\t\t{\n\t\t\t\tloadPercent = ((plannedLoad / maxLoad) * 100).round(0);\n\t\t\t\tif(loadPercent &gt; 100)\n\t\t\t\t{\n\t\t\t\t\t\tloadPercent = 100;\n\t\t\t\t}\n\t\t}\n\n\t\tcodCollected = ifnull(Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Assigned_Agent == agentId &amp;&amp; Delivery_Run_Sheet.Run_Date == zoho.currentdate &amp;&amp; Delivery_Status == &quot;Delivered&quot;].sum(COD_Collected),0);\n\t\tremittances = COD_Remittances[Agent == agentId &amp;&amp; Remittance_Date == zoho.currentdate];\n\t\tremittanceStatus = &quot;Not generated&quot;;\n\t\tremittanceClass = &quot;zcs-badge-grey&quot;;\n\t\tremittanceExpected = 0;\n\t\tremittanceSubmitted = 0;\n\t\thasShortfall = false;\n\t\tallConfirmed = true;\n\t\tfor each remittance in remittances\n\t\t{\n\t\t\t\tremittanceExpected = remittanceExpected + ifnull(remittance.Expected_Amount,0);\n\t\t\t\tremittanceSubmitted = remittanceSubmitted + ifnull(remittance.Submitted_Amount,0);\n\t\t\t\tif(remittance.Remittance_Status == &quot;Shortfall&quot;)\n\t\t\t\t{\n\t\t\t\t\t\thasShortfall = true;\n\t\t\t\t}\n\t\t\t\tif(remittance.Remittance_Status != &quot;Confirmed&quot;)\n\t\t\t\t{\n\t\t\t\t\t\tallConfirmed = false;\n\t\t\t\t}\n\t\t}\n\t\tif(remittances.count(ID) &gt; 0)\n\t\t{\n\t\t\t\tif(hasShortfall)\n\t\t\t\t{\n\t\t\t\t\t\tremittanceStatus = &quot;Shortfall&quot;;\n\t\t\t\t\t\tremittanceClass = &quot;zcs-badge-red&quot;;\n\t\t\t\t}\n\t\t\t\telse if(allConfirmed)\n\t\t\t\t{\n\t\t\t\t\t\tremittanceStatus = &quot;Confirmed&quot;;\n\t\t\t\t\t\tremittanceClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\t\tremittanceStatus = &quot;Pending&quot;;\n\t\t\t\t\t\tremittanceClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t}\n\t\t}\n%&gt;\n&lt;style&gt;\n/* zcs-global utility sheet, included once for Agent_Dashboard. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#f3f3f4;--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_teritiary_text_color);font-size:16px;line-height:1.5}.zcs-flex,.zcs-row{display:flex}.zcs-row{flex-wrap:wrap}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-row-wrap{flex-wrap:wrap}.zcs-no-shrink{flex-shrink:0}.zcs-col-common{flex:1 1 0}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-half{border-radius:50%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-color-green{color:#179e6c}.zcs-color-red{color:#fe455d}.zcs-color-yellow{color:#b8770d}.zcs-text-center{text-align:center}.zcs-text-left{text-align:left}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-list-none{list-style:none}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}\n/* ZCS component CSS: card-fleets-driver-info-3-btns, card-fleet-trip-summary-card, card-fleets-performance-metrics, badge-filled-badge, button-full-size-button, no-data-no-data-text-only, banner-status-banner. */\n.zcs-button{width:auto;min-width:5rem;min-height:48px}.zcs-fw-button{width:100%}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color);border:1px solid var(--zcs_brand_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-icon{width:18px;max-height:18px}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-theme{background:var(--zcs_brand_color);color:#fff}.zcs-badge-green{background:#179e6c;color:#fff}.zcs-badge-red{background:#fe455d;color:#fff}.zcs-badge-grey{background:#242424;color:#fff}.zcs-badge-yellow{background:#faae13;color:#fff}.zcs-badge-blue{background:#2a6ffc;color:#fff}.zcs-badge-orange{background:#f4660c;color:#fff}.zcs-success-toast{background:#edf7ed;color:#1d4620}.zcs-info-toast{background:#e4f6fd;color:#024361}.zcs-warning-toast{background:#fef4e5;color:#663c01}.zcs-error-toast{background:#feedec;color:#5f2120}\n.agent-dashboard{background:var(--zcs-page-bg-color);min-height:100%;padding:16px;font-family:Arial,sans-serif}.agent-shell{max-width:1180px;margin:0 auto}.agent-header{background:linear-gradient(120deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));color:var(--zcs_brand_foreground_color);border-radius:16px}.agent-header .zcs-color-primary,.agent-header .zcs-color-secondary,.agent-header .zcs-color-tertiary{color:inherit}.agent-avatar{width:52px;height:52px;background:var(--zcs_brand_foreground_color);color:var(--zcs_brand_color);font-size:24px}.summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.summary-card{min-height:112px}.summary-icon{width:38px;height:38px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:18px}.dashboard-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(280px,1fr);gap:16px}.task-card{border-left:4px solid var(--zcs_brand_color)}.task-card.delivery{border-left-color:#179e6c}.task-top{border-bottom:1px solid var(--zcs_tertiary_border_color);padding-bottom:10px}.sequence{width:38px;height:38px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-weight:700}.task-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}.task-address{min-height:42px}.section-title{border-bottom:1px solid var(--zcs_tertiary_border_color);padding-bottom:10px}.metric-list li:not(:last-child){border-bottom:1px solid var(--zcs_tertiary_border_color);padding-bottom:12px}.sticky-side{position:sticky;top:12px}.security-card{border-left:4px solid #fe455d}.empty-state{min-height:120px}.location-line{word-break:break-word}.compact-progress{min-width:150px}.touch-report{min-height:52px}.failed-link{text-decoration:underline}.meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 14px}.payment-cod{color:#663c01}\n@media(max-width:900px){.summary-grid{grid-template-columns:repeat(2,1fr)}.dashboard-grid{grid-template-columns:1fr}.sticky-side{position:static}}\n@media(max-width:576px){.agent-dashboard{padding:10px}.agent-header{padding:16px}.agent-header-main{align-items:flex-start}.summary-grid{grid-template-columns:repeat(2,1fr);gap:8px}.summary-card{padding:12px;min-height:104px}.task-card{padding:14px}.task-actions{grid-template-columns:1fr}.zcs-button{min-height:50px}.meta-grid{grid-template-columns:1fr}.hide-phone{display:none}.agent-name{font-size:1.25rem}.compact-progress{width:100%}}\n&lt;/style&gt;\n&lt;div class=&apos;agent-dashboard zcs-box-border&apos;&gt;\n\t&lt;div class=&apos;agent-shell zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n\t\t&lt;div class=&apos;agent-header zcs-flex zcs-direction-column zcs-gap-16 zcs-p-24 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;agent-header-main zcs-flex zcs-align-items-center zcs-justify-space-between zcs-row-wrap zcs-gap-16&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 zcs-col-common&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;agent-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-no-shrink&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-05&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-col-common zcs-ellipsis&apos;&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-m-0&apos;&gt;Field day view · &lt;%=zoho.currentdate%&gt;&lt;/p&gt;\n\t\t\t\t\t\t&lt;h2 class=&apos;agent-name zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-m-0&apos;&gt;&lt;%=agent.Employee_Name%&gt;&lt;/h2&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-m-0&apos;&gt;&lt;%=if(isDeputed,&quot;Deputed hub&quot;,&quot;Home hub&quot;)%&gt;: &lt;%=hubName%&gt; · Role: &lt;%=ifnull(agent.Agent_Role,&quot;Not Applicable&quot;)%&gt;&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;compact-progress zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=completionPercent%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-m-0&apos;&gt;&lt;strong&gt;&lt;%=completionPercent%&gt;%&lt;/strong&gt; of assigned stops completed&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-row-wrap zcs-font-13&apos;&gt;\n\t\t\t\t&lt;span&gt;&lt;i class=&apos;zc-li-outline transport-car-simple zcs-mt-4&apos;&gt;&lt;/i&gt; &lt;%=ifnull(agent.Vehicle_Type,&quot;Vehicle not specified&quot;)%&gt;: &lt;%=vehicleLabel%&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;hide-phone&apos;&gt;·&lt;/span&gt;\n\t\t\t\t&lt;span&gt;&lt;i class=&apos;zc-li-outline location-pin-copy&apos;&gt;&lt;/i&gt; Last location: &lt;%=ifnull(agent.Last_Location_At,&quot;Not updated&quot;)%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;% if(pickupFailedNotes + deliveryFailedNotes &gt; 0) { %&gt;\n\t\t&lt;div class=&apos;zcs-warning-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14&apos;&gt;\n\t\t\t&lt;i class=&apos;zcs-no-shrink zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;div&gt;&lt;strong&gt;Notes required:&lt;/strong&gt; &lt;%=pickupFailedNotes + deliveryFailedNotes%&gt; failed task(s) still need failure notes. Open the affected task before ending the shift.&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;% } %&gt;\n\n\t\t&lt;div class=&apos;summary-grid&apos;&gt;\n\t\t\t&lt;div class=&apos;summary-card zcs-card zcs-flex zcs-direction-column zcs-gap-8 zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;summary-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div&gt;&lt;span class=&apos;zcs-font-24 zcs-font-bold zcs-color-primary&apos;&gt;&lt;%=totalCompleted%&gt;&lt;/span&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Completed stops&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;summary-card zcs-card zcs-flex zcs-direction-column zcs-gap-8 zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;summary-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div&gt;&lt;span class=&apos;zcs-font-24 zcs-font-bold zcs-color-primary&apos;&gt;&lt;%=totalRemaining%&gt;&lt;/span&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Remaining stops&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;summary-card zcs-card zcs-flex zcs-direction-column zcs-gap-8 zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;summary-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline finance-money-coins&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div&gt;&lt;span class=&apos;zcs-font-22 zcs-font-bold zcs-color-primary&apos;&gt;₹&lt;%=codCollected%&gt;&lt;/span&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;COD collected&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;summary-card zcs-card zcs-flex zcs-direction-column zcs-gap-8 zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;summary-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div&gt;&lt;span class=&apos;zcs-font-24 zcs-font-bold zcs-color-primary&apos;&gt;&lt;%=pickupTotal%&gt; / &lt;%=deliveryTotal%&gt;&lt;/span&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Pickup / delivery&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;dashboard-grid&apos;&gt;\n\t\t\t&lt;main class=&apos;zcs-flex zcs-direction-column zcs-gap-20&apos;&gt;\n\t\t\t\t&lt;section class=&apos;zcs-flex zcs-direction-column zcs-gap-12&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;section-title zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Today&apos;s pickup stops&lt;/h3&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;&lt;%=pickupCompleted%&gt; completed · &lt;%=pickupRemaining%&gt; remaining · &lt;%=pickupFailed%&gt; failed&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-font-13 zcs-color-theme&apos; href=&apos;#Report:My_Pickup_Tasks&apos;&gt;View report&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% if(pickupTotal == 0) { %&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-card zcs-nodata-wrapper empty-state zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast zcs-font-24 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-8 zcs-mb-0&apos;&gt;No pickup stops assigned today&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% } else { for each pickupTask in pickupTasks {\n\t\t\t\t\t\t\tpickupStatus = ifnull(pickupTask.Stop_Status,&quot;Assigned&quot;);\n\t\t\t\t\t\t\tpickupBadge = &quot;zcs-badge-blue&quot;;\n\t\t\t\t\t\t\tif(pickupStatus == &quot;Picked Up&quot;) { pickupBadge = &quot;zcs-badge-green&quot;; }\n\t\t\t\t\t\t\telse if(pickupStatus == &quot;Failed&quot;) { pickupBadge = &quot;zcs-badge-red&quot;; }\n\t\t\t\t\t\t\telse if(pickupStatus == &quot;Cancelled&quot;) { pickupBadge = &quot;zcs-badge-grey&quot;; }\n\t\t\t\t\t\t\telse if(pickupStatus == &quot;Arrived&quot;) { pickupBadge = &quot;zcs-badge-orange&quot;; }\n\t\t\t\t\t\t\tpickupAddress = ifnull(pickupTask.Shipment.Pickup_Address.address_line_1,&quot;&quot;);\n\t\t\t\t\t\t\tpickupCity = ifnull(pickupTask.Shipment.Pickup_Address.district_city,&quot;&quot;);\n\t\t\t\t\t\t\tpickupLat = pickupTask.Shipment.Pickup_Address.latitude;\n\t\t\t\t\t\t\tpickupLon = pickupTask.Shipment.Pickup_Address.longitude;\n\t\t\t\t\t\t\tpickupDestination = encodeURL(ifnull(pickupTask.Shipment.Pickup_Pincode,&quot;&quot;));\n\t\t\t\t\t\t\tif(pickupLat != null &amp;&amp; pickupLon != null) { pickupDestination = pickupLat + &quot;,&quot; + pickupLon; }\n\t\t\t\t\t\t\tpickupMapUrl = &quot;https://www.google.com/maps/dir/?api=1&amp;amp;destination=&quot; + pickupDestination;\n\t\t\t\t\t\t\tpickupOpenUrl = &quot;#Report:My_Pickup_Tasks?ID=&quot; + pickupTask.ID + &quot;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;;\n\t\t\t\t\t\t\tpickupActionLabel = if(pickupStatus == &quot;Arrived&quot;,&quot;Complete pickup&quot;,&quot;Open pickup&quot;);\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;article class=&apos;task-card zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;task-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-10&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10 zcs-col-common zcs-ellipsis&apos;&gt;&lt;div class=&apos;sequence zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-no-shrink&apos;&gt;&lt;%=pickupTask.Stop_Sequence%&gt;&lt;/div&gt;&lt;div class=&apos;zcs-col-common zcs-ellipsis&apos;&gt;&lt;strong class=&apos;zcs-font-15 zcs-color-primary&apos;&gt;AWB &lt;%=pickupTask.Shipment.AWB_Number%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-ellipsis&apos;&gt;&lt;%=pickupTask.Shipment.Sender_Name%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=pickupBadge%&gt;&apos;&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;&lt;%=pickupStatus%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;task-address zcs-flex zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline location-pin-copy zcs-color-theme zcs-mt-4&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-primary zcs-m-0&apos;&gt;&lt;%=pickupAddress%&gt;&lt;%=if(pickupAddress != &quot;&quot; &amp;&amp; pickupCity != &quot;&quot;,&quot;, &quot;,&quot;&quot;)%&gt;&lt;%=pickupCity%&gt;&lt;/p&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Pincode &lt;%=pickupTask.Shipment.Pickup_Pincode%&gt; · &lt;%=ifnull(pickupTask.Shipment.Package_Count,1)%&gt; package(s)&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-row-wrap&apos;&gt;&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-badge-theme&apos;&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;OTP / signature proof&lt;/span&gt;&lt;/div&gt;&lt;% if(pickupStatus == &quot;Failed&quot; &amp;&amp; (pickupTask.Failure_Reason == null || pickupTask.Failure_Reason == &quot;&quot;)) { %&gt;&lt;span class=&apos;zcs-font-12 zcs-color-red&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt; Failure note required&lt;/span&gt;&lt;% } %&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;task-actions&apos;&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-10 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;&lt;%=pickupMapUrl%&gt;&apos; target=&apos;_blank&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline location-pin-copy&apos;&gt;&lt;/i&gt;&lt;span&gt;Navigate&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-10 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;&lt;%=pickupOpenUrl%&gt;&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=pickupActionLabel%&gt;&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/article&gt;\n\t\t\t\t\t&lt;% } } %&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&apos;zcs-flex zcs-direction-column zcs-gap-12&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;section-title zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Today&apos;s delivery stops&lt;/h3&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;&lt;%=deliveryCompleted%&gt; delivered · &lt;%=deliveryRemaining%&gt; remaining · &lt;%=deliveryFailed%&gt; failed&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-font-13 zcs-color-theme&apos; href=&apos;#Report:My_Delivery_Tasks&apos;&gt;View report&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% if(deliveryTotal == 0) { %&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-card zcs-nodata-wrapper empty-state zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;i class=&apos;zc-li-outline location-pin-copy zcs-font-24 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-8 zcs-mb-0&apos;&gt;No delivery stops assigned today&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% } else { for each deliveryTask in deliveryTasks {\n\t\t\t\t\t\t\tdeliveryStatus = ifnull(deliveryTask.Delivery_Status,&quot;Assigned&quot;);\n\t\t\t\t\t\t\tdeliveryBadge = &quot;zcs-badge-blue&quot;;\n\t\t\t\t\t\t\tif(deliveryStatus == &quot;Delivered&quot;) { deliveryBadge = &quot;zcs-badge-green&quot;; }\n\t\t\t\t\t\t\telse if(deliveryStatus == &quot;Failed&quot; || deliveryStatus == &quot;RTO&quot;) { deliveryBadge = &quot;zcs-badge-red&quot;; }\n\t\t\t\t\t\t\tdeliveryAddress = ifnull(deliveryTask.Shipment.Delivery_Address.address_line_1,&quot;&quot;);\n\t\t\t\t\t\t\tdeliveryCity = ifnull(deliveryTask.Shipment.Delivery_Address.district_city,&quot;&quot;);\n\t\t\t\t\t\t\tdeliveryLat = deliveryTask.Shipment.Delivery_Address.latitude;\n\t\t\t\t\t\t\tdeliveryLon = deliveryTask.Shipment.Delivery_Address.longitude;\n\t\t\t\t\t\t\tdeliveryDestination = encodeURL(ifnull(deliveryTask.Shipment.Delivery_Pincode,&quot;&quot;));\n\t\t\t\t\t\t\tif(deliveryLat != null &amp;&amp; deliveryLon != null) { deliveryDestination = deliveryLat + &quot;,&quot; + deliveryLon; }\n\t\t\t\t\t\t\tdeliveryMapUrl = &quot;https://www.google.com/maps/dir/?api=1&amp;amp;destination=&quot; + deliveryDestination;\n\t\t\t\t\t\t\tdeliveryOpenUrl = &quot;#Report:My_Delivery_Tasks?ID=&quot; + deliveryTask.ID + &quot;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;;\n\t\t\t\t\t\t\tpaymentLabel = ifnull(deliveryTask.Shipment.Payment_Type,&quot;Not specified&quot;);\n\t\t\t\t\t\t\tpaymentBadge = &quot;zcs-badge-theme&quot;;\n\t\t\t\t\t\t\tif(paymentLabel == &quot;COD&quot;) { paymentLabel = &quot;COD ₹&quot; + ifnull(deliveryTask.Shipment.COD_Amount,0); paymentBadge = &quot;zcs-badge-yellow&quot;; }\n\t\t\t\t\t\t\telse if(paymentLabel == &quot;Prepaid&quot;) { paymentBadge = &quot;zcs-badge-green&quot;; }\n\t\t\t\t\t\t\tproofLabel = ifnull(deliveryTask.Proof_Type,&quot;Proof required&quot;);\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;article class=&apos;task-card delivery zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;task-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-10&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10 zcs-col-common zcs-ellipsis&apos;&gt;&lt;div class=&apos;sequence zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-no-shrink&apos;&gt;&lt;%=deliveryTask.Stop_Sequence%&gt;&lt;/div&gt;&lt;div class=&apos;zcs-col-common zcs-ellipsis&apos;&gt;&lt;strong class=&apos;zcs-font-15 zcs-color-primary&apos;&gt;AWB &lt;%=deliveryTask.Shipment.AWB_Number%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-ellipsis&apos;&gt;&lt;%=deliveryTask.Shipment.Recipient_Name%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=deliveryBadge%&gt;&apos;&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;&lt;%=deliveryStatus%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;task-address zcs-flex zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline location-pin-copy zcs-color-green zcs-mt-4&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-primary zcs-m-0&apos;&gt;&lt;%=deliveryAddress%&gt;&lt;%=if(deliveryAddress != &quot;&quot; &amp;&amp; deliveryCity != &quot;&quot;,&quot;, &quot;,&quot;&quot;)%&gt;&lt;%=deliveryCity%&gt;&lt;/p&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Pincode &lt;%=deliveryTask.Shipment.Delivery_Pincode%&gt; · Attempt &lt;%=ifnull(deliveryTask.Attempt_Number,1)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-row-wrap&apos;&gt;&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=paymentBadge%&gt;&apos;&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;&lt;%=paymentLabel%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-badge-theme&apos;&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;&lt;%=proofLabel%&gt;&lt;/span&gt;&lt;/div&gt;&lt;% if(deliveryStatus == &quot;Failed&quot; &amp;&amp; (deliveryTask.NDR_Notes == null || deliveryTask.NDR_Notes == &quot;&quot;)) { %&gt;&lt;span class=&apos;zcs-font-12 zcs-color-red&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt; NDR note required&lt;/span&gt;&lt;% } %&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;task-actions&apos;&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-10 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;&lt;%=deliveryMapUrl%&gt;&apos; target=&apos;_blank&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline location-pin-copy&apos;&gt;&lt;/i&gt;&lt;span&gt;Navigate&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-10 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;&lt;%=deliveryOpenUrl%&gt;&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;Deliver / update&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/article&gt;\n\t\t\t\t\t&lt;% } } %&gt;\n\t\t\t\t&lt;/section&gt;\n\t\t\t&lt;/main&gt;\n\n\t\t\t&lt;aside class=&apos;zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n\t\t\t\t&lt;div class=&apos;sticky-side zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Vehicle and load&lt;/h3&gt;\n\t\t\t\t\t\t&lt;ul class=&apos;metric-list zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0 zcs-list-none&apos;&gt;\n\t\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Vehicle&lt;/span&gt;&lt;strong class=&apos;zcs-font-13 zcs-color-primary zcs-text-left&apos;&gt;&lt;%=vehicleLabel%&gt;&lt;/strong&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Vehicle type&lt;/span&gt;&lt;strong class=&apos;zcs-font-13 zcs-color-primary&apos;&gt;&lt;%=ifnull(agent.Vehicle_Type,&quot;Not set&quot;)%&gt;&lt;/strong&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Planned load&lt;/span&gt;&lt;strong class=&apos;zcs-font-13 zcs-color-primary&apos;&gt;&lt;%=plannedLoad.round(2)%&gt; kg&lt;/strong&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t&lt;li class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;&lt;p class=&apos;zcs-flex zcs-justify-space-between zcs-font-13 zcs-m-0&apos;&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;Daily load limit&lt;/span&gt;&lt;span class=&apos;zcs-color-primary&apos;&gt;&lt;%=if(maxLoad &gt; 0,maxLoad + &quot; kg&quot;,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/p&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=loadPercent%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;COD remittance&lt;/h3&gt;&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=remittanceClass%&gt;&apos;&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;&lt;%=remittanceStatus%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;meta-grid&apos;&gt;&lt;div&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;Collected&lt;/p&gt;&lt;strong class=&apos;zcs-font-20 zcs-color-primary&apos;&gt;₹&lt;%=codCollected%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;Submitted&lt;/p&gt;&lt;strong class=&apos;zcs-font-20 zcs-color-primary&apos;&gt;₹&lt;%=remittanceSubmitted%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Expected remittance: ₹&lt;%=remittanceExpected%&gt;. Cash confirmation is handled by the authorized hub or finance user.&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Location status&lt;/h3&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-10&apos;&gt;&lt;i class=&apos;zc-li-outline location-pin-copy zcs-color-theme zcs-mt-4&apos;&gt;&lt;/i&gt;&lt;div class=&apos;location-line&apos;&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Last update&lt;/p&gt;&lt;strong class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=ifnull(agent.Last_Location_At,&quot;Not updated&quot;)%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;&lt;%=if(agent.Current_Latitude != null &amp;&amp; agent.Current_Longitude != null,agent.Current_Latitude + &quot;, &quot; + agent.Current_Longitude,&quot;Coordinates unavailable&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;% if(agent.Current_Latitude != null &amp;&amp; agent.Current_Longitude != null) { currentMapUrl = &quot;https://www.google.com/maps/search/?api=1&amp;amp;query=&quot; + agent.Current_Latitude + &quot;,&quot; + agent.Current_Longitude; %&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-fw-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-10 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;&lt;%=currentMapUrl%&gt;&apos; target=&apos;_blank&apos;&gt;&lt;i class=&apos;zc-li-outline location-pin-copy&apos;&gt;&lt;/i&gt;&lt;span&gt;View last location&lt;/span&gt;&lt;/a&gt;&lt;% } %&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;% if(pickupFailed + deliveryFailed &gt; 0) { %&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-error-toast zcs-flex zcs-direction-column zcs-gap-10 zcs-p-16 zcs-rounded-sm zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt;&lt;strong class=&apos;zcs-font-14&apos;&gt;Failed tasks: &lt;%=pickupFailed + deliveryFailed%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-m-0&apos;&gt;Every failed pickup needs a failure reason. Every failed delivery needs an NDR reason and notes.&lt;/p&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-12 zcs-row-wrap&apos;&gt;&lt;% if(pickupFailed &gt; 0) { %&gt;&lt;a class=&apos;failed-link zcs-font-13&apos; href=&apos;#Report:My_Pickup_Tasks&apos;&gt;Pickup failures&lt;/a&gt;&lt;% } %&gt;&lt;% if(deliveryFailed &gt; 0) { %&gt;&lt;a class=&apos;failed-link zcs-font-13&apos; href=&apos;#Report:My_Delivery_Tasks&apos;&gt;Delivery failures&lt;/a&gt;&lt;% } %&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/aside&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;% } else { %&gt;\n&lt;style&gt;\n:root{--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-white-color:#fff}.zcs-flex{display:flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-gap-8{gap:.5rem}.zcs-p-24{padding:1.5rem}.zcs-box-border{box-sizing:border-box}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-24{font-size:1.5rem}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-red{color:#fe455d}.zcs-m-0{margin:0}.security-wrap{min-height:360px;background:#f3f3f4;padding:16px}.security-card{max-width:560px;border-left:4px solid #fe455d;text-align:center}\n&lt;/style&gt;\n&lt;div class=&apos;security-wrap zcs-flex zcs-align-items-center zcs-justify-center zcs-box-border&apos;&gt;&lt;div class=&apos;security-card zcs-card zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-8 zcs-p-24 zcs-box-border&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-05 zcs-font-24 zcs-color-red&apos;&gt;&lt;/i&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;&lt;%=if(!isAllowed,&quot;Access restricted&quot;,&quot;Agent profile not found&quot;)%&gt;&lt;/h2&gt;&lt;p class=&apos;zcs-font-14 zcs-color-primary zcs-m-0&apos;&gt;&lt;%=if(!isAllowed,&quot;This page is limited to Field Agent and support administrator profiles.&quot;,&quot;No active Operations Users record matches the current login email. No task data has been loaded.&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% } %&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Customer_Dashboard
		{
					displayname = "Customer Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Customer_Dashboard_Snippet' elementName='Customer_Dashboard_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Customer_Dashboard_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t\t&lt;%\ncustomer_rows = Customers[Portal_Login_Email == zoho.loginuserid];\ncustomer_found = customer_rows.count(ID) &gt; 0;\nif(customer_found)\n{\n\t\tcustomer = customer_rows;\n\t\tcustomer_id = customer.ID;\n\t\tkyc_total = Customer_KYC_Documents[Customer == customer_id &amp;&amp; Required_For_Onboarding == true].count(ID);\n\t\tkyc_verified = Customer_KYC_Documents[Customer == customer_id &amp;&amp; Required_For_Onboarding == true &amp;&amp; Review_Status == &quot;Verified&quot;].count(ID);\n\t\texpiring_points = ifnull(Loyalty_Transactions[Customer == customer_id &amp;&amp; Customer_Login_Email == zoho.loginuserid &amp;&amp; Points_Status == &quot;Available&quot; &amp;&amp; Expiry_Date &gt;= zoho.currentdate &amp;&amp; Expiry_Date &lt;= zoho.currentdate.addDay(30)].sum(Points),0);\n\t\tactive_shipments = Shipment_Requests[Customer == customer_id &amp;&amp; Shipment_Status != &quot;Delivered&quot; &amp;&amp; Shipment_Status != &quot;Cancelled&quot; &amp;&amp; Shipment_Status != &quot;Return to Origin&quot;] sort by Booked_On desc;\n\t\tdelivered_shipments = Shipment_Requests[Customer == customer_id &amp;&amp; Shipment_Status == &quot;Delivered&quot;] sort by Booked_On desc;\n\t\topen_invoices = Invoices[Customer == customer_id &amp;&amp; Invoice_Status != &quot;Paid&quot; &amp;&amp; Invoice_Status != &quot;Void&quot; &amp;&amp; Invoice_Status != &quot;Draft&quot;] sort by Due_Date asc;\n\t\topen_invoice_total = ifnull(Invoices[Customer == customer_id &amp;&amp; Invoice_Status != &quot;Paid&quot; &amp;&amp; Invoice_Status != &quot;Void&quot; &amp;&amp; Invoice_Status != &quot;Draft&quot;].sum(Invoice_Total),0);\n\t\topen_ledger_count = Account_Ledger[Customer == customer_id &amp;&amp; Customer_Login_Email == zoho.loginuserid &amp;&amp; Ledger_Status != &quot;Settled&quot;].count(ID);\n\t\tcurrent_points = ifnull(customer.Current_Loyalty_Points,0);\n\t\tlifetime_points = ifnull(customer.Lifetime_Loyalty_Points,0);\n\t\tcustomer_type = ifnull(customer.Customer_Type,&quot;Retail&quot;);\n\t\tonboarding_status = ifnull(customer.Onboarding_Status,&quot;Registration Pending&quot;);\n\t\tprofile_badge = &quot;zcs-badge-yellow&quot;;\n\t\tif(onboarding_status == &quot;Active&quot;)\n\t\t{\n\t\t\t\tprofile_badge = &quot;zcs-badge-green&quot;;\n\t\t}\n\t\telse if(onboarding_status == &quot;Action Required&quot; || onboarding_status == &quot;KYC Expired&quot; || onboarding_status == &quot;Suspended&quot;)\n\t\t{\n\t\t\t\tprofile_badge = &quot;zcs-badge-red&quot;;\n\t\t}\n\t\ttier_name = ifnull(customer.Current_Loyalty_Tier,&quot;None&quot;);\n\t\tquarter_spend = ifnull(customer.Quarterly_Eligible_Spend,0);\n\t\tnext_tier_name = &quot;Top tier&quot;;\n\t\tnext_tier_min = 0;\n\t\tfor each tier in Loyalty_Tiers[Active == true &amp;&amp; (Applies_To == customer_type || Applies_To == &quot;Both&quot; || Applies_To == &quot;All&quot;)] sort by Minimum_Quarterly_Spend asc\n\t\t{\n\t\t\t\tif(next_tier_min == 0 &amp;&amp; tier.Minimum_Quarterly_Spend &gt; quarter_spend)\n\t\t\t\t{\n\t\t\t\t\t\tnext_tier_min = tier.Minimum_Quarterly_Spend;\n\t\t\t\t\t\tnext_tier_name = tier.Tier_Name;\n\t\t\t\t}\n\t\t}\n\t\ttier_progress = 100;\n\t\tspend_remaining = 0;\n\t\tif(next_tier_min &gt; 0)\n\t\t{\n\t\t\t\ttier_progress = ((quarter_spend / next_tier_min) * 100).round(0);\n\t\t\t\tif(tier_progress &gt; 100)\n\t\t\t\t{\n\t\t\t\t\t\ttier_progress = 100;\n\t\t\t\t}\n\t\t\t\tspend_remaining = next_tier_min - quarter_spend;\n\t\t}\n%&gt;\n&lt;style&gt;\n/* zcs-global.css: page-scoped essentials from zcs-global */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#F3F3F4;--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-row-wrap{flex-wrap:wrap}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:.625rem}.zcs-mb-0{margin-bottom:0}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.zcs-list-none{list-style:none}.zcs-relative{position:relative}.zcs-cursor-pointer{cursor:pointer}a{text-decoration:none}\n/* ZCS component CSS: layout-dashboard, header-heading-with-actions, card-profile-card, card-fleets-performance-metrics, progress-bar-range-bar-with-texts, quick-actions-card-type-quick-actions, badge-filled-badge, table-simple-table */\n.zcs-page-container{background:var(--zcs-page-bg-color);min-height:100%;font-family:Arial,sans-serif}.zcs-page-container-inner{max-width:1440px;margin:0 auto}.zcs-page-header{background:linear-gradient(125deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));border-radius:12px;color:var(--zcs_brand_foreground_color)}.zcs-page-header .zcs-color-primary,.zcs-page-header .zcs-color-tertiary{color:var(--zcs_brand_foreground_color)}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-page-header .zcs-primary-button{background:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-button:hover{filter:brightness(.97)}.zcs-panel{border:1px solid var(--zcs_tertiary_border_color);box-shadow:0 2px 8px #f2f2f6;background:var(--zcs-white-color)}.zcs-panel-icon-wrapper{width:40px;height:40px}.zcs-panel-icon{width:24px;height:24px;line-height:24px}.zcs-panel-green .zcs-panel-icon-wrapper{background:#E4FCF3;color:#179E6C}.zcs-panel-blue .zcs-panel-icon-wrapper{background:#E8EFFF;color:#2A6FFC}.zcs-panel-violet .zcs-panel-icon-wrapper{background:#f6f6fb;color:#5c66ff}.zcs-panel-orange .zcs-panel-icon-wrapper{background:#F8F0EB;color:#F4660C}.zcs-avatar{width:60px;height:60px;background:var(--zcs_brand_color);border-radius:12px;color:var(--zcs_brand_foreground_color)}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}.zcs-quick-action-item{list-style:none}.zcs-quick-action-item:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-theme{background:var(--zcs_brand_color);color:#fff}.zcs-badge-green{background:#179E6C;color:#fff}.zcs-badge-red{background:#FE455D;color:#fff}.zcs-badge-yellow{background:#FAAE13;color:#fff}.zcs-badge-blue{background:#2A6FFC;color:#fff}.zcs-badge-orange{background:#F4660C;color:#fff}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper th{background:#F9FAFE;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tbody tr:hover td{background:#F9FAFE}.dashboard-grid{display:grid;grid-template-columns:2fr 1fr;gap:20px}.kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.shipment-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.section-header{padding-bottom:12px;border-bottom:1px solid var(--zcs_tertiary_border_color)}.shipment-card{transition:border-color .2s}.shipment-card:hover{border-color:var(--zcs_brand_color)}.route-line{height:1px;background:var(--zcs_tertiary_border_color);flex:1}.amount{font-variant-numeric:tabular-nums}.empty-state{min-height:110px}.invoice-row{border-bottom:1px solid var(--zcs_tertiary_border_color)}.invoice-row:last-child{border-bottom:0}.support-note{opacity:.85}@media(max-width:992px){.dashboard-grid{grid-template-columns:1fr}.kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.shipment-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:576px){.zcs-page-container-inner{padding:16px 20px}.zcs-page-header{align-items:flex-start;flex-direction:column}.kpi-grid,.shipment-grid{grid-template-columns:1fr}.zcs-page-header .zcs-button{width:100%}.zcs-table-wrapper table{min-width:680px}}\n&lt;/style&gt;\n&lt;div class=&apos;zcs-page-container zcs-wh-full&apos;&gt;\n\t&lt;div class=&apos;zcs-page-container-inner zcs-flex zcs-direction-column zcs-gap-20 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-p-24 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-6 zcs-ellipsis&apos;&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&apos;&gt;Customer self-service&lt;/p&gt;\n\t\t\t\t&lt;h2 class=&apos;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Welcome, &lt;%=customer.Full_Name%&gt;&lt;/h2&gt;\n\t\t\t\t&lt;p class=&apos;support-note zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&apos;&gt;Account &lt;%=customer.Customer_ID%&gt; · &lt;%=customer_type%&gt;&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;a href=&apos;#Form:Shipment_Requests?Customer=&lt;%=customer_id%&gt;&apos; class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;span&gt;Book Shipment&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;dashboard-grid&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-20&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-row-wrap&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-05 zcs-font-24&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;%=customer.Full_Name%&gt;&lt;/h3&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;&lt;%=customer.Email_ID%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled &lt;%=profile_badge%&gt; zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-14&apos;&gt;&lt;%=onboarding_status%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-row zcs-gap-20&apos;&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Portal access&lt;/span&gt;&lt;p class=&apos;zcs-font-14 zcs-color-primary zcs-m-0&apos;&gt;&lt;%=customer.Portal_Access_Status%&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;KYC status&lt;/span&gt;&lt;p class=&apos;zcs-font-14 zcs-color-primary zcs-m-0&apos;&gt;&lt;%=if(customer_type == &quot;Retail&quot;,&quot;Not required&quot;,onboarding_status)%&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;% if(customer_type != &quot;Retail&quot;) { %&gt;&lt;div&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Documents verified&lt;/span&gt;&lt;p class=&apos;zcs-font-14 zcs-color-primary zcs-m-0&apos;&gt;&lt;%=kyc_verified%&gt; of &lt;%=kyc_total%&gt;&lt;/p&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&apos;kpi-grid&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-panel zcs-panel-green zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-panel-icon zcs-font-24 zc-li-outline business-coins&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h3 class=&apos;amount zcs-font-24 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;&lt;%=current_points.round(0)%&gt;&lt;/h3&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Current Loyalty Points&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-panel zcs-panel-blue zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-panel-icon zcs-font-24 zc-li-outline sport-trophy&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h3 class=&apos;amount zcs-font-24 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;&lt;%=lifetime_points.round(0)%&gt;&lt;/h3&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Lifetime Loyalty Points&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-panel zcs-panel-orange zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-panel-icon zcs-font-24 zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h3 class=&apos;amount zcs-font-24 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;&lt;%=expiring_points.round(0)%&gt;&lt;/h3&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Points expiring in 30 days&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-panel zcs-panel-violet zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-panel-icon zcs-font-24 zc-li-outline shopping-wallet&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h3 class=&apos;amount zcs-font-20 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;INR &lt;%=ifnull(customer.Outstanding_Balance,0).round(2)%&gt;&lt;/h3&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Account balance&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;% if(customer_type == &quot;Corporate&quot; || customer_type == &quot;Wholesale&quot;) { %&gt;\n\t\t\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-24 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Quarterly tier progress&lt;/h3&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-theme zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-14&apos;&gt;&lt;%=tier_name%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=tier_progress%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-color-primary zcs-m-0&apos;&gt;&lt;span&gt;INR &lt;%=quarter_spend.round(2)%&gt; eligible spend&lt;/span&gt;&lt;span&gt;&lt;%=tier_progress%&gt;%&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;&lt;%=if(next_tier_min &gt; 0,&quot;INR &quot; + spend_remaining.round(2) + &quot; more to reach &quot; + next_tier_name,&quot;You are in the highest configured tier&quot;)%&gt;&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;% } else { %&gt;\n\t\t\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Retail rewards&lt;/h3&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Earn points on eligible delivered shipments and use available points while booking.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;a href=&apos;#Report:My_Loyalty_History&apos; class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&apos;&gt;&lt;i class=&apos;zc-li-outline business-coins&apos;&gt;&lt;/i&gt;&lt;span&gt;View history&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;% } %&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-20&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Quick actions&lt;/h3&gt;\n\t\t\t\t\t&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary&apos; href=&apos;#Form:Shipment_Requests?Customer=&lt;%=customer_id%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;&lt;span&gt;Book Shipment&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary&apos; href=&apos;#Report:My_KYC_Checklist&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-doc&apos;&gt;&lt;/i&gt;&lt;span&gt;Upload or Correct KYC&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary&apos; href=&apos;#Report:My_Invoices&apos;&gt;&lt;i class=&apos;zc-li-outline files-1-paper&apos;&gt;&lt;/i&gt;&lt;span&gt;View My Invoices&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary&apos; href=&apos;#Report:My_Loyalty_History&apos;&gt;&lt;i class=&apos;zc-li-outline business-coins&apos;&gt;&lt;/i&gt;&lt;span&gt;My Loyalty History&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Invoices and balance&lt;/h3&gt;&lt;a class=&apos;zcs-font-13 zcs-color-theme&apos; href=&apos;#Report:My_Account_Statement&apos;&gt;Ledger&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-color-tertiary&apos;&gt;Open invoices&lt;/span&gt;&lt;strong class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=open_invoices.count(ID)%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-color-tertiary&apos;&gt;Open ledger entries&lt;/span&gt;&lt;strong class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=open_ledger_count%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-color-tertiary&apos;&gt;Open invoice total&lt;/span&gt;&lt;strong class=&apos;amount zcs-font-16 zcs-color-primary&apos;&gt;INR &lt;%=open_invoice_total.round(2)%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% if(open_invoices.count(ID) &gt; 0) { invoice_count = 0; for each invoice in open_invoices { if(invoice_count &lt; 3) { invoice_count = invoice_count + 1; %&gt;\n\t\t\t\t\t&lt;div class=&apos;invoice-row zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-py-8&apos;&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;p class=&apos;zcs-font-14 zcs-font-medium zcs-color-primary zcs-m-0&apos;&gt;Invoice &lt;%=invoice.Invoice_Number%&gt;&lt;/p&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;Due &lt;%=invoice.Due_Date.toString(&quot;dd-MMM-yyyy&quot;)%&gt; · &lt;%=invoice.Invoice_Status%&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;a href=&apos;#Report:My_Invoices&apos; class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-px-12 zcs-py-8 zcs-rounded-md zcs-font-13&apos;&gt;Pay Now&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } } } else { %&gt;&lt;div class=&apos;empty-state zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08 zcs-font-24 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;h4 class=&apos;zcs-font-16 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-mb-0&apos;&gt;No unpaid invoices&lt;/h4&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Active shipments&lt;/h3&gt;&lt;a class=&apos;zcs-font-13 zcs-color-theme&apos; href=&apos;#Report:My_Shipments&apos;&gt;View all&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;% if(active_shipments.count(ID) &gt; 0) { %&gt;&lt;div class=&apos;shipment-grid&apos;&gt;&lt;% shipment_count = 0; for each shipment in active_shipments { if(shipment_count &lt; 6) { shipment_count = shipment_count + 1; shipment_badge = &quot;zcs-badge-blue&quot;; if(shipment.Shipment_Status == &quot;Delivery Failed - NDR&quot; || shipment.Shipment_Status == &quot;Credit Hold&quot;) { shipment_badge = &quot;zcs-badge-orange&quot;; } %&gt;\n\t\t\t\t&lt;a href=&apos;#Page:Shipment_Tracking?Shipment_ID=&lt;%=shipment.ID%&gt;&apos; class=&apos;shipment-card zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;strong class=&apos;zcs-font-15 zcs-color-primary&apos;&gt;AWB &lt;%=shipment.AWB_Number%&gt;&lt;/strong&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled &lt;%=shipment_badge%&gt; zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-12&apos;&gt;&lt;%=shipment.Shipment_Status%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline location-pin-copy zcs-color-tertiary&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;&lt;%=shipment.Pickup_Pincode%&gt;&lt;/span&gt;&lt;span class=&apos;route-line&apos;&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;&lt;%=shipment.Delivery_Pincode%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;%=if(shipment.Expected_Delivery_Date != null,&quot;Expected &quot; + shipment.Expected_Delivery_Date.toString(&quot;dd-MMM-yyyy&quot;),&quot;Delivery estimate pending&quot;)%&gt;&lt;/span&gt;&lt;strong class=&apos;amount zcs-font-13 zcs-color-primary&apos;&gt;INR &lt;%=ifnull(shipment.Total_Payable,0).round(2)%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;% } } %&gt;&lt;/div&gt;&lt;% } else { %&gt;&lt;div class=&apos;empty-state zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast zcs-font-30 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;h4 class=&apos;zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-mb-0&apos;&gt;No active shipments&lt;/h4&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Book a shipment when you are ready to send.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Recently delivered&lt;/h3&gt;&lt;a class=&apos;zcs-font-13 zcs-color-theme&apos; href=&apos;#Report:My_Shipments&apos;&gt;Shipment history&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;% if(delivered_shipments.count(ID) &gt; 0) { %&gt;&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&apos;&gt;AWB&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&apos;&gt;Route&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&apos;&gt;Booked&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&apos;&gt;Amount&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&apos;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;% delivered_count = 0; for each delivered in delivered_shipments { if(delivered_count &lt; 5) { delivered_count = delivered_count + 1; %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12 zcs-font-14&apos;&gt;&lt;a class=&apos;zcs-color-theme&apos; href=&apos;#Page:Shipment_Tracking?Shipment_ID=&lt;%=delivered.ID%&gt;&apos;&gt;&lt;%=delivered.AWB_Number%&gt;&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=delivered.Pickup_Pincode%&gt; to &lt;%=delivered.Delivery_Pincode%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-tertiary&apos;&gt;&lt;%=if(delivered.Booked_On != null,delivered.Booked_On.toString(&quot;dd-MMM-yyyy&quot;),&quot;Not available&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;amount zcs-px-16 zcs-py-12 zcs-text-right zcs-font-14 zcs-color-primary&apos;&gt;INR &lt;%=ifnull(delivered.Total_Payable,0).round(2)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-green zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&apos;&gt;Delivered&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;% } else { %&gt;&lt;div class=&apos;empty-state zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div&gt;&lt;h4 class=&apos;zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0&apos;&gt;No delivered shipments yet&lt;/h4&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n}\nelse\n{\n%&gt;\n&lt;style&gt;\n:root{--zcs-page-bg-color:#F3F3F4;--zcs-white-color:#fff}.zcs-page-container{min-height:100%;padding:24px;box-sizing:border-box;background:var(--zcs-page-bg-color);font-family:Arial,sans-serif}.zcs-card{max-width:680px;margin:60px auto;padding:32px;text-align:center;background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;color:var(--zcs_primary_text_color)}.zcs-card i{font-size:32px;color:var(--zcs_brand_color)}\n&lt;/style&gt;\n&lt;div class=&apos;zcs-page-container&apos;&gt;&lt;div class=&apos;zcs-card&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-05&apos;&gt;&lt;/i&gt;&lt;h2&gt;Customer profile not found&lt;/h2&gt;&lt;p&gt;This dashboard only loads the customer whose Portal Login Email matches the signed-in account. Contact support if your portal invitation uses a different email.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n}\n%&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Hub_Dashboard(int Hub_ID)
		{
					displayname = "Hub Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Hub_Command_Center' elementName='Hub_Command_Center'>\n\t\t\t\t\t<![CDATA[htmlpage Hub_Command_Center()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nprofileName = thisapp.permissions.loginUserProfile();\nnetworkRole = profileName == &quot;Logistics_Administrator&quot; || profileName == &quot;Administrator&quot; || profileName == &quot;Operations_Manager&quot;;\nhubRole = profileName == &quot;Hub_Supervisor&quot; || profileName == &quot;Hub_Operator&quot;;\nallowed = networkRole || hubRole;\nuserRec = Operations_Users[Work_Email == zoho.loginuserid &amp;&amp; Active == true];\nhubId = 0;\nhubName = &quot;Select a hub&quot;;\nhubCode = &quot;&quot;;\nif(hubRole &amp;&amp; userRec.count(ID) &gt; 0)\n{\n\t\tdeputationActive = userRec.Deputed_Hub != null &amp;&amp; (userRec.Deputation_Start_Date == null || userRec.Deputation_Start_Date &lt;= zoho.currentdate) &amp;&amp; (userRec.Deputation_End_Date == null || userRec.Deputation_End_Date &gt;= zoho.currentdate);\n\t\tif(deputationActive)\n\t\t{\n\t\t\t\thubId = userRec.Deputed_Hub;\n\t\t}\n\t\telse if(userRec.Home_Hub != null)\n\t\t{\n\t\t\t\thubId = userRec.Home_Hub;\n\t\t}\n}\nelse if(networkRole &amp;&amp; input.Hub_ID != null &amp;&amp; input.Hub_ID &gt; 0)\n{\n\t\tselectedHub = Hubs[ID == input.Hub_ID &amp;&amp; Active == true];\n\t\tif(selectedHub.count(ID) &gt; 0)\n\t\t{\n\t\t\t\thubId = selectedHub.ID;\n\t\t}\n}\nif(hubId &gt; 0)\n{\n\t\thubRec = Hubs[ID == hubId &amp;&amp; Active == true];\n\t\tif(hubRec.count(ID) &gt; 0)\n\t\t{\n\t\t\t\thubName = ifnull(hubRec.Hub_Name,&quot;Hub&quot;);\n\t\t\t\thubCode = ifnull(hubRec.Hub_ID,&quot;&quot;);\n\t\t}\n\t\telse\n\t\t{\n\t\t\t\thubId = 0;\n\t\t}\n}\n%&gt;\n&lt;style&gt;\n/* ZCS global utilities used by this page; included once. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;--zcs-page-bg-color:#f3f3f4;--zcs-thead-color:#f9fafe}\n.zcs-flex,.zcs-row{display:flex}.zcs-row{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-row-wrap{flex-wrap:wrap}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-half{border-radius:50%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-color-red{color:#fe455d}.zcs-color-green{color:#179e6c}.zcs-color-yellow{color:#b8770d}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-overflow-auto{overflow:auto}.zcs-list-none{list-style:none}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.zcs-button{width:auto;min-height:36px;text-decoration:none}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color);border:1px solid var(--zcs_brand_color)}.zcs-primary-outline-button{background:#fff;color:var(--zcs_brand_color);border:1px solid var(--zcs_brand_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}\n.hub-dashboard{background:var(--zcs-page-bg-color);padding:16px;min-height:100%;font-family:Arial,sans-serif}.hub-header{background:linear-gradient(115deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));color:var(--zcs_brand_foreground_color);border-radius:14px}.hub-header .zcs-color-primary,.hub-header .zcs-color-secondary{color:inherit}.hub-selector{max-width:100%;overflow:auto}.hub-selector a{white-space:nowrap;text-decoration:none}.hub-selector .active-hub{background:var(--zcs_brand_foreground_color);color:var(--zcs_brand_color)}.dashboard-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:16px}.span-12{grid-column:span 12}.span-8{grid-column:span 8}.span-7{grid-column:span 7}.span-6{grid-column:span 6}.span-5{grid-column:span 5}.span-4{grid-column:span 4}.kpi-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}.kpi-card{min-height:118px}.kpi-icon{width:38px;height:38px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:18px}.section-title{border-bottom:1px solid var(--zcs_tertiary_border_color)}.zcs-badge{width:auto;border:1px solid}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#179e6c}.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#fe455d}.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#a06309}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#2a6ffc}.zcs-badge-theme{background:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color)}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}.work-chart{height:215px}.work-bars{height:155px;border-bottom:1px solid var(--zcs_tertiary_border_color)}.work-bar-group{flex:1;min-width:54px;height:100%}.work-bar{width:28px;min-height:3px;background:var(--zcs_brand_color);border-radius:6px 6px 0 0}.work-bar.delivery{background:#179e6c}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;min-width:620px}.zcs-table-wrapper th{background:var(--zcs-thead-color);top:0}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tr:hover td{background:#f9fafe}.zcs-tl-li{list-style:none;padding-left:26px}.zcs-tl-dot{width:12px;height:12px;background:var(--zcs_brand_color);left:0;top:5px}.zcs-tl-li:not(:last-child):before{content:&quot;&quot;;position:absolute;left:5px;top:16px;width:1px;height:calc(100% + 10px);background:#e1e1e1}.quick-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.zcs-quick-action-item{list-style:none}.zcs-quick-action-link{text-decoration:none}.zcs-quick-action-item:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover a{color:var(--zcs_brand_color)}.queue-scroll{max-height:330px}.empty-state{min-height:120px}.cod-amount{font-size:2rem}.security-banner{border-left:4px solid #fe455d;background:#fde3e6}.agent-load-item:not(:last-child){border-bottom:1px solid var(--zcs_tertiary_border_color)}\n@media(max-width:1100px){.kpi-grid{grid-template-columns:repeat(3,1fr)}.span-8,.span-7,.span-6,.span-5,.span-4{grid-column:span 12}}\n@media(max-width:700px){.hub-dashboard{padding:10px}.kpi-grid{grid-template-columns:repeat(2,1fr)}.quick-grid{grid-template-columns:repeat(2,1fr)}.hub-header{align-items:flex-start}.hub-header&gt;.zcs-flex{width:100%}}\n&lt;/style&gt;\n&lt;div class=&apos;hub-dashboard zcs-box-border&apos;&gt;\n&lt;% if(!allowed) { %&gt;\n\t\t&lt;div class=&apos;zcs-card security-banner zcs-p-24 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-red zcs-m-0&apos;&gt;Access restricted&lt;/h5&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-primary zcs-mb-0&apos;&gt;This command center is limited to hub operations and network operations profiles.&lt;/p&gt;\n\t\t&lt;/div&gt;\n&lt;% } else if(hubRole &amp;&amp; (userRec.count(ID) == 0 || hubId == 0)) { %&gt;\n\t\t&lt;div class=&apos;zcs-card security-banner zcs-p-24 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-red zcs-m-0&apos;&gt;Hub mapping required&lt;/h5&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-primary zcs-mb-0&apos;&gt;No active home or deputed hub is mapped to your Operations Users record. No operational data has been loaded.&lt;/p&gt;\n\t\t&lt;/div&gt;\n&lt;% } else if(networkRole &amp;&amp; hubId == 0) { %&gt;\n\t\t&lt;div class=&apos;hub-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-row-wrap zcs-gap-16 zcs-p-24 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h3 class=&apos;zcs-font-24 zcs-font-semibold zcs-m-0&apos;&gt;Hub Command Center&lt;/h3&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-mt-4 zcs-mb-0&apos;&gt;Select an active hub to load operational data. No network-wide totals are shown on this page.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-mt-8 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Active hubs&lt;/h5&gt;\n\t\t\t\t&lt;div class=&apos;hub-selector zcs-flex zcs-row-wrap zcs-gap-8 zcs-mt-8&apos;&gt;\n\t\t\t\t&lt;% for each hubOption in Hubs[Active == true] sort by Hub_Name asc { %&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Page:Hub_Dashboard?Hub_ID=&lt;%=hubOption.ID%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline location-pin&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=hubOption.Hub_Name%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;% } else {\n\t\ttodayPickupItems = Pickup_Run_Sheet_Items[Pickup_Run_Sheet.Hub == hubId &amp;&amp; Pickup_Run_Sheet.Run_Date == zoho.currentdate &amp;&amp; Stop_Status == &quot;Picked Up&quot;];\n\t\tinboundAWBs = Shipment_Requests[Current_Hub == hubId &amp;&amp; (Shipment_Status == &quot;Inbound at Branch Station&quot; || Shipment_Status == &quot;Arrived at Destination Hub&quot;)];\n\t\topenBags = Logistics_Bags[Origin_Hub == hubId &amp;&amp; Bag_Status == &quot;Open&quot;];\n\t\toutboundManifests = Manifests[Origin_Hub == hubId &amp;&amp; (Manifest_Status == &quot;Closed&quot; || Manifest_Status == &quot;In Transit&quot;)];\n\t\tatDeliveryHub = Shipment_Requests[Destination_Hub == hubId &amp;&amp; Shipment_Status == &quot;At Delivery Hub&quot;];\n\t\tofdShipments = Shipment_Requests[Destination_Hub == hubId &amp;&amp; Shipment_Status == &quot;Out For Delivery (OFD)&quot;];\n\t\tndrShipments = Shipment_Requests[Destination_Hub == hubId &amp;&amp; Shipment_Status == &quot;Delivery Failed - NDR&quot;];\n\t\topenExceptions = Shipment_Exceptions[Reporting_Hub == hubId &amp;&amp; Exception_Status != &quot;Resolved&quot;];\n\t\tactiveHubShipments = Shipment_Requests[Current_Hub == hubId &amp;&amp; Shipment_Status != &quot;Delivered&quot; &amp;&amp; Shipment_Status != &quot;Cancelled&quot;];\n\t\tdailyCapacity = ifnull(hubRec.Daily_Capacity,0);\n\t\tcapacityPct = 0;\n\t\tif(dailyCapacity &gt; 0)\n\t\t{\n\t\t\t\tcapacityPct = (activeHubShipments.count(ID) * 100.0 / dailyCapacity).round(1);\n\t\t\t\tif(capacityPct &gt; 100) { capacityPct = 100; }\n\t\t}\n\t\tpickupAssigned = Pickup_Run_Sheet_Items[Pickup_Run_Sheet.Hub == hubId &amp;&amp; Pickup_Run_Sheet.Run_Date == zoho.currentdate &amp;&amp; Stop_Status == &quot;Assigned&quot;].count(ID);\n\t\tpickupArrived = Pickup_Run_Sheet_Items[Pickup_Run_Sheet.Hub == hubId &amp;&amp; Pickup_Run_Sheet.Run_Date == zoho.currentdate &amp;&amp; Stop_Status == &quot;Arrived&quot;].count(ID);\n\t\tpickupDone = todayPickupItems.count(ID);\n\t\tpickupFailed = Pickup_Run_Sheet_Items[Pickup_Run_Sheet.Hub == hubId &amp;&amp; Pickup_Run_Sheet.Run_Date == zoho.currentdate &amp;&amp; Stop_Status == &quot;Failed&quot;].count(ID);\n\t\tdeliveryAssigned = Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Hub == hubId &amp;&amp; Delivery_Run_Sheet.Run_Date == zoho.currentdate &amp;&amp; Delivery_Status == &quot;Assigned&quot;].count(ID);\n\t\tdeliveryOFD = Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Hub == hubId &amp;&amp; Delivery_Run_Sheet.Run_Date == zoho.currentdate &amp;&amp; Delivery_Status == &quot;Out For Delivery&quot;].count(ID);\n\t\tdeliveryDone = Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Hub == hubId &amp;&amp; Delivery_Run_Sheet.Run_Date == zoho.currentdate &amp;&amp; Delivery_Status == &quot;Delivered&quot;].count(ID);\n\t\tdeliveryFailed = Delivery_Run_Sheet_Items[Delivery_Run_Sheet.Hub == hubId &amp;&amp; Delivery_Run_Sheet.Run_Date == zoho.currentdate &amp;&amp; Delivery_Status == &quot;Failed&quot;].count(ID);\n\t\tworkloadMax = pickupAssigned;\n\t\tfor each workValue in {pickupArrived,pickupDone,pickupFailed,deliveryAssigned,deliveryOFD,deliveryDone,deliveryFailed}\n\t\t{\n\t\t\t\tif(workValue &gt; workloadMax) { workloadMax = workValue; }\n\t\t}\n\t\tif(workloadMax &lt; 1) { workloadMax = 1; }\n\t\tcodPending = COD_Remittances[Hub == hubId &amp;&amp; (Remittance_Status == &quot;Pending&quot; || Remittance_Status == &quot;Shortfall&quot;)];\n\t\tcodAmount = ifnull(codPending.sum(Expected_Amount),0);\n\t\thubAgents = Operations_Users[Active == true &amp;&amp; Application_Role == &quot;Field Agent&quot; &amp;&amp; ((Deputed_Hub == hubId &amp;&amp; (Deputation_Start_Date == null || Deputation_Start_Date &lt;= zoho.currentdate) &amp;&amp; (Deputation_End_Date == null || Deputation_End_Date &gt;= zoho.currentdate)) || (Home_Hub == hubId &amp;&amp; (Deputed_Hub == null || (Deputation_Start_Date != null &amp;&amp; Deputation_Start_Date &gt; zoho.currentdate) || (Deputation_End_Date != null &amp;&amp; Deputation_End_Date &lt; zoho.currentdate))))];\n%&gt;\n\t\t&lt;div class=&apos;hub-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-row-wrap zcs-gap-16 zcs-p-24 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline location-pin zcs-font-22&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;h3 class=&apos;zcs-font-24 zcs-font-semibold zcs-m-0&apos;&gt;&lt;%=hubName%&gt;&lt;/h3&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=hubCode%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-mt-4 zcs-mb-0&apos;&gt;Operational command center for &lt;%=zoho.currentdate.toString(&quot;dd-MMM-yyyy&quot;)%&gt;. Data and actions are scoped to this hub.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;% if(networkRole) { %&gt;\n\t\t\t\t&lt;div class=&apos;hub-selector zcs-flex zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t&lt;% for each hubOption in Hubs[Active == true] sort by Hub_Name asc { %&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-flex zcs-align-items-center zcs-px-12 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-13 &lt;%=if(hubOption.ID == hubId,&quot;active-hub&quot;,&quot;zcs-primary-outline-button&quot;)%&gt;&apos; href=&apos;#Page:Hub_Dashboard?Hub_ID=&lt;%=hubOption.ID%&gt;&apos;&gt;&lt;%=hubOption.Hub_Name%&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;% } %&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;kpi-grid zcs-mt-8&apos;&gt;\n\t\t&lt;%\n\t\tkpiLabels = {&quot;Today&apos;s pickups&quot;,&quot;Inbound AWBs&quot;,&quot;Open bags&quot;,&quot;Outbound manifests&quot;,&quot;At delivery hub&quot;,&quot;Out for delivery&quot;,&quot;NDR&quot;,&quot;Open exceptions&quot;,&quot;Capacity utilization&quot;};\n\t\tkpiValues = {todayPickupItems.count(ID),inboundAWBs.count(ID),openBags.count(ID),outboundManifests.count(ID),atDeliveryHub.count(ID),ofdShipments.count(ID),ndrShipments.count(ID),openExceptions.count(ID),capacityPct + &quot;%&quot;};\n\t\tkpiIcons = {&quot;transportation-box-delivery&quot;,&quot;arrows-1-log-in&quot;,&quot;files-folder&quot;,&quot;transportation-truck&quot;,&quot;location-pin&quot;,&quot;transportation-bike&quot;,&quot;ui-3-alert&quot;,&quot;ui-2-notification&quot;,&quot;business-chart-bar-32&quot;};\n\t\tfor each index kpiIndex in kpiLabels\n\t\t{\n\t\t%&gt;\n\t\t\t\t&lt;div class=&apos;zcs-card kpi-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;&lt;%=kpiLabels.get(kpiIndex)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=kpiIcons.get(kpiIndex)%&gt;&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;strong class=&apos;zcs-font-30 zcs-color-primary&apos;&gt;&lt;%=kpiValues.get(kpiIndex)%&gt;&lt;/strong&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;% } %&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;dashboard-grid zcs-mt-8&apos;&gt;\n\t\t\t\t&lt;section class=&apos;zcs-card span-8 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;section-title zcs-flex zcs-align-items-center zcs-justify-space-between zcs-py-12&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Pickup and delivery workload&lt;/h5&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-12 zcs-font-12&apos;&gt;&lt;span class=&apos;zcs-color-theme&apos;&gt;Pickup&lt;/span&gt;&lt;span class=&apos;zcs-color-green&apos;&gt;Delivery&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;work-chart zcs-flex zcs-direction-column zcs-justify-center zcs-mt-8&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;work-bars zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\tworkLabels = {&quot;Assigned&quot;,&quot;In progress&quot;,&quot;Completed&quot;,&quot;Failed&quot;};\n\t\t\t\t\t\t\t\tpickupValues = {pickupAssigned,pickupArrived,pickupDone,pickupFailed};\n\t\t\t\t\t\t\t\tdeliveryValues = {deliveryAssigned,deliveryOFD,deliveryDone,deliveryFailed};\n\t\t\t\t\t\t\t\tfor each index workIndex in workLabels\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tpickupHeight = (pickupValues.get(workIndex) * 100.0 / workloadMax).round(0);\n\t\t\t\t\t\t\t\t\t\tdeliveryHeight = (deliveryValues.get(workIndex) * 100.0 / workloadMax).round(0);\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;work-bar-group zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-6 zcs-h-full&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;work-bar&apos; title=&apos;Pickup &lt;%=pickupValues.get(workIndex)%&gt;&apos; style=&apos;height:&lt;%=pickupHeight%&gt;%&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;work-bar delivery&apos; title=&apos;Delivery &lt;%=deliveryValues.get(workIndex)%&gt;&apos; style=&apos;height:&lt;%=deliveryHeight%&gt;%&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-12 zcs-color-tertiary zcs-text-center&apos;&gt;&lt;%=workLabels.get(workIndex)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;aside class=&apos;zcs-card span-4 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;section-title zcs-py-12&apos;&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Quick actions&lt;/h5&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;ul class=&apos;quick-grid zcs-p-0 zcs-mt-8&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-p-12 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary zcs-text-center&apos; href=&apos;#Form:Pickup_Run_Sheets?Hub=&lt;%=hubId%&gt;&amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-date zcs-font-22&apos;&gt;&lt;/i&gt;&lt;span&gt;Generate PRS&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-p-12 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary zcs-text-center&apos; href=&apos;#Form:Logistics_Bags?Origin_Hub=&lt;%=hubId%&gt;&amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-bag zcs-font-22&apos;&gt;&lt;/i&gt;&lt;span&gt;Create Bag&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-p-12 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary zcs-text-center&apos; href=&apos;#Form:Manifests?Origin_Hub=&lt;%=hubId%&gt;&amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-doc zcs-font-22&apos;&gt;&lt;/i&gt;&lt;span&gt;Create Manifest&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-p-12 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary zcs-text-center&apos; href=&apos;#Report:Last_Mile_Dispatcher?Hub=&lt;%=hubId%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline location-map zcs-font-22&apos;&gt;&lt;/i&gt;&lt;span&gt;Auto-Cluster DRS&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-p-12 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary zcs-text-center&apos; href=&apos;#Report:All_Manifests?Destination_Hub=&lt;%=hubId%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-log-in zcs-font-22&apos;&gt;&lt;/i&gt;&lt;span&gt;Receive Manifest&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-p-12 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-8 zcs-font-13 zcs-color-primary zcs-text-center&apos; href=&apos;#Report:COD_Pending_Remittance?Hub=&lt;%=hubId%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline business-coins zcs-font-22&apos;&gt;&lt;/i&gt;&lt;span&gt;Confirm COD&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;/aside&gt;\n\n\t\t\t\t&lt;section class=&apos;zcs-card span-7 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;section-title zcs-flex zcs-align-items-center zcs-justify-space-between zcs-py-12&apos;&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Manifest arrival and departure timeline&lt;/h5&gt;&lt;a class=&apos;zcs-font-13 zcs-color-theme&apos; href=&apos;#Report:In_Transit_Manifests?Origin_Hub=&lt;%=hubId%&gt;&apos;&gt;View manifests&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-timeline-wrapper zcs-mt-8&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-20 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;% timelineCount = 0; for each manifestRow in Manifests[(Origin_Hub == hubId || Destination_Hub == hubId) &amp;&amp; Manifest_Status != &quot;Cancelled&quot; &amp;&amp; Manifest_Status != &quot;Draft&quot;] sort by Expected_Arrival_Time asc { if(timelineCount &lt; 8) { timelineCount = timelineCount + 1; movement = if(manifestRow.Origin_Hub == hubId,&quot;Departure&quot;,&quot;Arrival&quot;); eventTime = if(movement == &quot;Departure&quot;,manifestRow.Departure_Time,manifestRow.Expected_Arrival_Time); %&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-tl-li zcs-relative&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-tl-dot zcs-rounded-half zcs-absolute&apos;&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;strong class=&apos;zcs-font-15 zcs-color-primary&apos;&gt;&lt;%=movement%&gt; · &lt;%=manifestRow.Manifest_Number%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-blue zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=manifestRow.Manifest_Status%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0&apos;&gt;&lt;%=ifnull(eventTime,&quot;Time pending&quot;)%&gt; · &lt;%=manifestRow.Origin_Hub%&gt; to &lt;%=manifestRow.Destination_Hub%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;% } } if(timelineCount == 0) { %&gt;&lt;li class=&apos;zcs-list-none zcs-text-center zcs-color-tertiary zcs-p-20&apos;&gt;No active manifest movements for this hub.&lt;/li&gt;&lt;% } %&gt;\n\t\t\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&apos;zcs-card span-5 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;section-title zcs-flex zcs-align-items-center zcs-justify-space-between zcs-py-12&apos;&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Agent availability and load&lt;/h5&gt;&lt;span class=&apos;zcs-badge zcs-badge-theme zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=hubAgents.count(ID)%&gt; active&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column&apos;&gt;\n\t\t\t\t\t\t&lt;% agentCount = 0; for each agent in Operations_Users[Active == true &amp;&amp; Application_Role == &quot;Field Agent&quot; &amp;&amp; ((Deputed_Hub == hubId &amp;&amp; (Deputation_Start_Date == null || Deputation_Start_Date &lt;= zoho.currentdate) &amp;&amp; (Deputation_End_Date == null || Deputation_End_Date &gt;= zoho.currentdate)) || (Home_Hub == hubId &amp;&amp; (Deputed_Hub == null || (Deputation_Start_Date != null &amp;&amp; Deputation_Start_Date &gt; zoho.currentdate) || (Deputation_End_Date != null &amp;&amp; Deputation_End_Date &lt; zoho.currentdate))))] sort by Employee_ID asc { if(agentCount &lt; 8) { agentCount = agentCount + 1; activePickupRuns = Pickup_Run_Sheets[Hub == hubId &amp;&amp; Run_Date == zoho.currentdate &amp;&amp; Assigned_Agent == agent.ID &amp;&amp; (Status == &quot;Released&quot; || Status == &quot;In Progress&quot;)]; activeDeliveryRuns = Delivery_Run_Sheets[Hub == hubId &amp;&amp; Run_Date == zoho.currentdate &amp;&amp; Assigned_Agent == agent.ID &amp;&amp; (DRS_Status == &quot;Released&quot; || DRS_Status == &quot;In Progress&quot;)]; plannedWeight = ifnull(Pickup_Run_Sheets[Hub == hubId &amp;&amp; Run_Date == zoho.currentdate &amp;&amp; Assigned_Agent == agent.ID].sum(Total_Planned_Weight_Kg),0); maxLoad = ifnull(agent.Maximum_Daily_Load_Kg,0); loadPct = 0; if(maxLoad &gt; 0) { loadPct = (plannedWeight * 100.0 / maxLoad).round(0); if(loadPct &gt; 100) { loadPct = 100; } } isAvailable = activePickupRuns.count(ID) + activeDeliveryRuns.count(ID) == 0; %&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;agent-load-item zcs-py-12&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div&gt;&lt;strong class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=agent.Employee_ID%&gt;&lt;/strong&gt;&lt;div class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;%=agent.Agent_Role%&gt; · &lt;%=ifnull(agent.Assigned_Beat,&quot;Unassigned beat&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge &lt;%=if(isAvailable,&quot;zcs-badge-green&quot;,&quot;zcs-badge-blue&quot;)%&gt; zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=if(isAvailable,&quot;Available&quot;,&quot;Assigned&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 zcs-mt-8&apos;&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=loadPct%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;&lt;span&gt;Pickup load&lt;/span&gt;&lt;span&gt;&lt;%=plannedWeight%&gt; / &lt;%=maxLoad%&gt; kg&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;% } } if(agentCount == 0) { %&gt;&lt;div class=&apos;empty-state zcs-flex zcs-align-items-center zcs-justify-center zcs-color-tertiary zcs-font-14&apos;&gt;No active field agents mapped to this hub.&lt;/div&gt;&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&apos;zcs-card span-4 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;section-title zcs-py-12&apos;&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Pincode and zone distribution&lt;/h5&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-mt-8&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Pincode&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Zone&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Service&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t\t&lt;% mappingCount = 0; for each mapping in Hub_Pincode_Mapping[Primary_Collection_Center == hubId &amp;&amp; Active == true] sort by Service_Zone asc { if(mappingCount &lt; 10) { mappingCount = mappingCount + 1; %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary&apos;&gt;&lt;%=mapping.Pincode%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary&apos;&gt;&lt;%=mapping.Service_Zone%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13&apos;&gt;&lt;span class=&apos;zcs-badge &lt;%=if(mapping.Serviceability == &quot;Serviceable&quot;,&quot;zcs-badge-green&quot;,&quot;zcs-badge-yellow&quot;)%&gt; zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=mapping.Serviceability%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } } if(mappingCount == 0) { %&gt;&lt;tr&gt;&lt;td colspan=&apos;3&apos; class=&apos;zcs-p-20 zcs-text-center zcs-color-tertiary&apos;&gt;No active pincode mappings.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&apos;zcs-card span-4 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;section-title zcs-py-12&apos;&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;COD pending&lt;/h5&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-16 zcs-mt-8&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Expected remittance&lt;/div&gt;&lt;strong class=&apos;cod-amount zcs-color-primary&apos;&gt;INR &lt;%=codAmount%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline business-coins&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-font-14&apos;&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;Pending / shortfall records&lt;/span&gt;&lt;strong class=&apos;zcs-color-primary&apos;&gt;&lt;%=codPending.count(ID)%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Report:COD_Pending_Remittance?Hub=&lt;%=hubId%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;Open confirmation queue&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&apos;zcs-card span-4 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;section-title zcs-py-12&apos;&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Capacity utilization&lt;/h5&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-16 zcs-mt-8&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;strong class=&apos;cod-amount zcs-color-primary&apos;&gt;&lt;%=capacityPct%&gt;%&lt;/strong&gt;&lt;span class=&apos;zcs-badge &lt;%=if(capacityPct &gt;= 90,&quot;zcs-badge-red&quot;,if(capacityPct &gt;= 70,&quot;zcs-badge-yellow&quot;,&quot;zcs-badge-green&quot;))%&gt; zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=if(capacityPct &gt;= 90,&quot;Critical&quot;,if(capacityPct &gt;= 70,&quot;Watch&quot;,&quot;Healthy&quot;))%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=capacityPct%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;&lt;span&gt;Active hub AWBs&lt;/span&gt;&lt;span&gt;&lt;%=activeHubShipments.count(ID)%&gt; / &lt;%=dailyCapacity%&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Utilization is based only on shipments whose current hub is &lt;%=hubName%&gt;.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&apos;zcs-card span-6 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;section-title zcs-flex zcs-align-items-center zcs-justify-space-between zcs-py-12&apos;&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Exception queue&lt;/h5&gt;&lt;a class=&apos;zcs-font-13 zcs-color-theme&apos; href=&apos;#Report:Shipment_Exception_Queue?Reporting_Hub=&lt;%=hubId%&gt;&apos;&gt;Open queue&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-table-wrapper queue-scroll zcs-rounded-sm zcs-mt-8&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Exception&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Type&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Severity&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t\t&lt;% exceptionCount = 0; for each exceptionRow in Shipment_Exceptions[Reporting_Hub == hubId &amp;&amp; Exception_Status != &quot;Resolved&quot;] sort by Reported_At desc { if(exceptionCount &lt; 6) { exceptionCount = exceptionCount + 1; severityClass = if(exceptionRow.Severity == &quot;Critical&quot; || exceptionRow.Severity == &quot;High&quot;,&quot;zcs-badge-red&quot;,if(exceptionRow.Severity == &quot;Medium&quot;,&quot;zcs-badge-yellow&quot;,&quot;zcs-badge-blue&quot;)); %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary&apos;&gt;&lt;%=exceptionRow.Exception_Number%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary&apos;&gt;&lt;%=exceptionRow.Exception_Type%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;zcs-badge &lt;%=severityClass%&gt; zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=exceptionRow.Severity%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary&apos;&gt;&lt;%=exceptionRow.Exception_Status%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } } if(exceptionCount == 0) { %&gt;&lt;tr&gt;&lt;td colspan=&apos;4&apos; class=&apos;zcs-p-20 zcs-text-center zcs-color-tertiary&apos;&gt;No open exceptions for this hub.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&apos;zcs-card span-6 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;section-title zcs-flex zcs-align-items-center zcs-justify-space-between zcs-py-12&apos;&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;NDR action queue&lt;/h5&gt;&lt;a class=&apos;zcs-font-13 zcs-color-theme&apos; href=&apos;#Report:NDR_Instruction_Action_Queue?Shipment.Destination_Hub=&lt;%=hubId%&gt;&apos;&gt;Open queue&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-table-wrapper queue-scroll zcs-rounded-sm zcs-mt-8&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;NDR&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;AWB&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Reason&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t\t&lt;% ndrCount = 0; for each ndrRow in NDR_Instructions[Shipment.Destination_Hub == hubId &amp;&amp; NDR_Status != &quot;RTO&quot; &amp;&amp; NDR_Status != &quot;Added to Next DRS&quot;] sort by Submitted_At desc { if(ndrCount &lt; 6) { ndrCount = ndrCount + 1; %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary&apos;&gt;&lt;%=ndrRow.NDR_ID%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary&apos;&gt;&lt;%=ndrRow.Shipment.AWB_Number%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary&apos;&gt;&lt;%=ifnull(ndrRow.Failure_Reason,&quot;Awaiting details&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-yellow zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=ndrRow.NDR_Status%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } } if(ndrCount == 0) { %&gt;&lt;tr&gt;&lt;td colspan=&apos;4&apos; class=&apos;zcs-p-20 zcs-text-center zcs-color-tertiary&apos;&gt;No pending NDR instructions for this hub.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\t\t&lt;/div&gt;\n&lt;% } %&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page KYC_Review(int Customer_ID)
		{
					displayname = "KYC Review"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='KYC_Review_Workspace' elementName='KYC_Review_Workspace'>\n\t\t\t\t\t<![CDATA[htmlpage KYC_Review_Workspace()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t\t&lt;%\ncurrent_profile = thisapp.permissions.loginUserProfile();\ncustomer_rows = Customers[ID == input.Customer_ID];\ncustomer_found = customer_rows.count(ID) &gt; 0;\nauthorized_profile = current_profile == &quot;KYC_Reviewer&quot; || current_profile == &quot;Logistics_Administrator&quot;;\nauthorized = false;\nif(customer_found &amp;&amp; authorized_profile)\n{\n\t\tcustomer = customer_rows;\n\t\tauthorized = customer.Customer_Type == &quot;Corporate&quot; || customer.Customer_Type == &quot;Wholesale&quot;;\n}\nif(authorized)\n{\n\t\tcustomer_id = customer.ID;\n\t\tdocuments = Customer_KYC_Documents[Customer == customer_id] sort by KYC_Document_ID asc;\n\t\trequired_count = Customer_KYC_Documents[Customer == customer_id &amp;&amp; Required_For_Onboarding == true].count(ID);\n\t\treceived_count = Customer_KYC_Documents[Customer == customer_id &amp;&amp; Required_For_Onboarding == true &amp;&amp; Uploaded_File != null].count(ID);\n\t\tverified_count = Customer_KYC_Documents[Customer == customer_id &amp;&amp; Required_For_Onboarding == true &amp;&amp; Review_Status == &quot;Verified&quot;].count(ID);\n\t\tqueried_count = Customer_KYC_Documents[Customer == customer_id &amp;&amp; Review_Status == &quot;Query&quot;].count(ID);\n\t\tpending_count = Customer_KYC_Documents[Customer == customer_id &amp;&amp; Required_For_Onboarding == true &amp;&amp; Review_Status != &quot;Verified&quot;].count(ID);\n\t\tprogress_percent = 0;\n\t\tif(required_count &gt; 0)\n\t\t{\n\t\t\t\tprogress_percent = ((verified_count * 100.0) / required_count).round(0);\n\t\t}\n\t\tapproval_ready = required_count &gt; 0 &amp;&amp; pending_count == 0;\n\t\trate_card_name = &quot;Not assigned&quot;;\n\t\tif(customer.Assigned_Rate_Card != null)\n\t\t{\n\t\t\t\trate_card_name = customer.Assigned_Rate_Card.Rate_Card_Name;\n\t\t}\n\t\tsubmitted_text = &quot;Not submitted&quot;;\n\t\tif(customer.KYC_Submitted_On != null)\n\t\t{\n\t\t\t\tsubmitted_text = customer.KYC_Submitted_On.toString(&quot;dd-MMM-yyyy HH:mm&quot;);\n\t\t}\n\t\tverified_date_text = &quot;Captured on approval&quot;;\n\t\tif(customer.KYC_Verified_Date != null)\n\t\t{\n\t\t\t\tverified_date_text = customer.KYC_Verified_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t}\n\t\texpiry_date_text = &quot;Captured on approval&quot;;\n\t\tif(customer.KYC_Expiry_Date != null)\n\t\t{\n\t\t\t\texpiry_date_text = customer.KYC_Expiry_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t}\n\t\tcustomer_edit_url = &quot;#Form:Customers?recLinkID=&quot; + customer_id + &quot;&amp;viewLinkName=Verification_Pending&amp;zc_LoadIn=dialog&quot;;\n\t\tapproval_report_url = &quot;#Report:Verification_Pending?ID=&quot; + customer_id;\n\t\tdocument_report_url = &quot;#Report:KYC_Review_Queue?Customer=&quot; + customer_id;\n\t\tbase_url = &quot;https://creatorapp.zoho.com/&quot; + zoho.adminuser + &quot;/&quot; + zoho.appname + &quot;/&quot;;\n\t\tdocument_queue_embed = base_url + &quot;report-embed/KYC_Review_Queue/?zc_Header=false&amp;zc_Footer=false&amp;zc_AddRec=false&amp;zc_EditRec=true&amp;zc_DelRec=false&amp;zc_DuplRec=false&amp;zc_Print=false&amp;zc_Export=false&amp;Customer=&quot; + customer_id;\n\t\tcustomer_queue_embed = base_url + &quot;report-embed/Verification_Pending/?zc_Header=false&amp;zc_Footer=false&amp;zc_AddRec=false&amp;zc_EditRec=true&amp;zc_DelRec=false&amp;zc_DuplRec=false&amp;zc_Print=false&amp;zc_Export=false&amp;ID=&quot; + customer_id;\n%&gt;\n&lt;style&gt;\n/* zcs-global.css: page-scoped utility subset, loaded once for this page. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-row-wrap{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-col-6{flex:0 0 50%;max-width:50%}.zcs-col-12{flex:0 0 100%;max-width:100%}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-15{padding-left:.9375rem;padding-right:.9375rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mb-0{margin-bottom:0}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-color-white{color:#fff}.zcs-text-center{text-align:center}.zcs-text-left{text-align:left}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-overflow-hidden{overflow:hidden}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}\n/* ZCS components: header-heading-with-actions, card-template-default, progress-bar-range-bar-with-texts, badge-filled-outlined-badge, button-button-group, label-value-key-value-parallel, notes-notes-simple, no-data-no-data-text-only. */\n.kyc-page{min-height:100%;background:var(--zcs-page-bg-color);font-family:Arial,sans-serif}.kyc-shell{max-width:1540px;margin:0 auto}.zcs-page-header{background:#fff;border-bottom:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.review-layout{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(390px,.85fr);gap:20px}.summary-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.summary-tile{background:#F9FAFE;border:1px solid var(--zcs_tertiary_border_color)}.section-heading{border-bottom:1px solid var(--zcs_tertiary_border_color);padding-bottom:12px}.zcs-labelvalue-wrapper.zcs-labelvalue-with-bg{background:#F9FAFE}.zcs-labelvalue-wrapper ul{list-style:none}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}.zcs-badge{width:auto;border:1px solid}.zcs-badge-green{background:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-red{background:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-grey{background:#e8e8e8;border-color:#626262;color:#242424}.zcs-badge-yellow{background:#FCF4E6;border-color:#FAAE13;color:#9a6700}.zcs-badge-blue{background:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-orange{background:#F8F0EB;border-color:#F4660C;color:#F4660C}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-button:hover{filter:brightness(.96)}.zcs-button-disabled{border:1px solid var(--zcs_tertiary_border_color);background:#f4f4f5;color:var(--zcs_tertiary_text_color);cursor:not-allowed;opacity:.75}.document-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.zcs-template-card{width:100%;min-height:300px;overflow:hidden}.zcs-card-header{border-bottom:1px solid var(--zcs_tertiary_border_color)}.zcs-template-card-badge{top:0;right:0;background:var(--zcs_brand_color);border-bottom-left-radius:32px}.zcs-card-content{padding-bottom:62px}.zcs-card-footer{left:0;bottom:0;background:#F9FAFE;border-top:1px solid var(--zcs_tertiary_border_color)}.metadata{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.metadata-item{min-width:0}.review-note{background:#F9FAFE;border-left:3px solid var(--zcs_brand_color)}.query-note{border-left-color:#F4660C}.workflow-frame{width:100%;height:330px;border:1px solid var(--zcs_tertiary_border_color);border-radius:8px;background:#fff}.decision-frame{height:250px}.sticky-controls{position:sticky;top:12px}.flag-list{list-style:none}.flag-item{border-top:1px solid var(--zcs_tertiary_border_color)}.flag-item:first-child{border-top:0}.zcs-notes-text a:hover{text-decoration:underline}.status-band{border-left:4px solid var(--zcs_brand_color)}\n@media(max-width:1120px){.review-layout{grid-template-columns:1fr}.sticky-controls{position:static}.summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media(max-width:760px){.kyc-shell{padding:16px}.zcs-page-header{padding:16px;align-items:flex-start;flex-direction:column}.zcs-page-header&gt;div:last-child{width:100%;flex-wrap:wrap}.zcs-button{width:100%}.document-grid,.summary-grid{grid-template-columns:1fr}.metadata{grid-template-columns:1fr}.zcs-col-sm-12{flex:0 0 100%;max-width:100%}.workflow-frame{height:420px}}\n&lt;/style&gt;\n&lt;div class=&apos;kyc-page zcs-wh-full&apos;&gt;\n\t&lt;div class=&apos;kyc-shell zcs-flex zcs-direction-column zcs-gap-20 zcs-px-24 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;KYC review workspace&lt;/p&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-10&apos;&gt;&lt;h1 class=&apos;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;%=ifnull(customer.Company_Name,&quot;Business customer&quot;)%&gt;&lt;/h1&gt;&lt;span class=&apos;zcs-badge zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13&apos;&gt;&lt;%=customer.Customer_Type%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-yellow zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13&apos;&gt;&lt;%=customer.Onboarding_Status%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Customer &lt;%=customer.Customer_ID%&gt; | Submitted &lt;%=submitted_text%&gt;&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;&lt;%=customer_edit_url%&gt;&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;span&gt;Set approval terms&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;&lt;%=document_report_url%&gt;&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline files-3-search&apos;&gt;&lt;/i&gt;&lt;span&gt;Open review queue&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;section class=&apos;status-band zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-row-wrap&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Required-document progress&lt;/h2&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;&lt;%=received_count%&gt; received, &lt;%=verified_count%&gt; verified, &lt;%=required_count%&gt; required&lt;/p&gt;&lt;/div&gt;&lt;strong class=&apos;zcs-font-20 zcs-color-theme&apos;&gt;&lt;%=progress_percent%&gt;%&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=progress_percent%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-m-0&apos;&gt;&lt;span class=&apos;zcs-color-primary&apos;&gt;Verified versus required&lt;/span&gt;&lt;span class=&apos;zcs-color-primary&apos;&gt;&lt;%=verified_count%&gt; / &lt;%=required_count%&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&apos;summary-grid&apos;&gt;\n\t\t\t&lt;section class=&apos;summary-tile zcs-rounded-xl zcs-p-16 zcs-box-border&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-05 zcs-font-22 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-mt-8 zcs-mx-0 zcs-mb-0&apos;&gt;Customer&lt;/p&gt;&lt;strong class=&apos;zcs-font-15 zcs-color-primary&apos;&gt;&lt;%=customer.Full_Name%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;&lt;%=customer.Email_ID%&gt;&lt;/p&gt;&lt;/section&gt;\n\t\t\t&lt;section class=&apos;summary-tile zcs-rounded-xl zcs-p-16 zcs-box-border&apos;&gt;&lt;i class=&apos;zc-li-outline business-building zcs-font-22 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-mt-8 zcs-mx-0 zcs-mb-0&apos;&gt;Company identifiers&lt;/p&gt;&lt;strong class=&apos;zcs-font-15 zcs-color-primary&apos;&gt;GSTIN &lt;%=ifnull(customer.GSTIN,&quot;Not supplied&quot;)%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;PAN &lt;%=ifnull(customer.PAN_Number,&quot;Not supplied&quot;)%&gt;&lt;/p&gt;&lt;/section&gt;\n\t\t\t&lt;section class=&apos;summary-tile zcs-rounded-xl zcs-p-16 zcs-box-border&apos;&gt;&lt;i class=&apos;zc-li-outline business-coins zcs-font-22 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-mt-8 zcs-mx-0 zcs-mb-0&apos;&gt;Credit request&lt;/p&gt;&lt;strong class=&apos;zcs-font-15 zcs-color-primary&apos;&gt;INR &lt;%=ifnull(customer.Requested_Credit_Limit,0).round(2)%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Outstanding INR &lt;%=ifnull(customer.Outstanding_Balance,0).round(2)%&gt;&lt;/p&gt;&lt;/section&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;review-layout&apos;&gt;\n\t\t\t&lt;main class=&apos;zcs-flex zcs-direction-column zcs-gap-20&apos;&gt;\n\t\t\t\t&lt;section class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;section-heading zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-row-wrap&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Document checklist&lt;/h2&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Each file opens through an authenticated Creator record; no public file URL is exposed.&lt;/p&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge &lt;%=if(queried_count &gt; 0,&quot;zcs-badge-orange&quot;,&quot;zcs-badge-green&quot;)%&gt; zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13&apos;&gt;&lt;%=queried_count%&gt; flagged&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% if(documents.count(ID) &gt; 0) { %&gt;\n\t\t\t\t\t&lt;div class=&apos;document-grid&apos;&gt;\n\t\t\t\t\t\t&lt;% for each doc in documents {\n\t\t\t\t\t\t\t\tdoc_status = ifnull(doc.Review_Status,&quot;Pending Upload&quot;);\n\t\t\t\t\t\t\t\tstatus_class = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t\t\tstatus_icon = &quot;ui-2-time&quot;;\n\t\t\t\t\t\t\t\tif(doc_status == &quot;Verified&quot;) { status_class = &quot;zcs-badge-green&quot;; status_icon = &quot;ui-1-check-circle-08&quot;; }\n\t\t\t\t\t\t\t\telse if(doc_status == &quot;Query&quot;) { status_class = &quot;zcs-badge-orange&quot;; status_icon = &quot;travel-info&quot;; }\n\t\t\t\t\t\t\t\telse if(doc_status == &quot;Pending Verification&quot;) { status_class = &quot;zcs-badge-blue&quot;; status_icon = &quot;files-3-search&quot;; }\n\t\t\t\t\t\t\t\telse if(doc_status == &quot;Pending Upload&quot;) { status_class = &quot;zcs-badge-grey&quot;; status_icon = &quot;arrows-2-file-upload-86&quot;; }\n\t\t\t\t\t\t\t\trequired_text = if(doc.Required_For_Onboarding,&quot;Required&quot;,&quot;Optional&quot;);\n\t\t\t\t\t\t\t\tuploaded_text = &quot;Not uploaded&quot;;\n\t\t\t\t\t\t\t\tif(doc.Uploaded_On != null) { uploaded_text = doc.Uploaded_On.toString(&quot;dd-MMM-yyyy HH:mm&quot;); }\n\t\t\t\t\t\t\t\texpiry_text = &quot;Not required / not supplied&quot;;\n\t\t\t\t\t\t\t\tif(doc.Expiry_Date != null) { expiry_text = doc.Expiry_Date.toString(&quot;dd-MMM-yyyy&quot;); }\n\t\t\t\t\t\t\t\tdoc_edit_url = &quot;#Form:Customer_KYC_Documents?recLinkID=&quot; + doc.ID + &quot;&amp;viewLinkName=KYC_Review_Queue&amp;zc_LoadIn=dialog&quot;;\n\t\t\t\t\t\t\t\tdoc_queue_url = &quot;#Report:KYC_Review_Queue?KYC_Document_ID=&quot; + doc.KYC_Document_ID;\n\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;article class=&apos;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-card-header zcs-p-16 zcs-box-border zcs-relative&apos;&gt;&lt;h3 class=&apos;zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;%=doc.Document_Type.Document_Name%&gt;&lt;/h3&gt;&lt;span class=&apos;zcs-template-card-badge zcs-px-16 zcs-py-4 zcs-box-border zcs-font-11 zcs-color-white zcs-absolute&apos;&gt;&lt;%=required_text%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;span class=&apos;zcs-badge &lt;%=status_class%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=status_icon%&gt;&apos;&gt;&lt;/i&gt;&lt;%=doc_status%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Version &lt;%=doc.File_Version%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&apos;metadata&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;metadata-item&apos;&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Document number&lt;/span&gt;&lt;p class=&apos;zcs-font-14 zcs-font-medium zcs-color-primary zcs-m-0&apos;&gt;&lt;%=ifnull(doc.Document_Number,&quot;Not supplied&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;metadata-item&apos;&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Expiry&lt;/span&gt;&lt;p class=&apos;zcs-font-14 zcs-font-medium zcs-color-primary zcs-m-0&apos;&gt;&lt;%=expiry_text%&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;metadata-item&apos;&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Uploaded&lt;/span&gt;&lt;p class=&apos;zcs-font-14 zcs-font-medium zcs-color-primary zcs-m-0&apos;&gt;&lt;%=uploaded_text%&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;metadata-item&apos;&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Reviewed by&lt;/span&gt;&lt;p class=&apos;zcs-font-14 zcs-font-medium zcs-color-primary zcs-m-0&apos;&gt;&lt;%=ifnull(doc.Reviewed_By_Email,&quot;Not reviewed&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&apos;review-note &lt;%=if(doc_status == &quot;Query&quot;,&quot;query-note&quot;,&quot;&quot;)%&gt; zcs-p-12 zcs-rounded-md zcs-box-border&apos;&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Reviewer remarks&lt;/span&gt;&lt;p class=&apos;zcs-font-14 zcs-color-primary zcs-m-0&apos;&gt;&lt;%=ifnull(doc.Review_Remarks,&quot;No reviewer remarks&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-card-footer zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-10 zcs-p-10 zcs-box-border zcs-absolute&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-13&apos; href=&apos;&lt;%=doc_edit_url%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-2-file-download-87&apos;&gt;&lt;/i&gt;&lt;span&gt;Secure preview / download&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;% if(doc_status == &quot;Pending Verification&quot;) { %&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-13&apos; href=&apos;&lt;%=doc_queue_url%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline files-3-search&apos;&gt;&lt;/i&gt;&lt;span&gt;Run Verify / Query&lt;/span&gt;&lt;/a&gt;&lt;% } %&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/article&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } else { %&gt;&lt;div class=&apos;zcs-nodata-wrapper zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;i class=&apos;zc-li-outline files-3-search zcs-font-24 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-mb-0&apos;&gt;No KYC checklist records exist&lt;/h3&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;section-heading&apos;&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Pending document workflows&lt;/h2&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Enter reviewer remarks through Secure preview / download before selecting Query. Verify and Query execute the permitted KYC Review Queue report workflows.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;iframe class=&apos;workflow-frame&apos; src=&apos;&lt;%=document_queue_embed%&gt;&apos; title=&apos;Filtered KYC document workflow queue&apos;&gt;&lt;/iframe&gt;\n\t\t\t\t&lt;/section&gt;\n\t\t\t&lt;/main&gt;\n\n\t\t\t&lt;aside class=&apos;sticky-controls zcs-flex zcs-direction-column zcs-gap-20&apos;&gt;\n\t\t\t\t&lt;section class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;section-heading zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Approval and activation&lt;/h2&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Final values are captured on the customer before the report workflow activates the account.&lt;/p&gt;&lt;/div&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08 zcs-font-24 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-labelvalue-wrapper zcs-labelvalue-with-bg zcs-rounded-xl zcs-px-15 zcs-py-10 zcs-box-border&apos;&gt;&lt;ul class=&apos;zcs-row zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-row zcs-gap-8 zcs-col-12 zcs-px-15 zcs-py-10 zcs-box-border&apos;&gt;&lt;label class=&apos;zcs-col-6 zcs-font-14 zcs-color-tertiary&apos;&gt;Assigned rate card&lt;/label&gt;&lt;span class=&apos;zcs-col-6 zcs-font-14 zcs-font-medium zcs-color-primary&apos;&gt;&lt;%=rate_card_name%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-row zcs-gap-8 zcs-col-12 zcs-px-15 zcs-py-10 zcs-box-border&apos;&gt;&lt;label class=&apos;zcs-col-6 zcs-font-14 zcs-color-tertiary&apos;&gt;Approved credit limit&lt;/label&gt;&lt;span class=&apos;zcs-col-6 zcs-font-14 zcs-font-medium zcs-color-primary&apos;&gt;INR &lt;%=ifnull(customer.Approved_Credit_Limit,0).round(2)%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-row zcs-gap-8 zcs-col-12 zcs-px-15 zcs-py-10 zcs-box-border&apos;&gt;&lt;label class=&apos;zcs-col-6 zcs-font-14 zcs-color-tertiary&apos;&gt;Payment terms&lt;/label&gt;&lt;span class=&apos;zcs-col-6 zcs-font-14 zcs-font-medium zcs-color-primary&apos;&gt;&lt;%=customer.Payment_Terms%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-row zcs-gap-8 zcs-col-12 zcs-px-15 zcs-py-10 zcs-box-border&apos;&gt;&lt;label class=&apos;zcs-col-6 zcs-font-14 zcs-color-tertiary&apos;&gt;KYC verified date&lt;/label&gt;&lt;span class=&apos;zcs-col-6 zcs-font-14 zcs-font-medium zcs-color-primary&apos;&gt;&lt;%=verified_date_text%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-row zcs-gap-8 zcs-col-12 zcs-px-15 zcs-py-10 zcs-box-border&apos;&gt;&lt;label class=&apos;zcs-col-6 zcs-font-14 zcs-color-tertiary&apos;&gt;KYC expiry&lt;/label&gt;&lt;span class=&apos;zcs-col-6 zcs-font-14 zcs-font-medium zcs-color-primary&apos;&gt;&lt;%=expiry_date_text%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;/ul&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;&lt;%=customer_edit_url%&gt;&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;span&gt;Set approval terms&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;% if(approval_ready) { %&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;&lt;%=approval_report_url%&gt;&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;Open enabled Approve action&lt;/span&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;span class=&apos;zcs-button zcs-button-disabled zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-lock&apos;&gt;&lt;/i&gt;&lt;span&gt;Approve disabled: &lt;%=pending_count%&gt; required item(s) not verified&lt;/span&gt;&lt;/span&gt;&lt;% } %&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-notes-wrapper&apos;&gt;&lt;p class=&apos;zcs-notes-text zcs-m-0 zcs-font-13 zcs-color-primary&apos;&gt;&lt;span class=&apos;zcs-font-medium zcs-color-tertiary&apos;&gt;Control:&lt;/span&gt; The Approve report workflow re-checks every required item, stamps verification and expiry, writes Audit_Log and Communication_Log, and only then activates the customer.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;section-heading&apos;&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Flagged items for customer query&lt;/h2&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;The customer-level Query action is available only after one or more documents have Query status with remarks.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% if(queried_count &gt; 0) { %&gt;&lt;ul class=&apos;flag-list zcs-flex zcs-direction-column zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\t&lt;% for each flagged in Customer_KYC_Documents[Customer == customer_id &amp;&amp; Review_Status == &quot;Query&quot;] sort by Reviewed_On desc { %&gt;&lt;li class=&apos;flag-item zcs-flex zcs-direction-column zcs-gap-4 zcs-py-10&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;strong class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=flagged.Document_Type.Document_Name%&gt;&lt;/strong&gt;&lt;span class=&apos;zcs-badge zcs-badge-orange zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&apos;&gt;Query&lt;/span&gt;&lt;/div&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;&lt;%=ifnull(flagged.Review_Remarks,&quot;Remarks required&quot;)%&gt;&lt;/p&gt;&lt;/li&gt;&lt;% } %&gt;\n\t\t\t\t\t&lt;/ul&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;&lt;%=approval_report_url%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline travel-info&apos;&gt;&lt;/i&gt;&lt;span&gt;Open customer Query action&lt;/span&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;div class=&apos;zcs-nodata-wrapper zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-p-16&apos;&gt;&lt;h3 class=&apos;zcs-font-16 zcs-font-medium zcs-color-primary zcs-m-0&apos;&gt;No flagged items&lt;/h3&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Save document remarks, then run Query from the filtered document workflow queue.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;section-heading&apos;&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Customer decision workflow&lt;/h2&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Approve and customer Query execute from the filtered Verification Pending report.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;iframe class=&apos;workflow-frame decision-frame&apos; src=&apos;&lt;%=customer_queue_embed%&gt;&apos; title=&apos;Filtered customer KYC decision workflow&apos;&gt;&lt;/iframe&gt;\n\t\t\t\t&lt;/section&gt;\n\t\t\t&lt;/aside&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n}\nelse\n{\n%&gt;\n&lt;style&gt;\n:root{--zcs-page-bg-color:#F3F3F4;--zcs-white-color:#fff}.kyc-denied{min-height:100%;padding:24px;box-sizing:border-box;background:var(--zcs-page-bg-color);font-family:Arial,sans-serif}.kyc-denied-card{max-width:680px;margin:60px auto;padding:32px;text-align:center;background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;color:var(--zcs_primary_text_color)}.kyc-denied-card i{font-size:32px;color:var(--zcs_brand_color)}\n&lt;/style&gt;\n&lt;div class=&apos;kyc-denied&apos;&gt;&lt;div class=&apos;kyc-denied-card&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-lock&apos;&gt;&lt;/i&gt;&lt;h2&gt;KYC review unavailable&lt;/h2&gt;&lt;p&gt;Direct access was denied. The signed-in profile must be KYC_Reviewer or Logistics_Administrator, the Customer_ID must resolve to an existing record, and the customer must be Corporate or Wholesale.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n}\n%&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Shipment_Tracking(int Shipment_ID)
		{
					displayname = "Shipment Tracking"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Shipment_Tracking_Snippet' elementName='Shipment_Tracking_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Shipment_Tracking_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t\t&lt;%\nshipment_rows = Shipment_Requests[ID == input.Shipment_ID];\nshipment_found = shipment_rows.count(ID) &gt; 0;\ncurrent_profile = thisapp.permissions.loginUserProfile();\nis_internal = current_profile == &quot;Logistics_Administrator&quot; || current_profile == &quot;Operations_Manager&quot; || current_profile == &quot;Hub_Supervisor&quot; || current_profile == &quot;Hub_Operator&quot; || current_profile == &quot;Field_Agent&quot; || current_profile == &quot;Finance_Officer&quot;;\nauthorized = false;\nis_customer = false;\nif(shipment_found)\n{\n\t\tshipment = shipment_rows;\n\t\towner_email = ifnull(shipment.Customer.Portal_Login_Email,&quot;&quot;).trim();\n\t\tfallback_email = ifnull(shipment.Customer.Email_ID,&quot;&quot;).trim();\n\t\tis_customer = owner_email == zoho.loginuserid || fallback_email == zoho.loginuserid;\n\t\tauthorized = is_customer || is_internal;\n}\nif(shipment_found &amp;&amp; authorized)\n{\n\t\tshipment_id = shipment.ID;\n\t\tstatus = ifnull(shipment.Shipment_Status,&quot;Booked&quot;);\n\t\tvisible_events = Shipment_Tracking_Events[Shipment == shipment_id] sort by Event_Time desc;\n\t\tif(is_customer)\n\t\t{\n\t\t\t\tvisible_events = Shipment_Tracking_Events[Shipment == shipment_id &amp;&amp; Customer_Visible == true] sort by Event_Time desc;\n\t\t}\n\n\t\tbooked_reached = true;\n\t\tpicked_reached = Shipment_Tracking_Events[Shipment == shipment_id &amp;&amp; Event_Status == &quot;Picked Up&quot;].count(ID) &gt; 0;\n\t\ttransit_reached = Shipment_Tracking_Events[Shipment == shipment_id &amp;&amp; (Event_Status == &quot;In Transit&quot; || Event_Status == &quot;Inbound at Branch Station&quot; || Event_Status == &quot;Bagged &amp; Dispatched to Origin Hub&quot; || Event_Status == &quot;Sorted at Origin Hub&quot; || Event_Status == &quot;Arrived at Destination Hub&quot; || Event_Status == &quot;At Delivery Hub&quot;)].count(ID) &gt; 0;\n\t\tofd_reached = Shipment_Tracking_Events[Shipment == shipment_id &amp;&amp; Event_Status == &quot;Out For Delivery (OFD)&quot;].count(ID) &gt; 0;\n\t\tdelivered_reached = Shipment_Tracking_Events[Shipment == shipment_id &amp;&amp; Event_Status == &quot;Delivered&quot;].count(ID) &gt; 0 || status == &quot;Delivered&quot;;\n\t\tif(status == &quot;Picked Up&quot;) { picked_reached = true; }\n\t\tif(status == &quot;Inbound at Branch Station&quot; || status == &quot;Bagged &amp; Dispatched to Origin Hub&quot; || status == &quot;Sorted at Origin Hub&quot; || status == &quot;In Transit&quot; || status == &quot;Arrived at Destination Hub&quot; || status == &quot;At Delivery Hub&quot;) { picked_reached = true; transit_reached = true; }\n\t\tif(status == &quot;Out For Delivery (OFD)&quot;) { picked_reached = true; transit_reached = true; ofd_reached = true; }\n\t\tif(delivered_reached) { picked_reached = true; transit_reached = true; ofd_reached = true; }\n\t\tcurrent_step = 1;\n\t\tif(picked_reached) { current_step = 2; }\n\t\tif(transit_reached) { current_step = 3; }\n\t\tif(ofd_reached) { current_step = 4; }\n\t\tif(delivered_reached) { current_step = 5; }\n\t\tprogress_percent = current_step * 20;\n\n\t\torigin_name = &quot;Assignment pending&quot;;\n\t\tif(shipment.Origin_Sorting_Hub != null) { origin_name = shipment.Origin_Sorting_Hub.Hub_Name; }\n\t\telse if(shipment.Collection_Center != null) { origin_name = shipment.Collection_Center.Hub_Name; }\n\t\tdestination_name = &quot;Assignment pending&quot;;\n\t\tif(shipment.Destination_Hub != null) { destination_name = shipment.Destination_Hub.Hub_Name; }\n\t\telse if(shipment.Destination_Sorting_Hub != null) { destination_name = shipment.Destination_Sorting_Hub.Hub_Name; }\n\t\tcurrent_hub_name = &quot;In network transit&quot;;\n\t\tif(shipment.Current_Hub != null) { current_hub_name = shipment.Current_Hub.Hub_Name; }\n\t\telse\n\t\t{\n\t\t\t\thub_context = Shipment_Tracking_Events[Shipment == shipment_id &amp;&amp; Hub != null] sort by Event_Time desc range from 0 to 0;\n\t\t\t\tif(hub_context.count(ID) &gt; 0) { current_hub_name = hub_context.Hub.Hub_Name; }\n\t\t}\n\n\t\tmanifest_number = &quot;Not currently manifested&quot;;\n\t\tmanifest_status = &quot;Not available&quot;;\n\t\tmanifest_event = Shipment_Tracking_Events[Shipment == shipment_id &amp;&amp; Manifest != null] sort by Event_Time desc range from 0 to 0;\n\t\tif(manifest_event.count(ID) &gt; 0)\n\t\t{\n\t\t\t\tmanifest_number = manifest_event.Manifest.Manifest_Number;\n\t\t\t\tmanifest_status = manifest_event.Manifest.Manifest_Status;\n\t\t}\n\t\tbag_number = &quot;Not currently bagged&quot;;\n\t\tbag_status = &quot;Not available&quot;;\n\t\tbag_event = Shipment_Tracking_Events[Shipment == shipment_id &amp;&amp; Bag != null] sort by Event_Time desc range from 0 to 0;\n\t\tif(bag_event.count(ID) &gt; 0)\n\t\t{\n\t\t\t\tbag_number = bag_event.Bag.Bag_Number;\n\t\t\t\tbag_status = bag_event.Bag.Bag_Status;\n\t\t}\n\n\t\tpayment_badge = &quot;zcs-badge-yellow&quot;;\n\t\tpayment_icon = &quot;ui-2-time&quot;;\n\t\tif(shipment.Payment_Status == &quot;Paid&quot; || shipment.Payment_Status == &quot;Not Required&quot;) { payment_badge = &quot;zcs-badge-green&quot;; payment_icon = &quot;ui-1-check-circle-08&quot;; }\n\t\telse if(shipment.Payment_Status == &quot;Failed&quot;) { payment_badge = &quot;zcs-badge-red&quot;; payment_icon = &quot;ui-1-circle-remove&quot;; }\n\t\tstatus_badge = &quot;zcs-badge-blue&quot;;\n\t\tstatus_icon = &quot;loader-dots-06&quot;;\n\t\tif(delivered_reached) { status_badge = &quot;zcs-badge-green&quot;; status_icon = &quot;ui-1-check-circle-08&quot;; }\n\t\telse if(status == &quot;Delivery Failed - NDR&quot; || status == &quot;Credit Hold&quot; || status == &quot;Return to Origin&quot; || status == &quot;Cancelled&quot;) { status_badge = &quot;zcs-badge-orange&quot;; status_icon = &quot;travel-info&quot;; }\n\n\t\texception_event = Shipment_Tracking_Events[Shipment == shipment_id &amp;&amp; Event_Status == &quot;Exception&quot;] sort by Event_Time desc range from 0 to 0;\n\t\thas_exception = exception_event.count(ID) &gt; 0;\n\t\tif(is_customer)\n\t\t{\n\t\t\t\texception_event = Shipment_Tracking_Events[Shipment == shipment_id &amp;&amp; Event_Status == &quot;Exception&quot; &amp;&amp; Customer_Visible == true] sort by Event_Time desc range from 0 to 0;\n\t\t\t\thas_exception = exception_event.count(ID) &gt; 0;\n\t\t}\n\n\t\tofd_item = Delivery_Run_Sheet_Items[Shipment == shipment_id &amp;&amp; Delivery_Status == &quot;Out For Delivery&quot;] sort by Stop_Sequence asc range from 0 to 0;\n\t\tlatest_latitude = null;\n\t\tlatest_longitude = null;\n\t\tlatest_location_at = null;\n\t\tstops_remaining = null;\n\t\tif(ofd_item.count(ID) &gt; 0)\n\t\t{\n\t\t\t\tif(ofd_item.Agent_Latitude != null &amp;&amp; ofd_item.Agent_Longitude != null)\n\t\t\t\t{\n\t\t\t\t\t\tlatest_latitude = ofd_item.Agent_Latitude;\n\t\t\t\t\t\tlatest_longitude = ofd_item.Agent_Longitude;\n\t\t\t\t\t\tlatest_location_at = ofd_item.Arrived_At;\n\t\t\t\t}\n\t\t\t\tstops_remaining = Delivery_Run_Sheet_Items[Delivery_Run_Sheet == ofd_item.Delivery_Run_Sheet &amp;&amp; Stop_Sequence &gt; ofd_item.Stop_Sequence &amp;&amp; (Delivery_Status == &quot;Assigned&quot; || Delivery_Status == &quot;Out For Delivery&quot;)].count(ID);\n\t\t\t\tif(latest_latitude == null || latest_longitude == null)\n\t\t\t\t{\n\t\t\t\t\t\trun_record = Delivery_Run_Sheets[ID == ofd_item.Delivery_Run_Sheet];\n\t\t\t\t\t\tif(run_record.count(ID) &gt; 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tassigned_agent = Operations_Users[ID == run_record.Assigned_Agent &amp;&amp; Active == true];\n\t\t\t\t\t\t\t\tif(assigned_agent.count(ID) &gt; 0 &amp;&amp; assigned_agent.Current_Latitude != null &amp;&amp; assigned_agent.Current_Longitude != null)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tlatest_latitude = assigned_agent.Current_Latitude;\n\t\t\t\t\t\t\t\t\t\tlatest_longitude = assigned_agent.Current_Longitude;\n\t\t\t\t\t\t\t\t\t\tlatest_location_at = assigned_agent.Last_Location_At;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t}\n\t\tif(status == &quot;Out For Delivery (OFD)&quot; &amp;&amp; (latest_latitude == null || latest_longitude == null))\n\t\t{\n\t\t\t\tlocation_event = Shipment_Tracking_Events[Shipment == shipment_id &amp;&amp; Event_Status == &quot;Out For Delivery (OFD)&quot; &amp;&amp; Latitude != null &amp;&amp; Longitude != null] sort by Event_Time desc range from 0 to 0;\n\t\t\t\tif(location_event.count(ID) &gt; 0)\n\t\t\t\t{\n\t\t\t\t\t\tlatest_latitude = location_event.Latitude;\n\t\t\t\t\t\tlatest_longitude = location_event.Longitude;\n\t\t\t\t\t\tlatest_location_at = location_event.Event_Time;\n\t\t\t\t}\n\t\t}\n\t\tmap_url = &quot;&quot;;\n\t\tif(latest_latitude != null &amp;&amp; latest_longitude != null) { map_url = &quot;https://www.google.com/maps/search/?api=1&amp;query=&quot; + latest_latitude + &quot;,&quot; + latest_longitude; }\n\n\t\tdelivered_item = Delivery_Run_Sheet_Items[Shipment == shipment_id &amp;&amp; Delivery_Status == &quot;Delivered&quot;] sort by Completed_At desc range from 0 to 0;\n\t\tdelivered_recipient = &quot;Not recorded&quot;;\n\t\tdelivered_at = null;\n\t\tproof_type = &quot;Electronic proof&quot;;\n\t\tepod_url = ifnull(shipment.EPOD_Download_URL,&quot;&quot;);\n\t\tif(delivered_item.count(ID) &gt; 0)\n\t\t{\n\t\t\t\tdelivered_recipient = ifnull(delivered_item.Recipient_Name,&quot;Not recorded&quot;);\n\t\t\t\tdelivered_at = delivered_item.Completed_At;\n\t\t\t\tproof_type = ifnull(delivered_item.Proof_Type,&quot;Electronic proof&quot;);\n\t\t\t\tif(epod_url == &quot;&quot;) { epod_url = ifnull(delivered_item.EPOD_URL,&quot;&quot;); }\n\t\t}\n\t\texpected_text = &quot;Delivery estimate pending&quot;;\n\t\tif(shipment.Expected_Delivery_Date != null) { expected_text = shipment.Expected_Delivery_Date.toString(&quot;dd-MMM-yyyy&quot;); }\n\t\ttracking_report = if(is_customer,&quot;Customer_Tracking_Events&quot;,&quot;Shipment_Timeline&quot;);\n%&gt;\n&lt;style&gt;\n/* zcs-global.css: page-scoped, deduplicated utilities used by this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#F3F3F4;--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-row-wrap{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-col-2{flex:0 0 16.666%;max-width:16.666%}.zcs-col-10{flex:0 0 83.333%;max-width:83.333%}.zcs-col-12{flex:0 0 100%;max-width:100%}.zcs-gap-0{gap:0}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-gap-32{gap:2rem}.zcs-p-0{padding:0}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-px-60{padding-left:3.75rem;padding-right:3.75rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-20{padding-top:1.25rem;padding-bottom:1.25rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-5{margin-top:.3125rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mb-0{margin-bottom:0}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-color-white{color:#fff}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-no-shrink{flex-shrink:0}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}\n/* ZCS component CSS: card-fleet-trip-summary-card, stepper-in-progress, timeline-timeline-advanced, badge-badge-with-icon, button-primary-button, label-value-key-value-with-icon, banner-outline-banner-with-icon, no-data-no-data-text-only */\n.zcs-page{min-height:100%;background:var(--zcs-page-bg-color);font-family:Arial,sans-serif}.tracking-shell{max-width:1440px;margin:0 auto}.awb-header{background:linear-gradient(125deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));color:var(--zcs_brand_foreground_color);border:0}.awb-header .zcs-color-primary,.awb-header .zcs-color-tertiary{color:var(--zcs_brand_foreground_color)}.control-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(310px,1fr);gap:20px}.context-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.section-title{border-bottom:1px solid var(--zcs_tertiary_border_color);padding-bottom:12px}.route-band{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px}.route-node:last-child{text-align:right}.route-line{height:1px;min-width:80px;background:var(--zcs_tertiary_border_color)}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}.zcs-stepper-status{width:32px;height:32px;background:var(--zcs_brand_color);border:4px solid var(--zcs-white-color)}.zcs-stepper-count{display:none}.zcs-stepper-icon.zcs-stepper-failed{display:none}.zcs-stepper-level{display:none}.zcs-stepper:not(:last-child):before{content:&apos;&apos;;width:100%;height:1px;border-top:1px solid var(--zcs_brand_color);box-sizing:border-box;position:absolute;top:15px;left:50%}.zcs-stepper-active .zcs-stepper-status{border:1px solid var(--zcs_brand_color);outline:4px solid var(--zcs-white-color);background:var(--zcs-white-color)}.zcs-stepper-active .zcs-stepper-count{display:flex;border:0;color:var(--zcs_brand_color)}.zcs-stepper-active .zcs-stepper-icon{display:none}.zcs-stepper-active .zcs-stepper-text{font-weight:500;color:var(--zcs_brand_color)}.zcs-stepper-active:before,.zcs-stepper-active~.zcs-stepper:before{border-color:var(--zcs_tertiary_border_color)}.zcs-stepper-active~.zcs-stepper .zcs-stepper-status{background:var(--zcs-white-color)}.zcs-stepper-active~.zcs-stepper .zcs-stepper-count{display:flex}.zcs-stepper-active~.zcs-stepper .zcs-stepper-icon{display:none}.zcs-stepper-active~.zcs-stepper .zcs-stepper-text{color:var(--zcs_tertiary_text_color)}.zcs-tl-indicator{width:60px;left:16.666%}.zcs-tl-dot{width:12px;height:12px;background:var(--zcs_brand_color);border:1px solid #fff;box-shadow:0 2px 6px #C4DEE4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:&apos;&apos;;position:absolute;width:1px;height:calc(100% + 32px);background:#E1E1E1;top:5px}.zcs-badge{width:auto;border:1px solid}.zcs-badge-green{background:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-red{background:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-yellow{background:#FCF4E6;border-color:#FAAE13;color:#9a6700}.zcs-badge-blue{background:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-orange{background:#F8F0EB;border-color:#F4660C;color:#F4660C}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-button:hover{filter:brightness(.96)}.zcs-outline-toast{border:1px solid}.zcs-theme-toast{background:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color)}.zcs-warning-toast{background:#fef4e5;color:#663c01;border-color:#edb25b}.map-ready{min-height:190px;background:linear-gradient(145deg,var(--zcs_component_hover_color),#fff);border:1px dashed var(--zcs_brand_color);overflow:hidden}.map-grid{background-image:linear-gradient(var(--zcs_tertiary_border_color) 1px,transparent 1px),linear-gradient(90deg,var(--zcs_tertiary_border_color) 1px,transparent 1px);background-size:28px 28px}.integration-note{border-top:1px solid var(--zcs_tertiary_border_color);padding-top:10px}.timeline-empty{min-height:180px}.amount{font-variant-numeric:tabular-nums}.epod-card{border-left:4px solid var(--zcs_brand_color)}\n@media(max-width:992px){.control-grid{grid-template-columns:1fr}.context-grid{grid-template-columns:1fr 1fr}.zcs-tl-li{flex-direction:column}.zcs-tl-indicator{left:0}.zcs-tl-time{text-align:left;padding:0 60px;margin-bottom:12px}.zcs-tl-li&gt;div:last-child{max-width:100%;padding-left:60px;padding-right:0}}\n@media(max-width:575px){.tracking-shell{padding:16px}.awb-header{align-items:flex-start;flex-direction:column}.context-grid{grid-template-columns:1fr}.route-band{grid-template-columns:1fr}.route-node:last-child{text-align:left}.route-line{display:none}.zcs-stepper-wrapper ul{flex-direction:column;gap:24px}.zcs-stepper-wrapper ul .zcs-stepper{flex-direction:row;gap:16px}.zcs-stepper:not(:last-child):before{width:1px;height:100%;border-left:1px solid var(--zcs_brand_color);border-top:0;left:15px}.zcs-button{width:100%}.zcs-tl-time{padding-left:44px}.zcs-tl-li&gt;div:last-child{padding-left:44px}}\n&lt;/style&gt;\n&lt;div class=&apos;zcs-page zcs-wh-full&apos;&gt;\n\t&lt;div class=&apos;tracking-shell zcs-flex zcs-direction-column zcs-gap-20 zcs-px-24 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;section class=&apos;awb-header zcs-card zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-20 zcs-p-24 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Live shipment control tower&lt;/p&gt;\n\t\t\t\t&lt;h1 class=&apos;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;AWB &lt;%=shipment.AWB_Number%&gt;&lt;/h1&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;&lt;%=shipment.Pickup_Pincode%&gt; to &lt;%=shipment.Delivery_Pincode%&gt; | &lt;%=shipment.Transport_Mode%&gt;&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-10&apos;&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge &lt;%=status_badge%&gt; zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=status_icon%&gt;&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-14&apos;&gt;&lt;%=status%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge &lt;%=payment_badge%&gt; zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=payment_icon%&gt;&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-14&apos;&gt;&lt;%=shipment.Payment_Type%&gt;: &lt;%=shipment.Payment_Status%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;% if(has_exception) { %&gt;\n\t\t&lt;div class=&apos;zcs-toast zcs-outline-toast zcs-warning-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14&apos;&gt;\n\t\t\t&lt;i class=&apos;zcs-no-shrink zcs-lh-body zc-li-outline travel-info&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;p class=&apos;zcs-m-0&apos;&gt;&lt;strong&gt;Delivery update:&lt;/strong&gt; This shipment needs attention. Our operations team is working on the next safe movement. Customer-facing tracking intentionally excludes internal exception notes.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;% } %&gt;\n\n\t\t&lt;section class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-20 zcs-p-24 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-row-wrap&apos;&gt;\n\t\t\t\t&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Shipment milestones&lt;/h2&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Built from shipment tracking events&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;strong class=&apos;zcs-font-14 zcs-color-theme&apos;&gt;&lt;%=progress_percent%&gt;% complete&lt;/strong&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=progress_percent%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-stepper-wrapper&apos;&gt;\n\t\t\t\t&lt;ul class=&apos;zcs-flex zcs-gap-8 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t&lt;% milestone_names = {&quot;Booked&quot;,&quot;Picked Up&quot;,&quot;In Transit&quot;,&quot;Out For Delivery&quot;,&quot;Delivered&quot;}; for each index i in milestone_names { step_number = i + 1; active_class = if(step_number == current_step,&quot;zcs-stepper-active&quot;,&quot;&quot;); %&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-stepper &lt;%=active_class%&gt; zcs-col-common zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-4 zcs-text-center zcs-relative&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-stepper-status zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-text-center zcs-relative zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t&lt;h6 class=&apos;zcs-stepper-count zcs-col-common zcs-w-full zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-12 zcs-font-semibold zcs-color-tertiary zcs-m-0&apos;&gt;&lt;%=step_number%&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t&lt;i class=&apos;zcs-stepper-icon zcs-stepper-passed zcs-font-18 zcs-font-bold zcs-color-white zc-li-outline ui-1-check-small&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t&lt;i class=&apos;zcs-stepper-icon zcs-stepper-failed zcs-font-18 zcs-color-white zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-stepper-level zcs-rounded-half&apos;&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-stepper-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=milestone_names.get(i)%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&apos;control-grid&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-20&apos;&gt;\n\t\t\t\t&lt;section class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;section-title zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-row-wrap&apos;&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Detailed event timeline&lt;/h2&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;&lt;%=visible_events.count(ID)%&gt; visible updates&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-13&apos; href=&apos;#Report:&lt;%=tracking_report%&gt;?Shipment=&lt;%=shipment_id%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-2-time&apos;&gt;&lt;/i&gt;&lt;span&gt;Open tracking report&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% if(visible_events.count(ID) &gt; 0) { %&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-timeline-wrapper&apos;&gt;&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\t&lt;% for each event in visible_events { event_message = ifnull(event.Event_Description,&quot;Shipment status updated.&quot;); if(is_customer &amp;&amp; event.Event_Status == &quot;Exception&quot;) { event_message = &quot;A delivery update needs attention. Our team is working on it.&quot;; } event_hub = &quot;Network update&quot;; if(event.Hub != null) { event_hub = event.Hub.Hub_Name; } %&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&apos;&gt;&lt;span class=&apos;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&apos;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-col-2 zcs-tl-time zcs-font-13 zcs-color-tertiary zcs-text-right&apos;&gt;&lt;%=if(event.Event_Time != null,event.Event_Time.toString(&quot;dd-MMM-yyyy HH:mm&quot;),&quot;Time pending&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&apos;&gt;&lt;h3 class=&apos;zcs-font-16 zcs-font-medium zcs-color-primary zcs-m-0&apos;&gt;&lt;%=event.Event_Status%&gt;&lt;/h3&gt;&lt;span class=&apos;zcs-badge zcs-badge-blue zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=event_hub%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&apos;&gt;&lt;%=event_message%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;% if(event.Manifest != null || event.Bag != null) { %&gt;&lt;p class=&apos;zcs-font-12 zcs-color-tertiary zcs-mt-8 zcs-mx-0 zcs-mb-0&apos;&gt;&lt;%=if(event.Manifest != null,&quot;Manifest &quot; + event.Manifest.Manifest_Number,&quot;&quot;)%&gt;&lt;%=if(event.Manifest != null &amp;&amp; event.Bag != null,&quot; | &quot;,&quot;&quot;)%&gt;&lt;%=if(event.Bag != null,&quot;Bag &quot; + event.Bag.Bag_Number,&quot;&quot;)%&gt;&lt;/p&gt;&lt;% } %&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t&lt;/ul&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% } else { %&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-nodata-wrapper timeline-empty zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-2-time zcs-font-30 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-mb-0&apos;&gt;No tracking updates available yet&lt;/h3&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/section&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;aside class=&apos;zcs-flex zcs-direction-column zcs-gap-20&apos;&gt;\n\t\t\t\t&lt;section class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;h2 class=&apos;section-title zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Delivery summary&lt;/h2&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-labelvalue-wrapper&apos;&gt;&lt;ul class=&apos;zcs-row zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12 zcs-px-12 zcs-py-10 zcs-box-border&apos;&gt;&lt;label class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Expected delivery&lt;/label&gt;&lt;div class=&apos;zcs-flex zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time zcs-color-primary&apos;&gt;&lt;/i&gt;&lt;strong class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=expected_text%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12 zcs-px-12 zcs-py-10 zcs-box-border&apos;&gt;&lt;label class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Amount and payment&lt;/label&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;span class=&apos;amount zcs-font-16 zcs-font-semibold zcs-color-primary&apos;&gt;INR &lt;%=ifnull(shipment.Total_Payable,0).round(2)%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge &lt;%=payment_badge%&gt; zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=shipment.Payment_Status%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12 zcs-px-12 zcs-py-10 zcs-box-border&apos;&gt;&lt;label class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Package&lt;/label&gt;&lt;div class=&apos;zcs-flex zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline box-3d-50 zcs-color-primary&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=shipment.Package_Count%&gt; package(s), &lt;%=ifnull(shipment.Billable_Weight_Kg,0)%&gt; kg billable&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;/ul&gt;&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;h2 class=&apos;section-title zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Hub and custody context&lt;/h2&gt;\n\t\t\t\t\t&lt;div class=&apos;route-band&apos;&gt;&lt;div class=&apos;route-node&apos;&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Origin&lt;/span&gt;&lt;p class=&apos;zcs-font-14 zcs-font-medium zcs-color-primary zcs-m-0&apos;&gt;&lt;%=origin_name%&gt;&lt;/p&gt;&lt;/div&gt;&lt;div class=&apos;route-line&apos;&gt;&lt;/div&gt;&lt;div class=&apos;route-node&apos;&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Destination&lt;/span&gt;&lt;p class=&apos;zcs-font-14 zcs-font-medium zcs-color-primary zcs-m-0&apos;&gt;&lt;%=destination_name%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;context-grid&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-6 zcs-p-16 zcs-box-border&apos;&gt;&lt;i class=&apos;zc-li-outline location-pin zcs-font-20 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Current hub&lt;/span&gt;&lt;strong class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=current_hub_name%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-6 zcs-p-16 zcs-box-border&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast zcs-font-20 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Manifest&lt;/span&gt;&lt;strong class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=manifest_number%&gt;&lt;/strong&gt;&lt;small class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;%=manifest_status%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-6 zcs-p-16 zcs-box-border&apos;&gt;&lt;i class=&apos;zc-li-outline box-3d-50 zcs-font-20 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Bag&lt;/span&gt;&lt;strong class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=bag_number%&gt;&lt;/strong&gt;&lt;small class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;%=bag_status%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;% if(status == &quot;Out For Delivery (OFD)&quot;) { %&gt;\n\t\t\t\t&lt;section class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Out for delivery&lt;/h2&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Latest available field update&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% if(latest_latitude != null &amp;&amp; latest_longitude != null) { %&gt;\n\t\t\t\t\t&lt;div class=&apos;map-ready map-grid zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-lg zcs-p-20 zcs-box-border&apos; data-latitude=&apos;&lt;%=latest_latitude%&gt;&apos; data-longitude=&apos;&lt;%=latest_longitude%&gt;&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zc-li-solid location-pin zcs-font-30 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;strong class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=latest_latitude%&gt;, &lt;%=latest_longitude%&gt;&lt;/strong&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;%=if(latest_location_at != null,&quot;Updated &quot; + latest_location_at.toString(&quot;dd-MMM-yyyy HH:mm&quot;),&quot;Latest recorded position&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md zcs-font-13&apos; href=&apos;&lt;%=map_url%&gt;&apos; target=&apos;_blank&apos;&gt;&lt;i class=&apos;zc-li-outline business-globe&apos;&gt;&lt;/i&gt;&lt;span&gt;Open map&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } else { %&gt;&lt;div class=&apos;zcs-toast zcs-outline-toast zcs-theme-toast zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm&apos;&gt;&lt;i class=&apos;zc-li-outline location-pin&apos;&gt;&lt;/i&gt;&lt;p class=&apos;zcs-font-14 zcs-m-0&apos;&gt;A live position has not been received. Shipment milestones remain available.&lt;/p&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-color-tertiary&apos;&gt;Stops remaining&lt;/span&gt;&lt;strong class=&apos;zcs-font-20 zcs-color-primary&apos;&gt;&lt;%=if(stops_remaining != null,stops_remaining,&quot;Not available&quot;)%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;p class=&apos;integration-note zcs-font-12 zcs-color-tertiary zcs-m-0&apos;&gt;This panel is native map-widget-ready. Continuous background tracking remains an integration point and is not inferred when a fresh location is unavailable.&lt;/p&gt;\n\t\t\t\t&lt;/section&gt;\n\t\t\t\t&lt;% } %&gt;\n\n\t\t\t\t&lt;% if(delivered_reached) { %&gt;\n\t\t\t\t&lt;section class=&apos;epod-card zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08 zcs-font-24 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Delivered&lt;/h2&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;&lt;%=if(delivered_at != null,delivered_at.toString(&quot;dd-MMM-yyyy HH:mm&quot;),&quot;Delivery timestamp pending&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-labelvalue-wrapper&apos;&gt;&lt;ul class=&apos;zcs-row zcs-p-0 zcs-m-0&apos;&gt;&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12 zcs-py-10&apos;&gt;&lt;label class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Received by&lt;/label&gt;&lt;div class=&apos;zcs-flex zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-05 zcs-color-primary&apos;&gt;&lt;/i&gt;&lt;strong class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=delivered_recipient%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;/li&gt;&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12 zcs-py-10&apos;&gt;&lt;label class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Proof type&lt;/label&gt;&lt;div class=&apos;zcs-flex zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline files-3-pdf zcs-color-primary&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=proof_type%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% if(epod_url != &quot;&quot;) { %&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;&lt;%=epod_url%&gt;&apos; target=&apos;_blank&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline files-3-pdf&apos;&gt;&lt;/i&gt;&lt;span&gt;Download ePOD&lt;/span&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;div class=&apos;zcs-toast zcs-outline-toast zcs-theme-toast zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;p class=&apos;zcs-font-14 zcs-m-0&apos;&gt;The ePOD file is being finalized. Delivery confirmation remains recorded.&lt;/p&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t\t\t&lt;/section&gt;\n\t\t\t\t&lt;% } %&gt;\n\t\t\t&lt;/aside&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n}\nelse\n{\n%&gt;\n&lt;style&gt;\n:root{--zcs-page-bg-color:#F3F3F4;--zcs-white-color:#fff}.zcs-page{min-height:100%;padding:24px;box-sizing:border-box;background:var(--zcs-page-bg-color);font-family:Arial,sans-serif}.zcs-card{max-width:680px;margin:60px auto;padding:32px;text-align:center;background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;color:var(--zcs_primary_text_color)}.zcs-card i{font-size:32px;color:var(--zcs_brand_color)}\n&lt;/style&gt;\n&lt;div class=&apos;zcs-page&apos;&gt;&lt;div class=&apos;zcs-card&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-lock&apos;&gt;&lt;/i&gt;&lt;h2&gt;Shipment unavailable&lt;/h2&gt;&lt;p&gt;The shipment could not be shown. Customer access requires the signed-in email to match the shipment owner; internal access follows the assigned Creator profile and record permissions.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n}\n%&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Account_Ledger_On_Delete as "Protect Account Ledger"
			{
			    type = form
			    form = Account_Ledger
			    record event = on delete
			    description = "Prevents deletion of financial ledger evidence"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                alert "Ledger entries cannot be deleted. Post an authorised reversing entry instead.";
			                cancel delete;
			            )
			        }
			    }
			}

			Account_Ledger_On_Load as "Secure Account Ledger Load"
			{
			    type = form
			    form = Account_Ledger
			    record event = on add or edit
			    description = "Protects system fields and limits manual ledger posting to authorised finance users"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Transaction_Date, Ageing_Bucket, Posted_By_Email, Customer_Login_Email;
			                current_profile = thisapp.permissions.loginUserProfile();
			                is_portal = thisapp.portal.isUserInProfile("Customer_Portal");
			                if(is_portal == true)
			                {
			                    disable Customer, Shipment, Invoice, Transaction_Type, Amount, Due_Date, Ledger_Status, Payment_Reference, Notes;
			                    alert "Ledger entries are posted by authorised finance processes.";
			                }
			                else if(input.ID != null)
			                {
			                    disable Customer, Shipment, Invoice, Transaction_Type, Amount, Transaction_Date, Due_Date, Payment_Reference, Posted_By_Email, Customer_Login_Email;
			                    if(current_profile != "Logistics_Administrator" && current_profile != "Finance_Officer")
			                    {
			                        disable Ledger_Status, Notes;
			                    }
			                }
			                else if(current_profile == "Logistics_Administrator" || current_profile == "Finance_Officer")
			                {
			                    input.Transaction_Type = "Adjustment";
			                    input.Ledger_Status = "Open";
			                }
			                else
			                {
			                    disable Customer, Shipment, Invoice, Transaction_Type, Amount, Due_Date, Ledger_Status, Payment_Reference, Notes;
			                    alert "Only Logistics Administrators and Finance Officers can post manual ledger entries.";
			                }
			            )
			        }
			    }
			}

			Account_Ledger_On_Success as "Post Account Ledger Entry"
			{
			    type = form
			    form = Account_Ledger
			    record event = on add or edit
			    description = "Recomputes customer exposure, releases eligible credit holds after payment, and audits adjustments"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                customer_record = Customers[ID == input.Customer];
			                prior_outstanding = ifnull(customer_record.Outstanding_Balance,0);
			                recalculated_outstanding = thisapp.Recalculate_Customer_Outstanding(input.Customer);
			                current_profile = thisapp.permissions.loginUserProfile();
			                if(input.Transaction_Type == "Adjustment")
			                {
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuserid
			                        Actor_Profile = current_profile
			                        Action_Name = "Post Account Adjustment"
			                        Module_Name = "Account Ledger"
			                        Record_ID = input.ID.toString()
			                        Before_Data = "Customer outstanding=" + prior_outstanding
			                        After_Data = "Adjustment=" + input.Amount + "; Customer outstanding=" + recalculated_outstanding + "; Reference=" + input.Payment_Reference
			                        Source = "Finance Correction"
			                        Severity = "Critical"
			                    ];
			                }
			                if(input.Transaction_Type == "Payment" && input.Ledger_Status == "Settled" && customer_record.Onboarding_Status == "Active" && (customer_record.KYC_Expiry_Date == null || customer_record.KYC_Expiry_Date >= zoho.currentdate))
			                {
			                    projected_exposure = recalculated_outstanding;
			                    held_shipments = Shipment_Requests[Customer == input.Customer && Shipment_Status == "Credit Hold" && Credit_Check_Status == "Hold"] sort by Booked_On range from 0 to 199;
			                    for each held_shipment in held_shipments
			                    {
			                        proposed_exposure = projected_exposure + ifnull(held_shipment.Total_Payable,0);
			                        if(proposed_exposure <= ifnull(customer_record.Approved_Credit_Limit,0))
			                        {
			                            held_shipment.Credit_Check_Status = "Passed";
			                            held_shipment.Shipment_Status = if(held_shipment.Collection_Center == null,"Booked - Hub Assignment Pending","Booked");
			                            projected_exposure = proposed_exposure;
			                            tracking_id = insert into Shipment_Tracking_Events
			                            [
			                                Shipment = held_shipment.ID
			                                Event_Time = zoho.currenttime
			                                Event_Status = held_shipment.Shipment_Status
			                                Hub = held_shipment.Current_Hub
			                                Event_Description = "Credit hold released after verified payment reduced account exposure."
			                                Source = "Account Ledger"
			                                Customer_Visible = true
			                                Created_By_Email = zoho.loginuserid
			                            ];
			                            audit_id = insert into Audit_Log
			                            [
			                                Event_Time = zoho.currenttime
			                                Actor_Email = zoho.loginuserid
			                                Actor_Profile = current_profile
			                                Action_Name = "Release Credit Hold"
			                                Module_Name = "Shipment Requests"
			                                Record_ID = held_shipment.ID.toString()
			                                Before_Data = "Status=Credit Hold"
			                                After_Data = "Status=" + held_shipment.Shipment_Status + "; Projected exposure=" + projected_exposure
			                                Source = "Payment Reconciliation"
			                                Severity = "Warning"
			                            ];
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Account_Ledger_On_Validate as "Validate Account Ledger Entry"
			{
			    type = form
			    form = Account_Ledger
			    record event = on add or edit
			    description = "Validates ledger signs, references, ownership, ageing, and immutable posting fields"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                is_portal = thisapp.portal.isUserInProfile("Customer_Portal");
			                if(is_portal == true)
			                {
			                    alert "Customer portal users cannot post or edit ledger entries.";
			                    cancel submit;
			                }
			                else
			                {
			                    customer_record = Customers[ID == input.Customer];
			                    if(customer_record.count(ID) == 0)
			                    {
			                        alert "Select a valid customer.";
			                        cancel submit;
			                    }
			                    else
			                    {
			                        if(input.Transaction_Type == "Adjustment")
			                        {
			                            if(ifnull(input.Amount,0) == 0)
			                            {
			                                alert "An adjustment amount must be non-zero.";
			                                cancel submit;
			                            }
			                        }
			                        else if(ifnull(input.Amount,0) <= 0)
			                        {
			                            alert "Debit, credit, payment, settlement, rebate, and refund amounts must be positive.";
			                            cancel submit;
			                        }
			                        if((input.Transaction_Type == "Debit" || input.Transaction_Type == "COD Settlement") && input.Due_Date == null)
			                        {
			                            alert "A due date is required for debits and COD settlements.";
			                            cancel submit;
			                        }
			                        if(input.Shipment != null)
			                        {
			                            shipment_record = Shipment_Requests[ID == input.Shipment];
			                            if(shipment_record.count(ID) == 0 || shipment_record.Customer != customer_record.ID)
			                            {
			                                alert "The selected shipment does not belong to this customer.";
			                                cancel submit;
			                            }
			                        }
			                        if(input.Invoice != null)
			                        {
			                            invoice_record = Invoices[ID == input.Invoice];
			                            if(invoice_record.count(ID) == 0 || invoice_record.Customer != customer_record.ID || (input.Shipment != null && invoice_record.Shipment != input.Shipment))
			                            {
			                                alert "The selected invoice does not match the customer and shipment.";
			                                cancel submit;
			                            }
			                        }
			                        if(ifnull(input.Payment_Reference,"").trim() != "" && Account_Ledger[Payment_Reference == input.Payment_Reference && ID != input.ID].count(ID) > 0)
			                        {
			                            alert "This payment reference already exists in the ledger.";
			                            cancel submit;
			                        }
			                        if(input.ID != null)
			                        {
			                            stored_record = Account_Ledger[ID == input.ID];
			                            if(input.Customer != stored_record.Customer || input.Shipment != stored_record.Shipment || input.Invoice != stored_record.Invoice || input.Transaction_Type != stored_record.Transaction_Type || input.Amount != stored_record.Amount || input.Transaction_Date != stored_record.Transaction_Date || input.Due_Date != stored_record.Due_Date || input.Payment_Reference != stored_record.Payment_Reference || input.Posted_By_Email != stored_record.Posted_By_Email || input.Customer_Login_Email != stored_record.Customer_Login_Email)
			                            {
			                                alert "Posted ledger values are immutable. Only status and notes may be updated through authorised reconciliation.";
			                                cancel submit;
			                            }
			                        }
			                        else
			                        {
			                            input.Transaction_Date = zoho.currenttime;
			                            input.Posted_By_Email = zoho.loginuserid;
			                            input.Customer_Login_Email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID);
			                        }
			                        input.Ageing_Bucket = "Not Applicable";
			                        if(input.Ledger_Status != "Settled" && input.Due_Date != null)
			                        {
			                            overdue_days = input.Due_Date.daysBetween(zoho.currentdate);
			                            if(overdue_days <= 0)
			                            {
			                                input.Ageing_Bucket = "Current";
			                            }
			                            else if(overdue_days <= 30)
			                            {
			                                input.Ageing_Bucket = "1-30 Days";
			                            }
			                            else if(overdue_days <= 60)
			                            {
			                                input.Ageing_Bucket = "31-60 Days";
			                            }
			                            else if(overdue_days <= 90)
			                            {
			                                input.Ageing_Bucket = "61-90 Days";
			                            }
			                            else
			                            {
			                                input.Ageing_Bucket = "90+ Days";
			                            }
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			App_Configuration_On_Success as "Audit Application Configuration"
			{
			    type = form
			    form = App_Configuration
			    record event = on add or edit
			    description = "Writes an audit record whenever the active operations policy is saved"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = "Logistics Administrator"
			                    Action_Name = "Save Operations Policy"
			                    Module_Name = "App Configuration"
			                    Record_ID = input.ID.toString()
			                    After_Data = "Configuration=" + input.Configuration_Name + "; Active=" + input.Active + "; NDR Attempts=" + input.Maximum_NDR_Attempts + "; COD Cycle=" + input.COD_Payout_Cycle
			                    Source = "Form Workflow"
			                    Severity = "Info"
			                ];
			            )
			        }
			    }
			}

			App_Configuration_On_Validate as "Validate Application Configuration"
			{
			    type = form
			    form = App_Configuration
			    record event = on add or edit
			    description = "Validates positive policy values and ensures exactly one active configuration"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(ifnull(input.High_Credit_KYC_Threshold,0) <= 0 || ifnull(input.KYC_Expiry_Alert_Days,0) <= 0 || ifnull(input.Maximum_NDR_Attempts,0) <= 0 || ifnull(input.Points_Expiry_Months,0) <= 0 || ifnull(input.Default_Volumetric_Divisor,0) <= 0 || ifnull(input.Loyalty_Redemption_Value_Per_Point,0) <= 0 || ifnull(input.Notification_Retry_Limit,0) <= 0)
			                {
			                    alert "All policy thresholds, retry limits, expiry periods, and divisors must be greater than zero.";
			                    cancel submit;
			                }
			                other_active_count = App_Configuration[Active == true && ID != input.ID].count();
			                if(input.Active == true && other_active_count > 0)
			                {
			                    alert "Only one operations policy can be active.";
			                    cancel submit;
			                }
			                if(input.Active == false && other_active_count == 0)
			                {
			                    alert "At least one operations policy must remain active.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

