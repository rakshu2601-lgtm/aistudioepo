			Audit_Log_On_Validate as "Validate Immutable Audit Event"
			{
			    type = form
			    form = Audit_Log
			    record event = on add or edit
			    description = "Stamps missing actor metadata on new events and prohibits every edit to recorded evidence"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.ID != null)
			                {
			                    alert "Audit evidence is immutable and cannot be edited.";
			                    cancel submit;
			                }
			                else
			                {
			                    if(input.Event_Time == null)
			                    {
			                        input.Event_Time = zoho.currenttime;
			                    }
			                    if(ifnull(input.Actor_Email,"").trim() == "")
			                    {
			                        input.Actor_Email = if(ifnull(zoho.loginuserid,"").trim() != "",zoho.loginuserid,zoho.adminuserid);
			                    }
			                    if(ifnull(input.Actor_Profile,"").trim() == "")
			                    {
			                        input.Actor_Profile = if(ifnull(zoho.loginuserid,"").trim() != "",thisapp.permissions.loginUserProfile(),"System");
			                    }
			                    if(ifnull(input.Action_Name,"").trim() == "" || ifnull(input.Module_Name,"").trim() == "" || ifnull(input.Record_ID,"").trim() == "")
			                    {
			                        alert "Action name, module name, and record ID are required for audit evidence.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Bag_On_User_Input as "Filter Compatible Bag Shipments"
			{
			    type = form
			    form = Bag_Shipments
			    record event = on add or edit
			    description = "Shows only shipments at the bag origin that match the selected movement leg"
			
			    on user input of Bag
			    {
			        actions
			        {
			            custom deluge script
			            (
			                clear Shipment;
			                bag_record = Logistics_Bags[ID == input.Bag && Bag_Status == "Open"];
			                if(bag_record.count(ID) > 0)
			                {
			                    if(bag_record.Bag_Type == "Feeder")
			                    {
			                        Shipment:ui.add(Shipment_Requests[Current_Hub == bag_record.Origin_Hub && Collection_Center == bag_record.Origin_Hub && Origin_Sorting_Hub == bag_record.Destination_Hub && (Shipment_Status == "Picked Up" || Shipment_Status == "Inbound at Branch Station")].ID.getall());
			                    }
			                    else if(bag_record.Bag_Type == "Master")
			                    {
			                        Shipment:ui.add(Shipment_Requests[Current_Hub == bag_record.Origin_Hub && Origin_Sorting_Hub == bag_record.Origin_Hub && Destination_Sorting_Hub == bag_record.Destination_Hub && Shipment_Status == "Sorted at Origin Hub"].ID.getall());
			                    }
			                    else if(bag_record.Bag_Type == "Delivery Feeder")
			                    {
			                        Shipment:ui.add(Shipment_Requests[Current_Hub == bag_record.Origin_Hub && Destination_Sorting_Hub == bag_record.Origin_Hub && Destination_Hub == bag_record.Destination_Hub && Shipment_Status == "Arrived at Destination Hub"].ID.getall());
			                    }
			                    else
			                    {
			                        Shipment:ui.add(Shipment_Requests[Current_Hub == bag_record.Origin_Hub && Shipment_Status == "Return to Origin"].ID.getall());
			                    }
			                }
			            )
			        }
			    }
			}

			Bag_Shipments_On_Delete as "Protect Bag Shipment Deletion"
			{
			    type = form
			    form = Bag_Shipments
			    record event = on delete
			    description = "Prevents deletion of bag scan and reconciliation evidence"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                alert "Bag shipment custody records cannot be deleted. Use Remove Shipment before sealing when applicable.";
			                cancel delete;
			            )
			        }
			    }
			}

			Bag_Shipments_On_Load as "Secure Bag Shipment Scan"
			{
			    type = form
			    form = Bag_Shipments
			    record event = on add or edit
			    description = "Restricts scans to open bags and protects reconciliation-controlled fields"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Scan_Status, Scanned_At, Scanned_By_Email, Received_At, Exception_Notes;
			                if(input.ID == null)
			                {
			                    clear Bag;
			                    Bag:ui.add(Logistics_Bags[Bag_Status == "Open"].ID.getall());
			                    clear Shipment;
			                }
			                else
			                {
			                    disable Bag, Shipment;
			                    bag_record = Logistics_Bags[ID == input.Bag];
			                    if(input.Scan_Status == "Loaded" && (bag_record.Bag_Status == "Received" || bag_record.Bag_Status == "Exception"))
			                    {
			                        enable Exception_Notes;
			                    }
			                }
			            )
			        }
			    }
			}

			Bag_Shipments_On_Success as "Recalculate Bag after Scan"
			{
			    type = form
			    form = Bag_Shipments
			    record event = on add
			    description = "Recalculates open-bag totals and audits every loaded AWB scan"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                shipment_count = 0;
			                total_weight = 0.0;
			                for each bag_item in Bag_Shipments[Bag == input.Bag && Scan_Status == "Loaded"]
			                {
			                    shipment_count = shipment_count + 1;
			                    shipment_record = Shipment_Requests[ID == bag_item.Shipment];
			                    total_weight = total_weight + ifnull(shipment_record.Billable_Weight_Kg,0);
			                }
			                bag_record = Logistics_Bags[ID == input.Bag];
			                bag_record.Total_Shipments = shipment_count;
			                bag_record.Total_Weight_Kg = total_weight;
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = thisapp.permissions.loginUserProfile()
			                    Action_Name = "Load Shipment into Bag"
			                    Module_Name = "Bag Shipments"
			                    Record_ID = input.ID.toString()
			                    After_Data = "Bag=" + input.Bag + "; Shipment=" + input.Shipment + "; Status=Loaded"
			                    Source = "Form Workflow"
			                    Severity = "Critical"
			                ];
			            )
			        }
			    }
			}

			Bag_Shipments_On_Validate as "Validate Bag Shipment Scan"
			{
			    type = form
			    form = Bag_Shipments
			    record event = on add or edit
			    description = "Validates hub custody, movement-leg compatibility, and duplicate bag membership"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                authorised = current_profile == "Logistics_Administrator" || current_profile == "Operations_Manager" || current_profile == "Hub_Supervisor" || current_profile == "Hub_Operator";
			                if(authorised == false)
			                {
			                    alert "You are not authorised to scan shipments into logistics bags.";
			                    cancel submit;
			                }
			                if(input.ID != null)
			                {
			                    existing_record = Bag_Shipments[ID == input.ID];
			                    bag_record = Logistics_Bags[ID == existing_record.Bag];
			                    notes_only_change = existing_record.Bag == input.Bag && existing_record.Shipment == input.Shipment && existing_record.Scan_Status == input.Scan_Status && existing_record.Scanned_At == input.Scanned_At && existing_record.Scanned_By_Email == input.Scanned_By_Email && existing_record.Received_At == input.Received_At;
			                    if(existing_record.Scan_Status != "Loaded" || (bag_record.Bag_Status != "Received" && bag_record.Bag_Status != "Exception") || notes_only_change == false)
			                    {
			                        alert "After loading, only exception notes may be prepared for an AWB awaiting reconciliation in a received or quarantined bag.";
			                        cancel submit;
			                    }
			                    if(current_profile == "Hub_Supervisor" || current_profile == "Hub_Operator")
			                    {
			                        logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                        deputation_active = logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate);
			                        effective_hub = logged_user.Home_Hub;
			                        if(deputation_active == true)
			                        {
			                            effective_hub = logged_user.Deputed_Hub;
			                        }
			                        if(logged_user.count(ID) == 0 || effective_hub != bag_record.Destination_Hub)
			                        {
			                            alert "Hub users can prepare reconciliation notes only at their effective destination hub.";
			                            cancel submit;
			                        }
			                    }
			                }
			                else
			                {
			                    bag_record = Logistics_Bags[ID == input.Bag && Bag_Status == "Open"];
			                    shipment_record = Shipment_Requests[ID == input.Shipment];
			                    if(bag_record.count(ID) == 0 || shipment_record.count(ID) == 0)
			                    {
			                        alert "Select an open bag and a valid shipment.";
			                        cancel submit;
			                    }
			                    if(current_profile == "Hub_Supervisor" || current_profile == "Hub_Operator")
			                    {
			                        logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                        deputation_active = logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate);
			                        effective_hub = logged_user.Home_Hub;
			                        if(deputation_active == true)
			                        {
			                            effective_hub = logged_user.Deputed_Hub;
			                        }
			                        if(logged_user.count(ID) == 0 || effective_hub != bag_record.Origin_Hub)
			                        {
			                            alert "Hub users can load bags only at their effective hub.";
			                            cancel submit;
			                        }
			                    }
			                    if(shipment_record.Current_Hub != bag_record.Origin_Hub)
			                    {
			                        alert "The shipment is not currently in custody at the bag origin hub.";
			                        cancel submit;
			                    }
			                    compatible = false;
			                    if(bag_record.Bag_Type == "Feeder")
			                    {
			                        compatible = shipment_record.Collection_Center == bag_record.Origin_Hub && shipment_record.Origin_Sorting_Hub == bag_record.Destination_Hub && (shipment_record.Shipment_Status == "Picked Up" || shipment_record.Shipment_Status == "Inbound at Branch Station");
			                    }
			                    else if(bag_record.Bag_Type == "Master")
			                    {
			                        compatible = shipment_record.Origin_Sorting_Hub == bag_record.Origin_Hub && shipment_record.Destination_Sorting_Hub == bag_record.Destination_Hub && shipment_record.Shipment_Status == "Sorted at Origin Hub";
			                    }
			                    else if(bag_record.Bag_Type == "Delivery Feeder")
			                    {
			                        compatible = shipment_record.Destination_Sorting_Hub == bag_record.Origin_Hub && shipment_record.Destination_Hub == bag_record.Destination_Hub && shipment_record.Shipment_Status == "Arrived at Destination Hub";
			                    }
			                    else
			                    {
			                        compatible = shipment_record.Shipment_Status == "Return to Origin";
			                    }
			                    if(compatible == false)
			                    {
			                        alert "The shipment route or lifecycle status is incompatible with this bag movement.";
			                        cancel submit;
			                    }
			                    active_membership = Bag_Shipments[Shipment == input.Shipment && Scan_Status == "Loaded"];
			                    if(active_membership.count(ID) > 0)
			                    {
			                        alert "This shipment is already loaded in another active bag.";
			                        cancel submit;
			                    }
			                    input.Scan_Status = "Loaded";
			                    input.Scanned_At = zoho.currenttime;
			                    input.Scanned_By_Email = zoho.loginuserid;
			                    input.Received_At = null;
			                    input.Exception_Notes = "";
			                }
			            )
			        }
			    }
			}

			COD_Remittances_On_Delete as "Protect COD Remittance Evidence"
			{
			    type = form
			    form = COD_Remittances
			    record event = on delete
			    description = "Prevents deletion of financial custody evidence"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                alert "COD remittance records are financial evidence and cannot be deleted.";
			                cancel delete;
			            )
			        }
			    }
			}

			COD_Remittances_On_Load as "Secure COD Remittance Load"
			{
			    type = form
			    form = COD_Remittances
			    record event = on add or edit
			    description = "Locks reconciliation fields and permits cash entry only for authorised users"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Delivery_Run_Sheet, Agent, Hub, Remittance_Date, Expected_Amount, Shortfall_Amount, Remittance_Status, Cashier_Email, Confirmed_At, Customer_Payout_Due_Date;
			                current_profile = thisapp.permissions.loginUserProfile();
			                current_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                assigned_agent = Operations_Users[ID == input.Agent];
			                effective_hub = if(current_user.count(ID) > 0 && current_user.Deputed_Hub != null && (current_user.Deputation_Start_Date == null || current_user.Deputation_Start_Date <= input.Remittance_Date) && (current_user.Deputation_End_Date == null || current_user.Deputation_End_Date >= input.Remittance_Date),current_user.Deputed_Hub,current_user.Home_Hub);
			                authorised = current_profile == "Logistics_Administrator" || current_profile == "Operations_Manager" || current_profile == "Finance_Officer" || (current_profile == "Hub_Supervisor" && current_user.count(ID) > 0 && effective_hub == input.Hub) || (current_profile == "Field_Agent" && assigned_agent.count(ID) > 0 && assigned_agent.Work_Email == zoho.loginuserid);
			                if(input.ID == null || authorised == false || input.Remittance_Status == "Confirmed")
			                {
			                    disable Submitted_Amount, Notes;
			                }
			                else
			                {
			                    enable Submitted_Amount, Notes;
			                }
			            )
			        }
			    }
			}

			COD_Remittances_On_Success as "Audit COD Cash Submission"
			{
			    type = form
			    form = COD_Remittances
			    record event = on edit
			    description = "Audits every agent or supervisor cash-submission update"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = current_profile
			                    Action_Name = "Submit COD Cash"
			                    Module_Name = "COD Remittances"
			                    Record_ID = input.ID.toString()
			                    Before_Data = "Expected=" + input.Expected_Amount
			                    After_Data = "Submitted=" + input.Submitted_Amount + "; Shortfall=" + input.Shortfall_Amount + "; Status=Pending"
			                    Source = "Form Workflow"
			                    Severity = if(input.Shortfall_Amount > 0,"Warning","Info")
			                ];
			            )
			        }
			    }
			}

			COD_Remittances_On_Validate as "Validate COD Remittance"
			{
			    type = form
			    form = COD_Remittances
			    record event = on add or edit
			    description = "Protects run-level cash reconciliation and permits corrections only by authorised users"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.ID == null)
			                {
			                    alert "COD remittances are created automatically when a delivery run is completed.";
			                    cancel submit;
			                }
			                else
			                {
			                    existing_record = COD_Remittances[ID == input.ID];
			                    current_profile = thisapp.permissions.loginUserProfile();
			                    current_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                    assigned_agent = Operations_Users[ID == input.Agent];
			                    effective_hub = if(current_user.count(ID) > 0 && current_user.Deputed_Hub != null && (current_user.Deputation_Start_Date == null || current_user.Deputation_Start_Date <= input.Remittance_Date) && (current_user.Deputation_End_Date == null || current_user.Deputation_End_Date >= input.Remittance_Date),current_user.Deputed_Hub,current_user.Home_Hub);
			                    authorised = current_profile == "Logistics_Administrator" || current_profile == "Operations_Manager" || current_profile == "Finance_Officer" || (current_profile == "Hub_Supervisor" && current_user.count(ID) > 0 && effective_hub == input.Hub) || (current_profile == "Field_Agent" && assigned_agent.count(ID) > 0 && assigned_agent.Work_Email == zoho.loginuserid);
			                    run_record = Delivery_Run_Sheets[ID == input.Delivery_Run_Sheet];
			                    calculated_expected = 0.0;
			                    for each delivered_item in Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.Delivery_Run_Sheet && Delivery_Status == "Delivered"]
			                    {
			                        shipment_record = Shipment_Requests[ID == delivered_item.Shipment];
			                        if(shipment_record.count(ID) > 0 && shipment_record.Payment_Type == "COD")
			                        {
			                            calculated_expected = calculated_expected + ifnull(shipment_record.COD_Amount,0);
			                        }
			                    }
			                    fixed_fields_changed = existing_record.Delivery_Run_Sheet != input.Delivery_Run_Sheet || existing_record.Agent != input.Agent || existing_record.Hub != input.Hub || existing_record.Remittance_Date != input.Remittance_Date || existing_record.Expected_Amount != input.Expected_Amount || existing_record.Cashier_Email != input.Cashier_Email || existing_record.Confirmed_At != input.Confirmed_At || existing_record.Customer_Payout_Due_Date != input.Customer_Payout_Due_Date;
			                    if(authorised == false)
			                    {
			                        alert "You are not authorised to update this COD remittance.";
			                        cancel submit;
			                    }
			                    else if(existing_record.Remittance_Status == "Confirmed")
			                    {
			                        alert "A confirmed COD remittance is immutable.";
			                        cancel submit;
			                    }
			                    else if(fixed_fields_changed == true || run_record.count(ID) == 0 || run_record.DRS_Status != "Completed" || run_record.Assigned_Agent != input.Agent || run_record.Hub != input.Hub)
			                    {
			                        alert "Delivery-run, agent, hub, expected amount, and cashier-controlled fields cannot be changed.";
			                        cancel submit;
			                    }
			                    else if((calculated_expected - input.Expected_Amount).abs() > 0.01)
			                    {
			                        alert "Expected COD no longer matches delivered run items. Contact Finance before submitting cash.";
			                        cancel submit;
			                    }
			                    else if(ifnull(input.Submitted_Amount,0) < 0 || ifnull(input.Submitted_Amount,0) > calculated_expected)
			                    {
			                        alert "Submitted cash must be between zero and the expected COD amount.";
			                        cancel submit;
			                    }
			                    else
			                    {
			                        input.Shortfall_Amount = calculated_expected - ifnull(input.Submitted_Amount,0);
			                        input.Remittance_Status = "Pending";
			                        input.Cashier_Email = null;
			                        input.Confirmed_At = null;
			                        input.Customer_Payout_Due_Date = null;
			                    }
			                }
			            )
			        }
			    }
			}

			Submitted_Amount_On_User_Input as "Calculate COD Shortfall"
			{
			    type = form
			    form = COD_Remittances
			    record event = on edit
			    description = "Recalculates the cash shortfall while an authorised user records submitted cash"
			
			    on user input of Submitted_Amount
			    {
			        actions
			        {
			            custom deluge script
			            (
			                expected_amount = ifnull(input.Expected_Amount,0);
			                submitted_amount = ifnull(input.Submitted_Amount,0);
			                input.Shortfall_Amount = if(expected_amount > submitted_amount,expected_amount - submitted_amount,0);
			            )
			        }
			    }
			}

