			                    effective_hub = if(deputation_active == true,logged_user.Deputed_Hub,logged_user.Home_Hub);
			                    if(logged_user.count(ID) == 0 || effective_hub != input.Hub)
			                    {
			                        info "Only an active operations user at the run's effective hub can complete it.";
			                    }
			                    else
			                    {
			                        planned_count = 0;
			                        delivered_count = 0;
			                        failed_count = 0;
			                        unresolved_count = 0;
			                        expected_cod = 0.0;
			                        delivered_cod_expected = 0.0;
			                        collected_cod = 0.0;
			                        for each run_item in Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.ID]
			                        {
			                            planned_count = planned_count + 1;
			                            shipment_record = Shipment_Requests[ID == run_item.Shipment];
			                            if(shipment_record.Payment_Type == "COD")
			                            {
			                                expected_cod = expected_cod + ifnull(shipment_record.COD_Amount,0);
			                            }
			                            if(run_item.Delivery_Status == "Delivered")
			                            {
			                                delivered_count = delivered_count + 1;
			                                collected_cod = collected_cod + ifnull(run_item.COD_Collected,0);
			                                if(shipment_record.Payment_Type == "COD")
			                                {
			                                    delivered_cod_expected = delivered_cod_expected + ifnull(shipment_record.COD_Amount,0);
			                                }
			                            }
			                            else if(run_item.Delivery_Status == "Failed" || run_item.Delivery_Status == "RTO")
			                            {
			                                failed_count = failed_count + 1;
			                            }
			                            else
			                            {
			                                unresolved_count = unresolved_count + 1;
			                            }
			                        }
			                        if(planned_count == 0 || unresolved_count > 0)
			                        {
			                            info "Every delivery stop must be marked Delivered, Failed, or RTO before completing the run.";
			                        }
			                        else
			                        {
			                            prior_status = input.DRS_Status;
			                            input.Planned_Stop_Count = planned_count;
			                            input.Delivered_Count = delivered_count;
			                            input.Failed_Count = failed_count;
			                            input.Expected_COD_Amount = expected_cod;
			                            input.Collected_COD_Amount = collected_cod;
			                            input.DRS_Status = "Completed";
			                            input.Completed_At = zoho.currenttime;
			                            if(input.Vehicle != null)
			                            {
			                                vehicle_record = Vehicles[ID == input.Vehicle];
			                                if(vehicle_record.count(ID) > 0 && vehicle_record.Status == "Assigned" && vehicle_record.Assigned_Driver == input.Assigned_Agent)
			                                {
			                                    vehicle_record.Status = "Available";
			                                    vehicle_record.Assigned_Driver = null;
			                                }
			                            }
			                            if(delivered_cod_expected > 0 && COD_Remittances[Delivery_Run_Sheet == input.ID].count(ID) == 0)
			                            {
			                                remittance_id = insert into COD_Remittances
			                                [
			                                    Delivery_Run_Sheet = input.ID
			                                    Agent = input.Assigned_Agent
			                                    Hub = input.Hub
			                                    Remittance_Date = zoho.currentdate
			                                    Expected_Amount = delivered_cod_expected
			                                    Submitted_Amount = 0
			                                    Shortfall_Amount = delivered_cod_expected
			                                    Remittance_Status = "Pending"
			                                    Notes = "Created automatically when DRS " + input.DRS_Number + " was completed."
			                                ];
			                            }
			                            audit_id = insert into Audit_Log
			                            [
			                                Event_Time = zoho.currenttime
			                                Actor_Email = zoho.loginuserid
			                                Actor_Profile = current_profile
			                                Action_Name = "Complete Delivery Run"
			                                Module_Name = "Delivery Run Sheets"
			                                Record_ID = input.ID.toString()
			                                Before_Data = "Status=" + prior_status
			                                After_Data = "Status=Completed; Delivered=" + delivered_count + "; Failed or RTO=" + failed_count + "; COD Expected on Delivered=" + delivered_cod_expected + "; COD Collected=" + collected_cod
			                                Source = "Report Action"
			                                Severity = "Warning"
			                            ];
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Release_Delivery_Run as "Release Delivery Run"
			{
			    type = functions
			    form = Delivery_Run_Sheets
			    execution type = for each record
			    description = "Validates last-mile custody and capacity, releases stops, and moves shipments out for delivery"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                if(input.DRS_Status != "Draft")
			                {
			                    info "Only draft delivery runs can be released.";
			                }
			                else if(input.Run_Date < zoho.currentdate)
			                {
			                    info "A delivery run scheduled in the past cannot be released.";
			                }
			                else
			                {
			                    logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                    deputation_active = logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= input.Run_Date) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= input.Run_Date);
			                    effective_hub = if(deputation_active == true,logged_user.Deputed_Hub,logged_user.Home_Hub);
			                    if(logged_user.count(ID) == 0 || effective_hub != input.Hub)
			                    {
			                        info "Only an active operations user at the run's effective hub can release it.";
			                    }
			                    else
			                    {
			                        agent_record = Operations_Users[ID == input.Assigned_Agent && Active == true && Application_Role == "Field Agent" && (Agent_Role == "Delivery" || Agent_Role == "Both")];
			                        agent_deputation_active = agent_record.count(ID) > 0 && agent_record.Deputed_Hub != null && (agent_record.Deputation_Start_Date == null || agent_record.Deputation_Start_Date <= input.Run_Date) && (agent_record.Deputation_End_Date == null || agent_record.Deputation_End_Date >= input.Run_Date);
			                        agent_hub = if(agent_deputation_active == true,agent_record.Deputed_Hub,agent_record.Home_Hub);
			                        if(agent_record.count(ID) == 0 || agent_hub != input.Hub)
			                        {
			                            info "The assigned delivery agent is not effective at this hub on the run date.";
			                        }
			                        else
			                        {
			                            planned_count = 0;
			                            planned_weight = 0.0;
			                            expected_cod = 0.0;
			                            invalid_count = 0;
			                            for each run_item in Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.ID]
			                            {
			                                planned_count = planned_count + 1;
			                                shipment_record = Shipment_Requests[ID == run_item.Shipment];
			                                if(run_item.Delivery_Status != "Assigned" || shipment_record.count(ID) == 0 || shipment_record.Shipment_Status != "At Delivery Hub" || shipment_record.Current_Hub != input.Hub || shipment_record.Destination_Hub != input.Hub)
			                                {
			                                    invalid_count = invalid_count + 1;
			                                }
			                                else
			                                {
			                                    planned_weight = planned_weight + ifnull(shipment_record.Billable_Weight_Kg,0);
			                                    if(shipment_record.Payment_Type == "COD")
			                                    {
			                                        expected_cod = expected_cod + ifnull(shipment_record.COD_Amount,0);
			                                    }
			                                }
			                            }
			                            if(planned_count == 0)
			                            {
			                                info "Add at least one delivery stop before releasing the run.";
			                            }
			                            else if(invalid_count > 0)
			                            {
			                                info "One or more stops are not assigned, not at this delivery hub, or no longer eligible for release.";
			                            }
			                            else
			                            {
			                                other_agent_weight = 0.0;
			                                for each pickup_run in Pickup_Run_Sheets[Assigned_Agent == input.Assigned_Agent && Run_Date == input.Run_Date && Status != "Cancelled"]
			                                {
			                                    other_agent_weight = other_agent_weight + ifnull(pickup_run.Total_Planned_Weight_Kg,0);
			                                }
			                                for each other_run in Delivery_Run_Sheets[Assigned_Agent == input.Assigned_Agent && Run_Date == input.Run_Date && ID != input.ID && DRS_Status != "Cancelled"]
			                                {
			                                    for each other_item in Delivery_Run_Sheet_Items[Delivery_Run_Sheet == other_run.ID]
			                                    {
			                                        other_shipment = Shipment_Requests[ID == other_item.Shipment];
			                                        other_agent_weight = other_agent_weight + ifnull(other_shipment.Billable_Weight_Kg,0);
			                                    }
			                                }
			                                agent_overloaded = agent_record.Maximum_Daily_Load_Kg != null && agent_record.Maximum_Daily_Load_Kg > 0 && other_agent_weight + planned_weight > agent_record.Maximum_Daily_Load_Kg;
			                                vehicle_invalid = false;
			                                if(input.Vehicle != null)
			                                {
			                                    vehicle_record = Vehicles[ID == input.Vehicle && Active == true && Owning_Hub == input.Hub && Status == "Available"];
			                                    duplicate_delivery_run = Delivery_Run_Sheets[Vehicle == input.Vehicle && Run_Date == input.Run_Date && ID != input.ID && DRS_Status != "Cancelled"].count(ID);
			                                    duplicate_pickup_run = Pickup_Run_Sheets[Vehicle == input.Vehicle && Run_Date == input.Run_Date && Status != "Cancelled"].count(ID);
			                                    vehicle_invalid = vehicle_record.count(ID) == 0 || duplicate_delivery_run > 0 || duplicate_pickup_run > 0 || planned_weight > vehicle_record.Capacity_Kg;
			                                }
			                                if(agent_overloaded == true)
			                                {
			                                    info "The assigned agent's combined pickup and delivery load would exceed the daily limit.";
			                                }
			                                else if(vehicle_invalid == true)
			                                {
			                                    info "The selected vehicle is unavailable, double-booked, or below the required capacity.";
			                                }
			                                else
			                                {
			                                    for each release_item in Delivery_Run_Sheet_Items[Delivery_Run_Sheet == input.ID]
			                                    {
			                                        release_shipment = Shipment_Requests[ID == release_item.Shipment];
			                                        release_item.Delivery_Status = "Out For Delivery";
			                                        release_shipment.Shipment_Status = "Out For Delivery (OFD)";
			                                        release_shipment.Current_Hub = input.Hub;
			                                        tracking_id = insert into Shipment_Tracking_Events
			                                        [
			                                            Shipment = release_shipment.ID
			                                            Event_Time = zoho.currenttime
			                                            Event_Status = "Out For Delivery (OFD)"
			                                            Source = "Delivery"
			                                            Hub = input.Hub
			                                            Agent = input.Assigned_Agent
			                                            Event_Description = "Shipment released from the delivery hub and assigned to the last-mile agent."
			                                            Customer_Visible = true
			                                            Created_By_Email = zoho.loginuserid
			                                        ];
			                                    }
			                                    input.Planned_Stop_Count = planned_count;
			                                    input.Delivered_Count = 0;
			                                    input.Failed_Count = 0;
			                                    input.Expected_COD_Amount = expected_cod;
			                                    input.Collected_COD_Amount = 0;
			                                    input.DRS_Status = "Released";
			                                    input.Released_At = zoho.currenttime;
			                                    if(input.Vehicle != null)
			                                    {
			                                        vehicle_record.Status = "Assigned";
			                                        vehicle_record.Assigned_Driver = input.Assigned_Agent;
			                                    }
			                                    audit_id = insert into Audit_Log
			                                    [
			                                        Event_Time = zoho.currenttime
			                                        Actor_Email = zoho.loginuserid
			                                        Actor_Profile = current_profile
			                                        Action_Name = "Release Delivery Run"
			                                        Module_Name = "Delivery Run Sheets"
			                                        Record_ID = input.ID.toString()
			                                        Before_Data = "Status=Draft"
			                                        After_Data = "Status=Released; Stops=" + planned_count + "; Weight Kg=" + planned_weight + "; Expected COD=" + expected_cod
			                                        Source = "Report Action"
			                                        Severity = "Warning"
			                                    ];
			                                    sendmail
			                                    (
			                                        from : zoho.adminuserid
			                                        to : agent_record.Work_Email
			                                        subject : "Delivery run released: DRS " + input.DRS_Number
			                                        message : "Your delivery run for " + input.Run_Date + " has been released with " + planned_count + " stops in zone " + input.Delivery_Zone + "."
			                                    )
			                                }
			                            }
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Reassign_Primary_Hub as "Reassign Primary Hub"
			{
			    type = functions
			    form = Hub_Pincode_Mapping
			    execution type = for each record
			    description = "Swaps the primary collection center with the configured overflow hub"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                if(input.Secondary_Overflow_Hub == null)
			                {
			                    info "Configure an overflow hub before reassignment.";
			                }
			                else
			                {
			                    previous_primary = input.Primary_Collection_Center;
			                    previous_secondary = input.Secondary_Overflow_Hub;
			                    input.Primary_Collection_Center = previous_secondary;
			                    input.Secondary_Overflow_Hub = previous_primary;
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuserid
			                        Actor_Profile = "Operations Manager"
			                        Action_Name = "Reassign Primary Hub"
			                        Module_Name = "Hub Pincode Mapping"
			                        Record_ID = input.ID.toString()
			                        Before_Data = "Primary Hub ID=" + previous_primary + "; Overflow Hub ID=" + previous_secondary
			                        After_Data = "Primary Hub ID=" + previous_secondary + "; Overflow Hub ID=" + previous_primary
			                        Source = "Report Action"
			                        Severity = "Warning"
			                    ];
			                }
			            )
			        }
			    }
			}

			Issue_Invoice as "Issue Invoice"
			{
			    type = functions
			    form = Invoices
			    execution type = for each record
			    description = "Issues a draft invoice, creates one receivable, generates its PDF, archives it, and notifies the customer"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = "POC Process User";
			                if(input.Invoice_Status != "Draft")
			                {
			                    info "Only a draft invoice can be issued.";
			                }
			                else
			                {
			                    shipment_record = Shipment_Requests[ID == input.Shipment];
			                    customer_record = Customers[ID == input.Customer];
			                    if(shipment_record.count(ID) == 0 || customer_record.count(ID) == 0 || shipment_record.Customer != customer_record.ID)
			                    {
			                        info "Invoice shipment and customer details are inconsistent.";
			                    }
			                    else
			                    {
			                        expected_total = (ifnull(input.Freight_Subtotal,0) + ifnull(input.Fuel_Surcharge,0) + ifnull(input.COD_Fee,0) + ifnull(input.GST_Amount,0) - ifnull(input.Loyalty_Discount,0) - ifnull(input.Credit_Rebate,0)).round(2);
			                        if(expected_total < 0)
			                        {
			                            expected_total = 0;
			                        }
			                        if((ifnull(input.Invoice_Total,0) - expected_total).abs() > 0.01 || (ifnull(input.Invoice_Total,0) - ifnull(shipment_record.Total_Payable,0)).abs() > 0.01)
			                        {
			                            info "Invoice charges no longer match the shipment. Refresh the draft before issuing it.";
			                        }
			                        else
			                        {
			                            invoice_reference = "INV-" + input.Invoice_Number;
			                            existing_debit = Account_Ledger[Invoice == input.ID && Transaction_Type == "Debit"];
			                            if(existing_debit.count(ID) == 0)
			                            {
			                                ledger_id = insert into Account_Ledger
			                                [
			                                    Customer = customer_record.ID
			                                    Shipment = shipment_record.ID
			                                    Invoice = input.ID
			                                    Transaction_Type = "Debit"
			                                    Amount = input.Invoice_Total
			                                    Transaction_Date = zoho.currenttime
			                                    Due_Date = input.Due_Date
			                                    Ledger_Status = "Open"
			                                    Payment_Reference = invoice_reference
			                                    Notes = "Receivable created when invoice was issued."
			                                    Posted_By_Email = zoho.loginuserid
			                                    Customer_Login_Email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID)
			                                ];
			                                thisapp.Recalculate_Customer_Outstanding(customer_record.ID);
			                            }
			                            input.Invoice_Status = "Issued";
			                            invoice_html = "<html><body style='font-family:Arial,sans-serif;color:#1f2937;margin:32px'><div style='display:flex;justify-content:space-between;border-bottom:3px solid #1d4ed8;padding-bottom:16px'><div><h1 style='margin:0;color:#1d4ed8'>Tax Invoice</h1><p style='margin:6px 0'>Logistics & Loyalty Management</p></div><div style='text-align:right'><b>Invoice " + invoice_reference + "</b><br/>Date: " + input.Invoice_Date + "<br/>Due: " + input.Due_Date + "</div></div><h3>Bill To</h3><p>Customer ID: " + customer_record.Customer_ID + "<br/>Customer: " + customer_record.Full_Name.first_name + " " + customer_record.Full_Name.last_name + "<br/>Email: " + customer_record.Email_ID + "</p><h3>Shipment</h3><p>AWB: " + shipment_record.AWB_Number + "<br/>Mode: " + shipment_record.Transport_Mode + "<br/>Billable Weight: " + shipment_record.Billable_Weight_Kg + " kg</p><table style='border-collapse:collapse;width:100%;margin-top:20px'><tr style='background:#eff6ff'><th style='text-align:left;padding:10px;border:1px solid #cbd5e1'>Charge</th><th style='text-align:right;padding:10px;border:1px solid #cbd5e1'>Amount (INR)</th></tr><tr><td style='padding:10px;border:1px solid #cbd5e1'>Freight</td><td style='text-align:right;padding:10px;border:1px solid #cbd5e1'>" + input.Freight_Subtotal + "</td></tr><tr><td style='padding:10px;border:1px solid #cbd5e1'>Fuel Surcharge</td><td style='text-align:right;padding:10px;border:1px solid #cbd5e1'>" + input.Fuel_Surcharge + "</td></tr><tr><td style='padding:10px;border:1px solid #cbd5e1'>COD Fee</td><td style='text-align:right;padding:10px;border:1px solid #cbd5e1'>" + input.COD_Fee + "</td></tr><tr><td style='padding:10px;border:1px solid #cbd5e1'>GST</td><td style='text-align:right;padding:10px;border:1px solid #cbd5e1'>" + input.GST_Amount + "</td></tr><tr><td style='padding:10px;border:1px solid #cbd5e1'>Loyalty Discount</td><td style='text-align:right;padding:10px;border:1px solid #cbd5e1'>-" + input.Loyalty_Discount + "</td></tr><tr><td style='padding:10px;border:1px solid #cbd5e1'>Credit Rebate</td><td style='text-align:right;padding:10px;border:1px solid #cbd5e1'>-" + input.Credit_Rebate + "</td></tr><tr style='font-weight:bold;background:#f8fafc'><td style='padding:12px;border:1px solid #cbd5e1'>Total</td><td style='text-align:right;padding:12px;border:1px solid #cbd5e1'>INR " + input.Invoice_Total + "</td></tr></table><p style='margin-top:24px'><b>Payment Terms:</b> " + input.Payment_Terms + "</p><p style='font-size:12px;color:#64748b'>This is a system-generated invoice for the shipment identified above.</p></body></html>";
			                            invoice_pdf = zoho.file.convertToPDF(invoice_html);
			                            invoice_file_name = invoice_reference + "_" + shipment_record.AWB_Number + ".pdf";
			                            invoice_pdf.setFileName(invoice_file_name);
			                            workdrive_archived = false;
			                            try
			                            {
			                                workdrive_response = zoho.workdrive.uploadFile(invoice_pdf,"CONFIGURE_INVOICE_FOLDER_ID",encodeUrl(invoice_file_name),true,"zoho_workdrive");
			                                if(workdrive_response.containKey("data"))
			                                {
			                                    workdrive_data = workdrive_response.get("data");
			                                    if(workdrive_data.size() > 0)
			                                    {
			                                        workdrive_attributes = workdrive_data.get(0).get("attributes");
			                                        workdrive_resource_id = workdrive_attributes.get("resource_id");
			                                        input.Invoice_WorkDrive_File_ID = workdrive_resource_id;
			                                        input.Invoice_Download_URL = "https://workdrive.zoho.com/open/" + workdrive_resource_id;
			                                        workdrive_archived = true;
			                                    }
			                                }
			                            }
			                            catch (workdrive_error)
			                            {
			                                input.Invoice_WorkDrive_File_ID = "PENDING-WORKDRIVE-CONFIGURATION";
			                            }
			                            books_sync_status = "Not configured";
			                            input.Zoho_Books_Invoice_ID = "PENDING-BOOKS-CONFIGURATION";
			                            recipient_email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID);
			                            communication_id = insert into Communication_Log
			                            [
			                                Customer = customer_record.ID
			                                Shipment = shipment_record.ID
			                                Recipient = recipient_email
			                                Channel = "Email"
			                                Template_Code = "INVOICE_ISSUED"
			                                Subject = "Invoice " + invoice_reference + " for AWB " + shipment_record.AWB_Number
			                                Message_Summary = "Invoice issued for INR " + input.Invoice_Total + ". WorkDrive archive: " + if(workdrive_archived == true,"Completed","Pending configuration") + "."
			                                Provider = "Zoho Mail"
			                                Communication_Status = "Sent"
			                                Attempt_Count = 1
			                                Last_Attempt_At = zoho.currenttime
			                            ];
			                            sendmail
			                            [
			                                from: zoho.adminuserid
			                                to: recipient_email
			                                subject: "Invoice " + invoice_reference + " for AWB " + shipment_record.AWB_Number
			                                message: "Your shipment invoice for INR " + input.Invoice_Total + " is attached. Payment terms: " + input.Payment_Terms + "; due date: " + input.Due_Date + "."
			                                attachments: file: invoice_pdf
			                            ]
			                            audit_id = insert into Audit_Log
			                            [
			                                Event_Time = zoho.currenttime
			                                Actor_Email = zoho.loginuserid
			                                Actor_Profile = current_profile
			                                Action_Name = "Issue Invoice"
			                                Module_Name = "Invoices"
			                                Record_ID = input.ID.toString()
			                                Before_Data = "Status=Draft; Receivable=Absent"
			                                After_Data = "Status=Issued; Amount=" + input.Invoice_Total + "; WorkDrive Archived=" + workdrive_archived + "; Books Sync=" + books_sync_status
			                                Source = "Report Action"
			                                Severity = "Critical"
			                            ];
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Pay_Invoice_Now as "Pay Invoice - My Invoices"
			{
			    type = functions
			    form = Invoices
			    execution type = for each record
			    description = "Creates an initiated payment record and opens the configured Zoho Checkout session without inferring success"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = "POC Process User";
			                customer_record = Customers[ID == input.Customer];
			                customer_login_email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID);
			                authorised = customer_record.count(ID) > 0 && customer_login_email == zoho.loginuserid;
			                if(authorised == false)
			                {
			                    info "You are not authorised to pay this invoice.";
			                }
			                else if(input.Invoice_Status != "Issued" && input.Invoice_Status != "Part Paid" && input.Invoice_Status != "Overdue")
			                {
			                    info "Only an open issued invoice can be paid.";
			                }
			                else
			                {
			                    ledger_record = Account_Ledger[Invoice == input.ID && Transaction_Type == "Debit" && Ledger_Status != "Settled"];
			                    if(ledger_record.count(ID) == 0)
			                    {
			                        info "No open receivable exists for this invoice.";
			                    }
			                    else
			                    {
			                        payment_amount = ledger_record.Amount;
			                        prior_success_amount = 0.0;
			                        for each successful_payment in Payment_Transactions[Invoice == input.ID && Payment_Status == "Success"]
			                        {
			                            prior_success_amount = prior_success_amount + ifnull(successful_payment.Amount,0);
			                        }
			                        payment_amount = (payment_amount - prior_success_amount).round(2);
			                        if(payment_amount <= 0)
			                        {
			                            info "This invoice has no remaining balance to pay.";
			                        }
			                        else
			                        {
			                            gateway_order_id = "CHK-" + input.Invoice_Number + "-" + zoho.currenttime.toLong();
			                            existing_initiated = Payment_Transactions[Invoice == input.ID && Payment_Status == "Initiated"] sort by Initiated_At desc range from 0 to 0;
			                            if(existing_initiated.count(ID) > 0)
			                            {
			                                payment_record_id = existing_initiated.ID;
			                                gateway_order_id = existing_initiated.Gateway_Order_ID;
			                            }
			                            else
			                            {
			                                payment_record_id = insert into Payment_Transactions
			                                [
			                                    Customer = customer_record.ID
			                                    Shipment = input.Shipment
			                                    Invoice = input.ID
			                                    Ledger_Entry = ledger_record.ID
			                                    Gateway = "Zoho Checkout"
			                                    Gateway_Order_ID = gateway_order_id
			                                    Amount = payment_amount
			                                    Payment_Method = "Other"
			                                    Payment_Status = "Initiated"
			                                    Initiated_At = zoho.currenttime
			                                    Gateway_Response_Summary = "Awaiting configured Checkout session creation and verified reconciliation."
			                                    Customer_Login_Email = customer_login_email
			                                ];
			                            }
			                            audit_id = insert into Audit_Log
			                            [
			                                Event_Time = zoho.currenttime
			                                Actor_Email = zoho.loginuserid
			                                Actor_Profile = current_profile
			                                Action_Name = "Initiate Invoice Payment"
			                                Module_Name = "Invoices"
			                                Record_ID = input.ID.toString()
			                                Before_Data = "Status=" + input.Invoice_Status + "; Remaining=" + payment_amount
			                                After_Data = "Payment Transaction=" + payment_record_id + "; Gateway Order=" + gateway_order_id + "; Status=Initiated"
			                                Source = "Payment"
			                                Severity = "Info"
			                            ];
			                            checkout_url = "https://payments.zoho.com/configure-checkout-session?invoice=" + encodeUrl(input.ID.toString()) + "&payment=" + encodeUrl(payment_record_id.toString()) + "&reference=" + encodeUrl(gateway_order_id) + "&amount=" + encodeUrl(payment_amount.toString());
			                            openUrl(checkout_url,"new window");
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Pay_Invoice_Statement as "Pay Invoice - Invoice Statement"
			{
			    type = functions
			    form = Invoices
			    execution type = for each record
			    description = "Creates an initiated payment record and opens the configured Zoho Checkout session without inferring success"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = "POC Process User";
			                customer_record = Customers[ID == input.Customer];
			                customer_login_email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID);
			                authorised = customer_record.count(ID) > 0 && customer_login_email == zoho.loginuserid;
			                if(authorised == false)
			                {
			                    info "You are not authorised to pay this invoice.";
			                }
			                else if(input.Invoice_Status != "Issued" && input.Invoice_Status != "Part Paid" && input.Invoice_Status != "Overdue")
			                {
			                    info "Only an open issued invoice can be paid.";
			                }
			                else
			                {
			                    ledger_record = Account_Ledger[Invoice == input.ID && Transaction_Type == "Debit" && Ledger_Status != "Settled"];
			                    if(ledger_record.count(ID) == 0)
			                    {
			                        info "No open receivable exists for this invoice.";
			                    }
			                    else
			                    {
			                        payment_amount = ledger_record.Amount;
			                        prior_success_amount = 0.0;
			                        for each successful_payment in Payment_Transactions[Invoice == input.ID && Payment_Status == "Success"]
			                        {
			                            prior_success_amount = prior_success_amount + ifnull(successful_payment.Amount,0);
			                        }
			                        payment_amount = (payment_amount - prior_success_amount).round(2);
			                        if(payment_amount <= 0)
			                        {
			                            info "This invoice has no remaining balance to pay.";
			                        }
			                        else
			                        {
			                            gateway_order_id = "CHK-" + input.Invoice_Number + "-" + zoho.currenttime.toLong();
			                            existing_initiated = Payment_Transactions[Invoice == input.ID && Payment_Status == "Initiated"] sort by Initiated_At desc range from 0 to 0;
			                            if(existing_initiated.count(ID) > 0)
			                            {
			                                payment_record_id = existing_initiated.ID;
			                                gateway_order_id = existing_initiated.Gateway_Order_ID;
			                            }
			                            else
			                            {
			                                payment_record_id = insert into Payment_Transactions
			                                [
			                                    Customer = customer_record.ID
			                                    Shipment = input.Shipment
			                                    Invoice = input.ID
			                                    Ledger_Entry = ledger_record.ID
			                                    Gateway = "Zoho Checkout"
			                                    Gateway_Order_ID = gateway_order_id
			                                    Amount = payment_amount
			                                    Payment_Method = "Other"
			                                    Payment_Status = "Initiated"
			                                    Initiated_At = zoho.currenttime
			                                    Gateway_Response_Summary = "Awaiting configured Checkout session creation and verified reconciliation."
			                                    Customer_Login_Email = customer_login_email
			                                ];
			                            }
			                            audit_id = insert into Audit_Log
			                            [
			                                Event_Time = zoho.currenttime
			                                Actor_Email = zoho.loginuserid
			                                Actor_Profile = current_profile
			                                Action_Name = "Initiate Invoice Payment"
			                                Module_Name = "Invoices"
			                                Record_ID = input.ID.toString()
			                                Before_Data = "Status=" + input.Invoice_Status + "; Remaining=" + payment_amount
			                                After_Data = "Payment Transaction=" + payment_record_id + "; Gateway Order=" + gateway_order_id + "; Status=Initiated"
			                                Source = "Payment"
			                                Severity = "Info"
			                            ];
			                            checkout_url = "https://payments.zoho.com/configure-checkout-session?invoice=" + encodeUrl(input.ID.toString()) + "&payment=" + encodeUrl(payment_record_id.toString()) + "&reference=" + encodeUrl(gateway_order_id) + "&amount=" + encodeUrl(payment_amount.toString());
			                            openUrl(checkout_url,"new window");
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

