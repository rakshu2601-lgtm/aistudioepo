		    (
		        type = text
		        displayname = "ePOD WorkDrive File ID"
		        row = 9
		        column = 1
		        width = medium
		    )
		    EPOD_Download_URL
		    (
		        type = url
		        displayname = "ePOD Download URL"
		        target = new window
		        enable = linkname, title
		        row = 9
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Confirm Booking"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Shipment"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Shipment_Tracking_Events
		{
		    title
		    {
		        displayname = "Shipment Tracking Events"
		        on add = "Add Tracking Event"
		        on edit = "Correct Tracking Event"
		    }
		    success message = "Shipment tracking event saved successfully"
		    Event_Identity
		    (
		        type = section
		        displayname = "Event Identity"
		        row = 1
		        column = 0
