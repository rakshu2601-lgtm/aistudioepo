			Shipment_Exceptions_On_Delete as "Protect Shipment Exception Evidence"
			{
			    type = form
			    form = Shipment_Exceptions
			    record event = on delete
			    description = "Prevents deletion of operational exception and claim evidence"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                alert "Shipment exception evidence cannot be deleted. Resolve the exception through the controlled report action.";
			                cancel delete;
			            )
			        }
			    }
			}

			Shipment_Exceptions_On_Load as "Secure Shipment Exception Form"
			{
			    type = form
			    form = Shipment_Exceptions
			    record event = on add or edit
			    description = "Protects immutable reporting metadata and resolved exception evidence"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Reported_By_Email, Reported_At, Resolved_By_Email, Resolved_At;
			                if(input.ID == null)
			                {
			                    disable Exception_Status;
			                    input.Reported_By_Email = zoho.loginuserid;
			                    input.Reported_At = zoho.currenttime;
			                    input.Exception_Status = "Open";
			                }
			                else
			                {
			                    disable Shipment, Bag, Manifest, Exception_Type, Severity, Reporting_Hub;
			                    if(input.Exception_Status == "Resolved")
			                    {
			                        disable Evidence_Photo, Notes, Exception_Status, Assigned_To_Email, Resolution;
			                    }
			                }
			            )
			        }
			    }
			}

			Shipment_Exceptions_On_Success as "Notify and Audit New Shipment Exception"
			{
			    type = form
			    form = Shipment_Exceptions
			    record event = on add
			    description = "Audits new exceptions and alerts operations management for high or critical severity"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = thisapp.permissions.loginUserProfile()
			                    Action_Name = "Create Shipment Exception"
			                    Module_Name = "Shipment Exceptions"
			                    Record_ID = input.ID.toString()
			                    After_Data = "Type=" + input.Exception_Type + "; Severity=" + input.Severity + "; Hub=" + input.Reporting_Hub + "; Status=" + input.Exception_Status
			                    Source = "Form Workflow"
			                    Severity = if(input.Severity == "Critical","Critical","Warning")
			                ];
			                if(input.Severity == "High" || input.Severity == "Critical")
			                {
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : zoho.adminuserid
			                        subject : input.Severity + " logistics exception " + input.Exception_Number
			                        message : "A " + input.Exception_Type + " exception was reported at hub " + input.Reporting_Hub + ". Review the internal Shipment Exception Queue."
			                    )
			                    for each operations_manager in Operations_Users[Active == true && Application_Role == "Operations Manager"]
			                    {
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : operations_manager.Work_Email
			                            subject : input.Severity + " logistics exception " + input.Exception_Number
			                            message : "A " + input.Exception_Type + " exception was reported at hub " + input.Reporting_Hub + ". Review the internal Shipment Exception Queue."
			                        )
			                    }
			                }
			            )
			        }
			    }
			}

			Shipment_Exceptions_On_Validate as "Validate Shipment Exception"
			{
			    type = form
			    form = Shipment_Exceptions
			    record event = on add or edit
			    description = "Enforces exception references, evidence, ownership, hub access, and controlled resolution"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                authorised_profile = current_profile == "Logistics_Administrator" || current_profile == "Operations_Manager" || current_profile == "Hub_Supervisor";
			                logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                effective_hub = null;
			                if(logged_user.count(ID) > 0)
			                {
			                    effective_hub = logged_user.Home_Hub;
			                    deputation_active = logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate);
			                    if(deputation_active == true)
			                    {
			                        effective_hub = logged_user.Deputed_Hub;
			                    }
			                }
			                hub_authorised = current_profile != "Hub_Supervisor" || effective_hub == input.Reporting_Hub;
			                if(authorised_profile == false || hub_authorised == false)
			                {
			                    alert "Only authorised operations management or the reporting hub supervisor can save this exception.";
			                    cancel submit;
			                }
			                if(input.Shipment == null && input.Bag == null && input.Manifest == null)
			                {
			                    alert "Link at least one shipment, bag, or manifest to the exception.";
			                    cancel submit;
			                }
			                evidence_required = input.Exception_Type == "Missing" || input.Exception_Type == "Damaged" || input.Exception_Type == "Short" || input.Exception_Type == "Seal Mismatch";
			                if(evidence_required == true && input.Evidence_Photo == null)
			                {
			                    alert "A photo is mandatory for missing, damaged, short, and seal mismatch exceptions.";
			                    cancel submit;
			                }
			                if(input.Assigned_To_Email != null)
			                {
			                    assignee = Operations_Users[Work_Email == input.Assigned_To_Email && Active == true];
			                    if(assignee.count(ID) == 0)
			                    {
			                        alert "Assign the exception to an active operations user email.";
			                        cancel submit;
			                    }
			                }
			                if(input.Exception_Status == "Investigating" && input.Assigned_To_Email == null)
			                {
			                    alert "Assign an owner before moving an exception to Investigating.";
			                    cancel submit;
			                }
			                if(input.Exception_Status == "Claim Raised" && ifnull(input.Resolution,"").trim() == "")
			                {
			                    alert "Enter claim or escalation details in Resolution before raising a claim.";
			                    cancel submit;
			                }
			                if(input.ID == null)
			                {
			                    input.Reported_By_Email = zoho.loginuserid;
			                    input.Reported_At = zoho.currenttime;
			                    input.Exception_Status = "Open";
			                    input.Resolved_By_Email = null;
			                    input.Resolved_At = null;
			                }
			                else
			                {
			                    existing_record = Shipment_Exceptions[ID == input.ID];
			                    input.Shipment = existing_record.Shipment;
			                    input.Bag = existing_record.Bag;
			                    input.Manifest = existing_record.Manifest;
			                    input.Exception_Type = existing_record.Exception_Type;
			                    input.Severity = existing_record.Severity;
			                    input.Reporting_Hub = existing_record.Reporting_Hub;
			                    input.Reported_By_Email = existing_record.Reported_By_Email;
			                    input.Reported_At = existing_record.Reported_At;
			                    input.Resolved_By_Email = existing_record.Resolved_By_Email;
			                    input.Resolved_At = existing_record.Resolved_At;
			                    if(existing_record.Exception_Status == "Resolved")
			                    {
			                        alert "Resolved exception evidence is immutable.";
			                        cancel submit;
			                    }
			                    if(input.Exception_Status == "Resolved")
			                    {
			                        alert "Use the Resolve Exception report action so resolver evidence and linked records are updated together.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Actual_Weight_Kg_On_User_Input as "Rate Shipment on Actual Weight Change"
			{
			    type = form
			    form = Shipment_Requests
			    record event = on add or edit
			    description = "Recalculates billable weight and charges when actual weight changes"
			
			    on user input of Actual_Weight_Kg
			    {
			        actions
			        {
			            custom deluge script
			            (
			                quote = thisapp.Calculate_Shipment_Quote(ifnull(input.Customer,0),ifnull(input.Pickup_Pincode,""),ifnull(input.Delivery_Pincode,""),ifnull(input.Transport_Mode,""),ifnull(input.Length_Cm,0),ifnull(input.Width_Cm,0),ifnull(input.Height_Cm,0),ifnull(input.Actual_Weight_Kg,0),ifnull(input.Payment_Type,""),ifnull(input.Loyalty_Points_Redeemed,0));
			                if(quote.get("valid") == true)
			                {
			                    input.Volumetric_Weight_Kg = quote.get("volumetric_weight");
			                    input.Billable_Weight_Kg = quote.get("billable_weight");
			                    input.Rated_Distance_Km = quote.get("rated_distance");
			                    input.Applied_Rate_Card = quote.get("rate_card_id");
			                    input.Applied_Rate_Slab = quote.get("rate_slab_id");
			                    input.Base_Rate = quote.get("base_rate");
			                    input.Fuel_Surcharge = quote.get("fuel_surcharge");
			                    input.COD_Handling_Fee = quote.get("cod_fee");
			                    input.GST_Amount = quote.get("gst_amount");
			                    input.Gross_Amount = quote.get("gross_amount");
			                    input.Loyalty_Redemption_Amount = quote.get("redemption_amount");
			                    input.Total_Payable = quote.get("total_payable");
			                }
			                else
			                {
			                    input.Volumetric_Weight_Kg = 0;
			                    input.Billable_Weight_Kg = 0;
			                    input.Rated_Distance_Km = 0;
			                    input.Applied_Rate_Card = null;
			                    input.Applied_Rate_Slab = null;
			                    input.Base_Rate = 0;
			                    input.Fuel_Surcharge = 0;
			                    input.COD_Handling_Fee = 0;
			                    input.GST_Amount = 0;
			                    input.Gross_Amount = 0;
			                    input.Loyalty_Redemption_Amount = 0;
			                    input.Total_Payable = 0;
			                }
			            )
			        }
			    }
			}

			Customer_On_User_Input as "Rate Shipment on Customer Change"
			{
			    type = form
			    form = Shipment_Requests
			    record event = on add or edit
			    description = "Prefills sender details and recalculates the shipment quote when the customer changes"
			
			    on user input of Customer
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Customer != null)
			                {
			                    customer_record = Customers[ID == input.Customer];
			                    if(customer_record.count(ID) > 0)
			                    {
			                        input.Sender_Name = ifnull(customer_record.Full_Name.first_name,"") + " " + ifnull(customer_record.Full_Name.last_name,"");
			                        input.Sender_Phone = customer_record.Mobile_Number;
			                        input.Sender_Email = customer_record.Email_ID;
			                        input.Pickup_Address = customer_record.Primary_Address;
			                        input.Pickup_Pincode = customer_record.Primary_Address.postal_Code;
			                        if(customer_record.Payment_Terms == "Prepaid")
			                        {
			                            input.Payment_Type = "Prepaid";
			                        }
			                    }
			                }
			                quote = thisapp.Calculate_Shipment_Quote(ifnull(input.Customer,0),ifnull(input.Pickup_Pincode,""),ifnull(input.Delivery_Pincode,""),ifnull(input.Transport_Mode,""),ifnull(input.Length_Cm,0),ifnull(input.Width_Cm,0),ifnull(input.Height_Cm,0),ifnull(input.Actual_Weight_Kg,0),ifnull(input.Payment_Type,""),ifnull(input.Loyalty_Points_Redeemed,0));
			                if(quote.get("valid") == true)
			                {
			                    input.Volumetric_Weight_Kg = quote.get("volumetric_weight");
			                    input.Billable_Weight_Kg = quote.get("billable_weight");
			                    input.Rated_Distance_Km = quote.get("rated_distance");
			                    input.Applied_Rate_Card = quote.get("rate_card_id");
			                    input.Applied_Rate_Slab = quote.get("rate_slab_id");
			                    input.Base_Rate = quote.get("base_rate");
			                    input.Fuel_Surcharge = quote.get("fuel_surcharge");
			                    input.COD_Handling_Fee = quote.get("cod_fee");
			                    input.GST_Amount = quote.get("gst_amount");
			                    input.Gross_Amount = quote.get("gross_amount");
			                    input.Loyalty_Redemption_Amount = quote.get("redemption_amount");
			                    input.Total_Payable = quote.get("total_payable");
			                }
			                else
			                {
			                    input.Volumetric_Weight_Kg = 0;
			                    input.Billable_Weight_Kg = 0;
			                    input.Rated_Distance_Km = 0;
			                    input.Applied_Rate_Card = null;
			                    input.Applied_Rate_Slab = null;
			                    input.Base_Rate = 0;
			                    input.Fuel_Surcharge = 0;
			                    input.COD_Handling_Fee = 0;
			                    input.GST_Amount = 0;
			                    input.Gross_Amount = 0;
			                    input.Loyalty_Redemption_Amount = 0;
			                    input.Total_Payable = 0;
			                }
			            )
			        }
			    }
			}

