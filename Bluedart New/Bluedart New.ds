application "Bluedart-New"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Account_Ledger
		{
		    title
		    {
		        displayname = "Account Ledger"
		        on add = "Post Ledger Entry"
		        on edit = "Review Ledger Entry"
		    }
		    success message = "Ledger entry saved successfully"
		
		    Ledger_Identity
		    (
		        type = section
		        displayname = "Ledger Identity"
		        row = 1
		        column = 0
		    )
		    Ledger_Entry_ID
		    (
		        type = autonumber
		        displayname = "Ledger Entry ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Customer
		    (
		        type = picklist
		        displayname = "Customer"
		        values = Customers.ID
		        displayformat = [Customer_ID]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Shipment
		    (
		        type = picklist
		        displayname = "Shipment"
		        values = Shipment_Requests.ID
		        displayformat = [AWB_Number]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Invoice
		    (
		        type = picklist
		        displayname = "Invoice"
		        values = Invoices.ID
		        displayformat = [Invoice_Number]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Transaction_Type
		    (
		        type = picklist
		        displayname = "Transaction Type"
		        values = {"Debit","Credit","Payment","COD Settlement","Rebate","Refund","Adjustment"}
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Amount_and_Status
		    (
		        type = section
		        displayname = "Amount and Status"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Amount
		    (
		        type = INR
		        displayname = "Amount"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Transaction_Date
		    (
		        type = datetime
		        displayname = "Transaction Date"
		        initial value = "${zoho.currenttime}"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Due_Date
		    (
		        type = date
		        displayname = "Due Date"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Ledger_Status
		    (
		        type = picklist
		        displayname = "Ledger Status"
		        values = {"Open","Partially Settled","Settled","Overdue"}
		        initial value = "Open"
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Ageing_Bucket
		    (
		        type = picklist
		        displayname = "Ageing Bucket"
		        values = {"Current","1-30 Days","31-60 Days","61-90 Days","90+ Days","Not Applicable"}
		        initial value = "Not Applicable"
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Reference_and_Ownership
		    (
		        type = section
		        displayname = "Reference and Ownership"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Payment_Reference
		    (
		        type = text
		        displayname = "Payment Reference"
		        maxchar = 100
		        row = 3
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 3
		        column = 2
		        width = medium
		    )
		    Posted_By_Email
		    (
		        type = email
		        displayname = "Posted By Email"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Customer_Login_Email
		    (
		        type = email
		        displayname = "Customer Login Email"
		        personal data = true
		        row = 3
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Post Entry"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Status"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form App_Configuration
		{
		    title
		    {
		        displayname = "Application Configuration"
		        on add = "Add Operations Policy"
		        on edit = "Edit Operations Policy"
		    }
		    success message = "Operations policy saved successfully"
		    General_Settings
		    (
		        type = section
		        displayname = "General Settings"
		        row = 1
		        column = 0
		    )
		    must have unique Configuration_Name
		    (
		        type = text
		        displayname = "Configuration Name"
		        initial value = "Default Operations Policy"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have KYC_Expiry_Alert_Days
		    (
		        type = number
		        displayname = "KYC Expiry Alert Days"
		        initial value = 30
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Notification_Retry_Limit
		    (
		        type = number
		        displayname = "Notification Retry Limit"
		        initial value = 3
		        row = 1
		        column = 2
		        width = medium
		    )
		    Operations_Policy
		    (
		        type = section
		        displayname = "Operations Policy"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have High_Credit_KYC_Threshold
		    (
		        type = INR
		        displayname = "High Credit KYC Threshold"
		        format = commadotindian
		        initial value = 500000
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Maximum_NDR_Attempts
		    (
		        type = number
		        displayname = "Maximum NDR Attempts"
		        initial value = 3
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have COD_Payout_Cycle
		    (
		        type = picklist
		        displayname = "COD Payout Cycle"
		        values = {"T+2","Weekly"}
		        initial value = "T+2"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Loyalty_Rating_Policy
		    (
		        type = section
		        displayname = "Loyalty and Rating"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    must have Points_Expiry_Months
		    (
		        type = number
		        displayname = "Points Expiry Months"
		        initial value = 12
		        row = 3
		        column = 1
		        width = medium
		    )
		    must have Default_Volumetric_Divisor
		    (
		        type = number
		        displayname = "Default Volumetric Divisor"
		        initial value = 5000
		        row = 3
		        column = 2
		        width = medium
		    )
		    must have Loyalty_Redemption_Value_Per_Point
		    (
		        type = INR
		        displayname = "Redemption Value Per Point"
		        format = commadotindian
		        initial value = 1
		        decimalplace = 2
		        maxchar = 16
		        row = 3
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Policy"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Policy"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Audit_Log
		{
		    title
		    {
		        displayname = "Audit Log"
		        on add = "Record Audit Event"
		        on edit = "Review Audit Event"
		    }
		    success message = "Audit event recorded"
		
		    Event_Identity
		    (
		        type = section
		        displayname = "Event Identity"
		        row = 1
		        column = 0
		    )
		    Audit_ID
		    (
		        type = autonumber
		        displayname = "Audit ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Event_Time
		    (
		        type = datetime
		        displayname = "Event Time"
		        initial value = "${zoho.currenttime}"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Actor_Email
		    (
		        type = email
		        displayname = "Actor Email"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Actor_Profile
		    (
		        type = text
		        displayname = "Actor Profile"
		        maxchar = 100
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Action_Name
		    (
		        type = text
		        displayname = "Action Name"
		        maxchar = 150
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Module_Name
		    (
		        type = text
		        displayname = "Module Name"
		        maxchar = 150
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Record_ID
		    (
		        type = text
		        displayname = "Record ID"
		        maxchar = 100
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Evidence_Details
		    (
		        type = section
		        displayname = "Evidence Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Before_Data
		    (
		        type = textarea
		        displayname = "Before Data"
		        height = 120px
		        isencrypted = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    After_Data
		    (
		        type = textarea
		        displayname = "After Data"
		        height = 120px
		        isencrypted = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Source
		    (
		        type = picklist
		        displayname = "Source"
		        values = {"Form Workflow","Report Action","Schedule","Payment","Integration","Admin Correction"}
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Severity
		    (
		        type = picklist
		        displayname = "Severity"
		        values = {"Info","Warning","Critical"}
		        initial value = "Info"
		        row = 2
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Record Event"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Event"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Bag_Shipments
		{
		    title
		    {
		        displayname = "Bag Shipments"
		        on add = "Scan Shipment into Bag"
		        on edit = "View Bag Shipment"
		    }
		    success message = "Bag shipment saved successfully"
		    Bag_Assignment
		    (
		        type = section
		        displayname = "Bag Assignment"
		        row = 1
		        column = 0
		    )
		    must have Bag
		    (
		        type = picklist
		        displayname = "Bag"
		        values = Logistics_Bags.ID
		        displayformat = [Bag_Number]
		        searchable = true
		        sortorder = ascending
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Shipment
		    (
		        type = picklist
		        displayname = "Shipment"
		        values = Shipment_Requests.ID
		        displayformat = [AWB_Number]
		        searchable = true
		        sortorder = ascending
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Scan_Status
		    (
		        type = picklist
		        displayname = "Scan Status"
		        values = {"Loaded","Received","Missing","Damaged","Removed"}
		        initial value = "Loaded"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Scan_Custody
		    (
		        type = section
		        displayname = "Scan Custody"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Scanned_At
		    (
		        type = datetime
		        displayname = "Scanned At"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Scanned_By_Email
		    (
		        type = email
		        displayname = "Scanned By Email"
		        personal data = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    Received_At
		    (
		        type = datetime
		        displayname = "Received At"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Exception_Notes
		    (
		        type = textarea
		        displayname = "Exception Notes"
		        height = 100px
		        row = 2
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Scan into Bag"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form COD_Remittances
		{
		    title
		    {
		        displayname = "COD Remittances"
		        on add = "Record COD Remittance"
		        on edit = "Update COD Remittance"
		    }
		    success message = "COD remittance saved successfully"
		
		    Remittance_Identity
		    (
		        type = section
		        displayname = "Remittance Identity"
		        row = 1
		        column = 0
		    )
		    Remittance_Number
		    (
		        type = autonumber
		        displayname = "Remittance Number"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Delivery_Run_Sheet
		    (
		        type = picklist
		        displayname = "Delivery Run Sheet"
		        values = Delivery_Run_Sheets.ID
		        displayformat = [DRS_Number]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Agent
		    (
		        type = picklist
		        displayname = "Delivery Agent"
		        values = Operations_Users.ID
		        displayformat = [Employee_ID]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Hub
		    (
		        type = picklist
		        displayname = "Hub"
		        values = Hubs.ID
		        displayformat = [Hub_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Remittance_Date
		    (
		        type = date
		        displayname = "Remittance Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Cash_Reconciliation
		    (
		        type = section
		        displayname = "Cash Reconciliation"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Expected_Amount
		    (
		        type = INR
		        displayname = "Expected Amount"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Submitted_Amount
		    (
		        type = INR
		        displayname = "Submitted Amount"
		        format = commadotindian
		        initial value = 0
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 2
		        width = medium
		    )
		    Shortfall_Amount
		    (
		        type = INR
		        displayname = "Shortfall Amount"
		        format = commadotindian
		        initial value = 0
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Remittance_Status
		    (
		        type = picklist
		        displayname = "Remittance Status"
		        values = {"Pending","Confirmed","Shortfall"}
		        initial value = "Pending"
		        row = 2
		        column = 2
		        width = medium
		    )
		
		    Confirmation_and_Payout
		    (
		        type = section
		        displayname = "Confirmation and Payout"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Cashier_Email
		    (
		        type = email
		        displayname = "Cashier Email"
		        personal data = true
		        row = 3
		        column = 1
		        width = medium
		    )
		    Confirmed_At
		    (
		        type = datetime
		        displayname = "Confirmed At"
		        row = 3
		        column = 2
		        width = medium
		    )
		    Customer_Payout_Due_Date
		    (
		        type = date
		        displayname = "Customer Payout Due Date"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 3
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit Remittance"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Remittance"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Communication_Log
		{
		    title
		    {
		        displayname = "Communication Log"
		        on add = "Queue Communication"
		        on edit = "Review Communication"
		    }
		    success message = "Communication record saved"
		
		    Communication_Identity
		    (
		        type = section
		        displayname = "Communication Identity"
		        row = 1
		        column = 0
		    )
		    Communication_ID
		    (
		        type = autonumber
		        displayname = "Communication ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    Customer
		    (
		        type = picklist
		        displayname = "Customer"
		        values = Customers.ID
		        displayformat = [Customer_ID]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Shipment
		    (
		        type = picklist
		        displayname = "Shipment"
		        values = Shipment_Requests.ID
		        displayformat = [AWB_Number]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Recipient
		    (
		        type = text
		        displayname = "Recipient"
		        maxchar = 255
		        personal data = true
		        isencrypted = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Channel
		    (
		        type = picklist
		        displayname = "Channel"
		        values = {"Email","SMS","WhatsApp","Portal Notification"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Template_Code
		    (
		        type = text
		        displayname = "Template Code"
		        maxchar = 100
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Message_Details
		    (
		        type = section
		        displayname = "Message Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Subject
		    (
		        type = text
		        displayname = "Subject"
		        maxchar = 255
		        row = 2
		        column = 1
		        width = medium
		    )
		    Message_Summary
		    (
		        type = textarea
		        displayname = "Message Summary"
		        height = 120px
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Provider
		    (
		        type = picklist
		        displayname = "Provider"
		        values = {"Zoho Mail","ZeptoMail","PhoneBridge","Configured SMS Gateway","Other"}
		        row = 2
		        column = 1
		        width = medium
		    )
		    Provider_Message_ID
		    (
		        type = text
		        displayname = "Provider Message ID"
		        maxchar = 255
		        row = 2
		        column = 2
		        width = medium
		    )
		
		    Delivery_Outcome
		    (
		        type = section
		        displayname = "Delivery Outcome"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    must have Communication_Status
		    (
		        type = picklist
		        displayname = "Communication Status"
		        values = {"Queued","Sent","Delivered","Failed"}
		        initial value = "Queued"
		        row = 3
		        column = 1
		        width = medium
		    )
		    must have Attempt_Count
		    (
		        type = number
		        displayname = "Attempt Count"
		        initial value = 0
		        row = 3
		        column = 2
		        width = medium
		    )
		    Last_Attempt_At
		    (
		        type = datetime
		        displayname = "Last Attempt At"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Failure_Reason
		    (
		        type = textarea
		        displayname = "Failure Reason"
		        height = 100px
		        row = 3
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Queue Communication"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Communication"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Customer_KYC_Documents
		{
		    title
		    {
		        displayname = "Customer KYC Documents"
		        on add = "Add KYC Document"
		        on edit = "Upload or Review KYC Document"
		    }
		    success message = "KYC document saved successfully"
		    Document_Identity
		    (
		        type = section
		        displayname = "Document Identity"
		        row = 1
		        column = 0
		    )
		    KYC_Document_ID
		    (
		        type = autonumber
		        displayname = "KYC Document ID"
		        start index = 100001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Customer
		    (
		        type = picklist
		        displayname = "Customer"
		        values = Customers[Customer_Type != "Retail"].ID
		        displayformat = [Company_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Document_Type
		    (
		        type = picklist
		        displayname = "Document Type"
		        values = KYC_Document_Types[Active == true].ID
		        displayformat = [Document_Name]
		        searchable = true
		        sortorder = ascending
		        row = 1
		        column = 1
		        width = medium
		    )
		    Required_For_Onboarding
		    (
		        type = checkbox
		        displayname = "Required for Onboarding"
		        initial value = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Upload_Details
		    (
		        type = section
		        displayname = "Upload Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Document_Number
		    (
		        type = text
		        displayname = "Document Number"
		        isencrypted = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    Expiry_Date
		    (
		        type = date
		        displayname = "Expiry Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Uploaded_File
		    (
		        type = upload file
		        displayname = "Uploaded File"
		        browse = local_drive, google_docs, zoho_docs
		        description [ type = tooltip  message = "Upload one PDF, JPG, or JPEG file within the limit configured for this document type." ]
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have File_Version
		    (
		        type = number
		        displayname = "File Version"
		        initial value = 1
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Review_Status
		    (
		        type = picklist
		        displayname = "Review Status"
		        values = {"Pending Upload","Pending Verification","Verified","Query"}
		        initial value = "Pending Upload"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Uploaded_On
		    (
		        type = datetime
		        displayname = "Uploaded On"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Review_Details
		    (
		        type = section
		        displayname = "Review Details"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Review_Remarks
		    (
		        type = textarea
		        displayname = "Review Remarks"
		        height = 100px
		        row = 3
		        column = 1
		        width = medium
		    )
		    Reviewed_By_Email
		    (
		        type = email
		        displayname = "Reviewed By Email"
		        row = 3
		        column = 2
		        width = medium
		    )
		    Reviewed_On
		    (
		        type = datetime
		        displayname = "Reviewed On"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Locked_After_Verification
		    (
		        type = checkbox
		        displayname = "Locked After Verification"
		        initial value = false
		        row = 3
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save KYC Document"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Save Upload"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Customers
		{
		    title
		    {
		        displayname = "Customers"
		        on add = "Onboard Customer"
		        on edit = "Update Customer"
		    }
		    success message = "Customer profile saved successfully"
		    Customer_Identity
		    (
		        type = section
		        displayname = "Customer Identity"
		        row = 1
		        column = 0
		    )
		    Customer_ID
		    (
		        type = autonumber
		        displayname = "Customer ID"
		        start index = 100001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Registration_Source
		    (
		        type = radiobuttons
		        displayname = "Registration Source"
		        values = {"Customer Portal","Employee"}
		        layout = 2
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Customer_Type
		    (
		        type = radiobuttons
		        displayname = "Customer Type"
		        values = {"Retail","Corporate","Wholesale"}
		        layout = 3
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Full_Name
		    (
		        type = name
		        displayname = "Full Name"
		        personal data = true
		        prefix
		        (
		            type = prefix
		            displayname = "Title"
		            value = {"Mr.","Ms.","Mrs.","Dr."}
		        )
		        first_name
		        (
		            type = first_name
		            displayname = "First Name"
		        )
		        last_name
		        (
		            type = last_name
		            displayname = "Last Name"
		        )
		        suffix
		        (
		            type = suffix
		            displayname = "Suffix"
		            visibility = false
		        )
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Mobile_Number
