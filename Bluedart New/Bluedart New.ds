			Unseal_Bag as "Unseal Bag"
			{
			    type = functions
			    form = Logistics_Bags
			    execution type = for each record
			    description = "Unseals a received bag at the destination after custody verification"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = "POC Process User";
			                logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                deputation_active = logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate);
			                effective_hub = logged_user.Home_Hub;
			                if(deputation_active == true)
			                {
			                    effective_hub = logged_user.Deputed_Hub;
			                }
			                authorised = logged_user.count(ID) > 0 && effective_hub == input.Destination_Hub;
			                if(authorised == false)
			                {
			                    info "Only an active operations user at the destination hub can unseal this bag.";
			                }
			                else if(input.Bag_Status != "Received" || ifnull(input.Seal_Code,"").trim() == "")
			                {
			                    info "Only a received bag with a verified seal can be unsealed.";
			                }
			                else
			                {
			                    pending_reconciliation = Bag_Shipments[Bag == input.ID && Scan_Status == "Loaded"].count(ID);
			                    if(pending_reconciliation > 0)
			                    {
			                        info "Reconcile every expected AWB as received, missing, damaged, or removed before unsealing the bag.";
			                    }
			                    else
			                    {
			                        input.Bag_Status = "Unsealed";
			                        audit_id = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.loginuserid
			                            Actor_Profile = current_profile
			                            Action_Name = "Unseal Bag"
			                            Module_Name = "Logistics Bags"
			                            Record_ID = input.ID.toString()
			                            Before_Data = "Status=Received; Seal=" + input.Seal_Code
			                            After_Data = "Status=Unsealed; Reconciliation=Complete"
			                            Source = "Report Action"
			                            Severity = "Critical"
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

			Activate_Loyalty_Rule as "Activate Loyalty Rule"
			{
			    type = functions
			    form = Loyalty_Rules
			    execution type = for each record
			    description = "Activates a draft earning rule only when its scope and period remain deterministic"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                if(current_profile != "Logistics_Administrator" && current_profile != "Finance_Officer")
			                {
			                    info "Only Logistics Administrators and Finance Officers can activate loyalty rules.";
			                }
			                else if(input.Status != "Draft")
			                {
			                    info "Only draft loyalty rules can be activated.";
			                }
			                else if(input.Effective_To != null && input.Effective_To < zoho.currentdate)
			                {
			                    info "This rule's effective period has already ended.";
			                }
			                else
			                {
			                    ambiguous_count = 0;
			                    for each candidate in Loyalty_Rules[ID != input.ID && Status == "Active" && Minimum_Shipment_Amount == input.Minimum_Shipment_Amount]
			                    {
			                        customer_scope_overlaps = candidate.Customer_Type == input.Customer_Type || candidate.Customer_Type == "All" || input.Customer_Type == "All";
			                        mode_scope_overlaps = candidate.Transport_Mode == input.Transport_Mode || candidate.Transport_Mode == "Any" || input.Transport_Mode == "Any";
			                        date_scope_overlaps = (candidate.Effective_To == null || candidate.Effective_To >= input.Effective_From) && (input.Effective_To == null || candidate.Effective_From <= input.Effective_To);
			                        if(customer_scope_overlaps == true && mode_scope_overlaps == true && date_scope_overlaps == true)
			                        {
			                            ambiguous_count = ambiguous_count + 1;
			                        }
			                    }
			                    if(ambiguous_count > 0)
			                    {
			                        info "Activation would overlap another active rule at the same amount threshold.";
			                    }
			                    else
			                    {
			                        input.Status = "Active";
			                        audit_id = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.loginuserid
			                            Actor_Profile = current_profile
			                            Action_Name = "Activate Loyalty Rule"
			                            Module_Name = "Loyalty Rules"
			                            Record_ID = input.ID.toString()
			                            Before_Data = "Status=Draft"
			                            After_Data = "Status=Active; Rule=" + input.Loyalty_Rule_ID + "; Effective From=" + input.Effective_From + "; Effective To=" + input.Effective_To
			                            Source = "Report Action"
			                            Severity = "Critical"
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

			Expire_Active_Loyalty_Rule as "Expire Rule - Active Loyalty Rules"
			{
			    type = functions
			    form = Loyalty_Rules
			    execution type = for each record
			    description = "Ends an active earning rule and preserves its effective-period history"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                if(current_profile != "Logistics_Administrator" && current_profile != "Finance_Officer")
			                {
			                    info "Only Logistics Administrators and Finance Officers can expire loyalty rules.";
			                }
			                else if(input.Status != "Active")
			                {
			                    info "Only active loyalty rules can be expired.";
			                }
			                else
			                {
			                    previous_effective_to = input.Effective_To;
			                    input.Status = "Expired";
			                    if(input.Effective_To == null || input.Effective_To > zoho.currentdate)
			                    {
			                        input.Effective_To = zoho.currentdate;
			                    }
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuserid
			                        Actor_Profile = current_profile
			                        Action_Name = "Expire Loyalty Rule"
			                        Module_Name = "Loyalty Rules"
			                        Record_ID = input.ID.toString()
			                        Before_Data = "Status=Active; Effective To=" + previous_effective_to
			                        After_Data = "Status=Expired; Effective To=" + input.Effective_To
			                        Source = "Report Action"
			                        Severity = "Critical"
			                    ];
			                }
			            )
			        }
			    }
			}

