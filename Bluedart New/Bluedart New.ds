			KYC_Document_Types_On_Success as "Audit KYC Document Type"
			{
			    type = form
			    form = KYC_Document_Types
			    record event = on add or edit
			    description = "Audits KYC checklist preset changes"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = "KYC Administration"
			                    Action_Name = "Save KYC Document Type"
			                    Module_Name = "KYC Document Types"
			                    Record_ID = input.ID.toString()
			                    After_Data = "Code=" + input.Document_Code + "; Applies To=" + input.Applies_To + "; Mandatory=" + input.Mandatory_By_Default + "; Conditional=" + input.Conditional_On_Credit_Threshold + "; Active=" + input.Active
			                    Source = "Form Workflow"
			                    Severity = "Info"
			                ];
			            )
			        }
			    }
			}

			KYC_Document_Types_On_Validate as "Validate KYC Document Type"
			{
			    type = form
			    form = KYC_Document_Types
			    record event = on add or edit
			    description = "Validates conditional thresholds and upload configuration"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Conditional_On_Credit_Threshold == true && ifnull(input.Credit_Threshold,0) <= 0)
			                {
			                    alert "Credit Threshold must be greater than zero for a conditional document.";
			                    cancel submit;
			                }
			                if(ifnull(input.Maximum_File_Size_MB,0) <= 0 || input.Maximum_File_Size_MB > 50)
			                {
			                    alert "Maximum file size must be between 1 and 50 MB.";
			                    cancel submit;
			                }
			                if(ifnull(input.Display_Order,0) <= 0)
			                {
			                    alert "Display Order must be greater than zero.";
			                    cancel submit;
			                }
			                file_types = ifnull(input.Accepted_File_Types,"").toLowerCase().replaceAll(" ","");
			                if(file_types == "" || file_types.contains(".") || !file_types.matches("[a-z0-9]+(,[a-z0-9]+)*"))
			                {
			                    alert "Accepted File Types must be lowercase extensions separated by commas, for example pdf,jpg,jpeg.";
			                    cancel submit;
			                }
			                input.Accepted_File_Types = file_types;
			            )
			        }
			    }
			}

			Bag_Type_On_User_Input as "Filter Bag Destinations"
			{
			    type = form
			    form = Logistics_Bags
			    record event = on add or edit
			    description = "Filters destination hubs according to the selected bag movement type"
			
			    on user input of Bag_Type
			    {
			        actions
			        {
			            custom deluge script
			            (
			                clear Destination_Hub;
			                if(input.Bag_Type == "Feeder" && input.Origin_Hub != null)
			                {
			                    origin_record = Hubs[ID == input.Origin_Hub];
			                    Destination_Hub:ui.add(Hubs[ID == origin_record.Parent_Sorting_Hub && Active == true].ID.getall());
			                }
			                else if(input.Bag_Type == "Master")
			                {
			                    Destination_Hub:ui.add(Hubs[Hub_Type == "Sorting Hub" && Active == true && ID != input.Origin_Hub].ID.getall());
			                }
			                else if(input.Bag_Type == "Delivery Feeder" && input.Origin_Hub != null)
			                {
			                    Destination_Hub:ui.add(Hubs[Hub_Type == "Collection Center" && Parent_Sorting_Hub == input.Origin_Hub && Active == true].ID.getall());
			                }
			                else
			                {
			                    Destination_Hub:ui.add(Hubs[Active == true && ID != input.Origin_Hub].ID.getall());
			                }
			            )
			        }
			    }
			}

