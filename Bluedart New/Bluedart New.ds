	reports
	{
		default list Account_Ledger_Statement
		{
		    displayName = "Account Ledger Statement"
		    show all rows from Account_Ledger
		    (
		        Ledger_Entry_ID
		        Customer
		        Shipment
		        Invoice
		        Transaction_Type
		        Amount
		        (
		            display = total
		        )
		        Transaction_Date
		        Due_Date
		        Ledger_Status
		        Ageing_Bucket
		        Payment_Reference
		        Notes
		        Posted_By_Email
		        Customer_Login_Email
		    )
		    filters
		    (
		        Customer
		        Transaction_Type
		        Transaction_Date
		        Due_Date
		        Ledger_Status
		        Ageing_Bucket
		        "Open Entries" : (Ledger_Status == "Open" || Ledger_Status == "Partially Settled" || Ledger_Status == "Overdue")
		    )
		    sort by
		    (
		        Transaction_Date descending
		        Ledger_Entry_ID descending
		    )
		    conditional formatting
		    (
		        "Overdue Balance"
		        {
		            condition = (Ledger_Status == "Overdue")
		            fields = [Customer, Amount, Due_Date, Ledger_Status, Ageing_Bucket]
		            format = "background-color:#FEE2E2;color:#991B1B;font-weight:bold"
		        }
		        "Settled Entry"
		        {
		            condition = (Ledger_Status == "Settled")
		            fields = [Customer, Amount, Ledger_Status]
		            format = "background-color:#ECFDF5;color:#065F46"
		        }
		    )
		}

		list Credit_Utilization
		{
		    displayName = "Credit Utilization"
		    show all rows from Account_Ledger [(Transaction_Type == "Debit" || (Transaction_Type == "Adjustment" && Amount > 0)) && (Ledger_Status == "Open" || Ledger_Status == "Partially Settled" || Ledger_Status == "Overdue")]
		    (
		        Customer
		        Invoice
		        Shipment
		        Transaction_Type
		        Amount
		        (
		            display = total
		        )
		        Transaction_Date
		        Due_Date
		        Ledger_Status
		        Ageing_Bucket
		    )
		    filters
		    (
		        Customer
		        Transaction_Type
		        Due_Date
		        Ledger_Status
		        Ageing_Bucket
		    )
		    sort by
		    (
		        Amount descending
		        Due_Date ascending
		    )
		    conditional formatting
		    (
		        "High Risk Credit"
		        {
		            condition = (Ledger_Status == "Overdue" && (Ageing_Bucket == "61-90 Days" || Ageing_Bucket == "90+ Days"))
		            fields = [Customer, Amount, Due_Date, Ledger_Status, Ageing_Bucket]
		            format = "background-color:#7F1D1D;color:#FFFFFF;font-weight:bold"
		        }
		    )
		}

		list Ledger_Ageing
		{
		    displayName = "Ledger Ageing"
		    show all rows from Account_Ledger [(Transaction_Type == "Debit" || (Transaction_Type == "Adjustment" && Amount > 0)) && Ledger_Status != "Settled"]
		    (
		        Ageing_Bucket
		        Customer
		        Invoice
		        Shipment
		        Transaction_Type
		        Amount
		        (
		            display = total
		        )
		        Due_Date
		        Ledger_Status
		        Transaction_Date
		    )
		    filters
		    (
		        Ageing_Bucket
		        Customer
		        Transaction_Type
		        Due_Date
		        Ledger_Status
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Ageing_Bucket ascending
		        Customer ascending
		    )
		    sort by
		    (
		        Due_Date ascending
		        Amount descending
		    )
		    conditional formatting
		    (
		        "Ninety Plus Days"
		        {
		            condition = (Ageing_Bucket == "90+ Days")
		            fields = [Ageing_Bucket, Customer, Amount, Due_Date, Ledger_Status]
		            format = "background-color:#450A0A;color:#FFFFFF;font-weight:bold"
		        }
		        "Sixty Plus Days"
		        {
		            condition = (Ageing_Bucket == "61-90 Days")
		            fields = [Ageing_Bucket, Customer, Amount, Due_Date]
		            format = "background-color:#FFEDD5;color:#9A3412"
		        }
		    )
		}

		list My_Account_Statement
		{
		    displayName = "My Account Statement"
		    show all rows from Account_Ledger [Customer_Login_Email == zoho.loginuserid]
		    (
		        Ledger_Entry_ID
		        Shipment
		        Invoice
		        Transaction_Type
		        Amount
		        (
		            display = total
		        )
		        Transaction_Date
		        Due_Date
		        Ledger_Status
		        Ageing_Bucket
		        Payment_Reference
		        Notes
		        Customer_Login_Email
		    )
		    filters
		    (
		        Transaction_Type
		        Transaction_Date
		        Due_Date
		        Ledger_Status
		        Ageing_Bucket
		        "Open Entries" : (Ledger_Status == "Open" || Ledger_Status == "Partially Settled" || Ledger_Status == "Overdue")
		    )
		    sort by
		    (
		        Transaction_Date descending
		        Ledger_Entry_ID descending
		    )
		    conditional formatting
		    (
		        "Payment Due"
		        {
		            condition = (Ledger_Status == "Overdue")
		            fields = [Invoice, Amount, Due_Date, Ledger_Status, Ageing_Bucket]
		            format = "background-color:#FFF1F2;color:#9F1239;font-weight:bold"
		        }
		    )
		}

		list Outstanding_Accounts
		{
		    displayName = "Outstanding Accounts"
		    show all rows from Account_Ledger [(Transaction_Type == "Debit" || (Transaction_Type == "Adjustment" && Amount > 0)) && (Ledger_Status == "Open" || Ledger_Status == "Partially Settled" || Ledger_Status == "Overdue")]
		    (
		        Customer
		        Invoice
		        Shipment
		        Transaction_Type
		        Amount
		        (
		            display = total
		        )
		        Transaction_Date
		        Due_Date
		        Ledger_Status
		        Ageing_Bucket
		        Payment_Reference
		    )
		    filters
		    (
		        Customer
		        Transaction_Type
		        Due_Date
		        Ledger_Status
		        Ageing_Bucket
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Customer ascending
		    )
		    sort by
		    (
		        Due_Date ascending
		        Transaction_Date descending
		    )
		    conditional formatting
		    (
		        "Overdue Account"
		        {
		            condition = (Ledger_Status == "Overdue")
		            fields = [Customer, Invoice, Amount, Due_Date, Ledger_Status]
		            format = "background-color:#FEE2E2;color:#991B1B;font-weight:bold"
		        }
		    )
		}

		default list App_Configurations
		{
		    displayName = "Application Configurations"
		    show all rows from App_Configuration
		    (
		        Configuration_Name
		        High_Credit_KYC_Threshold
		        KYC_Expiry_Alert_Days
		        Maximum_NDR_Attempts
		        COD_Payout_Cycle
		        Points_Expiry_Months
		        Default_Volumetric_Divisor
		        Loyalty_Redemption_Value_Per_Point
		        Notification_Retry_Limit
		        Active
		    )
		    filters
		    (
		        Active
		        COD_Payout_Cycle
		    )
		    sort by
		    (
		        Configuration_Name ascending
		    )
		    conditional formatting
		    (
		        "Inactive Policy"
		        {
		            condition = (Active == false)
		            fields = [Configuration_Name, Active]
		            format = "background-color:#F3F4F6;color:#6B7280"
		        }
		    )
		}

		default list Audit_Log_Report
		{
		    displayName = "Audit Log"
		    show all rows from Audit_Log
		    (
		        Audit_ID
		        Event_Time
		        Actor_Email
		        Actor_Profile
		        Action_Name
		        Module_Name
		        Record_ID
		        Before_Data
		        After_Data
		        Source
		        Severity
		    )
		    filters
		    (
		        Event_Time
		        Actor_Email
		        Actor_Profile
		        Action_Name
		        Module_Name
		        Source
		        Severity
		    )
		    sort by
		    (
		        Event_Time descending
		        Audit_ID descending
		    )
		    conditional formatting
		    (
		        "Critical Event"
		        {
		            condition = (Severity == "Critical")
		            fields = [Audit_ID, Event_Time, Actor_Email, Action_Name, Module_Name, Severity]
		            format = "background-color:#FEE2E2;color:#991B1B;font-weight:bold"
		        }
		        "Warning Event"
		        {
		            condition = (Severity == "Warning")
		            fields = [Audit_ID, Event_Time, Actor_Email, Action_Name, Module_Name, Severity]
		            format = "background-color:#FEF3C7;color:#92400E"
		        }
		    )
		}

