			Assign_Collection_Center as "Assign Collection Center"
			{
			    type = functions
			    form = Shipment_Requests
			    execution type = for each record
			    description = "Assigns the configured primary collection and destination hubs after profile, serviceability, cutoff, and capacity checks"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                if(input.Shipment_Status != "Booked - Hub Assignment Pending")
			                {
			                    info "This shipment is no longer awaiting hub assignment.";
			                }
			                else
			                {
			                    pickup_map = Hub_Pincode_Mapping[Pincode == input.Pickup_Pincode && Active == true && Serviceability != "Non-Serviceable"];
			                    delivery_map = Hub_Pincode_Mapping[Pincode == input.Delivery_Pincode && Active == true && Serviceability != "Non-Serviceable"];
			                    if(pickup_map.count(ID) == 0 || delivery_map.count(ID) == 0)
			                    {
			                        info "Active serviceability mappings are required for both pincodes.";
			                    }
			                    else
			                    {
			                        origin_hub = Hubs[ID == pickup_map.Primary_Collection_Center && Active == true];
			                        destination_hub = Hubs[ID == delivery_map.Primary_Collection_Center && Active == true];
			                        if(origin_hub.count(ID) == 0 || destination_hub.count(ID) == 0)
			                        {
			                            info "The configured primary collection or destination hub is inactive.";
			                        }
			                        else
			                        {
			                            todays_load = Shipment_Requests[Collection_Center == origin_hub.ID && Booked_On >= zoho.currentdate && Shipment_Status != "Cancelled"].count(ID);
			                            after_cutoff = zoho.currenttime.getHour() > origin_hub.Cut_Off_Time.getHour() || (zoho.currenttime.getHour() == origin_hub.Cut_Off_Time.getHour() && zoho.currenttime.getMinutes() > origin_hub.Cut_Off_Time.getMinutes());
			                            if(todays_load >= origin_hub.Daily_Capacity || after_cutoff == true)
			                            {
			                                info "The primary collection center is at capacity or past cutoff. Use Reassign Alternate Hub.";
			                            }
			                            else
			                            {
			                                input.Collection_Center = origin_hub.ID;
			                                input.Origin_Sorting_Hub = origin_hub.Parent_Sorting_Hub;
			                                input.Destination_Hub = destination_hub.ID;
			                                input.Destination_Sorting_Hub = destination_hub.Parent_Sorting_Hub;
			                                input.Current_Hub = origin_hub.ID;
			                                input.Shipment_Status = "Booked";
			                                tracking_id = insert into Shipment_Tracking_Events
			                                [
			                                    Shipment = input.ID
			                                    Event_Time = zoho.currenttime
			                                    Event_Status = "Booked"
			                                    Hub = origin_hub.ID
			                                    Event_Description = "Shipment assigned to the configured primary collection center."
			                                    Source = "System"
			                                    Customer_Visible = true
			                                    Created_By_Email = zoho.loginuserid
			                                ];
			                                audit_id = insert into Audit_Log
			                                [
			                                    Event_Time = zoho.currenttime
			                                    Actor_Email = zoho.loginuserid
			                                    Actor_Profile = current_profile
			                                    Action_Name = "Assign Collection Center"
			                                    Module_Name = "Shipment Requests"
			                                    Record_ID = input.ID.toString()
			                                    Before_Data = "Status=Booked - Hub Assignment Pending"
			                                    After_Data = "Status=Booked; Collection Center=" + origin_hub.Hub_Name + "; Destination Hub=" + destination_hub.Hub_Name
			                                    Source = "Report Action"
			                                    Severity = "Warning"
			                                ];
			                            }
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Mark_Non_Serviceable as "Mark Non-Serviceable"
			{
			    type = functions
			    form = Shipment_Requests
			    execution type = for each record
			    description = "Cancels an unassigned non-serviceable shipment and queues paid bookings for provider-verified refund confirmation"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                if(input.Shipment_Status != "Booked - Hub Assignment Pending")
			                {
			                    info "Only a shipment awaiting hub assignment can be marked non-serviceable.";
			                }
			                else
			                {
			                    prior_payment_status = input.Payment_Status;
			                    input.Shipment_Status = "Cancelled";
			                    if(input.Payment_Status == "Paid")
			                    {
			                        for each payment_record in Payment_Transactions[Shipment == input.ID && Payment_Status == "Success"]
			                        {
			                            if(Audit_Log[Module_Name == "Payment Transactions" && Record_ID == payment_record.ID.toString() && Action_Name == "Refund Required"].count(ID) == 0)
			                            {
			                                refund_audit_id = insert into Audit_Log
			                                [
			                                    Event_Time = zoho.currenttime
			                                    Actor_Email = zoho.loginuserid
			                                    Actor_Profile = current_profile
			                                    Action_Name = "Refund Required"
			                                    Module_Name = "Payment Transactions"
			                                    Record_ID = payment_record.ID.toString()
			                                    Before_Data = "Payment Status=Success; Shipment Status=Booked - Hub Assignment Pending"
			                                    After_Data = "Payment Status=Success; Shipment Status=Cancelled; Provider refund confirmation required"
			                                    Source = "Report Action"
			                                    Severity = "Critical"
			                                ];
			                            }
			                        }
			                    }
			                    for each invoice_record in Invoices[Shipment == input.ID && Invoice_Status != "Void"]
			                    {
			                        invoice_record.Invoice_Status = "Void";
			                    }
			                    for each ledger_record in Account_Ledger[Shipment == input.ID && Transaction_Type == "Debit"]
			                    {
			                        reversal_reference = "CANCEL-" + input.AWB_Number + "-" + ledger_record.ID;
			                        if(Account_Ledger[Payment_Reference == reversal_reference].count(ID) == 0)
			                        {
			                            reversal_id = insert into Account_Ledger
			                            [
			                                Customer = input.Customer
			                                Shipment = input.ID
			                                Invoice = ledger_record.Invoice
			                                Transaction_Type = "Credit"
			                                Amount = ledger_record.Amount
			                                Transaction_Date = zoho.currenttime
			                                Ledger_Status = "Settled"
			                                Ageing_Bucket = "Not Applicable"
			                                Payment_Reference = reversal_reference
			                                Notes = "Reversing credit posted because the shipment was cancelled as non-serviceable."
			                                Posted_By_Email = zoho.loginuserid
			                                Customer_Login_Email = ledger_record.Customer_Login_Email
			                            ];
			                        }
			                        ledger_record.Ledger_Status = "Settled";
			                        ledger_record.Notes = ifnull(ledger_record.Notes,"") + " | Cancelled as non-serviceable" + if(prior_payment_status == "Paid","; paid status retained until provider refund is confirmed by finance.","; receivable reversed.") + " Reversal: " + reversal_reference + ".";
			                    }
			                    for each non_debit_ledger_record in Account_Ledger[Shipment == input.ID && Transaction_Type != "Debit" && Transaction_Type != "Credit" && Ledger_Status != "Settled"]
			                    {
			                        non_debit_ledger_record.Ledger_Status = "Settled";
			                        non_debit_ledger_record.Notes = ifnull(non_debit_ledger_record.Notes,"") + " | Shipment cancelled as non-serviceable.";
			                    }
			                    thisapp.Recalculate_Customer_Outstanding(input.Customer);
			                    if(ifnull(input.Loyalty_Points_Redeemed,0) > 0)
			                    {
			                        customer_record = Customers[ID == input.Customer];
			                        customer_record.Current_Loyalty_Points = ifnull(customer_record.Current_Loyalty_Points,0) + input.Loyalty_Points_Redeemed;
			                        reversal_id = insert into Loyalty_Transactions
			                        [
			                            Customer = input.Customer
			                            Shipment = input.ID
			                            Transaction_Type = "Reverse"
			                            Points = input.Loyalty_Points_Redeemed
			                            Amount_Equivalent = input.Loyalty_Redemption_Amount
			                            Transaction_Date = zoho.currenttime
			                            Points_Status = "Available"
			                            Applied_Tier = customer_record.Current_Loyalty_Tier
			                            Reference = "Non-serviceable cancellation for AWB " + input.AWB_Number
			                            Notes = "Restored points redeemed at booking"
			                            Posted_By_Email = zoho.loginuserid
			                            Customer_Login_Email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID)
			                        ];
			                    }
			                    tracking_id = insert into Shipment_Tracking_Events
			                    [
			                        Shipment = input.ID
			                        Event_Time = zoho.currenttime
			                        Event_Status = "Cancelled"
			                        Hub = input.Current_Hub
			                        Event_Description = "Shipment cancelled because the route could not be serviced."
			                        Source = "System"
			                        Customer_Visible = true
			                        Created_By_Email = zoho.loginuserid
			                    ];
			                    customer_record = Customers[ID == input.Customer];
			                    recipient_email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID);
			                    communication_summary = if(prior_payment_status == "Paid","Shipment was cancelled as non-serviceable. The paid amount is awaiting provider-confirmed refund processing.","Shipment was cancelled as non-serviceable. Any receivable and loyalty redemption were reversed.");
			                    communication_id = insert into Communication_Log
			                    [
			                        Customer = input.Customer
			                        Shipment = input.ID
			                        Recipient = recipient_email
			                        Channel = "Email"
			                        Template_Code = "SHIPMENT_NON_SERVICEABLE"
			                        Subject = "Shipment cancelled: AWB " + input.AWB_Number
			                        Message_Summary = communication_summary
			                        Provider = "Zoho Mail"
			                        Communication_Status = "Sent"
			                        Attempt_Count = 1
			                        Last_Attempt_At = zoho.currenttime
			                    ];
			                    sendmail
			                    [
			                        from: zoho.adminuserid
			                        to: recipient_email
			                        subject: "Shipment cancelled: AWB " + input.AWB_Number
			                        message: if(prior_payment_status == "Paid","We could not service this route, so the booking was cancelled. Your paid amount will be marked refunded only after our finance team verifies completion with the payment provider.","We could not service this route, so the booking was cancelled. Any redeemed loyalty points and open receivable have been reversed.")
			                    ]
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuserid
			                        Actor_Profile = current_profile
			                        Action_Name = "Mark Shipment Non-Serviceable"
			                        Module_Name = "Shipment Requests"
			                        Record_ID = input.ID.toString()
			                        Before_Data = "Status=Booked - Hub Assignment Pending; Payment Status=" + prior_payment_status
			                        After_Data = "Status=Cancelled; Payment Status=" + input.Payment_Status + if(prior_payment_status == "Paid","; Refund verification required","")
			                        Source = "Report Action"
			                        Severity = "Critical"
			                    ];
			                }
			            )
			        }
			    }
			}

			Reassign_Alternate_Hub as "Reassign Alternate Hub"
			{
			    type = functions
			    form = Shipment_Requests
			    execution type = for each record
			    description = "Assigns the configured overflow collection center while preserving the destination route"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                if(input.Shipment_Status != "Booked - Hub Assignment Pending")
			                {
			                    info "This shipment is no longer awaiting hub assignment.";
			                }
			                else
			                {
			                    pickup_map = Hub_Pincode_Mapping[Pincode == input.Pickup_Pincode && Active == true && Serviceability != "Non-Serviceable"];
			                    delivery_map = Hub_Pincode_Mapping[Pincode == input.Delivery_Pincode && Active == true && Serviceability != "Non-Serviceable"];
			                    if(pickup_map.count(ID) == 0 || delivery_map.count(ID) == 0 || pickup_map.Secondary_Overflow_Hub == null)
			                    {
			                        info "No active overflow-hub mapping is configured for this shipment.";
			                    }
			                    else
			                    {
			                        alternate_hub = Hubs[ID == pickup_map.Secondary_Overflow_Hub && Active == true];
			                        destination_hub = Hubs[ID == delivery_map.Primary_Collection_Center && Active == true];
			                        if(alternate_hub.count(ID) == 0 || destination_hub.count(ID) == 0)
			                        {
			                            info "The overflow collection or destination hub is inactive.";
			                        }
			                        else
			                        {
			                            todays_load = Shipment_Requests[Collection_Center == alternate_hub.ID && Booked_On >= zoho.currentdate && Shipment_Status != "Cancelled"].count(ID);
			                            after_cutoff = zoho.currenttime.getHour() > alternate_hub.Cut_Off_Time.getHour() || (zoho.currenttime.getHour() == alternate_hub.Cut_Off_Time.getHour() && zoho.currenttime.getMinutes() > alternate_hub.Cut_Off_Time.getMinutes());
			                            if(todays_load >= alternate_hub.Daily_Capacity || after_cutoff == true)
			                            {
			                                info "The configured overflow hub is also at capacity or past cutoff.";
			                            }
			                            else
			                            {
			                                input.Collection_Center = alternate_hub.ID;
			                                input.Origin_Sorting_Hub = alternate_hub.Parent_Sorting_Hub;
			                                input.Destination_Hub = destination_hub.ID;
			                                input.Destination_Sorting_Hub = destination_hub.Parent_Sorting_Hub;
			                                input.Current_Hub = alternate_hub.ID;
			                                input.Shipment_Status = "Booked";
			                                tracking_id = insert into Shipment_Tracking_Events
			                                [
			                                    Shipment = input.ID
			                                    Event_Time = zoho.currenttime
			                                    Event_Status = "Booked"
			                                    Hub = alternate_hub.ID
			                                    Event_Description = "Shipment assigned to the configured overflow collection center."
			                                    Source = "System"
			                                    Customer_Visible = true
			                                    Created_By_Email = zoho.loginuserid
			                                ];
			                                audit_id = insert into Audit_Log
			                                [
			                                    Event_Time = zoho.currenttime
			                                    Actor_Email = zoho.loginuserid
			                                    Actor_Profile = current_profile
			                                    Action_Name = "Reassign Alternate Hub"
			                                    Module_Name = "Shipment Requests"
			                                    Record_ID = input.ID.toString()
			                                    Before_Data = "Status=Booked - Hub Assignment Pending"
			                                    After_Data = "Status=Booked; Overflow Collection Center=" + alternate_hub.Hub_Name + "; Destination Hub=" + destination_hub.Hub_Name
			                                    Source = "Report Action"
			                                    Severity = "Warning"
			                                ];
			                            }
			                        }
			                    }
			                }
			            )
			        }
			    }
			}
		}

		blueprint
		{
			Customer_KYC_Lifecycle as "Customer KYC Lifecycle"
			{
			    type = blueprint
			    form = Customers[Customer_Type != "Retail"]
			
			    start
			    {
			        start stage = "KYC Pending"
			    }
			
			    stages
			    {
			        "KYC Pending" { }
			        "Pending Verification" { }
			        "Action Required" { }
			        "Active" { }
			        "KYC Expired" { }
			    }
			
			    transitions
			    {
			        Submit_KYC as "Submit KYC"
			        {
			            type = normal
			            from stage = "KYC Pending"
			            to stage = "Pending Verification"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Customer_Portal"}
			                )
			                transition criteria = ( KYC_Submitted_On is not null )
			                confirmation before execution
			                (
			                    message = "Submit all uploaded KYC documents for verification?"
			                    confirm button text = "Submit KYC"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        input.KYC_Submitted_On = zoho.currenttime;
			                        audit_id = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.loginuserid
			                            Actor_Profile = "Customer_Portal"
			                            Action_Name = "Submit KYC"
			                            Module_Name = "Customers"
			                            Record_ID = input.ID.toString()
			                            After_Data = "Status=Pending Verification"
			                            Source = "Form Workflow"
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			        Resubmit_KYC as "Resubmit KYC"
			        {
			            type = normal
			            from stage = "Action Required"
			            to stage = "Pending Verification"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Customer_Portal"}
			                )
			                transition criteria = ( KYC_Submitted_On is not null )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        input.KYC_Submitted_On = zoho.currenttime;
			                        audit_id = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.loginuserid
			                            Actor_Profile = "Customer_Portal"
			                            Action_Name = "Resubmit KYC"
			                            Module_Name = "Customers"
			                            Record_ID = input.ID.toString()
			                            After_Data = "Status=Pending Verification"
			                            Source = "Form Workflow"
			                            Severity = "Info"
			                        ];
			                    )
			                }
			            }
			        }
			        Query_KYC as "Query KYC"
			        {
			            type = normal
			            from stage = "Pending Verification"
			            to stage = "Action Required"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"KYC_Reviewer","Logistics_Administrator"}
			                )
			                tooltip message = "Query at least one document before moving the customer to Action Required"
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        queried_count = Customer_KYC_Documents[Customer == input.ID && Review_Status == "Query"].count();
			                        if(queried_count == 0)
			                        {
			                            input.Onboarding_Status = "Pending Verification";
			                            info "Query at least one KYC document with review remarks first.";
			                        }
			                        else
			                        {
			                            communication_id = insert into Communication_Log
			                            [
			                                Customer = input.ID
			                                Recipient = input.Email_ID
			                                Channel = "Portal Notification"
			                                Template_Code = "KYC_ACTION_REQUIRED"
			                                Subject = "KYC correction required"
			                                Message_Summary = "One or more KYC documents require correction. Review the document remarks and re-upload."
			                                Provider = "Other"
			                                Communication_Status = "Queued"
			                                Attempt_Count = 0
			                            ];
			                        }
			                    )
			                }
			            }
			        }
			        Approve_KYC as "Approve KYC"
			        {
			            type = normal
			            from stage = "Pending Verification"
			            to stage = "Active"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"KYC_Reviewer","Logistics_Administrator"}
			                )
			                confirmation before execution
			                (
			                    message = "Approve KYC and activate this business customer?"
			                    confirm button text = "Approve"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        unverified_count = Customer_KYC_Documents[Customer == input.ID && Required_For_Onboarding == true && Review_Status != "Verified"].count();
			                        if(unverified_count > 0)
			                        {
			                            input.Onboarding_Status = "Pending Verification";
			                            info "Approval is blocked until every required KYC document is verified.";
			                        }
			                        else
			                        {
			                            input.KYC_Verified_Date = zoho.currentdate;
			                            input.KYC_Expiry_Date = zoho.currentdate.addYear(1);
			                            input.Approved_Credit_Limit = input.Requested_Credit_Limit;
			                            input.Portal_Access_Status = "Active";
			                            audit_id = insert into Audit_Log
			                            [
			                                Event_Time = zoho.currenttime
			                                Actor_Email = zoho.loginuserid
			                                Actor_Profile = thisapp.permissions.loginUserProfile()
			                                Action_Name = "Approve Customer KYC"
			                                Module_Name = "Customers"
			                                Record_ID = input.ID.toString()
			                                After_Data = "Status=Active; KYC Expiry=" + input.KYC_Expiry_Date + "; Approved Credit=" + input.Approved_Credit_Limit
			                                Source = "Form Workflow"
			                                Severity = "Warning"
			                            ];
			                        }
			                    )
			                }
			            }
			        }
			        Request_Re_KYC as "Request Re-KYC"
			        {
			            type = common
			            from stage = "Active"
			            to stage = "KYC Pending"
			            common stages = {"KYC Expired"}
			            before
			            {
			                transition owner
			                (
			                    permissions = {"KYC_Reviewer","Logistics_Administrator"}
			                )
			                confirmation before execution
			                (
			                    message = "Request a fresh KYC cycle for this customer?"
			                    confirm button text = "Request Re-KYC"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        input.KYC_Submitted_On = null;
			                        communication_id = insert into Communication_Log
			                        [
			                            Customer = input.ID
			                            Recipient = input.Email_ID
			                            Channel = "Portal Notification"
			                            Template_Code = "REKYC_REQUESTED"
			                            Subject = "Re-KYC required"
			                            Message_Summary = "A new KYC verification cycle has been requested."
			                            Provider = "Other"
			                            Communication_Status = "Queued"
			                            Attempt_Count = 0
			                        ];
			                        audit_id = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.loginuserid
			                            Actor_Profile = thisapp.permissions.loginUserProfile()
			                            Action_Name = "Request Re-KYC"
			                            Module_Name = "Customers"
			                            Record_ID = input.ID.toString()
			                            Before_Data = "Status=Active or KYC Expired"
			                            After_Data = "Status=KYC Pending"
			                            Source = "Form Workflow"
			                            Severity = "Warning"
			                        ];
			                    )
			                }
			            }
			        }
			    }
			}
		}
	}

	functions
	{
		Deluge
		{
			map Calculate_Shipment_Quote(int customer_id, string pickup_pincode, string delivery_pincode, string transport_mode, float length_cm, float width_cm, float height_cm, float actual_weight_kg, string payment_type, float points_redeemed)
			{
			    quote = Map();
			    quote.put("valid",false);
			    quote.put("message","Complete customer, mode, pincode, dimensions, and weight to calculate the quote.");
			    quote.put("volumetric_weight",0);
			    quote.put("billable_weight",0);
			    quote.put("rated_distance",0);
			    quote.put("rate_card_id",0);
			    quote.put("rate_slab_id",0);
			    quote.put("base_rate",0);
			    quote.put("fuel_surcharge",0);
			    quote.put("cod_fee",0);
			    quote.put("gst_amount",0);
			    quote.put("gross_amount",0);
			    quote.put("redemption_amount",0);
			    quote.put("total_payable",0);
			    if(customer_id != null && ifnull(pickup_pincode,"").matches("[0-9]{6}") && ifnull(delivery_pincode,"").matches("[0-9]{6}") && transport_mode != null && ifnull(length_cm,0) > 0 && ifnull(width_cm,0) > 0 && ifnull(height_cm,0) > 0 && ifnull(actual_weight_kg,0) > 0)
			    {
			        customer_record = Customers[ID == customer_id];
			        pickup_map = Hub_Pincode_Mapping[Pincode == pickup_pincode && Active == true && Serviceability != "Non-Serviceable"];
			        delivery_map = Hub_Pincode_Mapping[Pincode == delivery_pincode && Active == true && Serviceability != "Non-Serviceable"];
			        if(customer_record.count(ID) > 0 && pickup_map.count(ID) > 0 && delivery_map.count(ID) > 0)
			        {
			            rate_card = Rate_Cards[ID == customer_record.Assigned_Rate_Card && Status == "Published" && Effective_From <= zoho.currentdate && (Effective_To is null || Effective_To >= zoho.currentdate) && (Transport_Mode == transport_mode || Transport_Mode == "Both")] sort by Effective_From desc range from 0 to 0;
			            if(rate_card.count(ID) == 0)
			            {
			                rate_card = Rate_Cards[Customer_Type == customer_record.Customer_Type && Status == "Published" && Effective_From <= zoho.currentdate && (Effective_To is null || Effective_To >= zoho.currentdate) && (Transport_Mode == transport_mode || Transport_Mode == "Both")] sort by Effective_From desc range from 0 to 0;
			            }
			            if(rate_card.count(ID) == 0)
			            {
			                rate_card = Rate_Cards[Customer_Type == "All" && Status == "Published" && Effective_From <= zoho.currentdate && (Effective_To is null || Effective_To >= zoho.currentdate) && (Transport_Mode == transport_mode || Transport_Mode == "Both")] sort by Effective_From desc range from 0 to 0;
			            }
			            if(rate_card.count(ID) > 0)
			            {
			                divisor = ifnull(rate_card.Volumetric_Divisor,0);
			                if(divisor <= 0)
			                {
			                    config_record = App_Configuration[Active == true];
			                    divisor = ifnull(config_record.Default_Volumetric_Divisor,5000);
			                }
			                volumetric_weight = (length_cm * width_cm * height_cm / divisor).round(3);
			                billable_weight = actual_weight_kg;
			                if(volumetric_weight > actual_weight_kg)
			                {
			                    billable_weight = volumetric_weight;
			                }
			                origin_hub = Hubs[ID == pickup_map.Primary_Collection_Center];
			                destination_hub = Hubs[ID == delivery_map.Primary_Collection_Center];
			                route_record = Transport_Routes[Origin_Sorting_Hub == origin_hub.Parent_Sorting_Hub && Destination_Sorting_Hub == destination_hub.Parent_Sorting_Hub && Transport_Mode == transport_mode && Active == true] sort by Distance_Km range from 0 to 0;
			                rated_distance = ifnull(pickup_map.Approx_Distance_From_Primary_Km,0) + ifnull(delivery_map.Approx_Distance_From_Primary_Km,0);
			                if(route_record.count(ID) > 0)
			                {
			                    rated_distance = rated_distance + ifnull(route_record.Distance_Km,0);
			                }
			                service_zone = delivery_map.Service_Zone;
			                slab_record = Rate_Slabs[Rate_Card == rate_card.ID && Active == true && Service_Zone == service_zone && Minimum_Weight_Kg <= billable_weight && Maximum_Weight_Kg >= billable_weight && Minimum_Distance_Km <= rated_distance && Maximum_Distance_Km >= rated_distance] sort by Minimum_Weight_Kg, Minimum_Distance_Km range from 0 to 0;
			                if(slab_record.count(ID) == 0)
			                {
			                    slab_record = Rate_Slabs[Rate_Card == rate_card.ID && Active == true && (Service_Zone is null || Service_Zone == "") && Minimum_Weight_Kg <= billable_weight && Maximum_Weight_Kg >= billable_weight && Minimum_Distance_Km <= rated_distance && Maximum_Distance_Km >= rated_distance] sort by Minimum_Weight_Kg, Minimum_Distance_Km range from 0 to 0;
			                }
			                if(slab_record.count(ID) > 0)
			                {
			                    additional_weight = billable_weight - slab_record.Minimum_Weight_Kg;
			                    if(additional_weight < 0)
			                    {
			                        additional_weight = 0;
			                    }
			                    base_rate = (slab_record.Base_Rate + (additional_weight.ceil() * slab_record.Additional_Kg_Rate)).round(2);
			                    discount_amount = (base_rate * ifnull(rate_card.Contract_Discount_Percent,0) / 100).round(2);
			                    discounted_base = base_rate - discount_amount;
			                    fuel_surcharge = (discounted_base * ifnull(rate_card.Fuel_Surcharge_Percent,0) / 100).round(2);
			                    cod_fee = 0;
			                    if(payment_type == "COD")
			                    {
			                        cod_fee = ifnull(rate_card.COD_Handling_Fee,0);
			                    }
			                    taxable_amount = discounted_base + fuel_surcharge + cod_fee;
			                    gst_amount = (taxable_amount * ifnull(rate_card.GST_Percent,0) / 100).round(2);
			                    gross_amount = (taxable_amount + gst_amount).round(2);
			                    config_record = App_Configuration[Active == true];
			                    redemption_value = ifnull(config_record.Loyalty_Redemption_Value_Per_Point,1);
			                    redemption_amount = (ifnull(points_redeemed,0) * redemption_value).round(2);
			                    if(redemption_amount > gross_amount)
			                    {
			                        redemption_amount = gross_amount;
			                    }
			                    total_payable = (gross_amount - redemption_amount).round(2);
			                    quote.put("valid",true);
			                    quote.put("message","Quote calculated successfully.");
			                    quote.put("volumetric_weight",volumetric_weight);
			                    quote.put("billable_weight",billable_weight);
			                    quote.put("rated_distance",rated_distance.round(2));
			                    quote.put("rate_card_id",rate_card.ID);
			                    quote.put("rate_slab_id",slab_record.ID);
			                    quote.put("base_rate",discounted_base.round(2));
			                    quote.put("fuel_surcharge",fuel_surcharge);
			                    quote.put("cod_fee",cod_fee);
			                    quote.put("gst_amount",gst_amount);
			                    quote.put("gross_amount",gross_amount);
			                    quote.put("redemption_amount",redemption_amount);
			                    quote.put("total_payable",total_payable);
			                }
			                else
			                {
			                    quote.put("message","No active rate slab matches the billable weight, service zone, and rated distance.");
			                }
			            }
			            else
			            {
			                quote.put("message","No published rate card supports this customer and transport mode.");
			            }
			        }
			        else
			        {
			            quote.put("message","Customer or pincode serviceability could not be resolved.");
			        }
			    }
			    return quote;
			}

			float Recalculate_Customer_Outstanding(int customer_id)
			{
			    recalculated_outstanding = 0.0;
			    customer_record = Customers[ID == customer_id];
			    if(customer_record.count(ID) > 0)
			    {
			        debit_total = ifnull(Account_Ledger[Customer == customer_id && Transaction_Type == "Debit"].sum(Amount),0);
			        refund_total = ifnull(Account_Ledger[Customer == customer_id && Transaction_Type == "Refund"].sum(Amount),0);
			        adjustment_total = ifnull(Account_Ledger[Customer == customer_id && Transaction_Type == "Adjustment"].sum(Amount),0);
			        credit_total = ifnull(Account_Ledger[Customer == customer_id && Transaction_Type == "Credit"].sum(Amount),0);
			        payment_total = ifnull(Account_Ledger[Customer == customer_id && Transaction_Type == "Payment"].sum(Amount),0);
			        rebate_total = ifnull(Account_Ledger[Customer == customer_id && Transaction_Type == "Rebate"].sum(Amount),0);
			        recalculated_outstanding = (debit_total + refund_total + adjustment_total - credit_total - payment_total - rebate_total).round(2);
			        if(recalculated_outstanding < 0)
			        {
			            recalculated_outstanding = 0;
			        }
			        customer_record.Outstanding_Balance = recalculated_outstanding;
			    }
			    return recalculated_outstanding;
			}
		}
	}

