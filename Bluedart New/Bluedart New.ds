		    must have Credit_Rebate
		    (
		        type = INR
		        displayname = "Credit Rebate"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        initial value = 0
		        row = 2
		        column = 2
		        width = medium
