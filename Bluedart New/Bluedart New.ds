			Cancel_Manifest as "Cancel Manifest"
			{
			    type = functions
			    form = Manifests
			    execution type = for each record
			    description = "Cancels only an unused draft manifest with no loaded custody records"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = "POC Process User";
			                logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                deputation_active = logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate);
			                effective_hub = logged_user.Home_Hub;
			                if(deputation_active == true)
			                {
			                    effective_hub = logged_user.Deputed_Hub;
			                }
			                authorised = logged_user.count(ID) > 0 && effective_hub == input.Origin_Hub;
			                loaded_bags = Manifest_Bags[Manifest == input.ID && Load_Status == "Loaded"].count(ID);
			                if(authorised == false)
			                {
			                    info "Only an active operations user at the origin hub can cancel this manifest.";
			                }
			                else if(input.Manifest_Status != "Draft" || loaded_bags > 0)
			                {
			                    info "Only an unused draft with no loaded bags can be cancelled.";
			                }
			                else
			                {
			                    input.Manifest_Status = "Cancelled";
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuserid
			                        Actor_Profile = current_profile
			                        Action_Name = "Cancel Manifest"
			                        Module_Name = "Manifests"
			                        Record_ID = input.ID.toString()
			                        Before_Data = "Status=Draft"
			                        After_Data = "Status=Cancelled"
			                        Source = "Report Action"
			                        Severity = "High"
			                    ];
			                }
			            )
			        }
			    }
			}

			Close_Manifest as "Close Manifest"
			{
			    type = functions
			    form = Manifests
			    execution type = for each record
			    description = "Freezes a bounded loaded-bag set and validates trip capacity before dispatch"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = "POC Process User";
			                logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                deputation_active = logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate);
			                effective_hub = logged_user.Home_Hub;
			                if(deputation_active == true)
			                {
			                    effective_hub = logged_user.Deputed_Hub;
			                }
			                authorised = logged_user.count(ID) > 0 && effective_hub == input.Origin_Hub;
			                if(authorised == false)
			                {
			                    info "Only an active operations user at the origin hub can close this manifest.";
			                }
			                else if(input.Manifest_Status != "Draft")
			                {
			                    info "Only a draft manifest can be closed.";
			                }
			                else
			                {
			                    bag_count = 0;
			                    shipment_count = 0;
			                    total_weight = 0.0;
			                    invalid_bags = 0;
			                    for each manifest_bag in Manifest_Bags[Manifest == input.ID]
			                    {
			                        bag_count = bag_count + 1;
			                        bag_record = Logistics_Bags[ID == manifest_bag.Bag];
			                        if(manifest_bag.Load_Status != "Loaded" || bag_record.Bag_Status != "Sealed" || bag_record.Origin_Hub != input.Origin_Hub || bag_record.Destination_Hub != input.Destination_Hub)
			                        {
			                            invalid_bags = invalid_bags + 1;
			                        }
			                        expected_bag_type = if(input.Manifest_Type == "Linehaul","Master",input.Manifest_Type);
			                        if(bag_record.Bag_Type != expected_bag_type)
			                        {
			                            invalid_bags = invalid_bags + 1;
			                        }
			                        shipment_count = shipment_count + ifnull(bag_record.Total_Shipments,0);
			                        total_weight = total_weight + ifnull(bag_record.Total_Weight_Kg,0);
			                    }
			                    vehicle_record = Vehicles[ID == input.Vehicle && Active == true && Owning_Hub == input.Origin_Hub];
			                    if(bag_count == 0)
			                    {
			                        info "Load at least one sealed bag before closing the manifest.";
			                    }
			                    else if(bag_count > 100 || shipment_count > 1000)
			                    {
			                        info "This trip exceeds the safe processing batch of 100 bags or 1,000 shipments. Split it into additional manifests.";
			                    }
			                    else if(invalid_bags > 0)
			                    {
			                        info "Every manifest bag must be loaded, sealed, route-compatible, and match the manifest type.";
			                    }
			                    else if(vehicle_record.count(ID) == 0 || vehicle_record.Status != "Available" || total_weight > vehicle_record.Capacity_Kg)
			                    {
			                        info "The selected vehicle is unavailable or lacks capacity for the loaded bags.";
			                    }
			                    else
			                    {
			                        input.Total_Bags = bag_count;
			                        input.Total_Shipments = shipment_count;
			                        input.Total_Weight_Kg = total_weight;
			                        input.Manifest_Status = "Closed";
			                        audit_id = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.loginuserid
			                            Actor_Profile = current_profile
			                            Action_Name = "Close Manifest"
			                            Module_Name = "Manifests"
			                            Record_ID = input.ID.toString()
			                            Before_Data = "Status=Draft"
			                            After_Data = "Status=Closed; Bags=" + bag_count + "; Shipments=" + shipment_count + "; Weight=" + total_weight
			                            Source = "Report Action"
			                            Severity = "Critical"
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

			Dispatch_Manifest as "Dispatch Manifest"
			{
			    type = functions
			    form = Manifests
			    execution type = for each record
			    description = "Dispatches a closed bounded manifest and records bag and shipment custody milestones"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = "POC Process User";
			                logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                deputation_active = logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate);
			                effective_hub = logged_user.Home_Hub;
			                if(deputation_active == true)
			                {
			                    effective_hub = logged_user.Deputed_Hub;
			                }
			                authorised = logged_user.count(ID) > 0 && effective_hub == input.Origin_Hub;
			                if(authorised == false)
			                {
			                    info "Only an active operations user at the origin hub can dispatch this manifest.";
			                }
			                else if(input.Manifest_Status != "Closed" || ifnull(input.Vehicle_Seal_Code,"").trim() == "" || input.Departure_Time == null || input.Expected_Arrival_Time == null)
			                {
			                    info "A closed manifest requires departure, expected arrival, and a vehicle seal before dispatch.";
			                }
			                else if(input.Total_Bags > 100 || input.Total_Shipments > 1000)
			                {
			                    info "The manifest exceeds the safe dispatch batch and must be split.";
			                }
			                else
			                {
			                    vehicle_record = Vehicles[ID == input.Vehicle && Active == true && Status == "Available"];
			                    if(vehicle_record.count(ID) == 0)
			                    {
			                        info "The assigned vehicle is no longer available.";
			                    }
			                    else
			                    {
			                        milestone = "In Transit";
			                        if(input.Manifest_Type == "Feeder")
			                        {
			                            milestone = "Bagged & Dispatched to Origin Hub";
			                        }
			                        else if(input.Manifest_Type == "Return")
			                        {
			                            milestone = "Return to Origin";
			                        }
			                        validated_bags = 0;
			                        validated_shipments = 0;
			                        invalid_bags = 0;
			                        for each manifest_bag in Manifest_Bags[Manifest == input.ID && Load_Status == "Loaded"]
			                        {
			                            bag_record = Logistics_Bags[ID == manifest_bag.Bag];
			                            if(bag_record.Bag_Status != "Sealed" || bag_record.Origin_Hub != input.Origin_Hub || bag_record.Destination_Hub != input.Destination_Hub)
			                            {
			                                invalid_bags = invalid_bags + 1;
			                            }
			                            validated_bags = validated_bags + 1;
			                            validated_shipments = validated_shipments + Bag_Shipments[Bag == bag_record.ID && Scan_Status == "Loaded"].count(ID);
			                        }
			                        if(invalid_bags > 0 || validated_bags != input.Total_Bags || validated_shipments != input.Total_Shipments)
			                        {
			                            info "Dispatch stopped because sealed bag or shipment custody no longer matches the closed manifest. Reopen the investigation before retrying.";
			                        }
			                        else
			                        {
			                            processed_bags = 0;
			                            processed_shipments = 0;
			                            for each manifest_bag in Manifest_Bags[Manifest == input.ID && Load_Status == "Loaded"]
			                            {
			                                bag_record = Logistics_Bags[ID == manifest_bag.Bag];
			                                bag_record.Bag_Status = "Dispatched";
			                                bag_record.Dispatched_At = zoho.currenttime;
			                                processed_bags = processed_bags + 1;
			                                for each bag_item in Bag_Shipments[Bag == bag_record.ID && Scan_Status == "Loaded"]
			                                {
			                                    shipment_record = Shipment_Requests[ID == bag_item.Shipment];
			                                    shipment_record.Shipment_Status = milestone;
			                                    shipment_record.Current_Hub = input.Origin_Hub;
			                                    tracking_id = insert into Shipment_Tracking_Events
			                                    [
			                                        Shipment = shipment_record.ID
			                                        Event_Time = zoho.currenttime
			                                        Event_Status = milestone
			                                        Hub = input.Origin_Hub
			                                        Manifest = input.ID
			                                        Bag = bag_record.ID
			                                        Event_Description = input.Manifest_Type + " manifest dispatched under vehicle seal " + input.Vehicle_Seal_Code + "."
			                                        Source = "Manifest"
			                                        Customer_Visible = true
			                                        Created_By_Email = zoho.loginuserid
			                                    ];
			                                    processed_shipments = processed_shipments + 1;
			                                }
			                            }
			                            input.Manifest_Status = "In Transit";
			                            vehicle_record.Status = "Assigned";
			                            audit_id = insert into Audit_Log
			                            [
			                                Event_Time = zoho.currenttime
			                                Actor_Email = zoho.loginuserid
			                                Actor_Profile = current_profile
			                                Action_Name = "Dispatch Manifest"
			                                Module_Name = "Manifests"
			                                Record_ID = input.ID.toString()
			                                Before_Data = "Status=Closed; Seal=" + input.Vehicle_Seal_Code
			                                After_Data = "Status=In Transit; Bags=" + processed_bags + "; Shipments=" + processed_shipments + "; Milestone=" + milestone
			                                Source = "Report Action"
			                                Severity = "Critical"
			                            ];
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Receive_Manifest as "Receive Manifest"
			{
			    type = functions
			    form = Manifests
			    execution type = for each record
			    description = "Records destination arrival, verifies expected bag custody, and opens bag-level reconciliation"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = "POC Process User";
			                logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                deputation_active = logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate);
			                effective_hub = logged_user.Home_Hub;
			                if(deputation_active == true)
			                {
			                    effective_hub = logged_user.Deputed_Hub;
			                }
			                authorised = logged_user.count(ID) > 0 && effective_hub == input.Destination_Hub;
			                if(authorised == false)
			                {
			                    info "Only an active operations user at the destination hub can receive this manifest.";
			                }
			                else if(input.Manifest_Status != "In Transit" || ifnull(input.Vehicle_Seal_Code,"").trim() == "")
			                {
			                    info "Only an in-transit manifest with a recorded vehicle seal can be received.";
			                }
			                else
			                {
			                    expected_bags = Manifest_Bags[Manifest == input.ID && Load_Status == "Loaded"].count(ID);
			                    dispatched_bags = 0;
			                    bag_exceptions = 0;
			                    for each manifest_bag in Manifest_Bags[Manifest == input.ID && Load_Status == "Loaded"]
			                    {
			                        bag_record = Logistics_Bags[ID == manifest_bag.Bag];
			                        if(bag_record.Bag_Status == "Dispatched")
			                        {
			                            bag_record.Bag_Status = "Received";
			                            bag_record.Received_At = zoho.currenttime;
			                            dispatched_bags = dispatched_bags + 1;
			                        }
			                        else
			                        {
			                            bag_exceptions = bag_exceptions + 1;
			                        }
			                        for each bag_item in Bag_Shipments[Bag == bag_record.ID && Scan_Status == "Loaded"]
			                        {
			                            shipment_record = Shipment_Requests[ID == bag_item.Shipment];
			                            tracking_id = insert into Shipment_Tracking_Events
			                            [
			                                Shipment = shipment_record.ID
			                                Event_Time = zoho.currenttime
			                                Event_Status = "Information"
			                                Hub = input.Destination_Hub
			                                Manifest = input.ID
			                                Bag = bag_record.ID
			                                Event_Description = "Manifest arrived under recorded vehicle seal; bag and item reconciliation is pending."
			                                Source = "Manifest"
			                                Customer_Visible = false
			                                Created_By_Email = zoho.loginuserid
			                            ];
			                        }
			                    }
			                    input.Actual_Arrival_Time = zoho.currenttime;
			                    input.Manifest_Status = if(bag_exceptions > 0 || dispatched_bags != expected_bags,"Exception","Arrived");
			                    vehicle_record = Vehicles[ID == input.Vehicle];
			                    vehicle_record.Status = "Available";
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuserid
			                        Actor_Profile = current_profile
			                        Action_Name = "Receive Manifest"
			                        Module_Name = "Manifests"
			                        Record_ID = input.ID.toString()
			                        Before_Data = "Status=In Transit; Vehicle Seal=" + input.Vehicle_Seal_Code
			                        After_Data = "Status=" + input.Manifest_Status + "; Received Bags=" + dispatched_bags + "; Expected Bags=" + expected_bags + "; Reconciliation=Pending"
			                        Source = "Report Action"
			                        Severity = "Critical"
			                    ];
			                }
			            )
			        }
			    }
			}

			Reconcile_Manifest as "Reconcile Manifest"
			{
			    type = functions
			    form = Manifests
			    execution type = for each record
			    description = "Finalises the manifest only after every expected bag and shipment has a terminal reconciliation result"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = "POC Process User";
			                logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                deputation_active = logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate);
			                effective_hub = logged_user.Home_Hub;
			                if(deputation_active == true)
			                {
			                    effective_hub = logged_user.Deputed_Hub;
			                }
			                authorised = logged_user.count(ID) > 0 && effective_hub == input.Destination_Hub;
			                if(authorised == false)
			                {
			                    info "Only an active operations user at the destination hub can reconcile this manifest.";
			                }
			                else if(input.Manifest_Status != "Arrived" && input.Manifest_Status != "Exception")
			                {
			                    info "Only an arrived or quarantined manifest can be reconciled.";
			                }
			                else
			                {
			                    total_manifest_bags = Manifest_Bags[Manifest == input.ID].count(ID);
			                    unresolved_bags = Manifest_Bags[Manifest == input.ID && (Load_Status == "Expected" || Load_Status == "Loaded")].count(ID);
			                    exception_bags = Manifest_Bags[Manifest == input.ID && (Load_Status == "Missing" || Load_Status == "Damaged" || Load_Status == "Short")].count(ID);
			                    unresolved_shipments = 0;
			                    for each received_link in Manifest_Bags[Manifest == input.ID && Load_Status == "Received"]
			                    {
			                        unresolved_shipments = unresolved_shipments + Bag_Shipments[Bag == received_link.Bag && Scan_Status == "Loaded"].count(ID);
			                    }
			                    if(total_manifest_bags == 0 || unresolved_bags > 0 || unresolved_shipments > 0)
			                    {
			                        info "Reconciliation is incomplete. Resolve every expected bag and each loaded shipment first.";
			                    }
			                    else
			                    {
			                        prior_status = input.Manifest_Status;
			                        quarantined_bags = 0;
			                        for each manifest_bag in Manifest_Bags[Manifest == input.ID]
			                        {
			                            bag_record = Logistics_Bags[ID == manifest_bag.Bag];
			                            if(bag_record.Bag_Status == "Exception")
			                            {
			                                quarantined_bags = quarantined_bags + 1;
			                            }
			                        }
			                        input.Manifest_Status = if(exception_bags > 0 || quarantined_bags > 0,"Exception","Reconciled");
			                        audit_id = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.loginuserid
			                            Actor_Profile = current_profile
			                            Action_Name = "Reconcile Manifest"
			                            Module_Name = "Manifests"
			                            Record_ID = input.ID.toString()
			                            Before_Data = "Status=" + prior_status
			                            After_Data = "Status=" + input.Manifest_Status + "; Exception Bags=" + exception_bags + "; Quarantined Bags=" + quarantined_bags
			                            Source = "Report Action"
			                            Severity = "Critical"
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

			Acknowledge_NDR as "Acknowledge NDR"
			{
			    type = functions
			    form = NDR_Instructions
			    execution type = for each record
			    description = "Acknowledges a new recipient instruction for destination-hub processing"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = "POC Process User";
			                shipment_record = Shipment_Requests[ID == input.Shipment];
			                logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                effective_hub = if(logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate),logged_user.Deputed_Hub,logged_user.Home_Hub);
			                authorised = logged_user.count(ID) > 0 && effective_hub == shipment_record.Destination_Hub;
			                if(authorised == false)
			                {
			                    info "You are not authorised to acknowledge this NDR instruction.";
			                }
			                else if(input.NDR_Status != "New")
			                {
			                    info "Only a new recipient instruction can be acknowledged.";
			                }
			                else
			                {
			                    input.NDR_Status = "Acknowledged";
			                    input.Supervisor_Notes = ifnull(input.Supervisor_Notes,"") + "\nAcknowledged by " + zoho.loginuserid + " on " + zoho.currenttime + ".";
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuserid
			                        Actor_Profile = current_profile
			                        Action_Name = "Acknowledge NDR"
			                        Module_Name = "NDR Instructions"
			                        Record_ID = input.ID.toString()
			                        Before_Data = "Status=New"
			                        After_Data = "Status=Acknowledged"
			                        Source = "Report Action"
			                        Severity = "Info"
			                    ];
			                }
			            )
			        }
			    }
			}

			Add_To_Next_DRS as "Add to Next DRS"
			{
			    type = functions
			    form = NDR_Instructions
			    execution type = for each record
			    description = "Returns an acknowledged NDR shipment to destination-hub delivery planning"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = "POC Process User";
			                shipment_record = Shipment_Requests[ID == input.Shipment];
			                run_item = Delivery_Run_Sheet_Items[ID == input.Delivery_Run_Item];
			                logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                effective_hub = if(logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate),logged_user.Deputed_Hub,logged_user.Home_Hub);
			                authorised = logged_user.count(ID) > 0 && effective_hub == shipment_record.Destination_Hub;
			                active_assignment = Delivery_Run_Sheet_Items[Shipment == shipment_record.ID && ID != run_item.ID && (Delivery_Status == "Assigned" || Delivery_Status == "Out For Delivery")].count(ID);
			                if(authorised == false)
			                {
			                    info "You are not authorised to return this shipment to delivery planning.";
			                }
			                else if(input.NDR_Status != "Acknowledged" || input.Recipient_Instruction == "Hold at Local Office")
			                {
			                    info "Only an acknowledged redelivery instruction can return to DRS planning.";
			                }
			                else if(shipment_record.Shipment_Status != "Delivery Failed - NDR" || shipment_record.Current_Hub != shipment_record.Destination_Hub || active_assignment > 0)
			                {
			                    info "The shipment is not eligible for destination-hub redelivery planning.";
			                }
			                else
			                {
			                    if(input.Recipient_Instruction == "Reschedule Delivery")
			                    {
			                        shipment_record.Expected_Delivery_Date = input.Reschedule_Date;
			                    }
			                    else if(input.Recipient_Instruction == "Update Delivery Address")
			                    {
			                        shipment_record.Delivery_Address.address_line_1 = input.Updated_Delivery_Address.address_line_1;
			                        shipment_record.Delivery_Address.address_line_2 = input.Updated_Delivery_Address.address_line_2;
			                        shipment_record.Delivery_Address.district_city = input.Updated_Delivery_Address.district_city;
			                        shipment_record.Delivery_Address.state_province = input.Updated_Delivery_Address.state_province;
			                        shipment_record.Delivery_Address.postal_Code = input.Updated_Delivery_Address.postal_Code;
			                        shipment_record.Delivery_Address.country = input.Updated_Delivery_Address.country;
			                        shipment_record.Delivery_Pincode = input.Updated_Delivery_Address.postal_Code;
			                    }
			                    shipment_record.Shipment_Status = "At Delivery Hub";
			                    input.NDR_Status = "Added to Next DRS";
			                    input.Supervisor_Notes = ifnull(input.Supervisor_Notes,"") + "\nReturned to DRS planning by " + zoho.loginuserid + " on " + zoho.currenttime + ".";
			                    tracking_id = insert into Shipment_Tracking_Events
			                    [
			                        Shipment = shipment_record.ID
			                        Event_Time = zoho.currenttime
			                        Event_Status = "At Delivery Hub"
			                        Hub = shipment_record.Destination_Hub
			                        Event_Description = "Recipient instruction accepted; shipment returned to destination-hub delivery planning."
			                        Source = "NDR"
			                        Customer_Visible = true
			                        Created_By_Email = zoho.loginuserid
			                    ];
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuserid
			                        Actor_Profile = current_profile
			                        Action_Name = "Add NDR Shipment to Next DRS"
			                        Module_Name = "NDR Instructions"
			                        Record_ID = input.ID.toString()
			                        Before_Data = "NDR=Acknowledged; Shipment=Delivery Failed - NDR"
			                        After_Data = "NDR=Added to Next DRS; Shipment=At Delivery Hub"
			                        Source = "Report Action"
			                        Severity = "Critical"
			                    ];
			                }
			            )
			        }
			    }
			}

			Initiate_RTO as "Initiate RTO"
			{
			    type = functions
			    form = NDR_Instructions
			    execution type = for each record
			    description = "Applies NDR attempt policy and reverses routing for return-to-origin processing"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = "POC Process User";
			                shipment_record = Shipment_Requests[ID == input.Shipment];
			                run_item = Delivery_Run_Sheet_Items[ID == input.Delivery_Run_Item];
			                config_record = App_Configuration[Active == true] range from 0 to 0;
			                maximum_attempts = if(config_record.count(ID) > 0,config_record.Maximum_NDR_Attempts,3);
			                logged_user = Operations_Users[Work_Email == zoho.loginuserid && Active == true];
			                effective_hub = if(logged_user.count(ID) > 0 && logged_user.Deputed_Hub != null && (logged_user.Deputation_Start_Date == null || logged_user.Deputation_Start_Date <= zoho.currentdate) && (logged_user.Deputation_End_Date == null || logged_user.Deputation_End_Date >= zoho.currentdate),logged_user.Deputed_Hub,logged_user.Home_Hub);
			                authorised = logged_user.count(ID) > 0 && effective_hub == shipment_record.Destination_Hub;
			                latest_failure = Delivery_Run_Sheet_Items[ID == input.Delivery_Run_Item];
			                refusal_or_limit = latest_failure.NDR_Reason == "Refused COD" || ifnull(shipment_record.NDR_Attempt_Count,0) >= maximum_attempts;
			                if(authorised == false)
			                {
			                    info "You are not authorised to initiate RTO for this shipment.";
			                }
			                else if(input.NDR_Status == "Awaiting Instruction" || input.NDR_Status == "RTO" || input.NDR_Status == "Added to Next DRS")
			                {
			                    info "This NDR record is not eligible for manual RTO initiation.";
			                }
			                else if(refusal_or_limit == false)
			                {
			                    info "RTO requires COD refusal or the configured maximum number of delivery attempts.";
			                }
			                else
			                {
			                    previous_ndr_status = input.NDR_Status;
			                    original_collection_center = shipment_record.Collection_Center;
			                    original_origin_sorting_hub = shipment_record.Origin_Sorting_Hub;
			                    original_destination_sorting_hub = shipment_record.Destination_Sorting_Hub;
			                    original_destination_hub = shipment_record.Destination_Hub;
			                    shipment_record.Collection_Center = original_destination_hub;
			                    shipment_record.Origin_Sorting_Hub = original_destination_sorting_hub;
			                    shipment_record.Destination_Sorting_Hub = original_origin_sorting_hub;
			                    shipment_record.Destination_Hub = original_collection_center;
			                    shipment_record.Current_Hub = original_destination_hub;
			                    shipment_record.Shipment_Status = "Return to Origin";
			                    input.NDR_Status = "RTO";
			                    input.Supervisor_Notes = ifnull(input.Supervisor_Notes,"") + "\nRTO initiated by " + zoho.loginuserid + " on " + zoho.currenttime + ".";
			                    if(run_item.count(ID) > 0)
			                    {
			                        run_item.Delivery_Status = "RTO";
			                    }
			                    tracking_id = insert into Shipment_Tracking_Events
			                    [
			                        Shipment = shipment_record.ID
			                        Event_Time = zoho.currenttime
			                        Event_Status = "Return to Origin"
			                        Hub = original_destination_hub
			                        Event_Description = "Return-to-origin routing initiated under NDR attempt/refusal policy."
			                        Source = "RTO"
			                        Customer_Visible = true
			                        Created_By_Email = zoho.loginuserid
			                    ];
			                    customer_record = Customers[ID == shipment_record.Customer];
			                    sender_email = if(ifnull(shipment_record.Sender_Email,"").trim() != "",shipment_record.Sender_Email,customer_record.Email_ID);
			                    sendmail
			                    [
			                        from: zoho.adminuserid
			                        to: sender_email
			                        subject: "Return to origin initiated: AWB " + shipment_record.AWB_Number
			                        message: "The shipment entered return-to-origin processing after delivery attempt policy was met."
			                    ]
			                    communication_id = insert into Communication_Log
			                    [
			                        Customer = customer_record.ID
			                        Shipment = shipment_record.ID
			                        Recipient = sender_email
			                        Channel = "Email"
			                        Template_Code = "SHIPMENT_RTO_INITIATED"
			                        Subject = "Return to origin initiated: AWB " + shipment_record.AWB_Number
			                        Message_Summary = "Sender notified after RTO routing was initiated."
			                        Provider = "Zoho Mail"
			                        Communication_Status = "Sent"
			                        Attempt_Count = 1
			                        Last_Attempt_At = zoho.currenttime
			                    ];
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.loginuserid
			                        Actor_Profile = current_profile
			                        Action_Name = "Initiate RTO"
			                        Module_Name = "NDR Instructions"
			                        Before_Data = "Status=" + previous_ndr_status + "; Destination Hub=" + original_destination_hub
			                        Before_Data = "Status=" + input.NDR_Status + "; Destination Hub=" + original_destination_hub
			                        After_Data = "Status=RTO; Shipment=Return to Origin; Return Destination=" + original_collection_center
			                        Source = "Report Action"
			                        Severity = "Critical"
			                    ];
			                }
			            )
			        }
			    }
			}

			Confirm_Verified_Refund as "Confirm Verified Refund"
			{
			    type = functions
			    form = Payment_Transactions
			    execution type = for each record
			    description = "Lets authorised finance users record a refund only after verifying completion with the payment provider"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = "POC Process User";
			                if(input.Payment_Status != "Success")
			                {
			                    info "Only a successful payment can be confirmed as refunded.";
			                }
			                else
			                {
			                    shipment_record = Shipment_Requests[ID == input.Shipment];
			                    customer_record = Customers[ID == input.Customer];
			                    invoice_record = Invoices[ID == input.Invoice];
			                    if(shipment_record.count(ID) == 0 || customer_record.count(ID) == 0 || invoice_record.count(ID) == 0)
			                    {
			                        info "Refund reconciliation was blocked because the customer, shipment, or invoice reference is missing.";
			                    }
			                    else if(shipment_record.Shipment_Status != "Cancelled" && shipment_record.Shipment_Status != "RTO Completed")
			                    {
			                        info "Refund confirmation is allowed only for a cancelled or completed return-to-origin shipment.";
			                    }
			                    else if(ifnull(input.Gateway_Payment_ID,"").trim() == "")
			                    {
			                        info "The verified payment reference is missing, so this refund cannot be reconciled safely.";
			                    }
			                    else
			                    {
			                        refund_reference = "REFUND-" + input.Gateway_Payment_ID + "-" + input.ID;
			                        existing_refund = Account_Ledger[Payment_Reference == refund_reference && Transaction_Type == "Refund"];
			                        if(existing_refund.count(ID) == 0)
			                        {
			                            refund_ledger_id = insert into Account_Ledger
			                            [
			                                Customer = customer_record.ID
			                                Shipment = shipment_record.ID
			                                Invoice = invoice_record.ID
			                                Transaction_Type = "Refund"
			                                Amount = input.Amount
			                                Transaction_Date = zoho.currenttime
			                                Ledger_Status = "Settled"
			                                Ageing_Bucket = "Not Applicable"
			                                Payment_Reference = refund_reference
			                                Notes = "Provider refund completion manually verified by " + zoho.loginuserid + " against payment reference " + input.Gateway_Payment_ID + "."
			                                Posted_By_Email = zoho.loginuserid
			                                Customer_Login_Email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID)
			                            ];
			                        }
			                        input.Payment_Status = "Refunded";
			                        input.Completed_At = zoho.currenttime;
			                        input.Gateway_Response_Summary = ifnull(input.Gateway_Response_Summary,"") + " | Provider refund manually verified by authorised finance user. Refund reference: " + refund_reference + ".";
			                        input.Failure_Reason = "";
			                        verified_payment_total = ifnull(Account_Ledger[Invoice == invoice_record.ID && Transaction_Type == "Payment"].sum(Amount),0);
			                        verified_refund_total = ifnull(Account_Ledger[Invoice == invoice_record.ID && Transaction_Type == "Refund"].sum(Amount),0);
			                        if(verified_refund_total + 0.01 >= verified_payment_total)
			                        {
			                            shipment_record.Payment_Status = "Refunded";
			                        }
			                        thisapp.Recalculate_Customer_Outstanding(customer_record.ID);
			                        recipient_email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID);
			                        refund_summary = "Refund of INR " + input.Amount + " confirmed for payment " + input.Gateway_Payment_ID + "; reference " + refund_reference + ".";
			                        if(Communication_Log[Customer == customer_record.ID && Template_Code == "PAYMENT_REFUNDED" && Message_Summary == refund_summary].count(ID) == 0)
			                        {
			                            communication_id = insert into Communication_Log
			                            [
			                                Customer = customer_record.ID
			                                Shipment = shipment_record.ID
			                                Recipient = recipient_email
			                                Channel = "Email"
			                                Template_Code = "PAYMENT_REFUNDED"
			                                Subject = "Refund confirmed for AWB " + shipment_record.AWB_Number
			                                Message_Summary = refund_summary
			                                Provider = "Zoho Mail"
			                                Communication_Status = "Sent"
			                                Attempt_Count = 1
			                                Last_Attempt_At = zoho.currenttime
			                            ];
			                            sendmail
			                            [
			                                from: zoho.adminuserid
			                                to: recipient_email
			                                subject: "Refund confirmed for AWB " + shipment_record.AWB_Number
			                                message: "Your refund of INR " + input.Amount + " has been confirmed. Refund reference: " + refund_reference + "."
			                            ]
			                        }
			                        if(Audit_Log[Module_Name == "Payment Transactions" && Record_ID == input.ID.toString() && Action_Name == "Confirm Verified Refund"].count(ID) == 0)
			                        {
			                            audit_id = insert into Audit_Log
			                            [
			                                Event_Time = zoho.currenttime
			                                Actor_Email = zoho.loginuserid
			                                Actor_Profile = current_profile
			                                Action_Name = "Confirm Verified Refund"
			                                Module_Name = "Payment Transactions"
			                                Record_ID = input.ID.toString()
			                                Before_Data = "Payment Status=Success; Provider Payment=" + input.Gateway_Payment_ID
			                                After_Data = "Payment Status=Refunded; Refund Reference=" + refund_reference
			                                Source = "Payment"
			                                Severity = "Critical"
			                            ];
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Complete_Pickup as "Complete Pickup - Pickup Run Items"
			{
			    type = functions
			    form = Pickup_Run_Sheet_Items
			    execution type = for each record
			    description = "Validates proof and approved rerating, transfers shipment custody, and reconciles pickup run progress"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                run_record = Pickup_Run_Sheets[ID == input.Pickup_Run_Sheet];
			                assigned_agent = Operations_Users[ID == run_record.Assigned_Agent];
			                authorised = assigned_agent.Work_Email == zoho.loginuserid || Operations_Users[Work_Email == zoho.loginuserid && Active == true].count(ID) > 0;
			                if(authorised == false)
			                {
			                    info "Only the assigned agent or an active operations user can complete this pickup.";
			                }
			                else if(input.Stop_Status != "Arrived" || (run_record.Status != "Released" && run_record.Status != "In Progress"))
			                {
			                    info "The pickup stop must be marked Arrived on an active run before completion.";
			                }
			                else if(ifnull(input.Pickup_OTP,"").trim() == "" && input.Pickup_Signature == null)
			                {
			                    info "Capture either the pickup OTP or the customer's signature before completion.";
			                }
			                else
			                {
			                    shipment_record = Shipment_Requests[ID == input.Shipment];
			                    customer_record = Customers[ID == shipment_record.Customer];
			                    physical_weight = ifnull(input.Physical_Weight_Kg,shipment_record.Actual_Weight_Kg);
			                    quote = thisapp.Calculate_Shipment_Quote(shipment_record.Customer,shipment_record.Pickup_Pincode,shipment_record.Delivery_Pincode,shipment_record.Transport_Mode,shipment_record.Length_Cm,shipment_record.Width_Cm,shipment_record.Height_Cm,physical_weight,shipment_record.Payment_Type,shipment_record.Loyalty_Points_Redeemed);
			                    if(quote.get("valid") != true)
			                    {
			                        info quote.get("message");
			                    }
			                    else
			                    {
			                        old_total = shipment_record.Total_Payable;
			                        revised_total = quote.get("total_payable");
			                        charge_changed = (revised_total - old_total).abs() > 0.01;
			                        if(charge_changed == true && input.Customer_Approved_Revised_Charge != true)
			                        {
			                            info "Customer approval is required because the physical weight changed the shipment charge.";
			                        }
			                        else
			                        {
			                            input.Physical_Weight_Kg = physical_weight;
			                            input.Revised_Charge = revised_total;
			                            shipment_record.Actual_Weight_Kg = physical_weight;
			                            shipment_record.Volumetric_Weight_Kg = quote.get("volumetric_weight");
			                            shipment_record.Billable_Weight_Kg = quote.get("billable_weight");
			                            shipment_record.Rated_Distance_Km = quote.get("rated_distance");
			                            shipment_record.Applied_Rate_Card = quote.get("rate_card_id");
			                            shipment_record.Applied_Rate_Slab = quote.get("rate_slab_id");
			                            shipment_record.Base_Rate = quote.get("base_rate");
			                            shipment_record.Fuel_Surcharge = quote.get("fuel_surcharge");
			                            shipment_record.COD_Handling_Fee = quote.get("cod_fee");
			                            shipment_record.GST_Amount = quote.get("gst_amount");
			                            shipment_record.Gross_Amount = quote.get("gross_amount");
			                            shipment_record.Loyalty_Redemption_Amount = quote.get("redemption_amount");
			                            shipment_record.Total_Payable = revised_total;
			                            shipment_record.Shipment_Status = "Picked Up";
			                            shipment_record.Current_Hub = run_record.Hub;
			                            if(charge_changed == true)
			                            {
			                                invoice_record = Invoices[Shipment == shipment_record.ID];
			                                if(invoice_record.count(ID) > 0)
			                                {
			                                    if(invoice_record.Invoice_Status == "Draft")
			                                    {
			                                        invoice_record.Freight_Subtotal = shipment_record.Base_Rate;
			                                        invoice_record.Fuel_Surcharge = shipment_record.Fuel_Surcharge;
			                                        invoice_record.COD_Fee = shipment_record.COD_Handling_Fee;
			                                        invoice_record.GST_Amount = shipment_record.GST_Amount;
			                                        invoice_record.Loyalty_Discount = shipment_record.Loyalty_Redemption_Amount;
			                                        invoice_record.Invoice_Total = shipment_record.Total_Payable;
			                                    }
			                                    else if(invoice_record.Invoice_Status != "Void")
			                                    {
			                                        successful_payment_total = 0.0;
			                                        for each successful_payment in Payment_Transactions[Invoice == invoice_record.ID && Payment_Status == "Success"]
			                                        {
			                                            successful_payment_total = successful_payment_total + ifnull(successful_payment.Amount,0);
			                                        }
			                                        invoice_record.Freight_Subtotal = shipment_record.Base_Rate;
			                                        invoice_record.Fuel_Surcharge = shipment_record.Fuel_Surcharge;
			                                        invoice_record.COD_Fee = shipment_record.COD_Handling_Fee;
			                                        invoice_record.GST_Amount = shipment_record.GST_Amount;
			                                        invoice_record.Loyalty_Discount = shipment_record.Loyalty_Redemption_Amount;
			                                        invoice_record.Invoice_Total = shipment_record.Total_Payable;
			                                        if(successful_payment_total >= revised_total)
			                                        {
			                                            invoice_record.Invoice_Status = "Paid";
			                                        }
			                                        else if(successful_payment_total > 0)
			                                        {
			                                            invoice_record.Invoice_Status = "Part Paid";
			                                        }
			                                        else if(invoice_record.Due_Date < zoho.currentdate)
			                                        {
			                                            invoice_record.Invoice_Status = "Overdue";
			                                        }
			                                        else
			                                        {
			                                            invoice_record.Invoice_Status = "Issued";
			                                        }
			                                        ledger_record = Account_Ledger[Invoice == invoice_record.ID && Transaction_Type == "Debit"];
			                                        if(ledger_record.count(ID) > 0)
			                                        {
			                                            rating_adjustment = (revised_total - ledger_record.Amount).round(2);
			                                            adjustment_reference = "RERATE-" + shipment_record.AWB_Number + "-" + input.ID;
			                                            if(rating_adjustment.abs() > 0.01 && Account_Ledger[Payment_Reference == adjustment_reference].count(ID) == 0)
			                                            {
			                                                adjustment_status = "Open";
			                                                if(successful_payment_total >= revised_total)
			                                                {
			                                                    adjustment_status = "Settled";
			                                                }
			                                                else if(successful_payment_total > 0)
			                                                {
			                                                    adjustment_status = "Partially Settled";
			                                                }
			                                                else if(invoice_record.Due_Date < zoho.currentdate)
			                                                {
			                                                    adjustment_status = "Overdue";
			                                                }
			                                                adjustment_id = insert into Account_Ledger
			                                                [
			                                                    Customer = shipment_record.Customer
			                                                    Shipment = shipment_record.ID
			                                                    Invoice = invoice_record.ID
			                                                    Transaction_Type = "Adjustment"
			                                                    Amount = rating_adjustment
			                                                    Transaction_Date = zoho.currenttime
			                                                    Due_Date = invoice_record.Due_Date
			                                                    Ledger_Status = adjustment_status
			                                                    Ageing_Bucket = if(adjustment_status == "Overdue","1-30 Days",if(adjustment_status == "Settled","Not Applicable","Current"))
			                                                    Payment_Reference = adjustment_reference
			                                                    Notes = "Signed adjustment posted after physical-weight rerating at pickup."
			                                                    Posted_By_Email = zoho.loginuserid
			                                                    Customer_Login_Email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID)
			                                                ];
			                                            }
			                                            if(successful_payment_total >= revised_total)
			                                            {
			                                                ledger_record.Ledger_Status = "Settled";
			                                            }
			                                            else if(successful_payment_total > 0)
			                                            {
			                                                ledger_record.Ledger_Status = "Partially Settled";
			                                            }
			                                            else if(invoice_record.Invoice_Status == "Overdue")
			                                            {
			                                                ledger_record.Ledger_Status = "Overdue";
			                                            }
			                                            else
			                                            {
			                                                ledger_record.Ledger_Status = "Open";
			                                            }
			                                            thisapp.Recalculate_Customer_Outstanding(shipment_record.Customer);
			                                        }
			                                    }
			                                }
			                                if(shipment_record.Payment_Type == "Prepaid" && revised_total > old_total)
			                                {
			                                    shipment_record.Payment_Status = "Pending";
			                                }
			                            }
			                            input.Stop_Status = "Picked Up";
			                            input.Completed_At = zoho.currenttime;
			                            resolved_count = Pickup_Run_Sheet_Items[Pickup_Run_Sheet == input.Pickup_Run_Sheet && ID != input.ID && (Stop_Status == "Picked Up" || Stop_Status == "Failed")].count(ID) + 1;
			                            run_record.Completed_Stop_Count = resolved_count;
			                            run_record.Status = "In Progress";
			                            tracking_id = insert into Shipment_Tracking_Events
			                            [
			                                Shipment = shipment_record.ID
			                                Event_Time = zoho.currenttime
			                                Event_Status = "Picked Up"
			                                Hub = run_record.Hub
			                                Agent = assigned_agent.ID
			                                Latitude = input.Agent_Latitude
			                                Longitude = input.Agent_Longitude
			                                Event_Description = "Shipment picked up and custody transferred to the assigned pickup agent. Physical weight: " + physical_weight + " kg."
			                                Source = "Pickup Scan"
			                                Customer_Visible = true
			                                Created_By_Email = zoho.loginuserid
			                            ];
			                            customer_record = Customers[ID == shipment_record.Customer];
			                            communication_id = insert into Communication_Log
			                            [
			                                Customer = customer_record.ID
			                                Shipment = shipment_record.ID
			                                Recipient = customer_record.Email_ID
			                                Channel = "Email"
			                                Template_Code = "SHIPMENT_PICKED_UP"
			                                Subject = "Shipment picked up: AWB " + shipment_record.AWB_Number
			                                Message_Summary = "Shipment pickup completed. Current status: Picked Up."
			                                Provider = "Zoho Mail"
			                                Communication_Status = "Sent"
			                                Attempt_Count = 1
			                                Last_Attempt_At = zoho.currenttime
			                            ];
			                            sendmail
			                            [
			                                from: zoho.adminuserid
			                                to: customer_record.Email_ID
			                                subject: "Shipment picked up: AWB " + shipment_record.AWB_Number
			                                message: "Your shipment has been picked up. Current status: Picked Up."
			                            ]
			                            audit_id = insert into Audit_Log
			                            [
			                                Event_Time = zoho.currenttime
			                                Actor_Email = zoho.loginuserid
			                                Actor_Profile = current_profile
			                                Action_Name = "Complete Pickup"
			                                Module_Name = "Pickup Run Sheet Items"
			                                Record_ID = input.ID.toString()
			                                Before_Data = "Stop Status=Arrived; Shipment Status=" + shipment_record.Shipment_Status + "; Amount=" + old_total
			                                After_Data = "Stop Status=Picked Up; Shipment Status=Picked Up; Physical Weight=" + physical_weight + "; Amount=" + revised_total
			                                Source = "Report Action"
			                                Severity = "Critical"
			                            ];
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Complete_Pickup_My_Pickup_Tasks as "Complete Pickup - My Pickup Tasks"
			{
			    type = functions
