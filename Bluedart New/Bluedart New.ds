			Shipment_Requests_On_Load as "Secure and Configure Shipment Booking"
			{
			    type = form
			    form = Shipment_Requests
			    record event = on add or edit
			    description = "Resolves the portal customer and protects calculated, routing, payment, and lifecycle fields"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Booking_Source, Volumetric_Weight_Kg, Billable_Weight_Kg, Rated_Distance_Km, Applied_Rate_Card, Applied_Rate_Slab, Base_Rate, Fuel_Surcharge, COD_Handling_Fee, GST_Amount, Gross_Amount, Loyalty_Redemption_Amount, Total_Payable, Payment_Status, Credit_Check_Status, Collection_Center, Origin_Sorting_Hub, Destination_Sorting_Hub, Destination_Hub, Current_Hub, Shipment_Status, Booked_On, NDR_Attempt_Count, Loyalty_Awarded, EPOD_WorkDrive_File_ID, EPOD_Download_URL;
			                is_portal = thisapp.portal.isUserInProfile("Customer_Portal");
			                if(input.ID == null && is_portal == false)
			                {
			                    if(thisapp.permissions.loginUserProfile() == "Field_Agent")
			                    {
			                        input.Booking_Source = "Field Agent";
			                    }
			                    else
			                    {
			                        input.Booking_Source = "Employee";
			                    }
			                }
			                if(is_portal == true)
			                {
			                    portal_customer = Customers[(Portal_Login_Email == zoho.loginuserid || Email_ID == zoho.loginuserid) && Active == true];
			                    if(portal_customer.count(ID) == 0)
			                    {
			                        alert "No active customer profile is linked to this portal login.";
			                        disable Booking_Source, Customer, Sender_Name, Sender_Phone, Sender_Email, Pickup_Address, Pickup_Pincode, Recipient_Name, Recipient_Phone, Recipient_Email, Delivery_Address, Delivery_Pincode, Package_Count, Contents_Description, Declared_Value, Transport_Mode, Length_Cm, Width_Cm, Height_Cm, Actual_Weight_Kg, Loyalty_Points_Redeemed, Payment_Type, COD_Amount;
			                        openUrl("#Page:Customer_Dashboard","same window");
			                    }
			                    else
			                    {
			                        if(input.ID == null)
			                        {
			                            input.Booking_Source = "Customer Portal";
			                            input.Customer = portal_customer.ID;
			                            input.Sender_Name = ifnull(portal_customer.Full_Name.first_name,"") + " " + ifnull(portal_customer.Full_Name.last_name,"");
			                            input.Sender_Phone = portal_customer.Mobile_Number;
			                            input.Sender_Email = portal_customer.Email_ID;
			                            input.Pickup_Address = portal_customer.Primary_Address;
			                            input.Pickup_Pincode = portal_customer.Primary_Address.postal_Code;
			                            if(portal_customer.Payment_Terms == "Prepaid")
			                            {
			                                input.Payment_Type = "Prepaid";
			                            }
			                        }
			                        disable Booking_Source, Customer;
			                        if(input.Customer != portal_customer.ID)
			                        {
			                            alert "You are not authorised to access this shipment.";
			                            disable Sender_Name, Sender_Phone, Sender_Email, Pickup_Address, Pickup_Pincode, Recipient_Name, Recipient_Phone, Recipient_Email, Delivery_Address, Delivery_Pincode, Package_Count, Contents_Description, Declared_Value, Transport_Mode, Length_Cm, Width_Cm, Height_Cm, Actual_Weight_Kg, Loyalty_Points_Redeemed, Payment_Type, COD_Amount;
			                            openUrl("#Page:Customer_Dashboard","same window");
			                        }
			                    }
			                }
			                if(input.Payment_Type == "COD")
			                {
			                    show COD_Amount;
			                }
			                else
			                {
			                    hide COD_Amount;
			                }
			                if(input.ID != null && input.Shipment_Status != "Booked" && input.Shipment_Status != "Booked - Hub Assignment Pending" && input.Shipment_Status != "Credit Hold")
			                {
			                    disable Booking_Source, Customer, Sender_Name, Sender_Phone, Sender_Email, Pickup_Address, Pickup_Pincode, Recipient_Name, Recipient_Phone, Recipient_Email, Delivery_Address, Delivery_Pincode, Package_Count, Contents_Description, Declared_Value, Transport_Mode, Length_Cm, Width_Cm, Height_Cm, Actual_Weight_Kg, Loyalty_Points_Redeemed, Payment_Type, COD_Amount;
			                }
			            )
			        }
			    }
			}

			Shipment_Requests_On_Success as "Finalize Shipment Booking"
			{
			    type = form
			    form = Shipment_Requests
			    record event = on add
			    description = "Finalizes hubs, capacity, cutoff, ETA, tracking, billing, payment, redemption, notification, and audit records"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                shipment_record = Shipment_Requests[ID == input.ID];
			                customer_record = Customers[ID == shipment_record.Customer];
			                pickup_map = Hub_Pincode_Mapping[Pincode == shipment_record.Pickup_Pincode && Active == true];
			                delivery_map = Hub_Pincode_Mapping[Pincode == shipment_record.Delivery_Pincode && Active == true];
			                shipment_record.Booked_On = zoho.currenttime;
			                assignable = pickup_map.count(ID) > 0 && delivery_map.count(ID) > 0 && pickup_map.Serviceability != "Non-Serviceable" && delivery_map.Serviceability != "Non-Serviceable";
			                if(assignable == true)
			                {
			                    origin_hub = Hubs[ID == pickup_map.Primary_Collection_Center && Active == true];
			                    destination_hub = Hubs[ID == delivery_map.Primary_Collection_Center && Active == true];
			                    if(origin_hub.count(ID) == 0 || destination_hub.count(ID) == 0)
			                    {
			                        assignable = false;
			                    }
			                    else
			                    {
			                        todays_origin_load = Shipment_Requests[Collection_Center == origin_hub.ID && Booked_On >= zoho.currentdate && Shipment_Status != "Cancelled"].count(ID);
			                        after_cutoff = false;
			                        if(zoho.currenttime.getHour() > origin_hub.Cut_Off_Time.getHour() || (zoho.currenttime.getHour() == origin_hub.Cut_Off_Time.getHour() && zoho.currenttime.getMinutes() > origin_hub.Cut_Off_Time.getMinutes()))
			                        {
			                            after_cutoff = true;
			                        }
			                        if(todays_origin_load >= origin_hub.Daily_Capacity || after_cutoff == true)
			                        {
			                            alternate_hub = Hubs[ID == pickup_map.Secondary_Overflow_Hub && Active == true];
			                            if(alternate_hub.count(ID) > 0)
			                            {
			                                alternate_load = Shipment_Requests[Collection_Center == alternate_hub.ID && Booked_On >= zoho.currentdate && Shipment_Status != "Cancelled"].count(ID);
			                                alternate_after_cutoff = zoho.currenttime.getHour() > alternate_hub.Cut_Off_Time.getHour() || (zoho.currenttime.getHour() == alternate_hub.Cut_Off_Time.getHour() && zoho.currenttime.getMinutes() > alternate_hub.Cut_Off_Time.getMinutes());
			                                if(alternate_load < alternate_hub.Daily_Capacity && alternate_after_cutoff == false)
			                                {
			                                    origin_hub = alternate_hub;
			                                }
			                                else
			                                {
			                                    assignable = false;
			                                }
			                            }
			                            else
			                            {
			                                assignable = false;
			                            }
			                        }
			                        if(assignable == true)
			                        {
			                            shipment_record.Collection_Center = origin_hub.ID;
			                            shipment_record.Origin_Sorting_Hub = origin_hub.Parent_Sorting_Hub;
			                            shipment_record.Destination_Hub = destination_hub.ID;
			                            shipment_record.Destination_Sorting_Hub = destination_hub.Parent_Sorting_Hub;
			                            shipment_record.Current_Hub = origin_hub.ID;
			                            route_record = Transport_Routes[Origin_Sorting_Hub == shipment_record.Origin_Sorting_Hub && Destination_Sorting_Hub == shipment_record.Destination_Sorting_Hub && Transport_Mode == shipment_record.Transport_Mode && Active == true] sort by Estimated_Transit_Hours range from 0 to 0;
			                            transit_days = 1;
			                            if(route_record.count(ID) > 0)
			                            {
			                                transit_days = (route_record.Estimated_Transit_Hours / 24).ceil() + 1;
			                            }
			                            shipment_record.Expected_Delivery_Date = zoho.currentdate.addDay(transit_days);
			                            if(shipment_record.Credit_Check_Status != "Hold")
			                            {
			                                shipment_record.Shipment_Status = "Booked";
			                            }
			                        }
			                    }
			                }
			                if(assignable == false && shipment_record.Credit_Check_Status != "Hold")
			                {
			                    shipment_record.Shipment_Status = "Booked - Hub Assignment Pending";
			                }
			                tracking_id = insert into Shipment_Tracking_Events
			                [
			                    Shipment = shipment_record.ID
			                    Event_Time = zoho.currenttime
			                    Event_Status = shipment_record.Shipment_Status
			                    Hub = shipment_record.Current_Hub
			                    Event_Description = "Shipment booking was confirmed and initial routing was evaluated."
			                    Source = "Booking"
			                    Customer_Visible = true
			                    Created_By_Email = zoho.loginuserid
			                ];
			                due_date = zoho.currentdate;
			                if(customer_record.Payment_Terms == "Net 15")
			                {
			                    due_date = zoho.currentdate.addDay(15);
			                }
			                else if(customer_record.Payment_Terms == "Net 30")
			                {
			                    due_date = zoho.currentdate.addDay(30);
			                }
			                invoice_id = insert into Invoices
			                [
			                    Shipment = shipment_record.ID
			                    Customer = customer_record.ID
			                    Invoice_Date = zoho.currentdate
			                    Freight_Subtotal = shipment_record.Base_Rate
			                    Fuel_Surcharge = shipment_record.Fuel_Surcharge
			                    COD_Fee = shipment_record.COD_Handling_Fee
			                    GST_Amount = shipment_record.GST_Amount
			                    Loyalty_Discount = shipment_record.Loyalty_Redemption_Amount
			                    Credit_Rebate = 0
			                    Invoice_Total = shipment_record.Total_Payable
			                    Payment_Terms = customer_record.Payment_Terms
			                    Due_Date = due_date
			                    Invoice_Status = "Draft"
			                ];
			                if(ifnull(shipment_record.Loyalty_Points_Redeemed,0) > 0)
			                {
			                    loyalty_id = insert into Loyalty_Transactions
			                    [
			                        Customer = customer_record.ID
			                        Shipment = shipment_record.ID
			                        Transaction_Type = "Redeem"
			                        Points = 0 - shipment_record.Loyalty_Points_Redeemed
			                        Amount_Equivalent = shipment_record.Loyalty_Redemption_Amount
			                        Transaction_Date = zoho.currenttime
			                        Points_Status = "Consumed"
			                        Applied_Tier = customer_record.Current_Loyalty_Tier
			                        Reference = "AWB " + shipment_record.AWB_Number
			                        Notes = "Points redeemed against shipment booking"
			                        Posted_By_Email = zoho.loginuserid
			                        Customer_Login_Email = if(ifnull(customer_record.Portal_Login_Email,"").trim() != "",customer_record.Portal_Login_Email,customer_record.Email_ID)
			                    ];
			                    customer_record.Current_Loyalty_Points = ifnull(customer_record.Current_Loyalty_Points,0) - shipment_record.Loyalty_Points_Redeemed;
			                }
			                communication_id = insert into Communication_Log
			                [
			                    Customer = customer_record.ID
			                    Shipment = shipment_record.ID
			                    Recipient = customer_record.Email_ID
			                    Channel = "Email"
			                    Template_Code = "SHIPMENT_BOOKED"
			                    Subject = "Shipment booked: AWB " + shipment_record.AWB_Number
			                    Message_Summary = "Shipment booking confirmed with status " + shipment_record.Shipment_Status + "."
			                    Provider = "Zoho Mail"
			                    Communication_Status = "Sent"
			                    Attempt_Count = 1
			                    Last_Attempt_At = zoho.currenttime
			                ];
			                sendmail
			                [
			                    from: zoho.adminuserid
			                    to: customer_record.Email_ID
			                    subject: "Shipment booked: AWB " + shipment_record.AWB_Number
			                    message: "Your shipment has been booked. Current status: " + shipment_record.Shipment_Status + ". Total payable: INR " + shipment_record.Total_Payable + "."
			                ]
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = "Shipment Booking"
			                    Action_Name = "Book Shipment"
			                    Module_Name = "Shipment Requests"
			                    Record_ID = shipment_record.ID.toString()
			                    After_Data = "AWB=" + shipment_record.AWB_Number + "; Status=" + shipment_record.Shipment_Status + "; Amount=" + shipment_record.Total_Payable + "; Collection Center=" + shipment_record.Collection_Center
			                    Source = "Form Workflow"
			                    Severity = "Info"
			                ];
			            )
			        }
			    }
			}

			Shipment_Requests_On_Validate as "Validate Shipment Booking"
			{
			    type = form
			    form = Shipment_Requests
			    record event = on add or edit
			    description = "Validates ownership, serviceability, package values, rating, redemption, payment, KYC, and credit rules"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                is_portal = thisapp.portal.isUserInProfile("Customer_Portal");
			                if(is_portal == true)
			                {
			                    input.Booking_Source = "Customer Portal";
			                }
			                else if(thisapp.permissions.loginUserProfile() == "Field_Agent")
			                {
			                    input.Booking_Source = "Field Agent";
			                }
			                else
			                {
			                    input.Booking_Source = "Employee";
			                }
			                customer_record = Customers[ID == input.Customer];
			                if(customer_record.count(ID) == 0)
			                {
			                    alert "Select a valid customer.";
			                    cancel submit;
			                }
			                if(is_portal == true && customer_record.Portal_Login_Email != zoho.loginuserid && customer_record.Email_ID != zoho.loginuserid)
			                {
			                    alert "You cannot book or update a shipment for another customer.";
			                    cancel submit;
			                }
			                if(customer_record.Active != true || customer_record.Onboarding_Status != "Active")
			                {
			                    alert "Shipment booking is available only for active, fully onboarded customers.";
			                    cancel submit;
			                }
			                if(ifnull(input.Pickup_Pincode,"").matches("[0-9]{6}") == false || ifnull(input.Delivery_Pincode,"").matches("[0-9]{6}") == false)
			                {
			                    alert "Pickup and delivery pincodes must contain exactly six digits.";
			                    cancel submit;
			                }
			                if(ifnull(input.Package_Count,0) <= 0 || ifnull(input.Declared_Value,0) <= 0 || ifnull(input.Length_Cm,0) <= 0 || ifnull(input.Width_Cm,0) <= 0 || ifnull(input.Height_Cm,0) <= 0 || ifnull(input.Actual_Weight_Kg,0) <= 0)
			                {
			                    alert "Package count, declared value, dimensions, and actual weight must be greater than zero.";
			                    cancel submit;
			                }
			                pickup_map = Hub_Pincode_Mapping[Pincode == input.Pickup_Pincode && Active == true && Serviceability != "Non-Serviceable"];
			                delivery_map = Hub_Pincode_Mapping[Pincode == input.Delivery_Pincode && Active == true && Serviceability != "Non-Serviceable"];
			                if(pickup_map.count(ID) == 0 || delivery_map.count(ID) == 0)
			                {
			                    alert "One or both pincodes are not currently serviceable.";
			                    cancel submit;
			                }
			                quote = thisapp.Calculate_Shipment_Quote(customer_record.ID,input.Pickup_Pincode,input.Delivery_Pincode,input.Transport_Mode,input.Length_Cm,input.Width_Cm,input.Height_Cm,input.Actual_Weight_Kg,input.Payment_Type,ifnull(input.Loyalty_Points_Redeemed,0));
			                if(quote.get("valid") != true)
			                {
			                    alert quote.get("message");
			                    cancel submit;
			                }
			                input.Volumetric_Weight_Kg = quote.get("volumetric_weight");
			                input.Billable_Weight_Kg = quote.get("billable_weight");
			                input.Rated_Distance_Km = quote.get("rated_distance");
			                input.Applied_Rate_Card = quote.get("rate_card_id");
			                input.Applied_Rate_Slab = quote.get("rate_slab_id");
			                input.Base_Rate = quote.get("base_rate");
			                input.Fuel_Surcharge = quote.get("fuel_surcharge");
			                input.COD_Handling_Fee = quote.get("cod_fee");
			                input.GST_Amount = quote.get("gst_amount");
			                input.Gross_Amount = quote.get("gross_amount");
			                input.Loyalty_Redemption_Amount = quote.get("redemption_amount");
			                input.Total_Payable = quote.get("total_payable");
			                if(ifnull(input.Loyalty_Points_Redeemed,0) < 0 || input.Loyalty_Points_Redeemed > ifnull(customer_record.Current_Loyalty_Points,0))
			                {
			                    alert "Redeemed points cannot be negative or exceed the customer's current points balance.";
			                    cancel submit;
			                }
			                if(ifnull(input.Loyalty_Redemption_Amount,0) > ifnull(input.Gross_Amount,0))
			                {
			                    alert "Loyalty redemption cannot exceed the shipment gross amount.";
			                    cancel submit;
			                }
			                if(input.Payment_Type == "COD")
			                {
			                    if(ifnull(input.COD_Amount,0) <= 0)
			                    {
			                        alert "Enter the positive amount to collect for a COD shipment.";
			                        cancel submit;
			                    }
			                    input.Payment_Status = "Not Required";
			                    input.Credit_Check_Status = "Not Applicable";
			                }
			                else if(input.Payment_Type == "Credit")
			                {
			                    input.Payment_Status = "Not Required";
			                    if(customer_record.Customer_Type == "Retail" || customer_record.Payment_Terms == "Prepaid")
			                    {
			                        alert "Credit shipment booking is not available for this customer.";
			                        cancel submit;
			                    }
			                    if(customer_record.Onboarding_Status == "KYC Expired" || (customer_record.KYC_Expiry_Date != null && customer_record.KYC_Expiry_Date < zoho.currentdate))
			                    {
			                        input.Credit_Check_Status = "KYC Blocked";
			                        alert "Credit booking is blocked because KYC has expired.";
			                        cancel submit;
			                    }
			                    projected_outstanding = ifnull(customer_record.Outstanding_Balance,0) + ifnull(input.Total_Payable,0);
			                    if(projected_outstanding > ifnull(customer_record.Approved_Credit_Limit,0))
			                    {
			                        input.Credit_Check_Status = "Hold";
			                        input.Shipment_Status = "Credit Hold";
			                    }
			                    else
			                    {
			                        input.Credit_Check_Status = "Passed";
			                    }
			                }
			                else
			                {
			                    input.COD_Amount = 0;
			                    input.Payment_Status = "Pending";
			                    input.Credit_Check_Status = "Not Applicable";
			                }
			                if(is_portal == true && input.ID != null)
			                {
			                    stored_record = Shipment_Requests[ID == input.ID];
			                    if(input.Payment_Status != stored_record.Payment_Status || input.Credit_Check_Status != stored_record.Credit_Check_Status || input.Collection_Center != stored_record.Collection_Center || input.Origin_Sorting_Hub != stored_record.Origin_Sorting_Hub || input.Destination_Sorting_Hub != stored_record.Destination_Sorting_Hub || input.Destination_Hub != stored_record.Destination_Hub || input.Current_Hub != stored_record.Current_Hub || input.Shipment_Status != stored_record.Shipment_Status || input.Booked_On != stored_record.Booked_On || input.NDR_Attempt_Count != stored_record.NDR_Attempt_Count || input.Loyalty_Awarded != stored_record.Loyalty_Awarded)
			                    {
			                        alert "Calculated routing, payment, and shipment lifecycle fields cannot be changed from the customer portal.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

