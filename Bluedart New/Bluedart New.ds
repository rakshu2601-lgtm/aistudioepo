			Tracking_Event_Correction_Audit as "Audit Tracking Event Correction"
			{
			    type = form
			    form = Shipment_Tracking_Events
			    record event = on edit
			    description = "Audits every authorised administrator correction to immutable shipment history"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_profile = thisapp.permissions.loginUserProfile();
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = current_profile
			                    Action_Name = "Correct Shipment Tracking Event"
			                    Module_Name = "Shipment Tracking Events"
			                    Record_ID = input.ID.toString()
			                    After_Data = "Shipment=" + input.Shipment + "; Status=" + input.Event_Status + "; Event Time=" + input.Event_Time + "; Source=" + input.Source + "; Customer Visible=" + input.Customer_Visible
			                    Source = "Admin Correction"
			                    Severity = "Critical"
			                ];
			            )
			        }
			    }
			}

			Shipment_Tracking_Events_On_Delete as "Prevent Tracking Event Deletion"
			{
			    type = form
			    form = Shipment_Tracking_Events
			    record event = on delete
			    description = "Preserves the immutable shipment chain of custody by blocking event deletion"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                alert "Shipment tracking events are immutable and cannot be deleted.";
			                cancel delete;
			            )
			        }
			    }
			}

			Shipment_Tracking_Events_On_Load as "Secure Tracking Event Form"
			{
			    type = form
			    form = Shipment_Tracking_Events
			    record event = on add or edit
			    description = "Protects immutable event metadata and prevents unauthorised direct-record access"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Created_By_Email;
			                is_portal = thisapp.portal.isUserInProfile("Customer_Portal");
			                if(is_portal == true)
			                {
			                    hide Hub, Manifest, Bag, Agent, Latitude, Longitude, Customer_Visible, Created_By_Email;
			                    if(input.ID != null)
			                    {
			                        shipment_record = Shipment_Requests[ID == input.Shipment];
			                        customer_record = Customers[ID == shipment_record.Customer];
			                        if(input.Customer_Visible != true || (customer_record.Portal_Login_Email != zoho.loginuserid && customer_record.Email_ID != zoho.loginuserid))
			                        {
			                            alert "You are not authorised to access this tracking event.";
			                        }
			                        disable Shipment, Event_Time, Event_Status, Source, Event_Description;
			                    }
			                }
			                else if(input.ID != null && thisapp.permissions.loginUserProfile() != "Logistics_Administrator")
			                {
			                    disable Shipment, Event_Time, Event_Status, Source, Hub, Manifest, Bag, Agent, Latitude, Longitude, Event_Description, Customer_Visible;
			                }
			            )
			        }
			    }
			}

			Shipment_Tracking_Events_On_Validate as "Validate Tracking Event"
			{
			    type = form
			    form = Shipment_Tracking_Events
			    record event = on add or edit
			    description = "Stamps event authorship, validates portal ownership, protects edits, and validates coordinates"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                is_portal = thisapp.portal.isUserInProfile("Customer_Portal");
			                shipment_record = Shipment_Requests[ID == input.Shipment];
			                if(shipment_record.count(ID) == 0)
			                {
			                    alert "Select a valid shipment.";
			                    cancel submit;
			                }
			                if(input.Latitude != null && (input.Latitude < -90 || input.Latitude > 90))
			                {
			                    alert "Latitude must be between -90 and 90.";
			                    cancel submit;
			                }
			                if(input.Longitude != null && (input.Longitude < -180 || input.Longitude > 180))
			                {
			                    alert "Longitude must be between -180 and 180.";
			                    cancel submit;
			                }
			                if(input.ID != null)
			                {
			                    if(is_portal == true || thisapp.permissions.loginUserProfile() != "Logistics_Administrator")
			                    {
			                        alert "Shipment tracking events are immutable. Only a logistics administrator can correct an event.";
			                        cancel submit;
			                    }
			                    stored_event = Shipment_Tracking_Events[ID == input.ID];
			                    input.Created_By_Email = stored_event.Created_By_Email;
			                }
			                else
			                {
			                    input.Created_By_Email = zoho.loginuserid;
			                    if(is_portal == true)
			                    {
			                        customer_record = Customers[ID == shipment_record.Customer];
			                        if(customer_record.count(ID) == 0 || (customer_record.Portal_Login_Email != zoho.loginuserid && customer_record.Email_ID != zoho.loginuserid))
			                        {
			                            alert "You cannot add a tracking event for another customer's shipment.";
			                            cancel submit;
			                        }
			                        input.Event_Status = "Information";
			                        input.Source = "System";
			                        input.Customer_Visible = true;
			                        input.Hub = null;
			                        input.Manifest = null;
			                        input.Bag = null;
			                        input.Agent = null;
			                        input.Latitude = null;
			                        input.Longitude = null;
			                    }
			                }
			            )
			        }
			    }
			}

			Transport_Routes_On_Success as "Audit Transport Route"
			{
			    type = form
			    form = Transport_Routes
			    record event = on add or edit
			    description = "Audits transport lane and route capacity changes"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = "Operations"
			                    Action_Name = "Save Transport Route"
			                    Module_Name = "Transport Routes"
			                    Record_ID = input.ID.toString()
			                    After_Data = "Route=" + input.Route_ID + "; Mode=" + input.Transport_Mode + "; Origin Hub ID=" + input.Origin_Sorting_Hub + "; Destination Hub ID=" + input.Destination_Sorting_Hub + "; Capacity Kg=" + input.Daily_Capacity_Kg
			                    Source = "Form Workflow"
			                    Severity = "Info"
			                ];
			            )
			        }
			    }
			}

			Transport_Routes_On_Validate as "Validate Transport Route"
			{
			    type = form
			    form = Transport_Routes
			    record event = on add or edit
			    description = "Validates sorting-hub lanes, capacities, and active lane uniqueness"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Origin_Sorting_Hub == input.Destination_Sorting_Hub)
			                {
			                    alert "Origin and destination sorting hubs must be different.";
			                    cancel submit;
			                }
			                origin_hub = Hubs[ID == input.Origin_Sorting_Hub];
			                destination_hub = Hubs[ID == input.Destination_Sorting_Hub];
			                if(origin_hub.Hub_Type != "Sorting Hub" || origin_hub.Active != true)
			                {
			                    alert "Origin must be an active sorting hub.";
			                    cancel submit;
			                }
			                if(destination_hub.Hub_Type != "Sorting Hub" || destination_hub.Active != true)
			                {
			                    alert "Destination must be an active sorting hub.";
			                    cancel submit;
			                }
			                if(ifnull(input.Distance_Km,0) <= 0 || ifnull(input.Estimated_Transit_Hours,0) <= 0 || ifnull(input.Daily_Capacity_Kg,0) <= 0)
			                {
			                    alert "Distance, transit hours, and daily capacity must all be greater than zero.";
			                    cancel submit;
			                }
			                if(input.Active == true)
			                {
			                    duplicate_lane_count = Transport_Routes[Origin_Sorting_Hub == input.Origin_Sorting_Hub && Destination_Sorting_Hub == input.Destination_Sorting_Hub && Transport_Mode == input.Transport_Mode && Active == true && ID != input.ID].count();
			                    if(duplicate_lane_count > 0)
			                    {
			                        alert "An active route already exists for this origin, destination, and transport mode.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Vehicles_On_Success as "Audit Vehicle Assignment"
			{
			    type = form
			    form = Vehicles
			    record event = on add or edit
			    description = "Audits vehicle status, hub ownership, and driver assignment changes"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                audit_id = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    Actor_Email = zoho.loginuserid
			                    Actor_Profile = "Operations"
			                    Action_Name = "Save Vehicle"
			                    Module_Name = "Vehicles"
			                    Record_ID = input.ID.toString()
			                    After_Data = "Vehicle=" + input.Vehicle_Number + "; Status=" + input.Status + "; Hub ID=" + input.Owning_Hub + "; Driver ID=" + input.Assigned_Driver
			                    Source = "Form Workflow"
			                    Severity = "Info"
			                ];
			            )
			        }
			    }
			}

			Vehicles_On_Validate as "Validate Vehicle"
			{
			    type = form
			    form = Vehicles
			    record event = on add or edit
			    description = "Validates capacity, driver assignment, hub compatibility, and compliance dates"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(ifnull(input.Capacity_Kg,0) <= 0)
			                {
			                    alert "Vehicle capacity must be greater than zero.";
			                    cancel submit;
			                }
			                if(input.Assigned_Driver != null)
			                {
			                    driver_record = Operations_Users[ID == input.Assigned_Driver];
			                    if(driver_record.Application_Role != "Field Agent" || driver_record.Active != true)
			                    {
			                        alert "Assigned Driver must be an active field agent.";
			                        cancel submit;
			                    }
			                    effective_hub = driver_record.Home_Hub;
			                    if(driver_record.Deputed_Hub != null && driver_record.Deputation_Start_Date != null && driver_record.Deputation_End_Date != null && zoho.currentdate >= driver_record.Deputation_Start_Date && zoho.currentdate <= driver_record.Deputation_End_Date)
			                    {
			                        effective_hub = driver_record.Deputed_Hub;
			                    }
			                    if(effective_hub != input.Owning_Hub)
			                    {
			                        alert "The assigned driver's home or active deputed hub must match the vehicle's owning hub.";
			                        cancel submit;
			                    }
			                }
			                if(input.Active == true && input.Registration_Expiry != null && input.Registration_Expiry < zoho.currentdate)
			                {
			                    alert "An active vehicle cannot have an expired registration.";
			                    cancel submit;
			                }
			                if(input.Active == true && input.Insurance_Expiry != null && input.Insurance_Expiry < zoho.currentdate)
			                {
			                    alert "An active vehicle cannot have expired insurance.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}
		}

		schedule
		{
			Review_Account_Ageing_Daily as "Review Account Ageing Daily"
			{
			    type = schedule
			    start = "2026-01-01 08:00:00"
			    frequency = daily
			    time zone = "Asia/Kolkata"
			    description = "Marks due ledger entries overdue, refreshes ageing buckets, and sends bounded customer reminders"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                due_entries = Account_Ledger[(Transaction_Type == "Debit" || (Transaction_Type == "Adjustment" && Amount > 0)) && (Ledger_Status == "Open" || Ledger_Status == "Partially Settled") && Due_Date < zoho.currentdate] sort by Due_Date range from 0 to 199;
			                for each ledger_record in due_entries
			                {
			                    prior_status = ledger_record.Ledger_Status;
			                    overdue_days = ledger_record.Due_Date.daysBetween(zoho.currentdate);
			                    ledger_record.Ledger_Status = "Overdue";
			                    if(overdue_days <= 30)
			                    {
			                        ledger_record.Ageing_Bucket = "1-30 Days";
			                    }
			                    else if(overdue_days <= 60)
			                    {
			                        ledger_record.Ageing_Bucket = "31-60 Days";
			                    }
			                    else if(overdue_days <= 90)
			                    {
			                        ledger_record.Ageing_Bucket = "61-90 Days";
			                    }
			                    else
			                    {
			                        ledger_record.Ageing_Bucket = "90+ Days";
			                    }
			                    audit_id = insert into Audit_Log
			                    [
			                        Event_Time = zoho.currenttime
			                        Actor_Email = zoho.adminuserid
			                        Actor_Profile = "System"
			                        Action_Name = "Mark Ledger Overdue"
			                        Module_Name = "Account Ledger"
			                        Record_ID = ledger_record.ID.toString()
			                        Before_Data = "Status=" + prior_status
			                        After_Data = "Status=Overdue; Ageing=" + ledger_record.Ageing_Bucket + "; Due Date=" + ledger_record.Due_Date
			                        Source = "Schedule"
			                        Severity = "Warning"
			                    ];
			                }
			                reminder_entries = Account_Ledger[(Transaction_Type == "Debit" || (Transaction_Type == "Adjustment" && Amount > 0)) && Ledger_Status == "Overdue" && Customer_Login_Email != ""] sort by Due_Date range from 0 to 49;
			                for each reminder_record in reminder_entries
			                {
			                    customer_record = Customers[ID == reminder_record.Customer];
			                    recipient_email = reminder_record.Customer_Login_Email;
			                    if(ifnull(recipient_email,"").trim() != "")
			                    {
			                        sendmail
			                        [
			                            from: zoho.adminuserid
			                            to: recipient_email
			                            subject: "Payment reminder for overdue logistics account entry"
			                            message: "An account entry of INR " + reminder_record.Amount + " has been overdue since " + reminder_record.Due_Date + ". Please review your account statement or contact the finance team."
			                        ]
			                        communication_id = insert into Communication_Log
			                        [
			                            Customer = customer_record.ID
			                            Shipment = reminder_record.Shipment
			                            Recipient = recipient_email
			                            Channel = "Email"
			                            Template_Code = "ACCOUNT_OVERDUE_REMINDER"
			                            Subject = "Payment reminder for overdue logistics account entry"
			                            Message_Summary = "Reminder sent for ledger entry " + reminder_record.Ledger_Entry_ID + " amount INR " + reminder_record.Amount + "."
			                            Provider = "Zoho Mail"
			                            Communication_Status = "Sent"
			                            Attempt_Count = 1
			                            Last_Attempt_At = zoho.currenttime
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

			Process_Communication_Queue_Daily as "Process Communication Queue Daily"
			{
			    type = schedule
			    start = "2026-01-01 06:00:00"
			    frequency = daily
			    time zone = "Asia/Kolkata"
			    description = "Processes a bounded notification batch and stops retrying at the active policy limit"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                config_record = App_Configuration[Active == true] range from 0 to 0;
			                retry_limit = if(config_record.count(ID) > 0,config_record.Notification_Retry_Limit,3);
			                queued_records = Communication_Log[(Communication_Status == "Queued" || Communication_Status == "Failed") && Attempt_Count < retry_limit] sort by Communication_ID range from 0 to 49;
			                for each communication_record in queued_records
			                {
			                    communication_record.Attempt_Count = ifnull(communication_record.Attempt_Count,0) + 1;
			                    communication_record.Last_Attempt_At = zoho.currenttime;
			                    try
			                    {
			                        if(communication_record.Channel == "Email")
			                        {
			                            sendmail
			                            [
			                                from: zoho.adminuserid
			                                to: communication_record.Recipient
			                                subject: if(ifnull(communication_record.Subject,"").trim() != "",communication_record.Subject,"Logistics account notification")
			                                message: if(ifnull(communication_record.Message_Summary,"").trim() != "",communication_record.Message_Summary,"A new logistics account notification is available.")
			                            ]
			                            communication_record.Provider = "Zoho Mail";
			                            communication_record.Communication_Status = "Sent";
			                            communication_record.Failure_Reason = "";
			                        }
			                        else if(communication_record.Channel == "Portal Notification")
			                        {
			                            communication_record.Provider = "Other";
			                            communication_record.Communication_Status = "Delivered";
			                            communication_record.Failure_Reason = "Stored as an in-application portal notification.";
			                        }
			                        else
			                        {
			                            communication_record.Communication_Status = "Failed";
			                            communication_record.Failure_Reason = "No DLT-compliant SMS or WhatsApp connection is configured. Configure an approved provider connection before retrying this channel.";
			                        }
			                    }
			                    catch(error_record)
			                    {
			                        communication_record.Communication_Status = "Failed";
			                        communication_record.Failure_Reason = "Delivery attempt failed: " + error_record.message;
			                    }
			                    if(communication_record.Communication_Status == "Failed" || communication_record.Communication_Status == "Sent" || communication_record.Communication_Status == "Delivered")
			                    {
			                        audit_id = insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            Actor_Email = zoho.adminuserid
			                            Actor_Profile = "System"
			                            Action_Name = "Process Communication Attempt"
			                            Module_Name = "Communication Log"
			                            Record_ID = communication_record.ID.toString()
			                            After_Data = "Channel=" + communication_record.Channel + "; Status=" + communication_record.Communication_Status + "; Attempt=" + communication_record.Attempt_Count + "; Provider=" + communication_record.Provider
			                            Source = "Schedule"
			                            Severity = if(communication_record.Communication_Status == "Failed","Warning","Info")
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

