"Customer_Portal"
{
    name = "Customer_Portal"
    type = customer_portal
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
    description = "Customer self-service access to owned profile, KYC, shipments, billing, and loyalty"
    ModulePermissions
    {
        Customers
        {
            enabled = View,Edit,Search,Tab
            allFieldsVisible = false
            ReportPermissions { My_Profile={"View","Edit"} Action_Required_Customers={"View"} }
            FieldPermissions
            {
                Customer_ID{visibility:true,readonly:true} Registration_Source{visibility:true,readonly:true} Customer_Type{visibility:true,readonly:true} Full_Name{visibility:true,readonly:false} Mobile_Number{visibility:true,readonly:false} Email_ID{visibility:true,readonly:false} Portal_Login_Email{visibility:true,readonly:true} Primary_Address{visibility:true,readonly:false} Company_Name{visibility:true,readonly:false} GSTIN{visibility:true,readonly:false} PAN_Number{visibility:true,readonly:false} Contact_Person_Name{visibility:true,readonly:false} Contact_Person_Email{visibility:true,readonly:false} Contact_Person_Phone{visibility:true,readonly:false} Requested_Credit_Limit{visibility:true,readonly:false} Approved_Credit_Limit{visibility:true,readonly:true} Payment_Terms{visibility:true,readonly:true} Assigned_Rate_Card{visibility:true,readonly:true} Mobile_OTP_Verified{visibility:true,readonly:true} Email_OTP_Verified{visibility:true,readonly:true} Onboarding_Status{visibility:true,readonly:true} KYC_Submitted_On{visibility:true,readonly:true} KYC_Verified_Date{visibility:true,readonly:true} KYC_Expiry_Date{visibility:true,readonly:true} Portal_Access_Status{visibility:true,readonly:true} Current_Loyalty_Points{visibility:true,readonly:true} Lifetime_Loyalty_Points{visibility:true,readonly:true} Current_Loyalty_Tier{visibility:true,readonly:true} Quarterly_Eligible_Spend{visibility:true,readonly:true} Outstanding_Balance{visibility:true,readonly:true} Default_Collection_Center{visibility:false} OTP_Verified_At{visibility:false} Active{visibility:false}
            }
        }
        Customer_KYC_Documents
        {
            enabled = Create,View,Edit,Search,Tab
            allFieldsVisible = false
            ReportPermissions { My_KYC_Checklist={"View","Edit"} Queried_KYC_Documents={"View","Edit"} }
            FieldPermissions { KYC_Document_ID{visibility:true,readonly:true} Customer{visibility:true,readonly:true} Document_Type{visibility:true,readonly:true} Required_For_Onboarding{visibility:true,readonly:true} Document_Number{visibility:true,readonly:false} Expiry_Date{visibility:true,readonly:false} Uploaded_File{visibility:true,readonly:false} File_Version{visibility:true,readonly:true} Review_Status{visibility:true,readonly:true} Review_Remarks{visibility:true,readonly:true} Uploaded_On{visibility:true,readonly:true} Reviewed_By_Email{visibility:false} Reviewed_On{visibility:true,readonly:true} Locked_After_Verification{visibility:true,readonly:true} }
        }
        Shipment_Requests
        {
            enabled = Create,View,Edit,Search,Tab
            allFieldsVisible = false
            ReportPermissions { My_Shipments={"View","Edit"} }
            FieldPermissions { AWB_Number{visibility:true,readonly:true} Booking_Source{visibility:true,readonly:true} Customer{visibility:true,readonly:true} Sender_Name{visibility:true,readonly:false} Sender_Phone{visibility:true,readonly:false} Sender_Email{visibility:true,readonly:false} Pickup_Address{visibility:true,readonly:false} Pickup_Pincode{visibility:true,readonly:false} Recipient_Name{visibility:true,readonly:false} Recipient_Phone{visibility:true,readonly:false} Recipient_Email{visibility:true,readonly:false} Delivery_Address{visibility:true,readonly:false} Delivery_Pincode{visibility:true,readonly:false} Package_Count{visibility:true,readonly:false} Contents_Description{visibility:true,readonly:false} Declared_Value{visibility:true,readonly:false} Transport_Mode{visibility:true,readonly:false} Length_Cm{visibility:true,readonly:false} Width_Cm{visibility:true,readonly:false} Height_Cm{visibility:true,readonly:false} Actual_Weight_Kg{visibility:true,readonly:false} Volumetric_Weight_Kg{visibility:true,readonly:true} Billable_Weight_Kg{visibility:true,readonly:true} Gross_Amount{visibility:true,readonly:true} Loyalty_Points_Redeemed{visibility:true,readonly:false} Loyalty_Redemption_Amount{visibility:true,readonly:true} Total_Payable{visibility:true,readonly:true} Payment_Type{visibility:true,readonly:false} COD_Amount{visibility:true,readonly:false} Payment_Status{visibility:true,readonly:true} Shipment_Status{visibility:true,readonly:true} Booked_On{visibility:true,readonly:true} Expected_Delivery_Date{visibility:true,readonly:true} EPOD_Download_URL{visibility:true,readonly:true} Rated_Distance_Km{visibility:false} Applied_Rate_Card{visibility:false} Applied_Rate_Slab{visibility:false} Base_Rate{visibility:false} Fuel_Surcharge{visibility:false} COD_Handling_Fee{visibility:false} GST_Amount{visibility:true,readonly:true} Credit_Check_Status{visibility:false} Collection_Center{visibility:false} Origin_Sorting_Hub{visibility:false} Destination_Sorting_Hub{visibility:false} Destination_Hub{visibility:false} Current_Hub{visibility:false} NDR_Attempt_Count{visibility:false} Loyalty_Awarded{visibility:false} EPOD_WorkDrive_File_ID{visibility:false} }
        }
        Shipment_Tracking_Events { enabled = View,Search,Tab allFieldsVisible = false ReportPermissions { Customer_Tracking_Events={"View"} Shipment_Timeline={"View"} } FieldPermissions { Shipment{visibility:true,readonly:true} Event_Time{visibility:true,readonly:true} Event_Status{visibility:true,readonly:true} Event_Description{visibility:true,readonly:true} Customer_Visible{visibility:true,readonly:true} Hub{visibility:false} Manifest{visibility:false} Bag{visibility:false} Agent{visibility:false} Latitude{visibility:false} Longitude{visibility:false} Source{visibility:false} Created_By_Email{visibility:false} } }
        NDR_Instructions { enabled = View,Edit,Search,Tab allFieldsVisible = false ReportPermissions { Customer_NDR_Instructions={"View","Edit"} } FieldPermissions { NDR_ID{visibility:true,readonly:true} Shipment{visibility:true,readonly:true} Delivery_Run_Item{visibility:true,readonly:true} Secure_Token{visibility:false} Failure_Reason{visibility:true,readonly:true} Recipient_Instruction{visibility:true,readonly:false} Reschedule_Date{visibility:true,readonly:false} Updated_Delivery_Address{visibility:true,readonly:false} Submitted_At{visibility:true,readonly:true} NDR_Status{visibility:true,readonly:true} Supervisor_Notes{visibility:false} } }
        Loyalty_Tiers { enabled = View,Search,Tab allFieldsVisible = false ReportPermissions { Active_Tier_Benefits={"View"} } FieldPermissions { Tier_Name{visibility:true,readonly:true} Applies_To{visibility:true,readonly:true} Minimum_Quarterly_Spend{visibility:true,readonly:true} Maximum_Quarterly_Spend{visibility:true,readonly:true} Points_Multiplier{visibility:true,readonly:true} Credit_Rebate_Percent{visibility:true,readonly:true} }
        }
        Loyalty_Transactions { enabled = View,Search,Tab allFieldsVisible = false ReportPermissions { My_Loyalty_History={"View"} My_Points_Expiring_Soon={"View"} } FieldPermissions { Customer{visibility:true,readonly:true} Shipment{visibility:true,readonly:true} Transaction_Type{visibility:true,readonly:true} Points{visibility:true,readonly:true} Amount_Equivalent{visibility:true,readonly:true} Transaction_Date{visibility:true,readonly:true} Expiry_Date{visibility:true,readonly:true} Points_Status{visibility:true,readonly:true} Applied_Tier{visibility:true,readonly:true} Reference{visibility:true,readonly:true} Notes{visibility:false} Posted_By_Email{visibility:false} } }
        Invoices { enabled = View,Search,Tab allFieldsVisible = false ReportPermissions { My_Invoices={"View","Edit"} Overdue_Invoices={"View","Edit"} } FieldPermissions { Invoice_Number{visibility:true,readonly:true} Shipment{visibility:true,readonly:true} Customer{visibility:true,readonly:true} Invoice_Date{visibility:true,readonly:true} Freight_Subtotal{visibility:true,readonly:true} Fuel_Surcharge{visibility:true,readonly:true} COD_Fee{visibility:true,readonly:true} GST_Amount{visibility:true,readonly:true} Loyalty_Discount{visibility:true,readonly:true} Credit_Rebate{visibility:true,readonly:true} Invoice_Total{visibility:true,readonly:true} Payment_Terms{visibility:true,readonly:true} Due_Date{visibility:true,readonly:true} Invoice_Status{visibility:true,readonly:true} Invoice_Download_URL{visibility:true,readonly:true} Zoho_Books_Invoice_ID{visibility:false} Invoice_WorkDrive_File_ID{visibility:false} } }
        Account_Ledger { enabled = View,Search,Tab allFieldsVisible = false ReportPermissions { My_Account_Statement={"View"} } FieldPermissions { Ledger_Entry_ID{visibility:true,readonly:true} Shipment{visibility:true,readonly:true} Invoice{visibility:true,readonly:true} Transaction_Type{visibility:true,readonly:true} Amount{visibility:true,readonly:true} Transaction_Date{visibility:true,readonly:true} Due_Date{visibility:true,readonly:true} Ledger_Status{visibility:true,readonly:true} Payment_Reference{visibility:true,readonly:true} Notes{visibility:false} Posted_By_Email{visibility:false} Customer_Login_Email{visibility:false} } }
        Payment_Transactions { enabled = View,Search,Tab allFieldsVisible = false ReportPermissions { My_Payments={"View"} } FieldPermissions { Payment_Transaction_ID{visibility:true,readonly:true} Shipment{visibility:true,readonly:true} Invoice{visibility:true,readonly:true} Amount{visibility:true,readonly:true} Payment_Method{visibility:true,readonly:true} Payment_Status{visibility:true,readonly:true} Initiated_At{visibility:true,readonly:true} Completed_At{visibility:true,readonly:true} Gateway{visibility:true,readonly:true} Gateway_Order_ID{visibility:false} Gateway_Payment_ID{visibility:false} Gateway_Response_Summary{visibility:false} Failure_Reason{visibility:true,readonly:true} Customer_Login_Email{visibility:false} }
        }
        Customer_Dashboard { enabled = tab }
        Shipment_Tracking { enabled = tab }
    }
}