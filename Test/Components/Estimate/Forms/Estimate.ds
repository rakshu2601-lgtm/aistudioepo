form Estimate
{
    title
    {
        displayname = "Estimate"
        on add = "Assign Estimate Slice"
        on edit = "Review Estimate Slice"
    }
    Assignment
    (
        type = section
        displayname = "Assignment"
        row = 1
        column = 0
    )
    unique Estimate_ID
    (
        type = text
        displayname = "Estimate ID"
        row = 1
        column = 1
        width = medium
    )
    must have Service_Request
    (
        type = picklist
        displayname = "Service Request"
        values = Service_Request.ID
        displayformat = [Service_ID]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have MTter
    (
        type = picklist
        displayname = "MTter"
        values = MTter.ID
        displayformat = [MTter_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Capability_Slice
    (
        type = checkboxes
        displayname = "Capability Slice"
        values = Capability.ID
        displayformat = [Capability_Name]
        row = 1
        column = 2
        width = medium
    )
    must have Vehicles_Assigned
    (
        type = number
        displayname = "Vehicles Assigned"
        row = 1
        column = 1
        width = medium
    )
    must have Currency
    (
        type = picklist
        values = Currency.ID
        displayformat = [Currency_Code]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Labor_Hours
    (
        type = decimal
        displayname = "Labor Hours"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Labor_Rate
    (
        type = decimal
        displayname = "Labor Rate"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 2
        width = medium
    )
    Parts_Total
    (
        type = decimal
        displayname = "Parts Total"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Labor_Total
    (
        type = decimal
        displayname = "Labor Total"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 2
        width = medium
    )
    Estimate_Total
    (
        type = decimal
        displayname = "Estimate Total"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        values = {"Pending","Approved","Declined","Superseded"}
        initial value = "Pending"
        row = 1
        column = 2
        width = medium
    )
    Sent_At
    (
        type = datetime
        displayname = "Sent At"
        row = 1
        column = 1
        width = medium
    )
    Responded_At
    (
        type = datetime
        displayname = "Responded At"
        row = 1
        column = 2
        width = medium
    )
    Decline_Reason
    (
        type = picklist
        displayname = "Decline Reason"
        values = {"Capacity","Capability Gap","Outside Radius","Scheduling","Commercial","Other"}
        row = 1
        column = 1
        width = medium
    )
    Decline_Details
    (
        type = textarea
        displayname = "Decline Details"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    Assigned_Portal_Email
    (
        type = email
        displayname = "Assigned Portal Email"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    Supersedes_Estimate
    (
        type = picklist
        displayname = "Supersedes Estimate"
        values = Estimate.ID
        displayformat = [Estimate_ID]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Active_Slice
    (
        type = checkbox
        displayname = "Active Slice"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    Ranking_Override
    (
        type = checkbox
        displayname = "Ranking Override"
        initial value = false
        row = 1
        column = 2
        width = medium
    )
    Override_Reason
    (
        type = textarea
        displayname = "Override Reason"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    Distance_Value
    (
        type = decimal
        displayname = "Distance Value"
        decimalplace = 2
        row = 1
        column = 2
        width = medium
    )
    Within_Radius
    (
        type = checkbox
        displayname = "Within Radius"
        row = 1
        column = 1
        width = medium
    )
    Matching_Warning
    (
        type = textarea
        displayname = "Matching Warning"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    Reminder_Sent
    (
        type = checkbox
        displayname = "Reminder Sent"
        initial value = false
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Assign Estimate"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Save Review"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
