kanban Task_Board
{
    displayName = "Task Board"
    show all rows from Task
    (
        Service_Request
        Task_Type
        Related_Estimate
        Assigned_To_Email
        Due_Date
        Priority
        Status
    )
    filters
    (
        Task_Type
        Priority
        Assigned_To_Email
    )
    sort by
    (
        Due_Date ascending
    )
    options
    (
        display field = Status
        filter type = manual
        sort order = custom
        record count = enable
    )
}
