Log_Task_Status_Change as "Log Task Status Change"
{
    type = form
    form = Task
    record event = on edit
    description = "Writes an audit activity when task status changes."

    on update of Status
    {
        actions
        {
            custom deluge script
            (
                activity_id = insert into Activity
                [
                    Service_Request = input.Service_Request
                    Related_Estimate = input.Related_Estimate
                    Event_Timestamp = zoho.currenttime
                    User_Email = zoho.loginuser
                    Event_Type = "Task Updated"
                    Description = "Task status changed to " + input.Status + "."
                    Internal_Only = true
                ];
            )
        }
    }
}
