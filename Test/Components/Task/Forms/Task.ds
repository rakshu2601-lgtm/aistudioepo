form Task
{
    Details
    (
        type = section
        displayname = "Details"
        row = 1
        column = 0
    )
    must have Service_Request
    (
        type = picklist
        displayname = "Service Request"
        values = Service_Request.ID
        displayformat = [Service_ID]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Task_Type
    (
        type = picklist
        displayname = "Task Type"
        values = {"Reassignment","Follow-up","Geocoding","Insurance","Other"}
        row = 1
        column = 1
        width = medium
    )
    Related_Estimate
    (
        type = picklist
        displayname = "Related Estimate"
        values = Estimate.ID
        displayformat = [Estimate_ID]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Assigned_To_Email
    (
        type = email
        displayname = "Assigned To Email"
        row = 1
        column = 1
        width = medium
    )
    must have Due_Date
    (
        type = date
        displayname = "Due Date"
        row = 1
        column = 1
        width = medium
    )
    Priority
    (
        type = picklist
        values = {"Low","Medium","High","Critical"}
        initial value = "High"
        row = 1
        column = 1
        width = medium
    )
    Status
    (
        type = picklist
        values = {"Open","In Progress","Completed","Cancelled"}
        initial value = "Open"
        row = 1
        column = 1
        width = medium
    )
    must have Description
    (
        type = textarea
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    Created_Automatically
    (
        type = checkbox
        displayname = "Created Automatically"
        initial value = false
        row = 1
        column = 1
        width = medium
    )
    Completed_At
    (
        type = datetime
        displayname = "Completed At"
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
