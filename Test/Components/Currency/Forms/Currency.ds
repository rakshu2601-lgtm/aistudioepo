form Currency
{
    Details
    (
        type = section
        displayname = "Details"
        row = 1
        column = 0
    )
    must have unique Currency_Code
    (
        type = text
        displayname = "Currency Code"
        maxchar = 3
        row = 1
        column = 1
        width = medium
    )
    must have Currency_Name
    (
        type = text
        displayname = "Currency Name"
        row = 1
        column = 1
        width = medium
    )
    must have Symbol
    (
        type = text
        row = 1
        column = 1
        width = medium
    )
    must have Decimal_Places
    (
        type = number
        displayname = "Decimal Places"
        initial value = 2
        row = 1
        column = 1
        width = medium
    )
    Active
    (
        type = checkbox
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
