form Activity
{
    title
    {
        on add = "Add Activity"
        on edit = "View Activity"
    }
    Audit
    (
        type = section
        displayname = "Audit"
        row = 1
        column = 0
    )
    must have Service_Request
    (
        type = picklist
        displayname = "Service Request"
        values = Service_Request.ID
        displayformat = [Service_ID]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Related_Estimate
    (
        type = picklist
        displayname = "Related Estimate"
        values = Estimate.ID
        displayformat = [Estimate_ID]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Event_Timestamp
    (
        type = datetime
        displayname = "Event Timestamp"
        initial value = "${zoho.currenttime}"
        row = 1
        column = 1
        width = medium
    )
    must have User_Email
    (
        type = email
        displayname = "User Email"
        row = 1
        column = 1
        width = medium
    )
    must have Event_Type
    (
        type = picklist
        displayname = "Event Type"
        values = {"Request Submitted","Status Changed","Match Generated","Ranking Override","Estimate Sent","Estimate Approved","Estimate Declined","Estimate Superseded","Task Created","Task Updated","Totals Recalculated","Notification Sent","Note"}
        row = 1
        column = 1
        width = medium
    )
    must have Description
    (
        type = textarea
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    Internal_Only
    (
        type = checkbox
        displayname = "Internal Only"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
