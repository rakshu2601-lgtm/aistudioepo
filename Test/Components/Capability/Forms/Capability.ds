form Capability
{
    title
    {
        on add = "Add Capability"
        on edit = "Edit Capability"
    }
    Details
    (
        type = section
        displayname = "Details"
        row = 1
        column = 0
    )
    must have unique Capability_Name
    (
        type = text
        displayname = "Capability Name"
        row = 1
        column = 1
        width = medium
    )
    Description
    (
        type = textarea
        row = 1
        column = 1
        width = medium
    )
    Active
    (
        type = checkbox
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
