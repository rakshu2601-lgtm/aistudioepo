form MTter
{
    title
    {
        displayname = "MTter"
        on add = "Add MTter"
        on edit = "Edit MTter"
    }
    Identity
    (
        type = section
        displayname = "Identity"
        row = 1
        column = 0
    )
    unique MTter_ID
    (
        type = text
        displayname = "MTter ID"
        row = 1
        column = 1
        width = medium
    )
    must have MTter_Name
    (
        type = text
        displayname = "MTter Name"
        row = 1
        column = 2
        width = medium
    )
    must have MTter_Type
    (
        type = picklist
        displayname = "MTter Type"
        values = {"Member","Contracted"}
        row = 1
        column = 1
        width = medium
    )
    must have Location_Address
    (
        type = address
        displayname = "Location Address"
        capture_coordinates = true
        adjust_using_map = true
        address_line_1
        (
            type = address_line_1
            displayname = "Address Line 1"
        )
        address_line_2
        (
            type = address_line_2
            displayname = "Address Line 2"
        )
        district_city
        (
            type = district_city
            displayname = "City"
        )
        state_province
        (
            type = state_province
            displayname = "State / Province"
        )
        postal_Code
        (
            type = postal_Code
            displayname = "Postal Code"
        )
        country
        (
            type = country
            displayname = "Country"
        )
        latitude
        (
            type = latitude
            displayname = "Captured Latitude"
            visibility = false
        )
        longitude
        (
            type = longitude
            displayname = "Captured Longitude"
            visibility = false
        )
        row = 1
        column = 2
        width = medium
    )
    Latitude
    (
        type = decimal
        displayname = "Latitude"
        decimalplace = 6
        row = 1
        column = 1
        width = medium
    )
    Longitude
    (
        type = decimal
        displayname = "Longitude"
        decimalplace = 6
        row = 1
        column = 2
        width = medium
    )
    must have Service_Radius
    (
        type = decimal
        displayname = "Service Radius"
        decimalplace = 2
        row = 1
        column = 1
        width = medium
    )
    Radius_Unit
    (
        type = picklist
        displayname = "Radius Unit"
        values = {"Miles","Kilometres"}
        initial value = "Miles"
        row = 1
        column = 2
        width = medium
    )
    must have Capabilities
    (
        type = checkboxes
        displayname = "Capabilities"
        values = Capability.ID
        displayformat = [Capability_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Contact_Name
    (
        type = name
        displayname = "Contact Name"
        prefix
        (
            type = prefix
            displayname = "Title"
            visibility = false
            value = {"Mr.","Mrs.","Ms.","Dr."}
        )
        first_name
        (
            type = first_name
            displayname = "First Name"
        )
        last_name
        (
            type = last_name
            displayname = "Last Name"
        )
        suffix
        (
            type = suffix
            displayname = "Suffix"
            visibility = false
        )
        row = 1
        column = 2
        width = medium
    )
    must have Contact_Email
    (
        type = email
        displayname = "Contact Email"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    Contact_Phone
    (
        type = phonenumber
        displayname = "Contact Phone"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    must have unique Portal_Login_Email
    (
        type = email
        displayname = "Portal Login Email"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    must have Insurance_Expiry
    (
        type = date
        displayname = "Insurance Expiry"
        row = 1
        column = 2
        width = medium
    )
    Completed_Jobs
    (
        type = number
        displayname = "Completed Jobs"
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Rating
    (
        type = decimal
        displayname = "Rating"
        decimalplace = 2
        row = 1
        column = 2
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
