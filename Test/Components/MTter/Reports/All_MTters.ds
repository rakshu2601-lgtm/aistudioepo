default list All_MTters
{
    displayName = "All MTters"
    show all rows from MTter
    (
        MTter_ID
        MTter_Name
        MTter_Type
        Location_Address
        Service_Radius
        Capabilities
        Insurance_Expiry
        Completed_Jobs
        Rating
        Active
    )
    filters
    (
        Active
        MTter_Type
        Capabilities
    )
    sort by
    (
        MTter_Type custom
        Rating descending
    )
}
