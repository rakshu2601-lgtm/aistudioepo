		 detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Service_ID Program_Name Vehicle_Count Vehicle_Type Received_At Target_Completion_Date Status ) ) ) menu ( header ( Edit ) ) )
		}
