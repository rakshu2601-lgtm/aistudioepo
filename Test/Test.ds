			Sync_Estimate_Totals as "Sync Estimate Totals"
			{
			    type = form
			    form = Estimate_Line
			    record event = on add or edit
			    description = "Persists line totals, aggregates active lines to the estimate, and records the recalculation."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                parent_estimate = Estimate[ID == input.Estimate];
			                vehicles = ifNull(parent_estimate.Vehicles_Assigned,0);
			                labor_rate = ifNull(parent_estimate.Labor_Rate,0);
			                parts_total = ifNull(input.Quantity_Per_Vehicle,0) * ifNull(input.Unit_Price,0) * vehicles;
			                labor_total = ifNull(input.Labor_Hours_Per_Vehicle,0) * labor_rate * vehicles;
			                update Estimate_Line[ID == input.ID]
			                [
			                    Line_Parts_Total = parts_total
			                    Line_Labor_Total = labor_total
			                    Line_Total = parts_total + labor_total
			                ];
			                estimate_parts = ifNull(Estimate_Line[Estimate == input.Estimate && Active == true].sum(Line_Parts_Total),0);
			                estimate_hours = ifNull(Estimate_Line[Estimate == input.Estimate && Active == true].sum(Labor_Hours_Per_Vehicle),0) * vehicles;
			                estimate_labor = ifNull(Estimate_Line[Estimate == input.Estimate && Active == true].sum(Line_Labor_Total),0);
			                update Estimate[ID == input.Estimate]
			                [
			                    Parts_Total = estimate_parts
			                    Labor_Hours = estimate_hours
			                    Labor_Total = estimate_labor
			                    Estimate_Total = estimate_parts + estimate_labor
			                ];
			                activity_id = insert into Activity
			                [
			                    Service_Request = parent_estimate.Service_Request
			                    Related_Estimate = input.Estimate
			                    Event_Timestamp = zoho.currenttime
			                    User_Email = zoho.loginuser
			                    Event_Type = "Totals Recalculated"
			                    Description = "Estimate totals recalculated after an estimate line was added or edited."
			                    Internal_Only = true
			                ];
			            )
			        }
			    }
			}

			Sync_Estimate_Totals_On_Delete as "Sync Estimate Totals On Delete"
			{
			    type = form
			    form = Estimate_Line
			    record event = on delete
			    description = "Re-aggregates active estimate lines after deletion and records the recalculation."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                parent_estimate = Estimate[ID == input.Estimate];
			                vehicles = ifNull(parent_estimate.Vehicles_Assigned,0);
			                estimate_parts = ifNull(Estimate_Line[Estimate == input.Estimate && Active == true].sum(Line_Parts_Total),0);
			                estimate_hours = ifNull(Estimate_Line[Estimate == input.Estimate && Active == true].sum(Labor_Hours_Per_Vehicle),0) * vehicles;
			                estimate_labor = ifNull(Estimate_Line[Estimate == input.Estimate && Active == true].sum(Line_Labor_Total),0);
			                update Estimate[ID == input.Estimate]
			                [
			                    Parts_Total = estimate_parts
			                    Labor_Hours = estimate_hours
			                    Labor_Total = estimate_labor
			                    Estimate_Total = estimate_parts + estimate_labor
			                ];
			                activity_id = insert into Activity
			                [
			                    Service_Request = parent_estimate.Service_Request
			                    Related_Estimate = input.Estimate
			                    Event_Timestamp = zoho.currenttime
			                    User_Email = zoho.loginuser
			                    Event_Type = "Totals Recalculated"
			                    Description = "Estimate totals recalculated after an estimate line was deleted."
			                    Internal_Only = true
			                ];
			            )
			        }
			    }
			}

			Validate_Estimate_Line as "Validate Estimate Line"
			{
			    type = form
			    form = Estimate_Line
			    record event = on add or edit
			    description = "Validates approved parts, monetary values, currency consistency, and MTter ownership."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                validation_failed = false;
			                selected_part = Part[ID == input.Part];
			                parent_estimate = Estimate[ID == input.Estimate];
			                if(selected_part.ID == null || selected_part.Active != true)
			                {
			                    alert(Part,"Select an active approved catalog part.");
			                    validation_failed = true;
			                }
			                if(input.Quantity_Per_Vehicle == null || input.Quantity_Per_Vehicle <= 0)
			                {
			                    alert(Quantity_Per_Vehicle,"Quantity per vehicle must be greater than zero.");
			                    validation_failed = true;
			                }
			                if(input.Unit_Price == null || input.Unit_Price < 0)
			                {
			                    alert(Unit_Price,"Unit price cannot be negative.");
			                    validation_failed = true;
			                }
			                if(input.Labor_Hours_Per_Vehicle == null || input.Labor_Hours_Per_Vehicle < 0)
			                {
			                    alert(Labor_Hours_Per_Vehicle,"Labor hours cannot be negative.");
			                    validation_failed = true;
			                }
			                if(parent_estimate.ID == null || input.Currency != parent_estimate.Currency)
			                {
			                    alert(Currency,"Line currency must match the parent estimate currency.");
			                    validation_failed = true;
			                }
			                is_mtter = false;
			                try
			                {
			                    is_mtter = thisapp.portal.isUserInProfile("MTter");
			                }
			                catch (permission_error)
			                {
			                    is_mtter = false;
			                }
			                if(is_mtter && (parent_estimate.ID == null || parent_estimate.Assigned_Portal_Email != zoho.loginuser || parent_estimate.Status != "Pending"))
			                {
			                    alert "MTters may manage lines only under their assigned Pending estimate.";
			                    validation_failed = true;
			                }
			                if(validation_failed)
			                {
			                    cancel submit;
			                }
			                vehicles = ifNull(parent_estimate.Vehicles_Assigned,0);
			                labor_rate = ifNull(parent_estimate.Labor_Rate,0);
			                input.Line_Parts_Total = input.Quantity_Per_Vehicle * input.Unit_Price * vehicles;
			                input.Line_Labor_Total = input.Labor_Hours_Per_Vehicle * labor_rate * vehicles;
			                input.Line_Total = input.Line_Parts_Total + input.Line_Labor_Total;
			            )
			        }
			    }
			}

			Validate_Estimate_Line_Delete as "Validate Estimate Line Delete"
			{
			    type = form
			    form = Estimate_Line
			    record event = on delete
			    description = "Restricts MTter deletion to lines under the logged-in MTter's assigned Pending estimate."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                is_mtter = false;
			                try
			                {
			                    is_mtter = thisapp.portal.isUserInProfile("MTter");
			                }
			                catch (permission_error)
			                {
			                    is_mtter = false;
			                }
			                if(is_mtter)
			                {
			                    parent_estimate = Estimate[ID == input.Estimate];
			                    if(parent_estimate.ID == null || parent_estimate.Assigned_Portal_Email != zoho.loginuser || parent_estimate.Status != "Pending")
			                    {
			                        alert "MTters may delete lines only under their assigned Pending estimate.";
			                        cancel delete;
			                    }
			                }
			            )
			        }
			    }
			}

			Generate_Client_ID as "Generate Client ID"
			{
			    type = form
			    form = FMC_Client
			    record event = on add or edit
			    description = "Generates the client identifier after a successful save when it is blank."
			
			    on success
			    {
			        actions ( Client_ID == null || Client_ID == "" )
			        {
			            custom deluge script
			            (
			                if(input.ID < 10)
			                {
			                    client_code = "CLI-000" + input.ID;
			                }
			                else if(input.ID < 100)
			                {
			                    client_code = "CLI-00" + input.ID;
			                }
			                else if(input.ID < 1000)
			                {
			                    client_code = "CLI-0" + input.ID;
			                }
			                else
			                {
			                    client_code = "CLI-" + input.ID;
			                }
			                client_record = FMC_Client[ID == input.ID];
			                client_record.Client_ID = client_code;
			            )
			        }
			    }
			}

			Generate_MTter_ID as "Generate MTter ID"
			{
			    type = form
			    form = MTter
			    record event = on add
			    description = "Generates the MTter identifier after record creation when it is blank."
			
			    on success
			    {
			        actions ( MTter_ID == null || MTter_ID == "" )
			        {
			            custom deluge script
			            (
			                id_text = input.ID.toString();
			                if(id_text.length() == 1)
			                {
			                    input.MTter_ID = "MTT-000" + id_text;
			                }
			                else if(id_text.length() == 2)
			                {
			                    input.MTter_ID = "MTT-00" + id_text;
			                }
			                else if(id_text.length() == 3)
			                {
			                    input.MTter_ID = "MTT-0" + id_text;
			                }
			                else
			                {
			                    input.MTter_ID = "MTT-" + id_text;
			                }
			            )
			        }
			    }
			}

			Audit_Service_Request_Status as "Audit Service Request Status"
			{
			    type = form
			    form = Service_Request
			    record event = on edit
			    description = "Records substantive lifecycle status changes for submitted requests."
			
			    on update of Status
			    {
			        actions ( Service_ID != null && Service_ID != "" )
			        {
			            custom deluge script
			            (
			                insert into Activity
			                [
			                    Service_Request = input.ID
			                    Event_Timestamp = zoho.currenttime
			                    User_Email = zoho.loginuser
			                    Event_Type = "Status Changed"
			                    Description = "Service request status changed to " + input.Status + "."
			                    Internal_Only = true
			                ];
			            )
			        }
			    }
			}

			Load_Service_Request as "Load Service Request"
			{
			    type = form
			    form = Service_Request
			    record event = on add or edit
			    description = "Applies portal defaults and protects generated and operational fields."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                app_profile = thisapp.permissions.loginUserProfile();
			                portal_profile = thisapp.portal.loginUserProfile();
			                if(portal_profile == "FMC_Client")
			                {
			                    client_record = FMC_Client[Portal_Login_Email == zoho.loginuser];
			                    if(client_record.count() > 0)
			                    {
			                        input.FMC_Client = client_record.ID;
			                    }
			                    input.Source = "FMC Portal";
			                    input.Created_By_Email = zoho.loginuser;
			                    disable FMC_Client;
			                }
			                if(app_profile != "Internal_Admin")
			                {
			                    disable Service_ID, Status, Received_At, Source, Created_By_Email, Geocoding_Status, Geocoding_Warning, Matching_Started_At, Approved_Estimates_Count, Assigned_Vehicle_Count, Remaining_Unassigned_Vehicles;
			                }
			                if(input.Service_ID != null && input.Service_ID != "")
			                {
			                    disable Service_ID;
			                }
			            )
			        }
			    }
			}

			Process_Service_Request as "Process Service Request"
			{
			    type = form
			    form = Service_Request
			    record event = on add or edit
			    description = "Keeps drafts unqueued and initializes first-time submitted requests for Phase 1 matching."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                request_record = Service_Request[ID == input.ID];
			                if(input.Submission_Action == "Save as Draft" && (input.Service_ID == null || input.Service_ID == ""))
			                {
			                    request_record.Status = "Draft";
			                }
			                else if(input.Submission_Action == "Submit Request" && (input.Service_ID == null || input.Service_ID == ""))
			                {
			                    id_text = input.ID.toString();
			                    if(id_text.length() == 1)
			                    {
			                        padded_id = "000" + id_text;
			                    }
			                    else if(id_text.length() == 2)
			                    {
			                        padded_id = "00" + id_text;
			                    }
			                    else if(id_text.length() == 3)
			                    {
			                        padded_id = "0" + id_text;
			                    }
			                    else
			                    {
			                        padded_id = id_text;
			                    }
			                    request_record.Service_ID = "SVC-" + zoho.currentdate.getYear() + "-" + padded_id;
			                    request_record.Received_At = zoho.currenttime;
			                    if(request_record.Source == null || request_record.Source == "")
			                    {
			                        request_record.Source = "Internal";
			                    }
			                    if(request_record.Created_By_Email == null || request_record.Created_By_Email == "")
			                    {
			                        request_record.Created_By_Email = zoho.loginuser;
			                    }
			                    request_record.Geocoding_Status = "Pending Integration";
			                    request_record.Geocoding_Warning = "External geocoding connector is not configured.";
			                    request_record.Approved_Estimates_Count = 0;
			                    request_record.Assigned_Vehicle_Count = 0;
			                    request_record.Remaining_Unassigned_Vehicles = input.Vehicle_Count;
			                    request_record.Status = "Intake";
			                    request_record.Status = "Matching";
			                    request_record.Matching_Started_At = zoho.currenttime;
			                    insert into Activity
			                    [
			                        Service_Request = input.ID
			                        Event_Timestamp = zoho.currenttime
			                        User_Email = zoho.loginuser
			                        Event_Type = "Request Submitted"
			                        Description = "Service request submitted and queued for matching."
			                        Internal_Only = true
			                    ];
			                    insert into Activity
			                    [
			                        Service_Request = input.ID
			                        Event_Timestamp = zoho.currenttime
			                        User_Email = zoho.loginuser
			                        Event_Type = "Status Changed"
			                        Description = "Status advanced from Intake to Matching."
			                        Internal_Only = true
			                    ];
			                    admin_emails = thisapp.permissions.adminEmailIds();
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : request_record.Created_By_Email
			                        subject : "Service request received"
			                        message : "Your fleet-service request " + request_record.Service_ID + " has been received and queued for matching."
			                    );
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : admin_emails
			                        subject : "New service request in Matching"
			                        message : request_record.Service_ID + " has entered the matching queue."
			                    );
			                }
			            )
			        }
			    }
			}

			Service_Request_Lifecycle as "Service Request Lifecycle"
			{
			    type = blueprint
			    form = Service_Request[Status != "Draft"]
			
			    start
			    {
			        start stage = "Intake"
			    }
			
			    stages
			    {
			        "Intake" { }
			        "Matching" { }
			        "Estimating" { }
			        "Ready for quote" { }
			        "Quote sent" { }
			        "PO received" { }
			        "In progress" { }
			        "Completed" { }
			        "Invoiced" { }
			        "Closed" { }
			    }
			
			    transitions
			    {
			        Begin_Matching as "Begin Matching"
			        {
			            type = normal
			            from stage = "Intake"
			            to stage = "Matching"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Internal_Admin","Internal_Coordinator"}
			                )
			            }
			            after { }
			        }
			        Begin_Estimating as "Begin Estimating"
			        {
			            type = normal
			            from stage = "Matching"
			            to stage = "Estimating"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Internal_Admin","Internal_Coordinator"}
			                )
			            }
			            after { }
			        }
			        Ready_For_Quote as "Ready for Quote"
			        {
			            type = normal
			            from stage = "Estimating"
			            to stage = "Ready for quote"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Internal_Admin","Internal_Coordinator"}
			                )
			            }
			            after { }
			        }
			        Send_Quote as "Send Quote"
			        {
			            type = normal
			            from stage = "Ready for quote"
			            to stage = "Quote sent"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Internal_Admin","Internal_Coordinator"}
			                )
			            }
			            after { }
			        }
			        Receive_PO as "Receive PO"
			        {
			            type = normal
			            from stage = "Quote sent"
			            to stage = "PO received"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Internal_Admin","Internal_Coordinator"}
			                )
			            }
			            after { }
			        }
			        Start_Work as "Start Work"
			        {
			            type = normal
			            from stage = "PO received"
			            to stage = "In progress"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Internal_Admin","Internal_Coordinator"}
			                )
			            }
			            after { }
			        }
			        Complete_Work as "Complete Work"
			        {
			            type = normal
			            from stage = "In progress"
			            to stage = "Completed"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Internal_Admin","Internal_Coordinator"}
			                )
			            }
			            after { }
			        }
			        Mark_Invoiced as "Mark Invoiced"
			        {
			            type = normal
			            from stage = "Completed"
			            to stage = "Invoiced"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Internal_Admin","Internal_Coordinator"}
			                )
			            }
			            after { }
			        }
			        Close_Request as "Close Request"
			        {
			            type = normal
			            from stage = "Invoiced"
			            to stage = "Closed"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Internal_Admin","Internal_Coordinator"}
			                )
			            }
			            after { }
			        }
			    }
			}

			Submission_Action_Guidance as "Submission Action Guidance"
			{
			    type = form
			    form = Service_Request
			    record event = on add or edit
			    description = "Explains draft versus submission behavior without changing lifecycle data."
			
			    on user input of Submission_Action
			    {
			        actions ( Submission_Action == "Save as Draft" )
			        {
			            custom deluge script
			            (
			                alert "Drafts are saved without entering the matching queue.";
			            )
			        }
			        actions ( Submission_Action == "Submit Request" )
			        {
			            custom deluge script
			            (
			                alert "Submitting validates intake data and queues the request for matching.";
			            )
			        }
			    }
			}

			Validate_Edited_Service_Request as "Validate Edited Service Request"
			{
			    type = form
			    form = Service_Request
			    record event = on edit
			    description = "Validates edits and blocks unauthorized mutation of generated and lifecycle fields."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Vehicle_Count == null || input.Vehicle_Count < 1)
			                {
			                    alert(Vehicle_Count, "Vehicle count must be at least 1.");
			                    cancel submit;
			                }
			                if(input.Target_Completion_Date != null && input.Target_Completion_Date < zoho.currentdate)
			                {
			                    alert(Target_Completion_Date, "Target completion date cannot be before today.");
			                    cancel submit;
			                }
			                if(input.Submission_Action == "Submit Request" && (input.FMC_Client == null || input.Program_Name == null || input.Program_Name == "" || input.Vehicle_Count == null || input.Drop_Off_Address.address_line_1 == null || input.Requested_Capabilities == null || input.Target_Completion_Date == null))
			                {
			                    alert "Complete all required P0 intake data before submitting the request.";
			                    cancel submit;
			                }
			                app_profile = thisapp.permissions.loginUserProfile();
			                portal_profile = thisapp.portal.loginUserProfile();
			                if(portal_profile == "FMC_Client")
			                {
			                    selected_client = FMC_Client[ID == input.FMC_Client];
			                    if(selected_client.count() == 0 || selected_client.Portal_Login_Email != zoho.loginuser)
			                    {
			                        alert "The selected FMC client does not match the logged-in portal account.";
			                        cancel submit;
			                    }
			                }
			                if(app_profile != "Internal_Admin" && (old.Service_ID != input.Service_ID || old.Status != input.Status || old.Received_At != input.Received_At || old.Source != input.Source || old.Created_By_Email != input.Created_By_Email || old.Geocoding_Status != input.Geocoding_Status || old.Geocoding_Warning != input.Geocoding_Warning || old.Matching_Started_At != input.Matching_Started_At || old.Approved_Estimates_Count != input.Approved_Estimates_Count || old.Assigned_Vehicle_Count != input.Assigned_Vehicle_Count || old.Remaining_Unassigned_Vehicles != input.Remaining_Unassigned_Vehicles))
			                {
			                    alert "Generated identifiers and protected lifecycle fields cannot be changed.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Validate_New_Service_Request as "Validate New Service Request"
			{
			    type = form
			    form = Service_Request
			    record event = on add
			    description = "Validates new draft and submitted intake records and portal ownership."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Vehicle_Count == null || input.Vehicle_Count < 1)
			                {
			                    alert(Vehicle_Count, "Vehicle count must be at least 1.");
			                    cancel submit;
			                }
			                if(input.Target_Completion_Date != null && input.Target_Completion_Date < zoho.currentdate)
			                {
			                    alert(Target_Completion_Date, "Target completion date cannot be before today.");
			                    cancel submit;
			                }
			                if(input.Submission_Action == "Submit Request" && (input.FMC_Client == null || input.Program_Name == null || input.Program_Name == "" || input.Vehicle_Count == null || input.Drop_Off_Address.address_line_1 == null || input.Requested_Capabilities == null || input.Target_Completion_Date == null))
			                {
			                    alert "Complete all required P0 intake data before submitting the request.";
			                    cancel submit;
			                }
			                portal_profile = thisapp.portal.loginUserProfile();
			                if(portal_profile == "FMC_Client")
			                {
			                    selected_client = FMC_Client[ID == input.FMC_Client];
			                    if(selected_client.count() == 0 || selected_client.Portal_Login_Email != zoho.loginuser)
			                    {
			                        alert "The selected FMC client does not match the logged-in portal account.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Log_Task_Creation as "Log Task Creation"
			{
			    type = form
			    form = Task
			    record event = on add
			    description = "Writes an audit activity after a task is created."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                activity_id = insert into Activity
			                [
			                    Service_Request = input.Service_Request
			                    Related_Estimate = input.Related_Estimate
			                    Event_Timestamp = zoho.currenttime
			                    User_Email = zoho.loginuser
			                    Event_Type = "Task Created"
			                    Description = "Task " + input.Task_Type + " created with status " + input.Status + "."
			                    Internal_Only = true
			                ];
			            )
			        }
			    }
			}

			Complete_Task as "Complete Task"
			{
			    type = form
			    form = Task[Status == "Completed" && Completed_At == null]
			    record event = on add or edit
			    description = "Sets the completion timestamp the first time a task is saved as completed."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                task_record = Task[ID == input.ID];
			                task_record.Completed_At = zoho.currenttime;
			            )
			        }
			    }
			}

			Lock_Automation_Flag as "Lock Automation Flag"
			{
			    type = form
			    form = Task
			    record event = on add or edit
			    description = "Prevents users from changing the system-managed automatic creation flag."
			
			    on load
			    {
			        actions
			        {
			            disable Created_Automatically;
			        }
			    }
			}

			Log_Task_Status_Change as "Log Task Status Change"
			{
			    type = form
			    form = Task
			    record event = on edit
			    description = "Writes an audit activity when task status changes."
			
			    on update of Status
			    {
			        actions
			        {
			            custom deluge script
			            (
			                activity_id = insert into Activity
			                [
			                    Service_Request = input.Service_Request
			                    Related_Estimate = input.Related_Estimate
			                    Event_Timestamp = zoho.currenttime
			                    User_Email = zoho.loginuser
			                    Event_Type = "Task Updated"
			                    Description = "Task status changed to " + input.Status + "."
			                    Internal_Only = true
			                ];
			            )
			        }
			    }
			}

			Status_Completion_Guidance as "Status Completion Guidance"
			{
			    type = form
			    form = Task
			    record event = on add or edit
			    description = "Shows operational guidance when a task status is selected."
			
			    on user input of Status
			    {
			        actions ( Status == "Completed" )
			        {
			            custom deluge script
			            (
			                alert "Confirm the work is finished before saving. Completion time will be recorded automatically.";
			            )
			        }
			        actions ( Status == "Cancelled" )
			        {
			            custom deluge script
			            (
			                alert "Use Cancelled only when no further operational work is required; explain the reason in Description.";
			            )
			        }
			    }
			}
		}
	}

