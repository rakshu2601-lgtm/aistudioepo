			Copy_Approved_Discount as "Copy Approved Discount"
			{
			    type = form
			    form = Invoices
			    record event = on add or edit
			
			    on user input of Approved_Discount
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Discount_Amount = 0;
			                if(input.Approved_Discount != null)
			                {
			                    selected_discount = Discounts[ID == input.Approved_Discount && Approval_Status == "Approved" && Event == input.Event];
			                    if(selected_discount.ID != null)
			                    {
			                        input.Discount_Amount = selected_discount.Discount_Amount;
			                    }
			                    else
			                    {
			                        input.Approved_Discount = null;
			                        alert "Select an approved discount for this invoice's event.";
			                    }
			                }
			            )
			        }
			    }
			}

			Derive_Invoice_From_Event as "Derive Invoice From Event"
			{
			    type = form
			    form = Invoices
			    record event = on add or edit
			
			    on user input of Event
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Product = null;
			                input.Trainer = null;
			                input.Revenue_Amount = null;
			                input.Approved_Discount = null;
			                input.Discount_Amount = 0;
			                clear Approved_Discount;
			                if(input.Event != null)
			                {
			                    selected_event = Events[ID == input.Event];
			                    input.Product = selected_event.Product;
			                    input.Trainer = selected_event.Primary_Trainer;
			                    if(selected_event.Final_Revenue != null && selected_event.Final_Revenue > 0)
			                    {
			                        input.Revenue_Amount = selected_event.Final_Revenue;
			                    }
			                    else if(selected_event.Pre_Revenue != null)
			                    {
			                        input.Revenue_Amount = selected_event.Pre_Revenue;
			                    }
			                    eligible_discounts = Discounts[Approval_Status == "Approved" && Event == input.Event];
			                    Approved_Discount:ui.add(eligible_discounts.ID.getall());
			                }
			            )
			        }
			    }
			}

			Load_Invoice as "Load Invoice"
			{
			    type = form
			    form = Invoices
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Event != null)
			                {
			                    selected_event = Events[ID == input.Event];
			                    input.Product = selected_event.Product;
			                    input.Trainer = selected_event.Primary_Trainer;
			                    if(selected_event.Final_Revenue != null && selected_event.Final_Revenue > 0)
			                    {
			                        input.Revenue_Amount = selected_event.Final_Revenue;
			                    }
			                    else if(selected_event.Pre_Revenue != null)
			                    {
			                        input.Revenue_Amount = selected_event.Pre_Revenue;
			                    }
			                    clear Approved_Discount;
			                    eligible_discounts = Discounts[Approval_Status == "Approved" && Event == input.Event];
			                    Approved_Discount:ui.add(eligible_discounts.ID.getall());
			                }
			            )
			        }
			    }
			}

			Validate_Invoice as "Validate Invoice"
			{
			    type = form
			    form = Invoices
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Due_Date < input.Invoice_Date)
			                {
			                    alert(Due_Date,"Due Date must be on or after Invoice Date.");
			                    cancel submit;
			                }
			                if(input.Revenue_Amount < 0 || input.Discount_Amount < 0)
			                {
			                    alert "Revenue and discount amounts cannot be negative.";
			                    cancel submit;
			                }
			                if(input.Discount_Amount > input.Revenue_Amount)
			                {
			                    alert(Discount_Amount,"Discount Amount cannot exceed Revenue Amount.");
			                    cancel submit;
			                }
			                if(input.Conversion_Rate_To_USD == null || input.Conversion_Rate_To_USD <= 0)
			                {
			                    alert(Conversion_Rate_To_USD,"Conversion Rate To USD must be greater than zero.");
			                    cancel submit;
			                }
			                if(input.Invoice_Status == "Invoice Paid" && input.Paid_Date == null)
			                {
			                    alert(Paid_Date,"Paid Date is required when the invoice is paid.");
			                    cancel submit;
			                }
			                if(input.Approved_Discount != null)
			                {
			                    selected_discount = Discounts[ID == input.Approved_Discount];
			                    if(selected_discount.Approval_Status != "Approved" || selected_discount.Event != input.Event)
			                    {
			                        alert(Approved_Discount,"The discount must be approved and belong to the selected Event.");
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Initialize_Leave_Request as "Initialize Leave Request"
			{
			    type = form
			    form = Leave_Requests
			    record event = on add
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_member = Team_Members[Email == zoho.loginuserid];
			                is_training_manager = thisapp.permissions.isUserInProfile("Training_Manager");
			                if(current_member.ID != null)
			                {
			                    input.Team_Member = current_member.ID;
			                    input.Reporting_Manager = current_member.Reporting_Manager;
			                }
			                disable Team_Member;
			                disable Reporting_Manager;
			                if(!is_training_manager)
			                {
			                    hide Approval_Status;
			                    hide Manager_Comments;
			                    hide Decision_Date;
			                    disable Approval_Status;
			                    disable Manager_Comments;
			                    disable Decision_Date;
			                }
			            )
			        }
			    }
			}

			Load_Leave_Request_Edit as "Load Leave Request for Edit"
			{
			    type = form
			    form = Leave_Requests
			    record event = on edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                is_training_manager = thisapp.permissions.isUserInProfile("Training_Manager");
			                is_reporting_manager = input.Reporting_Manager.Email == zoho.loginuserid;
			                disable Team_Member;
			                disable Reporting_Manager;
			                if(is_training_manager || is_reporting_manager)
			                {
			                    show Approval_Status;
			                    show Manager_Comments;
			                    show Decision_Date;
			                    enable Approval_Status;
			                    enable Manager_Comments;
			                    disable Decision_Date;
			                }
			                else
			                {
			                    hide Approval_Status;
			                    hide Manager_Comments;
			                    hide Decision_Date;
			                    disable Approval_Status;
			                    disable Manager_Comments;
			                    disable Decision_Date;
			                }
			            )
			        }
			    }
			}

			Record_Leave_Decision as "Record Leave Decision"
			{
			    type = form
			    form = Leave_Requests
			    record event = on edit
			
			    on update of Approval_Status
			    {
			        actions ( Approval_Status == "Approved" || Approval_Status == "Rejected" )
			        {
			            custom deluge script
			            (
			                input.Decision_Date = zoho.currentdate;
			                insert into Audit_Log
			                [
			                    Module_Name = "Leave Requests"
			                    Record_ID = input.Request_Number.toString()
			                    Action = "Leave request " + input.Approval_Status
			                    Changed_By = zoho.loginuserid
			                    Changed_At = zoho.currenttime
			                    Before_Value = "Pending"
			                    After_Value = input.Approval_Status
			                    Notes = input.Manager_Comments
			                ];
			            )
			        }
			    }
			}

			Route_Leave_Request as "Route Leave Request"
			{
			    type = form
			    form = Leave_Requests
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                member = Team_Members[ID == input.Team_Member];
			                if(member.ID != null && input.Reporting_Manager != member.Reporting_Manager)
			                {
			                    input.Reporting_Manager = member.Reporting_Manager;
			                }
			            )
			        }
			    }
			}

			Validate_Leave_Request_Edit as "Validate Leave Request Edit"
			{
			    type = form
			    form = Leave_Requests
			    record event = on edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                is_training_manager = thisapp.permissions.isUserInProfile("Training_Manager");
			                is_requester = input.Team_Member.Email == zoho.loginuserid;
			                is_reporting_manager = input.Reporting_Manager.Email == zoho.loginuserid;
			                if(input.End_Date < input.Start_Date)
			                {
			                    alert "End Date must be on or after Start Date.";
			                    cancel submit;
			                }
			                if(!is_training_manager && !is_requester && !is_reporting_manager)
			                {
			                    alert "Only the requester, reporting manager, or Training Manager may update this request.";
			                    cancel submit;
			                }
			                if(is_requester && !is_training_manager && !is_reporting_manager && (old.Approval_Status != input.Approval_Status || old.Manager_Comments != input.Manager_Comments || old.Decision_Date != input.Decision_Date))
			                {
			                    alert "Requesters cannot change approval decision fields.";
			                    cancel submit;
			                }
			                if(is_reporting_manager && !is_training_manager && !is_requester && (old.Team_Member != input.Team_Member || old.Request_Type != input.Request_Type || old.Start_Date != input.Start_Date || old.End_Date != input.End_Date || old.Reason != input.Reason))
			                {
			                    alert "Reporting managers may change only approval decision fields.";
			                    cancel submit;
			                }
			                if(input.Approval_Status == "Rejected" && input.Manager_Comments == null)
			                {
			                    alert "Manager Comments are required when rejecting a request.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Validate_New_Leave_Request as "Validate New Leave Request"
			{
			    type = form
			    form = Leave_Requests
			    record event = on add
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                is_training_manager = thisapp.permissions.isUserInProfile("Training_Manager");
			                if(input.End_Date < input.Start_Date)
			                {
			                    alert "End Date must be on or after Start Date.";
			                    cancel submit;
			                }
			                if(!is_training_manager && input.Team_Member.Email != zoho.loginuserid)
			                {
			                    alert "You may submit a request only for yourself.";
			                    cancel submit;
			                }
			                if(!is_training_manager && input.Approval_Status != "Pending")
			                {
			                    alert "New requests must start in Pending status.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

