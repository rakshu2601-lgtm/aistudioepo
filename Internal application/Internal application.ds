	        {
	            displayname = "Event Operations"
	            icon = "business-agenda"
	            form Events { icon = "business-agenda" }
	            report Unified_Event_Summary { icon = "business-chart-bar-33" }
	            report Event_Calendar { icon = "business-agenda" }
	            report Event_Lifecycle_Board { icon = "business-hierarchy-54" }
	            report My_Assigned_Events { icon = "users-single-body" }
