	            report Incomplete_Event_Activities { icon = "files-exclamation" }
	            report Certification_Tickets { icon = "education-paper-diploma" }
	        }
	        section Performance
	        {
	            displayname = "Performance"
	            icon = "business-chart-pie-36"
	            form Event_Performance { icon = "business-chart-pie-36" }
	            report Event_Performance_Details { icon = "business-chart-bar-33" }
	            report Source_Performance { icon = "business-chart-growth" }
	            report Country_Performance { icon = "business-globe" }
	        }
	    }
	    space Team
	    {
	        displayname = "Team"
	        icon = "users-multiple-11"
	        section People
	        {
	            displayname = "People & Requests"
	            icon = "users-multiple-11"
	            form Team_Members { icon = "users-single-body" }
	            report All_Team_Members { icon = "users-multiple-19" }
	            report Active_Trainers { icon = "users-single-01" }
	            report Active_Mentors { icon = "users-network" }
	            form Leave_Requests { icon = "business-agenda" }
	            report My_Leave_Requests { icon = "files-user" }
	            report Pending_Leave_Approvals { icon = "loader-dots-06" }
	            report Approved_Leave_WFH { icon = "files-check" }
	            report All_Leave_Requests { icon = "files-paper" }
	        }
	    }
	    space Tasks
	    {
	        displayname = "Tasks"
	        icon = "design-todo"
	        form Tasks { icon = "design-todo" }
	        report My_Assigned_Tasks { icon = "files-user" }
	        report Task_Board { icon = "business-hierarchy-53" }
	        report Tasks_Requiring_Attention { icon = "files-exclamation" }
	        report Trainer_Tasks { icon = "users-single-01" }
	        report Mentor_Tasks { icon = "users-network" }
	        report All_Tasks { icon = "design-bullet-list-67" }
	    }
	    space Finance
	    {
	        displayname = "Finance"
	        icon = "business-briefcase-24"
	        section Finance_Dashboards
	        {
	            displayname = "Dashboard"
	            icon = "business-chart-growth"
	            page Finance_Dashboard { icon = "business-money-time" }
	        }
	        section Discounts
	        {
	            displayname = "Discounts"
	            icon = "shopping-discount"
	            form Discounts { icon = "shopping-discount" }
	            report Pending_Discount_Approvals { icon = "loader-dots-06" }
	            report Approved_Discounts { icon = "business-award-48" }
	            report All_Discounts { icon = "shopping-tag" }
	        }
	        section Invoicing
	        {
	            displayname = "Invoices"
	            icon = "shopping-receipt"
