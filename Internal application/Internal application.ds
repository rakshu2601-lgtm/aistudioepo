	reports
	{
		default list Audit_History
		{
		    displayName = "Audit History"
		    show all rows from Audit_Log
		    (
		        Audit_ID
		        Module_Name
		        Record_ID
		        Action
		        Changed_By
		        Changed_At
		        Before_Value
		        After_Value
		        Notes
		    )
		    filters
		    (
		        Module_Name
		        Action
		    )
		    sort by
		    (
		        Changed_At descending
		    )
		}

		default list All_Discounts
		{
		    displayName = "All Discounts"
		    show all rows from Discounts
		    (
		        Discount_ID
		        Event
		        Product
		        Requested_By
		        Discount_Type
		        Discount_Count
		        Gross_Revenue
		        Discount_Percentage
		        Discount_Amount
		        Discounted_Revenue
		        Approval_Status
		        Approved_By
		        Approval_Date
		        Approval_Comments
		    )
		    filters
		    (
		        Event
		        Product
		        Discount_Type
		        Approval_Status
		    )
		    sort by
		    (
		        Discount_ID descending
		    )
		}

		list Approved_Discounts
		{
		    displayName = "Approved Discounts"
		    show all rows from Discounts [Approval_Status == "Approved"]
		    (
		        Discount_ID
		        Event
		        Product
		        Requested_By
		        Discount_Type
		        Discount_Count
		        Gross_Revenue
		        Discount_Percentage
		        Discount_Amount
		        Discounted_Revenue
		        Approval_Status
		        Approved_By
		        Approval_Date
		        Approval_Comments
		    )
		    filters
		    (
		        Event
		        Product
		        Discount_Type
		        Approved_By
		        Approval_Date
		    )
		    sort by
		    (
		        Approval_Date descending
		    )
		}

		list Pending_Discount_Approvals
		{
		    displayName = "Pending Discount Approvals"
		    show all rows from Discounts [Approval_Status == "Pending"]
		    (
		        Discount_ID
		        Event
		        Product
		        Requested_By
		        Discount_Type
		        Discount_Count
		        Gross_Revenue
		        Discount_Percentage
		        Discount_Amount
		        Discounted_Revenue
		        Approval_Status
		        Approval_Comments
		    )
		    filters
		    (
		        Event
		        Product
		        Discount_Type
		        Requested_By
		    )
		    sort by
		    (
		        Discount_ID ascending
		    )
		}

		list Country_Performance
		{
		    displayName = "Country Performance"
		    show all rows from Event_Performance [Dimension_Type == "Country"]
		    (
		        Event
		        Dimension_Type
		        Dimension_Value
		        Registrations
		        Attendees
		        Notes
		    )
		    filters
		    (
		        Event
		        Dimension_Value
		    )
		    sort by
		    (
		        Dimension_Value ascending
		    )
		}

		default list Event_Performance_Details
		{
		    displayName = "Event Performance Details"
		    show all rows from Event_Performance
		    (
		        Event
		        Dimension_Type
		        Dimension_Value
		        Registrations
		        Attendees
		        Notes
		    )
		    filters
		    (
		        Event
		        Dimension_Type
		        Dimension_Value
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Event ascending
		        Dimension_Type ascending
		    )
		    sort by
		    (
		        Dimension_Value ascending
		    )
		}

		list Source_Performance
		{
		    displayName = "Source Performance"
		    show all rows from Event_Performance [Dimension_Type == "Source"]
		    (
		        Event
		        Dimension_Type
		        Dimension_Value
		        Registrations
		        Attendees
		        Notes
		    )
		    filters
		    (
		        Event
		        Dimension_Value
		    )
		    sort by
		    (
		        Dimension_Value ascending
		    )
		}

		list Certification_Tickets
		{
		    displayName = "Certification Tickets"
		    show all rows from Events [Event_Type == "Certification"]
		    (
		        Event_ID
		        Event_Title
		        Product
		        Region
		        Start_Date_Time
		        End_Date_Time
		        Primary_Trainer
		        Lifecycle_Stage
		        Event_Status
		        Ticket_ID
		        Ticket_Status
		        Ticket_Owner
		        Ticket_Closure_Notes
		    )
		    filters
		    (
		        Product
		        Region
		        Primary_Trainer
		        Lifecycle_Stage
		        Ticket_Status
		        Ticket_Owner
		    )
		    sort by
		    (
		        Start_Date_Time ascending
		    )
		    conditional formatting
		    (
		        "Open Past Event"
		        {
		            condition = (End_Date_Time < zoho.currenttime && Ticket_Status != "Closed")
		            fields = [Event_Title, Ticket_ID, Ticket_Status, Ticket_Owner]
		            format = "background-color:#FFE0E0;color:#A00000;font-weight:bold"
		        }
		        "Closed"
		        {
		            condition = (Ticket_Status == "Closed")
		            fields = [Event_Title, Ticket_ID, Ticket_Status]
		            format = "background-color:#E2F7E8;color:#146C2E"
		        }
		    )
		}

		calendar Event_Calendar
		{
		    displayName = "Event Calendar"
		    show all rows from Events [Event_Status != "Cancelled"]
		    (
		        Event_Title
		        Event_Type
		        Product
		        Region
		        Primary_Trainer
		        Lifecycle_Stage
		        Event_Status
		        Start_Date_Time
		        End_Date_Time
		    )
		    filters
		    (
		        Product
		        Region
		        Primary_Trainer
		        Event_Type
		        Lifecycle_Stage
		    )
		    options
		    (
		        display type = month
		        week start day = monday
		        display field = Event_Title
		        start date = Start_Date_Time
		        end date = End_Date_Time
		        default date
		        (
		            day = Today
		            month = Currentmonth
		            year = Currentyear
		        )
		    )
		    conditional formatting
		    (
		        "Completed"
		        {
		            condition = (Lifecycle_Stage == "Completed")
		            fields = [Event_Title, Lifecycle_Stage]
		            format = "background-color:#E2F7E8;color:#146C2E"
		        }
		    )
		}

		kanban Event_Lifecycle_Board
		{
		    displayName = "Event Lifecycle Board"
		    show all rows from Events
		    (
		        Event_Title
		        Event_Type
		        Product
		        Region
		        Primary_Trainer
		        Start_Date_Time
		        End_Date_Time
		        Lifecycle_Stage
		        Event_Status
		        Readiness_Status
		    )
		    filters
		    (
		        Product
		        Region
		        Primary_Trainer
		        Event_Type
		        Event_Status
		    )
		    sort by
		    (
		        Start_Date_Time ascending
		    )
		    options
		    (
		        display field = Lifecycle_Stage
		        filter type = manual
		        sort order = custom
		        record count = enable
		    )
		}

		list Incomplete_Event_Activities
		{
		    displayName = "Incomplete Event Activities"
		    show all rows from Events [Event_Status != "Cancelled" && Lifecycle_Stage != "Completed" && (Readiness_Status != "Ready" || General_Document_URL is null || Presentation_URL is null || (Event_Type == "Webinar" && (Social_Media_URL is null || Connect_Post_URL is null || Email_Invite_URL is null || Cliq_Message_URL is null)) || (Lifecycle_Stage == "Post-Event" && (Recording_URL is null || Upload_Status != "Uploaded")) || (Event_Type == "Certification" && Ticket_Status != "Closed"))]
		    (
		        Event_ID
		        Event_Title
		        Event_Type
		        Product
		        Primary_Trainer
		        End_Date_Time
		        Lifecycle_Stage
		        Event_Status
		        Readiness_Status
		        General_Document_URL
		        Presentation_URL
		        Recording_URL
		        Upload_Status
		        Ticket_Status
		        Missing_Activity_Notes
		    )
		    filters
		    (
		        Event_Type
		        Product
		        Primary_Trainer
		        Lifecycle_Stage
		        Readiness_Status
		    )
		    sort by
		    (
		        End_Date_Time ascending
		    )
		    conditional formatting
		    (
		        "Overdue Incomplete"
		        {
		            condition = (End_Date_Time < zoho.currenttime)
		            fields = [Event_Title, End_Date_Time, Lifecycle_Stage, Readiness_Status, Upload_Status, Ticket_Status]
		            format = "background-color:#FFE0E0;color:#A00000;font-weight:bold"
		        }
		        "Incomplete"
		        {
		            condition = (End_Date_Time >= zoho.currenttime)
		            fields = [Event_Title, Readiness_Status, Upload_Status, Ticket_Status]
		            format = "background-color:#FFF4D6;color:#8A5200"
		        }
		    )
		}

		list My_Assigned_Events
		{
		    displayName = "My Assigned Events"
		    show all rows from Events [Primary_Trainer.Email == zoho.loginuserid || Additional_Trainers.Email == zoho.loginuserid || QA_Trainer.Email == zoho.loginuserid]
		    (
		        Event_ID
		        Event_Title
		        Event_Type
		        Product
		        Region
		        Start_Date_Time
		        End_Date_Time
		        Primary_Trainer
		        Additional_Trainers
		        QA_Trainer
		        Lifecycle_Stage
		        Event_Status
		    )
		    filters
		    (
		        Product
		        Region
		        Lifecycle_Stage
		        Event_Type
		    )
		    sort by
		    (
		        Start_Date_Time ascending
		    )
		}

		default list Unified_Event_Summary
		{
		    displayName = "Unified Event Summary"
		    show all rows from Events
		    (
		        Event_ID
		        Event_Title
		        Event_Type
		        Product
		        Region
		        Start_Date_Time
		        End_Date_Time
		        Primary_Trainer
		        Lifecycle_Stage
		        Event_Status
		        Readiness_Status
		    )
		    filters
		    (
		        Product
		        Region
		        Primary_Trainer
		        Lifecycle_Stage
		        Event_Type
		    )
		    sort by
		    (
		        Start_Date_Time ascending
		    )
		    conditional formatting
		    (
		        "Overdue Incomplete"
		        {
		            condition = (End_Date_Time < zoho.currenttime && Lifecycle_Stage != "Completed" && Event_Status != "Cancelled")
		            fields = [Event_Title, End_Date_Time, Lifecycle_Stage, Event_Status]
		            format = "background-color:#FFE0E0;color:#A00000;font-weight:bold"
		        }
		        "Cancelled"
		        {
		            condition = (Event_Status == "Cancelled")
		            fields = [Event_Title, Event_Status]
		            format = "background-color:#F0F0F0;color:#666666;text-decoration:line-through"
		        }
		        "Completed"
		        {
		            condition = (Lifecycle_Stage == "Completed")
		            fields = [Event_Title, Lifecycle_Stage, Event_Status]
		            format = "background-color:#E2F7E8;color:#146C2E"
		        }
		    )
		}

		list Upcoming_Events
		{
		    displayName = "Upcoming Events"
		    show all rows from Events [Start_Date_Time >= zoho.currenttime && Event_Status != "Cancelled" && Lifecycle_Stage != "Completed"]
		    (
		        Event_ID
		        Event_Title
		        Event_Type
		        Product
		        Region
		        Start_Date_Time
		        End_Date_Time
		        Primary_Trainer
		        Readiness_Status
		        Event_Status
		    )
		    filters
		    (
		        Product
		        Region
		        Primary_Trainer
		        Event_Type
		        Readiness_Status
		    )
		    sort by
		    (
		        Start_Date_Time ascending
		    )
		    conditional formatting
		    (
		        "Not Ready"
		        {
		            condition = (Readiness_Status != "Ready")
		            fields = [Event_Title, Start_Date_Time, Readiness_Status]
		            format = "background-color:#FFF4D6;color:#8A5200;font-weight:bold"
		        }
		    )
		}

		default list All_Invoices
		{
		    displayName = "All Invoices"
		    show all rows from Invoices
		    (
		        Invoice_Number
		        Event
		        Product
		        Trainer
		        Customer_Name
		        Invoice_Date
		        Due_Date
		        Revenue_Amount
		        Discount_Amount
		        Invoice_Total
		        Source_Currency
		        Conversion_Rate_To_USD
		        Invoice_Total_USD
		        Exchange_Rate_Status
		        Invoice_Status
		        Paid_Date
		    )
		    filters
		    (
		        Product
		        Trainer
		        Source_Currency
		        Exchange_Rate_Status
		        Invoice_Status
		        Invoice_Date
		        Due_Date
		    )
		    sort by
		    (
		        Invoice_Date descending
		    )
		}

		list Outstanding_Invoices
		{
		    displayName = "Outstanding Invoices"
		    show all rows from Invoices [Invoice_Status != "Invoice Paid" && Invoice_Status != "Cancelled"]
		    (
		        Invoice_Number
		        Event
		        Product
		        Trainer
		        Customer_Name
		        Due_Date
		        Invoice_Total_USD
		        Exchange_Rate_Status
		        Invoice_Status
		        Payment_Link
		    )
		    filters
		    (
		        Product
		        Trainer
		        Due_Date
		        Exchange_Rate_Status
		        Invoice_Status
		    )
		    sort by
		    (
		        Due_Date ascending
		    )
		}

		list Overdue_Invoices
		{
		    displayName = "Overdue Invoices"
		    show all rows from Invoices [Invoice_Status == "Invoice Overdue"]
		    (
		        Invoice_Number
		        Event
		        Product
		        Trainer
		        Customer_Name
		        Due_Date
		        Invoice_Total_USD
		        Source_Currency
		        Exchange_Rate_Status
		        Invoice_Status
		    )
		    filters
		    (
		        Product
		        Trainer
		        Due_Date
		        Source_Currency
		        Exchange_Rate_Status
		        Invoice_Status
		    )
		    sort by
		    (
		        Due_Date ascending
		    )
		}

		list Paid_Invoices
		{
		    displayName = "Paid Invoices"
		    show all rows from Invoices [Invoice_Status == "Invoice Paid"]
		    (
		        Invoice_Number
		        Event
		        Product
		        Trainer
		        Customer_Name
		        Invoice_Date
		        Paid_Date
		        Invoice_Total_USD
		        Source_Currency
		        Exchange_Rate_Status
		        Invoice_Status
		    )
		    filters
		    (
		        Product
		        Trainer
		        Invoice_Date
		        Paid_Date
		        Source_Currency
		        Exchange_Rate_Status
		        Invoice_Status
		    )
		    sort by
		    (
		        Paid_Date descending
		    )
		}

		default list All_Leave_Requests
		{
		    displayName = "All Leave Requests"
		    show all rows from Leave_Requests
		    (
		        Request_Number
		        Team_Member
		        Request_Type
		        Start_Date
		        End_Date
		        Reason
		        Reporting_Manager
		        Approval_Status
		        Manager_Comments
		        Decision_Date
		    )
		    filters
		    (
		        Request_Type
		        Start_Date
		        End_Date
		        Approval_Status
		    )
		    sort by
		    (
		        Start_Date descending
		    )
		}

		calendar Approved_Leave_WFH
		{
		    displayName = "Approved Leave & WFH"
		    show all rows from Leave_Requests [Approval_Status == "Approved"]
		    (
		        Request_Number
		        Team_Member
		        Request_Type
		        Start_Date
		        End_Date
		        Reporting_Manager
		        Approval_Status
		    )
		    filters
		    (
		        Request_Type
		        Start_Date
		        End_Date
		        Approval_Status
		    )
		    options
		    (
		        display type = month
		        week start day = monday
		        display field = Team_Member
		        start date = Start_Date
		        end date = End_Date
		        default date
		        (
		            day = Today
		            month = Currentmonth
		            year = Currentyear
		        )
		    )
		}

		list My_Leave_Requests
		{
		    displayName = "My Leave Requests"
		    show all rows from Leave_Requests [Team_Member.Email == zoho.loginuserid]
		    (
		        Request_Number
		        Team_Member
		        Request_Type
		        Start_Date
		        End_Date
		        Reason
		        Approval_Status
		        Manager_Comments
		        Decision_Date
		    )
		    filters
		    (
		        Request_Type
		        Start_Date
		        End_Date
		        Approval_Status
		    )
		    sort by
		    (
		        Start_Date descending
		    )
		}

		list Pending_Leave_Approvals
		{
		    displayName = "Pending Leave Approvals"
		    show all rows from Leave_Requests [Approval_Status == "Pending"]
		    (
		        Request_Number
		        Team_Member
		        Request_Type
		        Start_Date
		        End_Date
		        Reason
		        Reporting_Manager
		        Approval_Status
		        Manager_Comments
		    )
		    filters
		    (
		        Request_Type
		        Start_Date
		        End_Date
		        Approval_Status
		    )
		    sort by
		    (
		        Start_Date ascending
		    )
		}

		list Active_Products
		{
		    displayName = "Active Products"
		    show all rows from Products [Active == true]
		    (
		        Product_Code
		        Product_Name
		        Product_Owner
		        Active
		        Notes
		    )
		    sort by
		    (
		        Product_Name ascending
		    )
		}

		default list All_Products
		{
		    displayName = "All Products"
		    show all rows from Products
		    (
		        Product_Code
		        Product_Name
		        Product_Owner
		        Active
		        Notes
		    )
		    filters
		    (
		        Active
		    )
		    sort by
		    (
		        Product_Name ascending
		    )
		}

		default list All_Tasks
		{
		    displayName = "All Tasks"
