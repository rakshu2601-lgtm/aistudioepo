	            report Outstanding_Invoices { icon = "business-money-time" }
	            report Overdue_Invoices { icon = "files-exclamation" }
	            report Paid_Invoices { icon = "files-money" }
	            report All_Invoices { icon = "shopping-receipt-list-43" }
	        }
	    }
	    space Administration
	    {
	        displayname = "Administration"
	        icon = "design-app"
	        section Masters
	        {
	            displayname = "Master Data"
	            icon = "objects-puzzle-09"
	            form Products { icon = "shopping-box" }
	            report All_Products { icon = "files-paper" }
	            report Active_Products { icon = "files-check" }
	            form Audit_Log { icon = "files-locked" }
	            report Audit_History { icon = "files-time" }
	        }
	    }
	    preference
	    {
	        icon
	        {
	            style = outline
	            show = {space,section,component}
	        }
	    }
	}
	customize
	{
	    layout
	    {
	        theme = "theme_2"
	        variant = "variant_2"
	    }
	    font = "lato"
	    color options
	    {
	        name = "Operations Blue Teal"
	        brand color = "#176B87"
	        type = "custom"
	        dark mode color = "#0E7490"
	    }
	    logo
	    {
	        preference = "app_icon"
	        placement = "left"
	    }
	    custom css
	    {
	        content = "body { color: #17324D; font-family: Lato, sans-serif; } .zc-app-header { background: #176B87; }"
	    }
	}
	}

