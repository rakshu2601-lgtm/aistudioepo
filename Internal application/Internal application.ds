	menu
	{
	    space Overview
	    {
	        displayname = "Overview"
	        icon = "business-chart-bar-33"
	        section Dashboards
	        {
	            displayname = "Dashboards"
	            icon = "business-chart-pie-36"
	            page Operations_Dashboard { icon = "business-chart-bar-33" }
	            page Metrics_Dashboard { icon = "business-chart-pie-36" }
	            page Trainer_Dashboard { icon = "users-multiple-11" }
	            page Leave_Task_Dashboard { icon = "design-todo" }
	            page Manager_Dashboard { icon = "business-briefcase-24" }
	        }
	        section SharedAnalytics_Section
	        {
	            type = shared_user_report_section
	            displayname = "Reports"
	            icon = "business-chart-bar-33"
	        }
	    }
	    space Events
	    {
	        displayname = "Events"
	        icon = "business-agenda"
