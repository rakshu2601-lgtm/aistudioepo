		    (
		        type = textarea
		        displayname = "Reason"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Approval
		    (
		        type = section
		        displayname = "Approval"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Reporting_Manager
		    (
		        type = picklist
		        displayname = "Reporting Manager"
		        values = Team_Members.ID
		        displayformat = [Employee_Name.first_name]
		        searchable = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Approval_Status
		    (
		        type = picklist
		        displayname = "Approval Status"
		        values = {"Pending","Approved","Rejected"}
		        initial value = "Pending"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Manager_Comments
		    (
		        type = textarea
		        displayname = "Manager Comments"
		        height = 100px
		        row = 2
		        column = 1
		        width = medium
		    )
		    Decision_Date
		    (
		        type = date
		        displayname = "Decision Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit Request"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Request"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
		    blueprint components
		    {
		        stages = {"Pending","Approved","Rejected"}
		    }
		}

