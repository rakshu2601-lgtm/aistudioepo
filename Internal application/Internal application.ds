	web
	{
	forms
	{
	    form Team_Members { label placement = top }
	    form Leave_Requests { label placement = top }
	    form Products { label placement = top }
	    form Events { label placement = top }
	    form Event_Performance { label placement = top }
	    form Tasks { label placement = top }
	    form Discounts { label placement = top }
	    form Invoices { label placement = top }
	    form Audit_Log { label placement = top }
	}
	reports
	{
		report Audit_History { quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( Audit_ID Module_Name Record_ID Action Changed_By Changed_At ) ) ) menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) ) action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) ) ) detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Audit_ID Module_Name Record_ID Action Changed_By Changed_At Before_Value After_Value Notes ) ) ) menu ( header ( Edit Duplicate Delete ) ) ) }
	
		report All_Discounts { quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( Discount_ID Event Product Requested_By Discount_Amount Approval_Status ) ) ) menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) ) action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) ) ) detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Discount_ID Event Product Requested_By Discount_Type Discount_Count Gross_Revenue Discount_Percentage Discount_Amount Discounted_Revenue Approval_Status Approved_By Approval_Date Approval_Comments ) ) ) menu ( header ( Edit Duplicate Delete ) ) ) }
	
