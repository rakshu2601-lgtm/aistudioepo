		schedule
		{
			Mark_Invoice_Overdue as "Mark Invoice Overdue"
			{
			    type = schedule
			    form = Invoices[Invoice_Status != "Invoice Paid" && Invoice_Status != "Cancelled"]
			    start = after 1 days from Due_Date at "00:05:00"
			    time zone = "UTC"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                if(input.Due_Date < zoho.currentdate && input.Invoice_Status != "Invoice Paid" && input.Invoice_Status != "Cancelled")
			                {
			                    input.Invoice_Status = "Invoice Overdue";
			                    insert into Audit_Log
			                    [
			                        Module_Name = "Invoices"
			                        Record_ID = input.Invoice_Number.toString()
			                        Action = "Invoice marked overdue"
			                        Changed_By = zoho.loginuserid
			                        Changed_At = zoho.currenttime
			                        After_Value = "Invoice Overdue"
			                        Notes = "Automatically marked overdue after Due Date"
			                    ];
			                }
			            )
			        }
			    }
			}
		}

		blueprint
		{
			Discount_Approval as "Discount Approval"
			{
			    type = blueprint
			    form = Discounts
			
			    start
			    {
			        start stage = "Pending"
			    }
			
			    stages
			    {
			        "Pending"
			        {
			        }
			        "Approved"
			        {
			        }
			        "Rejected"
			        {
			        }
			    }
			
			    transitions
			    {
			        Approve as "Approve"
			        {
			            type = normal
			            from stage = "Pending"
			            to stage = "Approved"
			
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Lead"}
			                )
			                tooltip message = "Approve this discount"
			            }
			
			
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        current_member = Team_Members[Email == zoho.loginuserid];
			                        if(current_member.ID != null)
			                        {
			                            input.Approved_By = current_member.ID;
			                        }
			                        input.Approval_Date = zoho.currentdate;
			                        insert into Audit_Log
			                        [
			                            Module_Name = "Discounts"
			                            Record_ID = input.Discount_ID.toString()
			                            Action = "Discount Approved"
			                            Changed_By = zoho.loginuserid
			                            Changed_At = zoho.currenttime
			                            Before_Value = "Pending"
			                            After_Value = "Approved"
			                            Notes = input.Approval_Comments
			                        ];
			                    )
			                }
			            }
			        }
			
			        Reject as "Reject"
			        {
			            type = normal
			            from stage = "Pending"
			            to stage = "Rejected"
			
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Lead"}
			                )
			                tooltip message = "Reject this discount with comments"
			            }
			
			
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        current_member = Team_Members[Email == zoho.loginuserid];
			                        if(current_member.ID != null)
			                        {
			                            input.Approved_By = current_member.ID;
			                        }
			                        input.Approval_Date = zoho.currentdate;
			                        insert into Audit_Log
			                        [
			                            Module_Name = "Discounts"
			                            Record_ID = input.Discount_ID.toString()
			                            Action = "Discount Rejected"
			                            Changed_By = zoho.loginuserid
			                            Changed_At = zoho.currenttime
			                            Before_Value = "Pending"
			                            After_Value = "Rejected"
			                            Notes = input.Approval_Comments
			                        ];
			                    )
			                }
			            }
			        }
			    }
			}

			Event_Lifecycle as "Event Lifecycle"
			{
			    type = blueprint
			    form = Events
			
			    start
			    {
			        start stage = "Pre-Event"
			    }
			    stages
			    {
			        "Pre-Event" { }
			        "During Event" { }
			        "Post-Event" { }
			        "Completed" { }
			    }
			    transitions
			    {
			        Start_Event as "Start Event"
			        {
			            type = normal
			            from stage = "Pre-Event"
			            to stage = "During Event"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Trainer","Training_Manager"}
			                )
			                transition criteria = ( Event_Status == "Ready" )
			            }
			            after { }
			        }
			        Move_To_Closure as "Move to Closure"
			        {
			            type = normal
			            from stage = "During Event"
			            to stage = "Post-Event"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Trainer","Training_Manager"}
			                )
			            }
			            after { }
			        }
			        Complete_Event as "Complete Event"
			        {
			            type = normal
			            from stage = "Post-Event"
			            to stage = "Completed"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Trainer","Training_Manager"}
			                )
			                confirmation before execution
			                (
			                    message = "Confirm that all closure activities are complete."
			                    confirm button text = "Complete"
			                    cancel button text = "Cancel"
			                )
			            }
			            after { }
			        }
