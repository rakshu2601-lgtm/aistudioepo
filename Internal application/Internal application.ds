		    (
		        Task_ID
		        Task_Title
		        Assignee_Type
		        Assigned_To
		        Priority
		        Due_Date
		        Status
		        Completion_Date
		    )
		    filters
		    (
		        Assignee_Type
		        Assigned_To
		        Priority
		        Due_Date
		        Status
		    )
		    sort by
		    (
		        Due_Date ascending
		    )
		}

		list Mentor_Tasks
		{
		    displayName = "Mentor Tasks"
		    show all rows from Tasks [Assignee_Type == "Mentor"]
		    (
		        Task_ID
		        Task_Title
		        Assigned_To
		        Priority
		        Due_Date
		        Status
		    )
		    filters
		    (
		        Assigned_To
		        Priority
		        Due_Date
		        Status
		    )
		    sort by
		    (
		        Due_Date ascending
		    )
		}

		list My_Assigned_Tasks
		{
		    displayName = "My Assigned Tasks"
		    show all rows from Tasks [Assigned_To.Email == zoho.loginuserid]
		    (
		        Task_ID
		        Task_Title
		        Assignee_Type
		        Assigned_To
		        Priority
		        Due_Date
		        Status
		    )
		    filters
		    (
		        Priority
		        Due_Date
		        Status
		    )
		    sort by
		    (
		        Due_Date ascending
		    )
		}

		kanban Task_Board
		{
		    displayName = "Task Board"
		    show all rows from Tasks
		    (
		        Task_ID
		        Task_Title
		        Assigned_To
		        Priority
		        Due_Date
		        Status
		    )
		    filters
		    (
		        Assigned_To
		        Priority
		        Due_Date
		        Status
		    )
		    sort by
		    (
		        Due_Date ascending
		    )
		    options
		    (
		        display field = Status
		        filter type = manual
		        sort order = custom
		        record count = enable
		    )
		}

		list Tasks_Requiring_Attention
		{
		    displayName = "Tasks Requiring Attention"
		    show all rows from Tasks [(Due_Date < zoho.currentdate && Status != "Completed" && Status != "Cancelled") || Status == "Blocked" || Priority == "Critical"]
		    (
		        Task_ID
		        Task_Title
		        Assigned_To
		        Priority
		        Due_Date
		        Status
		        Issue_Blocker
		    )
		    filters
		    (
		        Assigned_To
		        Priority
		        Due_Date
		        Status
		    )
		    sort by
		    (
		        Due_Date ascending
		    )
		}

		list Trainer_Tasks
		{
		    displayName = "Trainer Tasks"
		    show all rows from Tasks [Assignee_Type == "Trainer"]
		    (
		        Task_ID
		        Task_Title
		        Assigned_To
		        Priority
		        Due_Date
		        Status
		    )
		    filters
		    (
		        Assigned_To
		        Priority
		        Due_Date
		        Status
		    )
		    sort by
		    (
		        Due_Date ascending
		    )
		}

		list Active_Mentors
		{
		    displayName = "Active Mentors"
		    show all rows from Team_Members [Active == true && Member_Type == "Mentor"]
		    (
		        Employee_ID
		        Employee_Name
		        Email
		        Member_Type
		        Reporting_Manager
		        Active
		    )
		    filters
		    (
		        Member_Type
		        Active
		    )
		    sort by
		    (
		        Employee_Name ascending
		    )
		}

		list Active_Trainers
		{
		    displayName = "Active Trainers"
		    show all rows from Team_Members [Active == true && Member_Type == "Trainer"]
		    (
		        Employee_ID
		        Employee_Name
		        Email
		        Member_Type
		        Reporting_Manager
		        Active
		    )
		    filters
		    (
		        Member_Type
		        Active
		    )
		    sort by
		    (
		        Employee_Name ascending
		    )
		}

		default list All_Team_Members
		{
		    displayName = "All Team Members"
		    show all rows from Team_Members
		    (
		        Employee_ID
		        Employee_Name
		        Email
		        Member_Type
		        Reporting_Manager
		        Active
		    )
		    filters
		    (
		        Member_Type
		        Active
		        "Active Members" : (Active == true)
		    )
		    sort by
		    (
		        Employee_Name ascending
		    )
		}
	}

	pages
	{
		page Finance_Dashboard
		{
					displayname = "Finance Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Finance_Overview' elementName='Finance_Overview'>\n\t\t\t\t\t<![CDATA[htmlpage Finance_Overview()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\tmemberType = &quot;&quot;;\n\tmemberRows = Team_Members[Email == zoho.loginuserid];\n\tif(memberRows.count() &gt; 0)\n\t{\n\t\tmemberType = memberRows.Member_Type;\n\t}\n\tisTrainer = memberType == &quot;Trainer&quot;;\n\tif(isTrainer)\n\t{\n\t\tdiscountSet = Discounts[Requested_By.Email == zoho.loginuserid];\n\t\tpendingSet = Discounts[Approval_Status == &quot;Pending&quot; &amp;&amp; Requested_By.Email == zoho.loginuserid];\n\t\tapprovedSet = Discounts[Approval_Status == &quot;Approved&quot; &amp;&amp; Requested_By.Email == zoho.loginuserid];\n\t\tinvoiceSet = Invoices[Trainer.Email == zoho.loginuserid];\n\t\toutstandingSet = Invoices[Invoice_Status != &quot;Invoice Paid&quot; &amp;&amp; Invoice_Status != &quot;Cancelled&quot; &amp;&amp; Trainer.Email == zoho.loginuserid];\n\t\toverdueSet = Invoices[Invoice_Status == &quot;Invoice Overdue&quot; &amp;&amp; Trainer.Email == zoho.loginuserid];\n\t}\n\telse\n\t{\n\t\tdiscountSet = Discounts[ID != 0];\n\t\tpendingSet = Discounts[Approval_Status == &quot;Pending&quot;];\n\t\tapprovedSet = Discounts[Approval_Status == &quot;Approved&quot;];\n\t\tinvoiceSet = Invoices[ID != 0];\n\t\toutstandingSet = Invoices[Invoice_Status != &quot;Invoice Paid&quot; &amp;&amp; Invoice_Status != &quot;Cancelled&quot;];\n\t\toverdueSet = Invoices[Invoice_Status == &quot;Invoice Overdue&quot;];\n\t}\n\tpendingCount = pendingSet.count();\n\tapprovedValue = approvedSet.sum(Discount_Amount);\n\toutstandingValue = outstandingSet.sum(Invoice_Total_USD);\n\toverdueCount = overdueSet.count();\n\tif(approvedValue == null) { approvedValue = 0; }\n\tif(outstandingValue == null) { outstandingValue = 0; }\n\tgeneratedCount = 0;\n\tlinkSentCount = 0;\n\tpaidCount = 0;\n\tcancelledCount = 0;\n\tpendingRateCount = 0;\n\tappliedRateCount = 0;\n\tmanualRateCount = 0;\n\tfailedRateCount = 0;\n\tfor each invoiceRecord in invoiceSet\n\t{\n\t\tif(invoiceRecord.Invoice_Status == &quot;Invoice Generated&quot;) { generatedCount = generatedCount + 1; }\n\t\tif(invoiceRecord.Invoice_Status == &quot;Payment Link Sent&quot;) { linkSentCount = linkSentCount + 1; }\n\t\tif(invoiceRecord.Invoice_Status == &quot;Invoice Paid&quot;) { paidCount = paidCount + 1; }\n\t\tif(invoiceRecord.Invoice_Status == &quot;Cancelled&quot;) { cancelledCount = cancelledCount + 1; }\n\t\tif(invoiceRecord.Exchange_Rate_Status == &quot;Pending API Rate&quot;) { pendingRateCount = pendingRateCount + 1; }\n\t\tif(invoiceRecord.Exchange_Rate_Status == &quot;Rate Applied&quot;) { appliedRateCount = appliedRateCount + 1; }\n\t\tif(invoiceRecord.Exchange_Rate_Status == &quot;Manual Override&quot;) { manualRateCount = manualRateCount + 1; }\n\t\tif(invoiceRecord.Exchange_Rate_Status == &quot;Failed&quot;) { failedRateCount = failedRateCount + 1; }\n\t}\n\tinvoiceCount = invoiceSet.count();\n\tif(invoiceCount == 0) { invoiceCount = 1; }\n\tgeneratedPct = generatedCount * 100 / invoiceCount;\n\tlinkSentPct = linkSentCount * 100 / invoiceCount;\n\tpaidPct = paidCount * 100 / invoiceCount;\n\toverduePct = overdueCount * 100 / invoiceCount;\n\tpartnerCount = 0;\n\tcustomerCount = 0;\n\tprospectCount = 0;\n\totherCount = 0;\n\tfor each discountRecord in discountSet\n\t{\n\t\tif(discountRecord.Discount_Type == &quot;Partner&quot;) { partnerCount = partnerCount + 1; }\n\t\tif(discountRecord.Discount_Type == &quot;Customer&quot;) { customerCount = customerCount + 1; }\n\t\tif(discountRecord.Discount_Type == &quot;Prospect&quot;) { prospectCount = prospectCount + 1; }\n\t\tif(discountRecord.Discount_Type == &quot;Other&quot;) { otherCount = otherCount + 1; }\n\t}\n\tdiscountMax = partnerCount;\n\tif(customerCount &gt; discountMax) { discountMax = customerCount; }\n\tif(prospectCount &gt; discountMax) { discountMax = prospectCount; }\n\tif(otherCount &gt; discountMax) { discountMax = otherCount; }\n\tif(discountMax == 0) { discountMax = 1; }\n%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;--zcs-thead-color:#F9FAFE;--donut-cx:70px;--donut-cy:70px;--donut-r:54;--donut-stroke_width:16;--donut-pi:3.14;--donut-a1:&lt;%=generatedPct%&gt;;--donut-a2:&lt;%=linkSentPct%&gt;;--donut-a3:&lt;%=overduePct%&gt;;--donut-a4:&lt;%=paidPct%&gt;}\n*{box-sizing:border-box}.zcs-w-full{width:100%}.zcs-flex{display:flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-gap-20{gap:20px}.zcs-gap-24{gap:24px}.zcs-p-0{padding:0}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-p-24{padding:24px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-12{padding-top:12px;padding-bottom:12px}.zcs-px-30{padding-left:30px;padding-right:30px}.zcs-py-24{padding-top:24px;padding-bottom:24px}.zcs-m-0{margin:0}.zcs-font-12{font-size:12px}.zcs-font-14{font-size:14px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-full{border-radius:100%}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-no-underline{text-decoration:none}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.finance-shell{background:var(--zcs_page_bg_color,#F3F3F4);padding-bottom:24px}.finance-content{padding:0 30px}.finance-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}.span-3{grid-column:span 3}.span-4{grid-column:span 4}.span-5{grid-column:span 5}.span-7{grid-column:span 7}.span-8{grid-column:span 8}.span-12{grid-column:span 12}.metric-icon{width:42px;height:42px;border-radius:10px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;font-size:20px}.metric-value{font-size:26px;font-weight:600;color:var(--zcs_primary_text_color)}.section-title{margin:0 0 16px;font-size:18px;font-weight:500;color:var(--zcs_primary_text_color)}.zcs-button{min-height:36px;border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-button:hover{background:var(--zcs_component_hover_color)}.bar-row{display:grid;grid-template-columns:90px 1fr 32px;gap:10px;align-items:center}.zcs-progress-bar{height:9px;background:var(--zcs_component_hover_color);border-radius:4px}.zcs-progress-bar-indicator{height:100%;border-radius:inherit;background:var(--zcs_brand_color)}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;width:100%}.zcs-table-wrapper th{background:var(--zcs-thead-color);white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tr:hover td{background:#F9FAFE}.badge{display:inline-flex;padding:3px 8px;border-radius:12px;font-size:12px;font-weight:500}.badge-red{background:#feedec;color:#a51d31}.badge-yellow{background:#fef4e5;color:#7a4a00}.badge-green{background:#edf7ed;color:#176b3a}.badge-blue{background:#e4f6fd;color:#09598e}.zcs-outline-toast{border:1px solid var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.zcs-donut-chart svg{width:140px;height:140px;transform:rotate(-90deg)}.zcs-donut-chart svg circle{cx:70px;cy:70px;r:54;stroke-width:16;fill:transparent}.zcs-donut-chart svg circle:nth-child(1){stroke:#FECE56;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100) 400;stroke-dashoffset:85}.zcs-donut-chart svg circle:nth-child(2){stroke:#36A2EB;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a2) / 100) 400;stroke-dashoffset:calc(85 - 2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100)}.zcs-donut-chart svg circle:nth-child(3){stroke:#FF6283;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a3) / 100) 400;stroke-dashoffset:calc(85 - 2 * var(--donut-pi) * var(--donut-r) * (var(--donut-a1) + var(--donut-a2)) / 100)}.zcs-donut-chart svg circle:nth-child(4){stroke:#28CC97;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a4) / 100) 400;stroke-dashoffset:calc(85 - 2 * var(--donut-pi) * var(--donut-r) * (var(--donut-a1) + var(--donut-a2) + var(--donut-a3)) / 100)}.legend-dot{width:10px;height:10px;border-radius:50%;display:inline-block}.rate-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.rate-item{padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:8px}.product-row{display:flex;justify-content:space-between;border-bottom:1px solid var(--zcs_tertiary_border_color);padding:9px 0}.product-row:last-child{border-bottom:0}@media(max-width:992px){.span-3,.span-4,.span-5,.span-7,.span-8{grid-column:span 6}}@media(max-width:650px){.finance-content{padding:0 16px}.zcs-page-header{padding:18px 16px;align-items:flex-start;flex-direction:column}.span-3,.span-4,.span-5,.span-7,.span-8{grid-column:span 12}.header-links{flex-wrap:wrap}.rate-grid{grid-template-columns:1fr}}\n&lt;/style&gt;\n&lt;div class=&apos;finance-shell&apos;&gt;\n\t&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24&apos;&gt;\n\t\t&lt;div&gt;&lt;h2 class=&apos;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Finance Dashboard&lt;/h2&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Discount approvals, invoice health, and outstanding financial exposure&lt;% if(isTrainer) { %&gt; for your records&lt;% } %&gt;.&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;header-links zcs-flex zcs-gap-8&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&apos; href=&apos;#Report:Pending_Discount_Approvals&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span&gt;Pending approvals&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&apos; href=&apos;#Report:Outstanding_Invoices&apos;&gt;&lt;i class=&apos;zc-li-outline files-1-single-content-03&apos;&gt;&lt;/i&gt;&lt;span&gt;Outstanding invoices&lt;/span&gt;&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;finance-content&apos;&gt;\n\t\t&lt;div class=&apos;finance-grid&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-card span-3 zcs-p-20&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between&apos;&gt;&lt;div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Pending discounts&lt;/p&gt;&lt;div class=&apos;metric-value&apos;&gt;&lt;%=pendingCount%&gt;&lt;/div&gt;&lt;a class=&apos;zcs-font-12 zcs-color-theme&apos; href=&apos;#Report:Pending_Discount_Approvals&apos;&gt;Open queue&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;metric-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-card span-3 zcs-p-20&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between&apos;&gt;&lt;div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Approved discount value&lt;/p&gt;&lt;div class=&apos;metric-value&apos;&gt;$&lt;%=approvedValue.round(2)%&gt;&lt;/div&gt;&lt;a class=&apos;zcs-font-12 zcs-color-theme&apos; href=&apos;#Report:Approved_Discounts&apos;&gt;View approved&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;metric-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-card span-3 zcs-p-20&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between&apos;&gt;&lt;div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Outstanding value in USD&lt;/p&gt;&lt;div class=&apos;metric-value&apos;&gt;$&lt;%=outstandingValue.round(2)%&gt;&lt;/div&gt;&lt;a class=&apos;zcs-font-12 zcs-color-theme&apos; href=&apos;#Report:Outstanding_Invoices&apos;&gt;Review exposure&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;metric-icon&apos;&gt;&lt;i class=&apos;zc-li-outline business-coins-stack&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-card span-3 zcs-p-20&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between&apos;&gt;&lt;div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Overdue invoices&lt;/p&gt;&lt;div class=&apos;metric-value&apos;&gt;&lt;%=overdueCount%&gt;&lt;/div&gt;&lt;a class=&apos;zcs-font-12 zcs-color-theme&apos; href=&apos;#Report:Overdue_Invoices&apos;&gt;View overdue&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;metric-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-alert-circle&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\n\t\t\t&lt;div class=&apos;zcs-card span-7 zcs-p-24&apos;&gt;&lt;h3 class=&apos;section-title&apos;&gt;Discount trends by type&lt;/h3&gt;&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n\t\t\t\t&lt;div class=&apos;bar-row&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;Partner&lt;/span&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=partnerCount * 100 / discountMax%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong&gt;&lt;%=partnerCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;bar-row&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;Customer&lt;/span&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=customerCount * 100 / discountMax%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong&gt;&lt;%=customerCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;bar-row&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;Prospect&lt;/span&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=prospectCount * 100 / discountMax%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong&gt;&lt;%=prospectCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;bar-row&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;Other&lt;/span&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=otherCount * 100 / discountMax%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong&gt;&lt;%=otherCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-card span-5 zcs-p-24&apos;&gt;&lt;h3 class=&apos;section-title&apos;&gt;Invoice status distribution&lt;/h3&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-20&apos;&gt;&lt;div class=&apos;zcs-donut-chart&apos;&gt;&lt;svg class=&apos;zcs-rounded-full&apos;&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;/svg&gt;&lt;/div&gt;&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-8 zcs-font-14&apos;&gt;&lt;span&gt;&lt;i class=&apos;legend-dot&apos; style=&apos;background:#FECE56&apos;&gt;&lt;/i&gt; Generated: &lt;%=generatedCount%&gt;&lt;/span&gt;&lt;span&gt;&lt;i class=&apos;legend-dot&apos; style=&apos;background:#36A2EB&apos;&gt;&lt;/i&gt; Link sent: &lt;%=linkSentCount%&gt;&lt;/span&gt;&lt;span&gt;&lt;i class=&apos;legend-dot&apos; style=&apos;background:#FF6283&apos;&gt;&lt;/i&gt; Overdue: &lt;%=overdueCount%&gt;&lt;/span&gt;&lt;span&gt;&lt;i class=&apos;legend-dot&apos; style=&apos;background:#28CC97&apos;&gt;&lt;/i&gt; Paid: &lt;%=paidCount%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;Cancelled: &lt;%=cancelledCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\n\t\t\t&lt;div class=&apos;zcs-card span-8 zcs-p-24&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center&apos;&gt;&lt;h3 class=&apos;section-title&apos;&gt;Outstanding and overdue invoices&lt;/h3&gt;&lt;a class=&apos;zcs-font-14 zcs-color-theme&apos; href=&apos;#Report:Outstanding_Invoices&apos;&gt;All outstanding&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm&apos;&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&apos;&gt;Invoice&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&apos;&gt;Customer&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&apos;&gt;Due&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&apos;&gt;USD exposure&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&apos;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t&lt;% for each inv in outstandingSet { statusClass = &quot;badge-yellow&quot;; if(inv.Invoice_Status == &quot;Invoice Overdue&quot;) { statusClass = &quot;badge-red&quot;; } %&gt;\n\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-14&apos;&gt;&lt;%=inv.Invoice_Number%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-14&apos;&gt;&lt;%=inv.Customer_Name%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-14&apos;&gt;&lt;%=inv.Due_Date%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&apos;&gt;$&lt;%=inv.Invoice_Total_USD.round(2)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;badge &lt;%=statusClass%&gt;&apos;&gt;&lt;%=inv.Invoice_Status%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-card span-4 zcs-p-24&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between&apos;&gt;&lt;h3 class=&apos;section-title&apos;&gt;Pending approval queue&lt;/h3&gt;&lt;a class=&apos;zcs-font-14 zcs-color-theme&apos; href=&apos;#Report:Pending_Discount_Approvals&apos;&gt;Open report&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-12&apos;&gt;\n\t\t\t&lt;% for each req in pendingSet { %&gt;&lt;div class=&apos;rate-item&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between&apos;&gt;&lt;strong class=&apos;zcs-font-14&apos;&gt;Discount &lt;%=req.Discount_ID%&gt;&lt;/strong&gt;&lt;span class=&apos;badge badge-yellow&apos;&gt;Pending&lt;/span&gt;&lt;/div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;&lt;%=req.Discount_Type%&gt; | &lt;%=req.Discount_Percentage%&gt;% | $&lt;%=req.Discount_Amount.round(2)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t\t&lt;/div&gt;&lt;/div&gt;\n\n\t\t\t&lt;div class=&apos;zcs-card span-7 zcs-p-24&apos;&gt;&lt;h3 class=&apos;section-title&apos;&gt;Discount activity by product&lt;/h3&gt;&lt;div&gt;\n\t\t\t&lt;% for each product in Products[Active == true] { if(isTrainer) { productDiscounts = Discounts[Product == product.ID &amp;&amp; Requested_By.Email == zoho.loginuserid]; } else { productDiscounts = Discounts[Product == product.ID]; } productValue = productDiscounts.sum(Discount_Amount); if(productValue == null) { productValue = 0; } if(productDiscounts.count() &gt; 0) { %&gt;&lt;div class=&apos;product-row&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=product.Product_Name%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-14&apos;&gt;&lt;strong&gt;&lt;%=productDiscounts.count()%&gt;&lt;/strong&gt; requests | $&lt;%=productValue.round(2)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;% } } %&gt;\n\t\t\t&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-card span-5 zcs-p-24&apos;&gt;&lt;h3 class=&apos;section-title&apos;&gt;Currency-rate readiness&lt;/h3&gt;&lt;div class=&apos;rate-grid&apos;&gt;&lt;div class=&apos;rate-item&apos;&gt;&lt;span class=&apos;badge badge-yellow&apos;&gt;Pending API rate&lt;/span&gt;&lt;div class=&apos;metric-value&apos;&gt;&lt;%=pendingRateCount%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;rate-item&apos;&gt;&lt;span class=&apos;badge badge-green&apos;&gt;Rate applied&lt;/span&gt;&lt;div class=&apos;metric-value&apos;&gt;&lt;%=appliedRateCount%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;rate-item&apos;&gt;&lt;span class=&apos;badge badge-blue&apos;&gt;Manual override&lt;/span&gt;&lt;div class=&apos;metric-value&apos;&gt;&lt;%=manualRateCount%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;rate-item&apos;&gt;&lt;span class=&apos;badge badge-red&apos;&gt;Failed&lt;/span&gt;&lt;div class=&apos;metric-value&apos;&gt;&lt;%=failedRateCount%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;span-12 zcs-outline-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-font-14 zcs-color-primary&apos;&gt;&lt;i class=&apos;zc-li-outline travel-info&apos;&gt;&lt;/i&gt;&lt;p class=&apos;zcs-m-0&apos;&gt;&lt;strong&gt;Exchange-rate connection pending.&lt;/strong&gt; Live exchange-rate retrieval is not yet connected. USD totals use the conversion rates currently stored on invoice records; verify pending, failed, or manually overridden rates before relying on consolidated exposure.&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Leave_Task_Dashboard
		{
					displayname = "Leave & Task Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Leave_Task_Summary' elementName='Leave_Task_Summary'>\n\t\t\t\t\t<![CDATA[htmlpage Leave_Task_Summary()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nmember = Team_Members[Email == zoho.loginuserid];\nmemberId = 0;\nmemberName = zoho.loginuser;\nmemberType = &quot;Viewer&quot;;\nif(member.count() &gt; 0)\n{\n\tmemberId = member.ID;\n\tmemberName = member.Employee_Name;\n\tmemberType = member.Member_Type;\n}\nisManager = memberType == &quot;Training Manager&quot;;\nisLead = memberType == &quot;Lead&quot;;\nscopeLabel = &quot;Personal workload&quot;;\nif(isManager)\n{\n\tscopeLabel = &quot;Team-wide management view&quot;;\n}\nelse if(isLead)\n{\n\tscopeLabel = &quot;Read-only operational summary&quot;;\n}\nif(isManager || isLead)\n{\n\tpendingLeave = Leave_Requests[Approval_Status == &quot;Pending&quot;].count();\n\tcurrentApproved = Leave_Requests[Approval_Status == &quot;Approved&quot; &amp;&amp; Start_Date &lt;= zoho.currentdate &amp;&amp; End_Date &gt;= zoho.currentdate].count();\n\twfhToday = Leave_Requests[Approval_Status == &quot;Approved&quot; &amp;&amp; Request_Type == &quot;WFH&quot; &amp;&amp; Start_Date &lt;= zoho.currentdate &amp;&amp; End_Date &gt;= zoho.currentdate].count();\n\tupcomingAbsences = Leave_Requests[Approval_Status == &quot;Approved&quot; &amp;&amp; Request_Type != &quot;WFH&quot; &amp;&amp; Start_Date &gt; zoho.currentdate &amp;&amp; Start_Date &lt;= zoho.currentdate.addDay(30)].count();\n\topenTasks = Tasks[Status == &quot;Open&quot; || Status == &quot;In Progress&quot;].count();\n\tblockedTasks = Tasks[Status == &quot;Blocked&quot;].count();\n\toverdueTasks = Tasks[Due_Date &lt; zoho.currentdate &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Cancelled&quot;].count();\n\tcriticalTasks = Tasks[Priority == &quot;Critical&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Cancelled&quot;].count();\n}\nelse\n{\n\tpendingLeave = Leave_Requests[Team_Member == memberId &amp;&amp; Approval_Status == &quot;Pending&quot;].count();\n\tcurrentApproved = Leave_Requests[Team_Member == memberId &amp;&amp; Approval_Status == &quot;Approved&quot; &amp;&amp; Start_Date &lt;= zoho.currentdate &amp;&amp; End_Date &gt;= zoho.currentdate].count();\n\twfhToday = Leave_Requests[Team_Member == memberId &amp;&amp; Approval_Status == &quot;Approved&quot; &amp;&amp; Request_Type == &quot;WFH&quot; &amp;&amp; Start_Date &lt;= zoho.currentdate &amp;&amp; End_Date &gt;= zoho.currentdate].count();\n\tupcomingAbsences = Leave_Requests[Team_Member == memberId &amp;&amp; Approval_Status == &quot;Approved&quot; &amp;&amp; Request_Type != &quot;WFH&quot; &amp;&amp; Start_Date &gt; zoho.currentdate &amp;&amp; Start_Date &lt;= zoho.currentdate.addDay(30)].count();\n\topenTasks = Tasks[Assigned_To == memberId &amp;&amp; (Status == &quot;Open&quot; || Status == &quot;In Progress&quot;)].count();\n\tblockedTasks = Tasks[Assigned_To == memberId &amp;&amp; Status == &quot;Blocked&quot;].count();\n\toverdueTasks = Tasks[Assigned_To == memberId &amp;&amp; Due_Date &lt; zoho.currentdate &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Cancelled&quot;].count();\n\tcriticalTasks = Tasks[Assigned_To == memberId &amp;&amp; Priority == &quot;Critical&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Cancelled&quot;].count();\n}\n%&gt;\n&lt;style&gt;\n/* ZCS global utility sheet, included once for this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;--zcs-page-bg-color:#f3f3f4;line-height:1.5}.zcs-flex{display:flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.zcs-button{width:auto;min-height:36px;text-decoration:none}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}\n.lt-shell{background:var(--zcs-page-bg-color);padding:20px;box-sizing:border-box;font-family:inherit}.lt-header{background:linear-gradient(120deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));color:var(--zcs_brand_foreground_color);border-radius:16px;padding:24px}.lt-header h1,.lt-header p{margin:0;color:inherit}.lt-actions{display:flex;gap:8px;flex-wrap:wrap}.lt-actions .zcs-button{background:#fff}.lt-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:16px}.lt-section-label{grid-column:1/-1;margin:8px 0 -4px;color:var(--zcs_primary_text_color);font-size:14px;font-weight:600}.lt-kpi{padding:18px;min-height:118px;box-sizing:border-box;position:relative;overflow:hidden}.lt-kpi i{font-size:22px;color:var(--zcs_brand_color)}.lt-kpi .value{font-size:30px;font-weight:600;color:var(--zcs_primary_text_color);margin-top:10px}.lt-kpi .label{font-size:13px;color:var(--zcs_secondary_text_color)}.lt-kpi.alert i,.lt-kpi.alert .value{color:#d14343}.lt-kpi.warn i,.lt-kpi.warn .value{color:#b8770d}.lt-view-tag{display:inline-flex;margin-top:10px;padding:4px 10px;border-radius:20px;background:rgba(255,255,255,.18);font-size:12px}@media(max-width:900px){.lt-grid{grid-template-columns:repeat(2,1fr)}.lt-header{align-items:flex-start;flex-direction:column}}@media(max-width:520px){.lt-grid{grid-template-columns:1fr}.lt-shell{padding:12px}}\n&lt;/style&gt;\n&lt;div class=&quot;lt-shell&quot;&gt;\n\t&lt;div class=&quot;lt-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&quot;&gt;\n\t\t&lt;div&gt;&lt;h1 class=&quot;zcs-font-24 zcs-font-semibold&quot;&gt;Leave, WFH and task health&lt;/h1&gt;&lt;p class=&quot;zcs-font-14&quot;&gt;Hello &lt;%=memberName%&gt;. Scheduling coverage and workload risks in one place.&lt;/p&gt;&lt;span class=&quot;lt-view-tag&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&amp;nbsp;&lt;%=scopeLabel%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;lt-actions&quot;&gt;\n\t\t\t&lt;% if(isManager) { %&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&quot; href=&quot;#Report:Pending_Leave_Approvals&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span&gt;Approvals&lt;/span&gt;&lt;/a&gt;&lt;% } %&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&quot; href=&quot;#Report:Approved_Leave_WFH&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60&quot;&gt;&lt;/i&gt;&lt;span&gt;Schedule&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&quot; href=&quot;#Report:Task_Board&quot;&gt;&lt;i class=&quot;zc-li-outline design-layout-11&quot;&gt;&lt;/i&gt;&lt;span&gt;Task board&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&quot; href=&quot;#Report:Tasks_Requiring_Attention&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-alert-circle&quot;&gt;&lt;/i&gt;&lt;span&gt;Attention&lt;/span&gt;&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&quot;lt-grid&quot;&gt;\n\t\t&lt;div class=&quot;lt-section-label&quot;&gt;Leave and WFH&lt;/div&gt;\n\t\t&lt;div class=&quot;lt-kpi zcs-card warn&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;div class=&quot;value&quot;&gt;&lt;%=pendingLeave%&gt;&lt;/div&gt;&lt;div class=&quot;label&quot;&gt;Pending requests&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;lt-kpi zcs-card&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;div class=&quot;value&quot;&gt;&lt;%=currentApproved%&gt;&lt;/div&gt;&lt;div class=&quot;label&quot;&gt;Approved and current&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;lt-kpi zcs-card&quot;&gt;&lt;i class=&quot;zc-li-outline location-pin&quot;&gt;&lt;/i&gt;&lt;div class=&quot;value&quot;&gt;&lt;%=wfhToday%&gt;&lt;/div&gt;&lt;div class=&quot;label&quot;&gt;WFH today&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;lt-kpi zcs-card&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60&quot;&gt;&lt;/i&gt;&lt;div class=&quot;value&quot;&gt;&lt;%=upcomingAbsences%&gt;&lt;/div&gt;&lt;div class=&quot;label&quot;&gt;Upcoming absences, 30 days&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;lt-section-label&quot;&gt;Task health&lt;/div&gt;\n\t\t&lt;div class=&quot;lt-kpi zcs-card&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-list&quot;&gt;&lt;/i&gt;&lt;div class=&quot;value&quot;&gt;&lt;%=openTasks%&gt;&lt;/div&gt;&lt;div class=&quot;label&quot;&gt;Open or in progress&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;lt-kpi zcs-card alert&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-alert-circle&quot;&gt;&lt;/i&gt;&lt;div class=&quot;value&quot;&gt;&lt;%=blockedTasks%&gt;&lt;/div&gt;&lt;div class=&quot;label&quot;&gt;Blocked tasks&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;lt-kpi zcs-card alert&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;div class=&quot;value&quot;&gt;&lt;%=overdueTasks%&gt;&lt;/div&gt;&lt;div class=&quot;label&quot;&gt;Overdue tasks&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;lt-kpi zcs-card warn&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-notification-69&quot;&gt;&lt;/i&gt;&lt;div class=&quot;value&quot;&gt;&lt;%=criticalTasks%&gt;&lt;/div&gt;&lt;div class=&quot;label&quot;&gt;Critical active tasks&lt;/div&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Leave_Task_Detail' elementName='Leave_Task_Detail'>\n\t\t\t\t\t<![CDATA[htmlpage Leave_Task_Detail()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nmember = Team_Members[Email == zoho.loginuserid];\nmemberId = 0;\nmemberType = &quot;Viewer&quot;;\nif(member.count() &gt; 0)\n{\n\tmemberId = member.ID;\n\tmemberType = member.Member_Type;\n}\nisManager = memberType == &quot;Training Manager&quot;;\nisLead = memberType == &quot;Lead&quot;;\nif(isManager || isLead)\n{\n\tapprovals = Leave_Requests[Approval_Status == &quot;Pending&quot;] sort by Start_Date asc range from 1 to 6;\n\tschedule = Leave_Requests[Approval_Status == &quot;Approved&quot; &amp;&amp; End_Date &gt;= zoho.currentdate] sort by Start_Date asc range from 1 to 7;\n\tattention = Tasks[(Status == &quot;Blocked&quot; || Priority == &quot;Critical&quot; || Due_Date &lt; zoho.currentdate) &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Cancelled&quot;] sort by Due_Date asc range from 1 to 7;\n\ttaskOpen = Tasks[Status == &quot;Open&quot;].count();\n\ttaskProgress = Tasks[Status == &quot;In Progress&quot;].count();\n\ttaskBlocked = Tasks[Status == &quot;Blocked&quot;].count();\n\ttaskDone = Tasks[Status == &quot;Completed&quot;].count();\n\ttrainerTasks = Tasks[Assignee_Type == &quot;Trainer&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Cancelled&quot;].count();\n\tmentorTasks = Tasks[Assignee_Type == &quot;Mentor&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Cancelled&quot;].count();\n}\nelse\n{\n\tapprovals = Leave_Requests[Team_Member == memberId &amp;&amp; Approval_Status == &quot;Pending&quot;] sort by Start_Date asc range from 1 to 6;\n\tschedule = Leave_Requests[Team_Member == memberId &amp;&amp; Approval_Status == &quot;Approved&quot; &amp;&amp; End_Date &gt;= zoho.currentdate] sort by Start_Date asc range from 1 to 7;\n\tattention = Tasks[Assigned_To == memberId &amp;&amp; (Status == &quot;Blocked&quot; || Priority == &quot;Critical&quot; || Due_Date &lt; zoho.currentdate) &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Cancelled&quot;] sort by Due_Date asc range from 1 to 7;\n\ttaskOpen = Tasks[Assigned_To == memberId &amp;&amp; Status == &quot;Open&quot;].count();\n\ttaskProgress = Tasks[Assigned_To == memberId &amp;&amp; Status == &quot;In Progress&quot;].count();\n\ttaskBlocked = Tasks[Assigned_To == memberId &amp;&amp; Status == &quot;Blocked&quot;].count();\n\ttaskDone = Tasks[Assigned_To == memberId &amp;&amp; Status == &quot;Completed&quot;].count();\n\ttrainerTasks = Tasks[Assigned_To == memberId &amp;&amp; Assignee_Type == &quot;Trainer&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Cancelled&quot;].count();\n\tmentorTasks = Tasks[Assigned_To == memberId &amp;&amp; Assignee_Type == &quot;Mentor&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Cancelled&quot;].count();\n}\ntaskTotal = taskOpen + taskProgress + taskBlocked + taskDone;\nif(taskTotal == 0) { taskTotal = 1; }\nopenPct = taskOpen * 100 / taskTotal;\nprogressPct = taskProgress * 100 / taskTotal;\nblockedPct = taskBlocked * 100 / taskTotal;\ndonePct = taskDone * 100 / taskTotal;\nassigneeMax = trainerTasks;\nif(mentorTasks &gt; assigneeMax) { assigneeMax = mentorTasks; }\nif(assigneeMax == 0) { assigneeMax = 1; }\ntrainerPct = trainerTasks * 100 / assigneeMax;\nmentorPct = mentorTasks * 100 / assigneeMax;\n%&gt;\n&lt;style&gt;\n.lt-detail{background:var(--zcs-page-bg-color);padding:0 20px 24px;box-sizing:border-box}.lt-two{display:grid;grid-template-columns:1.25fr .75fr;gap:16px;margin-top:16px}.lt-card{padding:20px}.lt-title{margin:0 0 14px;font-size:17px;font-weight:600;color:var(--zcs_primary_text_color);display:flex;align-items:center;justify-content:space-between}.lt-title a{font-size:12px;color:var(--zcs_brand_color);text-decoration:none}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:var(--zcs-white-color);overflow:auto;border-radius:8px}.zcs-table-wrapper table{width:100%;border-collapse:collapse}.zcs-table-wrapper th{background:#f9fafe;white-space:nowrap;color:var(--zcs_primary_text_color);font-weight:500}.zcs-table-wrapper th,.zcs-table-wrapper td{padding:10px 12px;text-align:left;font-size:13px;border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper thead th{border-top:0}.zcs-table-wrapper tbody tr:hover td{background:#f9fafe}.lt-pill{display:inline-block;padding:3px 8px;border-radius:12px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_dark_color);font-size:11px}.lt-pill.red{background:#fe455d1a;color:#c73549}.lt-list{list-style:none;padding:0;margin:0}.lt-list li{display:flex;gap:10px;align-items:flex-start;padding:11px 0;border-bottom:1px solid var(--zcs_tertiary_border_color)}.lt-list li:last-child{border:0}.lt-list i{font-size:18px;color:var(--zcs_brand_color);margin-top:2px}.lt-list strong,.lt-list span{display:block;color:var(--zcs_primary_text_color);font-size:13px}.lt-list small{color:var(--zcs_secondary_text_color)}.lt-charts{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.lt-donut-wrap{display:flex;align-items:center;gap:20px;flex-wrap:wrap}.lt-donut{width:150px;height:150px;border-radius:50%;background:conic-gradient(#36a2eb 0 &lt;%=openPct%&gt;%,#fece56 &lt;%=openPct%&gt;% &lt;%=openPct + progressPct%&gt;%,#ff6283 &lt;%=openPct + progressPct%&gt;% &lt;%=openPct + progressPct + blockedPct%&gt;%,#28cc97 &lt;%=openPct + progressPct + blockedPct%&gt;% 100%);position:relative}.lt-donut:after{content:&apos;Tasks&apos;;position:absolute;inset:32px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;color:var(--zcs_primary_text_color);font-weight:600}.lt-legend{list-style:none;margin:0;padding:0}.lt-legend li{font-size:13px;color:var(--zcs_primary_text_color);margin:7px 0}.lt-dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:7px}.lt-bars{height:170px;display:flex;align-items:flex-end;justify-content:space-around;border-bottom:1px solid var(--zcs_tertiary_border_color);padding:0 30px}.lt-bar-item{text-align:center;color:var(--zcs_primary_text_color);font-size:12px}.lt-bar{width:42px;background:var(--zcs_brand_color);border-radius:7px 7px 0 0;min-height:4px}.lt-empty{padding:18px;text-align:center;color:var(--zcs_secondary_text_color);font-size:13px}@media(max-width:900px){.lt-two,.lt-charts{grid-template-columns:1fr}}@media(max-width:520px){.lt-detail{padding:0 12px 16px}.lt-card{padding:14px}}\n&lt;/style&gt;\n&lt;div class=&quot;lt-detail&quot;&gt;\n\t&lt;div class=&quot;lt-two&quot;&gt;\n\t\t&lt;section class=&quot;lt-card zcs-card&quot;&gt;&lt;h2 class=&quot;lt-title&quot;&gt;&lt;span&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt; &lt;% if(isManager) { %&gt;Approval queue&lt;% } else { %&gt;Pending requests&lt;% } %&gt;&lt;/span&gt;&lt;a href=&quot;#Report:Pending_Leave_Approvals&quot;&gt;View report&lt;/a&gt;&lt;/h2&gt;\n\t\t\t&lt;div class=&quot;zcs-table-wrapper&quot;&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Member&lt;/th&gt;&lt;th&gt;Type&lt;/th&gt;&lt;th&gt;Dates&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t&lt;% for each req in approvals { %&gt;&lt;tr&gt;&lt;td&gt;&lt;%=req.Team_Member%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=req.Request_Type%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=req.Start_Date%&gt; to &lt;%=req.End_Date%&gt;&lt;/td&gt;&lt;td&gt;&lt;span class=&quot;lt-pill&quot;&gt;Pending&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t&lt;% if(approvals.count() == 0) { %&gt;&lt;tr&gt;&lt;td colspan=&quot;4&quot; class=&quot;lt-empty&quot;&gt;No pending requests in this view.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t\t&lt;section class=&quot;lt-card zcs-card&quot;&gt;&lt;h2 class=&quot;lt-title&quot;&gt;&lt;span&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60&quot;&gt;&lt;/i&gt; WFH and leave schedule&lt;/span&gt;&lt;a href=&quot;#Report:Approved_Leave_WFH&quot;&gt;Calendar&lt;/a&gt;&lt;/h2&gt;&lt;ul class=&quot;lt-list&quot;&gt;\n\t\t\t&lt;% for each req in schedule { %&gt;&lt;li&gt;&lt;i class=&quot;zc-li-outline &lt;% if(req.Request_Type == &quot;WFH&quot;) { %&gt;location-pin&lt;% } else { %&gt;ui-1-calendar-60&lt;% } %&gt;&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;&lt;%=req.Team_Member%&gt; &lt;span class=&quot;lt-pill&quot;&gt;&lt;%=req.Request_Type%&gt;&lt;/span&gt;&lt;/strong&gt;&lt;small&gt;&lt;%=req.Start_Date%&gt; to &lt;%=req.End_Date%&gt;&lt;/small&gt;&lt;/div&gt;&lt;/li&gt;&lt;% } %&gt;\n\t\t\t&lt;% if(schedule.count() == 0) { %&gt;&lt;li class=&quot;lt-empty&quot;&gt;No current or upcoming approved schedule entries.&lt;/li&gt;&lt;% } %&gt;\n\t\t&lt;/ul&gt;&lt;/section&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&quot;lt-charts&quot;&gt;\n\t\t&lt;section class=&quot;lt-card zcs-card&quot;&gt;&lt;h2 class=&quot;lt-title&quot;&gt;Task status distribution&lt;/h2&gt;&lt;div class=&quot;lt-donut-wrap&quot;&gt;&lt;div class=&quot;lt-donut&quot;&gt;&lt;/div&gt;&lt;ul class=&quot;lt-legend&quot;&gt;&lt;li&gt;&lt;span class=&quot;lt-dot&quot; style=&quot;background:#36a2eb&quot;&gt;&lt;/span&gt;Open: &lt;%=taskOpen%&gt;&lt;/li&gt;&lt;li&gt;&lt;span class=&quot;lt-dot&quot; style=&quot;background:#fece56&quot;&gt;&lt;/span&gt;In progress: &lt;%=taskProgress%&gt;&lt;/li&gt;&lt;li&gt;&lt;span class=&quot;lt-dot&quot; style=&quot;background:#ff6283&quot;&gt;&lt;/span&gt;Blocked: &lt;%=taskBlocked%&gt;&lt;/li&gt;&lt;li&gt;&lt;span class=&quot;lt-dot&quot; style=&quot;background:#28cc97&quot;&gt;&lt;/span&gt;Completed: &lt;%=taskDone%&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&quot;lt-card zcs-card&quot;&gt;&lt;h2 class=&quot;lt-title&quot;&gt;Active tasks by assignee type&lt;/h2&gt;&lt;div class=&quot;lt-bars&quot;&gt;&lt;div class=&quot;lt-bar-item&quot;&gt;&lt;div class=&quot;lt-bar&quot; style=&quot;height:&lt;%=trainerPct%&gt;px&quot;&gt;&lt;/div&gt;&lt;strong&gt;&lt;%=trainerTasks%&gt;&lt;/strong&gt;&lt;div&gt;Trainer&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;lt-bar-item&quot;&gt;&lt;div class=&quot;lt-bar&quot; style=&quot;height:&lt;%=mentorPct%&gt;px&quot;&gt;&lt;/div&gt;&lt;strong&gt;&lt;%=mentorTasks%&gt;&lt;/strong&gt;&lt;div&gt;Mentor&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;\n\t&lt;/div&gt;\n\t&lt;section class=&quot;lt-card zcs-card&quot; style=&quot;margin-top:16px&quot;&gt;&lt;h2 class=&quot;lt-title&quot;&gt;&lt;span&gt;&lt;i class=&quot;zc-li-outline ui-2-alert-circle&quot;&gt;&lt;/i&gt; Issues requiring attention&lt;/span&gt;&lt;a href=&quot;#Report:Tasks_Requiring_Attention&quot;&gt;Open full list&lt;/a&gt;&lt;/h2&gt;&lt;div class=&quot;zcs-table-wrapper&quot;&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Task&lt;/th&gt;&lt;th&gt;Assignee&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;th&gt;Priority&lt;/th&gt;&lt;th&gt;Due date&lt;/th&gt;&lt;th&gt;Issue or blocker&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t&lt;% for each task in attention { %&gt;&lt;tr&gt;&lt;td&gt;&lt;%=task.Task_Title%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=task.Assigned_To%&gt;&lt;/td&gt;&lt;td&gt;&lt;span class=&quot;lt-pill &lt;% if(task.Status == &quot;Blocked&quot;) { %&gt;red&lt;% } %&gt;&quot;&gt;&lt;%=task.Status%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;%=task.Priority%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=task.Due_Date%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=task.Issue_Blocker%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t&lt;% if(attention.count() == 0) { %&gt;&lt;tr&gt;&lt;td colspan=&quot;6&quot; class=&quot;lt-empty&quot;&gt;No blocked, overdue, or critical tasks in this view.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Manager_Dashboard
		{
					displayname = "Manager Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Manager_Executive' elementName='Manager_Executive'>\n\t\t\t\t\t<![CDATA[htmlpage Manager_Executive()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nuserName = zoho.loginuser;\nmemberType = &quot;Training Manager&quot;;\nmemberRows = Team_Members[Email == zoho.loginuserid];\nif(memberRows.count() &gt; 0)\n{\n\tuserName = ifnull(memberRows.Employee_Name.first_name,zoho.loginuser);\n\tmemberType = memberRows.Member_Type;\n}\nisLead = memberType == &quot;Lead&quot;;\nupcomingCount = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; Start_Date_Time &gt;= zoho.currenttime &amp;&amp; Start_Date_Time &lt;= zoho.currenttime.addDay(30)].count();\nnotReadyCount = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; Start_Date_Time &gt;= zoho.currenttime &amp;&amp; Readiness_Status != &quot;Ready&quot;].count();\nincompleteCount = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; (Lifecycle_Stage == &quot;Post-Event&quot; || Event_Status == &quot;Delivered&quot;) &amp;&amp; (Recording_URL is null || Description_URL is null || Upload_Status == &quot;Pending&quot;)].count();\npendingLeave = Leave_Requests[Approval_Status == &quot;Pending&quot;].count();\nblockedTasks = Tasks[Status == &quot;Blocked&quot;].count();\noverdueTasks = Tasks[Due_Date &lt; zoho.currentdate &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Cancelled&quot;].count();\npendingDiscounts = Discounts[Approval_Status == &quot;Pending&quot;].count();\noverdueInvoices = Invoices[Due_Date &lt; zoho.currentdate &amp;&amp; Invoice_Status != &quot;Invoice Paid&quot; &amp;&amp; Invoice_Status != &quot;Cancelled&quot;].count();\noutstandingUSD = ifnull(Invoices[Invoice_Status != &quot;Invoice Paid&quot; &amp;&amp; Invoice_Status != &quot;Cancelled&quot;].sum(Invoice_Total_USD),0);\ntodayEvents = Events[Start_Date_Time &gt;= zoho.currentdate &amp;&amp; Start_Date_Time &lt; zoho.currentdate.addDay(1) &amp;&amp; Event_Status != &quot;Cancelled&quot;] sort by Start_Date_Time asc;\nnextEvents = Events[Start_Date_Time &gt;= zoho.currenttime &amp;&amp; Start_Date_Time &lt;= zoho.currenttime.addDay(14) &amp;&amp; Event_Status != &quot;Cancelled&quot;] sort by Start_Date_Time asc;\nleaveQueue = Leave_Requests[Approval_Status == &quot;Pending&quot;] sort by Start_Date asc;\nattentionTasks = Tasks[(Status == &quot;Blocked&quot; || (Due_Date &lt; zoho.currentdate &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Cancelled&quot;))] sort by Due_Date asc;\npreCount = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; Lifecycle_Stage == &quot;Pre-Event&quot;].count();\nduringCount = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; Lifecycle_Stage == &quot;During Event&quot;].count();\npostCount = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; Lifecycle_Stage == &quot;Post-Event&quot;].count();\ncompleteCount = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; Lifecycle_Stage == &quot;Completed&quot;].count();\nmaxStage = preCount;\nif(duringCount &gt; maxStage){maxStage = duringCount;}\nif(postCount &gt; maxStage){maxStage = postCount;}\nif(completeCount &gt; maxStage){maxStage = completeCount;}\nif(maxStage == 0){maxStage = 1;}\n%&gt;\n&lt;style&gt;\n/* zcs-global utility sheet, included once for this page */\n:root{--zcs-page-bg-color:#f3f3f4;--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color)}*{box-sizing:border-box}.zcs-flex,.zcs-row{display:flex}.zcs-row{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-end{align-items:flex-end}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-gap-4{gap:4px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-gap-20{gap:20px}.zcs-gap-24{gap:24px}.zcs-p-0{padding:0}.zcs-p-12{padding:12px}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-p-24{padding:24px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-normal{font-weight:400}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.zcs-col-3{width:calc(25% - 15px)}.zcs-col-4{width:calc(33.333% - 14px)}.zcs-col-5{width:calc(41.667% - 10px)}.zcs-col-6{width:calc(50% - 10px)}.zcs-col-7{width:calc(58.333% - 10px)}.zcs-col-12{width:100%}.zcs-no-shrink{flex-shrink:0}.zcs-relative{position:relative}.manager-page{background:var(--zcs-page-bg-color);padding:24px 30px;min-height:100%}.manager-header{background:linear-gradient(120deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));color:var(--zcs_brand_foreground_color);padding:24px;border-radius:12px}.manager-header h2,.manager-header p{color:inherit}.role-chip{border:1px solid rgba(255,255,255,.55);padding:5px 10px;border-radius:20px}.zcs-panel-wrapper ul,.zcs-quick-actions-wrapper ul{list-style:none}.zcs-panel{border:1px solid var(--zcs_tertiary_border_color);box-shadow:0 2px 8px #f2f2f6;background:#fff}.zcs-panel-icon-wrapper{width:40px;height:40px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.zcs-panel-wrapper li:hover .zcs-panel,.zcs-quick-action-item:hover{border-color:var(--zcs_brand_color)}.zcs-panel-wrapper a,.zcs-quick-action-link,.view-link{text-decoration:none;color:inherit}.zcs-badge{width:auto;border:1px solid}.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#d92f47}.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#9b6509}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#1652bb}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#087c51}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;min-width:620px}.zcs-table-wrapper th{background:#f9fafe}.zcs-table-wrapper th,.zcs-table-wrapper td{padding:9px 12px;text-align:left;border-bottom:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tr:hover td{background:#f9fafe}.section-title{margin:0 0 14px}.queue-card{min-height:300px}.empty{padding:22px;text-align:center;color:var(--zcs_teritiary_text_color)}.bar-chart{height:190px;padding:14px 8px 0;border-bottom:1px solid var(--zcs_tertiary_border_color)}.bar-item{height:100%;flex:1;min-width:58px}.bar{width:30px;background:var(--zcs_brand_color);border-radius:6px 6px 0 0;min-height:4px}.bar-label{text-align:center}.nav-grid .zcs-quick-action-item{list-style:none}.nav-grid .zcs-quick-action-link{height:100%;min-height:72px}.read-note{background:#e8efff;border:1px solid #2a6ffc;color:#1652bb;padding:10px 14px;border-radius:8px}.amount{font-variant-numeric:tabular-nums}@media(max-width:992px){.zcs-col-3,.zcs-col-4,.zcs-col-5,.zcs-col-6,.zcs-col-7{width:calc(50% - 10px)}}@media(max-width:640px){.manager-page{padding:16px}.zcs-col-3,.zcs-col-4,.zcs-col-5,.zcs-col-6,.zcs-col-7{width:100%}.manager-header{align-items:flex-start;flex-direction:column}.queue-card{min-height:auto}}\n&lt;/style&gt;\n&lt;div class=&apos;manager-page zcs-flex zcs-direction-column zcs-gap-20&apos;&gt;\n\t&lt;div class=&apos;manager-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&apos;&gt;\n\t\t&lt;div&gt;&lt;h2 class=&apos;zcs-font-24 zcs-font-semibold zcs-m-0&apos;&gt;Executive operations center&lt;/h2&gt;&lt;p class=&apos;zcs-font-14 zcs-m-0&apos;&gt;Hello &lt;%=userName%&gt;. Event delivery, people workload, approvals and financial exposure in one view.&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;span class=&apos;role-chip zcs-font-13&apos;&gt;&lt;%=if(isLead,&quot;Lead read-focused view&quot;,&quot;Training Manager full view&quot;)%&gt;&lt;/span&gt;\n\t&lt;/div&gt;\n\t&lt;%if(isLead){%&gt;&lt;div class=&apos;read-note zcs-font-14&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-eye-17&apos;&gt;&lt;/i&gt; Operational and finance indicators are presented for review. Approval and administration actions remain in their governed modules.&lt;/div&gt;&lt;%}%&gt;\n\t&lt;div class=&apos;zcs-panel-wrapper&apos;&gt;\n\t\t&lt;ul class=&apos;zcs-row zcs-gap-20 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t&lt;li class=&apos;zcs-col-3&apos;&gt;&lt;a href=&apos;#Report:Upcoming_Events&apos;&gt;&lt;div class=&apos;zcs-panel zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-font-24 zc-li-outline ui-1-calendar-60&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&apos;zcs-font-20 zcs-m-0&apos;&gt;&lt;%=upcomingCount%&gt;&lt;/h4&gt;&lt;/div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Events in next 30 days&lt;/p&gt;&lt;/div&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-col-3&apos;&gt;&lt;a href=&apos;#Report:Incomplete_Event_Activities&apos;&gt;&lt;div class=&apos;zcs-panel zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-font-24 zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&apos;zcs-font-20 zcs-m-0&apos;&gt;&lt;%=notReadyCount + incompleteCount%&gt;&lt;/h4&gt;&lt;/div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Readiness and closure alerts&lt;/p&gt;&lt;/div&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-col-3&apos;&gt;&lt;a href=&apos;#Report:Pending_Leave_Approvals&apos;&gt;&lt;div class=&apos;zcs-panel zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-font-24 zc-li-outline users-2-a-add&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&apos;zcs-font-20 zcs-m-0&apos;&gt;&lt;%=pendingLeave%&gt;&lt;/h4&gt;&lt;/div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Pending leave approvals&lt;/p&gt;&lt;/div&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-col-3&apos;&gt;&lt;a href=&apos;#Report:Tasks_Requiring_Attention&apos;&gt;&lt;div class=&apos;zcs-panel zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-font-24 zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&apos;zcs-font-20 zcs-m-0&apos;&gt;&lt;%=blockedTasks + overdueTasks%&gt;&lt;/h4&gt;&lt;/div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Blocked and overdue tasks&lt;/p&gt;&lt;/div&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-col-3&apos;&gt;&lt;a href=&apos;#Report:Pending_Discount_Approvals&apos;&gt;&lt;div class=&apos;zcs-panel zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-font-24 zc-li-outline business-coins&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&apos;zcs-font-20 zcs-m-0&apos;&gt;&lt;%=pendingDiscounts%&gt;&lt;/h4&gt;&lt;/div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Pending discount approvals&lt;/p&gt;&lt;/div&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-col-3&apos;&gt;&lt;a href=&apos;#Report:Overdue_Invoices&apos;&gt;&lt;div class=&apos;zcs-panel zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-font-24 zc-li-outline files-2-doc&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&apos;zcs-font-20 zcs-m-0&apos;&gt;&lt;%=overdueInvoices%&gt;&lt;/h4&gt;&lt;/div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Overdue invoices&lt;/p&gt;&lt;/div&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-col-3&apos;&gt;&lt;a href=&apos;#Page:Finance_Dashboard&apos;&gt;&lt;div class=&apos;zcs-panel zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-font-24 zc-li-outline business-money-coins&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&apos;amount zcs-font-20 zcs-m-0&apos;&gt;USD &lt;%=outstandingUSD.round(2)%&gt;&lt;/h4&gt;&lt;/div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Outstanding invoice exposure&lt;/p&gt;&lt;/div&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-col-3&apos;&gt;&lt;a href=&apos;#Page:Trainer_Dashboard&apos;&gt;&lt;div class=&apos;zcs-panel zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-font-24 zc-li-outline users-1-single-05&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&apos;zcs-font-20 zcs-m-0&apos;&gt;&lt;%=Tasks[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Cancelled&quot;].count()%&gt;&lt;/h4&gt;&lt;/div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Open team workload&lt;/p&gt;&lt;/div&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t&lt;/ul&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;zcs-row zcs-gap-20&apos;&gt;\n\t\t&lt;section class=&apos;zcs-card zcs-col-7 zcs-p-20 queue-card&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;h3 class=&apos;section-title zcs-font-18&apos;&gt;Today and upcoming schedule&lt;/h3&gt;&lt;a class=&apos;view-link zcs-font-13&apos; href=&apos;#Report:Event_Calendar&apos;&gt;Calendar&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;When&lt;/th&gt;&lt;th&gt;Event&lt;/th&gt;&lt;th&gt;Trainer&lt;/th&gt;&lt;th&gt;Readiness&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%rowCount=0;for each ev in nextEvents{if(rowCount &lt; 6){rowCount=rowCount+1;%&gt;&lt;tr&gt;&lt;td&gt;&lt;%=ev.Start_Date_Time.toString(&quot;dd MMM, hh:mm a&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ev.Event_Title%&gt;&lt;%if(ev.Start_Date_Time &gt;= zoho.currentdate &amp;&amp; ev.Start_Date_Time &lt; zoho.currentdate.addDay(1)){%&gt; &lt;span class=&apos;zcs-badge zcs-badge-blue zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;Today&lt;/span&gt;&lt;%}%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ev.Primary_Trainer.Employee_Name%&gt;&lt;/td&gt;&lt;td&gt;&lt;span class=&apos;zcs-badge &lt;%=if(ev.Readiness_Status == &quot;Ready&quot;,&quot;zcs-badge-green&quot;,&quot;zcs-badge-yellow&quot;)%&gt; zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;%=ev.Readiness_Status%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}}%&gt;&lt;%if(rowCount == 0){%&gt;&lt;tr&gt;&lt;td colspan=&apos;4&apos; class=&apos;empty&apos;&gt;No events scheduled in the next 14 days.&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;zcs-card zcs-col-5 zcs-p-20&apos;&gt;&lt;h3 class=&apos;section-title zcs-font-18&apos;&gt;Lifecycle trend&lt;/h3&gt;&lt;div class=&apos;bar-chart zcs-flex zcs-align-items-end zcs-gap-12&apos;&gt;&lt;div class=&apos;bar-item zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span&gt;&lt;%=preCount%&gt;&lt;/span&gt;&lt;div class=&apos;bar&apos; style=&apos;height:&lt;%=(preCount*100/maxStage)%&gt;%&apos;&gt;&lt;/div&gt;&lt;span class=&apos;bar-label zcs-font-12&apos;&gt;Pre&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;bar-item zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span&gt;&lt;%=duringCount%&gt;&lt;/span&gt;&lt;div class=&apos;bar&apos; style=&apos;height:&lt;%=(duringCount*100/maxStage)%&gt;%&apos;&gt;&lt;/div&gt;&lt;span class=&apos;bar-label zcs-font-12&apos;&gt;Live&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;bar-item zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span&gt;&lt;%=postCount%&gt;&lt;/span&gt;&lt;div class=&apos;bar&apos; style=&apos;height:&lt;%=(postCount*100/maxStage)%&gt;%&apos;&gt;&lt;/div&gt;&lt;span class=&apos;bar-label zcs-font-12&apos;&gt;Post&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;bar-item zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span&gt;&lt;%=completeCount%&gt;&lt;/span&gt;&lt;div class=&apos;bar&apos; style=&apos;height:&lt;%=(completeCount*100/maxStage)%&gt;%&apos;&gt;&lt;/div&gt;&lt;span class=&apos;bar-label zcs-font-12&apos;&gt;Done&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;zcs-row zcs-gap-8 zcs-p-16&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-yellow zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt; &lt;%=notReadyCount%&gt; not ready&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-red zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt; &lt;%=incompleteCount%&gt; incomplete closures&lt;/span&gt;&lt;/div&gt;&lt;/section&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;zcs-row zcs-gap-20&apos;&gt;\n\t\t&lt;section class=&apos;zcs-card zcs-col-6 zcs-p-20&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between&apos;&gt;&lt;h3 class=&apos;section-title zcs-font-18&apos;&gt;Pending leave approvals&lt;/h3&gt;&lt;a class=&apos;view-link zcs-font-13&apos; href=&apos;#Report:Pending_Leave_Approvals&apos;&gt;Open queue&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Team member&lt;/th&gt;&lt;th&gt;Type&lt;/th&gt;&lt;th&gt;Dates&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%leaveRows=0;for each req in leaveQueue{if(leaveRows &lt; 5){leaveRows=leaveRows+1;%&gt;&lt;tr&gt;&lt;td&gt;&lt;%=req.Team_Member.Employee_Name%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=req.Request_Type%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=req.Start_Date.toString(&quot;dd MMM&quot;)%&gt; - &lt;%=req.End_Date.toString(&quot;dd MMM&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}}%&gt;&lt;%if(leaveRows == 0){%&gt;&lt;tr&gt;&lt;td colspan=&apos;3&apos; class=&apos;empty&apos;&gt;No pending requests.&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;zcs-card zcs-col-6 zcs-p-20&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between&apos;&gt;&lt;h3 class=&apos;section-title zcs-font-18&apos;&gt;Tasks requiring attention&lt;/h3&gt;&lt;a class=&apos;view-link zcs-font-13&apos; href=&apos;#Report:Tasks_Requiring_Attention&apos;&gt;Open tasks&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Task&lt;/th&gt;&lt;th&gt;Assignee&lt;/th&gt;&lt;th&gt;Due&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%taskRows=0;for each task in attentionTasks{if(taskRows &lt; 5){taskRows=taskRows+1;%&gt;&lt;tr&gt;&lt;td&gt;&lt;%=task.Task_Title%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=task.Assigned_To.Employee_Name%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=if(task.Due_Date != null,task.Due_Date.toString(&quot;dd MMM&quot;),&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;span class=&apos;zcs-badge &lt;%=if(task.Status == &quot;Blocked&quot;,&quot;zcs-badge-red&quot;,&quot;zcs-badge-yellow&quot;)%&gt; zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;%=task.Status%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}}%&gt;&lt;%if(taskRows == 0){%&gt;&lt;tr&gt;&lt;td colspan=&apos;4&apos; class=&apos;empty&apos;&gt;No blocked or overdue tasks.&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/section&gt;\n\t&lt;/div&gt;\n\t&lt;section class=&apos;zcs-quick-actions-wrapper zcs-card zcs-p-20&apos;&gt;&lt;h3 class=&apos;section-title zcs-font-18&apos;&gt;Manager workspaces&lt;/h3&gt;&lt;ul class=&apos;nav-grid zcs-row zcs-gap-20 zcs-p-0 zcs-m-0&apos;&gt;&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-col-4 zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8&apos; href=&apos;#Page:Operations_Dashboard&apos;&gt;&lt;i class=&apos;zcs-font-20 zc-li-outline ui-1-settings-gear-63&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;strong&gt;Operations&lt;/strong&gt;&lt;br&gt;&lt;small&gt;Readiness, lifecycle and closure&lt;/small&gt;&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-col-4 zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8&apos; href=&apos;#Page:Metrics_Dashboard&apos;&gt;&lt;i class=&apos;zcs-font-20 zc-li-outline business-chart-bar-32&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;strong&gt;Metrics&lt;/strong&gt;&lt;br&gt;&lt;small&gt;Performance and trends&lt;/small&gt;&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-col-4 zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8&apos; href=&apos;#Page:Trainer_Dashboard&apos;&gt;&lt;i class=&apos;zcs-font-20 zc-li-outline users-1-single-05&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;strong&gt;Trainer workload&lt;/strong&gt;&lt;br&gt;&lt;small&gt;Assignments and capacity&lt;/small&gt;&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-col-4 zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8&apos; href=&apos;#Page:Leave_Task_Dashboard&apos;&gt;&lt;i class=&apos;zcs-font-20 zc-li-outline ui-1-calendar-60&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;strong&gt;Leave and tasks&lt;/strong&gt;&lt;br&gt;&lt;small&gt;Approvals and task health&lt;/small&gt;&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-col-4 zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8&apos; href=&apos;#Page:Finance_Dashboard&apos;&gt;&lt;i class=&apos;zcs-font-20 zc-li-outline business-money-coins&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;strong&gt;Finance&lt;/strong&gt;&lt;br&gt;&lt;small&gt;Discounts and invoices&lt;/small&gt;&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Metrics_Dashboard
		{
					displayname = "Metrics Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Metrics_Analytics' elementName='Metrics_Analytics'>\n\t\t\t\t\t<![CDATA[htmlpage Metrics_Analytics()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nevents = Events[ID != 0];\nperformanceRows = Event_Performance[ID != 0];\ntotalRegistrations = 0;\ntotalAttendees = 0;\ntotalRevenue = 0.0;\nproductTotals = Map();\nregionTotals = Map();\ntypeTotals = Map();\nmaxProduct = 1;\nmaxRegion = 1;\nfor each eventRec in events\n{\n\tregs = ifnull(eventRec.Final_Registrations,0);\n\tattendees = ifnull(eventRec.Final_Attendees,0);\n\trevenue = ifnull(eventRec.Final_Revenue,0.0);\n\ttotalRegistrations = totalRegistrations + regs;\n\ttotalAttendees = totalAttendees + attendees;\n\ttotalRevenue = totalRevenue + revenue;\n\tproductName = ifnull(eventRec.Product.Product_Name,&quot;Unassigned&quot;);\n\tregionName = ifnull(eventRec.Region,&quot;Other&quot;);\n\ttypeName = ifnull(eventRec.Event_Type,&quot;Other&quot;);\n\tproductValue = ifnull(productTotals.get(productName),0) + regs;\n\tregionValue = ifnull(regionTotals.get(regionName),0) + regs;\n\ttypeValue = ifnull(typeTotals.get(typeName),0) + 1;\n\tproductTotals.put(productName,productValue);\n\tregionTotals.put(regionName,regionValue);\n\ttypeTotals.put(typeName,typeValue);\n\tif(productValue &gt; maxProduct) { maxProduct = productValue; }\n\tif(regionValue &gt; maxRegion) { maxRegion = regionValue; }\n}\nattendanceRate = 0.0;\nif(totalRegistrations &gt; 0) { attendanceRate = (totalAttendees * 100.0 / totalRegistrations).round(1); }\nsourceTotals = Map();\ncountryTotals = Map();\nfor each performanceRec in performanceRows\n{\n\tdimensionName = ifnull(performanceRec.Dimension_Value,&quot;Unspecified&quot;);\n\trowRegs = ifnull(performanceRec.Registrations,0);\n\trowAttendees = ifnull(performanceRec.Attendees,0);\n\tif(performanceRec.Dimension_Type == &quot;Source&quot;)\n\t{\n\t\tsourceTotals.put(dimensionName,ifnull(sourceTotals.get(dimensionName),0) + rowRegs);\n\t}\n\telse if(performanceRec.Dimension_Type == &quot;Country&quot;)\n\t{\n\t\tcountryTotals.put(dimensionName,ifnull(countryTotals.get(dimensionName),0) + rowRegs);\n\t}\n}\n%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);font-size:16px;line-height:1.5}.zcs-flex,.zcs-row{display:flex}.zcs-row{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-0{padding:0}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-24{font-size:1.5rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.md-page{background:#f5f7fa;padding:20px;color:var(--zcs-primary-text-color);font-family:Arial,sans-serif}.md-header{background:linear-gradient(125deg,var(--zcs_brand_color),#087f8c);color:#fff;border:0}.md-header h1{font-size:26px}.md-header p{opacity:.9}.md-actions a{color:#fff;border:1px solid rgba(255,255,255,.6);padding:8px 12px;border-radius:6px;text-decoration:none}.md-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:16px}.md-kpi{grid-column:span 3;min-height:126px}.md-kpi-icon{width:38px;height:38px;border-radius:10px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.md-chart{grid-column:span 6}.md-chart.third{grid-column:span 4}.md-table-card{grid-column:span 12}.md-section-title{margin-bottom:16px}.md-bar-row{display:grid;grid-template-columns:minmax(105px,1.2fr) 3fr 70px;gap:10px;align-items:center;margin:12px 0}.md-track{height:10px;background:var(--zcs_component_hover_color);border-radius:6px;overflow:hidden}.md-fill{height:100%;background:var(--zcs_brand_color);border-radius:6px}.md-fill.alt{background:#28a6a6}.md-donut{width:150px;height:150px;border-radius:50%;background:conic-gradient(var(--zcs_brand_color) 0 35%,#36a2eb 35% 60%,#ffb44a 60% 78%,#28cc97 78% 92%,#ff6283 92%);position:relative}.md-donut:after{content:&apos;&apos;;position:absolute;inset:34px;border-radius:50%;background:#fff}.md-legend{list-style:none}.md-legend li{margin:7px 0}.md-legend i{color:var(--zcs_brand_color);margin-right:6px}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;min-width:760px}.zcs-table-wrapper th{background:#f9fafe;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tbody tr:hover td{background:#f9fafe}.zcs-badge{width:auto;border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#2a6ffc}.md-filters a{text-decoration:none}.md-note{border-left:4px solid var(--zcs_brand_color)}.md-empty{padding:24px;text-align:center;color:var(--zcs-secondary-text-color)}@media(max-width:992px){.md-kpi,.md-chart.third{grid-column:span 6}.md-chart{grid-column:span 12}}@media(max-width:620px){.md-page{padding:10px}.md-kpi,.md-chart,.md-chart.third{grid-column:span 12}.md-header{align-items:flex-start;flex-direction:column}.md-actions{flex-wrap:wrap}.md-bar-row{grid-template-columns:90px 1fr 55px}}\n&lt;/style&gt;\n&lt;div class=&apos;md-page zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n\t&lt;header class=&apos;md-header zcs-card zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-p-24 zcs-box-border&apos;&gt;\n\t\t&lt;div&gt;&lt;h1 class=&apos;zcs-font-semibold zcs-lh-heading zcs-m-0&apos;&gt;Event Performance Metrics&lt;/h1&gt;&lt;p class=&apos;zcs-font-14 zcs-m-0&apos;&gt;Registrations, attendance, recorded revenue, and webinar dimensions&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;md-actions zcs-flex zcs-gap-8&apos;&gt;&lt;a href=&apos;#Report:Unified_Event_Summary&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-bar-32&apos;&gt;&lt;/i&gt; Event summary&lt;/a&gt;&lt;a href=&apos;#Report:Event_Performance_Details&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-content-03&apos;&gt;&lt;/i&gt; Breakdown data&lt;/a&gt;&lt;/div&gt;\n\t&lt;/header&gt;\n\t&lt;section class=&apos;md-filters zcs-card zcs-p-16 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12&apos; style=&apos;flex-wrap:wrap&apos;&gt;&lt;strong class=&apos;zcs-font-14&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-filter&apos;&gt;&lt;/i&gt; Quick filters&lt;/strong&gt;&lt;a class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-rounded-sm zcs-px-10 zcs-py-2&apos; href=&apos;#Report:Unified_Event_Summary&apos;&gt;Event&lt;/a&gt;&lt;a class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-rounded-sm zcs-px-10 zcs-py-2&apos; href=&apos;#Report:Unified_Event_Summary&apos;&gt;Product&lt;/a&gt;&lt;a class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-rounded-sm zcs-px-10 zcs-py-2&apos; href=&apos;#Report:Unified_Event_Summary&apos;&gt;Region&lt;/a&gt;&lt;a class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-rounded-sm zcs-px-10 zcs-py-2&apos; href=&apos;#Report:Unified_Event_Summary&apos;&gt;Event type&lt;/a&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Open Event Summary and use its Event, Product, Region, or Event Type filters; this dashboard reflects records visible to your profile.&lt;/span&gt;&lt;/div&gt;\n\t&lt;/section&gt;\n\t&lt;section class=&apos;md-grid&apos;&gt;\n\t\t&lt;div class=&apos;md-kpi zcs-card zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;zcs-color-secondary zcs-font-14&apos;&gt;Registrations&lt;/span&gt;&lt;span class=&apos;md-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline users-multiple-19&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-font-24 zcs-font-semibold&apos;&gt;&lt;%=totalRegistrations%&gt;&lt;/div&gt;&lt;small class=&apos;zcs-color-secondary&apos;&gt;Final event registrations&lt;/small&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;md-kpi zcs-card zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;zcs-color-secondary zcs-font-14&apos;&gt;Attendees&lt;/span&gt;&lt;span class=&apos;md-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-font-24 zcs-font-semibold&apos;&gt;&lt;%=totalAttendees%&gt;&lt;/div&gt;&lt;small class=&apos;zcs-color-secondary&apos;&gt;Final event attendees&lt;/small&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;md-kpi zcs-card zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;zcs-color-secondary zcs-font-14&apos;&gt;Attendance rate&lt;/span&gt;&lt;span class=&apos;md-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-pie-36&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-font-24 zcs-font-semibold&apos;&gt;&lt;%=attendanceRate%&gt;%&lt;/div&gt;&lt;small class=&apos;zcs-color-secondary&apos;&gt;Attendees divided by registrations&lt;/small&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;md-kpi zcs-card zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;zcs-color-secondary zcs-font-14&apos;&gt;Recorded revenue&lt;/span&gt;&lt;span class=&apos;md-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-money-coins&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-font-24 zcs-font-semibold&apos;&gt;&lt;%=totalRevenue.round(2)%&gt;&lt;/div&gt;&lt;small class=&apos;zcs-color-secondary&apos;&gt;Source units; no USD conversion applied&lt;/small&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;md-chart zcs-card zcs-p-20 zcs-box-border&apos;&gt;&lt;h2 class=&apos;md-section-title zcs-font-18 zcs-font-medium zcs-m-0&apos;&gt;Registrations by product&lt;/h2&gt;&lt;% if(productTotals.size() == 0) { %&gt;&lt;div class=&apos;md-empty&apos;&gt;No event metrics available.&lt;/div&gt;&lt;% } else { for each keyName in productTotals.keys() { productPct = (productTotals.get(keyName) * 100.0 / maxProduct).round(1); %&gt;&lt;div class=&apos;md-bar-row&apos;&gt;&lt;span class=&apos;zcs-font-14&apos;&gt;&lt;%=keyName%&gt;&lt;/span&gt;&lt;div class=&apos;md-track&apos;&gt;&lt;div class=&apos;md-fill&apos; style=&apos;width:&lt;%=productPct%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong class=&apos;zcs-text-right zcs-font-14&apos;&gt;&lt;%=productTotals.get(keyName)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;% } } %&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;md-chart zcs-card zcs-p-20 zcs-box-border&apos;&gt;&lt;h2 class=&apos;md-section-title zcs-font-18 zcs-font-medium zcs-m-0&apos;&gt;Registrations by region&lt;/h2&gt;&lt;% if(regionTotals.size() == 0) { %&gt;&lt;div class=&apos;md-empty&apos;&gt;No regional metrics available.&lt;/div&gt;&lt;% } else { for each regionKey in regionTotals.keys() { regionPct = (regionTotals.get(regionKey) * 100.0 / maxRegion).round(1); %&gt;&lt;div class=&apos;md-bar-row&apos;&gt;&lt;span class=&apos;zcs-font-14&apos;&gt;&lt;%=regionKey%&gt;&lt;/span&gt;&lt;div class=&apos;md-track&apos;&gt;&lt;div class=&apos;md-fill alt&apos; style=&apos;width:&lt;%=regionPct%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong class=&apos;zcs-text-right zcs-font-14&apos;&gt;&lt;%=regionTotals.get(regionKey)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;% } } %&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;md-chart third zcs-card zcs-p-20 zcs-box-border&apos;&gt;&lt;h2 class=&apos;md-section-title zcs-font-18 zcs-font-medium zcs-m-0&apos;&gt;Event-type distribution&lt;/h2&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-20&apos;&gt;&lt;div class=&apos;md-donut&apos;&gt;&lt;/div&gt;&lt;ul class=&apos;md-legend zcs-p-0 zcs-m-0&apos;&gt;&lt;% for each typeKey in typeTotals.keys() { %&gt;&lt;li class=&apos;zcs-font-14&apos;&gt;&lt;i class=&apos;zc-li-solid ui-1-circle&apos;&gt;&lt;/i&gt;&lt;%=typeKey%&gt;: &lt;strong&gt;&lt;%=typeTotals.get(typeKey)%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;% } %&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;md-chart third zcs-card zcs-p-20 zcs-box-border&apos;&gt;&lt;h2 class=&apos;md-section-title zcs-font-18 zcs-font-medium zcs-m-0&apos;&gt;Webinar registrations by source&lt;/h2&gt;&lt;% if(sourceTotals.size() == 0) { %&gt;&lt;div class=&apos;md-empty&apos;&gt;No source rows in Event Performance.&lt;/div&gt;&lt;% } else { for each sourceKey in sourceTotals.keys() { %&gt;&lt;div class=&apos;md-bar-row&apos;&gt;&lt;span class=&apos;zcs-font-14&apos;&gt;&lt;%=sourceKey%&gt;&lt;/span&gt;&lt;div class=&apos;md-track&apos;&gt;&lt;div class=&apos;md-fill&apos; style=&apos;width:&lt;%=if(totalRegistrations &gt; 0,(sourceTotals.get(sourceKey) * 100.0 / totalRegistrations).round(1),0)%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong class=&apos;zcs-text-right zcs-font-14&apos;&gt;&lt;%=sourceTotals.get(sourceKey)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;% } } %&gt;&lt;a class=&apos;zcs-color-theme zcs-font-14&apos; href=&apos;#Report:Source_Performance&apos;&gt;Open source report&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;md-chart third zcs-card zcs-p-20 zcs-box-border&apos;&gt;&lt;h2 class=&apos;md-section-title zcs-font-18 zcs-font-medium zcs-m-0&apos;&gt;Webinar registrations by country&lt;/h2&gt;&lt;% if(countryTotals.size() == 0) { %&gt;&lt;div class=&apos;md-empty&apos;&gt;No country rows in Event Performance.&lt;/div&gt;&lt;% } else { for each countryKey in countryTotals.keys() { %&gt;&lt;div class=&apos;md-bar-row&apos;&gt;&lt;span class=&apos;zcs-font-14&apos;&gt;&lt;%=countryKey%&gt;&lt;/span&gt;&lt;div class=&apos;md-track&apos;&gt;&lt;div class=&apos;md-fill alt&apos; style=&apos;width:&lt;%=if(totalRegistrations &gt; 0,(countryTotals.get(countryKey) * 100.0 / totalRegistrations).round(1),0)%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong class=&apos;zcs-text-right zcs-font-14&apos;&gt;&lt;%=countryTotals.get(countryKey)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;% } } %&gt;&lt;a class=&apos;zcs-color-theme zcs-font-14&apos; href=&apos;#Report:Country_Performance&apos;&gt;Open country report&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;md-table-card zcs-card zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 md-section-title&apos;&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-medium zcs-m-0&apos;&gt;Event-level performance&lt;/h2&gt;&lt;a class=&apos;zcs-color-theme zcs-font-14&apos; href=&apos;#Report:Unified_Event_Summary&apos;&gt;View all event records&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&apos;&gt;Event&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&apos;&gt;Product&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&apos;&gt;Region / Type&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&apos;&gt;Registrations&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&apos;&gt;Attendees&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&apos;&gt;Rate&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&apos;&gt;Revenue units&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;% for each eventRow in events { eventRate = 0.0; if(ifnull(eventRow.Final_Registrations,0) &gt; 0) { eventRate = (ifnull(eventRow.Final_Attendees,0) * 100.0 / eventRow.Final_Registrations).round(1); } %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-14&apos;&gt;&lt;strong&gt;&lt;%=eventRow.Event_Title%&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-14&apos;&gt;&lt;%=eventRow.Product.Product_Name%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-14&apos;&gt;&lt;%=eventRow.Region%&gt; / &lt;%=eventRow.Event_Type%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&apos;&gt;&lt;%=ifnull(eventRow.Final_Registrations,0)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&apos;&gt;&lt;%=ifnull(eventRow.Final_Attendees,0)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&apos;&gt;&lt;%=eventRate%&gt;%&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&apos;&gt;&lt;%=ifnull(eventRow.Final_Revenue,0).round(2)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;/section&gt;\n\t&lt;aside class=&apos;md-note zcs-card zcs-p-16 zcs-font-12 zcs-color-secondary&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-info&apos;&gt;&lt;/i&gt; Training Manager and Lead totals cover all records granted by profile permissions. Trainer totals and rows follow the assigned-event records visible to the logged-in user. Recorded revenue deliberately remains currency-independent because Events does not store a source currency or conversion rate.&lt;/aside&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Operations_Dashboard
		{
					displayname = "Operations Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Operations_Overview' elementName='Operations_Overview'>\n\t\t\t\t\t<![CDATA[htmlpage Operations_Overview()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nuserName = zoho.loginuser;\nmemberType = &quot;Operational user&quot;;\nmemberRows = Team_Members[Email == zoho.loginuserid];\nif(memberRows.count() &gt; 0)\n{\n\tuserName = ifnull(memberRows.Employee_Name.first_name,zoho.loginuser);\n\tmemberType = memberRows.Member_Type;\n}\nallEvents = Events[Event_Status != &quot;Cancelled&quot;];\nupcomingEvents = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; Start_Date_Time &gt;= zoho.currenttime &amp;&amp; Start_Date_Time &lt;= zoho.currenttime.addDay(30)] sort by Start_Date_Time asc;\nactiveCount = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; Event_Status != &quot;Closed&quot; &amp;&amp; Lifecycle_Stage != &quot;Completed&quot;].count();\nnotReadyCount = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; Start_Date_Time &gt;= zoho.currenttime &amp;&amp; Readiness_Status != &quot;Ready&quot;].count();\nincompleteClosureCount = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; (Lifecycle_Stage == &quot;Post-Event&quot; || Event_Status == &quot;Delivered&quot;) &amp;&amp; (Recording_URL is null || Description_URL is null || Upload_Status == &quot;Pending&quot;)].count();\npreCount = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; Lifecycle_Stage == &quot;Pre-Event&quot;].count();\nduringCount = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; Lifecycle_Stage == &quot;During Event&quot;].count();\npostCount = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; Lifecycle_Stage == &quot;Post-Event&quot;].count();\ncompletedCount = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; Lifecycle_Stage == &quot;Completed&quot;].count();\ntotalCount = allEvents.count();\nif(totalCount == 0)\n{\n\ttotalCount = 1;\n}\nprePct = (preCount * 100.0 / totalCount).round(0);\nduringPct = (duringCount * 100.0 / totalCount).round(0);\npostPct = (postCount * 100.0 / totalCount).round(0);\ncompletedPct = (completedCount * 100.0 / totalCount).round(0);\nreadyPct = ((allEvents.count() - Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; Readiness_Status != &quot;Ready&quot;].count()) * 100.0 / totalCount).round(0);\nclosurePct = (completedCount * 100.0 / totalCount).round(0);\nmissingGeneral = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; General_Document_URL is null].count();\nmissingPresentation = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; Presentation_URL is null].count();\nmissingDryRun = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; Dry_Run_URL is null &amp;&amp; Event_Type != &quot;Certification&quot;].count();\nmissingSurvey = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; Survey_URL is null &amp;&amp; Event_Type != &quot;Webinar&quot; &amp;&amp; Event_Type != &quot;Certification&quot;].count();\n%&gt;\n&lt;style&gt;\n:root{--zcs-page-bg-color:#f3f3f4;--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color)}*{box-sizing:border-box}.zcs-flex,.zcs-row{display:flex}.zcs-row{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-gap-20{gap:20px}.zcs-p-0{padding:0}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-p-24{padding:24px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-normal{font-weight:400}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.zcs-col-3{width:calc(25% - 15px)}.zcs-col-5{width:calc(41.667% - 10px)}.zcs-col-7{width:calc(58.333% - 10px)}.zcs-col-12{width:100%}.ops-page{background:var(--zcs-page-bg-color);padding:24px 30px;min-height:100%}.ops-header{background:linear-gradient(120deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));color:var(--zcs_brand_foreground_color);padding:24px;border-radius:12px}.ops-header h2,.ops-header p{color:inherit}.ops-actions{flex-wrap:wrap}.zcs-button{min-height:36px;border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color);text-decoration:none}.zcs-button:hover{background:var(--zcs_component_hover_color)}.zcs-panel-wrapper ul,.zcs-quick-actions-wrapper ul{list-style:none}.zcs-panel{border:1px solid var(--zcs_tertiary_border_color);box-shadow:0 2px 8px #f2f2f6;background:#fff}.zcs-panel-icon-wrapper{width:40px;height:40px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color)}.zcs-progress-bar-indicator{height:100%;border-radius:inherit;background:var(--zcs_brand_color)}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent;color:#fff}.zcs-badge-green{background:#179e6c}.zcs-badge-red{background:#fe455d}.zcs-badge-yellow{background:#faae13}.zcs-badge-blue{background:#2a6ffc}.zcs-badge-grey{background:#555}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;min-width:760px}.zcs-table-wrapper th{background:#f9fafe}.zcs-table-wrapper th,.zcs-table-wrapper td{padding:10px 16px;text-align:left;border-bottom:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tr:hover td{background:#f9fafe}.section-title{margin:0 0 16px}.checklist{list-style:none;padding:0;margin:0}.checklist li{padding:10px 0;border-bottom:1px solid var(--zcs_tertiary_border_color)}.checklist i{color:#b8770d}.zcs-quick-action-item:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-link{text-decoration:none}.role-note{opacity:.9}.empty{padding:28px;text-align:center;color:var(--zcs_tertiary_text_color)}@media(max-width:992px){.zcs-col-3,.zcs-col-5,.zcs-col-7{width:calc(50% - 10px)}}@media(max-width:640px){.ops-page{padding:16px}.zcs-col-3,.zcs-col-5,.zcs-col-7{width:100%}.ops-header{align-items:flex-start;flex-direction:column}.ops-actions{width:100%}.zcs-button{flex:1}.hide-mobile{display:none}}\n&lt;/style&gt;\n&lt;div class=&apos;ops-page zcs-flex zcs-direction-column zcs-gap-20&apos;&gt;\n\t&lt;div class=&apos;ops-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&apos;&gt;\n\t\t&lt;div&gt;&lt;h2 class=&apos;zcs-font-24 zcs-font-semibold zcs-m-0&apos;&gt;Operations dashboard&lt;/h2&gt;&lt;p class=&apos;zcs-font-14 zcs-m-0&apos;&gt;Hello &lt;%=userName%&gt;. Upcoming delivery, readiness, lifecycle and closure control.&lt;/p&gt;&lt;p class=&apos;role-note zcs-font-12 zcs-m-0&apos;&gt;&lt;%=memberType%&gt; view. Trainer assignments are emphasized in the schedule.&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;ops-actions zcs-flex zcs-gap-8&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Report:Unified_Event_Summary&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-doc&apos;&gt;&lt;/i&gt;&lt;span&gt;Event summary&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Report:Event_Calendar&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span&gt;Calendar&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Report:Incomplete_Event_Activities&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt;&lt;span&gt;Closure work&lt;/span&gt;&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;zcs-panel-wrapper&apos;&gt;&lt;ul class=&apos;zcs-row zcs-gap-20 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t&lt;li class=&apos;zcs-col-3&apos;&gt;&lt;div class=&apos;zcs-panel zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-font-24 zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&apos;zcs-font-20 zcs-m-0&apos;&gt;&lt;%=upcomingEvents.count()%&gt;&lt;/h4&gt;&lt;/div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Upcoming events, next 30 days&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t&lt;li class=&apos;zcs-col-3&apos;&gt;&lt;div class=&apos;zcs-panel zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-font-24 zc-li-outline loader-dots-06&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&apos;zcs-font-20 zcs-m-0&apos;&gt;&lt;%=activeCount%&gt;&lt;/h4&gt;&lt;/div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Active events&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t&lt;li class=&apos;zcs-col-3&apos;&gt;&lt;div class=&apos;zcs-panel zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-font-24 zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&apos;zcs-font-20 zcs-m-0&apos;&gt;&lt;%=notReadyCount%&gt;&lt;/h4&gt;&lt;/div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Not-ready events&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t&lt;li class=&apos;zcs-col-3&apos;&gt;&lt;div class=&apos;zcs-panel zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-font-24 zc-li-outline arrows-4-restore&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&apos;zcs-font-20 zcs-m-0&apos;&gt;&lt;%=incompleteClosureCount%&gt;&lt;/h4&gt;&lt;/div&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Incomplete closures&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n\t&lt;/ul&gt;&lt;/div&gt;\n\t&lt;div class=&apos;zcs-card zcs-p-20&apos;&gt;&lt;h3 class=&apos;section-title zcs-font-18&apos;&gt;Upcoming events&lt;/h3&gt;&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Event&lt;/th&gt;&lt;th&gt;Date&lt;/th&gt;&lt;th&gt;Type&lt;/th&gt;&lt;th&gt;Trainer&lt;/th&gt;&lt;th&gt;Readiness&lt;/th&gt;&lt;th&gt;Lifecycle&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t&lt;% shown = 0; for each eventRec in upcomingEvents { if(shown &lt; 8) { assigned = false; if(memberRows.count() &gt; 0 &amp;&amp; eventRec.Primary_Trainer == memberRows.ID) { assigned = true; } badgeClass = &quot;zcs-badge-yellow&quot;; if(eventRec.Readiness_Status == &quot;Ready&quot;) { badgeClass = &quot;zcs-badge-green&quot;; } else if(eventRec.Readiness_Status == &quot;Not Ready&quot;) { badgeClass = &quot;zcs-badge-red&quot;; } lifecycleClass = &quot;zcs-badge-blue&quot;; if(eventRec.Lifecycle_Stage == &quot;Completed&quot;) { lifecycleClass = &quot;zcs-badge-green&quot;; } %&gt;\n\t\t&lt;tr&gt;&lt;td&gt;&lt;strong&gt;&lt;%=eventRec.Event_Title%&gt;&lt;/strong&gt;&lt;% if(assigned) { %&gt;&lt;div class=&apos;zcs-font-12&apos; style=&apos;color:var(--zcs_brand_color)&apos;&gt;Assigned to you&lt;/div&gt;&lt;% } %&gt;&lt;/td&gt;&lt;td&gt;&lt;%=eventRec.Start_Date_Time.toString(&quot;dd MMM yyyy&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=eventRec.Event_Type%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=eventRec.Primary_Trainer.Employee_Name.first_name%&gt;&lt;/td&gt;&lt;td&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled &lt;%=badgeClass%&gt; zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;%=eventRec.Readiness_Status%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled &lt;%=lifecycleClass%&gt; zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;%=eventRec.Lifecycle_Stage%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n\t&lt;% shown = shown + 1; } } if(shown == 0) { %&gt;&lt;tr&gt;&lt;td colspan=&apos;6&apos;&gt;&lt;div class=&apos;empty&apos;&gt;No upcoming events in the next 30 days.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&apos;zcs-row zcs-gap-20&apos;&gt;\n\t\t&lt;div class=&apos;zcs-col-7 zcs-card zcs-p-24&apos;&gt;&lt;h3 class=&apos;section-title zcs-font-18&apos;&gt;Lifecycle distribution&lt;/h3&gt;&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n\t\t\t&lt;% labels={&quot;Pre-Event&quot;,&quot;During Event&quot;,&quot;Post-Event&quot;,&quot;Completed&quot;}; values={preCount,duringCount,postCount,completedCount}; pcts={prePct,duringPct,postPct,completedPct}; for each index i in labels { %&gt;&lt;div class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=pcts.get(i)%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-font-12 zcs-font-medium zcs-m-0&apos;&gt;&lt;span&gt;&lt;%=labels.get(i)%&gt;&lt;/span&gt;&lt;span&gt;&lt;%=values.get(i)%&gt; events, &lt;%=pcts.get(i)%&gt;%&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-col-5 zcs-card zcs-p-24&apos;&gt;&lt;h3 class=&apos;section-title zcs-font-18&apos;&gt;Completion progress&lt;/h3&gt;&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-20&apos;&gt;&lt;div class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&apos;&gt;&lt;p class=&apos;zcs-flex zcs-justify-space-between zcs-m-0&apos;&gt;&lt;span&gt;Readiness complete&lt;/span&gt;&lt;strong&gt;&lt;%=readyPct%&gt;%&lt;/strong&gt;&lt;/p&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=readyPct%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&apos;&gt;&lt;p class=&apos;zcs-flex zcs-justify-space-between zcs-m-0&apos;&gt;&lt;span&gt;Lifecycle closed&lt;/span&gt;&lt;strong&gt;&lt;%=closurePct%&gt;%&lt;/strong&gt;&lt;/p&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=closurePct%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;zcs-row zcs-gap-20&apos;&gt;\n\t\t&lt;div class=&apos;zcs-col-7 zcs-card zcs-p-20&apos;&gt;&lt;h3 class=&apos;section-title zcs-font-18&apos;&gt;Missing URL and activity checklist&lt;/h3&gt;&lt;ul class=&apos;checklist&apos;&gt;&lt;li class=&apos;zcs-flex zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt; General document URL missing&lt;/span&gt;&lt;strong&gt;&lt;%=missingGeneral%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;li class=&apos;zcs-flex zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt; Presentation URL missing&lt;/span&gt;&lt;strong&gt;&lt;%=missingPresentation%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;li class=&apos;zcs-flex zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt; Dry-run URL missing&lt;/span&gt;&lt;strong&gt;&lt;%=missingDryRun%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;li class=&apos;zcs-flex zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt; Survey URL missing for training&lt;/span&gt;&lt;strong&gt;&lt;%=missingSurvey%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-col-5 zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16&apos;&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Quick links&lt;/h3&gt;&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&apos;&gt;&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-color-primary&apos; href=&apos;#Report:Unified_Event_Summary&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-doc&apos;&gt;&lt;/i&gt;&lt;span&gt;Unified event summary&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-color-primary&apos; href=&apos;#Report:Event_Calendar&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span&gt;Event calendar&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-color-primary&apos; href=&apos;#Report:Incomplete_Event_Activities&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt;&lt;span&gt;Incomplete event activities&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Trainer_Dashboard
		{
					displayname = "Trainer Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Trainer_Dashboard_Content' elementName='Trainer_Dashboard_Content'>\n\t\t\t\t\t<![CDATA[htmlpage Trainer_Dashboard_Content()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nmember = Team_Members[Email == zoho.loginuserid];\nviewerName = zoho.loginuser;\nviewerType = &quot;Lead&quot;;\nmemberId = 0;\nif(member.count() &gt; 0)\n{\n\t\tviewerName = member.Employee_Name;\n\t\tviewerType = member.Member_Type;\n\t\tmemberId = member.ID;\n}\nisManager = viewerType == &quot;Training Manager&quot;;\nisTrainer = viewerType == &quot;Trainer&quot;;\nif(isManager || viewerType == &quot;Lead&quot;)\n{\n\t\teventRows = Events[Event_Status != &quot;Cancelled&quot; &amp;&amp; Event_Status != &quot;Closed&quot;] sort by Start_Date_Time asc;\n\t\ttaskRows = Tasks[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Cancelled&quot;];\n}\nelse\n{\n\t\teventRows = Events[(Primary_Trainer == memberId || Additional_Trainers == memberId || QA_Trainer == memberId) &amp;&amp; Event_Status != &quot;Cancelled&quot; &amp;&amp; Event_Status != &quot;Closed&quot;] sort by Start_Date_Time asc;\n\t\ttaskRows = Tasks[Assigned_To == memberId &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Cancelled&quot;];\n}\nupcomingCount = 0;\nqaCount = 0;\noverdueCount = 0;\nfor each ev in eventRows\n{\n\t\tif(ev.Start_Date_Time &gt;= zoho.currenttime)\n\t\t{\n\t\t\t\tupcomingCount = upcomingCount + 1;\n\t\t}\n\t\tif(ev.QA_Trainer != null &amp;&amp; (isManager || viewerType == &quot;Lead&quot; || ev.QA_Trainer == memberId))\n\t\t{\n\t\t\t\tqaCount = qaCount + 1;\n\t\t}\n\t\tif(ev.End_Date_Time &lt; zoho.currenttime &amp;&amp; ev.Lifecycle_Stage != &quot;Completed&quot;)\n\t\t{\n\t\t\t\toverdueCount = overdueCount + 1;\n\t\t}\n}\nopenTaskCount = taskRows.count();\ntotalEvents = eventRows.count();\nmaxWorkload = if(totalEvents &gt; 0,totalEvents,1);\n%&gt;\n&lt;style&gt;\n/* ZCS global utility sheet, included once for this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;--zcs-page-bg-color:#f3f3f4;--zcs-thead-color:#f9fafe;--column-gap:0px;font-size:16px;line-height:1.5}.zcs-row,.zcs-flex{display:flex}.zcs-row{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-p-0{padding:0}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-m-0{margin:0}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-inline-flex{display:inline-flex}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}\n.trainer-dashboard{background:var(--zcs-page-bg-color);padding:20px;min-height:100%;font-family:Arial,sans-serif}.dashboard-header{background:linear-gradient(115deg,var(--zcs_brand_dark_color),var(--zcs_brand_color));color:var(--zcs_brand_foreground_color);border-radius:16px;padding:24px 28px}.dashboard-header h1,.dashboard-header p{color:inherit}.scope-pill{background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.28);padding:6px 10px;border-radius:999px}.metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.metric-card{min-height:130px}.metric-icon{width:40px;height:40px;border-radius:10px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);font-size:20px}.metric-value{font-size:30px;font-weight:700;color:var(--zcs_primary_text_color)}.section-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.55fr);gap:16px}.distribution-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.section-title{padding-bottom:14px;border-bottom:1px solid var(--zcs_tertiary_border_color)}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color);border-radius:4px;overflow:hidden}.zcs-progress-bar-indicator{height:100%;border-radius:inherit;background:var(--zcs_brand_color)}.bar-list{list-style:none}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:var(--zcs-white-color);overflow:auto;border-radius:8px}.zcs-table-wrapper table{border-collapse:collapse;min-width:780px}.zcs-table-wrapper th{background:var(--zcs-thead-color);white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tr:hover td{background:#f9fafe}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent;color:#fff}.zcs-badge-theme{background:var(--zcs_brand_color)}.zcs-badge-blue{background:#2a6ffc}.zcs-badge-orange{background:#f4660c}.zcs-badge-red{background:#fe455d}.zcs-badge-yellow{background:#faae13}.zcs-button{width:auto;min-width:5rem;min-height:36px;text-decoration:none}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}.empty-row{padding:28px;text-align:center;color:var(--zcs_tertiary_text_color)}\n@media(max-width:992px){.metric-grid{grid-template-columns:repeat(2,1fr)}.section-grid{grid-template-columns:1fr}.distribution-grid{grid-template-columns:1fr}}@media(max-width:576px){.trainer-dashboard{padding:12px}.metric-grid{grid-template-columns:1fr}.dashboard-header{padding:20px}.dashboard-header&gt;.zcs-flex{align-items:flex-start;flex-direction:column}.header-actions{width:100%;flex-wrap:wrap}.header-actions .zcs-button{flex:1}}\n&lt;/style&gt;\n&lt;div class=&apos;trainer-dashboard zcs-flex zcs-direction-column zcs-gap-16 zcs-box-border&apos;&gt;\n\t&lt;div class=&apos;dashboard-header&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&apos;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-m-0&apos;&gt;Training delivery workspace&lt;/p&gt;\n\t\t\t\t&lt;h1 class=&apos;zcs-font-24 zcs-font-semibold zcs-m-0&apos;&gt;Trainer Dashboard&lt;/h1&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-m-0&apos;&gt;Hello &lt;%=viewerName%&gt;. Review assignments, Q&amp;amp;A duties, workload, and delivery follow-ups.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 header-actions&apos;&gt;\n\t\t\t\t&lt;span class=&apos;scope-pill zcs-font-13&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-05&apos;&gt;&lt;/i&gt; &lt;%=if(isManager,&quot;All trainers&quot;,if(isTrainer,&quot;Personal workload&quot;,&quot;Read-only overview&quot;))%&gt;&lt;/span&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Report:My_Assigned_Events&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-60&apos;&gt;&lt;/i&gt;&lt;span&gt;My events&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Report:My_Assigned_Tasks&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;My tasks&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;metric-grid&apos;&gt;\n\t\t&lt;div class=&apos;zcs-card metric-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;Assigned upcoming events&lt;/span&gt;&lt;span class=&apos;metric-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-60&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&apos;metric-value&apos;&gt;&lt;%=upcomingCount%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Planned from today onward&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card metric-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;Q&amp;amp;A assignments&lt;/span&gt;&lt;span class=&apos;metric-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-chat-round-content&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&apos;metric-value&apos;&gt;&lt;%=qaCount%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Active Q&amp;amp;A delivery duties&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card metric-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;Overdue updates&lt;/span&gt;&lt;span class=&apos;metric-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&apos;metric-value&apos;&gt;&lt;%=overdueCount%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Ended but lifecycle not completed&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card metric-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;Open tasks&lt;/span&gt;&lt;span class=&apos;metric-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline design-bullet-list-67&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&apos;metric-value&apos;&gt;&lt;%=openTaskCount%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Open, in progress, or blocked&lt;/span&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;section-grid&apos;&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;section-title zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Compact assignment register&lt;/h2&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Upcoming and active delivery assignments&lt;/p&gt;&lt;/div&gt;&lt;a class=&apos;zcs-color-theme zcs-font-13&apos; href=&apos;#Report:My_Assigned_Events&apos;&gt;Open report&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Event&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Trainer&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Role&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Product / Region&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Start&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;Stage&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t&lt;% rowCount = 0; for each ev in eventRows { if(ev.Start_Date_Time &gt;= zoho.currenttime.subDay(30) &amp;&amp; rowCount &lt; 8) { roleLabel = &quot;Additional&quot;; roleClass = &quot;zcs-badge-blue&quot;; trainerLabel = ev.Additional_Trainers; if(!isManager &amp;&amp; !isTrainer &amp;&amp; viewerType == &quot;Lead&quot;) { trainerLabel = ev.Primary_Trainer; roleLabel = &quot;Primary&quot;; roleClass = &quot;zcs-badge-theme&quot;; } else if(ev.Primary_Trainer == memberId || isManager) { trainerLabel = ev.Primary_Trainer; roleLabel = &quot;Primary&quot;; roleClass = &quot;zcs-badge-theme&quot;; } if(!isManager &amp;&amp; ev.QA_Trainer == memberId) { trainerLabel = ev.QA_Trainer; roleLabel = &quot;Q&amp;A&quot;; roleClass = &quot;zcs-badge-orange&quot;; } rowCount = rowCount + 1; %&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13 zcs-color-primary&apos;&gt;&lt;strong&gt;&lt;%=ev.Event_Title%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;&lt;%=ev.Event_Type%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13&apos;&gt;&lt;%=trainerLabel%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=roleClass%&gt;&apos;&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;&lt;%=roleLabel%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13&apos;&gt;&lt;%=ev.Product%&gt;&lt;br&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;&lt;%=ev.Region%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13&apos;&gt;&lt;%=ev.Start_Date_Time%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13&apos;&gt;&lt;%=ev.Lifecycle_Stage%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;% } } if(rowCount == 0) { %&gt;&lt;tr&gt;&lt;td colspan=&apos;6&apos; class=&apos;empty-row&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-60&apos;&gt;&lt;/i&gt; No current assignments found.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;section-title&apos;&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Workload by trainer&lt;/h2&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Active event allocation&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;ul class=&apos;bar-list zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0&apos;&gt;\n\t\t\t&lt;% trainerShown = 0; for each tr in Team_Members[Active == true &amp;&amp; Member_Type == &quot;Trainer&quot;] { trainerLoad = Events[(Primary_Trainer == tr.ID || Additional_Trainers == tr.ID || QA_Trainer == tr.ID) &amp;&amp; Event_Status != &quot;Cancelled&quot; &amp;&amp; Event_Status != &quot;Closed&quot;].count(); if(isManager || viewerType == &quot;Lead&quot; || tr.ID == memberId) { trainerShown = trainerShown + 1; trainerPct = if(maxWorkload &gt; 0,(trainerLoad * 100 / maxWorkload),0); if(trainerPct &gt; 100) { trainerPct = 100; } %&gt;\n\t\t\t\t&lt;li class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-font-13&apos;&gt;&lt;span class=&apos;zcs-color-primary&apos;&gt;&lt;%=tr.Employee_Name%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;&lt;%=trainerLoad%&gt; events&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=trainerPct%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t&lt;% } } if(trainerShown == 0) { %&gt;&lt;li class=&apos;empty-row&apos;&gt;No trainer workload found.&lt;/li&gt;&lt;% } %&gt;\n\t\t\t&lt;/ul&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;distribution-grid&apos;&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Workload by product&lt;/h2&gt;&lt;/div&gt;&lt;ul class=&apos;bar-list zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0&apos;&gt;&lt;% for each pr in Products[Active == true] { productLoad = 0; for each ev in eventRows { if(ev.Product == pr.ID) { productLoad = productLoad + 1; } } if(productLoad &gt; 0) { pct = productLoad * 100 / maxWorkload; %&gt;&lt;li class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-font-13&apos;&gt;&lt;span&gt;&lt;%=pr.Product_Name%&gt;&lt;/span&gt;&lt;span&gt;&lt;%=productLoad%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=pct%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;&lt;% } } %&gt;&lt;/ul&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Workload by region&lt;/h2&gt;&lt;/div&gt;&lt;ul class=&apos;bar-list zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0&apos;&gt;&lt;% regionNames = {&quot;Americas&quot;,&quot;EMEA&quot;,&quot;APAC&quot;,&quot;India&quot;,&quot;Global&quot;,&quot;Other&quot;}; for each regionName in regionNames { regionLoad = 0; for each ev in eventRows { if(ev.Region == regionName) { regionLoad = regionLoad + 1; } } if(regionLoad &gt; 0) { pct = regionLoad * 100 / maxWorkload; %&gt;&lt;li class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-font-13&apos;&gt;&lt;span&gt;&lt;%=regionName%&gt;&lt;/span&gt;&lt;span&gt;&lt;%=regionLoad%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=pct%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;&lt;% } } %&gt;&lt;/ul&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Workload by event type&lt;/h2&gt;&lt;/div&gt;&lt;ul class=&apos;bar-list zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0&apos;&gt;&lt;% typeNames = {&quot;Webinar&quot;,&quot;Online Training&quot;,&quot;Customized Training&quot;,&quot;In-Person Training&quot;,&quot;Certification&quot;}; for each typeName in typeNames { typeLoad = 0; for each ev in eventRows { if(ev.Event_Type == typeName) { typeLoad = typeLoad + 1; } } if(typeLoad &gt; 0) { pct = typeLoad * 100 / maxWorkload; %&gt;&lt;li class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-font-13&apos;&gt;&lt;span&gt;&lt;%=typeName%&gt;&lt;/span&gt;&lt;span&gt;&lt;%=typeLoad%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=pct%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;&lt;% } } %&gt;&lt;/ul&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Pending delivery updates&lt;/h2&gt;&lt;/div&gt;&lt;ul class=&apos;bar-list zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0&apos;&gt;&lt;% updateShown = 0; for each ev in eventRows { if(ev.End_Date_Time &lt; zoho.currenttime &amp;&amp; ev.Lifecycle_Stage != &quot;Completed&quot; &amp;&amp; updateShown &lt; 5) { updateShown = updateShown + 1; %&gt;&lt;li class=&apos;zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;span class=&apos;zcs-font-13&apos;&gt;&lt;strong&gt;&lt;%=ev.Event_Title%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;&lt;%=ev.Primary_Trainer%&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-red zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Overdue&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;% } } if(updateShown == 0) { %&gt;&lt;li class=&apos;empty-row&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt; No overdue delivery updates.&lt;/li&gt;&lt;% } %&gt;&lt;/ul&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Initialize_Discount as "Initialize Discount"
			{
			    type = form
			    form = Discounts
			    record event = on add
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_member = Team_Members[Email == zoho.loginuserid];
			                is_lead = thisapp.permissions.isUserInProfile("Lead");
			                is_training_manager = thisapp.permissions.isUserInProfile("Training_Manager");
			                if(current_member.ID != null)
			                {
			                    input.Requested_By = current_member.ID;
			                }
			                disable Requested_By;
			                disable Approval_Status;
			                disable Approved_By;
			                disable Approval_Date;
			                if(input.Event != null)
			                {
			                    selected_event = Events[ID == input.Event];
			                    input.Product = selected_event.Product;
			                    if(selected_event.Final_Revenue != null && selected_event.Final_Revenue > 0)
			                    {
			                        input.Gross_Revenue = selected_event.Final_Revenue;
			                    }
			                    else if(selected_event.Pre_Revenue != null)
			                    {
			                        input.Gross_Revenue = selected_event.Pre_Revenue;
			                    }
			                }
			                if(!is_lead && !is_training_manager)
			                {
			                    hide Approval;
			                    disable Approval_Comments;
			                }
			            )
			        }
			    }
			}

			Load_Discount_Edit as "Load Discount Edit"
			{
			    type = form
			    form = Discounts
			    record event = on edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                is_lead = thisapp.permissions.isUserInProfile("Lead");
			                is_training_manager = thisapp.permissions.isUserInProfile("Training_Manager");
			                disable Requested_By;
			                disable Approval_Status;
			                disable Approved_By;
			                disable Approval_Date;
			                if(!is_lead && !is_training_manager)
			                {
			                    hide Approval;
			                    disable Approval_Comments;
			                }
			                else
			                {
			                    show Approval;
			                    enable Approval_Comments;
			                }
			            )
			        }
			    }
			}

			Refresh_Discount_Event as "Refresh Discount Event"
			{
			    type = form
			    form = Discounts
			    record event = on add or edit
			
			    on user input of Event
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Event != null)
			                {
			                    selected_event = Events[ID == input.Event];
			                    input.Product = selected_event.Product;
			                    if(selected_event.Final_Revenue != null && selected_event.Final_Revenue > 0)
			                    {
			                        input.Gross_Revenue = selected_event.Final_Revenue;
			                    }
			                    else if(selected_event.Pre_Revenue != null)
			                    {
			                        input.Gross_Revenue = selected_event.Pre_Revenue;
			                    }
			                }
			                else
			                {
			                    input.Product = null;
			                    input.Gross_Revenue = null;
			                }
			            )
			        }
			    }
			}

			Validate_Discount_Edit as "Validate Discount Edit"
			{
			    type = form
			    form = Discounts
			    record event = on edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                is_lead = thisapp.permissions.isUserInProfile("Lead");
			                if(input.Discount_Percentage < 0 || input.Discount_Percentage > 100)
			                {
			                    alert "Discount percentage must be between 0 and 100.";
			                    cancel submit;
			                }
			                if(input.Discount_Count <= 0)
			                {
			                    alert "Discount count must be positive.";
			                    cancel submit;
			                }
			                if(input.Gross_Revenue < 0)
			                {
			                    alert "Gross revenue cannot be negative.";
			                    cancel submit;
			                }
			                if(input.Approval_Status == "Rejected" && (input.Approval_Comments == null || input.Approval_Comments.trim() == ""))
			                {
			                    alert "Approval comments are required when rejecting a discount.";
			                    cancel submit;
			                }
			                if(old.Approval_Status != input.Approval_Status && !is_lead)
			                {
			                    alert "Only a Lead may approve or reject a discount.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Validate_New_Discount as "Validate New Discount"
			{
			    type = form
			    form = Discounts
			    record event = on add
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Discount_Percentage < 0 || input.Discount_Percentage > 100)
			                {
			                    alert "Discount percentage must be between 0 and 100.";
			                    cancel submit;
			                }
			                if(input.Discount_Count <= 0)
			                {
			                    alert "Discount count must be positive.";
			                    cancel submit;
			                }
			                if(input.Gross_Revenue < 0)
			                {
			                    alert "Gross revenue cannot be negative.";
			                    cancel submit;
			                }
			                if(input.Approval_Status == "Rejected" && (input.Approval_Comments == null || input.Approval_Comments.trim() == ""))
			                {
			                    alert "Approval comments are required when rejecting a discount.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Validate_Event_Performance as "Validate Event Performance"
			{
			    type = form
			    form = Event_Performance
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Registrations < 0 || input.Attendees < 0)
			                {
			                    alert "Registrations and attendees cannot be negative.";
			                    cancel submit;
			                }
			                selected_event = Events[ID == input.Event];
			                if(selected_event.ID == null || selected_event.Event_Type != "Webinar")
			                {
			                    alert "Event performance can only be recorded for a Webinar event.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Event_Type_On_Load as "Event Type On Load"
			{
			    type = form
			    form = Events
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                hide Webinar_Promotion;
			                hide Certification;
			                show Additional_Trainers;
			                show QA_Trainer;
			                show Trainer_Split;
			                show Survey_URL;
			                show Pre_Revenue;
			                show Final_Revenue;
			                show Upload_Destination;
			                if(input.Event_Type == "Webinar")
			                {
			                    show Webinar_Promotion;
			                    show QA_Trainer;
			                    show Upload_Destination;
			                    hide Additional_Trainers;
			                    hide Trainer_Split;
			                    hide Survey_URL;
			                    hide Pre_Revenue;
			                    hide Final_Revenue;
			                }
			                else if(input.Event_Type == "Certification")
			                {
			                    show Certification;
			                    hide Webinar_Promotion;
			                    hide Additional_Trainers;
			                    hide QA_Trainer;
			                    hide Trainer_Split;
			                    hide Survey_URL;
			                    hide Pre_Revenue;
			                    hide Final_Revenue;
			                    hide Recording_Status;
			                    hide Upload_Destination;
			                    hide Upload_Status;
			                }
			            )
			        }
			    }
			}

			Event_Type_On_User_Input as "Event Type On User Input"
			{
			    type = form
			    form = Events
			    record event = on add or edit
			
			    on user input of Event_Type
			    {
			        actions
			        {
			            custom deluge script
			            (
			                hide Webinar_Promotion;
			                hide Certification;
			                show Additional_Trainers;
			                show QA_Trainer;
			                show Trainer_Split;
			                show Survey_URL;
			                show Pre_Revenue;
			                show Final_Revenue;
			                show Recording_Status;
			                show Upload_Destination;
			                show Upload_Status;
			                if(input.Event_Type == "Webinar")
			                {
			                    show Webinar_Promotion;
			                    hide Additional_Trainers;
			                    hide Trainer_Split;
			                    hide Survey_URL;
			                    hide Pre_Revenue;
			                    hide Final_Revenue;
			                    input.Upload_Destination = "Trainer Central";
			                }
			                else if(input.Event_Type == "Online Training" || input.Event_Type == "Customized Training" || input.Event_Type == "In-Person Training")
			                {
			                    input.Upload_Destination = "WorkDrive";
			                }
			                else if(input.Event_Type == "Certification")
			                {
			                    show Certification;
			                    hide Additional_Trainers;
			                    hide QA_Trainer;
			                    hide Trainer_Split;
			                    hide Survey_URL;
			                    hide Pre_Revenue;
			                    hide Final_Revenue;
			                    hide Recording_Status;
			                    hide Upload_Destination;
			                    hide Upload_Status;
			                }
			            )
			        }
			    }
			}

			Lifecycle_On_Load as "Lifecycle On Load"
			{
			    type = form
			    form = Events
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Lifecycle_Stage;
			                if(input.Lifecycle_Stage == "Pre-Event")
			                {
			                    disable Pre_Registrations;
			                    disable Pre_Revenue;
			                    disable Live_Registrations;
			                    disable Live_Attendees;
			                    disable Recording_Status;
			                    disable Recording_URL;
			                    disable Description_URL;
			                    disable Final_Registrations;
			                    disable Final_Attendees;
			                    disable Final_Revenue;
			                    disable Insights_URL;
			                    disable Debrief_Recording_URL;
			                    disable MOM_Notes;
			                    disable Upload_Destination;
			                    disable Upload_Status;
			                    enable Event_Title;
			                    enable Event_Type;
			                    enable Product;
			                    enable Region;
			                    enable Start_Date_Time;
			                    enable End_Date_Time;
			                    enable Primary_Trainer;
			                    enable Additional_Trainers;
			                    enable QA_Trainer;
			                    enable Topic;
			                    enable Agenda;
			                    enable Trainer_Split;
			                    enable General_Document_URL;
			                    enable Presentation_URL;
			                    enable Dry_Run_URL;
			                    enable Survey_URL;
			                    enable Readiness_Status;
			                    enable Missing_Activity_Notes;
			                }
			                else if(input.Lifecycle_Stage == "During Event")
			                {
			                    disable Event_Title;
			                    disable Event_Type;
			                    disable Product;
			                    disable Region;
			                    disable Start_Date_Time;
			                    disable Topic;
			                    disable Agenda;
			                    disable Recording_URL;
			                    disable Description_URL;
			                    disable Final_Registrations;
			                    disable Final_Attendees;
			                    disable Final_Revenue;
			                    disable Insights_URL;
			                    disable Debrief_Recording_URL;
			                    disable MOM_Notes;
			                    disable Upload_Destination;
			                    disable Upload_Status;
			                    enable End_Date_Time;
			                    enable Pre_Registrations;
			                    enable Pre_Revenue;
			                    enable Live_Registrations;
			                    enable Live_Attendees;
			                    enable Recording_Status;
			                }
			                else if(input.Lifecycle_Stage == "Post-Event")
			                {
			                    disable Event_Title;
			                    disable Event_Type;
			                    disable Product;
			                    disable Region;
			                    disable Start_Date_Time;
			                    disable End_Date_Time;
			                    disable Topic;
			                    disable Agenda;
			                    disable Pre_Registrations;
			                    disable Pre_Revenue;
			                    disable Live_Registrations;
			                    disable Live_Attendees;
			                    enable Recording_URL;
			                    enable Description_URL;
			                    enable Final_Registrations;
			                    enable Final_Attendees;
			                    enable Final_Revenue;
			                    enable Insights_URL;
			                    enable Debrief_Recording_URL;
			                    enable MOM_Notes;
			                    enable Upload_Destination;
			                    enable Upload_Status;
			                }
			                else if(input.Lifecycle_Stage == "Completed")
			                {
			                    disable Event_Title;
			                    disable Event_Type;
			                    disable Product;
			                    disable Region;
			                    disable Start_Date_Time;
			                    disable End_Date_Time;
			                    disable Event_Status;
			                    disable Primary_Trainer;
			                    disable Additional_Trainers;
			                    disable QA_Trainer;
			                    disable Topic;
			                    disable Agenda;
			                    disable Trainer_Split;
			                    disable General_Document_URL;
			                    disable Presentation_URL;
			                    disable Dry_Run_URL;
			                    disable Survey_URL;
			                    disable Readiness_Status;
			                    disable Missing_Activity_Notes;
			                    disable Pre_Registrations;
			                    disable Pre_Revenue;
			                    disable Live_Registrations;
			                    disable Live_Attendees;
			                    disable Recording_Status;
			                    disable Social_Media_URL;
			                    disable Connect_Post_URL;
			                    disable Email_Invite_URL;
			                    disable Cliq_Message_URL;
			                    disable Recording_URL;
			                    disable Description_URL;
			                    disable Final_Registrations;
			                    disable Final_Attendees;
			                    disable Final_Revenue;
			                    disable Insights_URL;
			                    disable Debrief_Recording_URL;
			                    disable MOM_Notes;
			                    disable Upload_Destination;
			                    disable Upload_Status;
			                    disable Ticket_ID;
			                    disable Ticket_Status;
			                    disable Ticket_Owner;
			                    disable Ticket_Closure_Notes;
			                }
			            )
			        }
			    }
			}

			Validate_Event as "Validate Event"
			{
			    type = form
			    form = Events
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.End_Date_Time <= input.Start_Date_Time)
			                {
			                    alert(End_Date_Time,"End date and time must be after start date and time.");
			                    cancel submit;
			                }
			                if(input.Pre_Registrations < 0 || input.Pre_Revenue < 0 || input.Live_Registrations < 0 || input.Live_Attendees < 0 || input.Final_Registrations < 0 || input.Final_Attendees < 0 || input.Final_Revenue < 0)
			                {
			                    alert "Counts and revenue values cannot be negative.";
			                    cancel submit;
			                }
			                if(input.Event_Status == "Ready" && input.Event_Type == "Webinar" && (input.Social_Media_URL == null || input.Connect_Post_URL == null || input.Email_Invite_URL == null || input.Cliq_Message_URL == null))
			                {
			                    alert "All webinar promotional URLs are required before the event can be Ready.";
			                    cancel submit;
			                }
			                if(input.Event_Status == "Ready" && (input.Event_Type == "Online Training" || input.Event_Type == "Customized Training" || input.Event_Type == "In-Person Training") && (input.Trainer_Split == null || input.Presentation_URL == null || input.Dry_Run_URL == null || input.Survey_URL == null))
			                {
			                    alert "Trainer split, presentation, dry-run, and survey are required before training can be Ready.";
			                    cancel submit;
			                }
			                if(input.Event_Status == "Ready" && input.Event_Type == "Certification" && (input.Ticket_ID == null || input.Ticket_Owner == null))
			                {
			                    alert "Ticket ID and owner are required before certification can be Ready.";
			                    cancel submit;
			                }
			                if(input.Lifecycle_Stage == "Completed" && input.Event_Type != "Certification" && (input.Final_Registrations == null || input.Final_Attendees == null || input.Final_Revenue == null || input.Recording_Status != "Uploaded" || input.Upload_Status != "Uploaded"))
			                {
			                    alert "Final statistics and recording/upload completion are required before completion.";
			                    cancel submit;
			                }
			                if(input.Lifecycle_Stage == "Completed" && input.Event_Type == "Certification" && input.Ticket_Status != "Closed")
			                {
			                    alert "The certification ticket must be Closed before completion.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Audit_Invoice_Changes as "Audit Invoice Changes"
