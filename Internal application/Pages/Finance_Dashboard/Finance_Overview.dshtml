<%
  memberType = "";
  memberRows = Team_Members[Email == zoho.loginuserid];
  if(memberRows.count() > 0)
  {
    memberType = memberRows.Member_Type;
  }
  isTrainer = memberType == "Trainer";
  if(isTrainer)
  {
    discountSet = Discounts[Requested_By.Email == zoho.loginuserid];
    pendingSet = Discounts[Approval_Status == "Pending" && Requested_By.Email == zoho.loginuserid];
    approvedSet = Discounts[Approval_Status == "Approved" && Requested_By.Email == zoho.loginuserid];
    invoiceSet = Invoices[Trainer.Email == zoho.loginuserid];
    outstandingSet = Invoices[Invoice_Status != "Invoice Paid" && Invoice_Status != "Cancelled" && Trainer.Email == zoho.loginuserid];
    overdueSet = Invoices[Invoice_Status == "Invoice Overdue" && Trainer.Email == zoho.loginuserid];
  }
  else
  {
    discountSet = Discounts[ID != 0];
    pendingSet = Discounts[Approval_Status == "Pending"];
    approvedSet = Discounts[Approval_Status == "Approved"];
    invoiceSet = Invoices[ID != 0];
    outstandingSet = Invoices[Invoice_Status != "Invoice Paid" && Invoice_Status != "Cancelled"];
    overdueSet = Invoices[Invoice_Status == "Invoice Overdue"];
  }
  pendingCount = pendingSet.count();
  approvedValue = approvedSet.sum(Discount_Amount);
  outstandingValue = outstandingSet.sum(Invoice_Total_USD);
  overdueCount = overdueSet.count();
  if(approvedValue == null) { approvedValue = 0; }
  if(outstandingValue == null) { outstandingValue = 0; }
  generatedCount = 0;
  linkSentCount = 0;
  paidCount = 0;
  cancelledCount = 0;
  pendingRateCount = 0;
  appliedRateCount = 0;
  manualRateCount = 0;
  failedRateCount = 0;
  for each invoiceRecord in invoiceSet
  {
    if(invoiceRecord.Invoice_Status == "Invoice Generated") { generatedCount = generatedCount + 1; }
    if(invoiceRecord.Invoice_Status == "Payment Link Sent") { linkSentCount = linkSentCount + 1; }
    if(invoiceRecord.Invoice_Status == "Invoice Paid") { paidCount = paidCount + 1; }
    if(invoiceRecord.Invoice_Status == "Cancelled") { cancelledCount = cancelledCount + 1; }
    if(invoiceRecord.Exchange_Rate_Status == "Pending API Rate") { pendingRateCount = pendingRateCount + 1; }
    if(invoiceRecord.Exchange_Rate_Status == "Rate Applied") { appliedRateCount = appliedRateCount + 1; }
    if(invoiceRecord.Exchange_Rate_Status == "Manual Override") { manualRateCount = manualRateCount + 1; }
    if(invoiceRecord.Exchange_Rate_Status == "Failed") { failedRateCount = failedRateCount + 1; }
  }
  invoiceCount = invoiceSet.count();
  if(invoiceCount == 0) { invoiceCount = 1; }
  generatedPct = generatedCount * 100 / invoiceCount;
  linkSentPct = linkSentCount * 100 / invoiceCount;
  paidPct = paidCount * 100 / invoiceCount;
  overduePct = overdueCount * 100 / invoiceCount;
  partnerCount = 0;
  customerCount = 0;
  prospectCount = 0;
  otherCount = 0;
  for each discountRecord in discountSet
  {
    if(discountRecord.Discount_Type == "Partner") { partnerCount = partnerCount + 1; }
    if(discountRecord.Discount_Type == "Customer") { customerCount = customerCount + 1; }
    if(discountRecord.Discount_Type == "Prospect") { prospectCount = prospectCount + 1; }
    if(discountRecord.Discount_Type == "Other") { otherCount = otherCount + 1; }
  }
  discountMax = partnerCount;
  if(customerCount > discountMax) { discountMax = customerCount; }
  if(prospectCount > discountMax) { discountMax = prospectCount; }
  if(otherCount > discountMax) { discountMax = otherCount; }
  if(discountMax == 0) { discountMax = 1; }
%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;--zcs-thead-color:#F9FAFE;--donut-cx:70px;--donut-cy:70px;--donut-r:54;--donut-stroke_width:16;--donut-pi:3.14;--donut-a1:<%=generatedPct%>;--donut-a2:<%=linkSentPct%>;--donut-a3:<%=overduePct%>;--donut-a4:<%=paidPct%>}
*{box-sizing:border-box}.zcs-w-full{width:100%}.zcs-flex{display:flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-gap-20{gap:20px}.zcs-gap-24{gap:24px}.zcs-p-0{padding:0}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-p-24{padding:24px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-12{padding-top:12px;padding-bottom:12px}.zcs-px-30{padding-left:30px;padding-right:30px}.zcs-py-24{padding-top:24px;padding-bottom:24px}.zcs-m-0{margin:0}.zcs-font-12{font-size:12px}.zcs-font-14{font-size:14px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-full{border-radius:100%}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-no-underline{text-decoration:none}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.finance-shell{background:var(--zcs_page_bg_color,#F3F3F4);padding-bottom:24px}.finance-content{padding:0 30px}.finance-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}.span-3{grid-column:span 3}.span-4{grid-column:span 4}.span-5{grid-column:span 5}.span-7{grid-column:span 7}.span-8{grid-column:span 8}.span-12{grid-column:span 12}.metric-icon{width:42px;height:42px;border-radius:10px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;font-size:20px}.metric-value{font-size:26px;font-weight:600;color:var(--zcs_primary_text_color)}.section-title{margin:0 0 16px;font-size:18px;font-weight:500;color:var(--zcs_primary_text_color)}.zcs-button{min-height:36px;border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-button:hover{background:var(--zcs_component_hover_color)}.bar-row{display:grid;grid-template-columns:90px 1fr 32px;gap:10px;align-items:center}.zcs-progress-bar{height:9px;background:var(--zcs_component_hover_color);border-radius:4px}.zcs-progress-bar-indicator{height:100%;border-radius:inherit;background:var(--zcs_brand_color)}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;width:100%}.zcs-table-wrapper th{background:var(--zcs-thead-color);white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tr:hover td{background:#F9FAFE}.badge{display:inline-flex;padding:3px 8px;border-radius:12px;font-size:12px;font-weight:500}.badge-red{background:#feedec;color:#a51d31}.badge-yellow{background:#fef4e5;color:#7a4a00}.badge-green{background:#edf7ed;color:#176b3a}.badge-blue{background:#e4f6fd;color:#09598e}.zcs-outline-toast{border:1px solid var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.zcs-donut-chart svg{width:140px;height:140px;transform:rotate(-90deg)}.zcs-donut-chart svg circle{cx:70px;cy:70px;r:54;stroke-width:16;fill:transparent}.zcs-donut-chart svg circle:nth-child(1){stroke:#FECE56;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100) 400;stroke-dashoffset:85}.zcs-donut-chart svg circle:nth-child(2){stroke:#36A2EB;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a2) / 100) 400;stroke-dashoffset:calc(85 - 2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100)}.zcs-donut-chart svg circle:nth-child(3){stroke:#FF6283;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a3) / 100) 400;stroke-dashoffset:calc(85 - 2 * var(--donut-pi) * var(--donut-r) * (var(--donut-a1) + var(--donut-a2)) / 100)}.zcs-donut-chart svg circle:nth-child(4){stroke:#28CC97;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a4) / 100) 400;stroke-dashoffset:calc(85 - 2 * var(--donut-pi) * var(--donut-r) * (var(--donut-a1) + var(--donut-a2) + var(--donut-a3)) / 100)}.legend-dot{width:10px;height:10px;border-radius:50%;display:inline-block}.rate-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.rate-item{padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:8px}.product-row{display:flex;justify-content:space-between;border-bottom:1px solid var(--zcs_tertiary_border_color);padding:9px 0}.product-row:last-child{border-bottom:0}@media(max-width:992px){.span-3,.span-4,.span-5,.span-7,.span-8{grid-column:span 6}}@media(max-width:650px){.finance-content{padding:0 16px}.zcs-page-header{padding:18px 16px;align-items:flex-start;flex-direction:column}.span-3,.span-4,.span-5,.span-7,.span-8{grid-column:span 12}.header-links{flex-wrap:wrap}.rate-grid{grid-template-columns:1fr}}
</style>
<div class='finance-shell'>
  <div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24'>
    <div><h2 class='zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Finance Dashboard</h2><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Discount approvals, invoice health, and outstanding financial exposure<% if(isTrainer) { %> for your records<% } %>.</p></div>
    <div class='header-links zcs-flex zcs-gap-8'>
      <a class='zcs-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14' href='#Report:Pending_Discount_Approvals'><i class='zc-li-outline ui-2-time'></i><span>Pending approvals</span></a>
      <a class='zcs-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14' href='#Report:Outstanding_Invoices'><i class='zc-li-outline files-1-single-content-03'></i><span>Outstanding invoices</span></a>
    </div>
  </div>
  <div class='finance-content'>
    <div class='finance-grid'>
      <div class='zcs-card span-3 zcs-p-20'><div class='zcs-flex zcs-justify-space-between'><div><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Pending discounts</p><div class='metric-value'><%=pendingCount%></div><a class='zcs-font-12 zcs-color-theme' href='#Report:Pending_Discount_Approvals'>Open queue</a></div><div class='metric-icon'><i class='zc-li-outline ui-2-time'></i></div></div></div>
      <div class='zcs-card span-3 zcs-p-20'><div class='zcs-flex zcs-justify-space-between'><div><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Approved discount value</p><div class='metric-value'>$<%=approvedValue.round(2)%></div><a class='zcs-font-12 zcs-color-theme' href='#Report:Approved_Discounts'>View approved</a></div><div class='metric-icon'><i class='zc-li-outline ui-1-check-circle-08'></i></div></div></div>
      <div class='zcs-card span-3 zcs-p-20'><div class='zcs-flex zcs-justify-space-between'><div><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Outstanding value in USD</p><div class='metric-value'>$<%=outstandingValue.round(2)%></div><a class='zcs-font-12 zcs-color-theme' href='#Report:Outstanding_Invoices'>Review exposure</a></div><div class='metric-icon'><i class='zc-li-outline business-coins-stack'></i></div></div></div>
      <div class='zcs-card span-3 zcs-p-20'><div class='zcs-flex zcs-justify-space-between'><div><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Overdue invoices</p><div class='metric-value'><%=overdueCount%></div><a class='zcs-font-12 zcs-color-theme' href='#Report:Overdue_Invoices'>View overdue</a></div><div class='metric-icon'><i class='zc-li-outline ui-1-alert-circle'></i></div></div></div>

      <div class='zcs-card span-7 zcs-p-24'><h3 class='section-title'>Discount trends by type</h3><div class='zcs-flex zcs-direction-column zcs-gap-16'>
        <div class='bar-row'><span class='zcs-font-14 zcs-color-primary'>Partner</span><div class='zcs-progress-bar'><div class='zcs-progress-bar-indicator' style='width:<%=partnerCount * 100 / discountMax%>%'></div></div><strong><%=partnerCount%></strong></div>
        <div class='bar-row'><span class='zcs-font-14 zcs-color-primary'>Customer</span><div class='zcs-progress-bar'><div class='zcs-progress-bar-indicator' style='width:<%=customerCount * 100 / discountMax%>%'></div></div><strong><%=customerCount%></strong></div>
        <div class='bar-row'><span class='zcs-font-14 zcs-color-primary'>Prospect</span><div class='zcs-progress-bar'><div class='zcs-progress-bar-indicator' style='width:<%=prospectCount * 100 / discountMax%>%'></div></div><strong><%=prospectCount%></strong></div>
        <div class='bar-row'><span class='zcs-font-14 zcs-color-primary'>Other</span><div class='zcs-progress-bar'><div class='zcs-progress-bar-indicator' style='width:<%=otherCount * 100 / discountMax%>%'></div></div><strong><%=otherCount%></strong></div>
      </div></div>
      <div class='zcs-card span-5 zcs-p-24'><h3 class='section-title'>Invoice status distribution</h3><div class='zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-20'><div class='zcs-donut-chart'><svg class='zcs-rounded-full'><circle></circle><circle></circle><circle></circle><circle></circle></svg></div><div class='zcs-flex zcs-direction-column zcs-gap-8 zcs-font-14'><span><i class='legend-dot' style='background:#FECE56'></i> Generated: <%=generatedCount%></span><span><i class='legend-dot' style='background:#36A2EB'></i> Link sent: <%=linkSentCount%></span><span><i class='legend-dot' style='background:#FF6283'></i> Overdue: <%=overdueCount%></span><span><i class='legend-dot' style='background:#28CC97'></i> Paid: <%=paidCount%></span><span class='zcs-color-tertiary'>Cancelled: <%=cancelledCount%></span></div></div></div>

      <div class='zcs-card span-8 zcs-p-24'><div class='zcs-flex zcs-justify-space-between zcs-align-items-center'><h3 class='section-title'>Outstanding and overdue invoices</h3><a class='zcs-font-14 zcs-color-theme' href='#Report:Outstanding_Invoices'>All outstanding</a></div><div class='zcs-table-wrapper zcs-rounded-sm'><table><thead><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14'>Invoice</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14'>Customer</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14'>Due</th><th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14'>USD exposure</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14'>Status</th></tr></thead><tbody>
      <% for each inv in outstandingSet { statusClass = "badge-yellow"; if(inv.Invoice_Status == "Invoice Overdue") { statusClass = "badge-red"; } %>
        <tr><td class='zcs-px-16 zcs-py-8 zcs-font-14'><%=inv.Invoice_Number%></td><td class='zcs-px-16 zcs-py-8 zcs-font-14'><%=inv.Customer_Name%></td><td class='zcs-px-16 zcs-py-8 zcs-font-14'><%=inv.Due_Date%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14'>$<%=inv.Invoice_Total_USD.round(2)%></td><td class='zcs-px-16 zcs-py-8'><span class='badge <%=statusClass%>'><%=inv.Invoice_Status%></span></td></tr>
      <% } %></tbody></table></div></div>
      <div class='zcs-card span-4 zcs-p-24'><div class='zcs-flex zcs-justify-space-between'><h3 class='section-title'>Pending approval queue</h3><a class='zcs-font-14 zcs-color-theme' href='#Report:Pending_Discount_Approvals'>Open report</a></div><div class='zcs-flex zcs-direction-column zcs-gap-12'>
      <% for each req in pendingSet { %><div class='rate-item'><div class='zcs-flex zcs-justify-space-between'><strong class='zcs-font-14'>Discount <%=req.Discount_ID%></strong><span class='badge badge-yellow'>Pending</span></div><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'><%=req.Discount_Type%> | <%=req.Discount_Percentage%>% | $<%=req.Discount_Amount.round(2)%></p></div><% } %>
      </div></div>

      <div class='zcs-card span-7 zcs-p-24'><h3 class='section-title'>Discount activity by product</h3><div>
      <% for each product in Products[Active == true] { if(isTrainer) { productDiscounts = Discounts[Product == product.ID && Requested_By.Email == zoho.loginuserid]; } else { productDiscounts = Discounts[Product == product.ID]; } productValue = productDiscounts.sum(Discount_Amount); if(productValue == null) { productValue = 0; } if(productDiscounts.count() > 0) { %><div class='product-row'><span class='zcs-font-14 zcs-color-primary'><%=product.Product_Name%></span><span class='zcs-font-14'><strong><%=productDiscounts.count()%></strong> requests | $<%=productValue.round(2)%></span></div><% } } %>
      </div></div>
      <div class='zcs-card span-5 zcs-p-24'><h3 class='section-title'>Currency-rate readiness</h3><div class='rate-grid'><div class='rate-item'><span class='badge badge-yellow'>Pending API rate</span><div class='metric-value'><%=pendingRateCount%></div></div><div class='rate-item'><span class='badge badge-green'>Rate applied</span><div class='metric-value'><%=appliedRateCount%></div></div><div class='rate-item'><span class='badge badge-blue'>Manual override</span><div class='metric-value'><%=manualRateCount%></div></div><div class='rate-item'><span class='badge badge-red'>Failed</span><div class='metric-value'><%=failedRateCount%></div></div></div></div>
      <div class='span-12 zcs-outline-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-font-14 zcs-color-primary'><i class='zc-li-outline travel-info'></i><p class='zcs-m-0'><strong>Exchange-rate connection pending.</strong> Live exchange-rate retrieval is not yet connected. USD totals use the conversion rates currently stored on invoice records; verify pending, failed, or manually overridden rates before relying on consolidated exposure.</p></div>
    </div>
  </div>
</div>