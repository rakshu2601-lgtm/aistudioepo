<%
userName = zoho.loginuser;
memberType = "Operational user";
memberRows = Team_Members[Email == zoho.loginuserid];
if(memberRows.count() > 0)
{
  userName = ifnull(memberRows.Employee_Name.first_name,zoho.loginuser);
  memberType = memberRows.Member_Type;
}
allEvents = Events[Event_Status != "Cancelled"];
upcomingEvents = Events[Event_Status != "Cancelled" && Start_Date_Time >= zoho.currenttime && Start_Date_Time <= zoho.currenttime.addDay(30)] sort by Start_Date_Time asc;
activeCount = Events[Event_Status != "Cancelled" && Event_Status != "Closed" && Lifecycle_Stage != "Completed"].count();
notReadyCount = Events[Event_Status != "Cancelled" && Start_Date_Time >= zoho.currenttime && Readiness_Status != "Ready"].count();
incompleteClosureCount = Events[Event_Status != "Cancelled" && (Lifecycle_Stage == "Post-Event" || Event_Status == "Delivered") && (Recording_URL is null || Description_URL is null || Upload_Status == "Pending")].count();
preCount = Events[Event_Status != "Cancelled" && Lifecycle_Stage == "Pre-Event"].count();
duringCount = Events[Event_Status != "Cancelled" && Lifecycle_Stage == "During Event"].count();
postCount = Events[Event_Status != "Cancelled" && Lifecycle_Stage == "Post-Event"].count();
completedCount = Events[Event_Status != "Cancelled" && Lifecycle_Stage == "Completed"].count();
totalCount = allEvents.count();
if(totalCount == 0)
{
  totalCount = 1;
}
prePct = (preCount * 100.0 / totalCount).round(0);
duringPct = (duringCount * 100.0 / totalCount).round(0);
postPct = (postCount * 100.0 / totalCount).round(0);
completedPct = (completedCount * 100.0 / totalCount).round(0);
readyPct = ((allEvents.count() - Events[Event_Status != "Cancelled" && Readiness_Status != "Ready"].count()) * 100.0 / totalCount).round(0);
closurePct = (completedCount * 100.0 / totalCount).round(0);
missingGeneral = Events[Event_Status != "Cancelled" && General_Document_URL is null].count();
missingPresentation = Events[Event_Status != "Cancelled" && Presentation_URL is null].count();
missingDryRun = Events[Event_Status != "Cancelled" && Dry_Run_URL is null && Event_Type != "Certification"].count();
missingSurvey = Events[Event_Status != "Cancelled" && Survey_URL is null && Event_Type != "Webinar" && Event_Type != "Certification"].count();
%>
<style>
:root{--zcs-page-bg-color:#f3f3f4;--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color)}*{box-sizing:border-box}.zcs-flex,.zcs-row{display:flex}.zcs-row{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-gap-20{gap:20px}.zcs-p-0{padding:0}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-p-24{padding:24px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-normal{font-weight:400}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.zcs-col-3{width:calc(25% - 15px)}.zcs-col-5{width:calc(41.667% - 10px)}.zcs-col-7{width:calc(58.333% - 10px)}.zcs-col-12{width:100%}.ops-page{background:var(--zcs-page-bg-color);padding:24px 30px;min-height:100%}.ops-header{background:linear-gradient(120deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));color:var(--zcs_brand_foreground_color);padding:24px;border-radius:12px}.ops-header h2,.ops-header p{color:inherit}.ops-actions{flex-wrap:wrap}.zcs-button{min-height:36px;border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color);text-decoration:none}.zcs-button:hover{background:var(--zcs_component_hover_color)}.zcs-panel-wrapper ul,.zcs-quick-actions-wrapper ul{list-style:none}.zcs-panel{border:1px solid var(--zcs_tertiary_border_color);box-shadow:0 2px 8px #f2f2f6;background:#fff}.zcs-panel-icon-wrapper{width:40px;height:40px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color)}.zcs-progress-bar-indicator{height:100%;border-radius:inherit;background:var(--zcs_brand_color)}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent;color:#fff}.zcs-badge-green{background:#179e6c}.zcs-badge-red{background:#fe455d}.zcs-badge-yellow{background:#faae13}.zcs-badge-blue{background:#2a6ffc}.zcs-badge-grey{background:#555}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;min-width:760px}.zcs-table-wrapper th{background:#f9fafe}.zcs-table-wrapper th,.zcs-table-wrapper td{padding:10px 16px;text-align:left;border-bottom:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tr:hover td{background:#f9fafe}.section-title{margin:0 0 16px}.checklist{list-style:none;padding:0;margin:0}.checklist li{padding:10px 0;border-bottom:1px solid var(--zcs_tertiary_border_color)}.checklist i{color:#b8770d}.zcs-quick-action-item:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-link{text-decoration:none}.role-note{opacity:.9}.empty{padding:28px;text-align:center;color:var(--zcs_tertiary_text_color)}@media(max-width:992px){.zcs-col-3,.zcs-col-5,.zcs-col-7{width:calc(50% - 10px)}}@media(max-width:640px){.ops-page{padding:16px}.zcs-col-3,.zcs-col-5,.zcs-col-7{width:100%}.ops-header{align-items:flex-start;flex-direction:column}.ops-actions{width:100%}.zcs-button{flex:1}.hide-mobile{display:none}}
</style>
<div class='ops-page zcs-flex zcs-direction-column zcs-gap-20'>
  <div class='ops-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16'>
    <div><h2 class='zcs-font-24 zcs-font-semibold zcs-m-0'>Operations dashboard</h2><p class='zcs-font-14 zcs-m-0'>Hello <%=userName%>. Upcoming delivery, readiness, lifecycle and closure control.</p><p class='role-note zcs-font-12 zcs-m-0'><%=memberType%> view. Trainer assignments are emphasized in the schedule.</p></div>
    <div class='ops-actions zcs-flex zcs-gap-8'>
      <a class='zcs-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md' href='#Report:Unified_Event_Summary'><i class='zc-li-outline files-2-doc'></i><span>Event summary</span></a>
      <a class='zcs-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md' href='#Report:Event_Calendar'><i class='zc-li-outline ui-2-time'></i><span>Calendar</span></a>
      <a class='zcs-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md' href='#Report:Incomplete_Event_Activities'><i class='zc-li-outline ui-3-alert'></i><span>Closure work</span></a>
    </div>
  </div>
  <div class='zcs-panel-wrapper'><ul class='zcs-row zcs-gap-20 zcs-p-0 zcs-m-0'>
    <li class='zcs-col-3'><div class='zcs-panel zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zcs-font-24 zc-li-outline ui-2-time'></i></div><h4 class='zcs-font-20 zcs-m-0'><%=upcomingEvents.count()%></h4></div><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Upcoming events, next 30 days</p></div></li>
    <li class='zcs-col-3'><div class='zcs-panel zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zcs-font-24 zc-li-outline loader-dots-06'></i></div><h4 class='zcs-font-20 zcs-m-0'><%=activeCount%></h4></div><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Active events</p></div></li>
    <li class='zcs-col-3'><div class='zcs-panel zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zcs-font-24 zc-li-outline ui-3-alert'></i></div><h4 class='zcs-font-20 zcs-m-0'><%=notReadyCount%></h4></div><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Not-ready events</p></div></li>
    <li class='zcs-col-3'><div class='zcs-panel zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zcs-font-24 zc-li-outline arrows-4-restore'></i></div><h4 class='zcs-font-20 zcs-m-0'><%=incompleteClosureCount%></h4></div><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Incomplete closures</p></div></li>
  </ul></div>
  <div class='zcs-card zcs-p-20'><h3 class='section-title zcs-font-18'>Upcoming events</h3><div class='zcs-table-wrapper zcs-rounded-sm'><table class='zcs-w-full'><thead><tr><th>Event</th><th>Date</th><th>Type</th><th>Trainer</th><th>Readiness</th><th>Lifecycle</th></tr></thead><tbody>
  <% shown = 0; for each eventRec in upcomingEvents { if(shown < 8) { assigned = false; if(memberRows.count() > 0 && eventRec.Primary_Trainer == memberRows.ID) { assigned = true; } badgeClass = "zcs-badge-yellow"; if(eventRec.Readiness_Status == "Ready") { badgeClass = "zcs-badge-green"; } else if(eventRec.Readiness_Status == "Not Ready") { badgeClass = "zcs-badge-red"; } lifecycleClass = "zcs-badge-blue"; if(eventRec.Lifecycle_Stage == "Completed") { lifecycleClass = "zcs-badge-green"; } %>
    <tr><td><strong><%=eventRec.Event_Title%></strong><% if(assigned) { %><div class='zcs-font-12' style='color:var(--zcs_brand_color)'>Assigned to you</div><% } %></td><td><%=eventRec.Start_Date_Time.toString("dd MMM yyyy")%></td><td><%=eventRec.Event_Type%></td><td><%=eventRec.Primary_Trainer.Employee_Name.first_name%></td><td><span class='zcs-badge zcs-badge-filled <%=badgeClass%> zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'><%=eventRec.Readiness_Status%></span></td><td><span class='zcs-badge zcs-badge-filled <%=lifecycleClass%> zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'><%=eventRec.Lifecycle_Stage%></span></td></tr>
  <% shown = shown + 1; } } if(shown == 0) { %><tr><td colspan='6'><div class='empty'>No upcoming events in the next 30 days.</div></td></tr><% } %>
  </tbody></table></div></div>
  <div class='zcs-row zcs-gap-20'>
    <div class='zcs-col-7 zcs-card zcs-p-24'><h3 class='section-title zcs-font-18'>Lifecycle distribution</h3><div class='zcs-flex zcs-direction-column zcs-gap-16'>
      <% labels={"Pre-Event","During Event","Post-Event","Completed"}; values={preCount,duringCount,postCount,completedCount}; pcts={prePct,duringPct,postPct,completedPct}; for each index i in labels { %><div class='zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6'><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=pcts.get(i)%>%;'></div></div><p class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-font-12 zcs-font-medium zcs-m-0'><span><%=labels.get(i)%></span><span><%=values.get(i)%> events, <%=pcts.get(i)%>%</span></p></div><% } %>
    </div></div>
    <div class='zcs-col-5 zcs-card zcs-p-24'><h3 class='section-title zcs-font-18'>Completion progress</h3><div class='zcs-flex zcs-direction-column zcs-gap-20'><div class='zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10'><p class='zcs-flex zcs-justify-space-between zcs-m-0'><span>Readiness complete</span><strong><%=readyPct%>%</strong></p><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=readyPct%>%;'></div></div></div><div class='zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10'><p class='zcs-flex zcs-justify-space-between zcs-m-0'><span>Lifecycle closed</span><strong><%=closurePct%>%</strong></p><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=closurePct%>%;'></div></div></div></div></div>
  </div>
  <div class='zcs-row zcs-gap-20'>
    <div class='zcs-col-7 zcs-card zcs-p-20'><h3 class='section-title zcs-font-18'>Missing URL and activity checklist</h3><ul class='checklist'><li class='zcs-flex zcs-justify-space-between zcs-gap-12'><span><i class='zc-li-outline ui-3-alert'></i> General document URL missing</span><strong><%=missingGeneral%></strong></li><li class='zcs-flex zcs-justify-space-between zcs-gap-12'><span><i class='zc-li-outline ui-3-alert'></i> Presentation URL missing</span><strong><%=missingPresentation%></strong></li><li class='zcs-flex zcs-justify-space-between zcs-gap-12'><span><i class='zc-li-outline ui-3-alert'></i> Dry-run URL missing</span><strong><%=missingDryRun%></strong></li><li class='zcs-flex zcs-justify-space-between zcs-gap-12'><span><i class='zc-li-outline ui-3-alert'></i> Survey URL missing for training</span><strong><%=missingSurvey%></strong></li></ul></div>
    <div class='zcs-col-5 zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16'><h3 class='zcs-font-18 zcs-font-semibold zcs-m-0'>Quick links</h3><ul class='zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0'><li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-color-primary' href='#Report:Unified_Event_Summary'><i class='zc-li-outline files-2-doc'></i><span>Unified event summary</span></a></li><li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-color-primary' href='#Report:Event_Calendar'><i class='zc-li-outline ui-2-time'></i><span>Event calendar</span></a></li><li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-color-primary' href='#Report:Incomplete_Event_Activities'><i class='zc-li-outline ui-3-alert'></i><span>Incomplete event activities</span></a></li></ul></div>
  </div>
</div>