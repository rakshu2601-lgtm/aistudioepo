<%
events = Events[ID != 0];
performanceRows = Event_Performance[ID != 0];
totalRegistrations = 0;
totalAttendees = 0;
totalRevenue = 0.0;
productTotals = Map();
regionTotals = Map();
typeTotals = Map();
maxProduct = 1;
maxRegion = 1;
for each eventRec in events
{
  regs = ifnull(eventRec.Final_Registrations,0);
  attendees = ifnull(eventRec.Final_Attendees,0);
  revenue = ifnull(eventRec.Final_Revenue,0.0);
  totalRegistrations = totalRegistrations + regs;
  totalAttendees = totalAttendees + attendees;
  totalRevenue = totalRevenue + revenue;
  productName = ifnull(eventRec.Product.Product_Name,"Unassigned");
  regionName = ifnull(eventRec.Region,"Other");
  typeName = ifnull(eventRec.Event_Type,"Other");
  productValue = ifnull(productTotals.get(productName),0) + regs;
  regionValue = ifnull(regionTotals.get(regionName),0) + regs;
  typeValue = ifnull(typeTotals.get(typeName),0) + 1;
  productTotals.put(productName,productValue);
  regionTotals.put(regionName,regionValue);
  typeTotals.put(typeName,typeValue);
  if(productValue > maxProduct) { maxProduct = productValue; }
  if(regionValue > maxRegion) { maxRegion = regionValue; }
}
attendanceRate = 0.0;
if(totalRegistrations > 0) { attendanceRate = (totalAttendees * 100.0 / totalRegistrations).round(1); }
sourceTotals = Map();
countryTotals = Map();
for each performanceRec in performanceRows
{
  dimensionName = ifnull(performanceRec.Dimension_Value,"Unspecified");
  rowRegs = ifnull(performanceRec.Registrations,0);
  rowAttendees = ifnull(performanceRec.Attendees,0);
  if(performanceRec.Dimension_Type == "Source")
  {
    sourceTotals.put(dimensionName,ifnull(sourceTotals.get(dimensionName),0) + rowRegs);
  }
  else if(performanceRec.Dimension_Type == "Country")
  {
    countryTotals.put(dimensionName,ifnull(countryTotals.get(dimensionName),0) + rowRegs);
  }
}
%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);font-size:16px;line-height:1.5}.zcs-flex,.zcs-row{display:flex}.zcs-row{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-0{padding:0}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-24{font-size:1.5rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.md-page{background:#f5f7fa;padding:20px;color:var(--zcs-primary-text-color);font-family:Arial,sans-serif}.md-header{background:linear-gradient(125deg,var(--zcs_brand_color),#087f8c);color:#fff;border:0}.md-header h1{font-size:26px}.md-header p{opacity:.9}.md-actions a{color:#fff;border:1px solid rgba(255,255,255,.6);padding:8px 12px;border-radius:6px;text-decoration:none}.md-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:16px}.md-kpi{grid-column:span 3;min-height:126px}.md-kpi-icon{width:38px;height:38px;border-radius:10px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.md-chart{grid-column:span 6}.md-chart.third{grid-column:span 4}.md-table-card{grid-column:span 12}.md-section-title{margin-bottom:16px}.md-bar-row{display:grid;grid-template-columns:minmax(105px,1.2fr) 3fr 70px;gap:10px;align-items:center;margin:12px 0}.md-track{height:10px;background:var(--zcs_component_hover_color);border-radius:6px;overflow:hidden}.md-fill{height:100%;background:var(--zcs_brand_color);border-radius:6px}.md-fill.alt{background:#28a6a6}.md-donut{width:150px;height:150px;border-radius:50%;background:conic-gradient(var(--zcs_brand_color) 0 35%,#36a2eb 35% 60%,#ffb44a 60% 78%,#28cc97 78% 92%,#ff6283 92%);position:relative}.md-donut:after{content:'';position:absolute;inset:34px;border-radius:50%;background:#fff}.md-legend{list-style:none}.md-legend li{margin:7px 0}.md-legend i{color:var(--zcs_brand_color);margin-right:6px}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;min-width:760px}.zcs-table-wrapper th{background:#f9fafe;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tbody tr:hover td{background:#f9fafe}.zcs-badge{width:auto;border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#2a6ffc}.md-filters a{text-decoration:none}.md-note{border-left:4px solid var(--zcs_brand_color)}.md-empty{padding:24px;text-align:center;color:var(--zcs-secondary-text-color)}@media(max-width:992px){.md-kpi,.md-chart.third{grid-column:span 6}.md-chart{grid-column:span 12}}@media(max-width:620px){.md-page{padding:10px}.md-kpi,.md-chart,.md-chart.third{grid-column:span 12}.md-header{align-items:flex-start;flex-direction:column}.md-actions{flex-wrap:wrap}.md-bar-row{grid-template-columns:90px 1fr 55px}}
</style>
<div class='md-page zcs-flex zcs-direction-column zcs-gap-16'>
  <header class='md-header zcs-card zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-p-24 zcs-box-border'>
    <div><h1 class='zcs-font-semibold zcs-lh-heading zcs-m-0'>Event Performance Metrics</h1><p class='zcs-font-14 zcs-m-0'>Registrations, attendance, recorded revenue, and webinar dimensions</p></div>
    <div class='md-actions zcs-flex zcs-gap-8'><a href='#Report:Unified_Event_Summary'><i class='zc-li-outline business-chart-bar-32'></i> Event summary</a><a href='#Report:Event_Performance_Details'><i class='zc-li-outline files-single-content-03'></i> Breakdown data</a></div>
  </header>
  <section class='md-filters zcs-card zcs-p-16 zcs-box-border'>
    <div class='zcs-flex zcs-align-items-center zcs-gap-12' style='flex-wrap:wrap'><strong class='zcs-font-14'><i class='zc-li-outline ui-1-filter'></i> Quick filters</strong><a class='zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-rounded-sm zcs-px-10 zcs-py-2' href='#Report:Unified_Event_Summary'>Event</a><a class='zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-rounded-sm zcs-px-10 zcs-py-2' href='#Report:Unified_Event_Summary'>Product</a><a class='zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-rounded-sm zcs-px-10 zcs-py-2' href='#Report:Unified_Event_Summary'>Region</a><a class='zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-rounded-sm zcs-px-10 zcs-py-2' href='#Report:Unified_Event_Summary'>Event type</a><span class='zcs-font-12 zcs-color-secondary'>Open Event Summary and use its Event, Product, Region, or Event Type filters; this dashboard reflects records visible to your profile.</span></div>
  </section>
  <section class='md-grid'>
    <div class='md-kpi zcs-card zcs-p-20 zcs-box-border'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between'><span class='zcs-color-secondary zcs-font-14'>Registrations</span><span class='md-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline users-multiple-19'></i></span></div><div class='zcs-font-24 zcs-font-semibold'><%=totalRegistrations%></div><small class='zcs-color-secondary'>Final event registrations</small></div>
    <div class='md-kpi zcs-card zcs-p-20 zcs-box-border'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between'><span class='zcs-color-secondary zcs-font-14'>Attendees</span><span class='md-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline users-single-01'></i></span></div><div class='zcs-font-24 zcs-font-semibold'><%=totalAttendees%></div><small class='zcs-color-secondary'>Final event attendees</small></div>
    <div class='md-kpi zcs-card zcs-p-20 zcs-box-border'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between'><span class='zcs-color-secondary zcs-font-14'>Attendance rate</span><span class='md-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline business-chart-pie-36'></i></span></div><div class='zcs-font-24 zcs-font-semibold'><%=attendanceRate%>%</div><small class='zcs-color-secondary'>Attendees divided by registrations</small></div>
    <div class='md-kpi zcs-card zcs-p-20 zcs-box-border'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between'><span class='zcs-color-secondary zcs-font-14'>Recorded revenue</span><span class='md-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline business-money-coins'></i></span></div><div class='zcs-font-24 zcs-font-semibold'><%=totalRevenue.round(2)%></div><small class='zcs-color-secondary'>Source units; no USD conversion applied</small></div>
    <div class='md-chart zcs-card zcs-p-20 zcs-box-border'><h2 class='md-section-title zcs-font-18 zcs-font-medium zcs-m-0'>Registrations by product</h2><% if(productTotals.size() == 0) { %><div class='md-empty'>No event metrics available.</div><% } else { for each keyName in productTotals.keys() { productPct = (productTotals.get(keyName) * 100.0 / maxProduct).round(1); %><div class='md-bar-row'><span class='zcs-font-14'><%=keyName%></span><div class='md-track'><div class='md-fill' style='width:<%=productPct%>%'></div></div><strong class='zcs-text-right zcs-font-14'><%=productTotals.get(keyName)%></strong></div><% } } %></div>
    <div class='md-chart zcs-card zcs-p-20 zcs-box-border'><h2 class='md-section-title zcs-font-18 zcs-font-medium zcs-m-0'>Registrations by region</h2><% if(regionTotals.size() == 0) { %><div class='md-empty'>No regional metrics available.</div><% } else { for each regionKey in regionTotals.keys() { regionPct = (regionTotals.get(regionKey) * 100.0 / maxRegion).round(1); %><div class='md-bar-row'><span class='zcs-font-14'><%=regionKey%></span><div class='md-track'><div class='md-fill alt' style='width:<%=regionPct%>%'></div></div><strong class='zcs-text-right zcs-font-14'><%=regionTotals.get(regionKey)%></strong></div><% } } %></div>
    <div class='md-chart third zcs-card zcs-p-20 zcs-box-border'><h2 class='md-section-title zcs-font-18 zcs-font-medium zcs-m-0'>Event-type distribution</h2><div class='zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-20'><div class='md-donut'></div><ul class='md-legend zcs-p-0 zcs-m-0'><% for each typeKey in typeTotals.keys() { %><li class='zcs-font-14'><i class='zc-li-solid ui-1-circle'></i><%=typeKey%>: <strong><%=typeTotals.get(typeKey)%></strong></li><% } %></ul></div></div>
    <div class='md-chart third zcs-card zcs-p-20 zcs-box-border'><h2 class='md-section-title zcs-font-18 zcs-font-medium zcs-m-0'>Webinar registrations by source</h2><% if(sourceTotals.size() == 0) { %><div class='md-empty'>No source rows in Event Performance.</div><% } else { for each sourceKey in sourceTotals.keys() { %><div class='md-bar-row'><span class='zcs-font-14'><%=sourceKey%></span><div class='md-track'><div class='md-fill' style='width:<%=if(totalRegistrations > 0,(sourceTotals.get(sourceKey) * 100.0 / totalRegistrations).round(1),0)%>%'></div></div><strong class='zcs-text-right zcs-font-14'><%=sourceTotals.get(sourceKey)%></strong></div><% } } %><a class='zcs-color-theme zcs-font-14' href='#Report:Source_Performance'>Open source report</a></div>
    <div class='md-chart third zcs-card zcs-p-20 zcs-box-border'><h2 class='md-section-title zcs-font-18 zcs-font-medium zcs-m-0'>Webinar registrations by country</h2><% if(countryTotals.size() == 0) { %><div class='md-empty'>No country rows in Event Performance.</div><% } else { for each countryKey in countryTotals.keys() { %><div class='md-bar-row'><span class='zcs-font-14'><%=countryKey%></span><div class='md-track'><div class='md-fill alt' style='width:<%=if(totalRegistrations > 0,(countryTotals.get(countryKey) * 100.0 / totalRegistrations).round(1),0)%>%'></div></div><strong class='zcs-text-right zcs-font-14'><%=countryTotals.get(countryKey)%></strong></div><% } } %><a class='zcs-color-theme zcs-font-14' href='#Report:Country_Performance'>Open country report</a></div>
    <div class='md-table-card zcs-card zcs-p-20 zcs-box-border'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 md-section-title'><h2 class='zcs-font-18 zcs-font-medium zcs-m-0'>Event-level performance</h2><a class='zcs-color-theme zcs-font-14' href='#Report:Unified_Event_Summary'>View all event records</a></div><div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border'><table class='zcs-w-full'><thead><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14'>Event</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14'>Product</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14'>Region / Type</th><th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14'>Registrations</th><th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14'>Attendees</th><th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14'>Rate</th><th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14'>Revenue units</th></tr></thead><tbody><% for each eventRow in events { eventRate = 0.0; if(ifnull(eventRow.Final_Registrations,0) > 0) { eventRate = (ifnull(eventRow.Final_Attendees,0) * 100.0 / eventRow.Final_Registrations).round(1); } %><tr><td class='zcs-px-16 zcs-py-8 zcs-font-14'><strong><%=eventRow.Event_Title%></strong></td><td class='zcs-px-16 zcs-py-8 zcs-font-14'><%=eventRow.Product.Product_Name%></td><td class='zcs-px-16 zcs-py-8 zcs-font-14'><%=eventRow.Region%> / <%=eventRow.Event_Type%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14'><%=ifnull(eventRow.Final_Registrations,0)%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14'><%=ifnull(eventRow.Final_Attendees,0)%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14'><%=eventRate%>%</td><td class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14'><%=ifnull(eventRow.Final_Revenue,0).round(2)%></td></tr><% } %></tbody></table></div></div>
  </section>
  <aside class='md-note zcs-card zcs-p-16 zcs-font-12 zcs-color-secondary'><i class='zc-li-outline ui-1-info'></i> Training Manager and Lead totals cover all records granted by profile permissions. Trainer totals and rows follow the assigned-event records visible to the logged-in user. Recorded revenue deliberately remains currency-independent because Events does not store a source currency or conversion rate.</aside>
</div>