<%
userName = zoho.loginuser;
memberType = "Training Manager";
memberRows = Team_Members[Email == zoho.loginuserid];
if(memberRows.count() > 0)
{
  userName = ifnull(memberRows.Employee_Name.first_name,zoho.loginuser);
  memberType = memberRows.Member_Type;
}
isLead = memberType == "Lead";
upcomingCount = Events[Event_Status != "Cancelled" && Start_Date_Time >= zoho.currenttime && Start_Date_Time <= zoho.currenttime.addDay(30)].count();
notReadyCount = Events[Event_Status != "Cancelled" && Start_Date_Time >= zoho.currenttime && Readiness_Status != "Ready"].count();
incompleteCount = Events[Event_Status != "Cancelled" && (Lifecycle_Stage == "Post-Event" || Event_Status == "Delivered") && (Recording_URL is null || Description_URL is null || Upload_Status == "Pending")].count();
pendingLeave = Leave_Requests[Approval_Status == "Pending"].count();
blockedTasks = Tasks[Status == "Blocked"].count();
overdueTasks = Tasks[Due_Date < zoho.currentdate && Status != "Completed" && Status != "Cancelled"].count();
pendingDiscounts = Discounts[Approval_Status == "Pending"].count();
overdueInvoices = Invoices[Due_Date < zoho.currentdate && Invoice_Status != "Invoice Paid" && Invoice_Status != "Cancelled"].count();
outstandingUSD = ifnull(Invoices[Invoice_Status != "Invoice Paid" && Invoice_Status != "Cancelled"].sum(Invoice_Total_USD),0);
todayEvents = Events[Start_Date_Time >= zoho.currentdate && Start_Date_Time < zoho.currentdate.addDay(1) && Event_Status != "Cancelled"] sort by Start_Date_Time asc;
nextEvents = Events[Start_Date_Time >= zoho.currenttime && Start_Date_Time <= zoho.currenttime.addDay(14) && Event_Status != "Cancelled"] sort by Start_Date_Time asc;
leaveQueue = Leave_Requests[Approval_Status == "Pending"] sort by Start_Date asc;
attentionTasks = Tasks[(Status == "Blocked" || (Due_Date < zoho.currentdate && Status != "Completed" && Status != "Cancelled"))] sort by Due_Date asc;
preCount = Events[Event_Status != "Cancelled" && Lifecycle_Stage == "Pre-Event"].count();
duringCount = Events[Event_Status != "Cancelled" && Lifecycle_Stage == "During Event"].count();
postCount = Events[Event_Status != "Cancelled" && Lifecycle_Stage == "Post-Event"].count();
completeCount = Events[Event_Status != "Cancelled" && Lifecycle_Stage == "Completed"].count();
maxStage = preCount;
if(duringCount > maxStage){maxStage = duringCount;}
if(postCount > maxStage){maxStage = postCount;}
if(completeCount > maxStage){maxStage = completeCount;}
if(maxStage == 0){maxStage = 1;}
%>
<style>
/* zcs-global utility sheet, included once for this page */
:root{--zcs-page-bg-color:#f3f3f4;--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color)}*{box-sizing:border-box}.zcs-flex,.zcs-row{display:flex}.zcs-row{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-end{align-items:flex-end}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-gap-4{gap:4px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-gap-20{gap:20px}.zcs-gap-24{gap:24px}.zcs-p-0{padding:0}.zcs-p-12{padding:12px}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-p-24{padding:24px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-normal{font-weight:400}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.zcs-col-3{width:calc(25% - 15px)}.zcs-col-4{width:calc(33.333% - 14px)}.zcs-col-5{width:calc(41.667% - 10px)}.zcs-col-6{width:calc(50% - 10px)}.zcs-col-7{width:calc(58.333% - 10px)}.zcs-col-12{width:100%}.zcs-no-shrink{flex-shrink:0}.zcs-relative{position:relative}.manager-page{background:var(--zcs-page-bg-color);padding:24px 30px;min-height:100%}.manager-header{background:linear-gradient(120deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));color:var(--zcs_brand_foreground_color);padding:24px;border-radius:12px}.manager-header h2,.manager-header p{color:inherit}.role-chip{border:1px solid rgba(255,255,255,.55);padding:5px 10px;border-radius:20px}.zcs-panel-wrapper ul,.zcs-quick-actions-wrapper ul{list-style:none}.zcs-panel{border:1px solid var(--zcs_tertiary_border_color);box-shadow:0 2px 8px #f2f2f6;background:#fff}.zcs-panel-icon-wrapper{width:40px;height:40px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.zcs-panel-wrapper li:hover .zcs-panel,.zcs-quick-action-item:hover{border-color:var(--zcs_brand_color)}.zcs-panel-wrapper a,.zcs-quick-action-link,.view-link{text-decoration:none;color:inherit}.zcs-badge{width:auto;border:1px solid}.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#d92f47}.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#9b6509}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#1652bb}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#087c51}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;min-width:620px}.zcs-table-wrapper th{background:#f9fafe}.zcs-table-wrapper th,.zcs-table-wrapper td{padding:9px 12px;text-align:left;border-bottom:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tr:hover td{background:#f9fafe}.section-title{margin:0 0 14px}.queue-card{min-height:300px}.empty{padding:22px;text-align:center;color:var(--zcs_teritiary_text_color)}.bar-chart{height:190px;padding:14px 8px 0;border-bottom:1px solid var(--zcs_tertiary_border_color)}.bar-item{height:100%;flex:1;min-width:58px}.bar{width:30px;background:var(--zcs_brand_color);border-radius:6px 6px 0 0;min-height:4px}.bar-label{text-align:center}.nav-grid .zcs-quick-action-item{list-style:none}.nav-grid .zcs-quick-action-link{height:100%;min-height:72px}.read-note{background:#e8efff;border:1px solid #2a6ffc;color:#1652bb;padding:10px 14px;border-radius:8px}.amount{font-variant-numeric:tabular-nums}@media(max-width:992px){.zcs-col-3,.zcs-col-4,.zcs-col-5,.zcs-col-6,.zcs-col-7{width:calc(50% - 10px)}}@media(max-width:640px){.manager-page{padding:16px}.zcs-col-3,.zcs-col-4,.zcs-col-5,.zcs-col-6,.zcs-col-7{width:100%}.manager-header{align-items:flex-start;flex-direction:column}.queue-card{min-height:auto}}
</style>
<div class='manager-page zcs-flex zcs-direction-column zcs-gap-20'>
  <div class='manager-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16'>
    <div><h2 class='zcs-font-24 zcs-font-semibold zcs-m-0'>Executive operations center</h2><p class='zcs-font-14 zcs-m-0'>Hello <%=userName%>. Event delivery, people workload, approvals and financial exposure in one view.</p></div>
    <span class='role-chip zcs-font-13'><%=if(isLead,"Lead read-focused view","Training Manager full view")%></span>
  </div>
  <%if(isLead){%><div class='read-note zcs-font-14'><i class='zc-li-outline ui-1-eye-17'></i> Operational and finance indicators are presented for review. Approval and administration actions remain in their governed modules.</div><%}%>
  <div class='zcs-panel-wrapper'>
    <ul class='zcs-row zcs-gap-20 zcs-p-0 zcs-m-0'>
      <li class='zcs-col-3'><a href='#Report:Upcoming_Events'><div class='zcs-panel zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zcs-font-24 zc-li-outline ui-1-calendar-60'></i></div><h4 class='zcs-font-20 zcs-m-0'><%=upcomingCount%></h4></div><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Events in next 30 days</p></div></a></li>
      <li class='zcs-col-3'><a href='#Report:Incomplete_Event_Activities'><div class='zcs-panel zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zcs-font-24 zc-li-outline ui-3-alert'></i></div><h4 class='zcs-font-20 zcs-m-0'><%=notReadyCount + incompleteCount%></h4></div><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Readiness and closure alerts</p></div></a></li>
      <li class='zcs-col-3'><a href='#Report:Pending_Leave_Approvals'><div class='zcs-panel zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zcs-font-24 zc-li-outline users-2-a-add'></i></div><h4 class='zcs-font-20 zcs-m-0'><%=pendingLeave%></h4></div><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Pending leave approvals</p></div></a></li>
      <li class='zcs-col-3'><a href='#Report:Tasks_Requiring_Attention'><div class='zcs-panel zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zcs-font-24 zc-li-outline ui-2-time'></i></div><h4 class='zcs-font-20 zcs-m-0'><%=blockedTasks + overdueTasks%></h4></div><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Blocked and overdue tasks</p></div></a></li>
      <li class='zcs-col-3'><a href='#Report:Pending_Discount_Approvals'><div class='zcs-panel zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zcs-font-24 zc-li-outline business-coins'></i></div><h4 class='zcs-font-20 zcs-m-0'><%=pendingDiscounts%></h4></div><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Pending discount approvals</p></div></a></li>
      <li class='zcs-col-3'><a href='#Report:Overdue_Invoices'><div class='zcs-panel zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zcs-font-24 zc-li-outline files-2-doc'></i></div><h4 class='zcs-font-20 zcs-m-0'><%=overdueInvoices%></h4></div><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Overdue invoices</p></div></a></li>
      <li class='zcs-col-3'><a href='#Page:Finance_Dashboard'><div class='zcs-panel zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zcs-font-24 zc-li-outline business-money-coins'></i></div><h4 class='amount zcs-font-20 zcs-m-0'>USD <%=outstandingUSD.round(2)%></h4></div><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Outstanding invoice exposure</p></div></a></li>
      <li class='zcs-col-3'><a href='#Page:Trainer_Dashboard'><div class='zcs-panel zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zcs-font-24 zc-li-outline users-1-single-05'></i></div><h4 class='zcs-font-20 zcs-m-0'><%=Tasks[Status != "Completed" && Status != "Cancelled"].count()%></h4></div><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Open team workload</p></div></a></li>
    </ul>
  </div>
  <div class='zcs-row zcs-gap-20'>
    <section class='zcs-card zcs-col-7 zcs-p-20 queue-card'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between'><h3 class='section-title zcs-font-18'>Today and upcoming schedule</h3><a class='view-link zcs-font-13' href='#Report:Event_Calendar'>Calendar</a></div><div class='zcs-table-wrapper zcs-rounded-sm'><table class='zcs-w-full'><thead><tr><th>When</th><th>Event</th><th>Trainer</th><th>Readiness</th></tr></thead><tbody><%rowCount=0;for each ev in nextEvents{if(rowCount < 6){rowCount=rowCount+1;%><tr><td><%=ev.Start_Date_Time.toString("dd MMM, hh:mm a")%></td><td><%=ev.Event_Title%><%if(ev.Start_Date_Time >= zoho.currentdate && ev.Start_Date_Time < zoho.currentdate.addDay(1)){%> <span class='zcs-badge zcs-badge-blue zcs-rounded-sm zcs-px-10 zcs-py-2'>Today</span><%}%></td><td><%=ev.Primary_Trainer.Employee_Name%></td><td><span class='zcs-badge <%=if(ev.Readiness_Status == "Ready","zcs-badge-green","zcs-badge-yellow")%> zcs-rounded-sm zcs-px-10 zcs-py-2'><%=ev.Readiness_Status%></span></td></tr><%}}%><%if(rowCount == 0){%><tr><td colspan='4' class='empty'>No events scheduled in the next 14 days.</td></tr><%}%></tbody></table></div></section>
    <section class='zcs-card zcs-col-5 zcs-p-20'><h3 class='section-title zcs-font-18'>Lifecycle trend</h3><div class='bar-chart zcs-flex zcs-align-items-end zcs-gap-12'><div class='bar-item zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between'><span><%=preCount%></span><div class='bar' style='height:<%=(preCount*100/maxStage)%>%'></div><span class='bar-label zcs-font-12'>Pre</span></div><div class='bar-item zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between'><span><%=duringCount%></span><div class='bar' style='height:<%=(duringCount*100/maxStage)%>%'></div><span class='bar-label zcs-font-12'>Live</span></div><div class='bar-item zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between'><span><%=postCount%></span><div class='bar' style='height:<%=(postCount*100/maxStage)%>%'></div><span class='bar-label zcs-font-12'>Post</span></div><div class='bar-item zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between'><span><%=completeCount%></span><div class='bar' style='height:<%=(completeCount*100/maxStage)%>%'></div><span class='bar-label zcs-font-12'>Done</span></div></div><div class='zcs-row zcs-gap-8 zcs-p-16'><span class='zcs-badge zcs-badge-yellow zcs-rounded-sm zcs-px-10 zcs-py-2'><i class='zc-li-outline ui-3-alert'></i> <%=notReadyCount%> not ready</span><span class='zcs-badge zcs-badge-red zcs-rounded-sm zcs-px-10 zcs-py-2'><i class='zc-li-outline ui-2-time'></i> <%=incompleteCount%> incomplete closures</span></div></section>
  </div>
  <div class='zcs-row zcs-gap-20'>
    <section class='zcs-card zcs-col-6 zcs-p-20'><div class='zcs-flex zcs-justify-space-between'><h3 class='section-title zcs-font-18'>Pending leave approvals</h3><a class='view-link zcs-font-13' href='#Report:Pending_Leave_Approvals'>Open queue</a></div><div class='zcs-table-wrapper'><table class='zcs-w-full'><thead><tr><th>Team member</th><th>Type</th><th>Dates</th></tr></thead><tbody><%leaveRows=0;for each req in leaveQueue{if(leaveRows < 5){leaveRows=leaveRows+1;%><tr><td><%=req.Team_Member.Employee_Name%></td><td><%=req.Request_Type%></td><td><%=req.Start_Date.toString("dd MMM")%> - <%=req.End_Date.toString("dd MMM")%></td></tr><%}}%><%if(leaveRows == 0){%><tr><td colspan='3' class='empty'>No pending requests.</td></tr><%}%></tbody></table></div></section>
    <section class='zcs-card zcs-col-6 zcs-p-20'><div class='zcs-flex zcs-justify-space-between'><h3 class='section-title zcs-font-18'>Tasks requiring attention</h3><a class='view-link zcs-font-13' href='#Report:Tasks_Requiring_Attention'>Open tasks</a></div><div class='zcs-table-wrapper'><table class='zcs-w-full'><thead><tr><th>Task</th><th>Assignee</th><th>Due</th><th>Status</th></tr></thead><tbody><%taskRows=0;for each task in attentionTasks{if(taskRows < 5){taskRows=taskRows+1;%><tr><td><%=task.Task_Title%></td><td><%=task.Assigned_To.Employee_Name%></td><td><%=if(task.Due_Date != null,task.Due_Date.toString("dd MMM"),"Not set")%></td><td><span class='zcs-badge <%=if(task.Status == "Blocked","zcs-badge-red","zcs-badge-yellow")%> zcs-rounded-sm zcs-px-10 zcs-py-2'><%=task.Status%></span></td></tr><%}}%><%if(taskRows == 0){%><tr><td colspan='4' class='empty'>No blocked or overdue tasks.</td></tr><%}%></tbody></table></div></section>
  </div>
  <section class='zcs-quick-actions-wrapper zcs-card zcs-p-20'><h3 class='section-title zcs-font-18'>Manager workspaces</h3><ul class='nav-grid zcs-row zcs-gap-20 zcs-p-0 zcs-m-0'><li class='zcs-quick-action-item zcs-card zcs-col-4 zcs-px-12 zcs-py-8'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8' href='#Page:Operations_Dashboard'><i class='zcs-font-20 zc-li-outline ui-1-settings-gear-63'></i><span><strong>Operations</strong><br><small>Readiness, lifecycle and closure</small></span></a></li><li class='zcs-quick-action-item zcs-card zcs-col-4 zcs-px-12 zcs-py-8'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8' href='#Page:Metrics_Dashboard'><i class='zcs-font-20 zc-li-outline business-chart-bar-32'></i><span><strong>Metrics</strong><br><small>Performance and trends</small></span></a></li><li class='zcs-quick-action-item zcs-card zcs-col-4 zcs-px-12 zcs-py-8'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8' href='#Page:Trainer_Dashboard'><i class='zcs-font-20 zc-li-outline users-1-single-05'></i><span><strong>Trainer workload</strong><br><small>Assignments and capacity</small></span></a></li><li class='zcs-quick-action-item zcs-card zcs-col-4 zcs-px-12 zcs-py-8'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8' href='#Page:Leave_Task_Dashboard'><i class='zcs-font-20 zc-li-outline ui-1-calendar-60'></i><span><strong>Leave and tasks</strong><br><small>Approvals and task health</small></span></a></li><li class='zcs-quick-action-item zcs-card zcs-col-4 zcs-px-12 zcs-py-8'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8' href='#Page:Finance_Dashboard'><i class='zcs-font-20 zc-li-outline business-money-coins'></i><span><strong>Finance</strong><br><small>Discounts and invoices</small></span></a></li></ul></section>
</div>