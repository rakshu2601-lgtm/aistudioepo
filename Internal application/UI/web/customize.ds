customize
{
    layout
    {
        theme = "theme_2"
        variant = "variant_2"
    }
    font = "lato"
    color options
    {
        name = "Operations Blue Teal"
        brand color = "#176B87"
        type = "custom"
        dark mode color = "#0E7490"
    }
    logo
    {
        preference = "app_icon"
        placement = "left"
    }
    custom css
    {
        content = "body { color: #17324D; font-family: Lato, sans-serif; } .zc-app-header { background: #176B87; }"
    }
}
