list Source_Performance
{
    displayName = "Source Performance"
    show all rows from Event_Performance [Dimension_Type == "Source"]
    (
        Event
        Dimension_Type
        Dimension_Value
        Registrations
        Attendees
        Notes
    )
    filters
    (
        Event
        Dimension_Value
    )
    sort by
    (
        Dimension_Value ascending
    )
}
