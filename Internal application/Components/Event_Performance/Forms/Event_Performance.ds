form Event_Performance
{
    displayname = "Event Performance Breakdown"

    Performance_Detail
    (
        type = section
        displayname = "Performance Detail"
        row = 1
        column = 0
    )
    must have Event
    (
        type = picklist
        values = Events.ID
        displayformat = [Event_Title]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Dimension_Type
    (
        type = picklist
        displayname = "Dimension Type"
        values = {"Source","Country"}
        row = 1
        column = 2
        width = medium
    )
    must have Dimension_Value
    (
        type = text
        displayname = "Dimension Value"
        row = 1
        column = 1
        width = medium
    )
    must have Registrations
    (
        type = number
        initial value = 0
        row = 1
        column = 2
        width = medium
    )
    must have Attendees
    (
        type = number
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
