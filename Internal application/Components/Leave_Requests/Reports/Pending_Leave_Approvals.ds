list Pending_Leave_Approvals
{
    displayName = "Pending Leave Approvals"
    show all rows from Leave_Requests [Approval_Status == "Pending"]
    (
        Request_Number
        Team_Member
        Request_Type
        Start_Date
        End_Date
        Reason
        Reporting_Manager
        Approval_Status
        Manager_Comments
    )
    filters
    (
        Request_Type
        Start_Date
        End_Date
        Approval_Status
    )
    sort by
    (
        Start_Date ascending
    )
}
