form Leave_Requests
{
    displayname = "Leave & WFH Requests"

    Request
    (
        type = section
        displayname = "Request"
        row = 1
        column = 0
    )
    Request_Number
    (
        type = autonumber
        displayname = "Request Number"
        start index = 1001
        row = 1
        column = 1
        width = medium
    )
    must have Team_Member
    (
        type = picklist
        displayname = "Team Member"
        values = Team_Members.ID
        displayformat = [Employee_Name.first_name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Request_Type
    (
        type = picklist
        displayname = "Request Type"
        values = {"Sick Leave","Casual Leave","Restricted Holiday","WFH"}
        row = 1
        column = 2
        width = medium
    )
    must have Start_Date
    (
        type = date
        displayname = "Start Date"
        row = 1
        column = 1
        width = medium
    )
    must have End_Date
    (
        type = date
        displayname = "End Date"
        row = 1
        column = 2
        width = medium
    )
    must have Reason
    (
        type = textarea
        displayname = "Reason"
        height = 100px
        row = 1
        column = 1
        width = medium
    )

    Approval
    (
        type = section
        displayname = "Approval"
        visibility = true
        row = 2
        column = 1
    )
    Reporting_Manager
    (
        type = picklist
        displayname = "Reporting Manager"
        values = Team_Members.ID
        displayformat = [Employee_Name.first_name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    must have Approval_Status
    (
        type = picklist
        displayname = "Approval Status"
        values = {"Pending","Approved","Rejected"}
        initial value = "Pending"
        row = 2
        column = 2
        width = medium
    )
    Manager_Comments
    (
        type = textarea
        displayname = "Manager Comments"
        height = 100px
        row = 2
        column = 1
        width = medium
    )
    Decision_Date
    (
        type = date
        displayname = "Decision Date"
        row = 2
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit Request"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Request"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }

    blueprint components
    {
        stages = {"Pending","Approved","Rejected"}
    }
}
