Event_Type_On_User_Input as "Event Type On User Input"
{
    type = form
    form = Events
    record event = on add or edit

    on user input of Event_Type
    {
        actions
        {
            custom deluge script
            (
                hide Webinar_Promotion;
                hide Certification;
                show Additional_Trainers;
                show QA_Trainer;
                show Trainer_Split;
                show Survey_URL;
                show Pre_Revenue;
                show Final_Revenue;
                show Recording_Status;
                show Upload_Destination;
                show Upload_Status;
                if(input.Event_Type == "Webinar")
                {
                    show Webinar_Promotion;
                    hide Additional_Trainers;
                    hide Trainer_Split;
                    hide Survey_URL;
                    hide Pre_Revenue;
                    hide Final_Revenue;
                    input.Upload_Destination = "Trainer Central";
                }
                else if(input.Event_Type == "Online Training" || input.Event_Type == "Customized Training" || input.Event_Type == "In-Person Training")
                {
                    input.Upload_Destination = "WorkDrive";
                }
                else if(input.Event_Type == "Certification")
                {
                    show Certification;
                    hide Additional_Trainers;
                    hide QA_Trainer;
                    hide Trainer_Split;
                    hide Survey_URL;
                    hide Pre_Revenue;
                    hide Final_Revenue;
                    hide Recording_Status;
                    hide Upload_Destination;
                    hide Upload_Status;
                }
            )
        }
    }
}
