form Events
{
    title
    {
        displayname = "Unified Events"
        on add = "Add Unified Event"
        on edit = "Edit Unified Event"
    }
    Core_Details
    (
        type = section
        displayname = "Core Details"
        row = 1
        column = 0
    )
    Event_ID
    (
        type = autonumber
        displayname = "Event ID"
        start index = 1001
        row = 1
        column = 1
    )
    must have Event_Title
    (
        type = text
        displayname = "Event Title"
        row = 1
        column = 1
        width = medium
    )
    must have Event_Type
    (
        type = picklist
        displayname = "Event Type"
        values = {"Webinar","Online Training","Customized Training","In-Person Training","Certification"}
        row = 1
        column = 2
        width = medium
    )
    must have Product
    (
        type = picklist
        values = Products.ID
        displayformat = [Product_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Region
    (
        type = picklist
        values = {"Americas","EMEA","APAC","India","Global","Other"}
        row = 1
        column = 2
        width = medium
    )
    must have Start_Date_Time
    (
        type = datetime
        displayname = "Start Date & Time"
        row = 1
        column = 1
        width = medium
    )
    must have End_Date_Time
    (
        type = datetime
        displayname = "End Date & Time"
        row = 1
        column = 2
        width = medium
    )
    must have Lifecycle_Stage
    (
        type = picklist
        displayname = "Lifecycle Stage"
        values = {"Pre-Event","During Event","Post-Event","Completed"}
        initial value = "Pre-Event"
        row = 1
        column = 1
        width = medium
    )
    must have Event_Status
    (
        type = picklist
        displayname = "Event Status"
        values = {"Planned","Ready","In Progress","Delivered","On Hold","Cancelled","Closed"}
        initial value = "Planned"
        row = 1
        column = 2
        width = medium
    )
    Assignment
    (
        type = section
        displayname = "Trainer Assignment"
        visibility = true
        row = 2
        column = 1
    )
    must have Primary_Trainer
    (
        type = picklist
        displayname = "Primary Trainer"
        values = Team_Members.ID
        displayformat = [Employee_Name.first_name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    Additional_Trainers
    (
        type = checkboxes
        displayname = "Additional Trainers"
        values = Team_Members.ID
        displayformat = [Employee_Name.first_name]
        searchable = true
        layout = 2
        row = 2
        column = 2
        width = medium
    )
    QA_Trainer
    (
        type = picklist
        displayname = "Q&A Trainer"
        values = Team_Members.ID
        displayformat = [Employee_Name.first_name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    Content_Readiness
    (
        type = section
        displayname = "Content & Readiness"
        visibility = true
        row = 3
        column = 1
    )
    must have Topic
    (
        type = text
        row = 3
        column = 1
        width = medium
    )
    Agenda
    (
        type = richtext
        height = 180px
        toolbar = enable
        [
            style, alignment, bullets-and-numbering, link, table
        ]
        row = 3
        column = 2
        width = medium
    )
    Trainer_Split
    (
        type = richtext
        displayname = "Trainer Split"
        height = 180px
        toolbar = enable
        [
            style, alignment, bullets-and-numbering, link
        ]
        row = 3
        column = 1
        width = medium
    )
    General_Document_URL
    (
        type = url
        displayname = "General Document URL"
        row = 3
        column = 2
        width = medium
    )
    Presentation_URL
    (
        type = url
        displayname = "Presentation URL"
        row = 3
        column = 1
        width = medium
    )
    Dry_Run_URL
    (
        type = url
        displayname = "Dry Run URL"
        row = 3
        column = 2
        width = medium
    )
    Survey_URL
    (
        type = url
        displayname = "Survey URL"
        row = 3
        column = 1
        width = medium
    )
    Readiness_Status
    (
        type = picklist
        displayname = "Readiness Status"
        values = {"Not Reviewed","Ready","Not Ready"}
        initial value = "Not Reviewed"
        row = 3
        column = 2
        width = medium
    )
    Missing_Activity_Notes
    (
        type = textarea
        displayname = "Missing Activity Notes"
        height = 120px
        row = 3
        column = 1
        width = medium
    )
    Pre_Live_Statistics
    (
        type = section
        displayname = "Pre & Live Statistics"
        visibility = true
        row = 4
        column = 1
    )
    Pre_Registrations
    (
        type = number
        displayname = "Pre Registrations"
        initial value = 0
        row = 4
        column = 1
        width = medium
    )
    Pre_Revenue
    (
        type = decimal
        displayname = "Pre Revenue"
        initial value = 0
        row = 4
        column = 2
        width = medium
    )
    Live_Registrations
    (
        type = number
        displayname = "Live Registrations"
        initial value = 0
        row = 4
        column = 1
        width = medium
    )
    Live_Attendees
    (
        type = number
        displayname = "Live Attendees"
        initial value = 0
        row = 4
        column = 2
        width = medium
    )
    Recording_Status
    (
        type = picklist
        displayname = "Recording Status"
        values = {"Not Started","Recording","Recorded","Editing","Uploaded","Not Applicable"}
        initial value = "Not Started"
        row = 4
        column = 1
        width = medium
    )
    Webinar_Promotion
    (
        type = section
        displayname = "Webinar Promotion"
        visibility = true
        row = 5
        column = 1
    )
    Social_Media_URL
    (
        type = url
        displayname = "Social Media URL"
        row = 5
        column = 1
        width = medium
    )
    Connect_Post_URL
    (
        type = url
        displayname = "Connect Post URL"
        row = 5
        column = 2
        width = medium
    )
    Email_Invite_URL
    (
        type = url
        displayname = "Email Invite URL"
        row = 5
        column = 1
        width = medium
    )
    Cliq_Message_URL
    (
        type = url
        displayname = "Cliq Message URL"
        row = 5
        column = 2
        width = medium
    )
    Post_Event
    (
        type = section
        displayname = "Post-Event Closure"
        visibility = true
        row = 6
        column = 1
    )
    Recording_URL
    (
        type = url
        displayname = "Recording URL"
        row = 6
        column = 1
        width = medium
    )
    Description_URL
    (
        type = url
        displayname = "Description URL"
        row = 6
        column = 2
        width = medium
    )
    Final_Registrations
    (
        type = number
        displayname = "Final Registrations"
        initial value = 0
        row = 6
        column = 1
        width = medium
    )
    Final_Attendees
    (
        type = number
        displayname = "Final Attendees"
        initial value = 0
        row = 6
        column = 2
        width = medium
    )
    Final_Revenue
    (
        type = decimal
        displayname = "Final Revenue"
        initial value = 0
        row = 6
        column = 1
        width = medium
    )
    Insights_URL
    (
        type = url
        displayname = "Insights URL"
        row = 6
        column = 2
        width = medium
    )
    Debrief_Recording_URL
    (
        type = url
        displayname = "Debrief Recording URL"
        row = 6
        column = 1
        width = medium
    )
    MOM_Notes
    (
        type = richtext
        displayname = "MOM Notes"
        height = 180px
        toolbar = enable
        [
            style, alignment, bullets-and-numbering, link
        ]
        row = 6
        column = 2
        width = medium
    )
    Upload_Destination
    (
        type = picklist
        displayname = "Upload Destination"
        values = {"Trainer Central","WorkDrive","Other","Not Applicable"}
        row = 6
        column = 1
        width = medium
    )
    Upload_Status
    (
        type = picklist
        displayname = "Upload Status"
        values = {"Pending","Uploaded","Not Applicable"}
        initial value = "Pending"
        row = 6
        column = 2
        width = medium
    )
    Certification
    (
        type = section
        displayname = "Certification Ticket"
        visibility = true
        row = 7
        column = 1
    )
    Ticket_ID
    (
        type = text
        displayname = "Ticket ID"
        row = 7
        column = 1
        width = medium
    )
    Ticket_Status
    (
        type = picklist
        displayname = "Ticket Status"
        values = {"Open","In Progress","Resolved","Closed"}
        initial value = "Open"
        row = 7
        column = 2
        width = medium
    )
    Ticket_Owner
    (
        type = picklist
        displayname = "Ticket Owner"
        values = Team_Members.ID
        displayformat = [Employee_Name.first_name]
        searchable = true
        row = 7
        column = 1
        width = medium
    )
    Ticket_Closure_Notes
    (
        type = textarea
        displayname = "Ticket Closure Notes"
        height = 120px
        row = 7
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Event"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Event"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
    blueprint components
    {
        stages = {"Pre-Event","During Event","Post-Event","Completed"}
    }
}
