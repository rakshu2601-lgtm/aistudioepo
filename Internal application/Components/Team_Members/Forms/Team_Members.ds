form Team_Members
{
    displayname = "Team Members"

    Details
    (
        type = section
        displayname = "Details"
        row = 1
        column = 0
    )
    Employee_ID
    (
        type = autonumber
        displayname = "Employee ID"
        start index = 1001
        row = 1
        column = 1
        width = medium
    )
    must have Employee_Name
    (
        type = name
        displayname = "Employee Name"
        prefix
        (
            type = prefix
            displayname = "Title"
            visibility = false
            value = {"Mr.", "Mrs.", "Ms.", "Dr."}
        )
        first_name
        (
            type = first_name
            displayname = "First Name"
        )
        last_name
        (
            type = last_name
            displayname = "Last Name"
        )
        suffix
        (
            type = suffix
            displayname = "Suffix"
            visibility = false
        )
        row = 1
        column = 2
        width = medium
    )
    must have unique Email
    (
        type = email
        displayname = "Email"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    must have Member_Type
    (
        type = picklist
        displayname = "Member Type"
        values = {"Trainer", "Mentor", "Training Manager", "Lead", "Other"}
        row = 1
        column = 2
        width = medium
    )
    Reporting_Manager
    (
        type = picklist
        displayname = "Reporting Manager"
        values = Team_Members.ID
        displayformat = [Employee_Name.first_name]
        searchable = true
        sortorder = ascending
        row = 1
        column = 1
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
