Load_Invoice as "Load Invoice"
{
    type = form
    form = Invoices
    record event = on add or edit

    on load
    {
        actions
        {
            custom deluge script
            (
                if(input.Event != null)
                {
                    selected_event = Events[ID == input.Event];
                    input.Product = selected_event.Product;
                    input.Trainer = selected_event.Primary_Trainer;
                    if(selected_event.Final_Revenue != null && selected_event.Final_Revenue > 0)
                    {
                        input.Revenue_Amount = selected_event.Final_Revenue;
                    }
                    else if(selected_event.Pre_Revenue != null)
                    {
                        input.Revenue_Amount = selected_event.Pre_Revenue;
                    }
                    clear Approved_Discount;
                    eligible_discounts = Discounts[Approval_Status == "Approved" && Event == input.Event];
                    Approved_Discount:ui.add(eligible_discounts.ID.getall());
                }
            )
        }
    }
}
