list Outstanding_Invoices
{
    displayName = "Outstanding Invoices"
    show all rows from Invoices [Invoice_Status != "Invoice Paid" && Invoice_Status != "Cancelled"]
    (
        Invoice_Number
        Event
        Product
        Trainer
        Customer_Name
        Due_Date
        Invoice_Total_USD
        Exchange_Rate_Status
        Invoice_Status
        Payment_Link
    )
    filters
    (
        Product
        Trainer
        Due_Date
        Exchange_Rate_Status
        Invoice_Status
    )
    sort by
    (
        Due_Date ascending
    )
}
