default list Audit_History
{
    displayName = "Audit History"
    show all rows from Audit_Log
    (
        Audit_ID
        Module_Name
        Record_ID
        Action
        Changed_By
        Changed_At
        Before_Value
        After_Value
        Notes
    )
    filters
    (
        Module_Name
        Action
    )
    sort by
    (
        Changed_At descending
    )
}
