form Audit_Log
{
    Audit_Details
    (
        type = section
        displayname = "Audit Details"
        row = 1
        column = 0
    )
    Audit_ID
    (
        type = autonumber
        displayname = "Audit ID"
        start index = 1001
        row = 1
        column = 1
        width = medium
    )
    must have Module_Name
    (
        type = picklist
        displayname = "Module Name"
        values = {"Leave Requests","Events","Tasks","Discounts","Invoices"}
        row = 1
        column = 1
        width = medium
    )
    must have Record_ID
    (
        type = text
        displayname = "Record ID"
        row = 1
        column = 2
        width = medium
    )
    must have Action
    (
        type = text
        row = 1
        column = 1
        width = medium
    )
    must have Changed_By
    (
        type = email
        displayname = "Changed By"
        row = 1
        column = 2
        width = medium
    )
    must have Changed_At
    (
        type = datetime
        displayname = "Changed At"
        row = 1
        column = 1
        width = medium
    )
    Before_Value
    (
        type = textarea
        displayname = "Before Value"
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    After_Value
    (
        type = textarea
        displayname = "After Value"
        height = 120px
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        height = 120px
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
