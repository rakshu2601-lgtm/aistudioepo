list Trainer_Tasks
{
    displayName = "Trainer Tasks"
    show all rows from Tasks [Assignee_Type == "Trainer"]
    (
        Task_ID
        Task_Title
        Assigned_To
        Priority
        Due_Date
        Status
    )
    filters
    (
        Assigned_To
        Priority
        Due_Date
        Status
    )
    sort by
    (
        Due_Date ascending
    )
}
