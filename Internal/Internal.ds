	reports
	{
		default list All_Country_Wise_Statistics
		{
		    displayName = "All Country Wise Statistics"
		    show all rows from Country_Wise_Statistics
		    (
		        Post_Event_Statistics
		        Region
		        Country
		        Registrations
		        (
		            display = total
		        )
		        Attendees
		        (
		            display = total
		        )
		    )
		    filters
		    (
		        Post_Event_Statistics
		        Region
		        Country
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Post_Event_Statistics ascending
		        Region ascending
		    )
		    sort by
		    (
		        Country ascending
		    )
		}

		default list Daily_Work_Items_Report
		{
		    displayName = "Daily Work Items"
		    show all rows from Daily_Work_Items
		    (
		        Daily_Update
		        Event_Work_Category
		        Assigned_Task
		        Work_Done_Description
		        Status
		        Hours_Worked
		        (
		            display = total
		        )
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Daily_Update descending
		        Event_Work_Category ascending
		    )
		}

		default list All_Daily_Work_Updates
		{
		    displayName = "All Daily Work Updates"
		    show all rows from Daily_Work_Updates
		    (
		        Team_Member
		        Update_Date
		        Work_Items
		        Consolidated_Update
		    )
		    sort by
		    (
		        Update_Date descending
		    )
		}

		calendar Daily_Update_Calendar
		{
		    displayName = "Daily Update Calendar"
		    show all rows from Daily_Work_Updates
		    (
		        Team_Member
		        Update_Date
		        Consolidated_Update
		    )
		    filters
		    (
		        Team_Member
		        Update_Date
		    )
		    options
		    (
		        display type = month
		        week start day = monday
		        display field = Team_Member
		        start date = Update_Date
		        default date
		        (
		            day = Today
		            month = Currentmonth
		            year = Currentyear
		        )
		    )
		}

		list My_Daily_Work_Updates
		{
		    displayName = "My Daily Work Updates"
