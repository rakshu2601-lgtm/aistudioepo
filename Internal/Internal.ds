		            condition = (Status == "Rejected")
		            fields = [Status]
		            format = "background-color:#FDE8E8;color:#B42318;font-weight:bold"
		        }
		        "Pending"
		        {
		            condition = (Status == "Pending")
		            fields = [Status]
		            format = "background-color:#FFF4D6;color:#8A5A00;font-weight:bold"
		        }
		    )
		}

		calendar Approved_WFH_Calendar
		{
		    displayName = "Approved WFH Calendar"
		    show all rows from Work_From_Home_Requests [Status == "Approved"]
		    (
		        Requester
		        WFH_Date
		        Reason
		        Status
		    )
		    filters
		    (
		        Requester
		        WFH_Date
		        Status
		    )
		    options
		    (
		        display type = month
		        week start day = monday
		        display field = Requester
		        start date = WFH_Date
		        default date
		        (
		            day = Today
		            month = Currentmonth
		            year = Currentyear
		        )
		    )
		}

		list My_WFH_Requests
		{
		    displayName = "My WFH Requests"
		    show all rows from Work_From_Home_Requests [Requester.Creator_User == zoho.loginuser]
		    (
		        Requester
		        WFH_Date
		        Reason
		        Approver
		        Status
		        Rejection_Reason
		    )
		    filters
		    (
		        WFH_Date
		        Status
		    )
		    sort by
		    (
		        WFH_Date descending
		    )
		    options
		    (
		        show approval process = true
		    )
		}
	}

	pages
	{
		page Operations_Dashboard
		{
					displayname = "Operations Dashboard"
					Content="<zml mobileDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"onebyone\",\"forcedOrientation\":false}}' tabletDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"actual\",\"forcedOrientation\":false}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Operations_Overview' elementName='Operations_Overview'>\n\t\t\t\t\t<![CDATA[htmlpage Operations_Overview()\ncontent\n&lt;%{%&gt;\n&lt;%\nmonthNames = {&quot;January&quot;,&quot;February&quot;,&quot;March&quot;,&quot;April&quot;,&quot;May&quot;,&quot;June&quot;,&quot;July&quot;,&quot;August&quot;,&quot;September&quot;,&quot;October&quot;,&quot;November&quot;,&quot;December&quot;};\ncurrentMonth = monthNames.get(zoho.currentdate.getMonth() - 1);\ncurrentYear = zoho.currentdate.getYear();\nuserName = zoho.loginuser;\nmember = Team_Members[Email == zoho.loginuserid];\nif(member.count() &gt; 0)\n{\n\t\tuserName = member.Name.first_name;\n}\nactiveEvents = Events[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Cancelled&quot;].count();\noverdueTasks = Task_Assignments[Progress_Status != &quot;Completed&quot; &amp;&amp; Deadline &lt; zoho.currentdate].count();\npendingLeave = Leave_Requests[Status == &quot;Pending&quot;].count();\npendingWFH = Work_From_Home_Requests[Status == &quot;Pending&quot;].count();\npendingApprovals = pendingLeave + pendingWFH;\nmonthStats = Post_Event_Statistics[Statistics_Month == currentMonth &amp;&amp; Statistics_Year == currentYear];\nmonthlyRegistrations = ifnull(monthStats.sum(Total_Registrations),0);\nmonthlyAttendance = ifnull(monthStats.sum(Total_Attendees),0);\nmonthlyRevenue = ifnull(monthStats.sum(Revenue_USD),0);\npendingDiscounts = Discount_Requests[Status == &quot;Requested&quot;].count();\noutstandingInvoices = Manual_Invoice[Status == &quot;Invoice Raised&quot; || Status == &quot;Invoice Sent&quot;].count();\nstatusTentative = Events[Status == &quot;Tentative&quot;].count();\nstatusOpen = Events[Status == &quot;Open&quot;].count();\nstatusProgress = Events[Status == &quot;In Progress&quot;].count();\nstatusCompleted = Events[Status == &quot;Completed&quot;].count();\nstatusTotal = statusTentative + statusOpen + statusProgress + statusCompleted;\nif(statusTotal == 0) { statusTotal = 1; }\ntypeWebinar = Events[Event_Type == &quot;Webinar&quot;].count();\ntypeOnline = Events[Event_Type == &quot;Online Training&quot;].count();\ntypeInPerson = Events[Event_Type == &quot;In-person&quot;].count();\ntypeCustom = Events[Event_Type == &quot;Customized Training&quot;].count();\ntypeOther = Events[Event_Type == &quot;Adhoc&quot; || Event_Type == &quot;Certification&quot;].count();\ntypeMax = typeWebinar;\nif(typeOnline &gt; typeMax) { typeMax = typeOnline; }\nif(typeInPerson &gt; typeMax) { typeMax = typeInPerson; }\nif(typeCustom &gt; typeMax) { typeMax = typeCustom; }\nif(typeOther &gt; typeMax) { typeMax = typeOther; }\nif(typeMax == 0) { typeMax = 1; }\ntaskAssigned = Task_Assignments[Progress_Status == &quot;Assigned&quot;].count();\ntaskProgress = Task_Assignments[Progress_Status == &quot;In Progress&quot;].count();\ntaskCompleted = Task_Assignments[Progress_Status == &quot;Completed&quot;].count();\ntaskTotal = taskAssigned + taskProgress + taskCompleted;\nif(taskTotal == 0) { taskTotal = 1; }\nrevenueMax = 0;\nfor each revCheck in Post_Event_Statistics[Revenue_USD &gt; 0] sort by Statistics_Year desc\n{\n\t\tif(revCheck.Revenue_USD &gt; revenueMax) { revenueMax = revCheck.Revenue_USD; }\n}\nif(revenueMax == 0) { revenueMax = 1; }\n%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--column-gap:0px}.zcs-flex,.zcs-row{display:flex}.zcs-row{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-end{align-items:flex-end}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-0{padding:0}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.zcs-col-3{flex:0 0 calc(25% - 12px);max-width:calc(25% - 12px)}.zcs-col-4{flex:0 0 calc(33.333% - 11px);max-width:calc(33.333% - 11px)}.zcs-col-6{flex:0 0 calc(50% - 8px);max-width:calc(50% - 8px)}.zcs-col-8{flex:0 0 calc(66.667% - 6px);max-width:calc(66.667% - 6px)}.zcs-col-12{flex:0 0 100%;max-width:100%}\n.ops{background:var(--zcs-page-bg-color,#f5f6f8);padding:24px 30px;font-family:inherit}.hero{padding:22px 24px;color:#fff;background:linear-gradient(120deg,var(--zcs_brand_dark_color,#243b78),var(--zcs_brand_color,#4169e1));overflow:hidden}.hero h2,.hero p{color:#fff}.hero-icon{font-size:48px;opacity:.2}.quick{display:flex;gap:8px;flex-wrap:wrap}.zcs-button{min-height:36px;text-decoration:none;border:1px solid rgba(255,255,255,.48);color:#fff;padding:8px 12px}.zcs-button:hover{background:rgba(255,255,255,.12)}.kpi-list{list-style:none}.kpi{box-shadow:0 2px 8px rgba(20,32,64,.05)}.kpi-icon{width:42px;height:42px;background:var(--zcs_brand_light_color,#eef2ff);color:var(--zcs_brand_color);font-size:20px}.kpi.warn .kpi-icon{background:#fff4df;color:#a96800}.kpi.danger .kpi-icon{background:#ffe9ec;color:#d72f4b}.kpi.good .kpi-icon{background:#e5f8f1;color:#13855d}.section-head{margin-bottom:14px}.chart-card{min-height:300px}.donut{width:170px;height:170px;background:conic-gradient(#f0b429 0 calc(&lt;%=statusTentative%&gt; * 100% / &lt;%=statusTotal%&gt;),#2a6ffc 0 calc((&lt;%=statusTentative%&gt; + &lt;%=statusOpen%&gt;) * 100% / &lt;%=statusTotal%&gt;),#9b6cff 0 calc((&lt;%=statusTentative%&gt; + &lt;%=statusOpen%&gt; + &lt;%=statusProgress%&gt;) * 100% / &lt;%=statusTotal%&gt;),#28a978 0);position:relative}.donut:after{content:&apos;&apos;;position:absolute;inset:32px;background:#fff;border-radius:50%}.donut strong{z-index:1}.legend{list-style:none}.dot{width:10px;height:10px;border-radius:50%}.bars{height:210px;border-bottom:1px solid var(--zcs-border-color);padding:0 10px}.bar-item{height:100%;flex:1;min-width:48px}.bar{width:30px;min-height:3px;background:var(--zcs_brand_color);border-radius:6px 6px 0 0}.bar.alt{background:#6f77d9}.bar-label{text-align:center}.revenue-bars{overflow-x:auto}.revenue-bars .bar-item{min-width:70px}.event-grid .zcs-card{overflow:hidden}.event-top{border-bottom:1px solid var(--zcs-border-color)}.event-meta{background:var(--zcs_brand_light_color,#f6f7ff)}.badge{display:inline-flex;padding:3px 8px;border-radius:999px;background:#eef2ff;color:#3452a5}.badge.delayed{background:#ffe9ec;color:#c92d47}.badge.pending{background:#fff4df;color:#986000}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;min-width:700px}.zcs-table-wrapper th{background:#f8f9fc}.zcs-table-wrapper th,.zcs-table-wrapper td{padding:10px 14px;border-bottom:1px solid var(--zcs-border-color)}.feed{list-style:none}.feed li{position:relative;padding-left:28px}.feed li:before{content:&apos;&apos;;position:absolute;left:5px;top:6px;width:10px;height:10px;border-radius:50%;background:var(--zcs_brand_color)}.feed li:not(:last-child):after{content:&apos;&apos;;position:absolute;left:9px;top:16px;bottom:-18px;width:1px;background:var(--zcs-border-color)}.empty{padding:24px;text-align:center;color:var(--zcs-teritiary-text-color)}\n@media(max-width:992px){.zcs-col-3{flex-basis:calc(50% - 8px);max-width:calc(50% - 8px)}.zcs-col-4,.zcs-col-8{flex-basis:100%;max-width:100%}.ops{padding:18px}}\n@media(max-width:576px){.ops{padding:12px}.hero{padding:18px}.hero&gt;.zcs-flex{align-items:flex-start;flex-direction:column}.hero-icon{display:none}.zcs-col-3,.zcs-col-6{flex-basis:100%;max-width:100%}.kpi-list,.event-grid{gap:10px}.chart-card{min-height:auto}.donut-wrap{flex-direction:column}.quick .zcs-button{flex:1 1 calc(50% - 8px);justify-content:center}.bars{height:175px}.hide-phone{display:none}}\n&lt;/style&gt;\n&lt;div class=&apos;ops zcs-flex zcs-direction-column zcs-gap-20 zcs-box-border&apos;&gt;\n\t&lt;section class=&apos;hero zcs-card&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&apos;&gt;\n\t\t\t&lt;div&gt;&lt;p class=&apos;zcs-font-14 zcs-m-0&apos;&gt;Hello &lt;%=userName%&gt;&lt;/p&gt;&lt;h2 class=&apos;zcs-font-24 zcs-m-0&apos;&gt;Operations overview&lt;/h2&gt;&lt;p class=&apos;zcs-font-14 zcs-m-0&apos;&gt;Events, delivery, approvals, attendance and revenue in one view&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;i class=&apos;hero-icon zc-li-outline business-chart-bar-32&apos;&gt;&lt;/i&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;quick&apos; style=&apos;margin-top:18px&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-rounded-md&apos; href=&apos;#Report:All_Events&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-60&apos;&gt;&lt;/i&gt;&lt;span&gt;Events&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-rounded-md&apos; href=&apos;#Form:Daily_Work_Updates&apos;&gt;&lt;i class=&apos;zc-li-outline design-todo&apos;&gt;&lt;/i&gt;&lt;span&gt;Daily Work Update&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-rounded-md&apos; href=&apos;#Form:Discount_Requests&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-tag&apos;&gt;&lt;/i&gt;&lt;span&gt;Discount Request&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-rounded-md&apos; href=&apos;#Form:Manual_Invoice&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-folded-content&apos;&gt;&lt;/i&gt;&lt;span&gt;Manual Invoice&lt;/span&gt;&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/section&gt;\n\t&lt;ul class=&apos;kpi-list zcs-row zcs-gap-16 zcs-p-0 zcs-m-0&apos;&gt;\n&lt;%\nkpis = {{&quot;Active events&quot;,activeEvents,&quot;ui-1-calendar-60&quot;,&quot;good&quot;},{&quot;Overdue tasks&quot;,overdueTasks,&quot;ui-2-time&quot;,&quot;danger&quot;},{&quot;Pending leave / WFH&quot;,pendingApprovals,&quot;ui-3-alert&quot;,&quot;warn&quot;},{&quot;Monthly registrations&quot;,monthlyRegistrations,&quot;users-multiple-19&quot;,&quot;&quot;},{&quot;Monthly attendance&quot;,monthlyAttendance,&quot;users-single-03&quot;,&quot;good&quot;},{&quot;Monthly revenue&quot;,&quot;USD &quot; + monthlyRevenue,&quot;business-money-coins&quot;,&quot;good&quot;},{&quot;Pending discounts&quot;,pendingDiscounts,&quot;shopping-tag&quot;,&quot;warn&quot;},{&quot;Outstanding invoices&quot;,outstandingInvoices,&quot;files-single-folded-content&quot;,&quot;danger&quot;}};\nfor each kpi in kpis\n{\n%&gt;\n\t\t&lt;li class=&apos;zcs-col-3&apos;&gt;&lt;div class=&apos;kpi &lt;%=kpi.get(3)%&gt; zcs-card zcs-p-16 zcs-flex zcs-direction-column zcs-gap-8 zcs-box-border&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=kpi.get(2)%&gt;&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;strong class=&apos;zcs-font-24 zcs-color-primary&apos;&gt;&lt;%=kpi.get(1)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;span class=&apos;zcs-font-14 zcs-color-tertiary&apos;&gt;&lt;%=kpi.get(0)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;% } %&gt;\n\t&lt;/ul&gt;\n\t&lt;div class=&apos;zcs-row zcs-gap-16&apos;&gt;\n\t\t&lt;section class=&apos;chart-card zcs-card zcs-col-6 zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h3 class=&apos;zcs-font-18 zcs-m-0 zcs-color-primary&apos;&gt;Event status&lt;/h3&gt;&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Current portfolio distribution&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;donut-wrap zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-20&apos;&gt;&lt;div class=&apos;donut zcs-rounded-half zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;strong class=&apos;zcs-font-20&apos;&gt;&lt;%=statusTentative + statusOpen + statusProgress + statusCompleted%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;ul class=&apos;legend zcs-flex zcs-direction-column zcs-gap-8 zcs-p-0&apos;&gt;&lt;li class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;dot&apos; style=&apos;background:#f0b429&apos;&gt;&lt;/span&gt;Tentative &lt;strong&gt;&lt;%=statusTentative%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;li class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;dot&apos; style=&apos;background:#2a6ffc&apos;&gt;&lt;/span&gt;Open &lt;strong&gt;&lt;%=statusOpen%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;li class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;dot&apos; style=&apos;background:#9b6cff&apos;&gt;&lt;/span&gt;In Progress &lt;strong&gt;&lt;%=statusProgress%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;li class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;dot&apos; style=&apos;background:#28a978&apos;&gt;&lt;/span&gt;Completed &lt;strong&gt;&lt;%=statusCompleted%&gt;&lt;/strong&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;chart-card zcs-card zcs-col-6 zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h3 class=&apos;zcs-font-18 zcs-m-0 zcs-color-primary&apos;&gt;Event type&lt;/h3&gt;&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Events by delivery model&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;bars zcs-flex zcs-align-items-end zcs-gap-8&apos;&gt;&lt;% typeData={{&quot;Webinar&quot;,typeWebinar},{&quot;Online&quot;,typeOnline},{&quot;In-person&quot;,typeInPerson},{&quot;Custom&quot;,typeCustom},{&quot;Other&quot;,typeOther}}; for each t in typeData { pct=(t.get(1)*100)/typeMax; %&gt;&lt;div class=&apos;bar-item zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;zcs-font-13&apos;&gt;&lt;%=t.get(1)%&gt;&lt;/span&gt;&lt;div class=&apos;bar&apos; style=&apos;height:&lt;%=pct%&gt;%&apos;&gt;&lt;/div&gt;&lt;span class=&apos;bar-label zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;%=t.get(0)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;&lt;/section&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;zcs-row zcs-gap-16&apos;&gt;\n\t\t&lt;section class=&apos;chart-card zcs-card zcs-col-8 zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h3 class=&apos;zcs-font-18 zcs-m-0 zcs-color-primary&apos;&gt;Monthly revenue trend&lt;/h3&gt;&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Latest recorded event outcomes&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;revenue-bars bars zcs-flex zcs-align-items-end zcs-gap-12&apos;&gt;&lt;% revCounter=0; for each rev in Post_Event_Statistics[ID != 0] sort by Statistics_Year desc { if(revCounter &lt; 8) { revPct=(ifnull(rev.Revenue_USD,0)*100)/revenueMax; %&gt;&lt;div class=&apos;bar-item zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;USD &lt;%=ifnull(rev.Revenue_USD,0)%&gt;&lt;/span&gt;&lt;div class=&apos;bar alt&apos; style=&apos;height:&lt;%=revPct%&gt;%&apos;&gt;&lt;/div&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;%=rev.Statistics_Month%&gt;&lt;/span&gt;&lt;/div&gt;&lt;% revCounter=revCounter+1; } } if(revCounter==0) { %&gt;&lt;div class=&apos;empty zcs-w-full&apos;&gt;No revenue statistics recorded yet.&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;chart-card zcs-card zcs-col-4 zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h3 class=&apos;zcs-font-18 zcs-m-0 zcs-color-primary&apos;&gt;Task status&lt;/h3&gt;&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Execution distribution&lt;/span&gt;&lt;/div&gt;&lt;% taskData={{&quot;Assigned&quot;,taskAssigned,&quot;#f0b429&quot;},{&quot;In Progress&quot;,taskProgress,&quot;#2a6ffc&quot;},{&quot;Completed&quot;,taskCompleted,&quot;#28a978&quot;}}; for each ts in taskData { taskPct=(ts.get(1)*100)/taskTotal; %&gt;&lt;div style=&apos;margin-bottom:18px&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-font-14&apos;&gt;&lt;span&gt;&lt;%=ts.get(0)%&gt;&lt;/span&gt;&lt;strong&gt;&lt;%=ts.get(1)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div style=&apos;height:8px;background:#eef0f4;border-radius:8px;margin-top:7px&apos;&gt;&lt;div style=&apos;height:8px;width:&lt;%=taskPct%&gt;%;background:&lt;%=ts.get(2)%&gt;;border-radius:8px&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;&lt;/section&gt;\n\t&lt;/div&gt;\n\t&lt;section&gt;&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;div&gt;&lt;h3 class=&apos;zcs-font-18 zcs-m-0 zcs-color-primary&apos;&gt;Upcoming events&lt;/h3&gt;&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Next scheduled delivery commitments&lt;/span&gt;&lt;/div&gt;&lt;a class=&apos;zcs-font-14 zcs-color-theme&apos; href=&apos;#Report:Events_Calendar&apos;&gt;Open calendar&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;event-grid zcs-row zcs-gap-16&apos;&gt;&lt;% eventCounter=0; for each ev in Events[Start_Date &gt;= zoho.currentdate &amp;&amp; Status != &quot;Cancelled&quot; &amp;&amp; Status != &quot;Completed&quot;] sort by Start_Date asc { if(eventCounter &lt; 6) { %&gt;&lt;article class=&apos;zcs-col-4&apos;&gt;&lt;div class=&apos;zcs-card&apos;&gt;&lt;div class=&apos;event-top zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;h4 class=&apos;zcs-font-16 zcs-m-0 zcs-color-primary&apos;&gt;&lt;%=ev.Event_Name%&gt;&lt;/h4&gt;&lt;span class=&apos;badge zcs-font-12&apos;&gt;&lt;%=ev.Status%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos; style=&apos;margin-top:8px&apos;&gt;&lt;%=ev.Product.Product_Name%&gt;&lt;/p&gt;&lt;/div&gt;&lt;div class=&apos;event-meta zcs-flex zcs-justify-space-between zcs-gap-8 zcs-p-16&apos;&gt;&lt;span class=&apos;zcs-font-13&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-60&apos;&gt;&lt;/i&gt; &lt;%=ev.Start_Date.toString(&quot;dd-MMM-yyyy&quot;)%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-font-13&apos;&gt;&lt;i class=&apos;zc-li-outline business-briefcase-24&apos;&gt;&lt;/i&gt; &lt;%=ev.Event_Type%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/article&gt;&lt;% eventCounter=eventCounter+1; } } if(eventCounter==0) { %&gt;&lt;div class=&apos;empty zcs-card zcs-w-full&apos;&gt;No upcoming dated events.&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;&lt;/section&gt;\n\t&lt;div class=&apos;zcs-row zcs-gap-16&apos;&gt;\n\t\t&lt;section class=&apos;zcs-card zcs-col-8 zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;section-head zcs-flex zcs-justify-space-between&apos;&gt;&lt;div&gt;&lt;h3 class=&apos;zcs-font-18 zcs-m-0 zcs-color-primary&apos;&gt;Delayed tasks&lt;/h3&gt;&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Items requiring delivery attention&lt;/span&gt;&lt;/div&gt;&lt;a class=&apos;zcs-font-14 zcs-color-theme&apos; href=&apos;#Report:Delayed_Tasks&apos;&gt;View report&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;zcs-table-wrapper zcs-rounded-md&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-text-left&apos;&gt;Task&lt;/th&gt;&lt;th class=&apos;zcs-text-left&apos;&gt;Event&lt;/th&gt;&lt;th class=&apos;zcs-text-left&apos;&gt;Trainer&lt;/th&gt;&lt;th class=&apos;zcs-text-left&apos;&gt;Deadline&lt;/th&gt;&lt;th class=&apos;zcs-text-left&apos;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;% delayedCounter=0; for each task in Task_Assignments[Delivery_Status == &quot;Delayed&quot;] sort by Deadline asc { if(delayedCounter &lt; 8) { %&gt;&lt;tr&gt;&lt;td&gt;&lt;%=task.Task_Work_Item%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=task.Event.Event_Name%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=task.Assigned_Trainer.Name.first_name%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=task.Deadline.toString(&quot;dd-MMM-yyyy&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;span class=&apos;badge delayed&apos;&gt;&lt;%=task.Progress_Status%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% delayedCounter=delayedCounter+1; } } if(delayedCounter==0) { %&gt;&lt;tr&gt;&lt;td colspan=&apos;5&apos; class=&apos;empty&apos;&gt;No delayed tasks.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;aside class=&apos;zcs-card zcs-col-4 zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h3 class=&apos;zcs-font-18 zcs-m-0 zcs-color-primary&apos;&gt;Pending approvals&lt;/h3&gt;&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Current request activity&lt;/span&gt;&lt;/div&gt;&lt;ul class=&apos;feed zcs-flex zcs-direction-column zcs-gap-20 zcs-p-0&apos;&gt;&lt;li&gt;&lt;strong class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=pendingLeave%&gt; leave requests&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Awaiting reporting-manager action&lt;/p&gt;&lt;a class=&apos;zcs-font-13 zcs-color-theme&apos; href=&apos;#Report:All_Leave_Requests&apos;&gt;Review leave&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;strong class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=pendingWFH%&gt; WFH requests&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Awaiting reporting-manager action&lt;/p&gt;&lt;a class=&apos;zcs-font-13 zcs-color-theme&apos; href=&apos;#Report:All_WFH_Requests&apos;&gt;Review WFH&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;strong class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=pendingDiscounts%&gt; discount requests&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Awaiting selected approver&lt;/p&gt;&lt;a class=&apos;zcs-font-13 zcs-color-theme&apos; href=&apos;#Report:Discount_Requests_Tracker&apos;&gt;Review discounts&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;strong class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=outstandingInvoices%&gt; outstanding invoices&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Raised or sent, not yet paid&lt;/p&gt;&lt;a class=&apos;zcs-font-13 zcs-color-theme&apos; href=&apos;#Report:Outstanding_Invoices&apos;&gt;Review invoices&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/aside&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Validate_Country_Wise_Statistics as "Validate Country Wise Statistics"
			{
			    type = form
			    form = Country_Wise_Statistics
			    record event = on add or edit
			    description = "Allows only webinar statistics and validates nonnegative registration and attendance totals."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                parent_statistics = Post_Event_Statistics[ID == input.Post_Event_Statistics];
			                if(parent_statistics.Event_Type != "Webinar")
			                {
			                    alert "Country-wise statistics can only be recorded for Webinar events.";
			                    cancel submit;
			                }
			                if(input.Registrations < 0 || input.Attendees < 0)
			                {
			                    alert "Registrations and Attendees cannot be negative.";
			                    cancel submit;
			                }
			                if(input.Attendees > input.Registrations)
			                {
			                    alert "Attendees cannot exceed Registrations.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Finalize_Daily_Work_Update as "Finalize Daily Work Update"
			{
			    type = form
			    form = Daily_Work_Updates
			    record event = on add or edit
			    description = "Synchronizes assigned-task progress and deterministically rebuilds the consolidated BRD status message."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                category_names = List();
			                for each work_row in input.Work_Items
			                {
			                    category_name = "General Work";
			                    if(work_row.Event_Work_Category != null)
			                    {
			                        category_event = Events[ID == work_row.Event_Work_Category];
			                        if(category_event.count() > 0)
			                        {
			                            category_name = category_event.Event_Name;
			                        }
			                    }
			                    if(!category_names.contains(category_name))
			                    {
			                        category_names.add(category_name);
			                    }
			                    if(work_row.Assigned_Task != null)
			                    {
			                        mapped_progress = work_row.Status;
			                        if(mapped_progress == "No Progress")
			                        {
			                            mapped_progress = "Assigned";
			                        }
			                        if(mapped_progress == "Completed")
			                        {
			                            update Task_Assignments[ID == work_row.Assigned_Task]
			                            [
			                                Progress_Status = mapped_progress
			                                Completion_Date = input.Update_Date
			                            ];
			                        }
			                        else
			                        {
			                            update Task_Assignments[ID == work_row.Assigned_Task]
			                            [
			                                Progress_Status = mapped_progress
			                                Completion_Date = null
			                            ];
			                        }
			                    }
			                }
			                consolidated_html = "<h2>Daily Work Update - " + input.Update_Date.toString("dd-MMM-yyyy") + "</h2>";
			                consolidated_html = consolidated_html + "<h3>Overall Categories</h3><ul>";
			                for each overall_category in category_names
			                {
			                    consolidated_html = consolidated_html + "<li>" + overall_category + "</li>";
			                }
			                consolidated_html = consolidated_html + "</ul>";
			                for each category_heading in category_names
			                {
			                    consolidated_html = consolidated_html + "<h3>" + category_heading + "</h3><ul>";
			                    for each detail_row in input.Work_Items
			                    {
			                        detail_category = "General Work";
			                        if(detail_row.Event_Work_Category != null)
			                        {
			                            detail_event = Events[ID == detail_row.Event_Work_Category];
			                            if(detail_event.count() > 0)
			                            {
			                                detail_category = detail_event.Event_Name;
			                            }
			                        }
			                        if(detail_category == category_heading)
			                        {
			                            consolidated_html = consolidated_html + "<li>" + detail_row.Work_Done_Description + " <strong>Status:</strong> " + detail_row.Status + "</li>";
			                        }
			                    }
			                    consolidated_html = consolidated_html + "</ul>";
			                }
			                update Daily_Work_Updates[ID == input.ID]
			                [
			                    Consolidated_Update = consolidated_html
			                ];
			            )
			        }
			    }
			}

			Initialize_Daily_Work_Update as "Initialize Daily Work Update"
			{
			    type = form
			    form = Daily_Work_Updates
			    record event = on add or edit
			    description = "Defaults the logged-in member and date, protects generated fields, and preloads incomplete assigned tasks on new entries."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Team_Member == null)
			                {
			                    login_member = Team_Members[Email == zoho.loginuserid && Status == "Active"];
			                    if(login_member.count() > 0)
			                    {
			                        input.Team_Member = login_member.ID;
			                    }
			                }
			                if(input.Update_Date == null)
			                {
			                    input.Update_Date = zoho.currentdate;
			                }
			                if(input.ID == null && input.Team_Member != null)
			                {
			                    existing_task_ids = List();
			                    for each existing_row in input.Work_Items
			                    {
			                        if(existing_row.Assigned_Task != null)
			                        {
			                            existing_task_ids.add(existing_row.Assigned_Task);
			                        }
			                    }
			                    preload_rows = Collection();
			                    for each assigned_task in Task_Assignments[Assigned_Trainer == input.Team_Member && Progress_Status != "Completed"]
			                    {
			                        if(!existing_task_ids.contains(assigned_task.ID))
			                        {
			                            preload_row = Daily_Work_Updates.Work_Items();
			                            preload_row.Assigned_Task = assigned_task.ID;
			                            preload_row.Event_Work_Category = assigned_task.Event;
			                            preload_row.Work_Done_Description = assigned_task.Task_Work_Item;
			                            preload_row.Status = if(assigned_task.Progress_Status == "Assigned", "No Progress", assigned_task.Progress_Status);
			                            preload_row.Hours_Worked = 0;
			                            preload_rows.insert(preload_row);
			                            existing_task_ids.add(assigned_task.ID);
			                        }
			                    }
			                    if(preload_rows.size() > 0)
			                    {
			                        input.Work_Items.insert(preload_rows);
			                    }
			                }
			                disable Team_Member;
			                disable Update_Date;
			                disable Consolidated_Update;
			                hide Consolidated_Update;
			            )
			        }
			    }
			}

			Validate_Daily_Work_Update as "Validate Daily Work Update"
			{
			    type = form
			    form = Daily_Work_Updates
			    record event = on add or edit
			    description = "Requires work items and enforces one daily update per member and date."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Work_Items == null || input.Work_Items.isEmpty())
			                {
			                    alert "Add at least one work item before submitting the daily update.";
			                    cancel submit;
			                }
			                if(input.ID == null)
			                {
			                    duplicate_count = Daily_Work_Updates[Team_Member == input.Team_Member && Update_Date == input.Update_Date].count();
			                }
			                else
			                {
			                    duplicate_count = Daily_Work_Updates[Team_Member == input.Team_Member && Update_Date == input.Update_Date && ID != input.ID].count();
			                }
			                if(duplicate_count > 0)
			                {
			                    alert "A daily work update already exists for this team member and date.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Initialize_Discount_Request as "Initialize Discount Request"
			{
			    type = form
			    form = Discount_Requests
			    record event = on add or edit
			    description = "Sets the logged-in requester and protects routing, status, and calculated fields."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Requester == null)
			                {
			                    login_member = Team_Members[Email == zoho.loginuserid && Status == "Active"];
			                    if(login_member.count() > 0)
			                    {
			                        input.Requester = login_member.ID;
			                    }
			                }
			                hide Approver_User;
			                disable Requester;
			                disable Status;
			            )
			        }
			    }
			}

			Notify_Discount_Approver as "Notify Discount Approver"
			{
			    type = form
			    form = Discount_Requests[Status == "Requested"]
			    record event = on add
			    description = "Notifies the selected approver when a discount request is submitted."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                sendmail
			                [
			                    from: zoho.adminuserid
			                    to: input.Approver_User.email
			                    subject: "Discount request awaiting your approval"
			                    message: "A discount request for " + input.Event.Event_Name + " from " + input.Requester.Name.first_name + " is awaiting your approval. Requested discount: " + input.Discount_Percentage + "% on USD " + input.Total_Amount_USD + "."
			                ]
			            )
			        }
			    }
			}

			Notify_Requester_Promo_Fulfilment as "Notify Requester of Promo Fulfilment"
			{
			    type = form
			    form = Discount_Requests[Promo_Code_Status == "Added"]
			    record event = on edit
			    description = "Notifies the requester after promo-code or registration fulfilment details are supplied."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                sendmail
			                [
			                    from: zoho.adminuserid
			                    to: input.Requester.Email
			                    subject: "Promo code fulfilment updated"
			                    message: "Promo fulfilment details for " + input.Event.Event_Name + " are now available. Promo code: " + input.Promo_Code + ". Registration URL: " + input.Registration_URL
			                ]
			            )
			        }
			    }
			}

			Open_Add_Promo_Code as "Open Add Promo Code"
			{
			    type = functions
			    form = Discount_Requests
			    execution type = for each record
			    description = "Opens the selected approved discount request in an edit popup for promo-code fulfilment."
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                openUrl("#Form:Discount_Requests?recLinkID=" + input.ID + "&viewLinkName=Discount_Requests_Tracker", "popup window", "height=650px,width=760px");
			            )
			        }
			    }
			}

			Set_Discount_Approver_User as "Set Discount Approver User"
			{
			    type = form
			    form = Discount_Requests
			    record event = on add or edit
			    description = "Copies the deliberately selected team approver's Creator user into the approval routing field."
			
			    on user input of Approver
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Approver != null)
			                {
			                    selected_approver = Team_Members[ID == input.Approver];
			                    input.Approver_User = selected_approver.Creator_User;
			                }
			                else
			                {
			                    input.Approver_User = null;
			                }
			            )
			        }
			    }
			}

			Validate_Discount_Request as "Validate Discount Request"
			{
			    type = form
			    form = Discount_Requests
			    record event = on add or edit
			    description = "Validates amounts, discount range, event-product consistency, active approver selection, and rejection details."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Number_of_Tickets <= 0)
			                {
			                    alert "Number of Tickets must be greater than zero.";
			                    cancel submit;
			                }
			                if(input.Unit_Amount_USD <= 0)
			                {
			                    alert "Unit Amount (USD) must be greater than zero.";
			                    cancel submit;
			                }
			                if(input.Discount_Percentage < 0 || input.Discount_Percentage > 100)
			                {
			                    alert "Discount Percentage must be between 0 and 100.";
			                    cancel submit;
			                }
			                selected_event = Events[ID == input.Event];
			                if(selected_event.count() == 0 || selected_event.Product != input.Product)
			                {
			                    alert "The selected Event must belong to the selected Product.";
			                    cancel submit;
			                }
			                selected_approver = Team_Members[ID == input.Approver];
			                if(selected_approver.count() == 0 || selected_approver.Status != "Active" || selected_approver.Creator_User == null)
			                {
			                    alert "Approver must be an active team member linked to a Creator user.";
			                    cancel submit;
			                }
			                input.Approver_User = selected_approver.Creator_User;
			                if(input.Status == "Rejected" && (input.Reason_for_Rejection == null || input.Reason_for_Rejection.trim() == ""))
			                {
			                    alert "Reason for Rejection is required when a request is rejected.";
			                    cancel submit;
			                }
			                if((input.Promo_Code != null && input.Promo_Code.trim() != "") || input.Registration_URL != null)
			                {
			                    input.Promo_Code_Status = "Added";
			                }
			                else
			                {
			                    input.Promo_Code_Status = "Yet to Add";
			                }
			            )
			        }
			    }
			}

			Check_During_Event_Selection as "Check During Event Selection"
			{
			    type = form
			    form = During_Event_Updates
			    record event = on add or edit
			    description = "Prevents webinar updates and warns when the update date is outside the selected event."
			
			    on user input of Event
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Event != null)
			                {
			                    selected_event = Events[ID == input.Event];
			                    if(selected_event.Event_Type == "Webinar")
			                    {
			                        input.Event = null;
			                        alert "During-event updates cannot be created for Webinar events.";
			                    }
			                    else if(input.Update_Date != null && (selected_event.Start_Date == null || selected_event.End_Date == null || input.Update_Date < selected_event.Start_Date || input.Update_Date > selected_event.End_Date))
			                    {
			                        alert "Update Date must fall within the selected event's Start Date and End Date.";
			                    }
			                }
			            )
			        }
			    }
			}

			Initialize_During_Event_Update as "Initialize During Event Update"
			{
			    type = form
			    form = During_Event_Updates
			    record event = on add or edit
			    description = "Sets the trainer from the logged-in active team member and protects ownership."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Trainer == null)
			                {
			                    login_member = Team_Members[Email == zoho.loginuserid && Status == "Active"];
			                    if(login_member.count() > 0)
			                    {
			                        input.Trainer = login_member.ID;
			                    }
			                }
			                disable Trainer;
			            )
			        }
			    }
			}

			Validate_During_Event_Update as "Validate During Event Update"
			{
			    type = form
			    form = During_Event_Updates
			    record event = on add or edit
			    description = "Validates event eligibility, date range, and Event-Date-Trainer uniqueness."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                selected_event = Events[ID == input.Event];
			                if(selected_event.Event_Type == "Webinar")
			                {
			                    alert "During-event updates cannot be created for Webinar events.";
			                    cancel submit;
			                }
			                if(selected_event.Start_Date == null || selected_event.End_Date == null || input.Update_Date < selected_event.Start_Date || input.Update_Date > selected_event.End_Date)
			                {
			                    alert "Update Date must fall within the selected event's Start Date and End Date.";
			                    cancel submit;
			                }
			                if(input.ID == null)
			                {
			                    duplicate_count = During_Event_Updates[Event == input.Event && Update_Date == input.Update_Date && Trainer == input.Trainer].count();
			                }
			                else
			                {
			                    duplicate_count = During_Event_Updates[Event == input.Event && Update_Date == input.Update_Date && Trainer == input.Trainer && ID != input.ID].count();
			                }
			                if(duplicate_count > 0)
			                {
			                    alert "An update already exists for this Event, Update Date, and Trainer.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Configure_Event_On_Load as "Configure Event On Load"
			{
			    type = form
			    form = Events
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Event_Type == "Webinar")
			                {
			                    show QA_Trainer;
			                }
			                else
			                {
			                    hide QA_Trainer;
			                }
			                if(input.Event_Type == "Certification")
			                {
			                    show Certification_Name;
			                    show Certification_Year;
			                    show Certification_Month;
			                    hide Start_Date;
			                    hide End_Date;
			                    disable Start_Date;
			                    disable End_Date;
			                }
			                else
			                {
			                    hide Certification_Name;
			                    hide Certification_Year;
			                    hide Certification_Month;
			                    show Start_Date;
			                    show End_Date;
			                    enable Start_Date;
			                    enable End_Date;
			                }
			            )
			        }
			    }
			}

			Configure_Event_Type as "Configure Event Type"
			{
			    type = form
			    form = Events
			    record event = on add or edit
			
			    on user input of Event_Type
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Event_Type == "Webinar")
			                {
			                    show QA_Trainer;
			                }
			                else
			                {
			                    hide QA_Trainer;
			                }
			                if(input.Event_Type == "Certification")
			                {
			                    show Certification_Name;
			                    show Certification_Year;
			                    show Certification_Month;
			                    hide Start_Date;
			                    hide End_Date;
			                    disable Start_Date;
			                    disable End_Date;
			                }
			                else
			                {
			                    hide Certification_Name;
			                    hide Certification_Year;
			                    hide Certification_Month;
			                    show Start_Date;
			                    show End_Date;
			                    enable Start_Date;
			                    enable End_Date;
			                }
			            )
			        }
			    }
			}

			Notify_Trainers_On_Create as "Notify Trainers On Create"
			{
			    type = form
			    form = Events
			    record event = on add
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                for each trainer in Team_Members[ID in input.Trainers]
			                {
			                    sendmail
			                    [
			                        from: zoho.adminuserid
			                        to: trainer.Email
			                        subject: "Event assigned: " + input.Event_Name
			                        message: "You have been assigned to " + input.Event_Name + "."
			                    ]
			                }
			            )
			        }
			    }
			}

			Notify_Trainers_On_Reassignment as "Notify Trainers On Reassignment"
			{
			    type = form
			    form = Events
			    record event = on edit
			
			    on update of Trainers
			    {
			        actions
			        {
			            custom deluge script
			            (
			                for each trainer in Team_Members[ID in input.Trainers]
			                {
			                    sendmail
			                    [
			                        from: zoho.adminuserid
			                        to: trainer.Email
			                        subject: "Event assignment updated: " + input.Event_Name
			                        message: "Your assignment for " + input.Event_Name + " has been added or updated."
			                    ]
			                }
			            )
			        }
			    }
			}

			Validate_Event as "Validate Event"
			{
			    type = form
			    form = Events
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Trainers == null || input.Trainers.size() == 0)
			                {
			                    alert "Assign at least one trainer.";
			                    cancel submit;
			                }
			                if(input.Event_Type != "Certification")
			                {
			                    if(input.Start_Date == null || input.End_Date == null)
			                    {
			                        alert "Start Date and End Date are required for non-certification events.";
			                        cancel submit;
			                    }
			                    else if(input.End_Date < input.Start_Date)
			                    {
			                        alert "End Date must be on or after Start Date.";
			                        cancel submit;
			                    }
			                }
			                if(input.Event_Type == "Certification" && (input.Certification_Name == null || input.Certification_Year == null))
			                {
			                    alert "Certification Name and Certification Year are required for certification events.";
			                    cancel submit;
			                }
			                if(input.Event_Type == "Webinar" && input.QA_Trainer == null)
			                {
			                    alert "QA Trainer is required for webinars.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Validate_Exchange_Rate as "Validate Exchange Rate"
			{
			    type = form
			    form = Exchange_Rates
			    record event = on add or edit
			    description = "Validates positive USD-based rates and prevents duplicate active rates for the same currency and effective date."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Units_Per_USD <= 0)
			                {
			                    alert "Units Per USD must be greater than zero.";
			                    cancel submit;
			                }
			                if(input.Currency_Code == "USD" && input.Units_Per_USD != 1)
			                {
			                    alert "The USD rate must equal 1.";
			                    cancel submit;
			                }
			                if(input.Status == "Active")
			                {
			                    duplicate_count = Exchange_Rates[Currency_Code == input.Currency_Code && Effective_Date == input.Effective_Date && Status == "Active" && ID != input.ID].count();
			                    if(duplicate_count > 0)
			                    {
			                        alert "An active exchange rate already exists for this currency and effective date.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Initialize_Leave_Request as "Initialize Leave Request"
			{
			    type = form
			    form = Leave_Requests
			    record event = on add or edit
			    description = "Identifies the logged-in requester, assigns the reporting manager as approver, and protects routing fields."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Requester == null)
			                {
			                    login_member = Team_Members[Email == zoho.loginuserid && Status == "Active"];
			                    if(login_member.count() > 0)
			                    {
			                        input.Requester = login_member.ID;
			                    }
			                }
			                if(input.Requester != null)
			                {
			                    requester_record = Team_Members[ID == input.Requester];
			                    if(requester_record.Reporting_To != null)
			                    {
			                        input.Approver = requester_record.Reporting_To.Creator_User;
			                    }
			                    else
			                    {
			                        input.Approver = requester_record.Creator_User;
			                    }
			                }
			                disable Requester;
			                disable Approver;
			                disable Status;
			            )
			        }
			    }
			}

			Notify_Leave_Approver as "Notify Leave Approver"
			{
			    type = form
			    form = Leave_Requests[Status == "Pending"]
			    record event = on add
			    description = "Notifies the assigned approver after a new pending leave request is submitted."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                sendmail
			                [
			                    from: zoho.adminuserid
			                    to: input.Approver.email
			                    subject: "New leave request awaiting approval"
			                    message: "A new " + input.Leave_Type + " request from " + input.Requester.Name.first_name + " for " + input.Start_Date + " through " + input.End_Date + " is awaiting your approval."
			                ]
			            )
			        }
			    }
			}

			Validate_Leave_Request as "Validate Leave Request"
			{
			    type = form
			    form = Leave_Requests
			    record event = on add or edit
			    description = "Validates leave dates, advance notice, and rejection details."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.End_Date < input.Start_Date)
			                {
			                    alert "End Date must be on or after Start Date.";
			                    cancel submit;
			                }
			                if(input.Leave_Type != "Sick Leave" && input.Start_Date < zoho.currentdate.addDay(7))
			                {
			                    alert "Casual and planned leave must start at least 7 days after today.";
			                    cancel submit;
			                }
			                if(input.Status == "Rejected" && (input.Rejection_Reason == null || input.Rejection_Reason.trim() == ""))
			                {
			                    alert "Rejection Reason is required when a request is rejected.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Email_Invoice_Team as "Email Invoice Team"
			{
			    type = functions
			    form = Manual_Invoice
			    execution type = for each record
			    description = "Emails the complete manual invoice request to the selected invoice team and marks the request as raised."
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                sendmail
			                [
			                    from: zoho.adminuserid
			                    to: input.Invoice_Email
			                    reply to: input.Requester.Email
			                    subject: "Manual invoice request - " + input.Ticket_ID + " - " + input.Company_Name
			                    message: "<h3>Manual Invoice Request</h3><p><b>Ticket ID:</b> " + input.Ticket_ID + "<br><b>Product:</b> " + input.Product.Product_Name + "<br><b>Event:</b> " + input.Event.Event_Name + "<br><b>Certification / Training:</b> " + input.Certification_Training_Name + "</p><h4>Billing</h4><p><b>Company:</b> " + input.Company_Name + "<br><b>Billing Name:</b> " + input.Billing_Name + "<br><b>Billing Address:</b> " + input.Billing_Address + "<br><b>Billing Email:</b> " + input.Billing_Email + "<br><b>Contact Person:</b> " + input.Contact_Person + "<br><b>Region / Country:</b> " + input.Region_Country + "</p><h4>Amounts and Currency</h4><p><b>Total Tickets:</b> " + input.Total_Tickets + "<br><b>Amount Per Ticket USD:</b> " + input.Amount_Per_Ticket_USD + "<br><b>Total USD:</b> " + input.Total_Amount_USD + "<br><b>Converted Currency:</b> " + input.Converted_Currency + "<br><b>Rate Used:</b> " + input.Rate_Used + "<br><b>Total Invoice Amount:</b> " + input.Total_Invoice_Amount + "</p><h4>Tax</h4><p><b>GST Number:</b> " + input.GST_Number + "<br><b>VAT ID:</b> " + input.VAT_ID + "<br><b>Tax Exemption Certificate:</b> " + input.Tax_Exemption_Certificate_URL + "</p><p><b>Comments:</b> " + input.Comments + "</p>"
			                ];
			                input.Status = "Invoice Raised";
			            )
			        }
			    }
			}

			Initialize_Manual_Invoice as "Initialize Manual Invoice"
			{
			    type = form
			    form = Manual_Invoice
			    record event = on add or edit
			    description = "Defaults the requester and invoice date and protects calculated conversion fields."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Requester == null)
			                {
			                    login_member = Team_Members[Email == zoho.loginuserid && Status == "Active"];
			                    if(login_member.count() > 0)
			                    {
			                        input.Requester = login_member.ID;
			                    }
			                }
			                if(input.Invoice_Date == null)
			                {
			                    input.Invoice_Date = zoho.currentdate;
			                }
			                disable Requester;
			                disable Exchange_Rate;
			                disable Rate_Used;
			                disable Total_Invoice_Amount;
			            )
			        }
			    }
			}

			Set_Manual_Invoice_Rate as "Set Manual Invoice Rate"
			{
			    type = form
			    form = Manual_Invoice
			    record event = on add or edit
			    description = "Selects the latest active applicable maintained exchange rate and calculates the converted invoice amount."
			
			    on user input of Converted_Currency
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Exchange_Rate = null;
			                input.Rate_Used = null;
			                input.Total_Invoice_Amount = null;
			                applicable_rates = Exchange_Rates[Currency_Code == input.Converted_Currency && Status == "Active" && Effective_Date <= zoho.currentdate] sort by Effective_Date desc range from 0 to 0;
			                if(applicable_rates.count() > 0)
			                {
			                    input.Exchange_Rate = applicable_rates.ID;
			                    input.Rate_Used = applicable_rates.Units_Per_USD;
			                    input.Total_Invoice_Amount = (input.Total_Tickets * input.Amount_Per_Ticket_USD) * input.Rate_Used;
			                }
			                else
			                {
			                    alert "No active exchange rate effective on or before today is available for the selected currency.";
			                }
			            )
			        }
			    }
			}

			Validate_Manual_Invoice as "Validate Manual Invoice"
			{
			    type = form
			    form = Manual_Invoice
			    record event = on add or edit
			    description = "Validates references and paid details and recalculates the invoice conversion from the maintained rate server-side."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Event.Product != input.Product)
			                {
			                    alert "The selected event does not belong to the selected product.";
			                    cancel submit;
			                }
			                if(input.Total_Tickets <= 0)
			                {
			                    alert "Total Tickets must be greater than zero.";
			                    cancel submit;
			                }
			                if(input.Amount_Per_Ticket_USD <= 0)
			                {
			                    alert "Amount Per Ticket (USD) must be greater than zero.";
			                    cancel submit;
			                }
			                applicable_rates = Exchange_Rates[Currency_Code == input.Converted_Currency && Status == "Active" && Effective_Date <= zoho.currentdate] sort by Effective_Date desc range from 0 to 0;
			                if(applicable_rates.count() == 0)
			                {
			                    alert "No active exchange rate effective on or before today is available for the selected currency.";
			                    cancel submit;
			                }
			                else
			                {
			                    input.Exchange_Rate = applicable_rates.ID;
			                    input.Rate_Used = applicable_rates.Units_Per_USD;
			                    input.Total_Invoice_Amount = (input.Total_Tickets * input.Amount_Per_Ticket_USD) * input.Rate_Used;
			                }
			                if(input.Status == "Invoice Paid" && (input.Invoice_Number == null || input.Invoice_Ticket_ID == null || input.Invoice_Paid_On == null))
			                {
			                    alert "Invoice Number, Invoice Ticket ID, and Invoice Paid On are required when status is Invoice Paid.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Configure_Statistics_On_Load as "Configure Statistics On Load"
			{
			    type = form
			    form = Post_Event_Statistics
			    record event = on add or edit
			    description = "Shows only the post-event insight fields relevant to the selected event type."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                hide Revenue_USD, Survey_Report_URL, Feedback_Insights_URL, Debrief_URL;
			                if(input.Event_Type == "Online Training")
			                {
			                    show Revenue_USD, Survey_Report_URL;
			                }
			                else if(input.Event_Type == "In-person" || input.Event_Type == "Customized Training")
			                {
			                    show Revenue_USD, Feedback_Insights_URL, Debrief_URL;
			                }
			                else if(input.Event_Type == "Certification")
			                {
			                    show Revenue_USD;
			                }
			            )
			        }
			    }
			}

			Populate_Event_Statistics as "Populate Event Statistics"
			{
			    type = form
			    form = Post_Event_Statistics
			    record event = on add or edit
			    description = "Mirrors the selected event's product, type, month, and year and applies event-type field visibility."
			
			    on user input of Event
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Event != null)
			                {
			                    input.Product = Events[ID == input.Event].Product;
			                    input.Event_Type = Events[ID == input.Event].Event_Type;
			                    event_date = Events[ID == input.Event].Start_Date;
			                    if(event_date != null)
			                    {
			                        month_number = event_date.getMonth();
			                        if(month_number == 1) { input.Statistics_Month = "January"; }
			                        else if(month_number == 2) { input.Statistics_Month = "February"; }
			                        else if(month_number == 3) { input.Statistics_Month = "March"; }
			                        else if(month_number == 4) { input.Statistics_Month = "April"; }
			                        else if(month_number == 5) { input.Statistics_Month = "May"; }
			                        else if(month_number == 6) { input.Statistics_Month = "June"; }
			                        else if(month_number == 7) { input.Statistics_Month = "July"; }
			                        else if(month_number == 8) { input.Statistics_Month = "August"; }
			                        else if(month_number == 9) { input.Statistics_Month = "September"; }
			                        else if(month_number == 10) { input.Statistics_Month = "October"; }
			                        else if(month_number == 11) { input.Statistics_Month = "November"; }
			                        else if(month_number == 12) { input.Statistics_Month = "December"; }
			                        input.Statistics_Year = event_date.getYear();
			                    }
			                }
			                hide Revenue_USD, Survey_Report_URL, Feedback_Insights_URL, Debrief_URL;
			                if(input.Event_Type == "Online Training")
			                {
			                    show Revenue_USD, Survey_Report_URL;
			                }
			                else if(input.Event_Type == "In-person" || input.Event_Type == "Customized Training")
			                {
			                    show Revenue_USD, Feedback_Insights_URL, Debrief_URL;
			                }
			                else if(input.Event_Type == "Certification")
			                {
			                    show Revenue_USD;
			                }
			            )
			        }
			    }
			}

			Validate_Post_Event_Statistics as "Validate Post Event Statistics"
			{
			    type = form
			    form = Post_Event_Statistics
			    record event = on add or edit
			    description = "Rejects negative totals and attendance greater than registrations."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Total_Registrations < 0 || input.Total_Attendees < 0 || input.Revenue_USD < 0)
			                {
			                    alert "Registrations, attendees, and revenue cannot be negative.";
			                    cancel submit;
			                }
			                if(input.Total_Attendees > input.Total_Registrations)
			                {
			                    alert "Total Attendees cannot exceed Total Registrations.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Configure_Pre_Event_Activity_Type as "Configure Pre Event Activity Type"
			{
			    type = form
			    form = Pre_Event_Activities
			    record event = on add or edit
			
			    on user input of Activity_Type
			    {
			        actions
			        {
			            custom deluge script
			            (
			                event_type = "";
			                if(input.Event != null)
			                {
			                    event_type = Events[ID == input.Event].Event_Type;
			                }
			                hide Topic_or_Session;
			                hide Assigned_Trainer;
			                hide Review_Lead;
			                hide Review_Status;
			                hide Total_Registrations;
			                hide Revenue_USD;
			                hide Statistics_Message;
			                hide Survey_Link;
			                hide Recording_Link;
			                hide Materials_Link;
			                if(input.Activity_Type == "Agenda Topic")
			                {
			                    show Topic_or_Session;
			                    show Assigned_Trainer;
			                }
			                if(input.Activity_Type == "Promotional Content" || input.Activity_Type == "Connect Post" || input.Activity_Type == "Email Invite" || input.Activity_Type == "Presentation" || input.Activity_Type == "Dry Run" || input.Activity_Type == "Follow-up Content")
			                {
			                    show Review_Lead;
			                    show Review_Status;
			                }
			                if(input.Activity_Type == "Statistics Update" && event_type == "Online Training")
			                {
			                    show Total_Registrations;
			                    show Revenue_USD;
			                    show Statistics_Message;
			                    show Survey_Link;
			                    show Recording_Link;
			                    show Materials_Link;
			                }
			            )
			        }
			    }
			}

			Configure_Pre_Event_Event as "Configure Pre Event Event"
			{
			    type = form
			    form = Pre_Event_Activities
			    record event = on add or edit
			
			    on user input of Event
			    {
			        actions
			        {
			            custom deluge script
			            (
			                event_type = "";
			                if(input.Event != null)
			                {
			                    event_type = Events[ID == input.Event].Event_Type;
			                }
			                clear Activity_Type;
			                if(event_type == "Webinar")
			                {
			                    Activity_Type:ui.add({"Promotional Content","Connect Post","Email Invite","Presentation","Dry Run","Follow-up Content","Statistics Update"});
			                    if(input.Activity_Type == "Agenda Topic")
			                    {
			                        input.Activity_Type = null;
			                        hide Topic_or_Session;
			                        hide Assigned_Trainer;
			                    }
			                }
			                else
			                {
			                    Activity_Type:ui.add({"Promotional Content","Connect Post","Email Invite","Presentation","Dry Run","Follow-up Content","Agenda Topic","Statistics Update"});
			                }
			                if(input.Activity_Type == "Statistics Update" && event_type == "Online Training")
			                {
			                    show Total_Registrations;
			                    show Revenue_USD;
			                    show Statistics_Message;
			                    show Survey_Link;
			                    show Recording_Link;
			                    show Materials_Link;
			                }
			                else
			                {
			                    hide Total_Registrations;
			                    hide Revenue_USD;
			                    hide Statistics_Message;
			                    hide Survey_Link;
			                    hide Recording_Link;
			                    hide Materials_Link;
			                }
			            )
			        }
			    }
			}

			Configure_Pre_Event_On_Load as "Configure Pre Event On Load"
			{
			    type = form
			    form = Pre_Event_Activities
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Created_By == null)
			                {
			                    login_member = Team_Members[Email == zoho.loginuserid && Status == "Active"];
			                    if(login_member.count() > 0)
			                    {
			                        input.Created_By = login_member.ID;
			                    }
			                }
			                event_type = "";
			                if(input.Event != null)
			                {
			                    event_type = Events[ID == input.Event].Event_Type;
			                }
			                clear Activity_Type;
			                if(event_type == "Webinar")
			                {
			                    Activity_Type:ui.add({"Promotional Content","Connect Post","Email Invite","Presentation","Dry Run","Follow-up Content","Statistics Update"});
			                }
			                else
			                {
			                    Activity_Type:ui.add({"Promotional Content","Connect Post","Email Invite","Presentation","Dry Run","Follow-up Content","Agenda Topic","Statistics Update"});
			                }
			                hide Topic_or_Session;
			                hide Assigned_Trainer;
			                hide Review_Lead;
			                hide Review_Status;
			                hide Total_Registrations;
			                hide Revenue_USD;
			                hide Statistics_Message;
			                hide Survey_Link;
			                hide Recording_Link;
			                hide Materials_Link;
			                if(input.Activity_Type == "Agenda Topic")
			                {
			                    show Topic_or_Session;
			                    show Assigned_Trainer;
			                }
			                if(input.Activity_Type == "Promotional Content" || input.Activity_Type == "Connect Post" || input.Activity_Type == "Email Invite" || input.Activity_Type == "Presentation" || input.Activity_Type == "Dry Run" || input.Activity_Type == "Follow-up Content")
			                {
			                    show Review_Lead;
			                    show Review_Status;
			                }
			                if(input.Activity_Type == "Statistics Update" && event_type == "Online Training")
			                {
			                    show Total_Registrations;
			                    show Revenue_USD;
			                    show Statistics_Message;
			                    show Survey_Link;
			                    show Recording_Link;
			                    show Materials_Link;
			                }
			            )
			        }
			    }
			}

			Notify_Review_Lead as "Notify Review Lead"
			{
			    type = form
			    form = Pre_Event_Activities[Review_Status == "Pending Review"]
			    record event = on edit
			
			    on update of Review_Status
			    {
			        actions ( Review_Lead != null )
			        {
			            custom deluge script
			            (
			                sendmail
			                [
			                    from: zoho.adminuserid
			                    to: input.Review_Lead.Email
			                    subject: "Content awaiting review: " + input.Content_Name
			                    message: input.Content_Name + " for " + input.Event.Event_Name + " has been submitted for your review."
			                ]
			            )
			        }
			    }
			}

			Notify_Review_Lead_On_Create as "Notify Review Lead On Create"
			{
			    type = form
			    form = Pre_Event_Activities[Review_Status == "Pending Review"]
			    record event = on add
			
			    on success
			    {
			        actions ( Review_Lead != null )
			        {
			            custom deluge script
			            (
			                sendmail
			                [
			                    from: zoho.adminuserid
			                    to: input.Review_Lead.Email
			                    subject: "Content awaiting review: " + input.Content_Name
			                    message: input.Content_Name + " for " + input.Event.Event_Name + " has been submitted for your review."
			                ]
			            )
			        }
			    }
			}

			Validate_Pre_Event_Activity as "Validate Pre Event Activity"
			{
			    type = form
			    form = Pre_Event_Activities
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                event_record = Events[ID == input.Event];
			                if(input.Activity_Type == "Agenda Topic" && event_record.Event_Type == "Webinar")
			                {
			                    alert "Agenda Topic activities are not allowed for webinars.";
			                    cancel submit;
			                }
			                if(input.Activity_Type == "Statistics Update")
			                {
			                    if(event_record.Event_Type != "Online Training")
			                    {
			                        alert "Statistics Update activities are allowed only for Online Training events.";
			                        cancel submit;
			                    }
			                    if(input.Target_Date == null)
			                    {
			                        alert "Target Date is required for an Online Training statistics update.";
			                        cancel submit;
			                    }
			                    else if(input.Target_Date < event_record.Start_Date.addDay(-7))
			                    {
			                        alert "Statistics updates cannot be dated earlier than one week before the session start date.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Validate_Source_Wise_Statistics as "Validate Source Wise Statistics"
			{
			    type = form
			    form = Source_Wise_Statistics
			    record event = on add or edit
			    description = "Allows only webinar statistics and validates nonnegative registration and attendance totals."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                parent_statistics = Post_Event_Statistics[ID == input.Post_Event_Statistics];
			                if(parent_statistics.Event_Type != "Webinar")
			                {
			                    alert "Source-wise statistics can only be recorded for Webinar events.";
			                    cancel submit;
			                }
			                if(input.Registrations < 0 || input.Attendees < 0)
			                {
			                    alert "Registrations and Attendees cannot be negative.";
			                    cancel submit;
			                }
			                if(input.Attendees > input.Registrations)
			                {
			                    alert "Attendees cannot exceed Registrations.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Initialize_Task_Assignment as "Initialize Task Assignment"
			{
			    type = form
			    form = Task_Assignments
			    record event = on add or edit
			    description = "Defaults the assigned date for new tasks and keeps it read-only."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Assigned_Date == null)
			                {
			                    input.Assigned_Date = zoho.currentdate;
			                }
			                disable Assigned_Date;
			            )
			        }
			    }
			}

			Mark_Overdue_Tasks_Delayed as "Mark Overdue Tasks Delayed"
			{
			    type = schedule
			    form = Task_Assignments[Progress_Status != "Completed"]
			    start = after 1 days from Deadline at "00:05:00"
			    frequency = daily
			    time zone = "Asia/Kolkata"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                if(input.Progress_Status != "Completed" && zoho.currentdate > input.Deadline)
			                {
			                    input.Delivery_Status = "Delayed";
			                }
			            )
			        }
			    }
			}

			Notify_New_Task_Assignment as "Notify New Task Assignment"
			{
			    type = form
			    form = Task_Assignments
			    record event = on add
			    description = "Notifies the assigned trainer after a new task is created."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                sendmail
			                [
			                    from: zoho.adminuserid
			                    to: input.Assigned_Trainer.Email
			                    subject: "New task assigned: " + input.Task_Work_Item
			                    message: "You have been assigned work for " + input.Event.Event_Name + ". Deadline: " + input.Deadline + "."
			                ]
			            )
			        }
			    }
			}

			Notify_Task_Reassignment as "Notify Task Reassignment"
			{
			    type = form
			    form = Task_Assignments
			    record event = on edit
			    description = "Notifies the newly assigned trainer when a task is reassigned."
			
			    on update of Assigned_Trainer
			    {
			        actions
			        {
			            custom deluge script
			            (
			                sendmail
			                [
			                    from: zoho.adminuserid
			                    to: input.Assigned_Trainer.Email
			                    subject: "Task reassigned to you: " + input.Task_Work_Item
			                    message: "This task for " + input.Event.Event_Name + " has been reassigned to you. Deadline: " + input.Deadline + "."
			                ]
			            )
			        }
			    }
			}

			Validate_Task_Assignment as "Validate Task Assignment"
			{
			    type = form
			    form = Task_Assignments
			    record event = on add or edit
			    description = "Validates task dates, completion requirements, and delayed-task notes."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Deadline < input.Assigned_Date)
			                {
			                    alert "Deadline must be on or after the assigned date.";
			                    cancel submit;
			                }
			                if(input.Progress_Status == "Completed" && input.Completion_Date == null)
			                {
			                    alert "Completion Date is required when progress is Completed.";
			                    cancel submit;
			                }
			                is_delayed = false;
			                if(input.Completion_Date != null && input.Completion_Date > input.Deadline)
			                {
			                    is_delayed = true;
			                }
			                if(input.Progress_Status != "Completed" && zoho.currentdate > input.Deadline)
			                {
			                    is_delayed = true;
			                }
			                if(is_delayed)
			                {
			                    input.Delivery_Status = "Delayed";
			                }
			                else
			                {
			                    input.Delivery_Status = "On Time";
			                }
			                if(input.Delivery_Status == "Delayed" && (input.Delay_Reason_Notes == null || input.Delay_Reason_Notes.trim() == ""))
			                {
			                    alert "Delay Reason / Notes is required for delayed tasks.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Load_WFH_Request as "Load WFH Request"
			{
			    type = form
			    form = Work_From_Home_Requests
			    record event = on add or edit
			    description = "Populates the requester and reporting manager approver and protects routing fields."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.ID == null)
			                {
			                    member = Team_Members[Email == zoho.loginuserid && Status == "Active"];
			                    if(member.ID != null)
			                    {
			                        input.Requester = member.ID;
			                        if(member.Reporting_To != null)
			                        {
			                            input.Approver = member.Reporting_To.Creator_User;
			                        }
			                        else
			                        {
			                            input.Approver = member.Creator_User;
			                        }
			                    }
			                }
			                disable Requester;
			                disable Approver;
			                disable Status;
			            )
			        }
			    }
			}

			Notify_WFH_Approver as "Notify WFH Approver"
			{
			    type = form
			    form = Work_From_Home_Requests[Status == "Pending"]
			    record event = on add
			    description = "Notifies the reporting manager when a new work-from-home request is submitted."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                sendmail
			                [
			                    from: zoho.adminuserid
			                    to: input.Approver
			                    subject: "Work from home request awaiting approval"
			                    message: "A work from home request for " + input.WFH_Date + " is awaiting your approval. Reason: " + input.Reason
			                ]
			            )
			        }
			    }
			}

			Validate_WFH_Request as "Validate WFH Request"
			{
			    type = form
			    form = Work_From_Home_Requests
			    record event = on add or edit
			    description = "Rejects past work-from-home dates and requires a reason for rejected requests."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.WFH_Date < zoho.currentdate)
			                {
			                    alert(WFH_Date, "WFH Date must be today or a future date.");
			                    cancel submit;
			                }
			                if(input.Status == "Rejected" && (input.Rejection_Reason == null || input.Rejection_Reason.trim() == ""))
			                {
			                    alert(Rejection_Reason, "Rejection Reason is required when rejecting a request.");
			                    cancel submit;
			                }
			            )
			        }
			    }
			}
		}

		approval
		{
			Discount_Request_Approval as "Discount Request Approval"
			{
			    type = approval
			    form = Discount_Requests[Status == "Requested"]
			    display fields = [Product, Event, Requester, Customer_Company, Discount_Type, Number_of_Tickets, Total_Amount_USD, Discount_Percentage, Discounted_Amount_USD, Reason_for_Request, Approver, Status]
			    recall request = true
			
			    on start
			    {
			        actions
			        {
			            Status = "Requested";
			        }
			    }
			
			    on level 1
			    {
			        approvers
			        (
			            field = Approver_User
			        )
			
			        on approve
			        {
			            actions
			            {
			                Status = "Approved";
			            }
			        }
			
			        on reject
			        {
			            actions
			            {
			                Status = "Rejected";
			            }
			        }
			    }
			}

			Leave_Request_Approval as "Leave Request Approval"
			{
			    type = approval
			    form = Leave_Requests[Status == "Pending"]
			    display fields = [Requester, Leave_Type, Start_Date, End_Date, Reason, Rejection_Reason, Status]
			    recall request = true
			
			    on start
			    {
			        actions
			        {
			            Status = "Pending";
			        }
			    }
			
			    on level 1
			    {
			        approvers
			        (
			            field = Approver
			        )
			
			        on approve
			        {
			            actions
			            {
			                Status = "Approved";
			            }
			        }
			
			        on reject
			        {
			            actions
			            {
			                Status = "Rejected";
			            }
			        }
			    }
			}

			WFH_Request_Approval as "WFH Request Approval"
			{
			    type = approval
			    form = Work_From_Home_Requests[Status == "Pending"]
			    display fields = [Requester, WFH_Date, Reason, Status, Rejection_Reason]
			    recall request = true
			
			    on start
			    {
			        actions
			        {
			            Status = "Pending";
			        }
			    }
			
			    on level 1
			    {
			        approvers
			        (
			            field = Approver
			        )
			
			        on approve
			        {
			            actions
			            {
			                Status = "Approved";
			            }
			        }
			
			        on reject
			        {
			            actions
			            {
			                Status = "Rejected";
			            }
			        }
			    }
			}
		}
	}

