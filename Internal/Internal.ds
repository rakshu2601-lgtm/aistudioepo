application "Internal"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Country_Wise_Statistics
		{
		    Country_Statistics
		    (
		        type = section
		        displayname = "Country Statistics"
		        row = 1
		        column = 0
		    )
		    must have Post_Event_Statistics
		    (
		        type = picklist
		        displayname = "Post Event Statistics"
		        values = Post_Event_Statistics.ID
		        displayformat = [Event_Type]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Region
		    (
		        type = picklist
		        values = {"APAC & ANZ","EMEA","Americas"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Country
		    (
		        type = text
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Registrations
		    (
		        type = number
		        initial value = 0
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Attendees
		    (
		        type = number
		        initial value = 0
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		        }
		    }
		}

		form Daily_Work_Items
		{
		    displayname = "Daily Work Items"
		
		    Work_Item
		    (
		        type = section
		        displayname = "Work Item"
		        row = 1
		        column = 0
		    )
		    Daily_Update
		    (
		        type = picklist
		        displayname = "Daily Update"
		        values = Daily_Work_Updates.ID
		        bidirectional = Work_Items
		        displayformat = [Update_Date]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Event_Work_Category
		    (
		        type = picklist
		        displayname = "Event / Work Category"
		        values = Events.ID
		        displayformat = [Event_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Assigned_Task
		    (
		        type = picklist
		        displayname = "Assigned Task"
		        values = Task_Assignments.ID
		        displayformat = [Task_Work_Item]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Work_Done_Description
		    (
		        type = richtext
		        displayname = "Work Done Description"
		        height = 160px
		        toolbar = enable
		        [
		            style, bullets-and-numbering, link, remove-formatting
		        ]
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"No Progress", "In Progress", "Completed"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Hours_Worked
		    (
		        type = decimal
		        displayname = "Hours Worked"
		        initial value = 0
		        decimalplace = 2
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Daily_Work_Updates
		{
		    displayname = "Daily Work Updates"
		
		    Daily_Update
		    (
		        type = section
		        displayname = "Daily Update"
		        row = 1
		        column = 0
		    )
		    must have Team_Member
		    (
		        type = picklist
		        displayname = "Team Member"
		        values = Team_Members.ID
		        displayformat = [Name.first_name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Update_Date
		    (
		        type = date
		        displayname = "Update Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Consolidated_Update
		    (
		        type = richtext
		        displayname = "Consolidated Update"
		        height = 240px
		        toolbar = disable
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Work_Items_Section
		    (
		        type = section
		        displayname = "Work Items"
		        visibility = false
		        row = 2
		        column = 1
		    )
		    must have Work_Items
		    (
		        type = grid
		        displayname = "Work Items"
		        values = Daily_Work_Items.ID
		        bidirectional = Daily_Update
		        defaultrow = 0
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Discount_Requests
		{
		    displayname = "Discount Requests"
		    success message = "Discount request submitted successfully."
		
		    Event_Details
		    (
		        type = section
		        displayname = "Event Details"
		        row = 1
		        column = 0
		    )
		    must have Product
		    (
		        type = picklist
		        values = Products.ID
		        displayformat = [Product_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Event
		    (
		        type = picklist
		        values = Events.ID
		        displayformat = [Event_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Ticket_ID
		    (
		        type = text
		        displayname = "Ticket ID"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Request_Details
		    (
		        type = section
		        displayname = "Request Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Requester
		    (
		        type = picklist
		        values = Team_Members.ID
		        displayformat = [Name.first_name]
		        searchable = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    Customer_Company
		    (
		        type = text
		        displayname = "Customer Company"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Customer_Email
		    (
		        type = email
		        displayname = "Customer Email"
		        personal data = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Discount_Type
		    (
		        type = picklist
		        displayname = "Discount Type"
		        values = {"Partner","Customer","Prospect","Other"}
		        others option = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Number_of_Tickets
		    (
		        type = number
		        displayname = "Number of Tickets"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Unit_Amount_USD
		    (
		        type = USD
		        displayname = "Unit Amount (USD)"
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 2
		        width = medium
		    )
		    Total_Amount_USD
		    (
		        type = formula
		        displayname = "Total Amount (USD)"
		        value = Number_of_Tickets * Unit_Amount_USD
		        visibility = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Discount_Percentage
		    (
		        type = percentage
		        displayname = "Discount Percentage"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Discounted_Amount_USD
		    (
		        type = formula
		        displayname = "Discounted Amount (USD)"
		        value = (Number_of_Tickets * Unit_Amount_USD) - ((Number_of_Tickets * Unit_Amount_USD) * Discount_Percentage / 100)
		        visibility = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Reason_for_Request
		    (
		        type = textarea
		        displayname = "Reason for Request"
		        height = 100px
		        row = 2
		        column = 2
		        width = medium
		    )
		
		    Approval_Details
		    (
		        type = section
		        displayname = "Approval Details"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    must have Approver
		    (
		        type = picklist
		        values = Team_Members.ID
		        displayformat = [Name.first_name]
		        searchable = true
		        row = 3
		        column = 1
		        width = medium
		    )
		    Approver_User
		    (
		        type = users
		        displayname = "Approver User"
		        personal data = true
		        row = 3
		        column = 2
		        width = medium
		    )
		    Status
		    (
		        type = picklist
		        values = {"Requested","Approved","Rejected"}
		        initial value = "Requested"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Reason_for_Rejection
		    (
		        type = textarea
		        displayname = "Reason for Rejection"
		        height = 100px
		        row = 3
		        column = 2
		        width = medium
		    )
		
		    Promo_Code_Fulfilment
		    (
		        type = section
		        displayname = "Promo Code Fulfilment"
		        visibility = true
		        row = 4
		        column = 1
		    )
		    Assigned_Promo_Owner
		    (
		        type = picklist
		        displayname = "Assigned Promo Owner"
		        values = Team_Members.ID
		        displayformat = [Name.first_name]
		        searchable = true
		        row = 4
		        column = 1
		        width = medium
		    )
		    Promo_Code
		    (
		        type = text
		        displayname = "Promo Code"
		        row = 4
		        column = 2
		        width = medium
		    )
		    Registration_URL
		    (
		        type = url
		        displayname = "Registration URL"
		        target = new window
		        enable = linkname, title
		        row = 4
		        column = 1
		        width = medium
		    )
		    Promo_Code_Status
		    (
		        type = picklist
		        displayname = "Promo Code Status"
		        values = {"Yet to Add","Added"}
		        initial value = "Yet to Add"
		        row = 4
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit Request"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Request"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form During_Event_Updates
		{
		    displayname = "During Event Updates"
		
		    Daily_Event_Update
		    (
		        type = section
		        displayname = "Daily Event Update"
		        row = 1
		        column = 0
		    )
		    must have Event
		    (
		        type = picklist
		        values = Events.ID
		        displayformat = [Event_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Update_Date
		    (
		        type = date
		        displayname = "Update Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Trainer
		    (
		        type = picklist
		        values = Team_Members.ID
		        displayformat = [Name.first_name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Daily_Summary
		    (
		        type = textarea
		        displayname = "Daily Summary"
		        height = 120px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Registration_Details
		    (
		        type = textarea
		        displayname = "Registration Details"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Attendee_Details
		    (
		        type = textarea
		        displayname = "Attendee Details"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Recording_URL
		    (
		        type = url
		        displayname = "Recording URL"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Materials_URL
		    (
		        type = url
		        displayname = "Materials URL"
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Events
		{
		    Event_Details
		    (
		        type = section
		        displayname = "Event Details"
		        row = 1
		        column = 0
		    )
		    must have Product
		    (
		        type = picklist
		        values = Products.ID
		        displayformat = [Product_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Event_Name
		    (
		        type = text
		        displayname = "Event Name"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Event_Type
		    (
		        type = picklist
		        displayname = "Event Type"
		        values = {"Webinar","Online Training","In-person","Customized Training","Adhoc","Certification"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Start_Date
		    (
		        type = date
		        displayname = "Start Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    End_Date
		    (
		        type = date
		        displayname = "End Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Duration_Days
		    (
		        type = formula
		        displayname = "Duration Days"
		        value = if(Start_Date != null && End_Date != null, Start_Date.daysBetween(End_Date) + 1, 0)
		        visibility = false
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        values = {"Tentative","Open","In Progress","Completed","Hold","Cancelled"}
		        initial value = "Tentative"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Trainers
		    (
		        type = list
		        values = Team_Members[Status == "Active" && Role == "Trainer"].ID
		        displayformat = [Name.first_name]
		        searchable = true
		        height = 120px
		        row = 1
		        column = 1
		        width = medium
		    )
		    QA_Trainer
		    (
		        type = picklist
		        displayname = "QA Trainer"
		        values = Team_Members[Status == "Active" && Role == "Trainer"].ID
		        displayformat = [Name.first_name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Certification_Name
		    (
		        type = text
		        displayname = "Certification Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Certification_Year
		    (
		        type = number
		        displayname = "Certification Year"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Certification_Month
		    (
		        type = picklist
		        displayname = "Certification Month"
		        values = {"January","February","March","April","May","June","July","August","September","October","November","December"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Survey_Report_URL
		    (
		        type = url
		        displayname = "Survey Report URL"
		        target = new window
		        enable = linkname, title
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		        }
		    }
		}

		form Exchange_Rates
		{
		    title
		    {
		        displayname = "Exchange Rates"
		        on add = "Add Exchange Rate"
		        on edit = "Edit Exchange Rate"
		    }
		
		    Rate_Details
		    (
		        type = section
		        displayname = "Rate Details"
		        row = 1
		        column = 0
		    )
		    must have Currency_Code
		    (
		        type = picklist
		        displayname = "Currency Code"
		        values = {"USD", "INR", "CAD", "AED", "EUR", "NZD", "ZAR", "AUD", "EGP", "MYR"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Units_Per_USD
		    (
		        type = decimal
		        displayname = "Units Per USD"
		        decimalplace = 6
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Effective_Date
		    (
		        type = date
		        displayname = "Effective Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active", "Inactive"}
		        initial value = "Active"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Leave_Requests
		{
		    displayname = "Leave Requests"
		
		    Request_Details
		    (
		        type = section
		        displayname = "Request Details"
		        row = 1
		        column = 0
		    )
		    must have Requester
		    (
		        type = picklist
		        values = Team_Members.ID
		        displayformat = [Name.first_name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Leave_Type
		    (
		        type = picklist
		        displayname = "Leave Type"
		        values = {"Sick Leave", "Casual Leave", "Planned Leave"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Start_Date
		    (
		        type = date
		        displayname = "Start Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have End_Date
		    (
		        type = date
		        displayname = "End Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Reason
		    (
		        type = textarea
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Approver
		    (
		        type = users
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        values = {"Pending", "Approved", "Rejected"}
		        initial value = "Pending"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Rejection_Reason
		    (
		        type = textarea
		        displayname = "Rejection Reason"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Manual_Invoice
		{
		    displayname = "Manual Invoice"
		
		    References
		    (
		        type = section
		        displayname = "References"
		        row = 1
		        column = 0
		    )
		    must have Ticket_ID
		    (
		        type = text
		        displayname = "Ticket ID"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Product
		    (
		        type = picklist
		        values = Products.ID
		        displayformat = [Product_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Event
		    (
		        type = picklist
		        values = Events.ID
		        displayformat = [Event_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Certification_Training_Name
		    (
		        type = text
		        displayname = "Certification / Training Name"
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Requester_and_Billing
		    (
		        type = section
		        displayname = "Requester and Billing"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Requester
		    (
		        type = picklist
		        values = Team_Members.ID
		        displayformat = [Name.first_name]
		        searchable = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Company_Name
		    (
		        type = text
		        displayname = "Company Name"
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Billing_Name
		    (
		        type = text
		        displayname = "Billing Name"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Billing_Address
		    (
		        type = textarea
		        displayname = "Billing Address"
		        height = 100px
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Billing_Email
		    (
		        type = email
		        displayname = "Billing Email"
		        personal data = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    Region_Country
		    (
		        type = text
		        displayname = "Region / Country"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Contact_Person
		    (
		        type = email
		        displayname = "Contact Person"
		        personal data = true
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Amounts
		    (
		        type = section
		        displayname = "Amounts"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    must have Total_Tickets
		    (
		        type = number
		        displayname = "Total Tickets"
		        row = 3
		        column = 1
		        width = medium
		    )
		    must have Amount_Per_Ticket_USD
		    (
		        type = USD
		        displayname = "Amount Per Ticket (USD)"
		        decimalplace = 2
		        maxchar = 16
		        row = 3
		        column = 2
		        width = medium
		    )
		    Total_Amount_USD
		    (
		        type = formula
		        displayname = "Total Amount (USD)"
		        value = Total_Tickets * Amount_Per_Ticket_USD
		        visibility = true
		        row = 3
		        column = 1
		        width = medium
		    )
		    must have Converted_Currency
		    (
		        type = picklist
		        displayname = "Converted Currency"
		        values = {"USD", "INR", "CAD", "AED", "EUR", "NZD", "ZAR", "AUD", "EGP", "MYR"}
		        row = 3
		        column = 2
		        width = medium
		    )
		    must have Exchange_Rate
		    (
		        type = picklist
		        displayname = "Exchange Rate"
		        values = Exchange_Rates.ID
		        displayformat = [Currency_Code]
		        searchable = true
		        row = 3
		        column = 1
		        width = medium
		    )
		    must have Rate_Used
		    (
		        type = decimal
		        displayname = "Rate Used"
		        decimalplace = 6
		        row = 3
		        column = 2
		        width = medium
		    )
		    must have Total_Invoice_Amount
		    (
		        type = decimal
		        displayname = "Total Invoice Amount"
		        decimalplace = 2
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    Invoice_Processing
		    (
		        type = section
		        displayname = "Invoice Processing"
		        visibility = true
		        row = 4
		        column = 1
		    )
		    GST_Number
		    (
		        type = text
		        displayname = "GST Number"
		        row = 4
		        column = 1
		        width = medium
		    )
		    VAT_ID
		    (
		        type = text
		        displayname = "VAT ID"
		        row = 4
		        column = 2
		        width = medium
		    )
		    Tax_Exemption_Certificate_URL
		    (
		        type = url
		        displayname = "Tax Exemption Certificate URL"
		        target = new window
		        enable = linkname, title
		        row = 4
		        column = 1
		        width = medium
		    )
		    Comments
		    (
		        type = textarea
		        height = 100px
		        row = 4
		        column = 2
		        width = medium
		    )
		    Invoice_Email
		    (
		        type = picklist
		        displayname = "Invoice Email"
		        values = {"inv.zstoreind@zohocorp.com", "invoice@zohocorp.com"}
		        row = 4
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        values = {"Draft", "Invoice Raised", "Invoice Sent", "Invoice Paid", "Invoice Cancelled"}
		        initial value = "Draft"
		        row = 4
		        column = 2
		        width = medium
		    )
		    Invoice_Date
		    (
		        type = date
		        displayname = "Invoice Date"
		        initial value = "${zoho.currentdate}"
		        row = 4
		        column = 1
		        width = medium
		    )
		    Invoice_Number
		    (
		        type = text
		        displayname = "Invoice Number"
		        row = 4
		        column = 2
		        width = medium
		    )
		    Invoice_Ticket_ID
		    (
		        type = text
		        displayname = "Invoice Ticket ID"
		        row = 4
		        column = 1
		        width = medium
		    )
		    Invoice_Paid_On
		    (
		        type = date
		        displayname = "Invoice Paid On"
		        row = 4
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

