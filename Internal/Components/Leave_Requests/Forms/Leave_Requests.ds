form Leave_Requests
{
    displayname = "Leave Requests"

    Request_Details
    (
        type = section
        displayname = "Request Details"
        row = 1
        column = 0
    )
    must have Requester
    (
        type = picklist
        values = Team_Members.ID
        displayformat = [Name.first_name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Leave_Type
    (
        type = picklist
        displayname = "Leave Type"
        values = {"Sick Leave", "Casual Leave", "Planned Leave"}
        row = 1
        column = 2
        width = medium
    )
    must have Start_Date
    (
        type = date
        displayname = "Start Date"
        row = 1
        column = 1
        width = medium
    )
    must have End_Date
    (
        type = date
        displayname = "End Date"
        row = 1
        column = 2
        width = medium
    )
    must have Reason
    (
        type = textarea
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    must have Approver
    (
        type = users
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        values = {"Pending", "Approved", "Rejected"}
        initial value = "Pending"
        row = 1
        column = 1
        width = medium
    )
    Rejection_Reason
    (
        type = textarea
        displayname = "Rejection Reason"
        height = 100px
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
