form Exchange_Rates
{
    title
    {
        displayname = "Exchange Rates"
        on add = "Add Exchange Rate"
        on edit = "Edit Exchange Rate"
    }

    Rate_Details
    (
        type = section
        displayname = "Rate Details"
        row = 1
        column = 0
    )
    must have Currency_Code
    (
        type = picklist
        displayname = "Currency Code"
        values = {"USD", "INR", "CAD", "AED", "EUR", "NZD", "ZAR", "AUD", "EGP", "MYR"}
        row = 1
        column = 1
        width = medium
    )
    must have Units_Per_USD
    (
        type = decimal
        displayname = "Units Per USD"
        decimalplace = 6
        row = 1
        column = 2
        width = medium
    )
    must have Effective_Date
    (
        type = date
        displayname = "Effective Date"
        row = 1
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 100px
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
