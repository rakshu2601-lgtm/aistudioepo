<%
monthNames = {"January","February","March","April","May","June","July","August","September","October","November","December"};
currentMonth = monthNames.get(zoho.currentdate.getMonth() - 1);
currentYear = zoho.currentdate.getYear();
userName = zoho.loginuser;
member = Team_Members[Email == zoho.loginuserid];
if(member.count() > 0)
{
    userName = member.Name.first_name;
}
activeEvents = Events[Status != "Completed" && Status != "Cancelled"].count();
overdueTasks = Task_Assignments[Progress_Status != "Completed" && Deadline < zoho.currentdate].count();
pendingLeave = Leave_Requests[Status == "Pending"].count();
pendingWFH = Work_From_Home_Requests[Status == "Pending"].count();
pendingApprovals = pendingLeave + pendingWFH;
monthStats = Post_Event_Statistics[Statistics_Month == currentMonth && Statistics_Year == currentYear];
monthlyRegistrations = ifnull(monthStats.sum(Total_Registrations),0);
monthlyAttendance = ifnull(monthStats.sum(Total_Attendees),0);
monthlyRevenue = ifnull(monthStats.sum(Revenue_USD),0);
pendingDiscounts = Discount_Requests[Status == "Requested"].count();
outstandingInvoices = Manual_Invoice[Status == "Invoice Raised" || Status == "Invoice Sent"].count();
statusTentative = Events[Status == "Tentative"].count();
statusOpen = Events[Status == "Open"].count();
statusProgress = Events[Status == "In Progress"].count();
statusCompleted = Events[Status == "Completed"].count();
statusTotal = statusTentative + statusOpen + statusProgress + statusCompleted;
if(statusTotal == 0) { statusTotal = 1; }
typeWebinar = Events[Event_Type == "Webinar"].count();
typeOnline = Events[Event_Type == "Online Training"].count();
typeInPerson = Events[Event_Type == "In-person"].count();
typeCustom = Events[Event_Type == "Customized Training"].count();
typeOther = Events[Event_Type == "Adhoc" || Event_Type == "Certification"].count();
typeMax = typeWebinar;
if(typeOnline > typeMax) { typeMax = typeOnline; }
if(typeInPerson > typeMax) { typeMax = typeInPerson; }
if(typeCustom > typeMax) { typeMax = typeCustom; }
if(typeOther > typeMax) { typeMax = typeOther; }
if(typeMax == 0) { typeMax = 1; }
taskAssigned = Task_Assignments[Progress_Status == "Assigned"].count();
taskProgress = Task_Assignments[Progress_Status == "In Progress"].count();
taskCompleted = Task_Assignments[Progress_Status == "Completed"].count();
taskTotal = taskAssigned + taskProgress + taskCompleted;
if(taskTotal == 0) { taskTotal = 1; }
revenueMax = 0;
for each revCheck in Post_Event_Statistics[Revenue_USD > 0] sort by Statistics_Year desc
{
    if(revCheck.Revenue_USD > revenueMax) { revenueMax = revCheck.Revenue_USD; }
}
if(revenueMax == 0) { revenueMax = 1; }
%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--column-gap:0px}.zcs-flex,.zcs-row{display:flex}.zcs-row{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-end{align-items:flex-end}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-0{padding:0}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.zcs-col-3{flex:0 0 calc(25% - 12px);max-width:calc(25% - 12px)}.zcs-col-4{flex:0 0 calc(33.333% - 11px);max-width:calc(33.333% - 11px)}.zcs-col-6{flex:0 0 calc(50% - 8px);max-width:calc(50% - 8px)}.zcs-col-8{flex:0 0 calc(66.667% - 6px);max-width:calc(66.667% - 6px)}.zcs-col-12{flex:0 0 100%;max-width:100%}
.ops{background:var(--zcs-page-bg-color,#f5f6f8);padding:24px 30px;font-family:inherit}.hero{padding:22px 24px;color:#fff;background:linear-gradient(120deg,var(--zcs_brand_dark_color,#243b78),var(--zcs_brand_color,#4169e1));overflow:hidden}.hero h2,.hero p{color:#fff}.hero-icon{font-size:48px;opacity:.2}.quick{display:flex;gap:8px;flex-wrap:wrap}.zcs-button{min-height:36px;text-decoration:none;border:1px solid rgba(255,255,255,.48);color:#fff;padding:8px 12px}.zcs-button:hover{background:rgba(255,255,255,.12)}.kpi-list{list-style:none}.kpi{box-shadow:0 2px 8px rgba(20,32,64,.05)}.kpi-icon{width:42px;height:42px;background:var(--zcs_brand_light_color,#eef2ff);color:var(--zcs_brand_color);font-size:20px}.kpi.warn .kpi-icon{background:#fff4df;color:#a96800}.kpi.danger .kpi-icon{background:#ffe9ec;color:#d72f4b}.kpi.good .kpi-icon{background:#e5f8f1;color:#13855d}.section-head{margin-bottom:14px}.chart-card{min-height:300px}.donut{width:170px;height:170px;background:conic-gradient(#f0b429 0 calc(<%=statusTentative%> * 100% / <%=statusTotal%>),#2a6ffc 0 calc((<%=statusTentative%> + <%=statusOpen%>) * 100% / <%=statusTotal%>),#9b6cff 0 calc((<%=statusTentative%> + <%=statusOpen%> + <%=statusProgress%>) * 100% / <%=statusTotal%>),#28a978 0);position:relative}.donut:after{content:'';position:absolute;inset:32px;background:#fff;border-radius:50%}.donut strong{z-index:1}.legend{list-style:none}.dot{width:10px;height:10px;border-radius:50%}.bars{height:210px;border-bottom:1px solid var(--zcs-border-color);padding:0 10px}.bar-item{height:100%;flex:1;min-width:48px}.bar{width:30px;min-height:3px;background:var(--zcs_brand_color);border-radius:6px 6px 0 0}.bar.alt{background:#6f77d9}.bar-label{text-align:center}.revenue-bars{overflow-x:auto}.revenue-bars .bar-item{min-width:70px}.event-grid .zcs-card{overflow:hidden}.event-top{border-bottom:1px solid var(--zcs-border-color)}.event-meta{background:var(--zcs_brand_light_color,#f6f7ff)}.badge{display:inline-flex;padding:3px 8px;border-radius:999px;background:#eef2ff;color:#3452a5}.badge.delayed{background:#ffe9ec;color:#c92d47}.badge.pending{background:#fff4df;color:#986000}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;min-width:700px}.zcs-table-wrapper th{background:#f8f9fc}.zcs-table-wrapper th,.zcs-table-wrapper td{padding:10px 14px;border-bottom:1px solid var(--zcs-border-color)}.feed{list-style:none}.feed li{position:relative;padding-left:28px}.feed li:before{content:'';position:absolute;left:5px;top:6px;width:10px;height:10px;border-radius:50%;background:var(--zcs_brand_color)}.feed li:not(:last-child):after{content:'';position:absolute;left:9px;top:16px;bottom:-18px;width:1px;background:var(--zcs-border-color)}.empty{padding:24px;text-align:center;color:var(--zcs-teritiary-text-color)}
@media(max-width:992px){.zcs-col-3{flex-basis:calc(50% - 8px);max-width:calc(50% - 8px)}.zcs-col-4,.zcs-col-8{flex-basis:100%;max-width:100%}.ops{padding:18px}}
@media(max-width:576px){.ops{padding:12px}.hero{padding:18px}.hero>.zcs-flex{align-items:flex-start;flex-direction:column}.hero-icon{display:none}.zcs-col-3,.zcs-col-6{flex-basis:100%;max-width:100%}.kpi-list,.event-grid{gap:10px}.chart-card{min-height:auto}.donut-wrap{flex-direction:column}.quick .zcs-button{flex:1 1 calc(50% - 8px);justify-content:center}.bars{height:175px}.hide-phone{display:none}}
</style>
<div class='ops zcs-flex zcs-direction-column zcs-gap-20 zcs-box-border'>
  <section class='hero zcs-card'>
    <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16'>
      <div><p class='zcs-font-14 zcs-m-0'>Hello <%=userName%></p><h2 class='zcs-font-24 zcs-m-0'>Operations overview</h2><p class='zcs-font-14 zcs-m-0'>Events, delivery, approvals, attendance and revenue in one view</p></div>
      <i class='hero-icon zc-li-outline business-chart-bar-32'></i>
    </div>
    <div class='quick' style='margin-top:18px'>
      <a class='zcs-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-rounded-md' href='#Report:All_Events'><i class='zc-li-outline ui-1-calendar-60'></i><span>Events</span></a>
      <a class='zcs-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-rounded-md' href='#Form:Daily_Work_Updates'><i class='zc-li-outline design-todo'></i><span>Daily Work Update</span></a>
      <a class='zcs-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-rounded-md' href='#Form:Discount_Requests'><i class='zc-li-outline shopping-tag'></i><span>Discount Request</span></a>
      <a class='zcs-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-rounded-md' href='#Form:Manual_Invoice'><i class='zc-li-outline files-single-folded-content'></i><span>Manual Invoice</span></a>
    </div>
  </section>
  <ul class='kpi-list zcs-row zcs-gap-16 zcs-p-0 zcs-m-0'>
<%
kpis = {{"Active events",activeEvents,"ui-1-calendar-60","good"},{"Overdue tasks",overdueTasks,"ui-2-time","danger"},{"Pending leave / WFH",pendingApprovals,"ui-3-alert","warn"},{"Monthly registrations",monthlyRegistrations,"users-multiple-19",""},{"Monthly attendance",monthlyAttendance,"users-single-03","good"},{"Monthly revenue","USD " + monthlyRevenue,"business-money-coins","good"},{"Pending discounts",pendingDiscounts,"shopping-tag","warn"},{"Outstanding invoices",outstandingInvoices,"files-single-folded-content","danger"}};
for each kpi in kpis
{
%>
    <li class='zcs-col-3'><div class='kpi <%=kpi.get(3)%> zcs-card zcs-p-16 zcs-flex zcs-direction-column zcs-gap-8 zcs-box-border'><div class='zcs-flex zcs-align-items-center zcs-gap-12'><span class='kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline <%=kpi.get(2)%>'></i></span><strong class='zcs-font-24 zcs-color-primary'><%=kpi.get(1)%></strong></div><span class='zcs-font-14 zcs-color-tertiary'><%=kpi.get(0)%></span></div></li>
<% } %>
  </ul>
  <div class='zcs-row zcs-gap-16'>
    <section class='chart-card zcs-card zcs-col-6 zcs-p-20 zcs-box-border'><div class='section-head'><h3 class='zcs-font-18 zcs-m-0 zcs-color-primary'>Event status</h3><span class='zcs-font-13 zcs-color-tertiary'>Current portfolio distribution</span></div><div class='donut-wrap zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-20'><div class='donut zcs-rounded-half zcs-flex zcs-align-items-center zcs-justify-center'><strong class='zcs-font-20'><%=statusTentative + statusOpen + statusProgress + statusCompleted%></strong></div><ul class='legend zcs-flex zcs-direction-column zcs-gap-8 zcs-p-0'><li class='zcs-flex zcs-align-items-center zcs-gap-8'><span class='dot' style='background:#f0b429'></span>Tentative <strong><%=statusTentative%></strong></li><li class='zcs-flex zcs-align-items-center zcs-gap-8'><span class='dot' style='background:#2a6ffc'></span>Open <strong><%=statusOpen%></strong></li><li class='zcs-flex zcs-align-items-center zcs-gap-8'><span class='dot' style='background:#9b6cff'></span>In Progress <strong><%=statusProgress%></strong></li><li class='zcs-flex zcs-align-items-center zcs-gap-8'><span class='dot' style='background:#28a978'></span>Completed <strong><%=statusCompleted%></strong></li></ul></div></section>
    <section class='chart-card zcs-card zcs-col-6 zcs-p-20 zcs-box-border'><div class='section-head'><h3 class='zcs-font-18 zcs-m-0 zcs-color-primary'>Event type</h3><span class='zcs-font-13 zcs-color-tertiary'>Events by delivery model</span></div><div class='bars zcs-flex zcs-align-items-end zcs-gap-8'><% typeData={{"Webinar",typeWebinar},{"Online",typeOnline},{"In-person",typeInPerson},{"Custom",typeCustom},{"Other",typeOther}}; for each t in typeData { pct=(t.get(1)*100)/typeMax; %><div class='bar-item zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between'><span class='zcs-font-13'><%=t.get(1)%></span><div class='bar' style='height:<%=pct%>%'></div><span class='bar-label zcs-font-12 zcs-color-tertiary'><%=t.get(0)%></span></div><% } %></div></section>
  </div>
  <div class='zcs-row zcs-gap-16'>
    <section class='chart-card zcs-card zcs-col-8 zcs-p-20 zcs-box-border'><div class='section-head'><h3 class='zcs-font-18 zcs-m-0 zcs-color-primary'>Monthly revenue trend</h3><span class='zcs-font-13 zcs-color-tertiary'>Latest recorded event outcomes</span></div><div class='revenue-bars bars zcs-flex zcs-align-items-end zcs-gap-12'><% revCounter=0; for each rev in Post_Event_Statistics[ID != 0] sort by Statistics_Year desc { if(revCounter < 8) { revPct=(ifnull(rev.Revenue_USD,0)*100)/revenueMax; %><div class='bar-item zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-space-between'><span class='zcs-font-12'>USD <%=ifnull(rev.Revenue_USD,0)%></span><div class='bar alt' style='height:<%=revPct%>%'></div><span class='zcs-font-12 zcs-color-tertiary'><%=rev.Statistics_Month%></span></div><% revCounter=revCounter+1; } } if(revCounter==0) { %><div class='empty zcs-w-full'>No revenue statistics recorded yet.</div><% } %></div></section>
    <section class='chart-card zcs-card zcs-col-4 zcs-p-20 zcs-box-border'><div class='section-head'><h3 class='zcs-font-18 zcs-m-0 zcs-color-primary'>Task status</h3><span class='zcs-font-13 zcs-color-tertiary'>Execution distribution</span></div><% taskData={{"Assigned",taskAssigned,"#f0b429"},{"In Progress",taskProgress,"#2a6ffc"},{"Completed",taskCompleted,"#28a978"}}; for each ts in taskData { taskPct=(ts.get(1)*100)/taskTotal; %><div style='margin-bottom:18px'><div class='zcs-flex zcs-justify-space-between zcs-font-14'><span><%=ts.get(0)%></span><strong><%=ts.get(1)%></strong></div><div style='height:8px;background:#eef0f4;border-radius:8px;margin-top:7px'><div style='height:8px;width:<%=taskPct%>%;background:<%=ts.get(2)%>;border-radius:8px'></div></div></div><% } %></section>
  </div>
  <section><div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between'><div><h3 class='zcs-font-18 zcs-m-0 zcs-color-primary'>Upcoming events</h3><span class='zcs-font-13 zcs-color-tertiary'>Next scheduled delivery commitments</span></div><a class='zcs-font-14 zcs-color-theme' href='#Report:Events_Calendar'>Open calendar</a></div><div class='event-grid zcs-row zcs-gap-16'><% eventCounter=0; for each ev in Events[Start_Date >= zoho.currentdate && Status != "Cancelled" && Status != "Completed"] sort by Start_Date asc { if(eventCounter < 6) { %><article class='zcs-col-4'><div class='zcs-card'><div class='event-top zcs-p-16'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><h4 class='zcs-font-16 zcs-m-0 zcs-color-primary'><%=ev.Event_Name%></h4><span class='badge zcs-font-12'><%=ev.Status%></span></div><p class='zcs-font-13 zcs-color-tertiary zcs-m-0' style='margin-top:8px'><%=ev.Product.Product_Name%></p></div><div class='event-meta zcs-flex zcs-justify-space-between zcs-gap-8 zcs-p-16'><span class='zcs-font-13'><i class='zc-li-outline ui-1-calendar-60'></i> <%=ev.Start_Date.toString("dd-MMM-yyyy")%></span><span class='zcs-font-13'><i class='zc-li-outline business-briefcase-24'></i> <%=ev.Event_Type%></span></div></div></article><% eventCounter=eventCounter+1; } } if(eventCounter==0) { %><div class='empty zcs-card zcs-w-full'>No upcoming dated events.</div><% } %></div></section>
  <div class='zcs-row zcs-gap-16'>
    <section class='zcs-card zcs-col-8 zcs-p-20 zcs-box-border'><div class='section-head zcs-flex zcs-justify-space-between'><div><h3 class='zcs-font-18 zcs-m-0 zcs-color-primary'>Delayed tasks</h3><span class='zcs-font-13 zcs-color-tertiary'>Items requiring delivery attention</span></div><a class='zcs-font-14 zcs-color-theme' href='#Report:Delayed_Tasks'>View report</a></div><div class='zcs-table-wrapper zcs-rounded-md'><table class='zcs-w-full'><thead><tr><th class='zcs-text-left'>Task</th><th class='zcs-text-left'>Event</th><th class='zcs-text-left'>Trainer</th><th class='zcs-text-left'>Deadline</th><th class='zcs-text-left'>Status</th></tr></thead><tbody><% delayedCounter=0; for each task in Task_Assignments[Delivery_Status == "Delayed"] sort by Deadline asc { if(delayedCounter < 8) { %><tr><td><%=task.Task_Work_Item%></td><td><%=task.Event.Event_Name%></td><td><%=task.Assigned_Trainer.Name.first_name%></td><td><%=task.Deadline.toString("dd-MMM-yyyy")%></td><td><span class='badge delayed'><%=task.Progress_Status%></span></td></tr><% delayedCounter=delayedCounter+1; } } if(delayedCounter==0) { %><tr><td colspan='5' class='empty'>No delayed tasks.</td></tr><% } %></tbody></table></div></section>
    <aside class='zcs-card zcs-col-4 zcs-p-20 zcs-box-border'><div class='section-head'><h3 class='zcs-font-18 zcs-m-0 zcs-color-primary'>Pending approvals</h3><span class='zcs-font-13 zcs-color-tertiary'>Current request activity</span></div><ul class='feed zcs-flex zcs-direction-column zcs-gap-20 zcs-p-0'><li><strong class='zcs-font-14 zcs-color-primary'><%=pendingLeave%> leave requests</strong><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Awaiting reporting-manager action</p><a class='zcs-font-13 zcs-color-theme' href='#Report:All_Leave_Requests'>Review leave</a></li><li><strong class='zcs-font-14 zcs-color-primary'><%=pendingWFH%> WFH requests</strong><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Awaiting reporting-manager action</p><a class='zcs-font-13 zcs-color-theme' href='#Report:All_WFH_Requests'>Review WFH</a></li><li><strong class='zcs-font-14 zcs-color-primary'><%=pendingDiscounts%> discount requests</strong><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Awaiting selected approver</p><a class='zcs-font-13 zcs-color-theme' href='#Report:Discount_Requests_Tracker'>Review discounts</a></li><li><strong class='zcs-font-14 zcs-color-primary'><%=outstandingInvoices%> outstanding invoices</strong><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Raised or sent, not yet paid</p><a class='zcs-font-13 zcs-color-theme' href='#Report:Outstanding_Invoices'>Review invoices</a></li></ul></aside>
  </div>
</div>