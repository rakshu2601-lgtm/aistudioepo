customize
{
    layout
    {
        theme = "theme_2"
        variant = "variant_2"
    }
    font = "lato"
    color options
    {
        name = "Operations Navy"
        brand color = "#234E70"
        type = "custom"
        dark mode color = "#8CB4D8"
    }
    logo
    {
        preference = "app_icon"
        placement = "left"
    }
    custom css
    {
        content = ".zc-app-header { box-shadow: 0 1px 3px rgba(15,23,42,.12); } .zc-viewcontainer { background-color: #F6F8FA; }"
    }
}
