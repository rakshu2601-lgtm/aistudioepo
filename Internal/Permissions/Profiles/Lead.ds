            enabled = Create,View,Edit,Viewall,Search,Tab
            allFieldsVisible = false
            ReportPermissions { Discount_Requests_Tracker={"View"} My_Discount_Requests={"View"} Approved_Discounts={"View"} }
            FieldPermissions { Ticket_ID{visibility:true,readonly:true} Requester{visibility:true,readonly:true} Total_Amount_USD{visibility:true,readonly:true} Discounted_Amount_USD{visibility:true,readonly:true} Approver_User{visibility:false} Status{visibility:true,readonly:true} Reason_for_Rejection{visibility:true,readonly:true} Promo_Code_Status{visibility:true,readonly:true} }
        }
        Manual_Invoice
        {
            enabled = Create,View,Edit,Viewall,Search,Tab
            allFieldsVisible = false
            ReportPermissions { All_Manual_Invoices={"View"} My_Invoice_Requests={"View"} Outstanding_Invoices={"View"} }
