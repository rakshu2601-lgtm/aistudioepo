            FieldPermissions { Created_By{visibility:true,readonly:true} Review_Status{visibility:true,readonly:true} Revenue_USD{visibility:false} }
        }
        During_Event_Updates
        {
            enabled = Create,View,Edit,Search,Tab
            allFieldsVisible = false
