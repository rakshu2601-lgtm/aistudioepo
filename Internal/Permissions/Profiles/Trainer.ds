"Trainer"
{
    name        = "Trainer"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
    description = "Own operational requests and updates, assigned events and tasks, and read-only reference access."

