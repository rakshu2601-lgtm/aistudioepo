            FieldPermissions { Event{visibility:true,readonly:true} Task_Work_Item{visibility:true,readonly:true} Assigned_Trainer{visibility:true,readonly:true} Assigned_Date{visibility:true,readonly:true} Deadline{visibility:true,readonly:true} Completion_Date{visibility:true,readonly:false} Progress_Status{visibility:true,readonly:false} Delivery_Status{visibility:true,readonly:true} Delay_Reason_Notes{visibility:true,readonly:false} }
