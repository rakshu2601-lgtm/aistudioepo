form Programs
{
    displayname = "Programs"

    Program_Info
    (
        type = section
        displayname = "Program Information"
        row = 1
        column = 0
    )
    must have unique Program_Name
    (
        type = text
        displayname = "Program Name"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    must have unique Program_Code
    (
        type = text
        displayname = "Program Code"
        maxchar = 20
        row = 1
        column = 2
        width = medium
    )
    must have Total_Required_Hours
    (
        type = decimal
        displayname = "Total Required Hours"
        decimalplace = 2
        row = 1
        column = 1
        width = medium
    )
    Is_Active
    (
        type = checkbox
        displayname = "Is Active"
        initial value = true
        row = 1
        column = 2
        width = medium
    )
    Description
    (
        type = textarea
        displayname = "Description"
        height = 80px
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Program"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
