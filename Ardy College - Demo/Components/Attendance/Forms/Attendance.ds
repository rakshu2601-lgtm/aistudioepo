form Attendance
{
    displayname = "Attendance"
    record owner = Added_User

    Attendance_Record
    (
        type = section
        displayname = "Attendance Record"
        row = 1
        column = 0
    )
    must have Student
    (
        type = picklist
        displayname = "Student"
        values = Students.ID
        displayformat = [Student_Name.first_name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Attendance_Date
    (
        type = date
        displayname = "Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 2
        width = medium
    )
    Attendance_Status
    (
        type = picklist
        displayname = "Status"
        values = {"Present","Absent","Late","Excused"}
        initial value = "Present"
        row = 1
        column = 1
        width = medium
    )

    Check_In_Out
    (
        type = section
        displayname = "Check-In / Check-Out"
        visibility = true
        row = 2
        column = 1
    )
    Check_In_Time
    (
        type = datetime
        displayname = "Check-In Time"
        row = 2
        column = 1
        width = medium
    )
    Check_Out_Time
    (
        type = datetime
        displayname = "Check-Out Time"
        row = 2
        column = 2
        width = medium
    )
    Duration_Hours
    (
        type = decimal
        displayname = "Duration (hrs)"
        decimalplace = 2
        initial value = 0
        row = 2
        column = 1
        width = medium
    )

    Notes_Section
    (
        type = section
        displayname = "Notes"
        visibility = true
        row = 3
        column = 1
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 80px
        row = 3
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Attendance"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
