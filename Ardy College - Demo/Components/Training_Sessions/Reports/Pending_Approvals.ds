list Pending_Approvals
{
    displayName = "Pending Approvals"
    show all rows from Training_Sessions [Session_Status == "Pending Approval"]
    (
        Student
        Component
        Session_Date
        Start_Time
        End_Time
        Actual_Duration_Hours
        Credited_Hours
        Location_Name
        Session_Status
    )
    sort by
    (
        Session_Date descending
    )
}
