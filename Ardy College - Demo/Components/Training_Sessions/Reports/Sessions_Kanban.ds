kanban Sessions_Kanban
{
    displayName = "Sessions by Stage"
    show all rows from Training_Sessions
    (
        Student
        Component
        Session_Date
        Start_Time
        End_Time
        Actual_Duration_Hours
        Credited_Hours
        Session_Status
    )
    sort by
    (
        Session_Date descending
    )
    options
    (
        display field = Session_Status
        sort order = ascending
        record count = enable
    )
}
