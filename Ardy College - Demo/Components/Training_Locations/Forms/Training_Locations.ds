form Training_Locations
{
    displayname = "Training Locations"

    Location_Info
    (
        type = section
        displayname = "Location Information"
        row = 1
        column = 0
    )
    must have unique Location_Name
    (
        type = text
        displayname = "Location Name"
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    Is_Active
    (
        type = checkbox
        displayname = "Is Active"
        initial value = true
        row = 1
        column = 2
        width = medium
    )
    must have Latitude
    (
        type = decimal
        displayname = "Latitude"
        decimalplace = 6
        row = 1
        column = 1
        width = medium
    )
    must have Longitude
    (
        type = decimal
        displayname = "Longitude"
        decimalplace = 6
        row = 1
        column = 2
        width = medium
    )
    Radius_Meters
    (
        type = number
        displayname = "Allowed Radius (meters)"
        initial value = 200
        row = 1
        column = 1
        width = medium
    )
    Address_Description
    (
        type = textarea
        displayname = "Address / Description"
        height = 60px
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Location"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
