form Program_Components
{
    displayname = "Program Components"

    Component_Info
    (
        type = section
        displayname = "Component Information"
        row = 1
        column = 0
    )
    must have Program
    (
        type = picklist
        displayname = "Program"
        values = Programs.ID
        displayformat = [Program_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Component_Name
    (
        type = text
        displayname = "Component Name"
        maxchar = 100
        row = 1
        column = 2
        width = medium
    )
    must have Required_Hours
    (
        type = decimal
        displayname = "Required Hours"
        decimalplace = 2
        row = 1
        column = 1
        width = medium
    )
    Display_Order
    (
        type = number
        displayname = "Display Order"
        row = 1
        column = 2
        width = medium
    )
    Description
    (
        type = textarea
        displayname = "Description"
        height = 60px
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Component"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
