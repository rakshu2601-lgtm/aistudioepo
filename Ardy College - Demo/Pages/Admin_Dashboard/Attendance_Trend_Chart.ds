<chart elementName='Attendance_Trend_Chart'
       title='Attendance Trend (Last 30 Days)'
       titleColor='#222326'
       type='Line'
       xtitle='Date'
       ytitle='Attendance Count'
       bgColor='#FFFFFF'
       theme='theme1'
       legendPos='none'
       heightType='custom'
       heightValue='300px'
       appLinkName='thisapp'
       formLinkName='Attendance'
       xfield='Attendance_Date'
       yfields='count:Attendance_Date'
       dateGrouping='actual'
       showDataLabel='false'
       DelugeCriteria='Attendance_Date &gt;= zoho.currentdate.subMonth(1)' />
