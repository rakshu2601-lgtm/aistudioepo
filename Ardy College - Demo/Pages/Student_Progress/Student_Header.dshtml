<style>
/* ===== zcs-global.css ===== */
:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-app-header-color: #1c1c40; --zcs-page-bg-color: #F3F3F4; --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-placeholder-color: #878895; --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; --zcs-primary-btn-color: var(--zcs_brand_color); --zcs-primary-btn-border-color: var(--zcs_brand_color); --zcs-primary-btn-text-color: var(--zcs_brand_foreground_color); --zcs-primary-btn-h-color: var(--zcs_brand_dark_color); --zcs-primary-btn-h-border-color: var(--zcs_brand_dark_color); --zcs-primary-btn-h-text-color: var(--zcs_brand_foreground_color); --zcs-secondary-btn-color: var(--zcs_light_grey_color); --zcs-secondary-btn-border-color: var(--zcs_primary_border_color); --zcs-secondary-btn-text-color: var(--zcs_primary_text_color); --zcs-secondary-btn-h-color: var(--zcs_dark_grey_color); --zcs-secondary-btn-h-border-color: var(--zcs_primary_border_color); --zcs-secondary-btn-h-text-color: var(--zcs_primary_text_color); --zcs-tooltip-bg-color: #363636; } :root { font-size: 16px; line-height: 1.5; --column-gap: 0px; } .zcs-col-1 { flex: 0 0 calc(8.3333333333% - var(--column-gap) * 0.9166666667); max-width: calc(8.3333333333% - var(--column-gap) * 0.9166666667); } .zcs-col-2 { flex: 0 0 calc(16.6666666667% - var(--column-gap) * 0.8333333333); max-width: calc(16.6666666667% - var(--column-gap) * 0.8333333333); } .zcs-col-3 { flex: 0 0 calc(25% - var(--column-gap) * 0.75); max-width: calc(25% - var(--column-gap) * 0.75); } .zcs-col-4 { flex: 0 0 calc(33.3333333333% - var(--column-gap) * 0.6666666667); max-width: calc(33.3333333333% - var(--column-gap) * 0.6666666667); } .zcs-col-5 { flex: 0 0 calc(41.6666666667% - var(--column-gap) * 0.5833333333); max-width: calc(41.6666666667% - var(--column-gap) * 0.5833333333); } .zcs-col-6 { flex: 0 0 calc(50% - var(--column-gap) * 0.5); max-width: calc(50% - var(--column-gap) * 0.5); } .zcs-col-7 { flex: 0 0 calc(58.3333333333% - var(--column-gap) * 0.4166666667); max-width: calc(58.3333333333% - var(--column-gap) * 0.4166666667); } .zcs-col-8 { flex: 0 0 calc(66.6666666667% - var(--column-gap) * 0.3333333333); max-width: calc(66.6666666667% - var(--column-gap) * 0.3333333333); } .zcs-col-9 { flex: 0 0 calc(75% - var(--column-gap) * 0.25); max-width: calc(75% - var(--column-gap) * 0.25); } .zcs-col-10 { flex: 0 0 calc(83.3333333333% - var(--column-gap) * 0.1666666667); max-width: calc(83.3333333333% - var(--column-gap) * 0.1666666667); } .zcs-col-11 { flex: 0 0 calc(91.6666666667% - var(--column-gap) * 0.0833333333); max-width: calc(91.6666666667% - var(--column-gap) * 0.0833333333); } .zcs-col-12 { flex: 0 0 calc(100% - var(--column-gap) * 0); max-width: calc(100% - var(--column-gap) * 0); } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-col { flex-shrink: 0; width: 100%; max-width: 100%; } .zcs-flex { display: flex; } .zcs-direction-column { flex-direction: column; } .zcs-direction-row { flex-direction: row; } .zcs-align-items-center { align-items: center; } .zcs-justify-center { justify-content: center; } .zcs-justify-space-between { justify-content: space-between; } .zcs-gap-8 { gap: 0.5rem; } .zcs-gap-10 { gap: 0.625rem; } .zcs-gap-12 { gap: 0.75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-m-0 { margin: 0; } .zcs-mt-4 { margin-top: 0.25rem; } .zcs-mt-8 { margin-top: 0.5rem; } .zcs-font-12 { font-size: 0.75rem; } .zcs-font-13 { font-size: 0.8125rem; } .zcs-font-14 { font-size: 0.875rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-28 { font-size: 1.75rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; } .zcs-color-primary { color: var(--zcs_primary_text_color); } .zcs-color-secondary { color: var(--zcs_secondary_text_color); } .zcs-color-white { color: #FFFFFF; } .zcs-rounded-lg { border-radius: 0.5rem; } .zcs-rounded-xl { border-radius: 0.75rem; } .zcs-rounded-2xl { border-radius: 1rem; } .zcs-w-full { width: 100%; } .zcs-box-border { box-sizing: border-box; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; } .zcs-uppercase { text-transform: uppercase; }

/* ===== Student Header Styles ===== */
.sp-header-card {
    background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
    border-radius: 12px;
    padding: 28px 32px;
    color: #ffffff;
    box-sizing: border-box;
    width: 100%;
}
.sp-header-name {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 4px 0;
    color: #ffffff;
}
.sp-header-id {
    font-size: 0.875rem;
    font-weight: 400;
    color: rgba(255,255,255,0.75);
    margin: 0 0 16px 0;
}
.sp-header-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 0;
}
.sp-header-meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    color: rgba(255,255,255,0.9);
}
.sp-header-meta-item i {
    font-size: 1rem;
    color: rgba(255,255,255,0.75);
}
.sp-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}
.sp-status-active {
    background: rgba(22, 173, 120, 0.25);
    color: #a7f3d0;
    border: 1px solid rgba(22,173,120,0.4);
}
.sp-status-inactive {
    background: rgba(254, 69, 93, 0.2);
    color: #fca5a5;
    border: 1px solid rgba(254,69,93,0.35);
}
.sp-status-other {
    background: rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.9);
    border: 1px solid rgba(255,255,255,0.3);
}
.sp-completed-banner {
    margin-top: 16px;
    background: rgba(22, 173, 120, 0.2);
    border: 1px solid rgba(22,173,120,0.5);
    border-radius: 8px;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1rem;
    font-weight: 700;
    color: #a7f3d0;
    letter-spacing: 0.03em;
    text-transform: uppercase;
}
.sp-completed-banner i {
    font-size: 1.25rem;
    color: #6ee7b7;
}
.sp-error-card {
    background: #fff3f4;
    border: 1px solid #fca5a5;
    border-radius: 12px;
    padding: 32px;
    display: flex;
    align-items: center;
    gap: 16px;
    color: #b91c1c;
}
.sp-error-card i {
    font-size: 2rem;
    color: #ef4444;
    flex-shrink: 0;
}
.sp-error-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0 0 4px 0;
}
.sp-error-msg {
    font-size: 0.875rem;
    margin: 0;
    color: #7f1d1d;
}
</style>

<%
  notFound = input.studentNotFound;
  sName    = input.studentName;
  sProgram = input.studentProgram;
  sEnroll  = input.enrollmentDate;
  sStatus  = input.studentStatus;
  sIDval   = input.studentIDval;
  sCompleted = input.isProgramComplete;
%>

<% if(notFound == "true") { %>
<div class="sp-error-card">
  <i class="zc-li-outline ui-1-alert-circle-i"></i>
  <div>
    <p class="sp-error-title">Student Not Found</p>
    <p class="sp-error-msg">No student record could be located for the provided identifier. Please verify the Student ID and try again.</p>
  </div>
</div>
<% } else { %>
<div class="sp-header-card">
  <h1 class="sp-header-name"><%= sName %></h1>
  <p class="sp-header-id">
    <i class="zc-li-outline ui-1-id-card" style="font-size:13px;vertical-align:middle;margin-right:4px;"></i>
    Student ID: <%= sIDval %>
  </p>
  <div class="sp-header-meta">
    <div class="sp-header-meta-item">
      <i class="zc-li-outline education-graduation-hat"></i>
      <span><%= sProgram %></span>
    </div>
    <div class="sp-header-meta-item">
      <i class="zc-li-outline ui-2-calendar"></i>
      <span>Enrolled: <%= sEnroll %></span>
    </div>
    <div class="sp-header-meta-item">
      <%
        statusClass = "sp-status-other";
        if(sStatus == "Active") {
          statusClass = "sp-status-active";
        } else if(sStatus == "Inactive") {
          statusClass = "sp-status-inactive";
        }
      %>
      <span class="sp-status-badge <%= statusClass %>">
        <i class="zc-li-solid ui-1-circle-bold" style="font-size:8px;"></i>
        <%= sStatus %>
      </span>
    </div>
  </div>
  <% if(sCompleted == "true") { %>
  <div class="sp-completed-banner">
    <i class="zc-li-outline ui-1-check-circle-08"></i>
    Program Completed
  </div>
  <% } %>
</div>
<% } %>
