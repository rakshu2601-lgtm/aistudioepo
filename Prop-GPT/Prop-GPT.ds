application "Prop-GPT"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form API_Configuration
		{
		    title
		    {
		        displayname = "API Configuration"
		        on add = "Add API Configuration"
		        on edit = "Edit API Configuration"
		    }
		    API_Settings
		    (
		        type = section
		        displayname = "API Settings"
		        row = 1
		        column = 0
		    )
		    must have unique Configuration_Name
		    (
		        type = text
		        displayname = "Configuration Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Secret_Key
		    (
		        type = text
		        displayname = "Secret Key"
		        private = true
		        isencrypted = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Last_Rotated_On
		    (
		        type = datetime
		        displayname = "Last Rotated On"
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Configuration"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Configuration"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Leases
		{
		    title
		    {
		        displayname = "Leases"
		        on add = "Add Lease"
		        on edit = "Edit Lease"
		    }
		    Lease_Details
		    (
		        type = section
		        displayname = "Lease Details"
		        row = 1
		        column = 0
		    )
		    Lease_ID
		    (
		        type = autonumber
		        displayname = "Lease ID"
		        start index = 1001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Tenant
		    (
		        type = picklist
		        displayname = "Tenant"
		        values = Tenants.ID
		        displayformat = [Tenant_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Property
		    (
		        type = picklist
		        displayname = "Property"
		        values = Properties.ID
		        displayformat = [Property_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Unit
		    (
		        type = picklist
		        displayname = "Unit"
		        values = Units.ID
		        displayformat = [Unit_Number]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Lease_Start_Date
		    (
		        type = date
		        displayname = "Lease Start Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Lease_End_Date
		    (
		        type = date
		        displayname = "Lease End Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Monthly_Rent
		    (
		        type = USD
		        displayname = "Monthly Rent"
		        decimalplace = 2
		        maxchar = 12
		        row = 1
		        column = 2
		        width = medium
		    )
		    Security_Deposit
		    (
		        type = USD
		        displayname = "Security Deposit"
		        decimalplace = 2
		        maxchar = 12
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Billing_Start_Date
		    (
		        type = date
		        displayname = "Billing Start Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Payment_Due_Day
		    (
		        type = number
		        displayname = "Payment Due Day"
		        initial value = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Lease_Status
		    (
		        type = picklist
		        displayname = "Lease Status"
		        values = {"Draft","Active","Expired","Terminated"}
		        initial value = "Draft"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Lease"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Lease"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Properties
		{
		    title
		    {
		        displayname = "Properties"
		        on add = "Add Property"
		        on edit = "Edit Property"
		    }
		    record owner = Added_User
		    Property_Details
		    (
		        type = section
		        displayname = "Property Details"
		        row = 1
		        column = 0
		    )
		    Property_ID
		    (
		        type = autonumber
		        displayname = "Property ID"
		        start index = 1001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Property_Name
		    (
		        type = text
		        displayname = "Property Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Property_Type
		    (
		        type = picklist
		        displayname = "Property Type"
		        values = {"Multi-Unit Property","Individual Villa"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Address
		    (
		        type = address
		        displayname = "Address"
		        capture_coordinates = true
		        adjust_using_map = true
		        address_line_1
		        (
		            type = address_line_1
		            displayname = "Street Address"
		        )
		        address_line_2
		        (
		            type = address_line_2
		            displayname = "Apartment / Suite"
		        )
		        district_city
		        (
		            type = district_city
		            displayname = "City"
		        )
		        state_province
		        (
		            type = state_province
		            displayname = "State"
		        )
		        postal_Code
		        (
		            type = postal_Code
		            displayname = "ZIP Code"
		        )
		        country
		        (
		            type = country
		            displayname = "Country"
		        )
		        latitude
		        (
		            type = latitude
		            displayname = "Latitude"
		            visibility = false
		        )
		        longitude
		        (
		            type = longitude
		            displayname = "Longitude"
		            visibility = false
		        )
		        row = 1
		        column = 1
		        width = medium
		    )
		    Description
		    (
		        type = textarea
		        displayname = "Description"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Property"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Property"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Rental_Payments
		{
		    title
		    {
		        displayname = "Rental Payments"
		        on add = "Add Rental Payment"
		        on edit = "Edit Rental Payment"
		    }
		    Payment_Details
		    (
		        type = section
		        displayname = "Payment Details"
		        row = 1
		        column = 0
		    )
		    Payment_ID
		    (
		        type = autonumber
		        displayname = "Payment ID"
		        start index = 1001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Lease
		    (
		        type = picklist
		        displayname = "Lease"
		        values = Leases.ID
		        displayformat = [Lease_ID]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Tenant
		    (
		        type = picklist
		        displayname = "Tenant"
		        values = Tenants.ID
		        displayformat = [Tenant_Name]
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Property
		    (
		        type = picklist
		        displayname = "Property"
		        values = Properties.ID
		        displayformat = [Property_Name]
		        row = 1
		        column = 1
		        width = medium
		    )
		    Unit
		    (
		        type = picklist
		        displayname = "Unit"
		        values = Units.ID
		        displayformat = [Unit_Number]
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Billing_Month
		    (
		        type = date
		        displayname = "Billing Month"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Due_Date
		    (
		        type = date
		        displayname = "Due Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Reminder_Date
		    (
		        type = date
		        displayname = "Reminder Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Amount_Due
		    (
		        type = USD
		        displayname = "Amount Due"
		        decimalplace = 2
		        maxchar = 12
		        row = 1
		        column = 2
		        width = medium
		    )
		    Amount_Paid
		    (
		        type = USD
		        displayname = "Amount Paid"
		        initial value = 0
		        decimalplace = 2
		        maxchar = 12
		        row = 1
		        column = 1
		        width = medium
		    )
		    Paid_Date
		    (
		        type = date
		        displayname = "Paid Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Payment_Status
		    (
		        type = picklist
		        displayname = "Payment Status"
		        values = {"Due","Partially Paid","Paid","Overdue","Waived"}
		        initial value = "Due"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Payment_Reference
		    (
		        type = text
		        displayname = "Payment Reference"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Payment"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Payment"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Tenants
		{
		    title
		    {
		        displayname = "Tenants"
		        on add = "Add Tenant"
		        on edit = "Edit Tenant"
		    }
		    Tenant_Details
		    (
		        type = section
		        displayname = "Tenant Details"
		        row = 1
		        column = 0
		    )
		    Tenant_ID
		    (
		        type = autonumber
		        displayname = "Tenant ID"
		        start index = 1001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Tenant_Name
		    (
		        type = text
		        displayname = "Tenant Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Email
		    (
		        type = email
		        displayname = "Email"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have unique Phone
		    (
		        type = text
		        displayname = "Phone"
		        personal data = true
		        description
		        [
		            type = tooltip
		            message = "Enter in E.164 format, for example +12125551234."
		        ]
		        row = 1
		        column = 1
		        width = medium
		    )
		    Alternate_Phone
		    (
		        type = text
		        displayname = "Alternate Phone"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Emergency_Contact_Name
		    (
		        type = text
		        displayname = "Emergency Contact Name"
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Emergency_Contact_Phone
		    (
		        type = text
		        displayname = "Emergency Contact Phone"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Tenant"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Tenant"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Units
		{
		    title
		    {
		        displayname = "Units"
		        on add = "Add Unit"
		        on edit = "Edit Unit"
		    }
		    Unit_Details
		    (
		        type = section
		        displayname = "Unit Details"
		        row = 1
		        column = 0
		    )
		    Unit_ID
		    (
		        type = autonumber
		        displayname = "Unit ID"
		        start index = 1001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Property
		    (
		        type = picklist
		        displayname = "Property"
		        values = Properties.ID
		        displayformat = [Property_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Unit_Number
		    (
		        type = text
		        displayname = "Unit Number"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Unit_Type
		    (
		        type = picklist
		        displayname = "Unit Type"
		        values = {"Studio","1 Bedroom","2 Bedroom","3 Bedroom","4+ Bedroom","Other"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Floor
		    (
		        type = text
		        displayname = "Floor"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Bedrooms
		    (
		        type = number
		        displayname = "Bedrooms"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Bathrooms
		    (
		        type = decimal
		        displayname = "Bathrooms"
		        decimalplace = 1
		        row = 1
		        column = 2
		        width = medium
		    )
		    Default_Monthly_Rent
		    (
		        type = USD
		        displayname = "Default Monthly Rent"
		        decimalplace = 2
		        maxchar = 12
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Occupancy_Status
		    (
		        type = picklist
		        displayname = "Occupancy Status"
		        values = {"Vacant","Occupied","Unavailable"}
		        initial value = "Vacant"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Unit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Unit"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Work_Order_Status_History
		{
		    title
		    {
		        displayname = "Work Order Status History"
		        on add = "Add Status Event"
		        on edit = "Edit Status Event"
		    }
		    Status_Event
		    (
		        type = section
		        displayname = "Status Event"
		        row = 1
		        column = 0
		    )
		    History_ID
		    (
		        type = autonumber
		        displayname = "History ID"
		        start index = 10001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Work_Order
		    (
		        type = picklist
		        displayname = "Work Order"
		        values = Work_Orders.ID
		        displayformat = [Work_Order_ID]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Previous_Status
		    (
		        type = text
		        displayname = "Previous Status"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have New_Status
		    (
		        type = text
		        displayname = "New Status"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Changed_At
		    (
		        type = datetime
		        displayname = "Changed At"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Changed_By
		    (
		        type = email
		        displayname = "Changed By"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Change_Source
		    (
		        type = picklist
		        displayname = "Change Source"
		        values = {"Internal","External API","System"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Status Event"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Status Event"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Work_Order_Tracker_Filter
		{
		    title
		    {
		        displayname = "Work Order Tracker Filter"
		    }
		    store data in zc = false
		    Tracking_Filter
		    (
		        type = section
		        displayname = "Tracking Filter"
		        row = 1
		        column = 0
		    )
		    must have Work_Order
		    (
		        type = picklist
		        displayname = "Work Order ID"
		        values = Work_Orders.ID
		        displayformat = [Work_Order_ID]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        View_Tracking
		        (
		            type = button
		            displayname = "View Tracking"
		            tooltip = "Open the complete status timeline for this work order"
		        )
		    }
		}

		form Work_Orders
		{
		    title
		    {
		        displayname = "Work Orders"
		        on add = "Add Work Order"
		        on edit = "Edit Work Order"
		    }
		    Work_Order_Details
		    (
		        type = section
		        displayname = "Work Order Details"
		        row = 1
		        column = 0
		    )
		    Work_Order_ID
		    (
		        type = autonumber
		        displayname = "Work Order ID"
		        start index = 10001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Source
		    (
		        type = picklist
		        displayname = "Source"
		        values = {"Internal","External API"}
		        initial value = "Internal"
		        row = 1
		        column = 1
		        width = medium
		    )
		    unique External_Request_ID
		    (
		        type = text
		        displayname = "External Request ID"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Tenant
		    (
		        type = picklist
		        displayname = "Tenant"
		        values = Tenants.ID
		        displayformat = [Tenant_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Property
		    (
		        type = picklist
		        displayname = "Property"
		        values = Properties.ID
		        displayformat = [Property_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Unit
		    (
		        type = picklist
		        displayname = "Unit"
		        values = Units.ID
		        displayformat = [Unit_Number]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Request_Title
		    (
		        type = text
		        displayname = "Request Title"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Request_Description
		    (
		        type = textarea
		        displayname = "Request Description"
		        height = 120px
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Category
		    (
		        type = picklist
		        displayname = "Category"
		        values = {"Plumbing","Electrical","HVAC","Appliance","Structural","Security","Cleaning","Other"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Priority
		    (
		        type = picklist
		        displayname = "Priority"
		        values = {"Low","Medium","High","Emergency"}
		        initial value = "Medium"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"New","Assigned","In Progress","On Hold","Resolved","Closed","Cancelled"}
		        initial value = "New"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Assigned_To_Email
		    (
		        type = email
		        displayname = "Assigned To Email"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Raised_On
		    (
		        type = datetime
		        displayname = "Raised On"
		        initial value = "${zoho.currenttime}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Preferred_Access_Time
		    (
		        type = textarea
		        displayname = "Preferred Access Time"
		        height = 80px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Resolution_Notes
		    (
		        type = textarea
		        displayname = "Resolution Notes"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Status_Notes
		    (
		        type = textarea
		        displayname = "Status Notes"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Work Order"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Work Order"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		    blueprint components
		    {
		        stages = {"New","Assigned","In Progress","On Hold","Resolved","Closed","Cancelled"}
		    }
		}
	}

	reports
	{
		default list API_Configurations
		{
		    displayName = "API Configurations"
		    show all rows from API_Configuration
		    (
		        Configuration_Name
		        Active
		        Last_Rotated_On
		        Modified_Time
		    )
		    filters
		    (
		        Active
		    )
		    sort by
		    (
		        Modified_Time descending
		    )
		}

		list Active_Leases
		{
		    displayName = "Active Leases"
		    show all rows from Leases [Lease_Status == "Active"]
		    (
		        Lease_ID
		        Tenant
		        Property
		        Unit
		        Lease_Start_Date
		        Lease_End_Date
		        Monthly_Rent
		        Payment_Due_Day
		        Lease_Status
		    )
		    filters
		    (
		        Tenant
		        Property
		        Unit
		        Lease_Status
		    )
		    sort by
		    (
		        Lease_Start_Date descending
		    )
		}

		default list All_Leases
		{
		    displayName = "All Leases"
		    show all rows from Leases
		    (
		        Lease_ID
		        Tenant
		        Property
		        Unit
		        Lease_Start_Date
		        Lease_End_Date
		        Monthly_Rent
		        Payment_Due_Day
		        Lease_Status
		    )
		    filters
		    (
		        Tenant
		        Property
		        Unit
		        Lease_Status
		    )
		    sort by
		    (
		        Lease_Start_Date descending
		    )
		}

		default list All_Properties
		{
		    displayName = "All Properties"
		    show all rows from Properties
		    (
		        Property_ID
		        Property_Name
		        Property_Type
		        Address
		        Active
		        Added_Time
		    )
		    filters
		    (
		        Property_Type
		        Active
		    )
		    sort by
		    (
		        Property_Name ascending
		    )
		}

		map Property_Map
		{
		    displayName = "Property Map"
		    show all rows from Properties
		    (
		        Property_Name
		        Property_Type
		        Address
		        Active
		    )
		    filters
		    (
		        Active
		    )
		    options
		    (
		        display field = Address
		    )
		}

		default list All_Rental_Payments
		{
		    displayName = "All Rental Payments"
		    show all rows from Rental_Payments
		    (
		        Payment_ID
		        Lease
		        Tenant
		        Property
		        Unit
		        Billing_Month
		        Due_Date
		        Amount_Due
		        Amount_Paid
		        Payment_Status
		        Paid_Date
		    )
		    filters
		    (
		        Tenant
		        Property
		        Unit
		        Billing_Month
		        Payment_Status
		    )
		    sort by
		    (
		        Due_Date descending
		    )
		}

		list Outstanding_Rent
		{
		    displayName = "Outstanding Rent"
		    show all rows from Rental_Payments [Payment_Status == "Due" || Payment_Status == "Partially Paid" || Payment_Status == "Overdue"]
		    (
		        Payment_ID
		        Lease
		        Tenant
		        Property
		        Unit
		        Billing_Month
		        Due_Date
		        Amount_Due
		        Amount_Paid
		        Payment_Status
		    )
		    filters
		    (
		        Tenant
		        Property
		        Unit
		        Billing_Month
		        Payment_Status
		    )
		    sort by
		    (
		        Due_Date ascending
		    )
		    conditional formatting
		    (
		        "Overdue Rent"
		        {
		            condition = (Payment_Status == "Overdue")
		            fields = [Payment_ID,Tenant,Property,Unit,Due_Date,Amount_Due,Amount_Paid,Payment_Status]
		            format = "background-color:#FEE2E2;color:#991B1B;font-weight:bold"
		        }
		    )
		}

		default list All_Tenants
		{
		    displayName = "All Tenants"
		    show all rows from Tenants
		    (
		        Tenant_ID
		        Tenant_Name
		        Email
		        Phone
		        Alternate_Phone
		        Active
		        Added_Time
		    )
		    filters
		    (
		        Active
		    )
		    sort by
		    (
		        Tenant_Name ascending
		    )
		}

		default list All_Units
		{
		    displayName = "All Units"
		    show all rows from Units
		    (
		        Unit_ID
		        Property
		        Unit_Number
		        Unit_Type
		        Floor
		        Default_Monthly_Rent
		        Occupancy_Status
		        Active
		    )
		    filters
		    (
		        Property
		        Unit_Type
		        Occupancy_Status
		        Active
		    )
		    sort by
		    (
		        Property ascending
		        Unit_Number ascending
		    )
		}

		kanban Unit_Availability_Board
		{
		    displayName = "Unit Availability Board"
		    show all rows from Units
		    (
		        Unit_ID
		        Property
		        Unit_Number
		        Unit_Type
		        Default_Monthly_Rent
		        Occupancy_Status
		        Active
		    )
		    filters
		    (
		        Property
		        Active
		    )
		    options
		    (
		        display field = Occupancy_Status
		        filter type = manual
		        sort order = custom
		        record count = enable
		    )
		}

		default list All_Status_History
		{
		    displayName = "All Status History"
		    show all rows from Work_Order_Status_History
		    (
		        History_ID
		        Work_Order
		        Previous_Status
		        New_Status
		        Changed_At
		        Changed_By
		        Change_Source
		        Notes
		    )
		    filters
		    (
		        Work_Order
		        New_Status
		        Change_Source
		    )
		    sort by
		    (
		        Changed_At descending
		    )
		}

		timeline Work_Order_Status_Timeline
		{
		    displayName = "Work Order Status Timeline"
		    show all rows from Work_Order_Status_History
		    (
		        Work_Order
		        Previous_Status
		        New_Status
		        Changed_At
		        Changed_By
		        Change_Source
		        Notes
		    )
		    filters
		    (
		        Work_Order
		    )
		    sort by
		    (
		        Changed_At ascending
		    )
		    options
		    (
		        display field = New_Status
		        start date = Changed_At
		    )
		}

		default list All_Work_Orders
		{
		    displayName = "All Work Orders"
		    show all rows from Work_Orders
		    (
		        Work_Order_ID
		        Source
		        External_Request_ID
		        Tenant
		        Property
		        Unit
		        Request_Title
		        Category
		        Priority
		        Status
		        Assigned_To_Email
		        Raised_On
		    )
		    filters
		    (
		        Source
		        Tenant
		        Property
		        Unit
		        Category
		        Priority
		        Status
		    )
		    sort by
		    (
		        Raised_On descending
		    )
		}

		kanban Work_Order_Board
		{
		    displayName = "Work Order Board"
		    show all rows from Work_Orders
		    (
		        Work_Order_ID
		        Request_Title
		        Tenant
		        Property
		        Unit
		        Priority
		        Status
		        Assigned_To_Email
		        Raised_On
		    )
		    filters
		    (
		        Priority
		        Property
		        Assigned_To_Email
		    )
		    sort by
		    (
		        Raised_On descending
		    )
		    options
		    (
		        display field = Status
		        filter type = manual
		        sort order = custom
		        record count = enable
		    )
		}
	}

	pages
	{
		page Operations_Dashboard
		{
					displayname = "Operations Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='OperationsDashboard' elementName='Operations Dashboard'>\n\t\t\t\t\t<![CDATA[htmlpage OperationsDashboard()\ncontent\n&lt;%{%&gt;\n&lt;%\nactiveProperties = Properties[Active == true].count();\noccupiedUnits = Units[Active == true &amp;&amp; Occupancy_Status == &quot;Occupied&quot;].count();\nvacantUnits = Units[Active == true &amp;&amp; Occupancy_Status == &quot;Vacant&quot;].count();\nactiveUnits = Units[Active == true].count();\nactiveLeases = Leases[Lease_Status == &quot;Active&quot;].count();\noutstandingRows = Rental_Payments[Payment_Status == &quot;Due&quot; || Payment_Status == &quot;Partially Paid&quot; || Payment_Status == &quot;Overdue&quot;];\noutstandingDue = ifnull(outstandingRows.sum(Amount_Due),0);\noutstandingPaid = ifnull(outstandingRows.sum(Amount_Paid),0);\noutstandingAmount = outstandingDue - outstandingPaid;\nopenWorkOrders = Work_Orders[Status != &quot;Resolved&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Cancelled&quot;].count();\nemergencyWorkOrders = Work_Orders[Priority == &quot;Emergency&quot; &amp;&amp; Status != &quot;Resolved&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Cancelled&quot;].count();\noccupancyPct = 0;\nif(activeUnits &gt; 0)\n{\n occupancyPct = ((occupiedUnits * 100.0) / activeUnits).round(1);\n}\nnewCount = Work_Orders[Status == &quot;New&quot;].count();\nassignedCount = Work_Orders[Status == &quot;Assigned&quot;].count();\ninProgressCount = Work_Orders[Status == &quot;In Progress&quot;].count();\nonHoldCount = Work_Orders[Status == &quot;On Hold&quot;].count();\nresolvedCount = Work_Orders[Status == &quot;Resolved&quot;].count();\nclosedCount = Work_Orders[Status == &quot;Closed&quot;].count();\ncancelledCount = Work_Orders[Status == &quot;Cancelled&quot;].count();\nmaxStatus = newCount;\nfor each statusValue in {assignedCount,inProgressCount,onHoldCount,resolvedCount,closedCount,cancelledCount}\n{\n if(statusValue &gt; maxStatus)\n {\n\tmaxStatus = statusValue;\n }\n}\nif(maxStatus == 0)\n{\n maxStatus = 1;\n}\nupcomingPayments = Rental_Payments[(Payment_Status == &quot;Due&quot; || Payment_Status == &quot;Partially Paid&quot; || Payment_Status == &quot;Overdue&quot;) &amp;&amp; (Due_Date &gt;= zoho.currentdate &amp;&amp; Due_Date &lt;= zoho.currentdate.addDay(30) || Reminder_Date &gt;= zoho.currentdate &amp;&amp; Reminder_Date &lt;= zoho.currentdate.addDay(30))] sort by Due_Date range from 0 to 5;\n%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--column-gap:16px}.zcs-row,.zcs-flex,.zcs-inline-flex{display:flex}.zcs-row{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-gap-4{gap:4px}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-gap-24{gap:24px}.zcs-p-0{padding:0}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-p-24{padding:24px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:8px}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-xl{border-radius:12px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.ops{background:var(--zcs_page_bg_color,#f5f6f8);padding:20px;color:var(--zcs-primary-text-color);font-family:inherit}.ops-hero{background:linear-gradient(120deg,var(--zcs_brand_dark_color),var(--zcs_brand_color));color:var(--zcs_brand_foreground_color);padding:24px;border-radius:14px}.ops-actions{display:flex;flex-wrap:wrap;gap:8px}.zcs-button{display:inline-flex;align-items:center;gap:7px;padding:9px 14px;border-radius:6px;text-decoration:none;font-size:14px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.ops-hero .zcs-primary-outline-button{border-color:rgba(255,255,255,.7);background:rgba(255,255,255,.12);color:inherit}.kpi-grid{display:grid;grid-template-columns:repeat(7,minmax(150px,1fr));gap:14px;margin-top:16px}.kpi{padding:18px;min-height:118px}.kpi-icon{width:36px;height:36px;border-radius:9px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;font-size:18px}.kpi-value{font-size:25px;font-weight:600;margin-top:14px}.kpi-label{font-size:13px;color:var(--zcs-secondary-text-color);margin-top:3px}.ops-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px;margin-top:16px}.section{padding:20px;min-width:0}.section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}.section-head h3{font-size:17px;margin:0}.section-head a{color:var(--zcs_brand_color);text-decoration:none;font-size:13px}.zcs-progress-bar{height:10px;background:var(--zcs_component_hover_color,#edf0f4);border-radius:4px;overflow:hidden}.zcs-progress-bar-indicator{height:100%;background:var(--zcs_brand_color);border-radius:inherit}.status-row{display:grid;grid-template-columns:95px 1fr 30px;gap:10px;align-items:center;margin:12px 0;font-size:13px}.rent-number{font-size:28px;font-weight:600}.rent-split{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}.rent-split div{background:var(--zcs_component_hover_color,#f6f7fa);padding:12px;border-radius:8px}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);overflow:auto;border-radius:6px}.zcs-table-wrapper table{width:100%;border-collapse:collapse;min-width:760px}.zcs-table-wrapper th{background:#f9fafe;font-weight:500;white-space:nowrap}.zcs-table-wrapper th,.zcs-table-wrapper td{padding:10px 14px;text-align:left;font-size:13px;border-bottom:1px solid var(--zcs-border-color)}.zcs-table-wrapper tr:last-child td{border-bottom:0}.zcs-badge{display:inline-flex;align-items:center;border-radius:4px;padding:2px 9px;font-size:12px;color:#fff;white-space:nowrap}.zcs-badge-green{background:#179e6c}.zcs-badge-red{background:#fe455d}.zcs-badge-yellow{background:#c98a09}.zcs-badge-blue{background:#2a6ffc}.zcs-badge-orange{background:#f4660c}.zcs-badge-grey{background:#5f6470}.activity{list-style:none;margin:0;padding:0}.activity li{display:grid;grid-template-columns:36px 1fr auto;gap:12px;align-items:start;padding:13px 0;border-bottom:1px solid var(--zcs-border-color)}.activity li:last-child{border-bottom:0}.activity-icon{width:32px;height:32px;border-radius:50%;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center}.empty{padding:30px 16px;text-align:center;color:var(--zcs-secondary-text-color)}.empty i{font-size:24px;color:var(--zcs_brand_color);display:block;margin-bottom:8px}.quicklinks{margin-top:16px;padding:18px}.quicklinks .ops-actions{margin-top:12px}@media(max-width:1280px){.kpi-grid{grid-template-columns:repeat(4,1fr)}}@media(max-width:900px){.ops-grid{grid-template-columns:1fr}.kpi-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.ops{padding:10px}.ops-hero{padding:18px}.ops-hero&gt;div{align-items:flex-start;flex-direction:column}.kpi-grid{grid-template-columns:1fr}.rent-split{grid-template-columns:1fr}.section{padding:16px}.activity li{grid-template-columns:36px 1fr}.activity li&gt;span:last-child{grid-column:2}}\n&lt;/style&gt;\n&lt;div class=&apos;ops&apos;&gt;\n &lt;div class=&apos;ops-hero&apos;&gt;\n\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&apos;&gt;\n\t &lt;div&gt;&lt;h1 class=&apos;zcs-font-24 zcs-font-semibold zcs-m-0&apos;&gt;Operations Dashboard&lt;/h1&gt;&lt;p class=&apos;zcs-font-14 zcs-mt-8 zcs-m-0&apos;&gt;Portfolio, rent, and maintenance overview as of &lt;%=zoho.currentdate.toString(&quot;dd-MMM-yyyy&quot;)%&gt;.&lt;/p&gt;&lt;/div&gt;\n\t &lt;div class=&apos;ops-actions&apos;&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button&apos; href=&apos;#Form:Work_Orders&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;New work order&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button&apos; href=&apos;#Report:Outstanding_Rent&apos;&gt;&lt;i class=&apos;zc-li-outline business-money-coins&apos;&gt;&lt;/i&gt;Outstanding rent&lt;/a&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n &lt;/div&gt;\n &lt;div class=&apos;kpi-grid&apos;&gt;\n\t&lt;div class=&apos;zcs-card kpi&apos;&gt;&lt;div class=&apos;kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline buildings-1-office&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;kpi-value&apos;&gt;&lt;%=activeProperties%&gt;&lt;/div&gt;&lt;div class=&apos;kpi-label&apos;&gt;Active properties&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&apos;zcs-card kpi&apos;&gt;&lt;div class=&apos;kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;kpi-value&apos;&gt;&lt;%=occupiedUnits%&gt;&lt;/div&gt;&lt;div class=&apos;kpi-label&apos;&gt;Occupied units&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&apos;zcs-card kpi&apos;&gt;&lt;div class=&apos;kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;kpi-value&apos;&gt;&lt;%=vacantUnits%&gt;&lt;/div&gt;&lt;div class=&apos;kpi-label&apos;&gt;Vacant units&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&apos;zcs-card kpi&apos;&gt;&lt;div class=&apos;kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;kpi-value&apos;&gt;&lt;%=activeLeases%&gt;&lt;/div&gt;&lt;div class=&apos;kpi-label&apos;&gt;Active leases&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&apos;zcs-card kpi&apos;&gt;&lt;div class=&apos;kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline business-money-coins&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;kpi-value&apos;&gt;$&lt;%=outstandingAmount.toString(&quot;###,##0.00&quot;)%&gt;&lt;/div&gt;&lt;div class=&apos;kpi-label&apos;&gt;Outstanding rent&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&apos;zcs-card kpi&apos;&gt;&lt;div class=&apos;kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-settings-gear-63&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;kpi-value&apos;&gt;&lt;%=openWorkOrders%&gt;&lt;/div&gt;&lt;div class=&apos;kpi-label&apos;&gt;Open work orders&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&apos;zcs-card kpi&apos;&gt;&lt;div class=&apos;kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-solid ui-2-time&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;kpi-value&apos;&gt;&lt;%=emergencyWorkOrders%&gt;&lt;/div&gt;&lt;div class=&apos;kpi-label&apos;&gt;Emergency work orders&lt;/div&gt;&lt;/div&gt;\n &lt;/div&gt;\n &lt;div class=&apos;ops-grid&apos;&gt;\n\t&lt;section class=&apos;zcs-card section&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h3&gt;Occupancy&lt;/h3&gt;&lt;a href=&apos;#Report:All_Units&apos;&gt;View units&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;span class=&apos;zcs-font-14&apos;&gt;Occupied active units&lt;/span&gt;&lt;strong&gt;&lt;%=occupancyPct%&gt;%&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;zcs-progress-bar zcs-mt-8&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=occupancyPct%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;rent-split&apos;&gt;&lt;div&gt;&lt;strong&gt;&lt;%=occupiedUnits%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Occupied&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;strong&gt;&lt;%=vacantUnits%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Vacant&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;strong&gt;&lt;%=activeUnits%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Active units&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;\n\t&lt;section class=&apos;zcs-card section&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h3&gt;Work-order status&lt;/h3&gt;&lt;a href=&apos;#Report:Work_Order_Board&apos;&gt;Open board&lt;/a&gt;&lt;/div&gt;\n\t &lt;% for each statusItem in {&quot;New&quot;,&quot;Assigned&quot;,&quot;In Progress&quot;,&quot;On Hold&quot;,&quot;Resolved&quot;,&quot;Closed&quot;,&quot;Cancelled&quot;} { statusCount=0;if(statusItem==&quot;New&quot;){statusCount=newCount;}else if(statusItem==&quot;Assigned&quot;){statusCount=assignedCount;}else if(statusItem==&quot;In Progress&quot;){statusCount=inProgressCount;}else if(statusItem==&quot;On Hold&quot;){statusCount=onHoldCount;}else if(statusItem==&quot;Resolved&quot;){statusCount=resolvedCount;}else if(statusItem==&quot;Closed&quot;){statusCount=closedCount;}else{statusCount=cancelledCount;} statusPct=(statusCount*100.0/maxStatus).round(0); %&gt;&lt;div class=&apos;status-row&apos;&gt;&lt;span&gt;&lt;%=statusItem%&gt;&lt;/span&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=statusPct%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong&gt;&lt;%=statusCount%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;% } %&gt;\n\t&lt;/section&gt;\n\t&lt;section class=&apos;zcs-card section&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h3&gt;Outstanding rent summary&lt;/h3&gt;&lt;a href=&apos;#Report:Outstanding_Rent&apos;&gt;View report&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;rent-number&apos;&gt;$&lt;%=outstandingAmount.toString(&quot;###,##0.00&quot;)%&gt;&lt;/div&gt;&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-mt-8&apos;&gt;Balance across &lt;%=outstandingRows.count()%&gt; unpaid or partially paid obligations.&lt;/p&gt;&lt;div class=&apos;rent-split&apos;&gt;&lt;div&gt;&lt;strong&gt;$&lt;%=outstandingDue.toString(&quot;###,##0.00&quot;)%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Amount due&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;strong&gt;$&lt;%=outstandingPaid.toString(&quot;###,##0.00&quot;)%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Received&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;strong&gt;&lt;%=Rental_Payments[Payment_Status == &quot;Overdue&quot;].count()%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Overdue items&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;\n\t&lt;section class=&apos;zcs-card section&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h3&gt;Upcoming rent activity&lt;/h3&gt;&lt;a href=&apos;#Report:All_Rental_Payments&apos;&gt;All payments&lt;/a&gt;&lt;/div&gt;&lt;% if(upcomingPayments.count()==0){ %&gt;&lt;div class=&apos;empty&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;No rent dues or reminders in the next 30 days.&lt;/div&gt;&lt;% }else{ %&gt;&lt;ul class=&apos;activity&apos;&gt;&lt;% for each pay in upcomingPayments { balance=ifnull(pay.Amount_Due,0)-ifnull(pay.Amount_Paid,0); %&gt;&lt;li&gt;&lt;span class=&apos;activity-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;strong&gt;&lt;%=pay.Tenant.Tenant_Name%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;&lt;%=pay.Property.Property_Name%&gt; · Due &lt;%=pay.Due_Date.toString(&quot;dd-MMM&quot;)%&gt; · Reminder &lt;%=pay.Reminder_Date.toString(&quot;dd-MMM&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&apos;zcs-font-13 zcs-font-semibold&apos;&gt;$&lt;%=balance.toString(&quot;###,##0.00&quot;)%&gt;&lt;/span&gt;&lt;/li&gt;&lt;% } %&gt;&lt;/ul&gt;&lt;% } %&gt;&lt;/section&gt;\n &lt;/div&gt;\n &lt;section class=&apos;zcs-card section&apos; style=&apos;margin-top:16px&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h3&gt;Recent work orders&lt;/h3&gt;&lt;a href=&apos;#Report:All_Work_Orders&apos;&gt;View all work orders&lt;/a&gt;&lt;/div&gt;&lt;% recentCount=Work_Orders[ID != 0].count(); if(recentCount==0){ %&gt;&lt;div class=&apos;empty&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-settings-gear-63&apos;&gt;&lt;/i&gt;No work orders have been raised yet.&lt;/div&gt;&lt;% }else{ %&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Work order&lt;/th&gt;&lt;th&gt;Request&lt;/th&gt;&lt;th&gt;Property&lt;/th&gt;&lt;th&gt;Raised&lt;/th&gt;&lt;th&gt;Priority&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;% for each wo in Work_Orders[ID != 0] sort by Raised_On desc range from 0 to 7 { priorityClass=&quot;zcs-badge-blue&quot;;if(wo.Priority==&quot;Emergency&quot;){priorityClass=&quot;zcs-badge-red&quot;;}else if(wo.Priority==&quot;High&quot;){priorityClass=&quot;zcs-badge-orange&quot;;}else if(wo.Priority==&quot;Low&quot;){priorityClass=&quot;zcs-badge-grey&quot;;} statusClass=&quot;zcs-badge-blue&quot;;if(wo.Status==&quot;Resolved&quot; || wo.Status==&quot;Closed&quot;){statusClass=&quot;zcs-badge-green&quot;;}else if(wo.Status==&quot;On Hold&quot;){statusClass=&quot;zcs-badge-yellow&quot;;}else if(wo.Status==&quot;Cancelled&quot;){statusClass=&quot;zcs-badge-grey&quot;;} %&gt;&lt;tr&gt;&lt;td&gt;&lt;a href=&apos;#Page:Work_Order_Tracking?Work_Order_ID=&lt;%=wo.ID%&gt;&apos;&gt;&lt;%=wo.Work_Order_ID%&gt;&lt;/a&gt;&lt;/td&gt;&lt;td&gt;&lt;%=wo.Request_Title%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=wo.Property.Property_Name%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=wo.Raised_On.toString(&quot;dd-MMM-yyyy&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;span class=&apos;zcs-badge &lt;%=priorityClass%&gt;&apos;&gt;&lt;%=wo.Priority%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span class=&apos;zcs-badge &lt;%=statusClass%&gt;&apos;&gt;&lt;%=wo.Status%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;% } %&gt;&lt;/section&gt;\n &lt;section class=&apos;zcs-card quicklinks&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h3&gt;Core operations&lt;/h3&gt;&lt;/div&gt;&lt;div class=&apos;ops-actions&apos;&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button&apos; href=&apos;#Report:All_Properties&apos;&gt;Properties&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button&apos; href=&apos;#Report:All_Units&apos;&gt;Units&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button&apos; href=&apos;#Report:Active_Leases&apos;&gt;Active leases&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button&apos; href=&apos;#Report:Outstanding_Rent&apos;&gt;Outstanding rent&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button&apos; href=&apos;#Report:Work_Order_Board&apos;&gt;Work-order board&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-button&apos; href=&apos;#Form:Rental_Payments&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;Record payment&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-button&apos; href=&apos;#Form:Work_Orders&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;Add work order&lt;/a&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;/div&gt;\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Work_Order_Tracking(int Work_Order_ID)
		{
					displayname = "Work Order Tracking"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='WorkOrderTrackingSnippet' elementName='Work Order Tracking Content'>\n\t\t\t\t\t<![CDATA[htmlpage WorkOrderTrackingSnippet()\ncontent\n&lt;%{%&gt;\n&lt;%\nworkOrder = Work_Orders[ID == input.Work_Order_ID];\n%&gt;\n&lt;style&gt;\n.wot-page{background:var(--zcs_page_bg_color,#f5f6f8);padding:20px;color:var(--zcs_primary_text_color);font-family:inherit}.wot-shell{max-width:1180px;margin:0 auto}.wot-card{background:#fff;border:1px solid var(--zcs_tertiary_border_color,#e3e6eb);border-radius:12px;padding:20px}.wot-header{background:var(--zcs_brand_color,#2563eb);color:var(--zcs_brand_foreground_color,#fff);border-radius:12px;padding:24px}.wot-header h1{margin:5px 0 8px;font-size:25px}.wot-muted{opacity:.82;font-size:13px}.wot-grid{display:grid;grid-template-columns:2fr 1fr;gap:16px;margin-top:16px}.wot-stack{display:grid;gap:16px}.wot-details{display:grid;grid-template-columns:1fr 1fr;gap:0 20px}.wot-field{padding:11px 0;border-bottom:1px solid var(--zcs_tertiary_border_color,#e3e6eb)}.wot-field label{display:block;color:var(--zcs_secondary_text_color,#68707d);font-size:12px;margin-bottom:4px}.wot-field span{font-size:14px;font-weight:500;overflow-wrap:anywhere}.wot-card h2{font-size:17px;margin:0 0 12px}.wot-description{white-space:pre-wrap;line-height:1.6;margin:0}.wot-badges{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.wot-badge{border:1px solid currentColor;border-radius:4px;padding:3px 9px;font-size:12px}.wot-event{border-left:3px solid var(--zcs_brand_color,#2563eb);padding:2px 0 14px 14px;margin-top:12px}.wot-event:last-child{padding-bottom:2px}.wot-event-title{font-weight:600}.wot-event-meta{color:var(--zcs_secondary_text_color,#68707d);font-size:12px;margin-top:4px}.wot-event-notes{font-size:14px;margin:7px 0 0}.wot-empty{text-align:center;padding:48px 20px}.wot-empty i{display:block;font-size:28px;color:var(--zcs_brand_color,#2563eb);margin-bottom:10px}.wot-link{display:inline-block;margin-top:14px;color:var(--zcs_brand_color,#2563eb);text-decoration:none}.wot-resolution{border-left:4px solid #179e6c}@media(max-width:760px){.wot-page{padding:10px}.wot-grid,.wot-details{grid-template-columns:1fr}}\n&lt;/style&gt;\n&lt;div class=&apos;wot-page&apos;&gt;\n &lt;div class=&apos;wot-shell&apos;&gt;\n&lt;% if(workOrder.count() == 0) { %&gt;\n\t&lt;section class=&apos;wot-card wot-empty&apos;&gt;\n\t &lt;i class=&apos;zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;\n\t &lt;h2&gt;Work order not found&lt;/h2&gt;\n\t &lt;p&gt;The supplied work order ID is missing or invalid.&lt;/p&gt;\n\t &lt;a class=&apos;wot-link&apos; href=&apos;#Report:All_Work_Orders&apos;&gt;Open all work orders&lt;/a&gt;\n\t&lt;/section&gt;\n&lt;% } else { %&gt;\n&lt;%\nwo = workOrder;\nhistoryRows = Work_Order_Status_History[Work_Order == wo.ID] sort by Changed_At;\nresolutionText = ifnull(wo.Resolution_Notes,&quot;&quot;);\nstatusNotesText = ifnull(wo.Status_Notes,&quot;&quot;);\nassigneeText = ifnull(wo.Assigned_To_Email,&quot;Unassigned&quot;);\naccessText = ifnull(wo.Preferred_Access_Time,&quot;Not specified&quot;);\nexternalIdText = ifnull(wo.External_Request_ID,&quot;Not applicable&quot;);\n%&gt;\n\t&lt;header class=&apos;wot-header&apos;&gt;\n\t &lt;div class=&apos;wot-muted&apos;&gt;Work order &lt;%=wo.Work_Order_ID%&gt;&lt;/div&gt;\n\t &lt;h1&gt;&lt;%=wo.Request_Title%&gt;&lt;/h1&gt;\n\t &lt;div class=&apos;wot-muted&apos;&gt;Raised &lt;%=wo.Raised_On.toString(&quot;dd-MMM-yyyy hh:mm a&quot;)%&gt;&lt;/div&gt;\n\t &lt;div class=&apos;wot-badges&apos;&gt;\n\t\t&lt;span class=&apos;wot-badge&apos;&gt;&lt;%=wo.Priority%&gt; priority&lt;/span&gt;\n\t\t&lt;span class=&apos;wot-badge&apos;&gt;&lt;%=wo.Status%&gt;&lt;/span&gt;\n\t &lt;/div&gt;\n\t&lt;/header&gt;\n\t&lt;div class=&apos;wot-grid&apos;&gt;\n\t &lt;main class=&apos;wot-stack&apos;&gt;\n\t\t&lt;section class=&apos;wot-card&apos;&gt;\n\t\t &lt;h2&gt;&lt;i class=&apos;zc-li-outline education-notepad&apos;&gt;&lt;/i&gt; Request details&lt;/h2&gt;\n\t\t &lt;p class=&apos;wot-description&apos;&gt;&lt;%=wo.Request_Description%&gt;&lt;/p&gt;\n\t\t &lt;div class=&apos;wot-details&apos;&gt;\n\t\t\t&lt;div class=&apos;wot-field&apos;&gt;&lt;label&gt;Category&lt;/label&gt;&lt;span&gt;&lt;%=wo.Category%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;wot-field&apos;&gt;&lt;label&gt;Preferred access time&lt;/label&gt;&lt;span&gt;&lt;%=accessText%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;wot-field&apos;&gt;&lt;label&gt;Source&lt;/label&gt;&lt;span&gt;&lt;%=wo.Source%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;wot-field&apos;&gt;&lt;label&gt;External request ID&lt;/label&gt;&lt;span&gt;&lt;%=externalIdText%&gt;&lt;/span&gt;&lt;/div&gt;\n&lt;% if(statusNotesText != &quot;&quot;) { %&gt;\n\t\t\t&lt;div class=&apos;wot-field&apos;&gt;&lt;label&gt;Status notes&lt;/label&gt;&lt;span&gt;&lt;%=statusNotesText%&gt;&lt;/span&gt;&lt;/div&gt;\n&lt;% } %&gt;\n\t\t &lt;/div&gt;\n\t\t&lt;/section&gt;\n\t\t&lt;section class=&apos;wot-card&apos;&gt;\n\t\t &lt;h2&gt;&lt;i class=&apos;zc-li-outline arrows-2-time&apos;&gt;&lt;/i&gt; Status history&lt;/h2&gt;\n&lt;% if(historyRows.count() == 0) { %&gt;\n\t\t &lt;p&gt;No status history has been recorded yet.&lt;/p&gt;\n&lt;% } else { %&gt;\n&lt;% for each historyRow in historyRows { %&gt;\n&lt;%\npreviousStatusText = ifnull(historyRow.Previous_Status,&quot;Created&quot;);\nchangedByText = ifnull(historyRow.Changed_By,&quot;System&quot;);\nhistoryNotesText = ifnull(historyRow.Notes,&quot;&quot;);\n%&gt;\n\t\t &lt;div class=&apos;wot-event&apos;&gt;\n\t\t\t&lt;div class=&apos;wot-event-title&apos;&gt;&lt;%=previousStatusText%&gt; to &lt;%=historyRow.New_Status%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;wot-event-meta&apos;&gt;&lt;%=historyRow.Changed_At.toString(&quot;dd-MMM-yyyy hh:mm a&quot;)%&gt; by &lt;%=changedByText%&gt; via &lt;%=historyRow.Change_Source%&gt;&lt;/div&gt;\n&lt;% if(historyNotesText != &quot;&quot;) { %&gt;\n\t\t\t&lt;p class=&apos;wot-event-notes&apos;&gt;&lt;%=historyNotesText%&gt;&lt;/p&gt;\n&lt;% } %&gt;\n\t\t &lt;/div&gt;\n&lt;% } %&gt;\n&lt;% } %&gt;\n\t\t&lt;/section&gt;\n&lt;% if(resolutionText != &quot;&quot;) { %&gt;\n\t\t&lt;section class=&apos;wot-card wot-resolution&apos;&gt;\n\t\t &lt;h2&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt; Resolution&lt;/h2&gt;\n\t\t &lt;p class=&apos;wot-description&apos;&gt;&lt;%=resolutionText%&gt;&lt;/p&gt;\n\t\t&lt;/section&gt;\n&lt;% } %&gt;\n\t &lt;/main&gt;\n\t &lt;aside class=&apos;wot-stack&apos;&gt;\n\t\t&lt;section class=&apos;wot-card&apos;&gt;\n\t\t &lt;h2&gt;Current state&lt;/h2&gt;\n\t\t &lt;div class=&apos;wot-field&apos;&gt;&lt;label&gt;Status&lt;/label&gt;&lt;span&gt;&lt;%=wo.Status%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t &lt;div class=&apos;wot-field&apos;&gt;&lt;label&gt;Priority&lt;/label&gt;&lt;span&gt;&lt;%=wo.Priority%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t &lt;div class=&apos;wot-field&apos;&gt;&lt;label&gt;Assignee&lt;/label&gt;&lt;span&gt;&lt;%=assigneeText%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t\t&lt;section class=&apos;wot-card&apos;&gt;\n\t\t &lt;h2&gt;Location and tenant&lt;/h2&gt;\n\t\t &lt;div class=&apos;wot-field&apos;&gt;&lt;label&gt;Tenant&lt;/label&gt;&lt;span&gt;&lt;%=wo.Tenant.Tenant_Name%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t &lt;div class=&apos;wot-field&apos;&gt;&lt;label&gt;Property&lt;/label&gt;&lt;span&gt;&lt;%=wo.Property.Property_Name%&gt;&lt;/span&gt;&lt;/div&gt;\n&lt;% if(wo.Unit != null) { %&gt;\n\t\t &lt;div class=&apos;wot-field&apos;&gt;&lt;label&gt;Unit&lt;/label&gt;&lt;span&gt;&lt;%=wo.Unit.Unit_Number%&gt;&lt;/span&gt;&lt;/div&gt;\n&lt;% } %&gt;\n\t\t&lt;/section&gt;\n\t\t&lt;section class=&apos;wot-card&apos;&gt;\n\t\t &lt;h2&gt;Actions&lt;/h2&gt;\n\t\t &lt;a class=&apos;wot-link&apos; href=&apos;#Report:All_Work_Orders&apos;&gt;Back to all work orders&lt;/a&gt;\n\t\t&lt;/section&gt;\n\t &lt;/aside&gt;\n\t&lt;/div&gt;\n&lt;% } %&gt;\n &lt;/div&gt;\n&lt;/div&gt;\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			API_Configuration_On_Success as "Track API Key Rotation"
			{
			    type = form
			    form = API_Configuration
			    record event = on add or edit
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                config_record = API_Configuration[ID == input.ID];
			                config_record.Last_Rotated_On = zoho.currenttime;
			            )
			        }
			    }
			}

			API_Configuration_On_Validate as "Validate API Configuration"
			{
			    type = form
			    form = API_Configuration
			    record event = on add or edit
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Secret_Key == null || input.Secret_Key.trim() == "")
			                {
			                    alert "Secret Key is required.";
			                    cancel submit;
			                }
			                if(input.Active == true)
			                {
			                    active_configs = API_Configuration[Active == true && ID != input.ID];
			                    if(active_configs.count() > 0)
			                    {
			                        alert "Only one API configuration can be active.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Leases_On_Load as "Configure Lease Unit"
			{
			    type = form
			    form = Leases
			    record event = on add or edit
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Property != null)
			                {
			                    property_record = Properties[ID == input.Property];
			                    if(property_record.Property_Type == "Individual Villa")
			                    {
			                        input.Unit = null;
			                        hide Unit;
			                        disable Unit;
			                    }
			                    else
			                    {
			                        show Unit;
			                        enable Unit;
			                    }
			                }
			                else
			                {
			                    hide Unit;
			                    disable Unit;
			                }
			            )
			        }
			    }
			}

			Leases_On_Success as "Update Unit Occupancy"
			{
			    type = form
			    form = Leases
			    record event = on add or edit
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Unit != null)
			                {
			                    unit_record = Units[ID == input.Unit && Active == true];
			                    if(unit_record.count() > 0)
			                    {
			                        if(input.Lease_Status == "Active")
			                        {
			                            unit_record.Occupancy_Status = "Occupied";
			                        }
			                        else if(input.Lease_Status == "Expired" || input.Lease_Status == "Terminated")
			                        {
			                            other_active = Leases[ID != input.ID && Unit == input.Unit && Lease_Status == "Active"];
			                            if(other_active.count() == 0)
			                            {
			                                unit_record.Occupancy_Status = "Vacant";
			                            }
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Leases_On_Validate as "Validate Lease"
			{
			    type = form
			    form = Leases
			    record event = on add or edit
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Lease_End_Date != null && input.Lease_End_Date < input.Lease_Start_Date)
			                {
			                    alert "Lease end date cannot be before the start date.";
			                    cancel submit;
			                }
			                if(input.Payment_Due_Day < 1 || input.Payment_Due_Day > 28)
			                {
			                    alert "Payment due day must be between 1 and 28.";
			                    cancel submit;
			                }
			                property_record = Properties[ID == input.Property];
			                if(property_record.Property_Type == "Multi-Unit Property")
			                {
			                    if(input.Unit == null)
			                    {
			                        alert "A unit is required for a multi-unit property.";
			                        cancel submit;
			                    }
			                    unit_record = Units[ID == input.Unit];
			                    if(unit_record.count() == 0 || unit_record.Property != input.Property)
			                    {
			                        alert "The selected unit does not belong to the selected property.";
			                        cancel submit;
			                    }
			                }
			                else if(input.Unit != null)
			                {
			                    alert "Individual villa leases must not have a unit.";
			                    cancel submit;
			                }
			                if(input.Lease_Status == "Active")
			                {
			                    if(input.Unit != null)
			                    {
			                        overlaps = Leases[ID != input.ID && Lease_Status == "Active" && Unit == input.Unit && Lease_Start_Date <= ifnull(input.Lease_End_Date,'31-Dec-2999') && (Lease_End_Date is null || Lease_End_Date >= input.Lease_Start_Date)];
			                    }
			                    else
			                    {
			                        overlaps = Leases[ID != input.ID && Lease_Status == "Active" && Property == input.Property && Unit is null && Lease_Start_Date <= ifnull(input.Lease_End_Date,'31-Dec-2999') && (Lease_End_Date is null || Lease_End_Date >= input.Lease_Start_Date)];
			                    }
			                    if(overlaps.count() > 0)
			                    {
			                        alert "An overlapping active lease already exists for this residence.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Lease_Property_On_User_Input as "Lease Property Selection"
			{
			    type = form
			    form = Leases
			    record event = on add or edit
			    on user input of Property
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Unit = null;
			                if(input.Property != null)
			                {
			                    property_record = Properties[ID == input.Property];
			                    if(property_record.Property_Type == "Multi-Unit Property")
			                    {
			                        show Unit;
			                        enable Unit;
			                    }
			                    else
			                    {
			                        hide Unit;
			                        disable Unit;
			                    }
			                }
			                else
			                {
			                    hide Unit;
			                    disable Unit;
			                }
			            )
			        }
			    }
			}

			Payment_Lease_On_User_Input as "Populate Payment Lease Data"
			{
			    type = form
			    form = Rental_Payments
			    record event = on add or edit
			    on user input of Lease
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Lease != null)
			                {
			                    lease_record = Leases[ID == input.Lease];
			                    input.Tenant = lease_record.Tenant;
			                    input.Property = lease_record.Property;
			                    input.Unit = lease_record.Unit;
			                    input.Amount_Due = lease_record.Monthly_Rent;
			                }
			                else
			                {
			                    input.Tenant = null;
			                    input.Property = null;
			                    input.Unit = null;
			                    input.Amount_Due = null;
			                }
			                disable Tenant;
			                disable Property;
			                disable Unit;
			                disable Amount_Due;
			            )
			        }
			    }
			}

			Rental_Payments_On_Load as "Configure Payment Lease Data"
			{
			    type = form
			    form = Rental_Payments
			    record event = on add or edit
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Tenant;
			                disable Property;
			                disable Unit;
			                disable Amount_Due;
			                if(input.Lease != null)
			                {
			                    lease_record = Leases[ID == input.Lease];
			                    input.Tenant = lease_record.Tenant;
			                    input.Property = lease_record.Property;
			                    input.Unit = lease_record.Unit;
			                    input.Amount_Due = lease_record.Monthly_Rent;
			                }
			            )
			        }
			    }
			}

			Rental_Payments_On_Success as "Reconcile Rental Payment"
			{
			    type = form
			    form = Rental_Payments
			    record event = on add or edit
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                payment_record = Rental_Payments[ID == input.ID];
			                amount_paid = ifnull(input.Amount_Paid,0);
			                if(input.Payment_Status != "Waived")
			                {
			                    if(amount_paid >= input.Amount_Due)
			                    {
			                        payment_record.Payment_Status = "Paid";
			                        if(input.Paid_Date == null)
			                        {
			                            payment_record.Paid_Date = zoho.currentdate;
			                        }
			                    }
			                    else if(amount_paid > 0)
			                    {
			                        payment_record.Payment_Status = "Partially Paid";
			                    }
			                    else if(input.Due_Date < zoho.currentdate)
			                    {
			                        payment_record.Payment_Status = "Overdue";
			                    }
			                    else
			                    {
			                        payment_record.Payment_Status = "Due";
			                    }
			                }
			            )
			        }
			    }
			}

			Rental_Payments_On_Validate as "Validate Rental Payment"
			{
			    type = form
			    form = Rental_Payments
			    record event = on add or edit
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                amount_paid = ifnull(input.Amount_Paid,0);
			                if(amount_paid < 0 || amount_paid > input.Amount_Due)
			                {
			                    alert "Amount paid must be between zero and the amount due.";
			                    cancel submit;
			                }
			                if(input.Payment_Status == "Paid" && input.Paid_Date == null)
			                {
			                    input.Paid_Date = zoho.currentdate;
			                }
			            )
			        }
			    }
			}

			Tenants_On_Validate as "Validate Tenant Phones"
			{
			    type = form
			    form = Tenants
			    record event = on add or edit
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                e164_pattern = "^\\+[1-9][0-9]{7,14}$";
			                if(input.Phone.matches(e164_pattern) == false)
			                {
			                    alert "Phone must use E.164 format, for example +12125551234.";
			                    cancel submit;
			                }
			                if(input.Alternate_Phone != null && input.Alternate_Phone != "" && input.Alternate_Phone.matches(e164_pattern) == false)
			                {
			                    alert "Alternate Phone must use E.164 format.";
			                    cancel submit;
			                }
			                if(input.Emergency_Contact_Phone != null && input.Emergency_Contact_Phone != "" && input.Emergency_Contact_Phone.matches(e164_pattern) == false)
			                {
			                    alert "Emergency Contact Phone must use E.164 format.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Units_On_Validate as "Validate Unit"
			{
			    type = form
			    form = Units
			    record event = on add or edit
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                property_record = Properties[ID == input.Property];
			                if(property_record.count() == 0 || property_record.Property_Type != "Multi-Unit Property")
			                {
			                    alert "Units can only be added to a Multi-Unit Property.";
			                    cancel submit;
			                }
			                duplicate_units = Units[Property == input.Property && Unit_Number == input.Unit_Number && ID != input.ID];
			                if(duplicate_units.count() > 0)
			                {
			                    alert "This unit number already exists for the selected property.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			View_Tracking as "View Work Order Tracking"
			{
			    type = form
			    form = Work_Order_Tracker_Filter
			    button = View_Tracking
			    on click
			    {
			        actions
			        {
			            on click
			            (
			                if(input.Work_Order == null)
			                {
			                    alert "Select a work order before viewing tracking.";
			                }
			                else
			                {
			                    openUrl("#Page:Work_Order_Tracking?Work_Order_ID=" + input.Work_Order,"same window");
			                }
			            )
			        }
			    }
			}

			Work_Order_Property_On_User_Input as "Validate Work Order Property"
			{
			    type = form
			    form = Work_Orders
			    record event = on add or edit
			    on user input of Property
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Property == null)
			                {
			                    input.Unit = null;
			                }
			            )
			        }
			    }
			}

			Work_Order_Tenant_On_User_Input as "Resolve Tenant Residence"
			{
			    type = form
			    form = Work_Orders
			    record event = on add or edit
			    on user input of Tenant
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Property = null;
			                input.Unit = null;
			                if(input.Tenant != null)
			                {
			                    active_leases = Leases[Tenant == input.Tenant && Lease_Status == "Active" && Lease_Start_Date <= zoho.currentdate && (Lease_End_Date is null || Lease_End_Date >= zoho.currentdate)];
			                    if(active_leases.count() == 1)
			                    {
			                        for each active_lease in active_leases
			                        {
			                            input.Property = active_lease.Property;
			                            input.Unit = active_lease.Unit;
			                        }
			                    }
			                    else if(active_leases.count() == 0)
			                    {
			                        alert "No current active lease was found for this tenant.";
			                    }
			                    else
			                    {
			                        alert "Multiple active leases were found; resolve the lease data before raising a work order.";
			                    }
			                }
			                disable Property;
			                disable Unit;
			            )
			        }
			    }
			}

			Work_Orders_On_Load as "Configure Work Order"
			{
			    type = form
			    form = Work_Orders
			    record event = on add or edit
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Tenant != null)
			                {
			                    active_leases = Leases[Tenant == input.Tenant && Lease_Status == "Active" && Lease_Start_Date <= zoho.currentdate && (Lease_End_Date is null || Lease_End_Date >= zoho.currentdate)];
			                    if(active_leases.count() == 1)
			                    {
			                        for each active_lease in active_leases
			                        {
			                            input.Property = active_lease.Property;
			                            input.Unit = active_lease.Unit;
			                        }
			                    }
			                    disable Property;
			                    disable Unit;
			                }
			                if(input.Status == "Resolved" || input.Status == "Closed")
			                {
			                    show Resolution_Notes;
			                }
			                else
			                {
			                    hide Resolution_Notes;
			                }
			            )
			        }
			    }
			}

			Work_Orders_On_Success as "Log and Notify Work Order Status"
			{
			    type = form
			    form = Work_Orders
			    record event = on add or edit
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                previous_status = "";
			                latest_history = Work_Order_Status_History[Work_Order == input.ID] sort by Changed_At desc;
			                history_needed = true;
			                if(latest_history.count() > 0)
			                {
			                    previous_status = latest_history.New_Status;
			                    if(previous_status == input.Status)
			                    {
			                        history_needed = false;
			                    }
			                }
			                if(history_needed)
			                {
			                    change_source = "Internal";
			                    if(input.Source == "External API" && latest_history.count() == 0)
			                    {
			                        change_source = "External API";
			                    }
			                    history_id = insert into Work_Order_Status_History
			                    [
			                        Work_Order = input.ID
			                        Previous_Status = previous_status
			                        New_Status = input.Status
			                        Changed_At = zoho.currenttime
			                        Changed_By = zoho.loginuserid
			                        Change_Source = change_source
			                        Notes = input.Status_Notes
			                    ];
			                    tenant_record = Tenants[ID == input.Tenant];
			                    property_record = Properties[ID == input.Property];
			                    if(tenant_record.count() > 0 && tenant_record.Email != null)
			                    {
			                        unit_text = "";
			                        if(input.Unit != null)
			                        {
			                            unit_record = Units[ID == input.Unit];
			                            unit_text = "<br><b>Unit:</b> " + unit_record.Unit_Number;
			                        }
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : tenant_record.Email
			                            subject : "Work order " + input.Work_Order_ID + " status: " + input.Status
			                            message : "Hello " + tenant_record.Tenant_Name + ",<br><br>Your work order has been updated.<br><b>Work Order:</b> " + input.Work_Order_ID + "<br><b>Title:</b> " + input.Request_Title + "<br><b>Property:</b> " + property_record.Property_Name + unit_text + "<br><b>New status:</b> " + input.Status + "<br><b>Notes:</b> " + ifnull(input.Status_Notes,"") + "<br><b>Updated:</b> " + zoho.currenttime
			                        )
			                    }
			                }
			            )
			        }
			    }
			}

			Work_Orders_On_Validate as "Validate Work Order"
			{
			    type = form
			    form = Work_Orders
			    record event = on add or edit
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Source == "External API" && (input.External_Request_ID == null || input.External_Request_ID.trim() == ""))
			                {
			                    alert "External Request ID is required for API work orders.";
			                    cancel submit;
			                }
			                if(input.Unit != null)
			                {
			                    unit_record = Units[ID == input.Unit];
			                    if(unit_record.count() == 0 || unit_record.Property != input.Property)
			                    {
			                        alert "The selected unit does not belong to the selected property.";
			                        cancel submit;
			                    }
			                }
			                active_leases = Leases[Tenant == input.Tenant && Lease_Status == "Active" && Lease_Start_Date <= zoho.currentdate && (Lease_End_Date is null || Lease_End_Date >= zoho.currentdate)];
			                residence_matches = 0;
			                for each active_lease in active_leases
			                {
			                    if(active_lease.Property == input.Property && active_lease.Unit == input.Unit)
			                    {
			                        residence_matches = residence_matches + 1;
			                    }
			                }
			                if(residence_matches != 1)
			                {
			                    alert "Tenant, property and unit must match exactly one current active lease.";
			                    cancel submit;
			                }
			                if((input.Status == "Resolved" || input.Status == "Closed") && (input.Resolution_Notes == null || input.Resolution_Notes.trim() == ""))
			                {
			                    alert "Resolution Notes are required when resolving or closing a work order.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}
		}

		schedule
		{
			Lease_Monthly_Billing as "Generate Monthly Rent"
			{
			    type = schedule
			    form = Leases[Lease_Status == "Active"]
			    start = Billing_Start_Date at "00:15:00"
			    frequency = monthly
			    time zone = "America/New_York"
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                cycle_month = zoho.currentdate.toStartOfMonth();
			                if(input.Lease_Start_Date <= zoho.currentdate && (input.Lease_End_Date == null || input.Lease_End_Date >= zoho.currentdate))
			                {
			                    existing_payment = Rental_Payments[Lease == input.ID && Billing_Month == cycle_month];
			                    if(existing_payment.count() == 0)
			                    {
			                        due_date = cycle_month.addDay(input.Payment_Due_Day - 1);
			                        reminder_date = cycle_month.addDay(26);
			                        payment_record = insert into Rental_Payments
			                        [
			                            Lease = input.ID
			                            Tenant = input.Tenant
			                            Property = input.Property
			                            Unit = input.Unit
			                            Billing_Month = cycle_month
			                            Due_Date = due_date
			                            Reminder_Date = reminder_date
			                            Amount_Due = input.Monthly_Rent
			                            Amount_Paid = 0
			                            Payment_Status = "Due"
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

			Mark_Rent_Overdue as "Mark Rent Overdue"
			{
			    type = schedule
			    form = Rental_Payments[Payment_Status != "Paid" && Payment_Status != "Waived"]
			    start = after 1 days from Due_Date at "00:30:00"
			    time zone = "America/New_York"
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                payment_record = Rental_Payments[ID == input.ID];
			                payment_record.Payment_Status = "Overdue";
			            )
			        }
			    }
			}

			Rent_Reminder_27th as "Rent Reminder on 27th"
			{
			    type = schedule
			    form = Rental_Payments[Payment_Status == "Due" || Payment_Status == "Partially Paid" || Payment_Status == "Overdue"]
			    start = Reminder_Date at "09:00:00"
			    time zone = "America/New_York"
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                lease_record = Leases[ID == input.Lease && Lease_Status == "Active"];
			                tenant_record = Tenants[ID == input.Tenant && Active == true];
			                if(lease_record.count() > 0 && tenant_record.count() > 0 && lease_record.Lease_Start_Date <= zoho.currentdate && (lease_record.Lease_End_Date == null || lease_record.Lease_End_Date >= zoho.currentdate))
			                {
			                    property_record = Properties[ID == input.Property];
			                    unit_text = "";
			                    if(input.Unit != null)
			                    {
			                        unit_record = Units[ID == input.Unit];
			                        unit_text = "<br><b>Unit:</b> " + unit_record.Unit_Number;
			                    }
			                    balance = input.Amount_Due - ifnull(input.Amount_Paid,0);
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : tenant_record.Email
			                        subject : "Rent payment reminder - " + property_record.Property_Name
			                        message : "Hello " + tenant_record.Tenant_Name + ",<br><br>This is your rent payment reminder for " + input.Billing_Month.toString("MMMM yyyy") + ".<br><b>Property:</b> " + property_record.Property_Name + unit_text + "<br><b>Due date:</b> " + input.Due_Date + "<br><b>Amount due:</b> $" + input.Amount_Due + "<br><b>Amount paid:</b> $" + ifnull(input.Amount_Paid,0) + "<br><b>Balance:</b> $" + balance + "<br><br>Please arrange payment by the due date."
			                    )
			                }
			            )
			        }
			    }
			}
		}

		blueprint
		{
			Work_Order_Lifecycle as "Work Order Lifecycle"
			{
			    type = blueprint
			    form = Work_Orders
			    start
			    {
			        start stage = "New"
			    }
			    stages
			    {
			        "New" { }
			        "Assigned" { }
			        "In Progress" { }
			        "On Hold" { }
			        "Resolved" { }
			        "Closed" { }
			        "Cancelled" { }
			    }
			    transitions
			    {
			        Assign as "Assign"
			        {
			            type = normal
			            from stage = "New"
			            to stage = "Assigned"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Property Superadmin"}
			                )
			            }
			            after { }
			        }
			        Start_Work as "Start Work"
			        {
			            type = normal
			            from stage = "Assigned"
			            to stage = "In Progress"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Property Superadmin"}
			                )
			            }
			            after { }
			        }
			        Put_On_Hold as "Put On Hold"
			        {
			            type = common
			            from stage = "Assigned"
			            to stage = "On Hold"
			            common stages = {"In Progress"}
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Property Superadmin"}
			                )
			            }
			            after { }
			        }
			        Resume as "Resume"
			        {
			            type = normal
			            from stage = "On Hold"
			            to stage = "In Progress"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Property Superadmin"}
			                )
			            }
			            after { }
			        }
			        Resolve as "Resolve"
			        {
			            type = common
			            from stage = "In Progress"
			            to stage = "Resolved"
			            common stages = {"On Hold"}
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Property Superadmin"}
			                )
			            }
			            after { }
			        }
			        Reopen as "Reopen"
			        {
			            type = normal
			            from stage = "Resolved"
			            to stage = "In Progress"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Property Superadmin"}
			                )
			            }
			            after { }
			        }
			        Close as "Close"
			        {
			            type = normal
			            from stage = "Resolved"
			            to stage = "Closed"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Property Superadmin"}
			                )
			            }
			            after { }
			        }
			        Cancel_Work_Order as "Cancel"
			        {
			            type = common
			            from stage = "New"
			            to stage = "Cancelled"
			            common stages = {"Assigned","In Progress","On Hold","Resolved"}
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Property Superadmin"}
			                )
			            }
			            after { }
			        }
			    }
			}
		}
	}

	functions
	{
		Deluge
		{
			map Create_Work_Order_From_API(string secret_key, map request_payload)
			{
			    response = Map();
			    response.put("success",false);
			    response.put("code","INVALID_REQUEST");
			    response.put("message","The request could not be processed.");
			    response.put("work_order_id",null);
			    active_configs = API_Configuration[Active == true];
			    if(active_configs.count() != 1 || secret_key == null || secret_key != active_configs.Secret_Key)
			    {
			        response.put("code","UNAUTHORIZED");
			        response.put("message","Authentication failed.");
			        return response;
			    }
			    tenant_phone = ifnull(request_payload.get("tenant_phone"),"").toString().trim();
			    title = ifnull(request_payload.get("title"),"").toString().trim();
			    description = ifnull(request_payload.get("description"),"").toString().trim();
			    external_request_id = ifnull(request_payload.get("external_request_id"),"").toString().trim();
			    if(tenant_phone == "" || title == "" || description == "")
			    {
			        response.put("code","MISSING_FIELDS");
			        response.put("message","tenant_phone, title and description are required.");
			        return response;
			    }
			    tenant_phone = tenant_phone.replaceAll("[^0-9+]","");
			    if(tenant_phone.matches("^\\+[1-9][0-9]{7,14}$") == false)
			    {
			        response.put("code","INVALID_PHONE");
			        response.put("message","tenant_phone must be in E.164 format.");
			        return response;
			    }
			    if(external_request_id != "")
			    {
			        existing_order = Work_Orders[External_Request_ID == external_request_id];
			        if(existing_order.count() > 0)
			        {
			            response.put("success",true);
			            response.put("code","ALREADY_EXISTS");
			            response.put("message","The external request was already processed.");
			            response.put("work_order_id",existing_order.Work_Order_ID);
			            return response;
			        }
			    }
			    tenant_records = Tenants[Phone == tenant_phone && Active == true];
			    if(tenant_records.count() != 1)
			    {
			        response.put("code","TENANT_NOT_FOUND");
			        response.put("message","Exactly one active tenant must match tenant_phone.");
			        return response;
			    }
			    tenant_id = null;
			    for each tenant_record in tenant_records
			    {
			        tenant_id = tenant_record.ID;
			    }
			    active_leases = Leases[Tenant == tenant_id && Lease_Status == "Active" && Lease_Start_Date <= zoho.currentdate && (Lease_End_Date is null || Lease_End_Date >= zoho.currentdate)];
			    if(active_leases.count() != 1)
			    {
			        response.put("code","LEASE_NOT_RESOLVED");
			        response.put("message","Exactly one current active lease is required for the tenant.");
			        return response;
			    }
			    property_id = null;
			    unit_id = null;
			    for each active_lease in active_leases
			    {
			        property_id = active_lease.Property;
			        unit_id = active_lease.Unit;
			    }
			    category = ifnull(request_payload.get("category"),"Other").toString();
			    if(category not in {"Plumbing","Electrical","HVAC","Appliance","Structural","Security","Cleaning","Other"})
			    {
			        category = "Other";
			    }
			    priority = ifnull(request_payload.get("priority"),"Medium").toString();
			    if(priority not in {"Low","Medium","High","Emergency"})
			    {
			        priority = "Medium";
			    }
			    preferred_access_time = ifnull(request_payload.get("preferred_access_time"),"").toString();
			    if(external_request_id == "")
			    {
			        external_request_id = "API-" + zoho.currenttime.toLong();
			    }
			    work_order_record_id = insert into Work_Orders
			    [
			        Source = "External API"
			        External_Request_ID = external_request_id
			        Tenant = tenant_id
			        Property = property_id
			        Unit = unit_id
			        Request_Title = title
			        Request_Description = description
			        Category = category
			        Priority = priority
			        Status = "New"
			        Raised_On = zoho.currenttime
			        Preferred_Access_Time = preferred_access_time
			    ];
			    created_order = Work_Orders[ID == work_order_record_id];
			    history_id = insert into Work_Order_Status_History
			    [
			        Work_Order = work_order_record_id
			        Previous_Status = ""
			        New_Status = "New"
			        Changed_At = zoho.currenttime
			        Changed_By = zoho.adminuserid
			        Change_Source = "External API"
			        Notes = "Created through custom API"
			    ];
			    response.put("success",true);
			    response.put("code","CREATED");
			    response.put("message","Work order created successfully.");
			    response.put("work_order_id",created_order.Work_Order_ID);
			    return response;
			}
		}
	}

