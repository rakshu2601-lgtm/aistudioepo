customize
{
    layout
    {
        theme = "theme_2"
        variant = "variant_2"
    }
    font = "lato"
    color options
    {
        name = "Property Slate"
        brand color = "#2563EB"
        type = "custom"
        dark mode color = "#0F172A"
    }
    logo
    {
        preference = "app_icon"
        placement = "left"
    }
    custom css
    {
        content = ".zc-app-header{box-shadow:0 1px 3px rgba(15,23,42,.12)}"
    }
}
