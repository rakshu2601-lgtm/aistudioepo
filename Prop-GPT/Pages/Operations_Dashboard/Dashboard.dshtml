<%
activeProperties = Properties[Active == true].count();
occupiedUnits = Units[Active == true && Occupancy_Status == "Occupied"].count();
vacantUnits = Units[Active == true && Occupancy_Status == "Vacant"].count();
activeUnits = Units[Active == true].count();
activeLeases = Leases[Lease_Status == "Active"].count();
outstandingRows = Rental_Payments[Payment_Status == "Due" || Payment_Status == "Partially Paid" || Payment_Status == "Overdue"];
outstandingDue = ifnull(outstandingRows.sum(Amount_Due),0);
outstandingPaid = ifnull(outstandingRows.sum(Amount_Paid),0);
outstandingAmount = outstandingDue - outstandingPaid;
openWorkOrders = Work_Orders[Status != "Resolved" && Status != "Closed" && Status != "Cancelled"].count();
emergencyWorkOrders = Work_Orders[Priority == "Emergency" && Status != "Resolved" && Status != "Closed" && Status != "Cancelled"].count();
occupancyPct = 0;
if(activeUnits > 0)
{
 occupancyPct = ((occupiedUnits * 100.0) / activeUnits).round(1);
}
newCount = Work_Orders[Status == "New"].count();
assignedCount = Work_Orders[Status == "Assigned"].count();
inProgressCount = Work_Orders[Status == "In Progress"].count();
onHoldCount = Work_Orders[Status == "On Hold"].count();
resolvedCount = Work_Orders[Status == "Resolved"].count();
closedCount = Work_Orders[Status == "Closed"].count();
cancelledCount = Work_Orders[Status == "Cancelled"].count();
maxStatus = newCount;
for each statusValue in {assignedCount,inProgressCount,onHoldCount,resolvedCount,closedCount,cancelledCount}
{
 if(statusValue > maxStatus)
 {
  maxStatus = statusValue;
 }
}
if(maxStatus == 0)
{
 maxStatus = 1;
}
upcomingPayments = Rental_Payments[(Payment_Status == "Due" || Payment_Status == "Partially Paid" || Payment_Status == "Overdue") && (Due_Date >= zoho.currentdate && Due_Date <= zoho.currentdate.addDay(30) || Reminder_Date >= zoho.currentdate && Reminder_Date <= zoho.currentdate.addDay(30))] sort by Due_Date range from 0 to 5;
%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--column-gap:16px}.zcs-row,.zcs-flex,.zcs-inline-flex{display:flex}.zcs-row{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-gap-4{gap:4px}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-gap-24{gap:24px}.zcs-p-0{padding:0}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-p-24{padding:24px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:8px}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-xl{border-radius:12px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.ops{background:var(--zcs_page_bg_color,#f5f6f8);padding:20px;color:var(--zcs-primary-text-color);font-family:inherit}.ops-hero{background:linear-gradient(120deg,var(--zcs_brand_dark_color),var(--zcs_brand_color));color:var(--zcs_brand_foreground_color);padding:24px;border-radius:14px}.ops-actions{display:flex;flex-wrap:wrap;gap:8px}.zcs-button{display:inline-flex;align-items:center;gap:7px;padding:9px 14px;border-radius:6px;text-decoration:none;font-size:14px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.ops-hero .zcs-primary-outline-button{border-color:rgba(255,255,255,.7);background:rgba(255,255,255,.12);color:inherit}.kpi-grid{display:grid;grid-template-columns:repeat(7,minmax(150px,1fr));gap:14px;margin-top:16px}.kpi{padding:18px;min-height:118px}.kpi-icon{width:36px;height:36px;border-radius:9px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;font-size:18px}.kpi-value{font-size:25px;font-weight:600;margin-top:14px}.kpi-label{font-size:13px;color:var(--zcs-secondary-text-color);margin-top:3px}.ops-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px;margin-top:16px}.section{padding:20px;min-width:0}.section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}.section-head h3{font-size:17px;margin:0}.section-head a{color:var(--zcs_brand_color);text-decoration:none;font-size:13px}.zcs-progress-bar{height:10px;background:var(--zcs_component_hover_color,#edf0f4);border-radius:4px;overflow:hidden}.zcs-progress-bar-indicator{height:100%;background:var(--zcs_brand_color);border-radius:inherit}.status-row{display:grid;grid-template-columns:95px 1fr 30px;gap:10px;align-items:center;margin:12px 0;font-size:13px}.rent-number{font-size:28px;font-weight:600}.rent-split{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}.rent-split div{background:var(--zcs_component_hover_color,#f6f7fa);padding:12px;border-radius:8px}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);overflow:auto;border-radius:6px}.zcs-table-wrapper table{width:100%;border-collapse:collapse;min-width:760px}.zcs-table-wrapper th{background:#f9fafe;font-weight:500;white-space:nowrap}.zcs-table-wrapper th,.zcs-table-wrapper td{padding:10px 14px;text-align:left;font-size:13px;border-bottom:1px solid var(--zcs-border-color)}.zcs-table-wrapper tr:last-child td{border-bottom:0}.zcs-badge{display:inline-flex;align-items:center;border-radius:4px;padding:2px 9px;font-size:12px;color:#fff;white-space:nowrap}.zcs-badge-green{background:#179e6c}.zcs-badge-red{background:#fe455d}.zcs-badge-yellow{background:#c98a09}.zcs-badge-blue{background:#2a6ffc}.zcs-badge-orange{background:#f4660c}.zcs-badge-grey{background:#5f6470}.activity{list-style:none;margin:0;padding:0}.activity li{display:grid;grid-template-columns:36px 1fr auto;gap:12px;align-items:start;padding:13px 0;border-bottom:1px solid var(--zcs-border-color)}.activity li:last-child{border-bottom:0}.activity-icon{width:32px;height:32px;border-radius:50%;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center}.empty{padding:30px 16px;text-align:center;color:var(--zcs-secondary-text-color)}.empty i{font-size:24px;color:var(--zcs_brand_color);display:block;margin-bottom:8px}.quicklinks{margin-top:16px;padding:18px}.quicklinks .ops-actions{margin-top:12px}@media(max-width:1280px){.kpi-grid{grid-template-columns:repeat(4,1fr)}}@media(max-width:900px){.ops-grid{grid-template-columns:1fr}.kpi-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.ops{padding:10px}.ops-hero{padding:18px}.ops-hero>div{align-items:flex-start;flex-direction:column}.kpi-grid{grid-template-columns:1fr}.rent-split{grid-template-columns:1fr}.section{padding:16px}.activity li{grid-template-columns:36px 1fr}.activity li>span:last-child{grid-column:2}}
</style>
<div class='ops'>
 <div class='ops-hero'>
  <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16'>
   <div><h1 class='zcs-font-24 zcs-font-semibold zcs-m-0'>Operations Dashboard</h1><p class='zcs-font-14 zcs-mt-8 zcs-m-0'>Portfolio, rent, and maintenance overview as of <%=zoho.currentdate.toString("dd-MMM-yyyy")%>.</p></div>
   <div class='ops-actions'><a class='zcs-button zcs-primary-outline-button' href='#Form:Work_Orders'><i class='zc-li-outline ui-1-simple-add'></i>New work order</a><a class='zcs-button zcs-primary-outline-button' href='#Report:Outstanding_Rent'><i class='zc-li-outline business-money-coins'></i>Outstanding rent</a></div>
  </div>
 </div>
 <div class='kpi-grid'>
  <div class='zcs-card kpi'><div class='kpi-icon'><i class='zc-li-outline buildings-1-office'></i></div><div class='kpi-value'><%=activeProperties%></div><div class='kpi-label'>Active properties</div></div>
  <div class='zcs-card kpi'><div class='kpi-icon'><i class='zc-li-outline ui-1-check-circle-08'></i></div><div class='kpi-value'><%=occupiedUnits%></div><div class='kpi-label'>Occupied units</div></div>
  <div class='zcs-card kpi'><div class='kpi-icon'><i class='zc-li-outline ui-1-circle'></i></div><div class='kpi-value'><%=vacantUnits%></div><div class='kpi-label'>Vacant units</div></div>
  <div class='zcs-card kpi'><div class='kpi-icon'><i class='zc-li-outline files-single-copy-04'></i></div><div class='kpi-value'><%=activeLeases%></div><div class='kpi-label'>Active leases</div></div>
  <div class='zcs-card kpi'><div class='kpi-icon'><i class='zc-li-outline business-money-coins'></i></div><div class='kpi-value'>$<%=outstandingAmount.toString("###,##0.00")%></div><div class='kpi-label'>Outstanding rent</div></div>
  <div class='zcs-card kpi'><div class='kpi-icon'><i class='zc-li-outline ui-2-settings-gear-63'></i></div><div class='kpi-value'><%=openWorkOrders%></div><div class='kpi-label'>Open work orders</div></div>
  <div class='zcs-card kpi'><div class='kpi-icon'><i class='zc-li-solid ui-2-time'></i></div><div class='kpi-value'><%=emergencyWorkOrders%></div><div class='kpi-label'>Emergency work orders</div></div>
 </div>
 <div class='ops-grid'>
  <section class='zcs-card section'><div class='section-head'><h3>Occupancy</h3><a href='#Report:All_Units'>View units</a></div><div class='zcs-flex zcs-justify-space-between zcs-gap-8'><span class='zcs-font-14'>Occupied active units</span><strong><%=occupancyPct%>%</strong></div><div class='zcs-progress-bar zcs-mt-8'><div class='zcs-progress-bar-indicator' style='width:<%=occupancyPct%>%;'></div></div><div class='rent-split'><div><strong><%=occupiedUnits%></strong><br><span class='zcs-font-12 zcs-color-secondary'>Occupied</span></div><div><strong><%=vacantUnits%></strong><br><span class='zcs-font-12 zcs-color-secondary'>Vacant</span></div><div><strong><%=activeUnits%></strong><br><span class='zcs-font-12 zcs-color-secondary'>Active units</span></div></div></section>
  <section class='zcs-card section'><div class='section-head'><h3>Work-order status</h3><a href='#Report:Work_Order_Board'>Open board</a></div>
   <% for each statusItem in {"New","Assigned","In Progress","On Hold","Resolved","Closed","Cancelled"} { statusCount=0;if(statusItem=="New"){statusCount=newCount;}else if(statusItem=="Assigned"){statusCount=assignedCount;}else if(statusItem=="In Progress"){statusCount=inProgressCount;}else if(statusItem=="On Hold"){statusCount=onHoldCount;}else if(statusItem=="Resolved"){statusCount=resolvedCount;}else if(statusItem=="Closed"){statusCount=closedCount;}else{statusCount=cancelledCount;} statusPct=(statusCount*100.0/maxStatus).round(0); %><div class='status-row'><span><%=statusItem%></span><div class='zcs-progress-bar'><div class='zcs-progress-bar-indicator' style='width:<%=statusPct%>%;'></div></div><strong><%=statusCount%></strong></div><% } %>
  </section>
  <section class='zcs-card section'><div class='section-head'><h3>Outstanding rent summary</h3><a href='#Report:Outstanding_Rent'>View report</a></div><div class='rent-number'>$<%=outstandingAmount.toString("###,##0.00")%></div><p class='zcs-font-13 zcs-color-secondary zcs-mt-8'>Balance across <%=outstandingRows.count()%> unpaid or partially paid obligations.</p><div class='rent-split'><div><strong>$<%=outstandingDue.toString("###,##0.00")%></strong><br><span class='zcs-font-12 zcs-color-secondary'>Amount due</span></div><div><strong>$<%=outstandingPaid.toString("###,##0.00")%></strong><br><span class='zcs-font-12 zcs-color-secondary'>Received</span></div><div><strong><%=Rental_Payments[Payment_Status == "Overdue"].count()%></strong><br><span class='zcs-font-12 zcs-color-secondary'>Overdue items</span></div></div></section>
  <section class='zcs-card section'><div class='section-head'><h3>Upcoming rent activity</h3><a href='#Report:All_Rental_Payments'>All payments</a></div><% if(upcomingPayments.count()==0){ %><div class='empty'><i class='zc-li-outline ui-2-time'></i>No rent dues or reminders in the next 30 days.</div><% }else{ %><ul class='activity'><% for each pay in upcomingPayments { balance=ifnull(pay.Amount_Due,0)-ifnull(pay.Amount_Paid,0); %><li><span class='activity-icon'><i class='zc-li-outline ui-2-time'></i></span><div><strong><%=pay.Tenant.Tenant_Name%></strong><br><span class='zcs-font-12 zcs-color-secondary'><%=pay.Property.Property_Name%> · Due <%=pay.Due_Date.toString("dd-MMM")%> · Reminder <%=pay.Reminder_Date.toString("dd-MMM")%></span></div><span class='zcs-font-13 zcs-font-semibold'>$<%=balance.toString("###,##0.00")%></span></li><% } %></ul><% } %></section>
 </div>
 <section class='zcs-card section' style='margin-top:16px'><div class='section-head'><h3>Recent work orders</h3><a href='#Report:All_Work_Orders'>View all work orders</a></div><% recentCount=Work_Orders[ID != 0].count(); if(recentCount==0){ %><div class='empty'><i class='zc-li-outline ui-2-settings-gear-63'></i>No work orders have been raised yet.</div><% }else{ %><div class='zcs-table-wrapper'><table><thead><tr><th>Work order</th><th>Request</th><th>Property</th><th>Raised</th><th>Priority</th><th>Status</th></tr></thead><tbody><% for each wo in Work_Orders[ID != 0] sort by Raised_On desc range from 0 to 7 { priorityClass="zcs-badge-blue";if(wo.Priority=="Emergency"){priorityClass="zcs-badge-red";}else if(wo.Priority=="High"){priorityClass="zcs-badge-orange";}else if(wo.Priority=="Low"){priorityClass="zcs-badge-grey";} statusClass="zcs-badge-blue";if(wo.Status=="Resolved" || wo.Status=="Closed"){statusClass="zcs-badge-green";}else if(wo.Status=="On Hold"){statusClass="zcs-badge-yellow";}else if(wo.Status=="Cancelled"){statusClass="zcs-badge-grey";} %><tr><td><a href='#Page:Work_Order_Tracking?Work_Order_ID=<%=wo.ID%>'><%=wo.Work_Order_ID%></a></td><td><%=wo.Request_Title%></td><td><%=wo.Property.Property_Name%></td><td><%=wo.Raised_On.toString("dd-MMM-yyyy")%></td><td><span class='zcs-badge <%=priorityClass%>'><%=wo.Priority%></span></td><td><span class='zcs-badge <%=statusClass%>'><%=wo.Status%></span></td></tr><% } %></tbody></table></div><% } %></section>
 <section class='zcs-card quicklinks'><div class='section-head'><h3>Core operations</h3></div><div class='ops-actions'><a class='zcs-button zcs-primary-outline-button' href='#Report:All_Properties'>Properties</a><a class='zcs-button zcs-primary-outline-button' href='#Report:All_Units'>Units</a><a class='zcs-button zcs-primary-outline-button' href='#Report:Active_Leases'>Active leases</a><a class='zcs-button zcs-primary-outline-button' href='#Report:Outstanding_Rent'>Outstanding rent</a><a class='zcs-button zcs-primary-outline-button' href='#Report:Work_Order_Board'>Work-order board</a><a class='zcs-button zcs-primary-button' href='#Form:Rental_Payments'><i class='zc-li-outline ui-1-simple-add'></i>Record payment</a><a class='zcs-button zcs-primary-button' href='#Form:Work_Orders'><i class='zc-li-outline ui-1-simple-add'></i>Add work order</a></div></section>
</div>