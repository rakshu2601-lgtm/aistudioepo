form Units
{
    title
    {
        displayname = "Units"
        on add = "Add Unit"
        on edit = "Edit Unit"
    }
    Unit_Details
    (
        type = section
        displayname = "Unit Details"
        row = 1
        column = 0
    )
    Unit_ID
    (
        type = autonumber
        displayname = "Unit ID"
        start index = 1001
        row = 1
        column = 1
        width = medium
    )
    must have Property
    (
        type = picklist
        displayname = "Property"
        values = Properties.ID
        displayformat = [Property_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Unit_Number
    (
        type = text
        displayname = "Unit Number"
        row = 1
        column = 2
        width = medium
    )
    must have Unit_Type
    (
        type = picklist
        displayname = "Unit Type"
        values = {"Studio","1 Bedroom","2 Bedroom","3 Bedroom","4+ Bedroom","Other"}
        row = 1
        column = 1
        width = medium
    )
    Floor
    (
        type = text
        displayname = "Floor"
        row = 1
        column = 2
        width = medium
    )
    Bedrooms
    (
        type = number
        displayname = "Bedrooms"
        row = 1
        column = 1
        width = medium
    )
    Bathrooms
    (
        type = decimal
        displayname = "Bathrooms"
        decimalplace = 1
        row = 1
        column = 2
        width = medium
    )
    Default_Monthly_Rent
    (
        type = USD
        displayname = "Default Monthly Rent"
        decimalplace = 2
        maxchar = 12
        row = 1
        column = 1
        width = medium
    )
    must have Occupancy_Status
    (
        type = picklist
        displayname = "Occupancy Status"
        values = {"Vacant","Occupied","Unavailable"}
        initial value = "Vacant"
        row = 1
        column = 2
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Unit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Unit"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
