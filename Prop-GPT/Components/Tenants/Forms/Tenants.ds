form Tenants
{
    title
    {
        displayname = "Tenants"
        on add = "Add Tenant"
        on edit = "Edit Tenant"
    }
    Tenant_Details
    (
        type = section
        displayname = "Tenant Details"
        row = 1
        column = 0
    )
    Tenant_ID
    (
        type = autonumber
        displayname = "Tenant ID"
        start index = 1001
        row = 1
        column = 1
        width = medium
    )
    must have Tenant_Name
    (
        type = text
        displayname = "Tenant Name"
        row = 1
        column = 1
        width = medium
    )
    must have Email
    (
        type = email
        displayname = "Email"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    must have unique Phone
    (
        type = text
        displayname = "Phone"
        personal data = true
        description
        [
            type = tooltip
            message = "Enter in E.164 format, for example +12125551234."
        ]
        row = 1
        column = 1
        width = medium
    )
    Alternate_Phone
    (
        type = text
        displayname = "Alternate Phone"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    Emergency_Contact_Name
    (
        type = text
        displayname = "Emergency Contact Name"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    Emergency_Contact_Phone
    (
        type = text
        displayname = "Emergency Contact Phone"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Tenant"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Tenant"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
