form Work_Order_Status_History
{
    title
    {
        displayname = "Work Order Status History"
        on add = "Add Status Event"
        on edit = "Edit Status Event"
    }
    Status_Event
    (
        type = section
        displayname = "Status Event"
        row = 1
        column = 0
    )
    History_ID
    (
        type = autonumber
        displayname = "History ID"
        start index = 10001
        row = 1
        column = 1
        width = medium
    )
    must have Work_Order
    (
        type = picklist
        displayname = "Work Order"
        values = Work_Orders.ID
        displayformat = [Work_Order_ID]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Previous_Status
    (
        type = text
        displayname = "Previous Status"
        row = 1
        column = 2
        width = medium
    )
    must have New_Status
    (
        type = text
        displayname = "New Status"
        row = 1
        column = 1
        width = medium
    )
    must have Changed_At
    (
        type = datetime
        displayname = "Changed At"
        row = 1
        column = 2
        width = medium
    )
    Changed_By
    (
        type = email
        displayname = "Changed By"
        row = 1
        column = 1
        width = medium
    )
    must have Change_Source
    (
        type = picklist
        displayname = "Change Source"
        values = {"Internal","External API","System"}
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Status Event"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Status Event"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
