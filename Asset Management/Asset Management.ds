		list Manager_Approval_Queue
		{
		    displayName = "Manager Approval Queue"
		    show all rows from Asset_Requests [Manager_Email == zoho.loginuser && Request_Status == "Pending Manager Approval"]
		    (
		        Request_Number
		        Requested_By_Email
		        Manager_Email
		        Asset_Category
		        Needed_By
		        Business_Justification
		        Request_Status
		        custom action "Approve Request"
		        (
		            workflow = Approve_Asset_Request
		            show action for each record = true
		            column header = "Approve Request"
		            success message = "Request approved"
		            condition = (Request_Status == "Pending Manager Approval")
		            confirmation before execution
		            (
		                message for individual record = "Approve this asset request?"
		                confirm button text = "Approve"
		                cancel button text = "Cancel"
		            )
		        )
		        custom action "Reject Request"
		        (
		            workflow = Reject_Asset_Request
		            show action for each record = true
		            column header = "Reject Request"
		            success message = "Request rejected"
		            condition = (Request_Status == "Pending Manager Approval")
		            confirmation before execution
		            (
		                message for individual record = "Reject this asset request?"
		                confirm button text = "Reject"
		                cancel button text = "Cancel"
		            )
		        )
		    )
		    sort by
		    (
		        Needed_By ascending
		    )
		}

		default list My_Asset_Requests
		{
		    displayName = "My Asset Requests"
		    show all rows from Asset_Requests [Requested_By_Email == zoho.loginuser]
		    (
		        Request_Number
		        Asset_Category
		        Request_Date
		        Needed_By
		        Request_Status
		        Fulfilled_Asset
		        Manager_Comments
		        custom action "Cancel Request"
		        (
		            workflow = Cancel_Asset_Request
		            show action for each record = true
		            column header = "Cancel Request"
		            success message = "Request cancelled"
		            condition = (Request_Status == "Pending Manager Approval")
		            confirmation before execution
		            (
		                message for individual record = "Cancel this asset request?"
		                confirm button text = "Cancel Request"
		                cancel button text = "Keep Request"
		            )
		        )
		    )
		    sort by
		    (
		        Request_Date descending
		    )
		}

