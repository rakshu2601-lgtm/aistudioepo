	pages
	{
		page Asset_Dashboard
		{
					displayname = "Asset Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Asset_Dashboard_Snippet' elementName='Asset Dashboard'>\n\t\t\t\t\t<![CDATA[htmlpage Asset_Dashboard_Snippet()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t <file name:Asset_Dashboard/Asset_Dashboard.dshtml/>\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page IT_Asset_Dashboard(string CategoryFilter, string StockFilter)
		{
					displayname = "IT Asset Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='ITAssetHeader' elementName='IT Asset Header'>\n\t\t\t\t\t<![CDATA[htmlpage ITAssetHeader()\ncontent\n&lt;%{%&gt;\n\t<file name:IT_Asset_Dashboard/Dashboard.dshtml/>\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='ITAssetKPIs' elementName='IT Asset KPIs'>\n\t\t\t\t\t<![CDATA[htmlpage ITAssetKPIs()\ncontent\n&lt;%{%&gt;\n\t<file name:IT_Asset_Dashboard/KPIs.dshtml/>\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='66%'>\n\t\t\t\t<dsp id='CategoryStockHealth' elementName='Category Stock Health'>\n\t\t\t\t\t<![CDATA[htmlpage CategoryStockHealth()\ncontent\n&lt;%{%&gt;\n\t<file name:IT_Asset_Dashboard/CategoryStockHealth.dshtml/>\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t\t<column width='34%'>\n\t\t\t\t<dsp id='AssetStatusDistribution' elementName='Asset Status Distribution'>\n\t\t\t\t\t<![CDATA[htmlpage AssetStatusDistribution()\ncontent\n&lt;%{%&gt;\n\t<file name:IT_Asset_Dashboard/AssetStatusDistribution.dshtml/>\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='50%'>\n\t\t\t\t<dsp id='RecentStockMovements' elementName='Recent Stock Movements'>\n\t\t\t\t\t<![CDATA[htmlpage RecentStockMovements()\ncontent\n&lt;%{%&gt;\n\t<file name:IT_Asset_Dashboard/RecentStockMovements.dshtml/>\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t\t<column width='50%'>\n\t\t\t\t<dsp id='LowStockAlerts' elementName='Low Stock Alerts'>\n\t\t\t\t\t<![CDATA[htmlpage LowStockAlerts()\ncontent\n&lt;%{%&gt;\n\t<file name:IT_Asset_Dashboard/LowStockAlerts.dshtml/>\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='50%'>\n\t\t\t\t<dsp id='RequestWorkload' elementName='Request Workload'>\n\t\t\t\t\t<![CDATA[htmlpage RequestWorkload()\ncontent\n&lt;%{%&gt;\n\t<file name:IT_Asset_Dashboard/RequestWorkload.dshtml/>\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t\t<column width='50%'>\n\t\t\t\t<dsp id='ComplaintWorkload' elementName='Complaint Workload'>\n\t\t\t\t\t<![CDATA[htmlpage ComplaintWorkload()\ncontent\n&lt;%{%&gt;\n\t<file name:IT_Asset_Dashboard/ComplaintWorkload.dshtml/>\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Alert_Settings_On_Validate as "Validate Alert Settings"
			{
			    type = form
			    form = Alert_Settings
			    record event = on add
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                existingSettings = Alert_Settings[ID != 0];
			                if (existingSettings.count() > 0)
			                {
			                    alert "Only one alert settings record is allowed.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Asset_Assignments_On_Load as "Prepare Asset Assignment Form"
			{
			    type = form
			    form = Asset_Assignments
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                hide Stock_Deducted;
			                hide Stock_Restored;
			                disable Stock_Deducted;
			                disable Stock_Restored;
			                if (input.Status == "Returned")
			                {
			                    show Returned_Date;
			                    show Condition_On_Return;
			                }
			                else
			                {
			                    hide Returned_Date;
			                    hide Condition_On_Return;
			                }
			                if (input.Stock_Deducted == true)
			                {
			                    disable Asset;
			                    disable Employee;
			                    disable Quantity;
			                    disable Assigned_Date;
			                    disable Serial_Number;
			                }
			            )
			        }
			    }
			}

			Asset_Assignments_On_Success as "Process Asset Assignment"
			{
			    type = form
			    form = Asset_Assignments
			    record event = on add or edit
			    description = "Deducts and restores stock exactly once and records each movement in the inventory audit"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                assignmentRecord = Asset_Assignments[ID == input.ID];
			                if (assignmentRecord.count() > 0)
			                {
			                    assetRecord = Assets[ID == assignmentRecord.Asset];
			                    if (assetRecord.count() > 0)
			                    {
			                        movementRequired = false;
			                        quantityChange = 0;
			                        movementAction = "";
			                        sourceType = "Assignment";
			                        if (assignmentRecord.Status == "Assigned" && assignmentRecord.Stock_Deducted == false)
			                        {
			                            movementRequired = true;
			                            quantityChange = 0 - assignmentRecord.Quantity;
			                            movementAction = "Asset Assigned";
			                            assignmentRecord.Stock_Deducted = true;
			                        }
			                        else if (assignmentRecord.Status == "Returned" && assignmentRecord.Stock_Deducted == true && assignmentRecord.Stock_Restored == false)
			                        {
			                            movementRequired = true;
			                            quantityChange = assignmentRecord.Quantity;
			                            movementAction = "Asset Returned";
			                            sourceType = "Return";
			                            assignmentRecord.Stock_Restored = true;
			                        }
			                        if (movementRequired)
			                        {
			                            stockBefore = ifnull(assetRecord.Current_Stock,0);
			                            stockAfter = stockBefore + quantityChange;
			                            assetRecord.Current_Stock = stockAfter;
			                            stockPercent = 0.0;
			                            if (assetRecord.Maximum_Stock > 0)
			                            {
			                                stockPercent = (stockAfter * 100.0) / assetRecord.Maximum_Stock;
			                            }
			                            assetRecord.Stock_Percentage = stockPercent;
			                            if (stockAfter == 0)
			                            {
			                                assetRecord.Stock_Status = "Out of Stock";
			                            }
			                            else if (stockPercent < 10)
			                            {
			                                assetRecord.Stock_Status = "Low Stock";
			                            }
			                            else
			                            {
			                                assetRecord.Stock_Status = "Healthy";
			                            }
			                            if (stockPercent < 10 && assetRecord.Low_Stock_Alert_Sent == false)
			                            {
			                                settingsRecord = Alert_Settings[Notifications_Enabled == true];
			                                if (settingsRecord.count() > 0)
			                                {
			                                    ccList = List();
			                                    if (ifnull(settingsRecord.CC_Recipients,"") != "")
			                                    {
			                                        ccList = settingsRecord.CC_Recipients.toList(",");
			                                    }
			                                    sendmail
			                                    (
			                                        from : zoho.adminuserid
			                                        to : settingsRecord.Primary_Recipient
			                                        cc : ccList
			                                        subject : "Low stock alert: " + assetRecord.Asset_Name
			                                        message : "Asset " + assetRecord.Asset_Name + " (" + assetRecord.Asset_Code + ") is at " + stockAfter + " of " + assetRecord.Maximum_Stock + " units (" + stockPercent.round(2) + "%)."
			                                    )
			                                    assetRecord.Low_Stock_Alert_Sent = true;
			                                    assetRecord.Last_Alerted_At = zoho.currenttime;
			                                }
			                            }
			                            else if (stockPercent >= 10 && assetRecord.Low_Stock_Alert_Sent == true)
			                            {
			                                assetRecord.Low_Stock_Alert_Sent = false;
			                            }
			                            auditID = insert into Inventory_Audit
			                            [
			                                Asset = assetRecord.ID
			                                Source_Type = sourceType
			                                Source_Record_ID = assignmentRecord.ID.toString()
			                                Action = movementAction
			                                Quantity_Change = quantityChange
			                                Stock_Before = stockBefore
			                                Stock_After = stockAfter
			                                Performed_By = zoho.loginuser
			                                Performed_At = zoho.currenttime
			                                Details = ifnull(assignmentRecord.Notes,"")
			                            ];
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Asset_Assignments_On_Validate as "Validate Asset Assignment"
			{
			    type = form
			    form = Asset_Assignments
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (ifnull(input.Quantity,0) <= 0)
			                {
			                    alert "Quantity must be greater than zero.";
			                    cancel submit;
			                }
			                assetRecord = Assets[ID == input.Asset];
			                if (assetRecord.count() == 0)
			                {
			                    alert "The selected asset could not be found.";
			                    cancel submit;
			                }
			                if (assetRecord.Serial_Tracking_Required == true && ifnull(input.Serial_Number,"") == "")
			                {
			                    alert "Serial Number is required for this asset.";
			                    cancel submit;
			                }
			                if (input.ID == null && input.Status == "Assigned" && assetRecord.Current_Stock < input.Quantity)
			                {
			                    alert "There is not enough stock to complete this assignment.";
			                    cancel submit;
			                }
			                if (input.Status == "Returned" && (input.Returned_Date == null || ifnull(input.Condition_On_Return,"") == ""))
			                {
			                    alert "Returned Date and Condition on Return are required.";
			                    cancel submit;
			                }
			                if (input.ID != null)
			                {
			                    existingAssignment = Asset_Assignments[ID == input.ID];
			                    if (existingAssignment.count() > 0 && existingAssignment.Stock_Deducted == true && (existingAssignment.Asset != input.Asset || existingAssignment.Employee != input.Employee || existingAssignment.Quantity != input.Quantity || existingAssignment.Assigned_Date != input.Assigned_Date))
			                    {
			                        alert "Asset, employee, quantity, and assigned date cannot be changed after stock is deducted.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Status_On_User_Input as "Update Return Fields"
			{
			    type = form
			    form = Asset_Assignments
			    record event = on add or edit
			
			    on user input of Status
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Status == "Returned")
			                {
			                    show Returned_Date;
			                    show Condition_On_Return;
			                    enable Returned_Date;
			                    enable Condition_On_Return;
			                }
			                else
			                {
			                    hide Returned_Date;
			                    hide Condition_On_Return;
			                    input.Returned_Date = null;
			                    input.Condition_On_Return = "";
			                }
			            )
			        }
			    }
			}

			Asset_Complaints_On_Load as "Prepare Asset Complaint Form"
			{
			    type = form
			    form = Asset_Complaints
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.ID == null)
			                {
			                    input.Reported_By_Email = zoho.loginuser;
			                    input.Ticket_Status = "Open";
			                }
			                disable Reported_By_Email;
			                disable Resolved_Date_Time;
			                disable Closed_Date_Time;
			                availableAssets = Assets[Active == true].ID.getAll();
			                input.Asset:ui.add(list());
			                if (availableAssets.size() > 0)
			                {
			                    input.Asset:ui.add(availableAssets);
			                }
			            )
			        }
			    }
			}

			Asset_Complaints_On_Success as "Process Asset Complaint"
			{
			    type = form
			    form = Asset_Complaints
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                complaintRecord = Asset_Complaints[ID == input.ID];
			                if (complaintRecord.count() > 0)
			                {
			                    if (input.Ticket_Status == "Resolved" && input.Resolved_Date_Time == null)
			                    {
			                        complaintRecord.Resolved_Date_Time = zoho.currenttime;
			                    }
			                    if (input.Ticket_Status == "Closed" && input.Closed_Date_Time == null)
			                    {
			                        complaintRecord.Closed_Date_Time = zoho.currenttime;
			                    }
			                    if (input.Ticket_Status in {"In Progress", "Resolved", "Closed"})
			                    {
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : input.Reported_By_Email
			                            subject : "Asset complaint #" + input.Complaint_Number + " updated"
			                            message : "Your asset complaint is now " + input.Ticket_Status + ".<br><br>Resolution notes: " + ifnull(input.Resolution_Notes, "Not yet provided")
			                        )
			                    }
			                    if (input.Priority == "Critical" && input.Ticket_Status == "Open")
			                    {
			                        settingsRecord = Alert_Settings[Setting_Name == "Low Stock Notifications" && Notifications_Enabled == true];
			                        if (settingsRecord.count() > 0)
			                        {
			                            sendmail
			                            (
			                                from : zoho.adminuserid
			                                to : settingsRecord.Primary_Recipient
			                                subject : "Critical asset complaint #" + input.Complaint_Number
			                                message : "A critical complaint was raised by " + input.Reported_By_Email + " for asset " + input.Asset + ".<br><br>" + input.Description
			                            )
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Asset_Complaints_On_Validate as "Validate Asset Complaint"
			{
			    type = form
			    form = Asset_Complaints
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                assetRecord = Assets[ID == input.Asset];
			                if (assetRecord.count() == 0)
			                {
			                    alert "The selected asset could not be found.";
			                    cancel submit;
			                }
			                if (input.ID == null && input.Reported_By_Email != zoho.loginuser)
			                {
			                    alert "Reported By Email must match the signed-in user.";
			                    cancel submit;
			                }
			                if (input.Ticket_Status in {"Resolved", "Closed"} && ifnull(input.Resolution_Notes, "") == "")
			                {
			                    alert "Resolution Notes are required before resolving or closing a complaint.";
			                    cancel submit;
			                }
			                if (input.Ticket_Status == "Closed" && input.Resolved_Date_Time == null)
			                {
			                    alert "A complaint must be resolved before it can be closed.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Asset_Requests_On_Add_Validate as "Validate New Asset Request"
			{
			    type = form
			    form = Asset_Requests
			    record event = on add
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Requested_By_Email != zoho.loginuser)
			                {
			                    alert "You can only submit an asset request for your own login.";
			                    cancel submit;
			                }
			                if (input.Request_Status != "Pending Manager Approval")
			                {
			                    alert "New requests must start in Pending Manager Approval status.";
			                    cancel submit;
			                }
			                if (input.Manager_Email == input.Requested_By_Email)
			                {
			                    alert "Manager email must be different from the requester email.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Asset_Requests_On_Edit_Validate as "Protect Asset Request Status"
			{
			    type = form
			    form = Asset_Requests
			    record event = on edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                existingRequest = Asset_Requests[ID == input.ID];
			                if (existingRequest.count() > 0 && existingRequest.Request_Status != input.Request_Status)
			                {
			                    alert "Request status can only be changed through approval, cancellation, or fulfilment actions.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Asset_Requests_On_Load as "Prepare Asset Request Form"
			{
			    type = form
			    form = Asset_Requests
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.ID == null)
			                {
			                    input.Requested_By_Email = zoho.loginuser;
			                    input.Request_Status = "Pending Manager Approval";
			                }
			                disable Requested_By_Email;
			                disable Request_Status;
			                disable Approved_Date;
			                disable Fulfilled_Asset;
			                disable Fulfilled_Date;
			            )
			        }
			    }
			}

			Assets_On_Validate as "Validate Asset Stock"
			{
			    type = form
			    form = Assets
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (ifnull(input.Maximum_Stock,0) <= 0)
			                {
			                    alert "Maximum stock must be greater than zero.";
			                    cancel submit;
			                }
			                if (ifnull(input.Opening_Stock,0) < 0 || input.Opening_Stock > input.Maximum_Stock)
			                {
			                    alert "Opening stock must be between zero and maximum stock.";
			                    cancel submit;
			                }
			                if (input.ID == null)
			                {
			                    input.Current_Stock = input.Opening_Stock;
			                }
			                input.Stock_Percentage = (ifnull(input.Current_Stock,0) * 100.0) / input.Maximum_Stock;
			                if (ifnull(input.Current_Stock,0) == 0)
			                {
			                    input.Stock_Status = "Out of Stock";
			                }
			                else if (input.Stock_Percentage < 10)
			                {
			                    input.Stock_Status = "Low Stock";
			                }
			                else
			                {
			                    input.Stock_Status = "Healthy";
			                }
			            )
			        }
			    }
			}

			Assets_On_Edit_Validate as "Protect System Stock Fields"
			{
			    type = form
			    form = Assets
			    record event = on edit
			    description = "Prevents direct edits to stock balances and alert state"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                existingAsset = Assets[ID == input.ID];
			                if (existingAsset.count() > 0 && (existingAsset.Current_Stock != input.Current_Stock || existingAsset.Stock_Percentage != input.Stock_Percentage || existingAsset.Stock_Status != input.Stock_Status || existingAsset.Low_Stock_Alert_Sent != input.Low_Stock_Alert_Sent || existingAsset.Last_Alerted_At != input.Last_Alerted_At))
			                {
			                    alert "Stock balances and alert fields are maintained by inventory workflows.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Assets_On_Success as "Send Low Stock Alert"
			{
			    type = form
			    form = Assets
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                assetRecord = Assets[ID == input.ID];
			                if (assetRecord.count() > 0)
			                {
			                    if (assetRecord.Stock_Percentage < 10 && assetRecord.Low_Stock_Alert_Sent == false)
			                    {
			                        settingsRecord = Alert_Settings[Notifications_Enabled == true];
			                        if (settingsRecord.count() > 0)
			                        {
			                            ccList = List();
			                            if (ifnull(settingsRecord.CC_Recipients,"") != "")
			                            {
			                                ccList = settingsRecord.CC_Recipients.toList(",");
			                            }
			                            sendmail
			                            (
			                                from : zoho.adminuserid
			                                to : settingsRecord.Primary_Recipient
			                                cc : ccList
			                                subject : "Low stock alert: " + assetRecord.Asset_Name
			                                message : "Asset " + assetRecord.Asset_Name + " (" + assetRecord.Asset_Code + ") is at " + assetRecord.Current_Stock + " of " + assetRecord.Maximum_Stock + " units (" + assetRecord.Stock_Percentage.round(2) + "%)."
			                            )
			                            assetRecord.Low_Stock_Alert_Sent = true;
			                            assetRecord.Last_Alerted_At = zoho.currenttime;
			                        }
			                    }
			                    else if (assetRecord.Stock_Percentage >= 10 && assetRecord.Low_Stock_Alert_Sent == true)
			                    {
			                        assetRecord.Low_Stock_Alert_Sent = false;
			                    }
			                }
			            )
			        }
			    }
			}

			Stock_Transactions_On_Load as "Prepare Stock Transaction Form"
			{
			    type = form
			    form = Stock_Transactions
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Processed;
			                if (input.ID != null && input.Processed == true)
			                {
			                    disable Asset;
			                    disable Transaction_Type;
			                    disable Quantity;
			                    disable Transaction_Date;
			                    disable Vendor;
			                    disable Reference_Number;
			                    disable Unit_Cost;
			                }
			            )
			        }
			    }
			}

			Stock_Transactions_On_Success as "Process Stock Transaction"
			{
			    type = form
			    form = Stock_Transactions
			    record event = on add or edit
			    description = "Posts each stock movement once, recalculates stock health, sends threshold alerts, and writes an audit record"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                transactionRecord = Stock_Transactions[ID == input.ID];
			                if (transactionRecord.count() > 0 && transactionRecord.Processed == false)
			                {
			                    assetRecord = Assets[ID == transactionRecord.Asset];
			                    if (assetRecord.count() > 0)
			                    {
			                        stockBefore = ifnull(assetRecord.Current_Stock,0);
			                        quantityChange = transactionRecord.Quantity;
			                        if (transactionRecord.Transaction_Type in {"Adjustment Decrease", "Retirement"})
			                        {
			                            quantityChange = 0 - transactionRecord.Quantity;
			                        }
			                        stockAfter = stockBefore + quantityChange;
			                        assetRecord.Current_Stock = stockAfter;
			                        stockPercent = 0.0;
			                        if (assetRecord.Maximum_Stock > 0)
			                        {
			                            stockPercent = (stockAfter * 100.0) / assetRecord.Maximum_Stock;
			                        }
			                        assetRecord.Stock_Percentage = stockPercent;
			                        if (stockAfter == 0)
			                        {
			                            assetRecord.Stock_Status = "Out of Stock";
			                        }
			                        else if (stockPercent < 10)
			                        {
			                            assetRecord.Stock_Status = "Low Stock";
			                        }
			                        else
			                        {
			                            assetRecord.Stock_Status = "Healthy";
			                        }
			                        if (stockPercent < 10 && assetRecord.Low_Stock_Alert_Sent == false)
			                        {
			                            settingsRecord = Alert_Settings[Notifications_Enabled == true];
			                            if (settingsRecord.count() > 0)
			                            {
			                                ccList = List();
			                                if (ifnull(settingsRecord.CC_Recipients,"") != "")
			                                {
			                                    ccList = settingsRecord.CC_Recipients.toList(",");
			                                }
			                                sendmail
			                                (
			                                    from : zoho.adminuserid
			                                    to : settingsRecord.Primary_Recipient
			                                    cc : ccList
			                                    subject : "Low stock alert: " + assetRecord.Asset_Name
			                                    message : "Asset " + assetRecord.Asset_Name + " (" + assetRecord.Asset_Code + ") is at " + stockAfter + " of " + assetRecord.Maximum_Stock + " units (" + stockPercent.round(2) + "%)."
			                                )
			                                assetRecord.Low_Stock_Alert_Sent = true;
			                                assetRecord.Last_Alerted_At = zoho.currenttime;
			                            }
			                        }
			                        else if (stockPercent >= 10 && assetRecord.Low_Stock_Alert_Sent == true)
			                        {
			                            assetRecord.Low_Stock_Alert_Sent = false;
			                        }
			                        transactionRecord.Processed = true;
			                        auditID = insert into Inventory_Audit
			                        [
			                            Asset = assetRecord.ID
			                            Source_Type = "Stock Transaction"
			                            Source_Record_ID = transactionRecord.ID.toString()
			                            Action = transactionRecord.Transaction_Type
			                            Quantity_Change = quantityChange
			                            Stock_Before = stockBefore
			                            Stock_After = stockAfter
			                            Performed_By = zoho.loginuser
			                            Performed_At = zoho.currenttime
			                            Details = ifnull(transactionRecord.Notes,"")
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

			Stock_Transactions_On_Validate as "Validate Stock Transaction"
			{
			    type = form
			    form = Stock_Transactions
			    record event = on add or edit
			    description = "Validates quantity movements and prevents processed transactions from being changed"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (ifnull(input.Quantity,0) <= 0)
			                {
			                    alert "Quantity must be greater than zero.";
			                    cancel submit;
			                }
			                if (input.Transaction_Type == "Receipt" && input.Vendor == null)
			                {
			                    alert "Vendor is required for a receipt.";
			                    cancel submit;
			                }
			                assetRecord = Assets[ID == input.Asset];
			                if (assetRecord.count() == 0)
			                {
			                    alert "The selected asset could not be found.";
			                    cancel submit;
			                }
			                if (input.Transaction_Type in {"Adjustment Decrease", "Retirement"} && assetRecord.Current_Stock < input.Quantity)
			                {
			                    alert "There is not enough stock for this transaction.";
			                    cancel submit;
			                }
			                if (input.ID != null)
			                {
			                    existingTransaction = Stock_Transactions[ID == input.ID];
			                    if (existingTransaction.count() > 0 && existingTransaction.Processed == true && (existingTransaction.Asset != input.Asset || existingTransaction.Transaction_Type != input.Transaction_Type || existingTransaction.Quantity != input.Quantity))
			                    {
			                        alert "Asset, transaction type, and quantity cannot be changed after processing.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Transaction_Type_On_User_Input as "Update Transaction Fields"
			{
			    type = form
			    form = Stock_Transactions
			    record event = on add or edit
			
			    on user input of Transaction_Type
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Transaction_Type == "Receipt")
			                {
			                    show Vendor;
			                    enable Vendor;
			                }
			                else
			                {
			                    hide Vendor;
			                    input.Vendor = null;
			                }
			            )
			        }
			    }
			}
		}

		functions
		{
			Approve_Asset_Request as "Approve Asset Request"
			{
			    type = functions
			    form = Asset_Requests
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                if (input.Manager_Email != zoho.loginuser || input.Request_Status != "Pending Manager Approval")
			                {
			                    info "You are not authorized to approve this request.";
			                }
			                else
			                {
			                    input.Request_Status = "Approved";
			                    input.Approved_Date = zoho.currenttime;
			                    recipients = "";
			                    settingsRecord = Alert_Settings[Setting_Name == "Low Stock Notifications" && Notifications_Enabled == true];
			                    if (settingsRecord.count() > 0)
			                    {
			                        recipients = settingsRecord.CC_Recipients;
			                    }
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : input.Requested_By_Email
			                        cc : recipients
			                        subject : "Asset request approved"
			                        message : "Your asset request #" + input.Request_Number + " has been approved and is ready for inventory fulfilment."
			                    )
			                }
			            )
			        }
			    }
			}

			Cancel_Asset_Request as "Cancel Asset Request"
			{
			    type = functions
			    form = Asset_Requests
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                if (input.Requested_By_Email != zoho.loginuser || input.Request_Status != "Pending Manager Approval")
			                {
			                    info "Only the requester can cancel a pending request.";
			                }
			                else
			                {
			                    input.Request_Status = "Cancelled";
			                }
			            )
			        }
			    }
			}

			Reject_Asset_Request as "Reject Asset Request"
			{
			    type = functions
			    form = Asset_Requests
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                if (input.Manager_Email != zoho.loginuser || input.Request_Status != "Pending Manager Approval")
			                {
			                    info "You are not authorized to reject this request.";
			                }
			                else
			                {
			                    input.Request_Status = "Rejected";
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : input.Requested_By_Email
			                        subject : "Asset request rejected"
			                        message : "Your asset request #" + input.Request_Number + " has been rejected by your manager."
			                    )
			                }
			            )
			        }
			    }
			}
		}
	}

