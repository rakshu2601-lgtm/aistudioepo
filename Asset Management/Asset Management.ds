application "Asset-Management"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Alert_Settings
		{
		    title
		    {
		        displayname = "Alert Settings"
		        on add = "Configure Low Stock Alerts"
		        on edit = "Edit Low Stock Alerts"
		    }
		    success message = "Alert settings saved successfully."
		    Notification_Settings
		    (
		        type = section
		        displayname = "Notification Settings"
		        row = 1
		        column = 0
		    )
		    must have unique Setting_Name
		    (
		        type = text
		        displayname = "Setting Name"
		        initial value = "Low Stock Notifications"
		        maxchar = 100
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Primary_Recipient
		    (
		        type = email
		        displayname = "Primary Recipient"
		        row = 1
		        column = 1
		        width = medium
		    )
		    CC_Recipients
		    (
		        type = textarea
		        displayname = "CC Recipients"
		        description
		        [
		            type = tooltip
		            message = "Optional comma-separated email addresses"
		        ]
		        height = 80px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Notifications_Enabled
		    (
		        type = checkbox
		        displayname = "Notifications Enabled"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Settings"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Settings"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Asset_Assignments
		{
		    title
		    {
		        displayname = "Asset Assignments"
		        on add = "Assign Asset"
		        on edit = "Update Asset Assignment"
		    }
		    success message = "Asset assignment saved successfully"
		    Assignment_Details
		    (
		        type = section
		        displayname = "Assignment Details"
		        row = 1
		        column = 0
		    )
		    Assignment_Number
		    (
		        type = autonumber
		        displayname = "Assignment Number"
		        start index = 1001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Asset
		    (
		        type = picklist
		        values = Assets.ID
		        displayformat = [Asset_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Employee
		    (
		        type = picklist
		        values = Employees.ID
		        displayformat = [Employee_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Quantity
		    (
		        type = number
		        initial value = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Assigned_Date
		    (
		        type = date
		        displayname = "Assigned Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Expected_Return_Date
		    (
		        type = date
		        displayname = "Expected Return Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        values = {"Assigned", "Returned", "Lost"}
		        initial value = "Assigned"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Serial_Number
		    (
		        type = text
		        displayname = "Serial Number"
		        maxchar = 150
		        row = 1
		        column = 1
		        width = medium
		    )
		    Returned_Date
		    (
		        type = date
		        displayname = "Returned Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Condition_On_Return
		    (
		        type = picklist
		        displayname = "Condition on Return"
		        values = {"Good", "Damaged", "Unusable"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Stock_Deducted
		    (
		        type = checkbox
		        displayname = "Stock Deducted"
		        initial value = false
		        row = 1
		        column = 1
		        width = medium
		    )
		    Stock_Restored
		    (
		        type = checkbox
		        displayname = "Stock Restored"
		        initial value = false
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Assign Asset"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Assignment"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Asset_Categories
		{
		    title
		    {
		        displayname = "Asset Categories"
		        on add = "Add Asset Category"
		        on edit = "Edit Asset Category"
		    }
		    success message = "Asset category saved successfully."
		    Category_Details
		    (
		        type = section
		        displayname = "Category Details"
		        row = 1
		        column = 0
		    )
		    must have unique Category_Name
		    (
		        type = text
		        displayname = "Category Name"
		        maxchar = 100
		        row = 1
		        column = 1
		        width = medium
		    )
		    Description
		    (
		        type = textarea
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Asset_Complaints
		{
		    title
		    {
		        displayname = "Asset Complaints"
		        on add = "Raise Asset Complaint"
		        on edit = "Update Asset Complaint"
		    }
		    success message = "Asset complaint saved successfully"
		    Complaint_Details
		    (
		        type = section
		        displayname = "Complaint Details"
		        row = 1
		        column = 0
		    )
		    Complaint_Number
		    (
		        type = autonumber
		        displayname = "Complaint Number"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Reported_By_Email
		    (
		        type = email
		        displayname = "Reported By Email"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Asset
		    (
		        type = picklist
		        values = Assets.ID
		        displayformat = [Asset_Code + " - " + Asset_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Subject
		    (
		        type = text
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Description
		    (
		        type = textarea
		        height = 120px
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Priority
		    (
		        type = picklist
		        values = {"Low", "Medium", "High", "Critical"}
		        initial value = "Medium"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Reported_Date_Time
		    (
		        type = datetime
		        displayname = "Reported Date & Time"
		        initial value = "${zoho.currenttime}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Resolution
		    (
		        type = section
		        displayname = "Resolution"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Ticket_Status
		    (
		        type = picklist
		        displayname = "Ticket Status"
		        values = {"Open", "In Progress", "Resolved", "Closed"}
		        initial value = "Open"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Assigned_Inventory_Email
		    (
		        type = email
		        displayname = "Assigned Inventory Email"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Resolution_Notes
		    (
		        type = textarea
		        displayname = "Resolution Notes"
		        height = 120px
		        row = 2
		        column = 1
		        width = medium
		    )
		    Resolved_Date_Time
		    (
		        type = datetime
		        displayname = "Resolved Date & Time"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Closed_Date_Time
		    (
		        type = datetime
		        displayname = "Closed Date & Time"
		        row = 2
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit Complaint"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Complaint"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Asset_Requests
		{
		    title
		    {
		        displayname = "Asset Requests"
		        on add = "Request an Asset"
		        on edit = "Edit Asset Request"
		    }
		    success message = "Asset request submitted successfully"
		    Request_Details
		    (
		        type = section
		        displayname = "Request Details"
		        row = 1
		        column = 0
		    )
		    Request_Number
		    (
		        type = autonumber
		        displayname = "Request Number"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Requested_By_Email
		    (
		        type = email
		        displayname = "Requested By Email"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Manager_Email
		    (
		        type = email
		        displayname = "Manager Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Asset_Category
		    (
		        type = picklist
		        displayname = "Asset Category"
		        values = Asset_Categories[Active == true].ID
		        displayformat = [Category_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Business_Justification
		    (
		        type = textarea
		        displayname = "Business Justification"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Needed_By
		    (
		        type = date
		        displayname = "Needed By"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Request_Date
		    (
		        type = date
		        displayname = "Request Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Processing
		    (
		        type = section
		        displayname = "Processing"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Request_Status
		    (
		        type = picklist
		        displayname = "Request Status"
		        values = {"Pending Manager Approval", "Approved", "Rejected", "Fulfilled", "Cancelled"}
		        initial value = "Pending Manager Approval"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Manager_Comments
		    (
		        type = textarea
		        displayname = "Manager Comments"
		        height = 100px
		        row = 2
		        column = 2
		        width = medium
		    )
		    Approved_Date
		    (
		        type = datetime
		        displayname = "Approved Date"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Fulfilled_Asset
		    (
		        type = picklist
		        displayname = "Fulfilled Asset"
		        values = Assets.ID
		        displayformat = [Asset_Code + " - " + Asset_Name]
		        searchable = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    Fulfilled_Date
		    (
		        type = datetime
		        displayname = "Fulfilled Date"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Inventory_Notes
		    (
		        type = textarea
		        displayname = "Inventory Notes"
		        height = 100px
		        row = 2
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit Request"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Request"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Assets
		{
		    title
		    {
		        on add = "Add Asset"
		        on edit = "Edit Asset"
		    }
		    success message = "Asset saved successfully."
		    Asset_Details
		    (
		        type = section
		        displayname = "Asset Details"
		        row = 1
		        column = 0
		    )
		    must have unique Asset_Code
		    (
		        type = text
		        displayname = "Asset Code"
		        maxchar = 50
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Asset_Name
		    (
		        type = text
		        displayname = "Asset Name"
		        maxchar = 150
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Category
		    (
		        type = picklist
		        values = Asset_Categories.ID
		        displayformat = [Category_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Manufacturer
		    (
		        type = text
		        maxchar = 100
		        row = 1
		        column = 2
		        width = medium
		    )
		    Model
		    (
		        type = text
		        maxchar = 100
		        row = 1
		        column = 1
		        width = medium
		    )
		    Serial_Tracking_Required
		    (
		        type = checkbox
		        displayname = "Serial Tracking Required"
		        initial value = false
		        row = 1
		        column = 2
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Stock_Levels
		    (
		        type = section
		        displayname = "Stock Levels"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Maximum_Stock
		    (
		        type = number
		        displayname = "Maximum Stock"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Opening_Stock
		    (
		        type = number
		        displayname = "Opening Stock"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Current_Stock
		    (
		        type = number
		        displayname = "Current Stock"
		        initial value = 0
		        row = 2
		        column = 1
		        width = medium
		    )
		    Stock_Percentage
		    (
		        type = decimal
		        displayname = "Stock Percentage"
		        decimalplace = 2
		        initial value = 0
		        row = 2
		        column = 2
		        width = medium
		    )
		    Stock_Status
		    (
		        type = picklist
		        displayname = "Stock Status"
		        values = {"Healthy", "Low Stock", "Out of Stock"}
		        initial value = "Healthy"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Low_Stock_Alert_Sent
		    (
		        type = checkbox
		        displayname = "Low Stock Alert Sent"
		        initial value = false
		        row = 2
		        column = 2
		        width = medium
		    )
		    Last_Alerted_At
		    (
		        type = datetime
		        displayname = "Last Alerted At"
		        row = 2
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Employees
		{
		    title
		    {
		        on add = "Add Employee"
		        on edit = "Edit Employee"
		    }
		    success message = "Employee saved successfully."
		    Employee_Details
		    (
		        type = section
		        displayname = "Employee Details"
		        row = 1
		        column = 0
		    )
		    must have unique Employee_ID
		    (
		        type = text
		        displayname = "Employee ID"
		        maxchar = 50
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Employee_Name
		    (
		        type = text
		        displayname = "Employee Name"
		        maxchar = 150
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Email
		    (
		        type = email
		        row = 1
		        column = 1
		        width = medium
		    )
		    Department
		    (
		        type = text
		        maxchar = 100
		        row = 1
		        column = 1
		        width = medium
		    )
		    Location
		    (
		        type = text
		        maxchar = 100
		        row = 1
		        column = 1
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Inventory_Audit
		{
		    title
		    {
		        displayname = "Inventory Audit"
		        on add = "Add Inventory Audit"
		        on edit = "Edit Inventory Audit"
		    }
		    success message = "Inventory audit saved"
		    Audit_Details
		    (
		        type = section
		        displayname = "Audit Details"
		        row = 1
		        column = 0
		    )
		    must have Asset
		    (
		        type = picklist
		        values = Assets.ID
		        displayformat = [Asset_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Source_Type
		    (
		        type = picklist
		        displayname = "Source Type"
		        values = {"Asset Opening", "Stock Transaction", "Assignment", "Return"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Source_Record_ID
		    (
		        type = text
		        displayname = "Source Record ID"
		        maxchar = 50
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Action
		    (
		        type = text
		        maxchar = 100
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Quantity_Change
		    (
		        type = number
		        displayname = "Quantity Change"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Stock_Before
		    (
		        type = number
		        displayname = "Stock Before"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Stock_After
		    (
		        type = number
		        displayname = "Stock After"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Performed_By
		    (
		        type = email
		        displayname = "Performed By"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Performed_At
		    (
		        type = datetime
		        displayname = "Performed At"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Details
		    (
		        type = textarea
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Stock_Transactions
		{
		    title
		    {
		        displayname = "Stock Transactions"
		        on add = "Record Stock Transaction"
		        on edit = "Edit Stock Transaction"
		    }
		    success message = "Stock transaction saved successfully"
		    Transaction_Details
		    (
		        type = section
		        displayname = "Transaction Details"
		        row = 1
		        column = 0
		    )
		    Transaction_Number
		    (
		        type = autonumber
		        displayname = "Transaction Number"
		        start index = 1001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Asset
		    (
		        type = picklist
		        values = Assets.ID
		        displayformat = [Asset_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Transaction_Type
		    (
		        type = picklist
		        displayname = "Transaction Type"
		        values = {"Receipt", "Adjustment Increase", "Adjustment Decrease", "Retirement"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Quantity
		    (
		        type = number
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Transaction_Date
		    (
		        type = date
		        displayname = "Transaction Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Vendor
		    (
		        type = picklist
		        values = Vendors.ID
		        displayformat = [Vendor_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Reference_Number
		    (
		        type = text
		        displayname = "Reference Number"
		        maxchar = 100
		        row = 1
		        column = 2
		        width = medium
		    )
		    Unit_Cost
		    (
		        type = decimal
		        displayname = "Unit Cost"
		        decimalplace = 2
		        row = 1
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Processed
		    (
		        type = checkbox
		        initial value = false
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Record Transaction"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Transaction"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

