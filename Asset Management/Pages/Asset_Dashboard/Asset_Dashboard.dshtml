<%
activeTypes = Assets[Active == true].count();
totalOnHand = 0;
for each a in Assets[Active == true]
{
  totalOnHand = totalOnHand + ifnull(a.Current_Stock,0);
}
assignedUnits = 0;
for each asn in Asset_Assignments[Status == "Assigned"]
{
  assignedUnits = assignedUnits + ifnull(asn.Quantity,0);
}
lowStockCount = Assets[Active == true && Maximum_Stock > 0 && Stock_Percentage < 10].count();
outCount = Assets[Active == true && Current_Stock <= 0].count();
lowOnlyCount = Assets[Active == true && Current_Stock > 0 && Maximum_Stock > 0 && Stock_Percentage < 10].count();
healthyCount = activeTypes - outCount - lowOnlyCount;
if(healthyCount < 0) { healthyCount = 0; }
healthTotal = healthyCount + lowOnlyCount + outCount;
healthyPct = 0;
lowPct = 0;
outPct = 0;
if(healthTotal > 0)
{
  healthyPct = (healthyCount * 100.0 / healthTotal).round(1);
  lowPct = (lowOnlyCount * 100.0 / healthTotal).round(1);
  outPct = (100.0 - healthyPct - lowPct).round(1);
}
assignedCount = Asset_Assignments[Status == "Assigned"].count();
returnedCount = Asset_Assignments[Status == "Returned"].count();
lostCount = Asset_Assignments[Status == "Lost"].count();
assignmentTotal = assignedCount + returnedCount + lostCount;
assignmentMax = assignedCount;
if(returnedCount > assignmentMax) { assignmentMax = returnedCount; }
if(lostCount > assignmentMax) { assignmentMax = lostCount; }
if(assignmentMax <= 0) { assignmentMax = 1; }
movementMax = 0;
for each txMax in Stock_Transactions[Transaction_Date >= zoho.currentdate.subDay(6)]
{
  movementMax = movementMax + ifnull(txMax.Quantity,0);
}
if(movementMax <= 0) { movementMax = 1; }
recentAssignmentCount = Asset_Assignments[ID != 0].count();
%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-page-bg-color:#f3f3f4}.zcs-flex{display:flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-end{align-items:flex-end}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-gap-20{gap:20px}.zcs-p-0{padding:0}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-p-24{padding:24px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-full{border-radius:100%}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.zcs-list-none{list-style:none}a{text-decoration:none}
*{box-sizing:border-box}.asset-dashboard{font-family:Arial,sans-serif;background:var(--zcs-page-bg-color);padding:24px;color:var(--zcs-primary-text-color)}.dashboard-header{margin-bottom:20px}.dashboard-header h1{font-size:24px;margin:0 0 4px}.dashboard-header p{margin:0;color:var(--zcs-tertiary-text-color)}.dashboard-header .stamp{font-size:13px;color:var(--zcs-tertiary-text-color)}.kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:20px}.kpi{padding:18px;display:flex;gap:14px;align-items:center}.kpi-icon{width:44px;height:44px;display:flex;align-items:center;justify-content:center;border-radius:10px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);font-size:22px}.kpi.low .kpi-icon{background:#fde7e9;color:#d72f4b}.kpi-value{font-size:26px;font-weight:600;line-height:1.1}.kpi-label{font-size:13px;color:var(--zcs-tertiary-text-color);margin-top:5px}.dashboard-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:20px}.span-4{grid-column:span 4}.span-5{grid-column:span 5}.span-7{grid-column:span 7}.span-8{grid-column:span 8}.span-12{grid-column:span 12}.section-card{padding:20px;min-height:280px}.section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}.section-head h2{font-size:18px;margin:0}.section-head a{font-size:13px;color:var(--zcs_brand_color)}.empty{padding:40px 12px;text-align:center;color:var(--zcs-tertiary-text-color)}.category-bars{display:flex;flex-direction:column;gap:14px}.category-row{display:grid;grid-template-columns:minmax(100px,1.2fr) 3fr 55px;gap:10px;align-items:center;font-size:13px}.track{height:10px;background:var(--zcs_component_hover_color);border-radius:6px;overflow:hidden}.fill{height:100%;background:var(--zcs_brand_color);border-radius:inherit;min-width:2px}.donut-wrap{display:flex;align-items:center;justify-content:center;gap:24px;min-height:205px}.zcs-donut-chart{width:170px;height:170px;border-radius:50%;background:conic-gradient(#179e6c 0 <%=healthyPct%>%,#e2a12d <%=healthyPct%>% <%=healthyPct + lowPct%>%,#fe455d <%=healthyPct + lowPct%>% 100%);position:relative}.zcs-donut-chart:after{content:'';position:absolute;inset:28px;background:var(--zcs-white-color);border-radius:50%}.donut-center{position:absolute;z-index:1;text-align:center}.donut-center strong{display:block;font-size:24px}.legend{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:12px;font-size:13px}.legend i{width:10px;height:10px;border-radius:50%;display:inline-block;margin-right:8px}.trend{height:205px;display:flex;align-items:flex-end;gap:10px;border-bottom:1px solid var(--zcs_tertiary_border_color);padding:8px 6px 0}.trend-col{flex:1;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:7px}.trend-bar{width:70%;min-height:2px;border-radius:6px 6px 0 0;background:linear-gradient(var(--zcs_brand_color),var(--zcs_brand_light_color))}.trend-label{font-size:11px;color:var(--zcs-tertiary-text-color);white-space:nowrap}.status-bars{display:flex;flex-direction:column;gap:20px;padding-top:12px}.status-row{display:grid;grid-template-columns:85px 1fr 40px;gap:10px;align-items:center;font-size:13px}.status-row .fill.returned{background:#179e6c}.status-row .fill.overdue{background:#fe455d}.warning-card{border-color:#efc0c8}.warning-banner{display:flex;gap:10px;align-items:center;padding:12px 14px;background:#fff1f3;color:#9f1730;border-radius:8px;margin-bottom:14px}.zcs-table-wrapper{overflow:auto;border:1px solid var(--zcs_tertiary_border_color);border-radius:6px}.zcs-table-wrapper table{width:100%;border-collapse:collapse}.zcs-table-wrapper th{background:#f9fafe;font-weight:500;white-space:nowrap}.zcs-table-wrapper th,.zcs-table-wrapper td{padding:10px 14px;border-top:1px solid var(--zcs_tertiary_border_color);font-size:13px}.zcs-table-wrapper thead th{border-top:0}.severity{display:inline-flex;padding:3px 9px;border-radius:12px;font-size:12px;font-weight:600}.severity.critical{background:#fde3e6;color:#b51f39}.severity.warning{background:#fcf4e6;color:#8a5708}.stock-progress{height:6px;background:#f1f1f5;border-radius:4px;margin-top:5px;overflow:hidden}.stock-progress span{display:block;height:100%;background:#fe455d}.zcs-timeline-wrapper ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:20px}.zcs-tl-li{position:relative;padding-left:36px}.zcs-tl-dot{position:absolute;left:6px;top:3px;width:12px;height:12px;background:var(--zcs_brand_color);border:2px solid #fff;box-shadow:0 0 0 2px var(--zcs_brand_light_color);border-radius:50%}.zcs-tl-li:not(:last-child):after{content:'';position:absolute;left:11px;top:17px;width:1px;height:calc(100% + 12px);background:var(--zcs_tertiary_border_color)}.activity-title{font-size:14px;font-weight:600}.activity-meta{font-size:12px;color:var(--zcs-tertiary-text-color);margin-top:4px}.report-links{display:flex;gap:12px;flex-wrap:wrap}.report-links a{display:inline-flex;align-items:center;gap:6px;padding:7px 12px;border:1px solid var(--zcs_brand_color);border-radius:6px;color:var(--zcs_brand_color)}@media(max-width:1000px){.kpi-grid{grid-template-columns:repeat(2,1fr)}.span-4,.span-5,.span-7,.span-8{grid-column:span 12}}@media(max-width:600px){.asset-dashboard{padding:14px}.kpi-grid{grid-template-columns:1fr}.donut-wrap{flex-direction:column}.category-row{grid-template-columns:90px 1fr 45px}}
</style>
<div class='asset-dashboard'>
  <div class='dashboard-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
    <div><h1>Asset Stock Control</h1><p>Inventory levels, assignment coverage, and operational movement</p></div>
    <div class='stamp'><i class='zc-li-outline ui-2-time'></i> Updated <%=zoho.currenttime%></div>
  </div>
  <div class='kpi-grid'>
    <div class='kpi zcs-card'><div class='kpi-icon'><i class='zc-li-outline objects-puzzle-09'></i></div><div><div class='kpi-value'><%=activeTypes%></div><div class='kpi-label'>Active asset types</div></div></div>
    <div class='kpi zcs-card'><div class='kpi-icon'><i class='zc-li-outline business-stock'></i></div><div><div class='kpi-value'><%=totalOnHand%></div><div class='kpi-label'>Units on hand</div></div></div>
    <div class='kpi zcs-card'><div class='kpi-icon'><i class='zc-li-outline users-single-05'></i></div><div><div class='kpi-value'><%=assignedUnits%></div><div class='kpi-label'>Currently assigned units</div></div></div>
    <div class='kpi zcs-card low'><div class='kpi-icon'><i class='zc-li-outline travel-info'></i></div><div><div class='kpi-value'><%=lowStockCount%></div><div class='kpi-label'>Asset types below 10%</div></div></div>
  </div>
  <div class='dashboard-grid'>
    <section class='section-card zcs-card span-7'><div class='section-head'><h2>Category distribution</h2><span class='zcs-font-12 zcs-color-tertiary'>Units on hand</span></div><div class='category-bars'>
    <% if(activeTypes == 0) { %><div class='empty'>No active asset types are available.</div><% } else { for each cat in Asset_Categories[Active == true] sort by Category_Name asc { catUnits = 0; for each ca in Assets[Active == true && Category == cat.ID] { catUnits = catUnits + ifnull(ca.Current_Stock,0); } catPct = 0; if(totalOnHand > 0) { catPct = (catUnits * 100.0 / totalOnHand).round(1); } %><div class='category-row'><span><%=ifnull(cat.Category_Name,"Uncategorized")%></span><div class='track'><div class='fill' style='width:<%=catPct%>%'></div></div><strong><%=catUnits%></strong></div><% }} %>
    </div></section>
    <section class='section-card zcs-card span-5'><div class='section-head'><h2>Stock health</h2></div><div class='donut-wrap'><div class='zcs-donut-chart zcs-flex zcs-align-items-center zcs-justify-center'><div class='donut-center'><strong><%=healthTotal%></strong><span class='zcs-font-12 zcs-color-tertiary'>asset types</span></div></div><ul class='legend'><li><i style='background:#179e6c'></i>Healthy: <strong><%=healthyCount%></strong></li><li><i style='background:#e2a12d'></i>Low Stock: <strong><%=lowOnlyCount%></strong></li><li><i style='background:#fe455d'></i>Out of Stock: <strong><%=outCount%></strong></li></ul></div></section>
    <section class='section-card zcs-card span-8'><div class='section-head'><h2>Recent stock movement trend</h2><a href='#Report:All_Stock_Transactions'>View transactions</a></div><div class='trend'>
    <% for each dayOffset in {6,5,4,3,2,1,0} { trendDate = zoho.currentdate.subDay(dayOffset); dayQty = 0; for each tx in Stock_Transactions[Transaction_Date == trendDate] { dayQty = dayQty + ifnull(tx.Quantity,0); } dayHeight = (dayQty * 100.0 / movementMax).round(1); %><div class='trend-col'><strong class='zcs-font-12'><%=dayQty%></strong><div class='trend-bar' style='height:<%=dayHeight%>%'></div><span class='trend-label'><%=trendDate.toString("dd MMM")%></span></div><% } %>
    </div></section>
    <section class='section-card zcs-card span-4'><div class='section-head'><h2>Assignment status</h2></div><div class='status-bars'><div class='status-row'><span>Assigned</span><div class='track'><div class='fill' style='width:<%=(assignedCount * 100.0 / assignmentMax).round(1)%>%'></div></div><strong><%=assignedCount%></strong></div><div class='status-row'><span>Returned</span><div class='track'><div class='fill returned' style='width:<%=(returnedCount * 100.0 / assignmentMax).round(1)%>%'></div></div><strong><%=returnedCount%></strong></div><div class='status-row'><span>Lost</span><div class='track'><div class='fill overdue' style='width:<%=(lostCount * 100.0 / assignmentMax).round(1)%>%'></div></div><strong><%=lostCount%></strong></div><div class='zcs-font-12 zcs-color-tertiary'><%=assignmentTotal%> tracked assignment records</div></div></section>
    <section class='section-card zcs-card warning-card span-12'><div class='section-head'><h2>Low-stock warning queue</h2><a href='#Report:All_Assets'>Open asset report</a></div><div class='warning-banner'><i class='zc-li-outline travel-info'></i><span><strong><%=lowStockCount%> asset types require attention.</strong> Every active asset below 10% is listed.</span></div>
      <% if(lowStockCount == 0) { %><div class='empty'><i class='zc-li-outline ui-1-check-circle-08'></i> All active asset types are at or above the warning threshold.</div><% } else { %><div class='zcs-table-wrapper'><table><thead><tr><th class='zcs-text-left'>Asset</th><th class='zcs-text-left'>Category</th><th class='zcs-text-right'>Current quantity</th><th class='zcs-text-right'>Maximum quantity</th><th class='zcs-text-right'>Exact percentage</th><th class='zcs-text-left'>Severity</th></tr></thead><tbody><% for each low in Assets[Active == true && Maximum_Stock > 0 && Stock_Percentage < 10] sort by Stock_Percentage asc { pct = ifnull(low.Stock_Percentage,0).round(2); severity = "Warning"; sevClass = "warning"; if(pct <= 5) { severity = "Critical"; sevClass = "critical"; } categoryName = "Uncategorized"; if(low.Category != null) { categoryName = ifnull(low.Category.Category_Name,"Uncategorized"); } %><tr><td><strong><%=ifnull(low.Asset_Name,"Unnamed asset")%></strong><div class='stock-progress'><span style='width:<%=pct%>%'></span></div></td><td><%=categoryName%></td><td class='zcs-text-right'><%=ifnull(low.Current_Stock,0)%></td><td class='zcs-text-right'><%=ifnull(low.Maximum_Stock,0)%></td><td class='zcs-text-right'><strong><%=pct%>%</strong></td><td><span class='severity <%=sevClass%>'><%=severity%></span></td></tr><% } %></tbody></table></div><% } %>
    </section>
    <section class='section-card zcs-card span-12'><div class='section-head'><h2>Recent assignment and return activity</h2><div class='report-links'><a href='#Report:All_Assets'><i class='zc-li-outline tech-computer-monitor'></i> Asset report</a><a href='#Report:All_Stock_Transactions'><i class='zc-li-outline tech-sync'></i> Stock activity</a></div></div><div class='zcs-timeline-wrapper'><ul>
      <% if(recentAssignmentCount == 0) { %><li class='empty'>No assignment or return activity has been recorded.</li><% } else { for each activity in Asset_Assignments[ID != 0] sort by Modified_Time desc range from 0 to 7 { activityAsset = "Asset"; if(activity.Asset != null) { activityAsset = ifnull(activity.Asset.Asset_Name,"Asset"); } activityEmployee = "Employee"; if(activity.Employee != null) { activityEmployee = ifnull(activity.Employee.Employee_Name,"Employee"); } activityDate = activity.Assigned_Date; if(activity.Status == "Returned" && activity.Returned_Date != null) { activityDate = activity.Returned_Date; } %><li class='zcs-tl-li'><span class='zcs-tl-dot'></span><div class='activity-title'><%=ifnull(activity.Status,"Updated")%>: <%=activityAsset%></div><div class='activity-meta'><%=activityEmployee%> · <%=ifnull(activity.Quantity,0)%> unit(s) · <%=ifnull(activityDate,"")%></div></li><% }} %>
    </ul></div></section>
  </div>
</div>