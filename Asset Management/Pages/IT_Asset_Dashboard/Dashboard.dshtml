<style>
/* ZCS global utilities are included once on this page by this first snippet. */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff}.zcs-flex{display:flex}.zcs-align-items-center{align-items:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-medium{font-weight:500}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-m-0{margin:0}.zcs-rounded-md{border-radius:.375rem}.zcs-box-border{box-sizing:border-box}.zcs-w-full{width:100%}.zcs-button{min-height:36px;text-decoration:none}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-page-header{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;flex-wrap:wrap}.zcs-header-actions{flex-wrap:wrap}.zcs-page-subtitle{margin-top:4px}.zcs-button:hover{background:var(--zcs_component_hover_color)}
</style>
<div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-16 zcs-py-24 zcs-box-border'>
  <div><h1 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>IT Asset Inventory Command Center</h1><p class='zcs-page-subtitle zcs-color-secondary zcs-font-14 zcs-m-0'>Live stock health, asset movement, requests, and complaints</p></div>
  <div class='zcs-header-actions zcs-flex zcs-align-items-center zcs-gap-12'>
