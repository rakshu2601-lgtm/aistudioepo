    <a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14' href='#Report:All_Assets'><i class='zc-li-outline objects-1-laptop-71'></i><span>All assets</span></a>
    <a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14' href='#Report:Approved_Requests'><i class='zc-li-outline ui-1-check-circle-08'></i><span>Approved requests</span></a>
    <a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14' href='#Report:Open_Asset_Complaints'><i class='zc-li-outline ui-2-time'></i><span>Open complaints</span></a>
    <a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14' href='#Report:All_Stock_Transactions'><i class='zc-li-outline arrows-4-restore'></i><span>Stock transactions</span></a>
  </div>
</div>