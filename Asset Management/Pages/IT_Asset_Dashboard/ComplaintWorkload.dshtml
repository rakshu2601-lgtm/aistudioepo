<%
openCount = Asset_Complaints[Ticket_Status == "Open"].count(); progressCount = Asset_Complaints[Ticket_Status == "In Progress"].count(); criticalCount = Asset_Complaints[(Ticket_Status == "Open" || Ticket_Status == "In Progress") && Priority == "Critical"].count(); highCount = Asset_Complaints[(Ticket_Status == "Open" || Ticket_Status == "In Progress") && Priority == "High"].count(); total = openCount + progressCount;
%>
<style>.work-card{padding:20px;background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.head h2{font-size:18px;margin:0}.head a{font-size:13px;color:var(--zcs_brand_color);text-decoration:none}.work-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.work-item{padding:14px;background:#f9fafe;border-radius:8px;text-align:center}.value{font-size:24px;font-weight:700}.label{font-size:12px;color:var(--zcs_tertiary_text_color)}.badges{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.zcs-badge{display:inline-flex;padding:2px 10px;border-radius:4px;color:#fff;font-size:12px}.red{background:#fe455d}.yellow{background:#faae13}.blue{background:#2a6ffc}.empty{margin-top:12px;text-align:center;color:var(--zcs_tertiary_text_color);font-size:13px}</style>
<section class='work-card zcs-card'><div class='head'><h2>Complaint workload</h2><a href='#Report:Open_Asset_Complaints'>Open complaints</a></div><div class='work-grid'><div class='work-item'><div class='value'><%=ifnull(openCount,0)%></div><div class='label'>Open</div></div><div class='work-item'><div class='value'><%=ifnull(progressCount,0)%></div><div class='label'>In progress</div></div><div class='work-item'><div class='value'><%=ifnull(criticalCount,0) + ifnull(highCount,0)%></div><div class='label'>High / critical</div></div></div><div class='badges'><span class='zcs-badge zcs-badge-filled red'>Critical <%=ifnull(criticalCount,0)%></span><span class='zcs-badge zcs-badge-filled yellow'>High <%=ifnull(highCount,0)%></span><span class='zcs-badge zcs-badge-filled blue'>In progress <%=ifnull(progressCount,0)%></span></div><% if(total == 0){ %><div class='empty'>No open complaint workload is currently visible.</div><% } %></section>