<%
pending = Asset_Requests[Request_Status == "Pending Manager Approval"].count(); approved = Asset_Requests[Request_Status == "Approved"].count(); fulfilled = Asset_Requests[Request_Status == "Fulfilled"].count(); total = pending + approved + fulfilled;
%>
<style>.work-card{padding:20px;background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.head h2{font-size:18px;margin:0}.head a{font-size:13px;color:var(--zcs_brand_color);text-decoration:none}.work-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.work-item{padding:14px;background:#f9fafe;border-radius:8px;text-align:center}.value{font-size:24px;font-weight:700}.label{font-size:12px;color:var(--zcs_tertiary_text_color)}.empty{margin-top:12px;text-align:center;color:var(--zcs_tertiary_text_color);font-size:13px}</style>
<section class='work-card zcs-card'><div class='head'><h2>Request workload</h2><a href='#Report:Approved_Requests'>Approved queue</a></div><div class='work-grid'><div class='work-item'><div class='value'><%=ifnull(pending,0)%></div><div class='label'>Manager approval</div></div><div class='work-item'><div class='value'><%=ifnull(approved,0)%></div><div class='label'>Approved to fulfill</div></div><div class='work-item'><div class='value'><%=ifnull(fulfilled,0)%></div><div class='label'>Fulfilled</div></div></div><% if(total == 0){ %><div class='empty'>No request workload is currently visible.</div><% } %></section>