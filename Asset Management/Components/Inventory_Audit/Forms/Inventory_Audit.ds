form Inventory_Audit
{
    title
    {
        displayname = "Inventory Audit"
        on add = "Add Inventory Audit"
        on edit = "Edit Inventory Audit"
    }
    success message = "Inventory audit saved"
    Audit_Details
    (
        type = section
        displayname = "Audit Details"
        row = 1
        column = 0
    )
    must have Asset
    (
        type = picklist
        values = Assets.ID
        displayformat = [Asset_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Source_Type
    (
        type = picklist
        displayname = "Source Type"
        values = {"Asset Opening", "Stock Transaction", "Assignment", "Return"}
        row = 1
        column = 2
        width = medium
    )
    must have Source_Record_ID
    (
        type = text
        displayname = "Source Record ID"
        maxchar = 50
        row = 1
        column = 1
        width = medium
    )
    must have Action
    (
        type = text
        maxchar = 100
        row = 1
        column = 2
        width = medium
    )
    must have Quantity_Change
    (
        type = number
        displayname = "Quantity Change"
        row = 1
        column = 1
        width = medium
    )
    must have Stock_Before
    (
        type = number
        displayname = "Stock Before"
        row = 1
        column = 2
        width = medium
    )
    must have Stock_After
    (
        type = number
        displayname = "Stock After"
        row = 1
        column = 1
        width = medium
    )
    must have Performed_By
    (
        type = email
        displayname = "Performed By"
        row = 1
        column = 2
        width = medium
    )
    must have Performed_At
    (
        type = datetime
        displayname = "Performed At"
        row = 1
        column = 1
        width = medium
    )
    Details
    (
        type = textarea
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
