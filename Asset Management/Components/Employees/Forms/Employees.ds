form Employees
{
    title
    {
        on add = "Add Employee"
        on edit = "Edit Employee"
    }
    success message = "Employee saved successfully."
    Employee_Details
    (
        type = section
        displayname = "Employee Details"
        row = 1
        column = 0
    )
    must have unique Employee_ID
    (
        type = text
        displayname = "Employee ID"
        maxchar = 50
        row = 1
        column = 1
        width = medium
    )
    must have Employee_Name
    (
        type = text
        displayname = "Employee Name"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    must have unique Email
    (
        type = email
        row = 1
        column = 1
        width = medium
    )
    Department
    (
        type = text
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    Location
    (
        type = text
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    Active
    (
        type = checkbox
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
