Cancel_Asset_Request as "Cancel Asset Request"
{
    type = functions
    form = Asset_Requests
    execution type = for each record

    on start
    {
        actions
        {
            on click
            (
                if (input.Requested_By_Email != zoho.loginuser || input.Request_Status != "Pending Manager Approval")
                {
                    info "Only the requester can cancel a pending request.";
                }
                else
                {
                    input.Request_Status = "Cancelled";
                }
            )
        }
    }
}
