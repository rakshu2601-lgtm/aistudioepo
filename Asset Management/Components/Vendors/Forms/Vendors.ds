form Vendors
{
    title
    {
        on add = "Add Vendor"
        on edit = "Edit Vendor"
    }
    success message = "Vendor saved successfully."
    Vendor_Details
    (
        type = section
        displayname = "Vendor Details"
        row = 1
        column = 0
    )
    must have unique Vendor_Name
    (
        type = text
        displayname = "Vendor Name"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    Contact_Name
    (
        type = text
        displayname = "Contact Name"
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    Email
    (
        type = email
        row = 1
        column = 1
        width = medium
    )
    Phone
    (
        type = phonenumber
        row = 1
        column = 1
        width = medium
    )
    Website
    (
        type = url
        target = new window
        enable = linkname, title
        row = 1
        column = 1
        width = medium
    )
    Active
    (
        type = checkbox
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
