form Assets
{
    title
    {
        on add = "Add Asset"
        on edit = "Edit Asset"
    }
    success message = "Asset saved successfully."
    Asset_Details
    (
        type = section
        displayname = "Asset Details"
        row = 1
        column = 0
    )
    must have unique Asset_Code
    (
        type = text
        displayname = "Asset Code"
        maxchar = 50
        row = 1
        column = 1
        width = medium
    )
    must have Asset_Name
    (
        type = text
        displayname = "Asset Name"
        maxchar = 150
        row = 1
        column = 2
        width = medium
    )
    must have Category
    (
        type = picklist
        values = Asset_Categories.ID
        displayformat = [Category_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Manufacturer
    (
        type = text
        maxchar = 100
        row = 1
        column = 2
        width = medium
    )
    Model
    (
        type = text
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    Serial_Tracking_Required
    (
        type = checkbox
        displayname = "Serial Tracking Required"
        initial value = false
        row = 1
        column = 2
        width = medium
    )
    Active
    (
        type = checkbox
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    Stock_Levels
    (
        type = section
        displayname = "Stock Levels"
        visibility = true
        row = 2
        column = 1
    )
    must have Maximum_Stock
    (
        type = number
        displayname = "Maximum Stock"
        row = 2
        column = 1
        width = medium
    )
    must have Opening_Stock
    (
        type = number
        displayname = "Opening Stock"
        row = 2
        column = 2
        width = medium
    )
    Current_Stock
    (
        type = number
        displayname = "Current Stock"
        initial value = 0
        row = 2
        column = 1
        width = medium
    )
    Stock_Percentage
    (
        type = decimal
        displayname = "Stock Percentage"
        decimalplace = 2
        initial value = 0
        row = 2
        column = 2
        width = medium
    )
    Stock_Status
    (
        type = picklist
        displayname = "Stock Status"
        values = {"Healthy", "Low Stock", "Out of Stock"}
        initial value = "Healthy"
        row = 2
        column = 1
        width = medium
    )
    Low_Stock_Alert_Sent
    (
        type = checkbox
        displayname = "Low Stock Alert Sent"
        initial value = false
        row = 2
        column = 2
        width = medium
    )
    Last_Alerted_At
    (
        type = datetime
        displayname = "Last Alerted At"
        row = 2
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
