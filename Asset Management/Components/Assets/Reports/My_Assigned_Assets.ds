list My_Assigned_Assets
{
    displayName = "Asset Stock Summary"
    show all rows from Assets
    (
        Asset_Code
        Asset_Name
        Category
        Current_Stock
        Maximum_Stock
        Stock_Percentage
        Stock_Status
        Active
    )
    filters
    (
        Category
        Stock_Status
        Active
    )
    sort by
    (
        Stock_Percentage ascending
    )
}
