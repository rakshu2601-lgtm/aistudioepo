list All_Asset_Complaints
{
    displayName = "All Asset Complaints"
    show all rows from Asset_Complaints
    (
        Complaint_Number
        Reported_By_Email
        Asset
        Subject
        Priority
        Reported_Date_Time
        Ticket_Status
        Assigned_Inventory_Email
        Resolution_Notes
        Resolved_Date_Time
        Closed_Date_Time
    )
    filters
    (
        Ticket_Status
        Priority
    )
    sort by
    (
        Reported_Date_Time descending
    )
}
