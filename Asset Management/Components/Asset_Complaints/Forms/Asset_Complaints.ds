form Asset_Complaints
{
    title
    {
        displayname = "Asset Complaints"
        on add = "Raise Asset Complaint"
        on edit = "Update Asset Complaint"
    }
    success message = "Asset complaint saved successfully"
    Complaint_Details
    (
        type = section
        displayname = "Complaint Details"
        row = 1
        column = 0
    )
    Complaint_Number
    (
        type = autonumber
        displayname = "Complaint Number"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Reported_By_Email
    (
        type = email
        displayname = "Reported By Email"
        row = 1
        column = 1
        width = medium
    )
    must have Asset
    (
        type = picklist
        values = Assets.ID
        displayformat = [Asset_Code + " - " + Asset_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Subject
    (
        type = text
        row = 1
        column = 1
        width = medium
    )
    must have Description
    (
        type = textarea
        height = 120px
        row = 1
        column = 2
        width = medium
    )
    must have Priority
    (
        type = picklist
        values = {"Low", "Medium", "High", "Critical"}
        initial value = "Medium"
        row = 1
        column = 1
        width = medium
    )
    Reported_Date_Time
    (
        type = datetime
        displayname = "Reported Date & Time"
        initial value = "${zoho.currenttime}"
        row = 1
        column = 2
        width = medium
    )
    Resolution
    (
        type = section
        displayname = "Resolution"
        visibility = true
        row = 2
        column = 1
    )
    must have Ticket_Status
    (
        type = picklist
        displayname = "Ticket Status"
        values = {"Open", "In Progress", "Resolved", "Closed"}
        initial value = "Open"
        row = 2
        column = 1
        width = medium
    )
    Assigned_Inventory_Email
    (
        type = email
        displayname = "Assigned Inventory Email"
        row = 2
        column = 2
        width = medium
    )
    Resolution_Notes
    (
        type = textarea
        displayname = "Resolution Notes"
        height = 120px
        row = 2
        column = 1
        width = medium
    )
    Resolved_Date_Time
    (
        type = datetime
        displayname = "Resolved Date & Time"
        row = 2
        column = 2
        width = medium
    )
    Closed_Date_Time
    (
        type = datetime
        displayname = "Closed Date & Time"
        row = 2
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit Complaint"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Complaint"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
