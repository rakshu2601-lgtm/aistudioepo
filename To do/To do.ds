	menu
	{
	    unused
	    {
	        form Tasks
	        {
	            icon = "files-check"
	        }
	        report All_Tasks
	        {
	            icon = "files-single-content-03"
	        }
	        report Task_Board
	        {
	            icon = "business-board-27"
	        }
	        report Task_Calendar
	        {
	            icon = "business-agenda"
	        }
	    }
	    space Personal_Productivity
	    {
	        displayname = "Personal Productivity"
	        icon = "business-goal-65"
	        section Task_Workspace
	        {
	            displayname = "Tasks"
	            icon = "files-check"
	            page Task_Hub
	            {
	                icon = "business-chart"
	            }
	        }
	        section SharedAnalytics_Section
	        {
	            type = shared_user_report_section
	            displayname = "Reports"
	            icon = "business-chart-bar-33"
	        }
	    }
	    preference
	    {
	        icon
	        {
	            style = outline
	            show = {space, section, component}
	        }
	    }
	}
	customize
	{
	    layout
	    {
	        theme = "theme_2"
	        variant = "variant_2"
	    }
	    font = "lato"
	    color options
	    {
	        name = "Task Blue"
	        brand color = "#1565C0"
	        type = "custom"
	        dark mode color = "#26A69A"
	    }
	    logo
	    {
	        preference = "app_icon"
	        placement = "left"
	    }
	}
	}
}
