		                    Task_Title
		                    Status
		                    Priority
		                    Due_Date
		                    Completed
		                    Description
		                )
		            )
		        )
		        menu
		        (
		            header
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		            record
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		        )
		        action
		        (
		            on click
		            (
		                View Record
		            )
		            on right click
		            (
		                Edit
		                Delete
		                Duplicate
		                View Record
		            )
		        )
		    )
