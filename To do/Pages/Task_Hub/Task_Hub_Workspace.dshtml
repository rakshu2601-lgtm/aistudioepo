<style>
/* ===== zcs-global.css (page-scoped utility subset) ===== */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-page-bg-color:#f3f3f4;font-size:16px;line-height:1.5}
.zcs-flex{display:flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-m-0{margin:0}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-p-16{padding:1rem}.zcs-p-24{padding:1.5rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}
/* ZCS: header-heading-with-actions, button-primary-button */
.zcs-page-header{background:linear-gradient(120deg,var(--zcs_brand_light_color),var(--zcs-white-color));border:1px solid var(--zcs-border-color);border-radius:12px}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color)}.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-icon{width:16px;max-height:16px}
/* ZCS card adaptation */
.task-hub{font-family:inherit;background:var(--zcs-page-bg-color);padding:16px;box-sizing:border-box;color:var(--zcs-primary-text-color)}.task-hub-header{padding:20px 24px}.task-hub-title{font-size:24px;font-weight:600;margin:0}.task-hub-subtitle{margin:4px 0 0;color:var(--zcs-secondary-text-color);font-size:14px}.task-hub-kpis{display:grid;grid-template-columns:repeat(5,minmax(150px,1fr));gap:12px;margin:16px 0}.task-kpi{padding:18px;min-height:118px;box-sizing:border-box;display:flex;flex-direction:column;justify-content:space-between}.task-kpi-top{display:flex;align-items:center;justify-content:space-between;gap:10px}.task-kpi-label{font-size:13px;color:var(--zcs-secondary-text-color);font-weight:600}.task-kpi-icon{font-size:20px;color:var(--zcs_brand_color)}.task-kpi-value{font-size:30px;line-height:1;font-weight:700;color:var(--zcs-primary-text-color)}.task-kpi-overdue .task-kpi-icon,.task-kpi-overdue .task-kpi-value{color:#c33b46}
/* ZCS: horizontal-tab-horizontal-tab-with-icon */
.zcs-horizontal-tabpanel{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px;overflow:hidden}.zcs-horizontal-tabhead{box-shadow:0 -1px 0 var(--zcs-border-color) inset;overflow-x:auto;list-style:none}.zcs-horizontal-tabitem{list-style:none;border-bottom:2px solid transparent}.zcs-horizontal-tablink{white-space:nowrap}.zcs-horizontal-tabitem:hover,.zcs-horizontal-tabitem:focus-within{border-bottom-color:var(--zcs_brand_color)}.zcs-horizontal-tabitem:hover .zcs-horizontal-tablink,.zcs-horizontal-tablink:focus{color:var(--zcs_brand_color)}.zcs-horizontal-tablink:focus{outline:2px solid var(--zcs_brand_color);outline-offset:-2px}.task-view-copy{padding:18px 20px;color:var(--zcs-secondary-text-color);font-size:14px}.task-hub a{text-decoration:none}
@media(max-width:1100px){.task-hub-kpis{grid-template-columns:repeat(3,minmax(150px,1fr))}}@media(max-width:700px){.task-hub{padding:10px}.task-hub-header{align-items:flex-start;flex-direction:column;padding:16px}.task-hub-header .zcs-button{width:100%}.task-hub-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:430px){.task-hub-kpis{grid-template-columns:1fr}.task-hub-title{font-size:21px}}
</style>
<main class='task-hub' aria-labelledby='task-hub-title'>
  <header class='zcs-page-header task-hub-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-box-border'>
    <div>
      <h1 id='task-hub-title' class='task-hub-title'>Task Hub</h1>
      <p class='task-hub-subtitle'>Review workload, add tasks, and open the view that fits your work.</p>
    </div>
    <a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Form:Tasks' aria-label='Add a new task'>
      <i class='zcs-button-icon zc-li-outline ui-1-simple-add' aria-hidden='true'></i><span>Add Task</span>
    </a>
  </header>
  <section class='task-hub-kpis' aria-label='Task summary'>
    <article class='task-kpi zcs-card'><div class='task-kpi-top'><span class='task-kpi-label'>Total tasks</span><i class='task-kpi-icon zc-li-outline files-folder' aria-hidden='true'></i></div><strong class='task-kpi-value'><%=input.total_tasks%></strong></article>
    <article class='task-kpi zcs-card'><div class='task-kpi-top'><span class='task-kpi-label'>Not started</span><i class='task-kpi-icon zc-li-outline arrows-4-restore' aria-hidden='true'></i></div><strong class='task-kpi-value'><%=input.not_started_tasks%></strong></article>
    <article class='task-kpi zcs-card'><div class='task-kpi-top'><span class='task-kpi-label'>In progress</span><i class='task-kpi-icon zc-li-outline loader-dots-06' aria-hidden='true'></i></div><strong class='task-kpi-value'><%=input.in_progress_tasks%></strong></article>
    <article class='task-kpi zcs-card'><div class='task-kpi-top'><span class='task-kpi-label'>Completed</span><i class='task-kpi-icon zc-li-outline ui-1-check-circle-08' aria-hidden='true'></i></div><strong class='task-kpi-value'><%=input.completed_tasks%></strong></article>
    <article class='task-kpi task-kpi-overdue zcs-card'><div class='task-kpi-top'><span class='task-kpi-label'>Overdue</span><i class='task-kpi-icon zc-li-outline ui-2-time' aria-hidden='true'></i></div><strong class='task-kpi-value'><%=input.overdue_tasks%></strong></article>
  </section>
  <nav class='zcs-horizontal-tabpanel' aria-label='Task views'>
    <ul class='zcs-horizontal-tabhead zcs-flex zcs-gap-12 zcs-px-10 zcs-m-0 zcs-box-border'>
      <li class='zcs-horizontal-tabitem'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' href='#Report:All_Tasks'><i class='zc-li-outline design-bullet-list-67' aria-hidden='true'></i><span class='zcs-font-15'>All Tasks</span></a></li>
      <li class='zcs-horizontal-tabitem'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' href='#Report:Task_Board'><i class='zc-li-outline design-layout-11' aria-hidden='true'></i><span class='zcs-font-15'>Task Board</span></a></li>
      <li class='zcs-horizontal-tabitem'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' href='#Report:Task_Calendar'><i class='zc-li-outline ui-1-calendar-60' aria-hidden='true'></i><span class='zcs-font-15'>Task Calendar</span></a></li>
    </ul>
    <div class='task-view-copy'>Use the list for details, the board for status flow, or the calendar for due-date planning.</div>
  </nav>
</main>