calendar Task_Calendar
{
    displayName = "Task Calendar"
    show all rows from Tasks [Due_Date is not null]
    (
        Task_Title
        Status
        Priority
        Due_Date
    )
    filters
    (
        Status
        Priority
    )
    options
    (
        display type = month
        week start day = monday
        display field = Task_Title
        start date = Due_Date
        default date
        (
            day = Today
            month = Currentmonth
            year = Currentyear
        )
    )
}