form Tasks
{
    title
    {
        displayname = "Tasks"
        on add = "Add Task"
        on edit = "Edit Task"
    }
    success message = "Task saved successfully."
    Task_Details
    (
        type = section
        displayname = "Task Details"
        row = 1
        column = 0
    )
    must have Task_Title
    (
        type = text
        displayname = "Task Title"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    Description
    (
        type = textarea
        displayname = "Description"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Not Started", "In Progress", "Completed"}
        initial value = "Not Started"
        row = 1
        column = 1
        width = medium
    )
    must have Priority
    (
        type = picklist
        displayname = "Priority"
        values = {"Low", "Medium", "High"}
        initial value = "Medium"
        row = 1
        column = 2
        width = medium
    )
    Due_Date
    (
        type = date
        displayname = "Due Date"
        row = 1
        column = 1
        width = medium
    )
    Completed
    (
        type = checkbox
        displayname = "Completed"
        initial value = false
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}