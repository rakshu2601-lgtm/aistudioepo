			Create_Logistics_Booking_On_Load as "Create Logistics Booking On Load"
			{
			    type = form
			    form = Create_Logistics_Booking
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                hide Hidden;
			                disable Suppliers;
			                disable Status;
			                disable Action_Mode;
			                disable Logistics_Booking_Purchase_Orders.Supplier;
			                disable Logistics_Booking_Purchase_Orders.Sales_Order;
			                disable Logistics_Booking_Purchase_Orders.Purchase_Order_Date;
			                disable Logistics_Booking_Purchase_Orders.Invoice_Paid_Date;
			                disable Logistics_Booking_Purchase_Orders.Purchase_Order_Amount;
			                disable Logistics_Booking_Purchase_Orders.Currency;
			                disable Logistics_Booking_Products.Purchase_Order;
			                disable Logistics_Booking_Products.Purchase_Order_Product;
			                disable Logistics_Booking_Products.Supplier;
			                disable Logistics_Booking_Products.Product;
			                disable Logistics_Booking_Products.Product_ID;
			                disable Logistics_Booking_Products.Product_Name;
			                disable Logistics_Booking_Products.Product_Category;
			                disable Logistics_Booking_Products.Product_Type;
			                disable Logistics_Booking_Products.Manufacturer_Part_Number;
			                disable Logistics_Booking_Products.Brand_Make;
			                disable Logistics_Booking_Products.Model;
			                disable Logistics_Booking_Products.Configuration;
			                disable Logistics_Booking_Products.Expected_Quantity;
			                disable Logistics_Booking_Products.Unit_of_Measure;
			                disable Logistics_Booking_Products.Accepted_Quantity;
			                disable Logistics_Booking_Products.Rejected_Quantity;
			            )
			        }
			    }
			}

			Create_Logistics_Booking_On_Success as "Process Logistics Booking"
			{
			    type = form
			    form = Create_Logistics_Booking
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                booking_record = Create_Logistics_Booking[ID == input.ID];
			                if(input.Status == "New" && input.Action_Mode == null)
			                {
			                    insert into Add_History
			                    [
			                        Action_Type = "Logistics Booking Created"
			                        Status = "New"
			                        New_Status = "New"
			                        Comments = "Logistics booking created"
			                        Logistics_Booking_Lookup = input.ID
			                        Updated_By_Email = zoho.loginuserid
			                        Updated_Date_Time = zoho.currenttime
			                    ];
			                    for each booking_po in Logistics_Booking_Purchase_Order[Parent_Logistics_Booking == input.ID]
			                    {
			                        po_record = Create_Purchase_Order[ID == booking_po.Purchase_Order];
			                        po_record.Status = "Logistics Pending";
			                        sales_order_record = Create_Sales_Order[ID == booking_po.Sales_Order];
			                        sales_order_record.Status = "Logistics Pending";
			                        insert into Add_History
			                        [
			                            Action_Type = "Logistics Pending"
			                            Status = "Logistics Pending"
			                            Previous_Status = "Invoice Paid"
			                            New_Status = "Logistics Pending"
			                            Comments = "Purchase order added to logistics booking"
			                            Sales_Order_Lookup = booking_po.Sales_Order
			                            Purchase_Order_Lookup = booking_po.Purchase_Order
			                            Logistics_Booking_Lookup = input.ID
			                            Updated_By_Email = zoho.loginuserid
			                            Updated_Date_Time = zoho.currenttime
			                        ];
			                    }
			                }
			                if(input.Action_Mode == "Products Received" && input.Status == "New")
			                {
			                    booking_record.Status = "Products Received";
			                    for each booking_po in Logistics_Booking_Purchase_Order[Parent_Logistics_Booking == input.ID]
			                    {
			                        po_record = Create_Purchase_Order[ID == booking_po.Purchase_Order];
			                        po_record.Status = "Products Received";
			                        sales_order_record = Create_Sales_Order[ID == booking_po.Sales_Order];
			                        sales_order_record.Status = "Products Received";
			                        insert into Add_History
			                        [
			                            Action_Type = "Products Received and Quality Checked"
			                            Status = "Products Received"
			                            Previous_Status = "Logistics Pending"
			                            New_Status = "Products Received"
			                            Comments = input.Quality_Check_Summary
			                            Sales_Order_Lookup = booking_po.Sales_Order
			                            Purchase_Order_Lookup = booking_po.Purchase_Order
			                            Logistics_Booking_Lookup = input.ID
			                            Updated_By_Email = zoho.loginuserid
			                            Updated_Date_Time = zoho.currenttime
			                        ];
			                        supplier_record = Add_Supplier[ID == booking_po.Supplier];
			                        if(supplier_record.Email != null && supplier_record.Email != "")
			                        {
			                            sendmail
			                            (
			                                from : zoho.adminuserid
			                                to : supplier_record.Email
			                                subject : "Products received"
			                                message : "Products for purchase order " + po_record.Purchase_Order_ID + " have been received and quality checked."
			                            )
			                        }
			                    }
			                }
			                booking_record.Action_Mode = "";
			            )
			        }
			    }
			}

			Damaged_Quantity_On_User_Input as "Recalculate Receipt Quantities"
			{
			    type = form
			    form = Create_Logistics_Booking
			    record event = on add or edit
			
			    on user input of Logistics_Booking_Products.Damaged_Quantity
			    {
			        actions
			        {
			            custom deluge script
			            (
			                row.Rejected_Quantity = ifnull(row.Damaged_Quantity,0);
			                row.Accepted_Quantity = ifnull(row.Received_Quantity,0) - ifnull(row.Damaged_Quantity,0);
			            )
			        }
			    }
			}

			Logistics_PO_On_User_Input as "Load Logistics Purchase Order"
			{
			    type = form
			    form = Create_Logistics_Booking
			    record event = on add or edit
			
			    on user input of Logistics_Booking_Purchase_Orders.Purchase_Order
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(row.Purchase_Order != null)
			                {
			                    po_record = Create_Purchase_Order[ID == row.Purchase_Order];
			                    row.Supplier = po_record.Supplier;
			                    row.Sales_Order = po_record.Sales_Order;
			                    row.Purchase_Order_Date = po_record.PO_Date;
			                    row.Purchase_Order_Amount = po_record.Total_Customer_Price;
			                    row.Currency = po_record.Currency;
			                    invoice_record = Add_Supplier_Invoice[Purchase_Order == row.Purchase_Order && Status == "Paid"];
			                    if(invoice_record.count() > 0)
			                    {
			                        row.Invoice_Paid_Date = invoice_record.Paid_Date;
			                    }
			                    supplier_values = List();
			                    for each booking_po in input.Logistics_Booking_Purchase_Orders
			                    {
			                        if(booking_po.Supplier != null && !supplier_values.contains(booking_po.Supplier))
			                        {
			                            supplier_values.add(booking_po.Supplier);
			                        }
			                    }
			                    input.Suppliers = supplier_values;
			                    product_rows = Collection();
			                    for each po_item in Purchase_Order_Product[Parent_Purchase_Order == row.Purchase_Order]
			                    {
			                        product_row = Create_Logistics_Booking.Logistics_Booking_Products();
			                        product_row.Purchase_Order = row.Purchase_Order;
			                        product_row.Purchase_Order_Product = po_item.ID;
			                        product_row.Supplier = po_record.Supplier;
			                        product_row.Product = po_item.Product;
			                        product_row.Product_ID = po_item.Product_ID;
			                        product_row.Product_Name = po_item.Product_Name;
			                        product_row.Product_Category = po_item.Product_Category;
			                        product_row.Product_Type = po_item.Product_Type;
			                        product_row.Manufacturer_Part_Number = po_item.Manufacturer_Part_Number;
			                        product_row.Brand_Make = po_item.Brand_Make;
			                        product_row.Model = po_item.Model;
			                        product_row.Configuration = po_item.Approved_Configuration;
			                        product_row.Expected_Quantity = po_item.Quantity;
			                        product_row.Unit_of_Measure = po_item.Unit_of_Measure;
			                        product_rows.insert(product_row);
			                    }
			                    input.Logistics_Booking_Products.insert(product_rows);
			                }
			            )
			        }
			    }
			}

