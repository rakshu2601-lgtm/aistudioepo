			string styles.Vertical_Tab()
			{
			
			                 	color_codes = thisapp.styles.ColorCodes();
			                 	layout_style = ".zc-pra-vertical-tabpanel { } .zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead, .zc-pra-vertical-tabpanel .zc-pra-vertical-tabbody { height: 100%; overflow: auto; } .zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead { width: 250px; padding: 20px; border-right: 1px solid " + color_codes.get("zc-pra-border-color") + "; } .zc-pra-vertical-tabpanel .zc-pra-vertical-tabbody { width: calc(100% - 250px); } .zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead li { list-style-type: none; } .zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead li input { display: none; } .zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead li a { width: 100%; display: block; border-radius: 4px; padding: 10px 12px; margin: 2px 0px; font-size: 14px; font-weight: 400; line-height: 21px; color: " + color_codes.get("zc-pra-primary-text-color") + "; } .zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead li a:hover { color: var(--theme_brand_color); } .zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead li ul.zc-pra-vertical-tabsubmenu { background-color: var(--left_pane_section); border-radius: 4px; display: none; animation-duration: .25s; animation-name: animation-fade-up; } .zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead li ul.zc-pra-vertical-tabsubmenu li a { padding-left: 20px; } .zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead .zc-pra-vertical-tab-comp>label>a:after { content: '\f105'; font: normal normal normal 14px/21px FontAwesome; float: right; } .zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead li input:checked~ul.zc-pra-vertical-tabsubmenu { display: block; } .zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead .zc-pra-vertical-tab-comp>input:checked~label>a:after { content: '\f107'; transform: rotate(0deg); }";
			                 	rtl_style = ".zc-rtl-wrapper .zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead { border-right: 0px; border-left: 1px solid " + color_codes.get("zc-pra-border-color") + "; } .zc-rtl-wrapper .zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead li ul.zc-pra-vertical-tabsubmenu li a { padding-left: 12px; padding-right: 20px; } .zc-rtl-wrapper .zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead .zc-pra-vertical-tab-comp>label>a:after { float: left; transform: rotate(180deg); }";
			                 	style_txt = layout_style + rtl_style;
			                 	return style_txt;
			                 
			}

			void generateTestData()
			{
			
			                 	formList = {};
			                 	noOfRecords = 3;
			                 	if(formList.size() == 0)
			                 	{
			                 		response = invokeurl
			                 		[
			                 			url :"https://www.zohoapis.com/creator/v2.1/meta" + zoho.appuri + "forms"
			                 			type :GET
			                 			connection:"creator"
			                 		];
			                 		for each  rec1 in response.get("forms")
			                 		{
			                 			if(rec1.get("type") == 1)
			                 			{
			                 				formList.add(rec1.get("link_name"));
			                 			}
			                 		}
			                 	}
			                 	if(formList.size() != 0)
			                 	{
			                 		for each  formLinkName in formList
			                 		{
			                 			fieldResponse = invokeurl
			                 			[
			                 				url :"https://www.zohoapis.com/creator/v2.1/meta" + zoho.appuri + "form/" + formLinkName + "/fields"
			                 				type :GET
			                 				connection:"creator"
			                 			];
			                 			promptText = "Generate " + noOfRecords.toString() + " realistic JSON records for these fields with types and constraints: " + fieldResponse.toString() + ". Each record must strictly follow field types and constraints (numbers for number fields, booleans for checkbox fields, valid picklist choices only, max_char limits respected, mandatory fields filled, valid dates for date fields, valid emails for email fields).For fields representing Month and Year, only use values from the last 12 months relative to the current date. For example, Month should be equal to current or before this month and Year should current year only.Return ONLY a valid JSON array of objects like [{\"field1\":\"value1\",\"field2\":value2}, ...] with no surrounding markdown, ```json``` tags, explanations, comments, or any extra text.Do not include any text before or after the JSON array. The output must be a pure JSON array;";
			                 			result = zia
			                 			[
			                 				message:promptText
			                 			];
			                 			// info "Zia response: " + result;
			                 			resultResp = result + "";
			                 			liss = resultResp.toList();
			                 			for each  aec in liss
			                 			{
			                 				payload = Map();
			                 				dataList = List();
			                 				dataList.add(aec);
			                 				payload.put("data",dataList);
			                 				try 
			                 				{
			                 					insertResponse = invokeurl
			                 					[
			                 						url :"https://www.zohoapis.com/creator/v2.1/data" + zoho.appuri + "form/" + formLinkName
			                 						type :POST
			                 						parameters:payload.toString()
			                 						connection:"creator"
			                 					];
			                 					info "Inserted test record into " + formLinkName + ": " + insertResponse;
			                 				}
			                 				catch (e)
			                 				{
			                 					info "Error inserting record for " + formLinkName + ": " + e.toString();
			                 				}
			                 			}
			                 		}
			                 	}
			                 
			}

			string decisionBoxStyle.getDecisionBoxButtonStyle(string type, string fieldLinkName, string btnBgClr, string hoverClr)
			{
			
			                 	if(type = "All")
			                 	{
			                 		return "<style>..customCheckbox:checked+label{background: none; border: none;} .decision-box-field .customCheckbox+label { width: 80px; height: 36px; border-radius: 7px; border: none !important; background: " + btnBgClr + "; top: -8px; position: relative; box-shadow: none !important;} label.form-label.decision-box-label { color: #ffffff !important;margin: 0 !important; padding: 0 !important; width: 80px !important; !important;text-align: center !important;} .customCheckbox:checked+label:after{display:none;} .decision-box-field .customCheckbox+label:hover {background: " + hoverClr + ";} input.customCheckbox.zc_decisionbox[readonly]+label.zc_decision_box_label { opacity: 0.6 !important;}</style>";
			                 	}
			                 	else if(type = "Individual")
			                 	{
			                 		return "<style>.zc-" + fieldLinkName + "-group .customCheckbox:checked+label{background: none; border: none;}.zc-" + fieldLinkName + "-group .decision-box-field .customCheckbox+label { width: 80px; height: 36px; border-radius: 7px; border: none !important; background: " + btnBgClr + "; top: -8px; position: relative; box-shadow: none !important;} .zc-" + fieldLinkName + "-group label.form-label.decision-box-label { color: #ffffff !important;margin: 0 !important; padding: 0 !important; width: 80px !important; !important; text-align: center !important;} .zc-" + fieldLinkName + "-group .customCheckbox:checked+label:after{display:none;} .zc-" + fieldLinkName + "-group .decision-box-field .customCheckbox+label:hover {background: " + hoverClr + ";} input.customCheckbox.zc_decisionbox[readonly]+label.zc_decision_box_label { opacity: 0.6 !important;}</style>";
			                 	}
			                 	return "";
			                 
			}

			string decisionBoxStyle.getDecisionBoxToggleBtnStyle(string type, string fieldLinkName, string checkedBgClr, String uncheckedBgClr)
			{
			
			                 	if(type = "All")
			                 	{
			                 		return "<style>.zc-decisionbox-field-group label.zc_decision_box_label { cursor: pointer; background-color: " + uncheckedBgClr + "; transition: 0.4s; border-radius: 30px; width: 50px; height: 25px; outline: none; border: none !important; box-shadow: none !important; display: flex; align-items: center; padding: 5px; box-sizing: border-box;} label.zc_decision_box_label:before { display: flex; content: \"\"; height: 15px; width: 15px; background-color: white; transition: 0.4s !important; border-radius: 50%; } .customCheckbox:checked+ label.zc_decision_box_label { background: " + checkedBgClr + "; } .customCheckbox:checked+ label.zc_decision_box_label:before { transform: translateX(25px); } .customCheckbox:checked+label.zc_decision_box_label:after { display: none; }  label.form-label.decision-box-label { margin-left: 60px !important; display: flex; align-items: center; height: 25px; }</style>";
			                 	}
			                 	else if(type = "Individual")
			                 	{
			                 		return "<style>.zc-" + fieldLinkName + "-group label.zc_decision_box_label { cursor: pointer; background-color: " + uncheckedBgClr + "; transition: 0.4s; border-radius: 30px; width: 50px; height: 25px; outline: none; border: none !important; box-shadow: none !important; display: flex; align-items: center; padding: 5px; box-sizing: border-box;} .zc-" + fieldLinkName + "-group label.zc_decision_box_label:before { display: flex; content: \"\"; height: 15px; width: 15px; background-color: white; transition: 0.4s !important; border-radius: 50%; } .zc-" + fieldLinkName + "-group .customCheckbox:checked+ label.zc_decision_box_label { background: " + checkedBgClr + "; } .zc-" + fieldLinkName + "-group .customCheckbox:checked+ label.zc_decision_box_label:before { transform: translateX(25px); } .zc-" + fieldLinkName + "-group .customCheckbox:checked+label.zc_decision_box_label:after { display: none; } .zc-" + fieldLinkName + "-group label.form-label.decision-box-label { margin-left: 60px !important; display: flex; align-items: center; height: 25px; }</style>";
			                 	}
			                 	return "";
			                 
			}

			string ImportantFunctions.getImageURL(string img, string imgFieldLinkName, string reportName, int recID)
			{
			
			                 	if(input.img != "")
			                 	{
			                 		if(input.img.contains("lowqual"))
			                 		{
			                 			imagefile = input.img.getSuffix("fieldName/image/").getPrefix("\" lowqual");
			                 			return "/file" + zoho.appuri + input.reportName + "/" + input.recID + "/" + input.imgFieldLinkName + "/image-download?filepath=/" + imagefile;
			                 		}
			                 		else
			                 		{
			                 			return input.img.getSuffix("src = \"").getprefix("\" border");
			                 		}
			                 	}
			                 	else
			                 	{
			                 		return "https://sm.pcmag.com/pcmag_me/review/z/zoho-creat/zoho-creator_1vtu.png";
			                 	}
			                 
			}

			string ImportantFunctions.getLogo()
			{
			
			                 	fetchPref = Add_Preference[ID != null];
			                 	if(fetchPref.count() != 0)
			                 	{
			                 		if(fetchPref.Organization_Logo == "")
			                 		{
			                 			respImage = invokeurl
			                 			[
			                 				url :"https://www.zohowebstatic.com/sites/zweb/images/productlogos/creator.svg"
			                 				type :GET
			                 			];
			                 			respImage.setParamName("file");
			                 			respImage.setFileName("Creator_Logo.svg");
			                 			resp = invokeurl
			                 			[
			                 				url :"https://www.zohoapis.com/creator/v2.1/data/zc_poc/company-name-app-category-poc-id/report/All_Preferences/" + fetchPref.ID + "/Organization_Logo/upload"
			                 				type :POST
			                 				files:respImage
			                 				connection:"creator"
			                 			];
			                 		}
			                 		returnImage = thisapp.ImportantFunctions.getImageURL(fetchPref.Organization_Logo,"Organization_Logo","All_Preferences",fetchPref.ID);
			                 	}
			                 	else
			                 	{
			                 		insert into Add_Preference
			                 		[
			                 			Added_User=zoho.loginuser
			                 		]
			                 		returnImage = "https://www.zohowebstatic.com/sites/zweb/images/productlogos/creator.svg";
			                 	}
			                 	return returnImage;
			                 
			}

			string getNotesContent(string emailFor)
			{
			
			                 	returnString = "";
			                 	if(emailFor != "")
			                 	{
			                 		fieldMap = Map();
			                 		if(emailFor in {"Transfer Request Initiation","Transfer Request Approval","Transfer Request Rejection"})
			                 		{
			                 			fieldMap.put("Request_ID","Request ID");
			                 			fieldMap.put("Employee_Name","Employee Name");
			                 			fieldMap.put("Current_Location","Current Location");
			                 			fieldMap.put("Country","Country");
			                 			fieldMap.put("New_Location","New Location");
			                 			fieldMap.put("Reason_For_Transfer","Reason For Transfer");
			                 			fieldMap.put("Effective_Date","Effective Date");
			                 			fieldMap.put("Status","Status");
			                 			fieldMap.put("Comments","Comments");
			                 		}
			                 		else if(emailFor in {"Free Issue Reminder","Free Issue Booking"})
			                 		{
			                 			fieldMap.put("Employee_Name","Employee Name");
			                 			fieldMap.put("Date_field","Date");
			                 			fieldMap.put("Collection_Location","Collection Location");
			                 			fieldMap.put("Product_Preference","Products & Quanity");
			                 		}
			                 		else if(emailFor in {"Free Issue Allocation","Free Issue Collection"})
			                 		{
			                 			fieldMap.put("Employee_Name","Employee Name");
			                 			fieldMap.put("Collection_Location","Collection Location");
			                 			fieldMap.put("Collection_Code","Collection Code");
			                 			fieldMap.put("Selected_Products","Products & Quanity");
			                 		}
			                 		else if(emailFor in {"Invoice Approval","Invoice Rejection"})
			                 		{
			                 			fieldMap.put("Invoice_ID","Invoice ID");
			                 			fieldMap.put("Vendor","Vendor");
			                 			fieldMap.put("Broker","Broker");
			                 			fieldMap.put("Invoice_Date","Invoice Date");
			                 			fieldMap.put("Invoice_Amount","Invoice Amount");
			                 			fieldMap.put("Remaining_Amount","Remaining Amount");
			                 			fieldMap.put("Notes","Notes");
			                 			fieldMap.put("Status","Status");
			                 		}
			                 		fieldKeys = fieldMap.keys();
			                 		styleStr = "<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: rgb(51, 51, 51); line-height: 1.6\"><h2 style=\"color: rgb(41, 66, 134); border-bottom: 2px solid rgb(212, 221, 245); padding-bottom: 4px\">Note:<br></h2><p>Use the following placeholders to dynamically insert values into the Template content. These tags will be replaced with actual data from the form<br></p><ul style=\"background-color: rgb(233, 238, 251); padding: 14px 18px; border-radius: 10px; list-style-type: none; margin: 16px 0\">";
			                 		for each  fieldKey in fieldKeys
			                 		{
			                 			styleStr = styleStr + "<li><b>&#36;&#123;" + fieldKey + "&#125;</b> → <i>" + fieldMap.get(fieldKey) + "</i><br></li>";
			                 		}
			                 		returnString = styleStr + "</ul><p style=\"color: rgb(102, 102, 102)\">You can place these tags anywhere in the template. They will be replaced with their corresponding values from the form data.<br></p></div>";
			                 	}
			                 	return returnString;
			                 
			}

			string styles.getRatingStar(string ratingStr, string selectedClr, string unselectedClr)
			{
			
			                 	if(selectedClr == "")
			                 	{
			                 		selectedClr = "#FFB904";
			                 	}
			                 	if(unselectedClr == "")
			                 	{
			                 		unselectedClr = "#EDEDED";
			                 	}
			                 	ratingNum = if(ratingStr.isNumber(),ratingStr.toLong(),0);
			                 	loopingList = "".leftpad(4).toList(" ");
			                 	str = "<div style='gap: 5px;display: flex;justify-content: flex-end;'>";
			                 	for each index rating in loopingList
			                 	{
			                 		if(rating < ratingNum)
			                 		{
			                 			str = str + "<svg width='14' height='13' viewBox='0 0 14 13' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M6.35754 0.927052C6.65689 0.0057416 7.9603 0.00574088 8.25965 0.927052L9.10471 3.52786C9.23858 3.93989 9.62254 4.21885 10.0558 4.21885H12.7904C13.7591 4.21885 14.1619 5.45846 13.3782 6.02786L11.1658 7.63525C10.8153 7.8899 10.6687 8.34127 10.8025 8.75329L11.6476 11.3541C11.947 12.2754 10.8925 13.0415 10.1088 12.4721L7.89638 10.8647C7.54589 10.6101 7.0713 10.6101 6.72081 10.8647L4.50843 12.4721C3.72471 13.0415 2.67023 12.2754 2.96958 11.3541L3.81464 8.75329C3.94851 8.34127 3.80185 7.8899 3.45137 7.63525L1.23899 6.02787C0.455271 5.45846 0.858046 4.21885 1.82677 4.21885H4.56142C4.99465 4.21885 5.37861 3.93989 5.51248 3.52786L6.35754 0.927052Z' fill='" + selectedClr + "'/></svg>";
			                 		}
			                 		else
			                 		{
			                 			str = str + "<svg width='14' height='13' viewBox='0 0 14 13' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M6.35754 0.927052C6.65689 0.00574152 7.9603 0.00574078 8.25965 0.927051L9.10471 3.52786C9.23858 3.93989 9.62254 4.21885 10.0558 4.21885H12.7904C13.7591 4.21885 14.1619 5.45846 13.3782 6.02786L11.1658 7.63525C10.8153 7.8899 10.6687 8.34127 10.8025 8.75329L11.6476 11.3541C11.947 12.2754 10.8925 13.0415 10.1088 12.4721L7.89638 10.8647C7.54589 10.6101 7.0713 10.6101 6.72081 10.8647L4.50843 12.4721C3.72471 13.0415 2.67023 12.2754 2.96958 11.3541L3.81464 8.75329C3.94851 8.34127 3.80185 7.8899 3.45137 7.63525L1.23899 6.02787C0.455271 5.45846 0.858046 4.21885 1.82677 4.21885H4.56142C4.99465 4.21885 5.37861 3.93989 5.51248 3.52786L6.35754 0.927052Z' fill='" + unselectedClr + "'/></svg>";
			                 		}
			                 	}
			                 	return str + "</div>";
			                 
			}

