{margin:0;font-size:16px;font-weight:700}.qc-selector-input{position:absolute;opacity:0;pointer-events:none}.qc-selector{display:flex;flex-wrap:wrap;gap:7px}.qc-selector label{display:inline-flex;align-items:center;gap:7px;padding:8px 11px;border:1px solid var(--zcs_tertiary_border_color);border-radius:7px;background:#fff;color:var(--zcs-primary-text-color);cursor:pointer;transition:border-color .15s ease,background .15s ease}.qc-selector label:before{content:&apos;&apos;;width:11px;height:11px;border:2px solid var(--zcs_tertiary_border_color);border-radius:50%;box-sizing:border-box}.qc-comparison{display:none}.qc-offer-card{display:none}.qc-highlight{display:inline-flex;align-items:center;margin-top:6px;padding:2px 7px;border:1px solid #179e6c;border-radius:999px;background:#e4fcf3;color:#126e4d;font-size:10px;font-weight:700;white-space:nowrap}.qc-highlight:before{content:&apos;1&apos;;display:inline-grid;place-items:center;width:15px;height:15px;margin-right:5px;border-radius:50%;background:#179e6c;color:#fff;font-size:9px}.qc-config{min-width:230px}.qc-price{font-size:14px;font-weight:700;white-space:nowrap}.qc-attach{display:inline-flex;align-items:center;gap:5px;color:var(--zcs_brand_color);overflow-wrap:anywhere}.qc-mobile{display:none}.qc-mobile-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.qc-empty{padding:28px;text-align:center;color:var(--zcs-teritiary-text-color);border:1px dashed var(--zcs_tertiary_border_color);border-radius:10px;background:#F9FAFE}.qc-empty i{display:block;font-size:28px;margin-bottom:8px;color:var(--zcs_brand_color)}.qc-decision{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.qc-sheet{color:var(--zcs_brand_color);font-weight:700}.qc-state-note{padding:10px 12px;border:1px solid #9ee4c9;background:#eafaf4;color:#126e4d;border-radius:8px}.qc-history-scroll{height:260px;overflow:auto;padding-right:8px}.zcs-table-wrapper{height:230px;max-height:230px;border-color:var(--zcs_tertiary_border_color)}.qc-comparison .zcs-table-wrapper{height:390px;max-height:390px}.zcs-table-wrapper table{min-width:1380px}.zcs-table-wrapper thead{z-index:2}.zcs-table-wrapper th{font-size:11px;text-transform:uppercase;letter-spacing:.035em}.zcs-table-wrapper td{font-size:13px}.zcs-table-wrapper tbody td:first-child strong{display:inline-block;padding:2px 7px;border:1px solid var(--zcs_brand_color);border-radius:999px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:12px}.zcs-badge{white-space:nowrap}.zcs-progress-bar{height:6px;background:var(--zcs_component_hover_color)}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}#splash-screen,.zc-page-loader{display:none!important}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper,.zc-pb-page-content-wrapper,.zc-pb-tile-container,.zc-pb-tile-card{width:100%!important;max-width:none!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important;border-radius:0!important}@media(max-width:992px){.qc-summary{grid-template-columns:repeat(3,minmax(0,1fr))}.qc-decision{grid-template-columns:1fr}.qc-page{padding:12px}.qc-header{position:static}}@media(max-width:700px){.qc-page{padding:8px}.qc-header,.qc-section{padding:14px}.qc-title{font-size:19px}.qc-summary{grid-template-columns:1fr 1fr}.qc-actions{width:100%}.qc-actions .zcs-button{flex:1;min-width:42px}.qc-actions .zcs-button-text{display:none}.qc-desktop{display:none}.qc-mobile{display:flex;flex-direction:column;gap:10px;height:560px;max-height:560px;overflow:auto}.qc-offer-card{display:block;padding:14px}.qc-mobile-grid{grid-template-columns:1fr 1fr}.qc-selector{flex-wrap:nowrap;overflow:auto;padding-bottom:3px}.qc-selector label{white-space:nowrap}.qc-comparison{padding:14px}.qc-history-scroll{height:240px}}@media(max-width:440px){.qc-summary,.qc-mobile-grid{grid-template-columns:1fr}.qc-page{padding:6px}}\n&lt;% for each productStyle in products { %&gt;#qc-product-&lt;%=productStyle.ID%&gt;:checked ~ .qc-shell .qc-label-&lt;%=productStyle.ID%&gt;{border-color:var(--zcs_brand_color);background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-weight:700}#qc-product-&lt;%=productStyle.ID%&gt;:checked ~ .qc-shell .qc-label-&lt;%=productStyle.ID%&gt;:before{border-color:var(--zcs_brand_color);box-shadow:inset 0 0 0 2px #fff;background:var(--zcs_brand_color)}#qc-product-&lt;%=productStyle.ID%&gt;:checked ~ .qc-shell .qc-product-&lt;%=productStyle.ID%&gt;{display:block}&lt;% } %&gt;\n&lt;/style&gt;\n&lt;div class=&apos;qc-page&apos;&gt;\n&lt;% if(orders.count() == 0) { %&gt;\n&lt;div class=&apos;zcs-card qc-empty&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;&lt;h2 class=&apos;zcs-font-18 zcs-m-0&apos;&gt;Sales order not found&lt;/h2&gt;&lt;p&gt;No accessible record matches this Sales_Order_ID.&lt;/p&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Page:Sales_Orders&apos;&gt;Back to sales orders&lt;/a&gt;&lt;/div&gt;\n&lt;% } else { order = orders; products = Sales_Order_Product[Parent_Sales_Order == order.ID]; quotes = Add_Supplier_Quote[Sales_Order == order.ID] sort by Quote_Date desc; histories = Add_History[Sales_Order_Lookup == order.ID] sort by Updated_Date_Time desc; pos = Create_Purchase_Order[Sales_Order == order.ID]; firstProduct = 0; if(products.count() &gt; 0) { firstProduct = products.ID.get(0); } %&gt;\n&lt;% for each productRadio in products { %&gt;&lt;input class=&apos;qc-selector-input&apos; type=&apos;radio&apos; name=&apos;qc-product&apos; id=&apos;qc-product-&lt;%=productRadio.ID%&gt;&apos; &lt;% if(productRadio.ID == firstProduct) { %&gt;checked&lt;% } %&gt;&gt;&lt;% } %&gt;\n&lt;div class=&apos;qc-shell zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n&lt;header class=&apos;zcs-card qc-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-row-wrap zcs-gap-16&apos;&gt;\n&lt;div&gt;&lt;div class=&apos;qc-eyebrow&apos;&gt;Quote comparison&lt;/div&gt;&lt;h1 class=&apos;qc-title&apos;&gt;&lt;%=ifnull(order.Sales_Order_ID,&quot;Sales order&quot;)%&gt;&lt;/h1&gt;&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-mt-8&apos;&gt;&lt;%=order.Status%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;div class=&apos;qc-actions&apos;&gt;\n&lt;% if(order.Selected_Supplier_Quote != null &amp;&amp; pos.count() == 0) { %&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border&apos; href=&apos;#Form:Create_Purchase_Order?Sales_Order=&lt;%=order.ID%&gt;&amp;amp;Selected_Supplier_Quote=&lt;%=order.Selected_Supplier_Quote.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Create PO&lt;/span&gt;&lt;/a&gt;&lt;% } %&gt;\n&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border&apos; href=&apos;#Page:History?Sales_Order_ID=&lt;%=order.ID%&gt;&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;History&lt;/span&gt;&lt;/a&gt;\n&lt;/div&gt;&lt;/header&gt;\n&lt;section class=&apos;zcs-card qc-section&apos;&gt;&lt;div class=&apos;qc-summary&apos;&gt;&lt;div&gt;&lt;div class=&apos;qc-label&apos;&gt;Customer&lt;/div&gt;&lt;div class=&apos;qc-value&apos;&gt;&lt;%=if(order.Customer != null,order.Customer.Customer_Name,&quot;Not specified&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;qc-label&apos;&gt;Requirement source&lt;/div&gt;&lt;div class=&apos;qc-value&apos;&gt;&lt;%=ifnull(order.Requirement_Source,&quot;Not specified&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;qc-label&apos;&gt;Order date&lt;/div&gt;&lt;div class=&apos;qc-value&apos;&gt;&lt;%=ifnull(order.Sales_Order_Date,&quot;Not specified&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;qc-label&apos;&gt;Requested delivery&lt;/div&gt;&lt;div class=&apos;qc-value&apos;&gt;&lt;%=ifnull(order.Requested_Delivery_Date,&quot;Not specified&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;qc-label&apos;&gt;Coverage&lt;/div&gt;&lt;div class=&apos;qc-value&apos;&gt;&lt;%=products.count()%&gt; requirements · &lt;%=quotes.count()%&gt; quotes&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;qc-copy zcs-mt-8&apos;&gt;&lt;span class=&apos;qc-label&apos;&gt;Customer requirements&lt;/span&gt;&lt;br&gt;&lt;%=ifnull(order.Customer_Requirements,&quot;Not specified&quot;)%&gt;&lt;/div&gt;&lt;% if(products.count() &gt; 0) { %&gt;&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative zcs-mt-8&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Required product&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Configuration&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Quantity&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Availability / lead time&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;% for each requirement in products { %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12&apos;&gt;&lt;strong&gt;&lt;%=requirement.Product_Name%&gt;&lt;/strong&gt;&lt;div class=&apos;zcs-color-tertiary&apos;&gt;&lt;%=ifnull(requirement.Brand_Make,&quot;&quot;)%&gt; &lt;%=ifnull(requirement.Model,&quot;&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12 qc-copy&apos;&gt;&lt;%=ifnull(requirement.Configuration,ifnull(requirement.Technical_Requirements,&quot;Not specified&quot;))%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12 zcs-text-right&apos;&gt;&lt;%=requirement.Quantity%&gt; &lt;%=ifnull(requirement.Unit_of_Measure,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12&apos;&gt;&lt;%=ifnull(requirement.Required_Availability,&quot;Not specified&quot;)%&gt;&lt;div class=&apos;zcs-color-tertiary&apos;&gt;&lt;%=ifnull(requirement.Required_Lead_Time,&quot;Lead time not specified&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;% } %&gt;&lt;/section&gt;\n&lt;% if(quotes.count() == 0) { %&gt;&lt;section class=&apos;zcs-card qc-section&apos;&gt;&lt;div class=&apos;qc-empty&apos;&gt;&lt;i class=&apos;zc-li-outline business-handshake&apos;&gt;&lt;/i&gt;&lt;h2 class=&apos;zcs-font-18 zcs-m-0&apos;&gt;No supplier quotes yet&lt;/h2&gt;&lt;p&gt;Requirements are ready, but no supplier response can be compared.&lt;/p&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=order.ID%&gt;&apos;&gt;Review sourcing status&lt;/a&gt;&lt;/div&gt;&lt;/section&gt;&lt;% } else { %&gt;&lt;section class=&apos;zcs-card qc-section&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;h2 class=&apos;qc-section-title&apos;&gt;Select product&lt;/h2&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=products.count()%&gt; products&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;qc-selector zcs-mt-8&apos;&gt;&lt;% for each productLabel in products { %&gt;&lt;label class=&apos;qc-label-&lt;%=productLabel.ID%&gt;&apos; for=&apos;qc-product-&lt;%=productLabel.ID%&gt;&apos;&gt;&lt;%=productLabel.Product_Name%&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;x &lt;%=productLabel.Quantity%&gt;&lt;/span&gt;&lt;/label&gt;&lt;% } %&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;% for each productRow in products { offers = Supplier_Quote_Product[Sales_Order_Product == productRow.ID] sort by Supplier_Unit_Price asc; lowestId = 0; bestAvailabilityId = 0; shortestLeadId = 0; if(offers.count() &gt; 0) { lowestId = offers.ID.get(0); availabilityOffers = Supplier_Quote_Product[Sales_Order_Product == productRow.ID] sort by Availability asc; bestAvailabilityId = availabilityOffers.ID.get(0); leadOffers = Supplier_Quote_Product[Sales_Order_Product == productRow.ID] sort by Lead_Time asc; shortestLeadId = leadOffers.ID.get(0); } %&gt;\n&lt;section class=&apos;zcs-card qc-section qc-comparison qc-product-&lt;%=productRow.ID%&gt;&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;qc-section-title&apos;&gt;&lt;%=productRow.Product_Name%&gt;&lt;/h2&gt;&lt;div class=&apos;zcs-color-tertiary&apos;&gt;&lt;%=ifnull(productRow.Brand_Make,&quot;&quot;)%&gt; &lt;%=ifnull(productRow.Model,&quot;&quot;)%&gt; · Requested &lt;%=productRow.Quantity%&gt; &lt;%=ifnull(productRow.Unit_of_Measure,&quot;&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=offers.count()%&gt; offers&lt;/span&gt;&lt;/div&gt;\n&lt;% if(offers.count() == 0) { %&gt;&lt;div class=&apos;qc-empty zcs-mt-8&apos;&gt;No supplier offer was submitted for this product.&lt;/div&gt;&lt;% } else { %&gt;\n&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative zcs-mt-8 qc-desktop&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Supplier / Quote&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Requested configuration&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Offered configuration&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Match&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Quantity&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Unit price&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Total price&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Availability&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Lead time&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Dispatch / Remarks&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Attachment&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Actions&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;% for each offer in offers { quote = Add_Supplier_Quote[ID == offer.Parent_Supplier_Quote]; variance = offer.Quoted_Quantity - productRow.Quantity; badgeClass = &quot;zcs-badge-yellow&quot;; if(offer.Configuration_Match == &quot;Exact Match&quot; &amp;&amp; variance &gt;= 0) { badgeClass = &quot;zcs-badge-green&quot;; } else if(offer.Configuration_Match == &quot;Does Not Match&quot; || variance &lt; 0) { badgeClass = &quot;zcs-badge-red&quot;; } else if(offer.Configuration_Match == &quot;Alternative&quot;) { badgeClass = &quot;zcs-badge-orange&quot;; } %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12&apos;&gt;&lt;strong&gt;&lt;%=if(quote.Supplier != null,quote.Supplier.Supplier_Name,&quot;Supplier&quot;)%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;&lt;%=quote.Supplier_Quote_ID%&gt; · &lt;%=quote.Status%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12 qc-config qc-copy&apos;&gt;&lt;%=ifnull(offer.Requested_Configuration,&quot;Not specified&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12 qc-config qc-copy&apos;&gt;&lt;%=ifnull(offer.Offered_Configuration,&quot;Not specified&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline &lt;%=badgeClass%&gt; zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=ifnull(offer.Configuration_Match,&quot;Not assessed&quot;)%&gt;&lt;/span&gt;&lt;div class=&apos;zcs-font-12 zcs-mt-5 &lt;% if(variance &lt; 0) { %&gt;zcs-color-red&lt;% } else { %&gt;zcs-color-secondary&lt;% } %&gt;&apos;&gt;Quantity variance: &lt;%=variance%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12 zcs-text-right&apos;&gt;&lt;%=offer.Quoted_Quantity%&gt; &lt;%=ifnull(offer.Unit_of_Measure,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12 zcs-text-right&apos;&gt;&lt;span class=&apos;qc-price&apos;&gt;&lt;%=ifnull(offer.Currency,ifnull(quote.Currency,&quot;Currency not set&quot;))%&gt; &lt;%=offer.Supplier_Unit_Price%&gt;&lt;/span&gt;&lt;% if(offer.ID == lowestId) { %&gt;&lt;span class=&apos;qc-highlight&apos;&gt;Lowest price&lt;/span&gt;&lt;% } %&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12 zcs-text-right&apos;&gt;&lt;span class=&apos;qc-price&apos;&gt;&lt;%=ifnull(offer.Currency,ifnull(quote.Currency,&quot;Currency not set&quot;))%&gt; &lt;%=offer.Supplier_Total_Price%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12&apos;&gt;&lt;%=ifnull(offer.Availability,ifnull(quote.Availability,&quot;Not specified&quot;))%&gt;&lt;% if(offer.ID == bestAvailabilityId) { %&gt;&lt;span class=&apos;qc-highlight&apos;&gt;Best availability&lt;/span&gt;&lt;% } %&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12&apos;&gt;&lt;%=ifnull(offer.Lead_Time,ifnull(quote.Lead_Time,&quot;Not specified&quot;))%&gt;&lt;% if(offer.ID == shortestLeadId) { %&gt;&lt;span class=&apos;qc-highlight&apos;&gt;Shortest lead&lt;/span&gt;&lt;% } %&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12&apos;&gt;&lt;strong&gt;&lt;%=ifnull(offer.Dispatch_Location,ifnull(quote.Dispatch_Location,&quot;Not specified&quot;))%&gt;&lt;/strong&gt;&lt;div class=&apos;qc-copy zcs-color-tertiary&apos;&gt;&lt;%=ifnull(offer.Remarks,ifnull(quote.Supplier_Remarks,&quot;No remarks&quot;))%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12&apos;&gt;&lt;% if(quote.Quote_Attachment != null) { %&gt;&lt;span class=&apos;qc-attach&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;%=quote.Quote_Attachment%&gt;&lt;/span&gt;&lt;% } else { %&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;None&lt;/span&gt;&lt;% } %&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-12&apos;&gt;&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;&lt;% if(order.Selected_Supplier_Quote == null &amp;&amp; quote.Status == &quot;Received&quot;) { %&gt;&lt;a class=&apos;zcs-custom-btn zcs-px-10 zcs-py-6 zcs-rounded-sm&apos; href=&apos;#Form:Create_Sales_Order?recLinkID=&lt;%=order.ID%&gt;&amp;amp;viewLinkName=All_Sales_Orders&amp;amp;Recommended_Supplier=&lt;%=quote.Supplier.ID%&gt;&amp;amp;Action_Mode=Recommend Supplier&amp;amp;zc_LoadIn=dialog&apos;&gt;Recommend&lt;/a&gt;&lt;a class=&apos;zcs-custom-btn zcs-px-10 zcs-py-6 zcs-rounded-sm&apos; href=&apos;#Form:Create_Sales_Order?recLinkID=&lt;%=order.ID%&gt;&amp;amp;viewLinkName=All_Sales_Orders&amp;amp;Selected_Supplier_Quote=&lt;%=quote.ID%&gt;&amp;amp;Action_Mode=Select Quote&amp;amp;zc_LoadIn=dialog&apos;&gt;Select&lt;/a&gt;&lt;% } %&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n&lt;div class=&apos;qc-mobile&apos;&gt;&lt;% for each offerCard in offers { quoteCard = Add_Supplier_Quote[ID == offerCard.Parent_Supplier_Quote]; varianceCard = offerCard.Quoted_Quantity - productRow.Quantity; badgeCard = &quot;zcs-badge-yellow&quot;; if(offerCard.Configuration_Match == &quot;Exact Match&quot; &amp;&amp; varianceCard &gt;= 0) { badgeCard = &quot;zcs-badge-green&quot;; } else if(offerCard.Configuration_Match == &quot;Does Not Match&quot; || varianceCard &lt; 0) { badgeCard = &quot;zcs-badge-red&quot;; } %&gt;&lt;article class=&apos;zcs-card qc-offer-card&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;div&gt;&lt;strong&gt;&lt;%=if(quoteCard.Supplier != null,quoteCard.Supplier.Supplier_Name,&quot;Supplier&quot;)%&gt;&lt;/strong&gt;&lt;div class=&apos;zcs-color-tertiary&apos;&gt;&lt;%=quoteCard.Supplier_Quote_ID%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline &lt;%=badgeCard%&gt; zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=ifnull(offerCard.Configuration_Match,&quot;Not assessed&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;qc-mobile-grid zcs-mt-8&apos;&gt;&lt;div&gt;&lt;div class=&apos;qc-label&apos;&gt;Requested configuration&lt;/div&gt;&lt;div class=&apos;qc-copy&apos;&gt;&lt;%=ifnull(offerCard.Requested_Configuration,&quot;Not specified&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;qc-label&apos;&gt;Offered configuration&lt;/div&gt;&lt;div class=&apos;qc-copy&apos;&gt;&lt;%=ifnull(offerCard.Offered_Configuration,&quot;Not specified&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;qc-label&apos;&gt;Quantity / variance&lt;/div&gt;&lt;div class=&apos;qc-value&apos;&gt;&lt;%=offerCard.Quoted_Quantity%&gt; &lt;%=ifnull(offerCard.Unit_of_Measure,&quot;&quot;)%&gt; · &lt;%=varianceCard%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;qc-label&apos;&gt;Unit / total price&lt;/div&gt;&lt;div class=&apos;qc-value&apos;&gt;&lt;%=ifnull(offerCard.Currency,ifnull(quoteCard.Currency,&quot;Currency not set&quot;))%&gt; &lt;%=offerCard.Supplier_Unit_Price%&gt; / &lt;%=ifnull(offerCard.Currency,ifnull(quoteCard.Currency,&quot;Currency not set&quot;))%&gt; &lt;%=offerCard.Supplier_Total_Price%&gt;&lt;/div&gt;&lt;% if(offerCard.ID == lowestId) { %&gt;&lt;span class=&apos;qc-highlight&apos;&gt;Lowest price&lt;/span&gt;&lt;% } %&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;qc-label&apos;&gt;Availability&lt;/div&gt;&lt;div&gt;&lt;%=ifnull(offerCard.Availability,ifnull(quoteCard.Availability,&quot;Not specified&quot;))%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;qc-label&apos;&gt;Lead time&lt;/div&gt;&lt;div&gt;&lt;%=ifnull(offerCard.Lead_Time,ifnull(quoteCard.Lead_Time,&quot;Not specified&quot;))%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;qc-label zcs-mt-8&apos;&gt;Remarks&lt;/div&gt;&lt;div class=&apos;qc-copy&apos;&gt;&lt;%=ifnull(offerCard.Remarks,ifnull(quoteCard.Supplier_Remarks,&quot;No remarks&quot;))%&gt;&lt;/div&gt;&lt;% if(order.Selected_Supplier_Quote == null &amp;&amp; quoteCard.Status == &quot;Received&quot;) { %&gt;&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-mt-8&apos;&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Form:Create_Sales_Order?recLinkID=&lt;%=order.ID%&gt;&amp;amp;viewLinkName=All_Sales_Orders&amp;amp;Recommended_Supplier=&lt;%=quoteCard.Supplier.ID%&gt;&amp;amp;Action_Mode=Recommend Supplier&amp;amp;zc_LoadIn=dialog&apos;&gt;Recommend&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Form:Create_Sales_Order?recLinkID=&lt;%=order.ID%&gt;&amp;amp;viewLinkName=All_Sales_Orders&amp;amp;Selected_Supplier_Quote=&lt;%=quoteCard.ID%&gt;&amp;amp;Action_Mode=Select Quote&amp;amp;zc_LoadIn=dialog&apos;&gt;Select&lt;/a&gt;&lt;/div&gt;&lt;% } %&gt;&lt;/article&gt;&lt;% } %&gt;&lt;/div&gt;&lt;% } %&gt;&lt;/section&gt;&lt;% } %&gt;\n&lt;section class=&apos;zcs-card qc-section&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-row-wrap zcs-gap-8&apos;&gt;&lt;h2 class=&apos;qc-section-title&apos;&gt;Recommendation and selection&lt;/h2&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border&apos; href=&apos;#Form:Create_Sales_Order?recLinkID=&lt;%=order.ID%&gt;&amp;amp;viewLinkName=All_Sales_Orders&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;span&gt;Comparison remarks and sheet&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;qc-decision zcs-mt-8&apos;&gt;&lt;div&gt;&lt;div class=&apos;qc-label&apos;&gt;Recommended supplier&lt;/div&gt;&lt;div class=&apos;qc-value&apos;&gt;&lt;%=if(order.Recommended_Supplier != null,order.Recommended_Supplier.Supplier_Name,&quot;Not recommended&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;qc-label&apos;&gt;Selected supplier quote&lt;/div&gt;&lt;div class=&apos;qc-value&apos;&gt;&lt;%=if(order.Selected_Supplier_Quote != null,order.Selected_Supplier_Quote.Supplier_Quote_ID,&quot;Not selected&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;qc-label&apos;&gt;Comparison sheet&lt;/div&gt;&lt;div class=&apos;qc-sheet&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt; &lt;%=ifnull(order.Comparison_Sheet,&quot;No sheet uploaded&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;zcs-notes-wrapper zcs-mt-8&apos;&gt;&lt;p class=&apos;zcs-notes-text zcs-m-0 zcs-font-14 zcs-font-normal&apos;&gt;&lt;span class=&apos;zcs-color-tertiary zcs-font-medium&apos;&gt;Comparison remarks: &lt;/span&gt;&lt;span class=&apos;qc-copy&apos;&gt;&lt;%=ifnull(order.Comparison_Remarks,&quot;No comparison remarks&quot;)%&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;&lt;% if(order.Selected_Supplier_Quote != null) { %&gt;&lt;div class=&apos;qc-state-note zcs-mt-8&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt; Selection recorded. Purchase order creation is available while no purchase order exists.&lt;/div&gt;&lt;% } %&gt;&lt;/section&gt;\n&lt;section class=&apos;zcs-card qc-section&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;h2 class=&apos;qc-section-title&apos;&gt;Related history&lt;/h2&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=histories.count()%&gt; events&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;qc-history-scroll zcs-mt-8&apos;&gt;&lt;% if(histories.count() == 0) { %&gt;&lt;div class=&apos;qc-empty&apos;&gt;No history entries.&lt;/div&gt;&lt;% } else { %&gt;&lt;div class=&apos;zcs-timeline-wrapper&apos;&gt;&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-24 zcs-p-0 zcs-m-0&apos;&gt;&lt;% for each historyRow in histories { %&gt;&lt;li class=&apos;zcs-tl-li&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&apos;&gt;&lt;h6 class=&apos;zcs-font-16 zcs-font-semibold zcs-m-0&apos;&gt;&lt;%=historyRow.Action_Type%&gt;&lt;/h6&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=ifnull(historyRow.New_Status,ifnull(historyRow.Status,&quot;Recorded&quot;))%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;&lt;%=historyRow.Updated_Date_Time%&gt; · &lt;%=if(historyRow.Updated_By != null,historyRow.Updated_By.Employee_Name,ifnull(historyRow.Updated_By_Email,&quot;System&quot;))%&gt;&lt;/div&gt;&lt;% if(historyRow.Previous_Status != null || historyRow.New_Status != null) { %&gt;&lt;div class=&apos;zcs-mt-8&apos;&gt;&lt;%=ifnull(historyRow.Previous_Status,&quot;&quot;)%&gt; to &lt;%=ifnull(historyRow.New_Status,&quot;&quot;)%&gt;&lt;/div&gt;&lt;% } %&gt;&lt;% if(historyRow.Comments != null) { %&gt;&lt;div class=&apos;qc-copy&apos;&gt;&lt;%=historyRow.Comments%&gt;&lt;/div&gt;&lt;% } %&gt;&lt;% if(historyRow.Subform_Details_Change_Summary != null) { %&gt;&lt;div class=&apos;qc-copy zcs-color-secondary&apos;&gt;&lt;%=historyRow.Subform_Details_Change_Summary%&gt;&lt;/div&gt;&lt;% } %&gt;&lt;/li&gt;&lt;% } %&gt;&lt;/ul&gt;&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;/div&gt;&lt;% } %&gt;&lt;% } %&gt;&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page RD_Dashboard
		{
					displayname = "R&D Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='RD_Operations' elementName='RD_Operations'>\n\t\t\t\t\t<![CDATA[htmlpage RD_Operations()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nrdOrders = Create_Sales_Order[Requirement_Source == &quot;R&amp;D Market Need&quot;] sort by Sales_Order_Date desc;\nrdOrderCount = rdOrders.count();\nrdProducts = Sales_Order_Product[Parent_Sales_Order.Requirement_Source == &quot;R&amp;D Market Need&quot;];\nrdProductCount = rdProducts.count();\nrdQuotes = Add_Supplier_Quote[Sales_Order.Requirement_Source == &quot;R&amp;D Market Need&quot;] sort by Quote_Date desc;\nrdQuoteCount = rdQuotes.count();\nrdPOs = Create_Purchase_Order[Sales_Order.Requirement_Source == &quot;R&amp;D Market Need&quot;] sort by PO_Date desc;\nrdPOCount = rdPOs.count();\ntotalDemandQty = 0;\nordersWithQuotes = 0;\ncomparisonReadyCount = 0;\nselectedQuoteCount = 0;\nfor each demandRow in rdProducts\n{\n\tif(demandRow.Quantity != null)\n\t{\n\t\ttotalDemandQty = totalDemandQty + demandRow.Quantity;\n\t}\n}\nfor each needOrder in rdOrders\n{\n\tquoteCoverageCount = Add_Supplier_Quote[Sales_Order == needOrder.ID].count();\n\tif(quoteCoverageCount &gt; 0)\n\t{\n\t\tordersWithQuotes = ordersWithQuotes + 1;\n\t}\n\tif(quoteCoverageCount &gt; 1 &amp;&amp; needOrder.Selected_Supplier_Quote == null)\n\t{\n\t\tcomparisonReadyCount = comparisonReadyCount + 1;\n\t}\n\tif(needOrder.Selected_Supplier_Quote != null)\n\t{\n\t\tselectedQuoteCount = selectedQuoteCount + 1;\n\t}\n}\ncoveragePct = 0;\nif(rdOrderCount &gt; 0)\n{\n\tcoveragePct = (ordersWithQuotes * 100) / rdOrderCount;\n}\n%&gt;\n&lt;style&gt;\n/* ZCS global utility core, included once for this page. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#F6F5F9;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-col-common{flex:1 1 0;min-width:0}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:10px}.zcs-gap-4{gap:4px}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-gap-14{gap:14px}.zcs-gap-16{gap:16px}.zcs-rounded-sm{border-radius:4px}.zcs-font-11{font-size:11px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-white{color:#fff}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-text-right{text-align:right}.zcs-card{background:var(--zcs-white-color);border:1px solid #E6E3EC;border-radius:10px}a{text-decoration:none}\nhtml,body,div#zppagesLive,div#elementsContainer,.Layout.elemContainment,.zcpage-elemContainer,.zc-pb-page-content-wrapper,.zc-pb-tile-container,.zc-pb-tile-card{width:100%!important;max-width:none!important;min-height:100%;box-sizing:border-box}.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zc-pb-tile-container,.zc-pb-page-content-wrapper .zc-pb-tile-card{padding:0!important;margin:0!important;border-radius:0!important;box-shadow:none!important}#splash-screen,.zc-page-loader,.cogLoader{display:none!important}\n.rd-dashboard{min-height:100%;padding:16px;background:var(--zcs-page-bg-color);font:400 14px/1.45 Arial,sans-serif;color:var(--zcs-primary-text-color)}\n.intro{padding:18px 20px;border-left:4px solid #7253D6}.eyebrow{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#7253D6}.intro h1{margin:3px 0 4px}.intro p{max-width:760px;margin:0;color:var(--zcs-secondary-text-color)}.scope{max-width:360px;padding-left:18px;border-left:1px solid #DED9E8;color:var(--zcs-secondary-text-color);font-size:12px}.scope b{color:#7253D6}\n.summary-grid{display:grid;grid-template-columns:repeat(4,minmax(120px,1fr));gap:10px}.summary{padding:12px 14px;cursor:default}.summary-top{display:flex;align-items:center;justify-content:space-between;color:var(--zcs-secondary-text-color);font-size:12px}.summary-top i{color:#7253D6;font-size:16px}.summary-value{margin-top:4px;font-size:20px;font-weight:600}.lifecycle{padding:15px 18px}.lifecycle-head{margin-bottom:14px}.lifecycle-note{font-size:12px;color:var(--zcs-secondary-text-color)}\n.zcs-stepper-wrapper ul{display:flex;list-style:none;padding:0;margin:0;gap:8px}.zcs-stepper{flex:1;display:flex;flex-direction:column;align-items:center;gap:5px;text-align:center;position:relative}.zcs-stepper-status{width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#7253D6;border:4px solid #fff;box-sizing:border-box;z-index:1;color:#fff;font-size:12px}.zcs-stepper:not(:last-child):before{content:&apos;&apos;;width:100%;height:1px;border-top:1px solid #7253D6;position:absolute;top:14px;left:50%}.zcs-stepper-text{font-size:12px}.zcs-stepper-sub{font-size:11px;color:var(--zcs-secondary-text-color)}\n.workspace{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(340px,.85fr);gap:14px;align-items:start}.stack{display:grid;gap:14px}.section{min-width:0;overflow:hidden}.section-head{min-height:52px;padding:9px 14px;border-bottom:1px solid var(--zcs-border-color);background:#fff}.title-icon{width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border-radius:8px;background:#F0EBFF;color:#7253D6}.section-count{padding:2px 8px;border-radius:10px;background:#F1EFF5;color:var(--zcs-secondary-text-color);font-size:11px;font-weight:600}.section-link,.record-link,.icon-action{color:#6645CD}.section-link,.record-link{font-weight:600}.section-link{font-size:12px;white-space:nowrap}.section-body{height:286px;overflow:auto}.tall{height:320px}\n.zcs-table-wrapper{background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;min-width:690px}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:#FAF9FC;white-space:nowrap;box-shadow:0 -1px 0 var(--zcs-border-color) inset;font-size:11px;color:var(--zcs-secondary-text-color);font-weight:600}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color);vertical-align:middle;font-size:13px}.zcs-table-wrapper tbody tr:first-child td{border-top:0}.zcs-table-wrapper tbody tr:hover td{background:#FAF9FC}.meta{font-size:11px;color:var(--zcs-secondary-text-color);margin-top:2px}.muted{color:var(--zcs-secondary-text-color)}\n.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent;color:#fff}.zcs-badge-theme{background:#7253D6}.zcs-badge-green{background:#16845C}.zcs-badge-yellow{background:#B97800}.zcs-badge-blue{background:#2A6FFC}.zcs-badge-grey{background:#59606D}.zcs-badge-orange{background:#C95C12}.list{padding:2px 14px}.list-row{padding:11px 0;border-bottom:1px solid var(--zcs-border-color)}.list-row:last-child{border-bottom:0}.record-title{font-weight:600}.qty{min-width:38px;text-align:center;background:#F0EBFF;color:#6645CD;border-radius:6px;padding:4px 7px;font-weight:600}.zcs-button{width:auto;min-height:32px;border:1px solid #7253D6;background:#fff;color:#6645CD;padding:6px 10px;border-radius:6px;font-size:12px;font-weight:600;box-sizing:border-box}.zcs-button:hover{background:var(--zcs_component_hover_color)}.coverage{padding:12px 14px;border-bottom:1px solid var(--zcs-border-color)}.zcs-progress-bar{height:7px;background:var(--zcs_component_hover_color);border-radius:4px}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:#7253D6}.zcs-nodata-wrapper{min-height:210px}.zcs-nodata-content{max-width:390px}.empty-icon{display:block;font-size:26px;color:#8D8798;margin-bottom:7px}\n@media(max-width:1120px){.workspace{grid-template-columns:1fr}.section-body{height:310px}.tall{height:330px}}\n@media(max-width:720px){.rd-dashboard{padding:9px}.intro{align-items:flex-start;flex-direction:column}.scope{max-width:none;padding:10px 0 0;border-left:0;border-top:1px solid #DED9E8}.summary-grid{grid-template-columns:repeat(2,1fr)}.section-head{align-items:flex-start}.zcs-stepper-wrapper ul{flex-direction:column;gap:14px}.zcs-stepper{flex-direction:row;text-align:left}.zcs-stepper:not(:last-child):before{width:1px;height:100%;border-top:0;border-left:1px solid #7253D6;left:14px;top:14px}.zcs-table-wrapper table{min-width:0}.zcs-table-wrapper thead{display:none}.zcs-table-wrapper tbody tr{display:block;margin:8px;border:1px solid var(--zcs-border-color);border-radius:8px;overflow:hidden}.zcs-table-wrapper tbody td{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%!important;padding:7px 10px!important;box-sizing:border-box;border:0}.zcs-table-wrapper tbody td:before{content:attr(data-label);font-size:11px;color:var(--zcs-secondary-text-color);font-weight:600}.section-body,.tall{height:360px}}\n@media(max-width:430px){.summary-grid{grid-template-columns:1fr}.section-head{flex-wrap:wrap}}\n&lt;/style&gt;\n&lt;div class=&apos;rd-dashboard zcs-flex zcs-direction-column zcs-gap-14 zcs-box-border&apos;&gt;\n\t&lt;header class=&apos;intro zcs-card zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&apos;&gt;\n\t\t&lt;div&gt;&lt;div class=&apos;eyebrow&apos;&gt;Research and development&lt;/div&gt;&lt;h1 class=&apos;zcs-font-24 zcs-font-semibold zcs-lh-heading&apos;&gt;Market needs workspace&lt;/h1&gt;&lt;p&gt;Assess requested products and move each need through supplier evidence, comparison, selection, and downstream purchasing.&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;scope&apos;&gt;&lt;b&gt;Scoped data&lt;/b&gt;&lt;br&gt;Only sales orders with Requirement Source set to R&amp;amp;D Market Need are included. Customer Request orders remain outside this workspace.&lt;/div&gt;\n\t&lt;/header&gt;\n\n\t&lt;div class=&apos;summary-grid&apos;&gt;\n\t\t&lt;div class=&apos;summary zcs-card&apos;&gt;&lt;div class=&apos;summary-top&apos;&gt;&lt;span&gt;Market requirements&lt;/span&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=rdOrderCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;summary zcs-card&apos;&gt;&lt;div class=&apos;summary-top&apos;&gt;&lt;span&gt;Units requested&lt;/span&gt;&lt;i class=&apos;zc-li-outline tech-computer&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=totalDemandQty%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;summary zcs-card&apos;&gt;&lt;div class=&apos;summary-top&apos;&gt;&lt;span&gt;Supplier quotes&lt;/span&gt;&lt;i class=&apos;zc-li-outline arrows-2-file-download-87&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=rdQuoteCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;summary zcs-card&apos;&gt;&lt;div class=&apos;summary-top&apos;&gt;&lt;span&gt;Downstream POs&lt;/span&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=rdPOCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;section class=&apos;lifecycle zcs-card&apos;&gt;\n\t\t&lt;div class=&apos;lifecycle-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div class=&apos;zcs-font-16 zcs-font-semibold&apos;&gt;Sourcing lifecycle&lt;/div&gt;&lt;div class=&apos;lifecycle-note&apos;&gt;A compact portfolio view; open records below for detail.&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-stepper-wrapper&apos;&gt;&lt;ul&gt;\n\t\t\t&lt;li class=&apos;zcs-stepper&apos;&gt;&lt;span class=&apos;zcs-stepper-status&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-small&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-stepper-text&apos;&gt;Need captured&lt;/span&gt;&lt;span class=&apos;zcs-stepper-sub&apos;&gt;&lt;%=rdOrderCount%&gt; requirements&lt;/span&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-stepper&apos;&gt;&lt;span class=&apos;zcs-stepper-status&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-small&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-stepper-text&apos;&gt;Demand defined&lt;/span&gt;&lt;span class=&apos;zcs-stepper-sub&apos;&gt;&lt;%=rdProductCount%&gt; product lines&lt;/span&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-stepper&apos;&gt;&lt;span class=&apos;zcs-stepper-status&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-small&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-stepper-text&apos;&gt;Evidence received&lt;/span&gt;&lt;span class=&apos;zcs-stepper-sub&apos;&gt;&lt;%=ordersWithQuotes%&gt; covered&lt;/span&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-stepper&apos;&gt;&lt;span class=&apos;zcs-stepper-status&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-small&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-stepper-text&apos;&gt;Quote selected&lt;/span&gt;&lt;span class=&apos;zcs-stepper-sub&apos;&gt;&lt;%=selectedQuoteCount%&gt; selected&lt;/span&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-stepper&apos;&gt;&lt;span class=&apos;zcs-stepper-status&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-small&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-stepper-text&apos;&gt;PO created&lt;/span&gt;&lt;span class=&apos;zcs-stepper-sub&apos;&gt;&lt;%=rdPOCount%&gt; purchase orders&lt;/span&gt;&lt;/li&gt;\n\t\t&lt;/ul&gt;&lt;/div&gt;\n\t&lt;/section&gt;\n\n\t&lt;div class=&apos;workspace&apos;&gt;\n\t\t&lt;div class=&apos;stack&apos;&gt;\n\t\t\t&lt;section class=&apos;section zcs-card&apos;&gt;\n\t\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;title-icon zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-16 zcs-font-semibold&apos;&gt;Market requirements&lt;/span&gt;&lt;span class=&apos;section-count&apos;&gt;&lt;%=rdOrderCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Report:All_Sales_Orders?Requirement_Source=R%26D%20Market%20Need&apos;&gt;View filtered report&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;% if(rdOrderCount &gt; 0) { %&gt;&lt;div class=&apos;section-body tall zcs-table-wrapper zcs-relative&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Requirement&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Context&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Market need&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Delivery&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Evidence&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t&lt;% for each orderRec in rdOrders { orderQuoteCount = Add_Supplier_Quote[Sales_Order == orderRec.ID].count(); customerLabel = &quot;Internal market need&quot;; if(orderRec.Customer != null) { customerLabel = orderRec.Customer.Customer_Name; } %&gt;&lt;tr&gt;&lt;td data-label=&apos;Requirement&apos; class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=orderRec.ID%&gt;&apos;&gt;&lt;%=orderRec.Sales_Order_ID%&gt;&lt;/a&gt;&lt;div class=&apos;meta&apos;&gt;&lt;%=orderRec.Sales_Order_Date%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td data-label=&apos;Context&apos; class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=customerLabel%&gt;&lt;/td&gt;&lt;td data-label=&apos;Market need&apos; class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(orderRec.Customer_Requirements,&quot;Requirement detail pending&quot;)%&gt;&lt;/td&gt;&lt;td data-label=&apos;Delivery&apos; class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(orderRec.Requested_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td data-label=&apos;Evidence&apos; class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled &lt;% if(orderQuoteCount &gt; 0) { %&gt;zcs-badge-blue&lt;% } else { %&gt;zcs-badge-grey&lt;% } %&gt; zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;%=orderQuoteCount%&gt; quotes&lt;/span&gt;&lt;/td&gt;&lt;td data-label=&apos;Status&apos; class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(orderRec.Status,&quot;Status not set&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;% } else { %&gt;&lt;div class=&apos;section-body zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-nodata-content zcs-p-20&apos;&gt;&lt;i class=&apos;empty-icon zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-m-0&apos;&gt;No market requirements&lt;/h5&gt;&lt;p class=&apos;zcs-color-secondary zcs-mt-10&apos;&gt;Records appear here only when Requirement Source is R&amp;amp;D Market Need.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&apos;section zcs-card&apos;&gt;\n\t\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;title-icon zc-li-outline arrows-2-file-download-87&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-16 zcs-font-semibold&apos;&gt;Supplier evidence&lt;/span&gt;&lt;span class=&apos;section-count&apos;&gt;&lt;%=rdQuoteCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Report:All_Supplier_Quotes&apos;&gt;Open quote register&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;coverage&apos;&gt;&lt;div class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=coveragePct%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-m-0&apos;&gt;&lt;span&gt;&lt;%=ordersWithQuotes%&gt; of &lt;%=rdOrderCount%&gt; requirements have supplier evidence&lt;/span&gt;&lt;span&gt;&lt;%=coveragePct%&gt;%&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;% if(rdQuoteCount &gt; 0) { %&gt;&lt;div class=&apos;section-body zcs-table-wrapper zcs-relative&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Quote&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Requirement&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Supplier&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Availability&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Lead time&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;State&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t&lt;% for each quoteRec in rdQuotes { supplierLabel = &quot;Supplier not set&quot;; if(quoteRec.Supplier != null) { supplierLabel = quoteRec.Supplier.Supplier_Name; } %&gt;&lt;tr&gt;&lt;td data-label=&apos;Quote&apos; class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Report:All_Supplier_Quotes?ID=&lt;%=quoteRec.ID%&gt;&apos;&gt;&lt;%=quoteRec.Supplier_Quote_ID%&gt;&lt;/a&gt;&lt;div class=&apos;meta&apos;&gt;&lt;%=quoteRec.Quote_Date%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td data-label=&apos;Requirement&apos; class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=quoteRec.Sales_Order.ID%&gt;&apos;&gt;&lt;%=quoteRec.Sales_Order.Sales_Order_ID%&gt;&lt;/a&gt;&lt;/td&gt;&lt;td data-label=&apos;Supplier&apos; class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=supplierLabel%&gt;&lt;/td&gt;&lt;td data-label=&apos;Availability&apos; class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(quoteRec.Availability,&quot;Not stated&quot;)%&gt;&lt;/td&gt;&lt;td data-label=&apos;Lead time&apos; class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(quoteRec.Lead_Time,&quot;Not stated&quot;)%&gt;&lt;/td&gt;&lt;td data-label=&apos;State&apos; class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled &lt;% if(quoteRec.Status == &quot;Selected&quot;) { %&gt;zcs-badge-green&lt;% } else { %&gt;zcs-badge-yellow&lt;% } %&gt; zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;%=ifnull(quoteRec.Status,&quot;Submitted&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;% } else { %&gt;&lt;div class=&apos;section-body zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-nodata-content zcs-p-20&apos;&gt;&lt;i class=&apos;empty-icon zc-li-outline arrows-2-file-download-87&apos;&gt;&lt;/i&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-m-0&apos;&gt;No sourcing evidence yet&lt;/h5&gt;&lt;p class=&apos;zcs-color-secondary zcs-mt-10&apos;&gt;Supplier quotes linked to these market-need orders will appear here.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t\t&lt;/section&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;stack&apos;&gt;\n\t\t\t&lt;section class=&apos;section zcs-card&apos;&gt;\n\t\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;title-icon zc-li-outline tech-computer&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-16 zcs-font-semibold&apos;&gt;Product demand&lt;/span&gt;&lt;span class=&apos;section-count&apos;&gt;&lt;%=rdProductCount%&gt; lines&lt;/span&gt;&lt;/div&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Page:Products&apos;&gt;Product catalog&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;% if(rdProductCount &gt; 0) { %&gt;&lt;div class=&apos;section-body list&apos;&gt;&lt;% for each productRec in rdProducts { %&gt;&lt;div class=&apos;list-row zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div class=&apos;zcs-col-common&apos;&gt;&lt;div class=&apos;record-title&apos;&gt;&lt;%=ifnull(productRec.Product_Name,&quot;Unnamed product&quot;)%&gt;&lt;/div&gt;&lt;div class=&apos;meta&apos;&gt;&lt;%=ifnull(productRec.Product_Category,&quot;Category not set&quot;)%&gt; | &lt;%=ifnull(productRec.Brand_Make,&quot;Brand not set&quot;)%&gt; &lt;%=ifnull(productRec.Model,&quot;&quot;)%&gt;&lt;/div&gt;&lt;div class=&apos;meta&apos;&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=productRec.Parent_Sales_Order.ID%&gt;&apos;&gt;Requirement &lt;%=productRec.Parent_Sales_Order.Sales_Order_ID%&gt;&lt;/a&gt; | &lt;%=ifnull(productRec.Required_Availability,&quot;Availability not set&quot;)%&gt;&lt;/div&gt;&lt;div class=&apos;meta&apos;&gt;&lt;%=ifnull(productRec.Configuration,&quot;Configuration pending&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;qty&apos;&gt;&lt;%=ifnull(productRec.Quantity,0)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;&lt;% } else { %&gt;&lt;div class=&apos;section-body zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-nodata-content zcs-p-20&apos;&gt;&lt;i class=&apos;empty-icon zc-li-outline tech-computer&apos;&gt;&lt;/i&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-m-0&apos;&gt;No product demand recorded&lt;/h5&gt;&lt;p class=&apos;zcs-color-secondary zcs-mt-10&apos;&gt;Product lines added to the filtered requirements will appear here.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&apos;section zcs-card&apos;&gt;\n\t\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;title-icon zc-li-outline business-chart-bar-32&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-16 zcs-font-semibold&apos;&gt;Ready for comparison&lt;/span&gt;&lt;span class=&apos;section-count&apos;&gt;&lt;%=comparisonReadyCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;section-body list&apos;&gt;&lt;% if(comparisonReadyCount &gt; 0) { for each compareOrder in rdOrders { compareQuoteCount = Add_Supplier_Quote[Sales_Order == compareOrder.ID].count(); if(compareQuoteCount &gt; 1 &amp;&amp; compareOrder.Selected_Supplier_Quote == null) { %&gt;&lt;div class=&apos;list-row&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;div&gt;&lt;div class=&apos;record-title&apos;&gt;&lt;%=compareOrder.Sales_Order_ID%&gt;&lt;/div&gt;&lt;div class=&apos;meta&apos;&gt;&lt;%=compareQuoteCount%&gt; comparable responses; no quote selected&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-green zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;Ready&lt;/span&gt;&lt;/div&gt;&lt;a class=&apos;zcs-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-mt-10&apos; href=&apos;#Page:Quote_Comparison?Sales_Order_ID=&lt;%=compareOrder.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;span&gt;Compare quotes&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;% } } } else { %&gt;&lt;div class=&apos;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-nodata-content zcs-p-20&apos;&gt;&lt;i class=&apos;empty-icon zc-li-outline business-chart-bar-32&apos;&gt;&lt;/i&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-m-0&apos;&gt;Nothing ready to compare&lt;/h5&gt;&lt;p class=&apos;zcs-color-secondary zcs-mt-10&apos;&gt;Readiness requires at least two quotes and no selected quote.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&apos;section zcs-card&apos;&gt;\n\t\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;title-icon zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-16 zcs-font-semibold&apos;&gt;Purchase orders&lt;/span&gt;&lt;span class=&apos;section-count&apos;&gt;&lt;%=rdPOCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Report:All_Purchase_Orders&apos;&gt;Open PO register&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;% if(rdPOCount &gt; 0) { %&gt;&lt;div class=&apos;section-body list&apos;&gt;&lt;% for each poRec in rdPOs { supplierName = &quot;Supplier not set&quot;; if(poRec.Supplier != null) { supplierName = poRec.Supplier.Supplier_Name; } %&gt;&lt;div class=&apos;list-row&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=poRec.ID%&gt;&apos;&gt;&lt;%=poRec.Purchase_Order_ID%&gt;&lt;/a&gt;&lt;div class=&apos;meta&apos;&gt;&lt;%=supplierName%&gt; | Requirement &lt;%=poRec.Sales_Order.Sales_Order_ID%&gt;&lt;/div&gt;&lt;div class=&apos;meta&apos;&gt;Created &lt;%=poRec.PO_Date%&gt; | Expected &lt;%=ifnull(poRec.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&apos;icon-action&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=poRec.ID%&gt;&apos; title=&apos;Open purchase order&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;zcs-mt-10&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-orange zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;%=ifnull(poRec.Status,&quot;Status not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;&lt;% } else { %&gt;&lt;div class=&apos;section-body zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-nodata-content zcs-p-20&apos;&gt;&lt;i class=&apos;empty-icon zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-m-0&apos;&gt;No downstream purchase orders&lt;/h5&gt;&lt;p class=&apos;zcs-color-secondary zcs-mt-10&apos;&gt;Purchase orders created from selected quotes for these requirements will appear here.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t\t&lt;/section&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Requests_For_Quote
		{
					displayname = "Requests For Quote"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Requests_For_Quote_Snippet' elementName='Requests_For_Quote_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Requests_For_Quote_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nloginEmail = zoho.loginuserid;\nactiveSuppliers = Add_Supplier[Email == loginEmail &amp;&amp; Active == true];\nsupplierCount = activeSuppliers.count();\nidentityReady = supplierCount == 1;\nsupplierId = 0;\nsupplierName = &quot;Supplier&quot;;\neligibleOrders = Create_Sales_Order[ID == 0];\nmyQuotes = Add_Supplier_Quote[ID == 0];\nawaitingCount = 0;\ndueSoonCount = 0;\nif(identityReady)\n{\n\t\tfor each supplierRec in activeSuppliers\n\t\t{\n\t\t\t\tsupplierId = supplierRec.ID;\n\t\t\t\tsupplierName = supplierRec.Supplier_Name;\n\t\t}\n\t\teligibleOrders = Create_Sales_Order[(Status == &quot;New&quot; || Status == &quot;Quotes Received&quot;) &amp;&amp; (Recommended_Supplier == null || Recommended_Supplier == supplierId)] sort by Requested_Delivery_Date asc;\n\t\tmyQuotes = Add_Supplier_Quote[Supplier == supplierId] sort by Quote_Date descending;\n\t\tfor each summaryOrder in eligibleOrders\n\t\t{\n\t\t\t\tsummaryResponses = Add_Supplier_Quote[Supplier == supplierId &amp;&amp; Sales_Order == summaryOrder.ID];\n\t\t\t\tif(summaryResponses.count() == 0)\n\t\t\t\t{\n\t\t\t\t\t\tawaitingCount = awaitingCount + 1;\n\t\t\t\t}\n\t\t\t\tif(summaryOrder.Requested_Delivery_Date != null &amp;&amp; summaryOrder.Requested_Delivery_Date &gt;= zoho.currentdate &amp;&amp; summaryOrder.Requested_Delivery_Date &lt;= zoho.currentdate.addDay(7))\n\t\t\t\t{\n\t\t\t\t\t\tdueSoonCount = dueSoonCount + 1;\n\t\t\t\t}\n\t\t}\n}\n%&gt;\n&lt;style&gt;\n/* ZCS global utility sheet: page-scoped rules used by this single snippet. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row-wrap{flex-wrap:wrap}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:.625rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-lh-body{line-height:1.5}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-sticky{position:sticky}.zcs-relative{position:relative}.zcs-card{background:#fff;border:1px solid #e6e2ee;border-radius:12px}a{text-decoration:none}\n.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%;width:100%}.zc-container-wrapper .zc-main-content .inner,.zc-page-content-wrapper,.zc-pb-page-content-wrapper,.zc-pb-tile-container,.zc-pb-tile-card{max-width:none!important;width:100%!important;box-sizing:border-box}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}#splash-screen,.zc-page-loader{display:none!important}\n/* ZCS: card-sample-4, badge-filled-outlined-badge, table-simple-table, button-primary-button, button-primary-outline-button, no-data-no-data. */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto;border:1px solid}.zcs-badge-theme{background:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#167c59}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#245bcc}.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#946200}.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#c92c42}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;line-height:normal;min-width:760px}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:#f8f6fc;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper tbody tr:hover td{background:#faf9fc}\n.rfq-page{min-height:100%;padding:18px;background:#f7f5fa;color:var(--zcs_primary_text_color);font:14px/1.45 Arial,sans-serif;box-sizing:border-box}.rfq-header{padding:20px 22px;border:1px solid #e2dceb;border-left:4px solid #76539b;border-radius:12px;background:#fff}.eyebrow{color:#76539b;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.rfq-title{margin:3px 0 0;font-size:24px;line-height:1.2}.rfq-copy{margin:5px 0 0;color:var(--zcs_secondary_text_color)}.supplier-chip{padding:7px 10px;border-radius:8px;background:#f1edf6;color:#5f437c}.identity-state{max-width:760px;margin:36px auto;padding:32px;border:1px solid #e2dceb;border-radius:12px;background:#fff;text-align:center}.identity-state&gt;i{font-size:34px;color:#76539b}.identity-state p{color:var(--zcs_secondary_text_color)}.summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:12px 0}.metric{padding:12px 14px;border:1px solid #e6e2ee;border-radius:10px;background:#fff}.metric-top{display:flex;align-items:center;justify-content:space-between;gap:8px}.metric-icon{color:#76539b;font-size:17px}.metric-label{color:var(--zcs_secondary_text_color);font-size:12px}.metric-value{margin-top:2px;font-size:21px;font-weight:700}.metric.alert .metric-value,.metric.alert .metric-icon{color:#a56a08}.register-head{margin:15px 2px 9px}.register-title{margin:0;font-size:16px}.register-copy{color:var(--zcs_secondary_text_color);font-size:12px}.rfq-register{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;max-height:690px;overflow:auto;padding:1px 5px 4px 1px}.request-card{min-width:0;height:560px;overflow:hidden;display:flex;flex-direction:column}.request-head{padding:14px 16px;border-bottom:1px solid #e6e2ee;background:#faf8fc}.request-id{font-size:17px;font-weight:600}.request-body{padding:14px 16px 15px;overflow:auto;display:flex;flex:1;flex-direction:column}.meta-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-bottom:11px}.meta{min-width:0;padding:9px 10px;border:1px solid #ece8f1;border-radius:8px;background:#fbfafc;overflow-wrap:anywhere}.meta-label{display:flex;align-items:center;gap:5px;color:var(--zcs_secondary_text_color);font-size:12px;margin-bottom:2px}.meta-label i{color:#76539b}.products{max-height:230px}.action-row{margin-top:auto;padding-top:12px}.empty{min-height:360px;margin-top:12px}.empty-icon{font-size:34px;color:#76539b}.mobile-products{display:none}.mobile-product{padding:10px;border:1px solid var(--zcs_tertiary_border_color);border-radius:8px}.mobile-product+.mobile-product{margin-top:8px}.mobile-kv{display:grid;grid-template-columns:100px 1fr;gap:4px 7px;margin-top:7px}.mobile-kv span:nth-child(odd){color:var(--zcs_secondary_text_color)}\n@media(max-width:1050px){.summary{grid-template-columns:repeat(2,1fr)}.rfq-register{grid-template-columns:1fr;max-height:760px}.request-card{height:570px}}@media(max-width:650px){.rfq-page{padding:10px}.rfq-header{padding:16px}.supplier-chip{width:100%;box-sizing:border-box}.summary{grid-template-columns:1fr 1fr}.meta-grid{grid-template-columns:1fr}.desktop-products{display:none}.mobile-products{display:block;max-height:270px;overflow:auto}.request-card{height:610px}.action-row .zcs-button{width:100%}}@media(max-width:420px){.summary{grid-template-columns:1fr}.rfq-title{font-size:21px}.request-card{height:640px}}\n&lt;/style&gt;\n&lt;div class=&apos;rfq-page&apos;&gt;\n\t&lt;header class=&apos;rfq-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-row-wrap&apos;&gt;\n\t\t&lt;div&gt;&lt;div class=&apos;eyebrow&apos;&gt;Supplier workspace&lt;/div&gt;&lt;h1 class=&apos;rfq-title&apos;&gt;Requests for quote&lt;/h1&gt;&lt;p class=&apos;rfq-copy&apos;&gt;Demand, response status, and delivery deadlines in one guarded workspace.&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;supplier-chip&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-05&apos;&gt;&lt;/i&gt; &lt;%if(identityReady){%&gt;&lt;strong&gt;&lt;%=supplierName%&gt;&lt;/strong&gt;&lt;br&gt;&lt;%}%&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;&lt;%=loginEmail%&gt;&lt;/span&gt;&lt;/div&gt;\n\t&lt;/header&gt;\n\t&lt;%if(!identityReady){%&gt;\n\t\t&lt;section class=&apos;identity-state&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-alert-circle&apos;&gt;&lt;/i&gt;&lt;%if(supplierCount==0){%&gt;&lt;h2&gt;No active supplier account found&lt;/h2&gt;&lt;p&gt;This login is not linked to an active supplier. For privacy, quote requests are not shown. Ask your portal administrator to verify &lt;strong&gt;&lt;%=loginEmail%&gt;&lt;/strong&gt;.&lt;/p&gt;&lt;%}else{%&gt;&lt;h2&gt;Supplier account needs review&lt;/h2&gt;&lt;p&gt;More than one active supplier record uses &lt;strong&gt;&lt;%=loginEmail%&gt;&lt;/strong&gt;. No request or quote data is shown until an administrator resolves the duplicate mapping.&lt;/p&gt;&lt;%}%&gt;&lt;/section&gt;\n\t&lt;%}else{%&gt;\n\t\t&lt;section class=&apos;summary&apos;&gt;\n\t\t\t&lt;div class=&apos;metric&apos;&gt;&lt;div class=&apos;metric-top&apos;&gt;&lt;span class=&apos;metric-label&apos;&gt;Eligible demand&lt;/span&gt;&lt;i class=&apos;metric-icon zc-li-outline files-archive-drawer&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;metric-value&apos;&gt;&lt;%=eligibleOrders.count()%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;metric&apos;&gt;&lt;div class=&apos;metric-top&apos;&gt;&lt;span class=&apos;metric-label&apos;&gt;Awaiting response&lt;/span&gt;&lt;i class=&apos;metric-icon zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;metric-value&apos;&gt;&lt;%=awaitingCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;metric&apos;&gt;&lt;div class=&apos;metric-top&apos;&gt;&lt;span class=&apos;metric-label&apos;&gt;Quotes submitted&lt;/span&gt;&lt;i class=&apos;metric-icon zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;metric-value&apos;&gt;&lt;%=myQuotes.count()%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;metric &lt;%if(dueSoonCount&gt;0){%&gt;alert&lt;%}%&gt;&apos;&gt;&lt;div class=&apos;metric-top&apos;&gt;&lt;span class=&apos;metric-label&apos;&gt;Due within 7 days&lt;/span&gt;&lt;i class=&apos;metric-icon zc-li-outline ui-1-calendar-60&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;metric-value&apos;&gt;&lt;%=dueSoonCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t\t&lt;%if(eligibleOrders.count()==0){%&gt;\n\t\t\t&lt;div class=&apos;zcs-card empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;i class=&apos;empty-icon zc-li-outline files-archive-drawer&apos;&gt;&lt;/i&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-medium zcs-mt-10 zcs-mb-0&apos;&gt;No eligible open requests&lt;/h2&gt;&lt;p class=&apos;zcs-color-secondary&apos;&gt;Requests available to your supplier account will appear here when they are open for quotation.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;%}else{%&gt;\n\t\t\t&lt;div class=&apos;register-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-row-wrap&apos;&gt;&lt;h2 class=&apos;register-title&apos;&gt;Open RFQ register&lt;/h2&gt;&lt;span class=&apos;register-copy&apos;&gt;Sorted by requested delivery date&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;main class=&apos;rfq-register&apos;&gt;\n\t\t\t&lt;%for each orderRec in eligibleOrders\n\t\t\t{\n\t\t\t\t\tproductRows = Sales_Order_Product[Parent_Sales_Order == orderRec.ID];\n\t\t\t\t\texistingQuotes = Add_Supplier_Quote[Supplier == supplierId &amp;&amp; Sales_Order == orderRec.ID] sort by Quote_Date descending;\n\t\t\t\t\thasResponse = existingQuotes.count() &gt; 0;\n\t\t\t\t\turgencyLabel = &quot;Open deadline&quot;;\n\t\t\t\t\turgencyBadge = &quot;zcs-badge-theme&quot;;\n\t\t\t\t\tif(orderRec.Requested_Delivery_Date != null)\n\t\t\t\t\t{\n\t\t\t\t\t\t\tif(orderRec.Requested_Delivery_Date &lt; zoho.currentdate)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\turgencyLabel = &quot;Delivery date passed&quot;;\n\t\t\t\t\t\t\t\t\turgencyBadge = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse if(orderRec.Requested_Delivery_Date &lt;= zoho.currentdate.addDay(7))\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\turgencyLabel = &quot;Due within 7 days&quot;;\n\t\t\t\t\t\t\t\t\turgencyBadge = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t%&gt;\n\t\t\t\t&lt;article class=&apos;request-card zcs-card&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;request-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-row-wrap&apos;&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;div class=&apos;request-id&apos;&gt;&lt;%=orderRec.Sales_Order_ID%&gt;&lt;/div&gt;&lt;div class=&apos;zcs-color-secondary zcs-font-12&apos;&gt;Order date &lt;%=ifnull(orderRec.Sales_Order_Date,&quot;Not specified&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-6 zcs-row-wrap&apos;&gt;&lt;span class=&apos;zcs-badge &lt;%=urgencyBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;%=urgencyLabel%&gt;&lt;/span&gt;&lt;%if(hasResponse){%&gt;&lt;span class=&apos;zcs-badge zcs-badge-green zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;Responded&lt;/span&gt;&lt;%}else{%&gt;&lt;span class=&apos;zcs-badge zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-refresh-69&apos;&gt;&lt;/i&gt;Awaiting response&lt;/span&gt;&lt;%}%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;request-body&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;meta-grid&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;meta&apos;&gt;&lt;span class=&apos;meta-label&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-content&apos;&gt;&lt;/i&gt;Requirement&lt;/span&gt;&lt;%=ifnull(orderRec.Customer_Requirements,&quot;Not provided&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;meta&apos;&gt;&lt;span class=&apos;meta-label&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-60&apos;&gt;&lt;/i&gt;Requested delivery&lt;/span&gt;&lt;%=ifnull(orderRec.Requested_Delivery_Date,&quot;Not specified&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;meta&apos;&gt;&lt;span class=&apos;meta-label&apos;&gt;&lt;i class=&apos;zc-li-outline location-pin&apos;&gt;&lt;/i&gt;Source&lt;/span&gt;&lt;%=ifnull(orderRec.Requirement_Source,&quot;Not specified&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;meta&apos;&gt;&lt;span class=&apos;meta-label&apos;&gt;&lt;i class=&apos;zc-li-outline files-notebook&apos;&gt;&lt;/i&gt;Additional remarks&lt;/span&gt;&lt;%=ifnull(orderRec.Additional_Remarks,&quot;None&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;%if(productRows.count()==0){%&gt;&lt;div class=&apos;zcs-color-secondary&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt; No product requirement lines are available.&lt;/div&gt;&lt;%}else{%&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm products desktop-products&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Product&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Configuration&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Technical requirement&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Quantity&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Availability / lead time&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%for each productRec in productRows{%&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;strong&gt;&lt;%=ifnull(productRec.Product_Name,&quot;Product&quot;)%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&apos;zcs-color-secondary&apos;&gt;&lt;%=ifnull(productRec.Brand_Make,&quot;&quot;)%&gt; &lt;%=ifnull(productRec.Model,&quot;&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(productRec.Configuration,&quot;Not specified&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(productRec.Technical_Requirements,&quot;Not specified&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=productRec.Quantity%&gt; &lt;%=ifnull(productRec.Unit_of_Measure,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(productRec.Required_Availability,&quot;Not specified&quot;)%&gt;&lt;br&gt;&lt;%=ifnull(productRec.Required_Lead_Time,&quot;Not specified&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;mobile-products&apos;&gt;&lt;%for each productRec in productRows{%&gt;&lt;div class=&apos;mobile-product&apos;&gt;&lt;strong&gt;&lt;%=ifnull(productRec.Product_Name,&quot;Product&quot;)%&gt;&lt;/strong&gt;&lt;div class=&apos;mobile-kv&apos;&gt;&lt;span&gt;Configuration&lt;/span&gt;&lt;span&gt;&lt;%=ifnull(productRec.Configuration,&quot;Not specified&quot;)%&gt;&lt;/span&gt;&lt;span&gt;Technical&lt;/span&gt;&lt;span&gt;&lt;%=ifnull(productRec.Technical_Requirements,&quot;Not specified&quot;)%&gt;&lt;/span&gt;&lt;span&gt;Quantity&lt;/span&gt;&lt;span&gt;&lt;%=productRec.Quantity%&gt; &lt;%=ifnull(productRec.Unit_of_Measure,&quot;&quot;)%&gt;&lt;/span&gt;&lt;span&gt;Availability&lt;/span&gt;&lt;span&gt;&lt;%=ifnull(productRec.Required_Availability,&quot;Not specified&quot;)%&gt;&lt;/span&gt;&lt;span&gt;Lead time&lt;/span&gt;&lt;span&gt;&lt;%=ifnull(productRec.Required_Lead_Time,&quot;Not specified&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t\t&lt;div class=&apos;action-row zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12 zcs-row-wrap&apos;&gt;&lt;span class=&apos;zcs-color-secondary&apos;&gt;&lt;%if(hasResponse){%&gt;Your latest quote is on file.&lt;%}else{%&gt;A supplier response is required.&lt;%}%&gt;&lt;/span&gt;&lt;%if(hasResponse){for each quoteRec in existingQuotes{%&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:All_Supplier_Quotes?ID=&lt;%=quoteRec.ID%&gt;&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;span&gt;View quote&lt;/span&gt;&lt;/a&gt;&lt;%break;}}else{%&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Add_Supplier_Quote?Supplier=&lt;%=supplierId%&gt;&amp;amp;Sales_Order=&lt;%=orderRec.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;span&gt;Submit quote&lt;/span&gt;&lt;/a&gt;&lt;%}%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/article&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t&lt;/main&gt;\n\t\t&lt;%}%&gt;\n\t&lt;%}%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Return_Request_Detail(int Return_Request_ID)
		{
					displayname = "Return Request Detail"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Return_Request_Detail_Snippet' elementName='Return_Request_Detail'>\n\t\t\t\t\t<![CDATA[htmlpage Return_Request_Detail_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nrequestList = Create_Return_Request[ID == input.Return_Request_ID];\n%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color,#6147E5);--zcs-light-bg-color:var(--zcs_brand_light_color,#F1EDFF);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color,#1C1C40);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#65657A);--zcs-tertiary-text-color:var(--zcs_tertiary_text_color,#878895);--zcs-border-color:var(--zcs_tertiary_border_color,#E7E7EE);--zcs-white-color:#FFF;font-size:16px;line-height:1.5}*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-row-wrap{flex-wrap:wrap}.zcs-gap-4{gap:4px}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-gap-24{gap:24px}.zcs-p-0{padding:0}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-12{padding-top:12px;padding-bottom:12px}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:4px}.zcs-mt-8{margin-top:8px}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-half{border-radius:50%}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-22{font-size:22px}.zcs-font-24{font-size:24px}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-tertiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}a{text-decoration:none}\n#splash-screen{display:none!important}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .Layout.elemContainment,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%!important;padding:0!important}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important;border-radius:0!important}\n.zcs-badge{width:max-content;white-space:nowrap;border:1px solid}.zcs-badge-green{background:#E4FCF3;border-color:#179E6C;color:#117A55}.zcs-badge-red{background:#FDE3E6;border-color:#FE455D;color:#C52F43}.zcs-badge-blue{background:#E8EFFF;border-color:#2A6FFC;color:#245AC7}.zcs-badge-yellow{background:#FCF4E6;border-color:#FAAE13;color:#966109}.zcs-badge-violet{background:#F7EEFD;border-color:#8200DB;color:#6C1AA5}.zcs-button{width:auto;min-height:36px;border:1px solid var(--zcs-theme-brand-color)}.zcs-primary-button{background:var(--zcs-theme-brand-color);color:#FFF}.zcs-primary-outline-button{background:#FFF;color:var(--zcs-theme-brand-color)}.zcs-toast{border-left:4px solid}.zcs-success-toast{background:#edf7ed;color:#1d4620;border-color:#2e7d32}.zcs-info-toast{background:#e4f6fd;color:#024361;border-color:#0588d1}.zcs-warning-toast{background:#fef4e5;color:#663c01;border-color:#ed6c03}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:#FFF;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:860px}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper thead th{background:#F9FAFE;box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper tbody td{border-top:1px solid var(--zcs-border-color);vertical-align:top}.zcs-table-wrapper tbody tr:hover td{background:#F9FAFE}.zcs-tl-indicator{width:28px;left:0}.zcs-tl-dot{width:10px;height:10px;background:var(--zcs-theme-brand-color);border:1px solid #FFF;box-shadow:0 2px 6px #C4DEE4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:&apos;&apos;;position:absolute;width:1px;height:calc(100% + 20px);background:#E1E1E1;top:5px}\n.rrd-page{height:100%;overflow:auto;background:var(--zcs-page-bg-color);padding:16px;font:14px/1.5 Arial,sans-serif;color:var(--zcs-primary-text-color)}.rrd-shell{max-width:1500px;margin:auto}.rrd-stack{display:flex;flex-direction:column;gap:16px}.identity{padding:16px 20px}.back-link{width:34px;height:34px;border:1px solid var(--zcs-border-color);color:var(--zcs-secondary-text-color);flex:0 0 auto}.eyebrow{font-size:11px;letter-spacing:.08em;color:var(--zcs-tertiary-text-color);font-weight:600}.identity h1{font-size:22px;margin:1px 0}.identity-meta{color:var(--zcs-secondary-text-color);overflow-wrap:anywhere}.section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px}.section-title{font-size:16px;font-weight:600;margin:0}.section-note,.meta{font-size:12px;color:var(--zcs-secondary-text-color)}.workspace{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(320px,.75fr);gap:16px;align-items:start}.workspace-main,.workspace-side{display:flex;flex-direction:column;gap:16px}.workspace-side{position:sticky;top:16px}.context-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.context-item{padding:13px;background:#F9FAFE;border:1px solid var(--zcs-border-color);border-radius:8px;min-width:0}.context-item label{display:block;font-size:12px;color:var(--zcs-secondary-text-color);margin-bottom:4px}.context-item strong,.context-item span{display:block;overflow-wrap:anywhere}.context-icon{width:30px;height:30px;flex:0 0 30px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color)}.narrative{white-space:pre-wrap;overflow-wrap:anywhere;min-height:88px;padding:14px;background:#F9FAFE;border:1px solid var(--zcs-border-color);border-radius:8px}.resolution-callout{padding:14px;background:var(--zcs-light-bg-color);border-radius:8px}.resolution-callout label{display:block;font-size:12px;color:var(--zcs-secondary-text-color)}.resolution-actions{display:grid;grid-template-columns:1fr;gap:8px;margin-top:14px}.link{color:var(--zcs-theme-brand-color)}.stepper{display:flex;padding:4px 0 2px}.step{flex:1;position:relative;text-align:center;color:var(--zcs-tertiary-text-color)}.step:not(:last-child):before{content:&apos;&apos;;position:absolute;top:15px;left:50%;width:100%;height:1px;background:var(--zcs-border-color)}.step-dot{position:relative;z-index:1;width:30px;height:30px;margin:0 auto 6px;border:1px solid var(--zcs-border-color);background:#FFF}.step.done .step-dot{background:#179E6C;border-color:#179E6C;color:#FFF}.step.active .step-dot{border-color:var(--zcs-theme-brand-color);color:var(--zcs-theme-brand-color);background:var(--zcs-light-bg-color)}.step.done:not(:last-child):before{background:#179E6C}.document-link{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 12px;border:1px solid var(--zcs-border-color);border-radius:8px;color:var(--zcs-primary-text-color)}.related-scroll{height:360px;overflow:auto}.history-scroll{height:360px;overflow:auto;padding-right:6px}.timeline-content{padding-left:36px}.history-note,.text-block{white-space:pre-wrap;overflow-wrap:anywhere}.empty{height:140px;color:var(--zcs-secondary-text-color)}.product-cards{display:none}.not-found{min-height:320px}.qty{font-variant-numeric:tabular-nums}\n@media(max-width:980px){.workspace{grid-template-columns:1fr}.workspace-side{position:static}.context-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media(max-width:700px){.rrd-page{height:auto;padding:10px}.identity{align-items:flex-start;flex-direction:column}.context-grid{grid-template-columns:1fr}.stepper{flex-direction:column;gap:12px}.step{display:flex;align-items:center;gap:10px;text-align:left}.step-dot{margin:0}.step:not(:last-child):before{top:28px;left:14px;width:1px;height:28px}.desktop-products{display:none}.product-cards{display:flex;height:420px;overflow:auto}.product-card{padding:14px;border:1px solid var(--zcs-border-color);border-radius:8px}.related-scroll,.history-scroll{height:420px}.zcs-card{padding:14px!important}}\n&lt;/style&gt;\n&lt;div class=&apos;rrd-page&apos;&gt;&lt;div class=&apos;rrd-shell&apos;&gt;\n&lt;%if(requestList.count() == 0){%&gt;\n&lt;div class=&apos;zcs-card not-found zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-search-zoom-out zcs-font-24 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-medium&apos;&gt;Return request not found&lt;/h2&gt;&lt;p class=&apos;zcs-color-secondary&apos;&gt;No accessible record matches this Return_Request_ID.&lt;/p&gt;&lt;a class=&apos;link zcs-font-semibold&apos; href=&apos;#Page:Return_Requests&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-left&apos;&gt;&lt;/i&gt; Return requests&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%}else{request=requestList;products=Return_Request_Product[Parent_Return_Request == request.ID] sort by ID asc;history=Add_History[Return_Request_Lookup == request.ID] sort by Updated_Date_Time desc;latestStatus=&quot;Submitted&quot;;latestFound=false;for each statusEvent in history{if(!latestFound){latestStatus=ifnull(statusEvent.New_Status,ifnull(statusEvent.Status,&quot;Submitted&quot;));latestFound=true;}}isResolved=latestStatus.toLowerCase().contains(&quot;resolved&quot;) || latestStatus.toLowerCase().contains(&quot;complete&quot;) || latestStatus.toLowerCase().contains(&quot;closed&quot;);isRejected=latestStatus.toLowerCase().contains(&quot;reject&quot;) || latestStatus.toLowerCase().contains(&quot;cancel&quot;);statusClass=if(isResolved,&quot;zcs-badge-green&quot;,if(isRejected,&quot;zcs-badge-red&quot;,&quot;zcs-badge-blue&quot;));nextStep=if(isResolved,&quot;Resolution complete&quot;,if(isRejected,&quot;Review closure notes&quot;,if(request.Damage_Responsibility == &quot;Supplier&quot;,&quot;Confirm supplier remedy and financial recovery&quot;,&quot;Record decision, quantities, and customer outcome&quot;)));supplierName=&quot;Not set&quot;;poLabel=&quot;Not set&quot;;poStatus=&quot;Not set&quot;;poCurrency=&quot;&quot;;poValue=0.0;salesOrderLabel=&quot;Not set&quot;;customerName=&quot;Not set&quot;;createdBy=&quot;Not set&quot;;poID=null;salesOrderID=null;if(request.Customer != null){customerName=ifnull(request.Customer.Customer_Name,&quot;Not set&quot;);}if(request.Sales_Order != null){salesOrderID=request.Sales_Order.ID;salesOrderLabel=ifnull(request.Sales_Order.Sales_Order_ID,&quot;Not set&quot;);}if(request.Purchase_Order != null){poID=request.Purchase_Order.ID;poLabel=ifnull(request.Purchase_Order.Purchase_Order_ID,&quot;Not set&quot;);poStatus=ifnull(request.Purchase_Order.Status,&quot;Not set&quot;);poCurrency=ifnull(request.Purchase_Order.Currency,&quot;&quot;);poValue=ifnull(request.Purchase_Order.Supplier_Price,0.0);if(request.Purchase_Order.Supplier != null){supplierName=ifnull(request.Purchase_Order.Supplier.Supplier_Name,&quot;Not set&quot;);}}if(request.Created_By != null){createdBy=ifnull(request.Created_By.Employee_Name,ifnull(request.Created_By_Email,&quot;Not set&quot;));}else{createdBy=ifnull(request.Created_By_Email,&quot;Not set&quot;);}totalDelivered=0.0;totalReturned=0.0;estimatedReturnValue=0.0;evidenceCount=0;if(request.Attachments != null &amp;&amp; request.Attachments != &quot;&quot;){evidenceCount=evidenceCount + 1;}for each calcItem in products{deliveredQty=ifnull(calcItem.Delivered_Quantity,0.0);returnedQty=ifnull(calcItem.Return_Quantity,0.0);totalDelivered=totalDelivered + deliveredQty;totalReturned=totalReturned + returnedQty;if(calcItem.Attachments != null &amp;&amp; calcItem.Attachments != &quot;&quot;){evidenceCount=evidenceCount + 1;}if(calcItem.Purchase_Order_Product != null){unitPrice=ifnull(calcItem.Purchase_Order_Product.Supplier_Unit_Price,0.0);estimatedReturnValue=estimatedReturnValue + (returnedQty * unitPrice);}}returnShare=0.0;if(totalDelivered &gt; 0){returnShare=(totalReturned * 100.0) / totalDelivered;}%&gt;\n&lt;div class=&apos;rrd-stack&apos;&gt;\n&lt;header class=&apos;identity zcs-card zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;&lt;a class=&apos;back-link zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-md&apos; href=&apos;#Page:Return_Requests&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-left&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;div&gt;&lt;div class=&apos;eyebrow&apos;&gt;RETURN REQUEST&lt;/div&gt;&lt;h1&gt;&lt;%=request.Return_Request_ID%&gt;&lt;/h1&gt;&lt;div class=&apos;identity-meta&apos;&gt;&lt;%=customerName%&gt; | &lt;%=ifnull(request.Return_Date,&quot;Return date not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-px-10 zcs-py-2 zcs-rounded-sm &lt;%=statusClass%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=if(isResolved,&quot;ui-1-check-circle-08&quot;,if(isRejected,&quot;ui-1-circle-remove&quot;,&quot;loader-dots-06&quot;))%&gt;&apos;&gt;&lt;/i&gt;&lt;%=latestStatus%&gt;&lt;/span&gt;&lt;/header&gt;\n&lt;div class=&apos;zcs-toast &lt;%=if(isResolved,&quot;zcs-success-toast&quot;,if(isRejected,&quot;zcs-warning-toast&quot;,&quot;zcs-info-toast&quot;))%&gt; zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=if(isResolved,&quot;ui-1-check-circle-08&quot;,if(isRejected,&quot;ui-3-alert&quot;,&quot;travel-info&quot;))%&gt;&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;Next step&lt;/strong&gt;&lt;div&gt;&lt;%=nextStep%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;div class=&apos;workspace&apos;&gt;&lt;main class=&apos;workspace-main&apos;&gt;\n&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;section-title&apos;&gt;Return context&lt;/h2&gt;&lt;div class=&apos;section-note&apos;&gt;Source, parties, quantities, and exposure&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-violet zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=products.count()%&gt; products&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;context-grid&apos;&gt;&lt;div class=&apos;context-item zcs-flex zcs-gap-12&apos;&gt;&lt;span class=&apos;context-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-02&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;label&gt;Customer&lt;/label&gt;&lt;strong&gt;&lt;%=customerName%&gt;&lt;/strong&gt;&lt;span class=&apos;meta&apos;&gt;Created by &lt;%=createdBy%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;context-item zcs-flex zcs-gap-12&apos;&gt;&lt;span class=&apos;context-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline business-handshake&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;label&gt;Supplier&lt;/label&gt;&lt;strong&gt;&lt;%=supplierName%&gt;&lt;/strong&gt;&lt;span class=&apos;meta&apos;&gt;PO status: &lt;%=poStatus%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;context-item zcs-flex zcs-gap-12&apos;&gt;&lt;span class=&apos;context-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-folded-content&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;label&gt;Purchase order&lt;/label&gt;&lt;%if(poID != null){%&gt;&lt;a class=&apos;link zcs-font-semibold&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=poID%&gt;&apos;&gt;&lt;%=poLabel%&gt;&lt;/a&gt;&lt;%}else{%&gt;&lt;strong&gt;Not set&lt;/strong&gt;&lt;%}%&gt;&lt;span class=&apos;meta&apos;&gt;&lt;%=poCurrency%&gt; &lt;%=poValue%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;context-item zcs-flex zcs-gap-12&apos;&gt;&lt;span class=&apos;context-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;label&gt;Sales order&lt;/label&gt;&lt;%if(salesOrderID != null){%&gt;&lt;a class=&apos;link zcs-font-semibold&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=salesOrderID%&gt;&apos;&gt;&lt;%=salesOrderLabel%&gt;&lt;/a&gt;&lt;%}else{%&gt;&lt;strong&gt;Not set&lt;/strong&gt;&lt;%}%&gt;&lt;span class=&apos;meta&apos;&gt;Return date: &lt;%=ifnull(request.Return_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;context-item zcs-flex zcs-gap-12&apos;&gt;&lt;span class=&apos;context-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-2-reload&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;label&gt;Returned quantity&lt;/label&gt;&lt;strong class=&apos;qty&apos;&gt;&lt;%=totalReturned%&gt; / &lt;%=totalDelivered%&gt;&lt;/strong&gt;&lt;span class=&apos;meta&apos;&gt;&lt;%=returnShare.round(1)%&gt;% of delivered scope&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;context-item zcs-flex zcs-gap-12&apos;&gt;&lt;span class=&apos;context-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zc-li-outline business-coins&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;label&gt;Estimated return value&lt;/label&gt;&lt;strong&gt;&lt;%=poCurrency%&gt; &lt;%=estimatedReturnValue.round(2)%&gt;&lt;/strong&gt;&lt;span class=&apos;meta&apos;&gt;&lt;%=evidenceCount%&gt; attachment groups&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;context-grid zcs-mt-8&apos;&gt;&lt;div&gt;&lt;h3 class=&apos;zcs-font-14 zcs-font-semibold&apos;&gt;Issue description&lt;/h3&gt;&lt;div class=&apos;narrative&apos;&gt;&lt;%=ifnull(request.Issue_Description,&quot;No issue description provided&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;h3 class=&apos;zcs-font-14 zcs-font-semibold&apos;&gt;Return remarks&lt;/h3&gt;&lt;div class=&apos;narrative&apos;&gt;&lt;%=ifnull(request.Return_Remarks,&quot;No resolution remarks recorded&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;section-title&apos;&gt;Affected products&lt;/h2&gt;&lt;div class=&apos;section-note&apos;&gt;Configuration, quantities, defect, responsibility, and evidence&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-blue zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=products.count()%&gt; rows&lt;/span&gt;&lt;/div&gt;&lt;%if(products.count()==0){%&gt;&lt;div class=&apos;empty zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-box zcs-font-22 zcs-color-tertiary&apos;&gt;&lt;/i&gt;&lt;strong&gt;No returned products&lt;/strong&gt;&lt;span&gt;Add affected products from the return request.&lt;/span&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;zcs-table-wrapper desktop-products related-scroll zcs-rounded-md zcs-relative&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Product&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Configuration / serial&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Delivered&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Returned&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Defect / owner&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Evidence / remarks&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%for each item in products{%&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;strong&gt;&lt;%=ifnull(item.Product_Name,&quot;Unnamed product&quot;)%&gt;&lt;/strong&gt;&lt;span class=&apos;meta&apos;&gt;&lt;%=ifnull(item.Product_ID,&quot;No product ID&quot;)%&gt; | &lt;%=ifnull(item.Product_Category,&quot;No category&quot;)%&gt;&lt;/span&gt;&lt;span class=&apos;meta&apos;&gt;&lt;%=ifnull(item.Manufacturer_Part_Number,&quot;No MPN&quot;)%&gt; | &lt;%=ifnull(item.Internal_Part_Number,&quot;No internal part&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 text-block&apos;&gt;&lt;%=ifnull(item.Configuration,&quot;Not set&quot;)%&gt;&lt;span class=&apos;meta&apos;&gt;Serial: &lt;%=ifnull(item.Serial_Number,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right qty&apos;&gt;&lt;%=ifnull(item.Delivered_Quantity,0)%&gt; &lt;%=ifnull(item.Unit_of_Measure,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-semibold qty&apos;&gt;&lt;%=ifnull(item.Return_Quantity,0)%&gt; &lt;%=ifnull(item.Unit_of_Measure,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 text-block&apos;&gt;&lt;%=ifnull(item.Defect_Description,&quot;No defect description&quot;)%&gt;&lt;span class=&apos;zcs-badge zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm &lt;%=if(item.Damage_Responsibility == &quot;Supplier&quot;,&quot;zcs-badge-yellow&quot;,&quot;zcs-badge-blue&quot;)%&gt;&apos;&gt;&lt;%=ifnull(item.Damage_Responsibility,&quot;Not assigned&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%if(item.Attachments != null &amp;&amp; item.Attachments != &quot;&quot;){%&gt;&lt;a class=&apos;link zcs-font-semibold&apos; href=&apos;&lt;%=item.Attachments%&gt;&apos; target=&apos;_blank&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt; Evidence&lt;/a&gt;&lt;%}else{%&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;No evidence&lt;/span&gt;&lt;%}%&gt;&lt;span class=&apos;meta text-block&apos;&gt;&lt;%=ifnull(item.Remarks,&quot;No remarks&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;div class=&apos;product-cards zcs-direction-column zcs-gap-12&apos;&gt;&lt;%for each card in products{%&gt;&lt;article class=&apos;product-card&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div&gt;&lt;strong&gt;&lt;%=ifnull(card.Product_Name,&quot;Unnamed product&quot;)%&gt;&lt;/strong&gt;&lt;div class=&apos;meta&apos;&gt;&lt;%=ifnull(card.Product_ID,&quot;No product ID&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-px-10 zcs-py-2 zcs-rounded-sm &lt;%=if(card.Damage_Responsibility == &quot;Supplier&quot;,&quot;zcs-badge-yellow&quot;,&quot;zcs-badge-blue&quot;)%&gt;&apos;&gt;&lt;%=ifnull(card.Damage_Responsibility,&quot;Not assigned&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;context-grid zcs-mt-8&apos;&gt;&lt;div&gt;&lt;span class=&apos;meta&apos;&gt;Delivered&lt;/span&gt;&lt;strong&gt;&lt;%=ifnull(card.Delivered_Quantity,0)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&apos;meta&apos;&gt;Returned&lt;/span&gt;&lt;strong&gt;&lt;%=ifnull(card.Return_Quantity,0)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&apos;text-block&apos;&gt;&lt;%=ifnull(card.Defect_Description,&quot;No defect description&quot;)%&gt;&lt;/p&gt;&lt;%if(card.Attachments != null &amp;&amp; card.Attachments != &quot;&quot;){%&gt;&lt;a class=&apos;link zcs-font-semibold&apos; href=&apos;&lt;%=card.Attachments%&gt;&apos; target=&apos;_blank&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt; Open evidence&lt;/a&gt;&lt;%}else{%&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;No product evidence attached&lt;/span&gt;&lt;%}%&gt;&lt;/article&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/section&gt;\n&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;section-title&apos;&gt;Resolution history&lt;/h2&gt;&lt;div class=&apos;section-note&apos;&gt;Latest update first&lt;/div&gt;&lt;/div&gt;&lt;a class=&apos;link zcs-font-semibold&apos; href=&apos;#Report:All_Histories?Return_Request_Lookup=&lt;%=request.ID%&gt;&apos;&gt;Full history &lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;&lt;%if(history.count()==0){%&gt;&lt;div class=&apos;empty zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time zcs-font-22 zcs-color-tertiary&apos;&gt;&lt;/i&gt;&lt;strong&gt;No history recorded&lt;/strong&gt;&lt;span&gt;Status and decision updates will appear here.&lt;/span&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;history-scroll&apos;&gt;&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-24 zcs-p-0 zcs-m-0&apos;&gt;&lt;%for each event in history{eventBy=ifnull(event.Updated_By_Email,&quot;System&quot;);if(event.Updated_By != null){eventBy=ifnull(event.Updated_By.Employee_Name,eventBy);}%&gt;&lt;li class=&apos;zcs-tl-li zcs-relative&apos; style=&apos;list-style:none&apos;&gt;&lt;div class=&apos;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&apos;&gt;&lt;span class=&apos;zcs-tl-dot zcs-rounded-half zcs-relative&apos;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;timeline-content&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&apos;&gt;&lt;strong class=&apos;zcs-font-16&apos;&gt;&lt;%=event.Action_Type%&gt;&lt;/strong&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;%=event.Updated_Date_Time%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;By &lt;%=eventBy%&gt;&lt;%if(event.Previous_Status != null || event.New_Status != null){%&gt; | &lt;%=ifnull(event.Previous_Status,&quot;Not set&quot;)%&gt; to &lt;%=ifnull(event.New_Status,ifnull(event.Status,&quot;Not set&quot;))%&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%if(event.Comments != null &amp;&amp; event.Comments != &quot;&quot;){%&gt;&lt;p class=&apos;history-note zcs-mt-8 zcs-mb-0&apos;&gt;&lt;%=event.Comments%&gt;&lt;/p&gt;&lt;%}%&gt;&lt;%if(event.Subform_Details_Change_Summary != null &amp;&amp; event.Subform_Details_Change_Summary != &quot;&quot;){%&gt;&lt;p class=&apos;history-note zcs-mt-8 zcs-mb-0 zcs-color-tertiary&apos;&gt;&lt;%=event.Subform_Details_Change_Summary%&gt;&lt;/p&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/li&gt;&lt;%}%&gt;&lt;/ul&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/section&gt;\n&lt;/main&gt;&lt;aside class=&apos;workspace-side&apos;&gt;\n&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;section-title&apos;&gt;Resolution&lt;/h2&gt;&lt;div class=&apos;section-note&apos;&gt;&lt;%=history.count()%&gt; recorded updates&lt;/div&gt;&lt;/div&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08 zcs-font-18 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;stepper&apos;&gt;&lt;div class=&apos;step done&apos;&gt;&lt;div class=&apos;step-dot zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-small&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;strong&gt;Submitted&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;step &lt;%=if(isResolved,&quot;done&quot;,&quot;active&quot;)%&gt;&apos;&gt;&lt;div class=&apos;step-dot zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=if(isResolved,&quot;ui-1-check-small&quot;,&quot;loader-dots-06&quot;)%&gt;&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;strong&gt;Decision&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;step &lt;%=if(isResolved,&quot;done&quot;,&quot;&quot;)%&gt;&apos;&gt;&lt;div class=&apos;step-dot zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=if(isResolved,&quot;ui-1-check-small&quot;,&quot;ui-2-time&quot;)%&gt;&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;strong&gt;Resolved&lt;/strong&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;resolution-callout zcs-mt-8&apos;&gt;&lt;label&gt;Decision owner&lt;/label&gt;&lt;strong&gt;&lt;%=ifnull(request.Damage_Responsibility,&quot;Not assigned&quot;)%&gt;&lt;/strong&gt;&lt;div class=&apos;meta zcs-mt-4&apos;&gt;&lt;%=nextStep%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;resolution-actions&apos;&gt;&lt;%if(!isResolved &amp;&amp; !isRejected){%&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Form:Add_History?Return_Request_Lookup=&lt;%=request.ID%&gt;&amp;amp;Purchase_Order_Lookup=&lt;%=poID%&gt;&amp;amp;Sales_Order_Lookup=&lt;%=salesOrderID%&gt;&amp;amp;Action_Type=Status Changed&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt; Record status&lt;/a&gt;&lt;%}%&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Form:Create_Return_Request?recLinkID=&lt;%=request.ID%&gt;&amp;amp;viewLinkName=All_Return_Requests&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt; Update request&lt;/a&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;section-title&apos;&gt;Evidence&lt;/h2&gt;&lt;div class=&apos;section-note&apos;&gt;&lt;%=evidenceCount%&gt; attachment groups&lt;/div&gt;&lt;/div&gt;&lt;i class=&apos;zc-li-outline files-folder-15 zcs-font-18 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;%if(request.Attachments == null || request.Attachments == &quot;&quot;) {%&gt;&lt;div class=&apos;empty zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;i class=&apos;zc-li-outline files-single zcs-font-22 zcs-color-tertiary&apos;&gt;&lt;/i&gt;&lt;strong&gt;No request-level evidence&lt;/strong&gt;&lt;span&gt;Product evidence remains available in affected products.&lt;/span&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;a class=&apos;document-link&apos; href=&apos;&lt;%=request.Attachments%&gt;&apos; target=&apos;_blank&apos;&gt;&lt;span class=&apos;zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;&lt;i class=&apos;zc-li-outline files-folder-15 zcs-font-18&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;strong&gt;Return attachments&lt;/strong&gt;&lt;small class=&apos;meta&apos;&gt;Open submitted evidence&lt;/small&gt;&lt;/span&gt;&lt;/span&gt;&lt;i class=&apos;zc-li-outline arrows-2-square-download zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;%}%&gt;&lt;/section&gt;\n&lt;/aside&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}%&gt;\n&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Return_Requests
		{
					displayname = "Return Requests"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Return_Requests_List' elementName='Return_Requests_List'>\n\t\t\t\t\t<![CDATA[htmlpage Return_Requests_List()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nreturnRequests = Create_Return_Request[ID != 0] sort by Return_Date desc;\nreturnTotal = returnRequests.count();\nreturnUnassignedCount = 0;\nreturnCompanyCount = 0;\nreturnSupplierCount = 0;\nfor each returnSummaryRecord in returnRequests\n{\n\treturnSummaryOwner = ifnull(returnSummaryRecord.Damage_Responsibility,&quot;&quot;);\n\tif(returnSummaryOwner == &quot;Company&quot;)\n\t{\n\t\treturnCompanyCount = returnCompanyCount + 1;\n\t}\n\telse if(returnSummaryOwner == &quot;Supplier&quot;)\n\t{\n\t\treturnSupplierCount = returnSupplierCount + 1;\n\t}\n\telse\n\t{\n\t\treturnUnassignedCount = returnUnassignedCount + 1;\n\t}\n}\n%&gt;\n&lt;style&gt;\n/* ZCS global utilities used by this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#f5f4f8;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff}\n*{box-sizing:border-box}#splash-screen{display:none!important}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%!important}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-w-full{width:100%}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-8{padding-left:8px;padding-right:8px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-6{padding-top:6px;padding-bottom:6px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:8px}.zcs-mt-10{margin-top:10px}.zcs-mt-12{margin-top:12px}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-font-11{font-size:11px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-18{font-size:18px}.zcs-font-22{font-size:22px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}a{text-decoration:none}\n.rr-page{min-height:100%;padding:14px;background:var(--zcs-page-bg-color);font:14px/1.45 Arial,sans-serif;color:var(--zcs-primary-text-color)}.rr-header{padding:15px 18px;background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.rr-heading{min-width:0}.rr-icon{width:34px;height:34px;flex:0 0 34px;border-radius:9px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);font-size:17px}.rr-title{font-size:22px}.rr-subtitle{margin:2px 0 0;color:var(--zcs-secondary-text-color);font-size:13px}.rr-total{white-space:nowrap;color:var(--zcs-secondary-text-color);font-size:12px}.rr-total strong{display:block;color:var(--zcs-primary-text-color);font-size:18px;text-align:right}.rr-target{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}\n.rr-status-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:10px 0}.rr-filter{min-width:0;padding:10px 12px;background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:10px;color:var(--zcs-secondary-text-color);display:flex;align-items:center;justify-content:space-between;gap:8px}.rr-filter span{display:flex;align-items:center;gap:7px;min-width:0}.rr-filter strong{font-size:18px;color:var(--zcs-primary-text-color)}.rr-filter i{color:var(--zcs-theme-brand-color)}.rr-filter:hover{border-color:var(--zcs-theme-brand-color);background:var(--zcs-light-bg-color)}#all:target~.rr-status-strip a[href=&apos;#all&apos;],#unassigned:target~.rr-status-strip a[href=&apos;#unassigned&apos;],#company:target~.rr-status-strip a[href=&apos;#company&apos;],#supplier:target~.rr-status-strip a[href=&apos;#supplier&apos;]{border-color:var(--zcs-theme-brand-color);box-shadow:0 0 0 1px var(--zcs-theme-brand-color) inset;background:var(--zcs-light-bg-color)}#unassigned:target~.rr-scroll .rr-record:not(.state-unassigned),#company:target~.rr-scroll .rr-record:not(.state-company),#supplier:target~.rr-scroll .rr-record:not(.state-supplier){display:none}\n.rr-scroll{height:480px;min-height:320px;overflow:hidden;border-radius:12px}.zcs-table-wrapper{height:100%;border:1px solid var(--zcs-border-color);background:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:1320px}.zcs-table-wrapper thead{top:0;z-index:3}.zcs-table-wrapper thead th{background:#f8f7fb;box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap;color:var(--zcs-secondary-text-color);font-size:12px;text-transform:uppercase;letter-spacing:.03em}.zcs-table-wrapper tbody td{border-top:1px solid var(--zcs-border-color);vertical-align:top;padding-top:12px;padding-bottom:12px}.zcs-table-wrapper tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper tbody tr:hover td{background:#faf9fc}.record-link{font-weight:600;color:var(--zcs-theme-brand-color)}.subtle{display:block;margin-top:3px;color:var(--zcs-secondary-text-color);font-size:12px}.reason{display:block;max-width:260px;white-space:normal}.order-stack{white-space:nowrap}.owner{display:flex;align-items:flex-start;gap:7px}.owner i{margin-top:2px;color:var(--zcs-theme-brand-color)}\n.zcs-badge{width:auto;border:1px solid;white-space:nowrap}.zcs-badge-filled-outline.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#147b57}.zcs-badge-filled-outline.zcs-badge-yellow{background:#fcf4e6;border-color:#e6a11a;color:#8a5b00}.zcs-badge-filled-outline.zcs-badge-blue{background:#eee9ff;border-color:#7255c7;color:#6041b4}.zcs-badge-filled-outline.zcs-badge-grey{background:#f1f1f3;border-color:#85858d;color:#55555d}.zcs-primary-outline-button{width:auto;min-width:0;min-height:32px;border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs-theme-brand-color)}.zcs-primary-outline-button:hover{background:var(--zcs-light-bg-color)}\n.zcs-nodata-wrapper{height:100%;min-height:320px;background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.empty-icon{width:54px;height:54px;margin:auto;border-radius:50%;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);font-size:24px}.empty-desc{max-width:430px;color:var(--zcs-secondary-text-color)}.mobile-list{display:none;height:100%;overflow:auto}.mobile-card{padding:14px;margin-bottom:9px}.card-head,.card-footer{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.card-grid{margin:12px 0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.kv{min-width:0}.kv-label{display:block;color:var(--zcs-secondary-text-color);font-size:10px;text-transform:uppercase;letter-spacing:.05em}.kv-value{display:block;margin-top:2px;overflow-wrap:anywhere}.card-reason{margin:0 0 12px;padding:10px;border-radius:8px;background:#f8f7fb}.card-owner{margin:0 0 12px}.card-footer{align-items:center;border-top:1px solid var(--zcs-border-color);padding-top:12px}.card-date{color:var(--zcs-secondary-text-color);font-size:12px}\n@media(max-width:900px){.rr-page{padding:10px}.rr-status-strip{grid-template-columns:repeat(2,minmax(0,1fr))}.desktop-table{display:none}.mobile-list{display:block}.rr-scroll{height:560px}.rr-total{display:none}}@media(max-width:520px){.rr-header{align-items:flex-start}.rr-icon{display:none}.rr-title{font-size:19px}.rr-status-strip{display:flex;overflow:auto;padding-bottom:2px}.rr-filter{flex:0 0 150px}.card-grid{grid-template-columns:1fr}.zcs-primary-outline-button{min-width:36px}.action-text{display:none}}\n&lt;/style&gt;\n&lt;div class=&apos;rr-page&apos;&gt;\n\t&lt;span id=&apos;all&apos; class=&apos;rr-target&apos;&gt;&lt;/span&gt;&lt;span id=&apos;unassigned&apos; class=&apos;rr-target&apos;&gt;&lt;/span&gt;&lt;span id=&apos;company&apos; class=&apos;rr-target&apos;&gt;&lt;/span&gt;&lt;span id=&apos;supplier&apos; class=&apos;rr-target&apos;&gt;&lt;/span&gt;\n\t&lt;header class=&apos;rr-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t&lt;div class=&apos;rr-heading zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;span class=&apos;rr-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-reply-all&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h1 class=&apos;rr-title zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Return register&lt;/h1&gt;&lt;p class=&apos;rr-subtitle&apos;&gt;Cause, ownership, resolution state, and linked order context.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;rr-total&apos;&gt;&lt;strong&gt;&lt;%=returnTotal%&gt;&lt;/strong&gt;total requests&lt;/div&gt;\n\t&lt;/header&gt;\n\t&lt;nav class=&apos;rr-status-strip&apos; aria-label=&apos;Resolution filters&apos;&gt;\n\t\t&lt;a class=&apos;rr-filter&apos; href=&apos;#all&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline ui-1-list-bullet&apos;&gt;&lt;/i&gt;All returns&lt;/span&gt;&lt;strong&gt;&lt;%=returnTotal%&gt;&lt;/strong&gt;&lt;/a&gt;\n\t\t&lt;a class=&apos;rr-filter&apos; href=&apos;#unassigned&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;Unassigned&lt;/span&gt;&lt;strong&gt;&lt;%=returnUnassignedCount%&gt;&lt;/strong&gt;&lt;/a&gt;\n\t\t&lt;a class=&apos;rr-filter&apos; href=&apos;#company&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline business-briefcase-24&apos;&gt;&lt;/i&gt;Company owned&lt;/span&gt;&lt;strong&gt;&lt;%=returnCompanyCount%&gt;&lt;/strong&gt;&lt;/a&gt;\n\t\t&lt;a class=&apos;rr-filter&apos; href=&apos;#supplier&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline transportation-truck-front&apos;&gt;&lt;/i&gt;Supplier owned&lt;/span&gt;&lt;strong&gt;&lt;%=returnSupplierCount%&gt;&lt;/strong&gt;&lt;/a&gt;\n\t&lt;/nav&gt;\n\t&lt;div class=&apos;rr-scroll&apos;&gt;\n\t&lt;%if(returnTotal == 0){%&gt;\n\t\t&lt;section class=&apos;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;&lt;div class=&apos;empty-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-inbox&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;No return requests&lt;/h2&gt;&lt;p class=&apos;empty-desc zcs-font-14 zcs-font-normal zcs-lh-body zcs-mt-12 zcs-mx-0 zcs-mb-0&apos;&gt;Return requests will appear here with their reported cause, assigned owner, and linked sales and purchase orders.&lt;/p&gt;&lt;/div&gt;&lt;/section&gt;\n\t&lt;%}else{%&gt;\n\t\t&lt;div class=&apos;zcs-table-wrapper desktop-table zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Request&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Cause&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Resolution&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Owner&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Customer&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Linked orders&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Products&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Created by&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Action&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t&lt;%for each returnRegisterRecord in returnRequests{\n\t\t\tregisterProductCount=Return_Request_Product[Parent_Return_Request == returnRegisterRecord.ID].count();\n\t\t\tregisterResponsibility=ifnull(returnRegisterRecord.Damage_Responsibility,&quot;&quot;);\n\t\t\tregisterRequestNumber=ifnull(returnRegisterRecord.Return_Request_ID,&quot;Return request&quot;);\n\t\t\tregisterCustomerName=&quot;Not set&quot;;if(returnRegisterRecord.Customer != null){registerCustomerName=ifnull(returnRegisterRecord.Customer.Customer_Name,&quot;Not set&quot;);}\n\t\t\tregisterPurchaseOrderNumber=&quot;Not set&quot;;if(returnRegisterRecord.Purchase_Order != null){registerPurchaseOrderNumber=ifnull(returnRegisterRecord.Purchase_Order.Purchase_Order_ID,&quot;Not set&quot;);}\n\t\t\tregisterSalesOrderNumber=&quot;Not set&quot;;if(returnRegisterRecord.Sales_Order != null){registerSalesOrderNumber=ifnull(returnRegisterRecord.Sales_Order.Sales_Order_ID,&quot;Not set&quot;);}\n\t\t\tregisterCreatedByName=&quot;Not set&quot;;if(returnRegisterRecord.Created_By != null){registerCreatedByName=ifnull(returnRegisterRecord.Created_By.Employee_Name.first_name,&quot;Not set&quot;);}\n\t\t\tregisterReturnDate=&quot;Not set&quot;;if(returnRegisterRecord.Return_Date != null){registerReturnDate=returnRegisterRecord.Return_Date.toString(&quot;dd-MMM-yyyy&quot;);}\n\t\t\tregisterStateClass=&quot;state-unassigned&quot;;registerResolution=&quot;Needs assignment&quot;;registerBadgeClass=&quot;zcs-badge-yellow&quot;;registerBadgeIcon=&quot;ui-2-time&quot;;registerOwner=&quot;Not assigned&quot;;\n\t\t\tif(registerResponsibility == &quot;Company&quot;){registerStateClass=&quot;state-company&quot;;registerResolution=&quot;Internal resolution&quot;;registerBadgeClass=&quot;zcs-badge-blue&quot;;registerBadgeIcon=&quot;loader-dots-06&quot;;registerOwner=&quot;Company&quot;;}else if(registerResponsibility == &quot;Supplier&quot;){registerStateClass=&quot;state-supplier&quot;;registerResolution=&quot;Supplier resolution&quot;;registerBadgeClass=&quot;zcs-badge-green&quot;;registerBadgeIcon=&quot;ui-1-check-circle-08&quot;;registerOwner=&quot;Supplier&quot;;}%&gt;\n\t\t\t&lt;tr class=&apos;rr-record &lt;%=registerStateClass%&gt;&apos;&gt;&lt;td class=&apos;zcs-px-16&apos;&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Return_Request_Detail?Return_Request_ID=&lt;%=returnRegisterRecord.ID%&gt;&apos;&gt;&lt;%=registerRequestNumber%&gt;&lt;/a&gt;&lt;span class=&apos;subtle&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-60&apos;&gt;&lt;/i&gt; &lt;%=registerReturnDate%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16&apos;&gt;&lt;span class=&apos;reason&apos;&gt;&lt;%=ifnull(returnRegisterRecord.Issue_Description,&quot;No reason provided&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=registerBadgeClass%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=registerBadgeIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;%=registerResolution%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16&apos;&gt;&lt;span class=&apos;owner&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-05&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=registerOwner%&gt;&lt;span class=&apos;subtle&apos;&gt;&lt;%=if(registerResponsibility != &quot;&quot;,registerResponsibility,&quot;Responsibility not set&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16&apos;&gt;&lt;%=registerCustomerName%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16&apos;&gt;&lt;span class=&apos;order-stack&apos;&gt;SO: &lt;%=registerSalesOrderNumber%&gt;&lt;span class=&apos;subtle&apos;&gt;PO: &lt;%=registerPurchaseOrderNumber%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16&apos;&gt;&lt;%=registerProductCount%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16&apos;&gt;&lt;%=registerCreatedByName%&gt;&lt;span class=&apos;subtle&apos;&gt;&lt;%=ifnull(returnRegisterRecord.Created_By_Email,&quot;&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16&apos;&gt;&lt;a class=&apos;zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-md&apos; href=&apos;#Page:Return_Request_Detail?Return_Request_ID=&lt;%=returnRegisterRecord.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-eye-17&apos;&gt;&lt;/i&gt;&lt;span class=&apos;action-text&apos;&gt;Open&lt;/span&gt;&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;mobile-list&apos;&gt;&lt;%for each returnMobileRecord in returnRequests{\n\t\t\tmobileProductCount=Return_Request_Product[Parent_Return_Request == returnMobileRecord.ID].count();mobileResponsibility=ifnull(returnMobileRecord.Damage_Responsibility,&quot;&quot;);mobileRequestNumber=ifnull(returnMobileRecord.Return_Request_ID,&quot;Return request&quot;);\n\t\t\tmobileCustomerName=&quot;Not set&quot;;if(returnMobileRecord.Customer != null){mobileCustomerName=ifnull(returnMobileRecord.Customer.Customer_Name,&quot;Not set&quot;);}\n\t\t\tmobilePurchaseOrderNumber=&quot;Not set&quot;;if(returnMobileRecord.Purchase_Order != null){mobilePurchaseOrderNumber=ifnull(returnMobileRecord.Purchase_Order.Purchase_Order_ID,&quot;Not set&quot;);}\n\t\t\tmobileSalesOrderNumber=&quot;Not set&quot;;if(returnMobileRecord.Sales_Order != null){mobileSalesOrderNumber=ifnull(returnMobileRecord.Sales_Order.Sales_Order_ID,&quot;Not set&quot;);}\n\t\t\tmobileCreatedByName=&quot;Not set&quot;;if(returnMobileRecord.Created_By != null){mobileCreatedByName=ifnull(returnMobileRecord.Created_By.Employee_Name.first_name,&quot;Not set&quot;);}\n\t\t\tmobileReturnDate=&quot;Not set&quot;;if(returnMobileRecord.Return_Date != null){mobileReturnDate=returnMobileRecord.Return_Date.toString(&quot;dd-MMM-yyyy&quot;);}\n\t\t\tmobileStateClass=&quot;state-unassigned&quot;;mobileResolution=&quot;Needs assignment&quot;;mobileBadgeClass=&quot;zcs-badge-yellow&quot;;mobileBadgeIcon=&quot;ui-2-time&quot;;mobileOwner=&quot;Not assigned&quot;;\n\t\t\tif(mobileResponsibility == &quot;Company&quot;){mobileStateClass=&quot;state-company&quot;;mobileResolution=&quot;Internal resolution&quot;;mobileBadgeClass=&quot;zcs-badge-blue&quot;;mobileBadgeIcon=&quot;loader-dots-06&quot;;mobileOwner=&quot;Company&quot;;}else if(mobileResponsibility == &quot;Supplier&quot;){mobileStateClass=&quot;state-supplier&quot;;mobileResolution=&quot;Supplier resolution&quot;;mobileBadgeClass=&quot;zcs-badge-green&quot;;mobileBadgeIcon=&quot;ui-1-check-circle-08&quot;;mobileOwner=&quot;Supplier&quot;;}%&gt;\n\t\t\t&lt;article class=&apos;rr-record &lt;%=mobileStateClass%&gt; mobile-card zcs-card&apos;&gt;&lt;div class=&apos;card-head&apos;&gt;&lt;div&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Return_Request_Detail?Return_Request_ID=&lt;%=returnMobileRecord.ID%&gt;&apos;&gt;&lt;%=mobileRequestNumber%&gt;&lt;/a&gt;&lt;span class=&apos;subtle&apos;&gt;&lt;%=mobileCustomerName%&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=mobileBadgeClass%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=mobileBadgeIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;%=mobileResolution%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;card-grid&apos;&gt;&lt;div class=&apos;kv&apos;&gt;&lt;span class=&apos;kv-label&apos;&gt;Sales order&lt;/span&gt;&lt;span class=&apos;kv-value&apos;&gt;&lt;%=mobileSalesOrderNumber%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;span class=&apos;kv-label&apos;&gt;Purchase order&lt;/span&gt;&lt;span class=&apos;kv-value&apos;&gt;&lt;%=mobilePurchaseOrderNumber%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;span class=&apos;kv-label&apos;&gt;Products&lt;/span&gt;&lt;span class=&apos;kv-value&apos;&gt;&lt;%=mobileProductCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;span class=&apos;kv-label&apos;&gt;Created by&lt;/span&gt;&lt;span class=&apos;kv-value&apos;&gt;&lt;%=mobileCreatedByName%&gt;&lt;span class=&apos;subtle&apos;&gt;&lt;%=ifnull(returnMobileRecord.Created_By_Email,&quot;&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&apos;card-reason&apos;&gt;&lt;span class=&apos;kv-label&apos;&gt;Reported cause&lt;/span&gt;&lt;span class=&apos;kv-value&apos;&gt;&lt;%=ifnull(returnMobileRecord.Issue_Description,&quot;No reason provided&quot;)%&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&apos;card-owner owner&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-05&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;span class=&apos;kv-label&apos;&gt;Resolution owner&lt;/span&gt;&lt;%=mobileOwner%&gt;&lt;span class=&apos;subtle&apos;&gt;&lt;%=if(mobileResponsibility != &quot;&quot;,mobileResponsibility,&quot;Responsibility not set&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;div class=&apos;card-footer&apos;&gt;&lt;span class=&apos;card-date&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-60&apos;&gt;&lt;/i&gt; &lt;%=mobileReturnDate%&gt;&lt;/span&gt;&lt;a class=&apos;zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-md&apos; href=&apos;#Page:Return_Request_Detail?Return_Request_ID=&lt;%=returnMobileRecord.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-eye-17&apos;&gt;&lt;/i&gt;&lt;span&gt;Open return&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/article&gt;\n\t\t&lt;%}%&gt;&lt;/div&gt;\n\t&lt;%}%&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Sales_Dashboard
		{
					displayname = "Sales Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Sales_Dashboard_Snippet' elementName='Sales_Dashboard_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Sales_Dashboard_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t\t&lt;%\nnewLeads = Add_Lead[Status == &quot;New&quot;] sort by Lead_Date desc;\nactiveOrders = Create_Sales_Order[Status != &quot;Delivered&quot; &amp;&amp; Status != &quot;Return Requested&quot;] sort by Requested_Delivery_Date asc;\npoHandoffs = Create_Purchase_Order[Status != &quot;Delivered&quot;] sort by Expected_Delivery_Date asc;\nunpaidInvoices = Add_Supplier_Invoice[Status != &quot;Paid&quot;] sort by Invoice_Date asc;\nopenBookings = Create_Logistics_Booking[Status != &quot;Products Received&quot;] sort by Expected_Arrival_Date asc;\nreturnWork = Create_Return_Request[ID != 0] sort by Return_Date desc;\noverdueOrders = 0;\nfor each orderItem in activeOrders\n{\n\tif(orderItem.Requested_Delivery_Date != null &amp;&amp; orderItem.Requested_Delivery_Date &lt; zoho.currentdate)\n\t{\n\t\toverdueOrders = overdueOrders + 1;\n\t}\n}\noverdueInvoices = 0;\nfor each invoiceItem in unpaidInvoices\n{\n\tif(invoiceItem.Invoice_Date != null &amp;&amp; invoiceItem.Invoice_Date &lt; zoho.currentdate.subDay(30))\n\t{\n\t\toverdueInvoices = overdueInvoices + 1;\n\t}\n}\n%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#f7f6fb;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-thead-color:#f7f5fc;--zcs-tr-h-color:#faf9fd;--violet-soft:#f1edff;--violet-mid:#7357c7;--green-soft:#e8f8f1;--red-soft:#fdecef;--amber-soft:#fff4dc;--blue-soft:#eaf2ff}\n*{box-sizing:border-box}#splash-screen{display:none!important}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%!important}.zc-container-wrapper .zc-main-content .inner,.zc-page-content-wrapper,.zc-pb-page-content-wrapper{width:100%!important;max-width:none!important}.zc-pb-page-content-wrapper .zc-pb-tile-container,.zc-pb-page-content-wrapper .zc-pb-tile-card{padding:0!important;border-radius:0!important;box-shadow:none!important}\n.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-rounded-sm{border-radius:4px}.zcs-font-12{font-size:12px}.zcs-font-14{font-size:14px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-lh-body{line-height:1.5}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-sticky{position:sticky}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-theme{background:var(--violet-soft);border-color:#c8bafa;color:#6548bd}.zcs-badge-green{background:var(--green-soft);border-color:#61bd98;color:#147c58}.zcs-badge-red{background:var(--red-soft);border-color:#ed91a0;color:#c42e48}.zcs-badge-yellow{background:var(--amber-soft);border-color:#e9be59;color:#8e6508}.zcs-badge-blue{background:var(--blue-soft);border-color:#88ace9;color:#315fba}.zcs-badge-orange{background:#fff0e6;border-color:#e8a070;color:#ae560f}\n.sales-dashboard{min-height:100%;background:var(--zcs-page-bg-color);font:14px/1.45 Arial,sans-serif;color:var(--zcs-primary-text-color)}.dashboard-content{max-width:1760px;margin:auto;padding:18px 20px 26px}.workspace-title{display:flex;align-items:center;gap:10px;margin:0 0 12px}.workspace-title i{width:34px;height:34px;border-radius:10px;background:var(--violet-soft);color:var(--violet-mid);display:flex;align-items:center;justify-content:center;font-size:18px}.workspace-title h1{font-size:20px;line-height:1.2;margin:0}.workspace-title p{font-size:12px;color:var(--zcs-secondary-text-color);margin:2px 0 0}.kpi-grid{display:grid;grid-template-columns:repeat(6,minmax(112px,1fr));gap:8px;margin-bottom:14px}.kpi{min-height:64px;padding:10px 12px;border-radius:10px}.kpi-icon{width:30px;height:30px;border-radius:8px;background:var(--violet-soft);color:var(--violet-mid);font-size:15px;flex:0 0 auto}.kpi-value{font-size:18px;font-weight:600;line-height:1.1}.kpi-label{font-size:11px;color:var(--zcs-secondary-text-color);margin-top:2px}.kpi.exception .kpi-icon{background:var(--red-soft);color:#c42e48}.kpi.exception .kpi-value{color:#c42e48}.section-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.work-section{height:342px;overflow:hidden;display:flex;flex-direction:column;border-top:3px solid #baa7ef}.section-head{padding:11px 14px 10px;border-bottom:1px solid var(--zcs-border-color);min-height:59px}.section-title{display:flex;align-items:center;gap:9px;min-width:0}.section-icon{width:30px;height:30px;display:flex;align-items:center;justify-content:center;border-radius:8px;background:var(--violet-soft);color:var(--violet-mid);font-size:15px;flex:0 0 auto}.section-head h2{font-size:15px;margin:0;line-height:1.2}.section-subtitle{font-size:11px;color:var(--zcs-secondary-text-color);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.section-count{font-size:11px;font-weight:600;color:#6548bd;background:var(--violet-soft);border:1px solid #d8cdf8;border-radius:999px;padding:2px 8px;white-space:nowrap}.section-body{height:280px;overflow:auto}.zcs-table-wrapper{height:100%;overflow:auto;background:var(--zcs-white-color)}.zcs-table-wrapper table{width:100%;min-width:620px;border-collapse:collapse;line-height:normal}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:var(--zcs-thead-color);box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap;font-size:11px;font-weight:600;color:var(--zcs-secondary-text-color);padding:8px 10px;text-align:left}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color);padding:9px 10px;font-size:12px;vertical-align:middle}.zcs-table-wrapper tbody tr:first-child td{border-top:0}.zcs-table-wrapper tbody tr:hover td{background:var(--zcs-tr-h-color)}.record-link,.row-action{color:var(--violet-mid);text-decoration:none;font-weight:600;white-space:nowrap}.muted{color:var(--zcs-secondary-text-color)}.empty-state{height:100%;min-height:210px;flex-direction:column;padding:24px;color:var(--zcs-secondary-text-color)}.empty-icon{width:42px;height:42px;border-radius:12px;background:var(--green-soft);color:#17835f;font-size:20px;margin-bottom:9px}.empty-state h3{font-size:14px;color:var(--zcs-primary-text-color);margin:0 0 3px}.empty-state p{font-size:12px;margin:0;text-align:center;max-width:300px}\n@media(max-width:1180px){.kpi-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:820px){.dashboard-content{padding:14px}.section-grid{grid-template-columns:1fr}.work-section{height:330px}.section-body{height:268px}}@media(max-width:520px){.dashboard-content{padding:10px}.kpi-grid{grid-template-columns:repeat(2,1fr)}.workspace-title p,.section-subtitle{display:none}.work-section{height:320px}.section-body{height:258px}}\n&lt;/style&gt;\n&lt;div class=&apos;sales-dashboard&apos;&gt;\n\t&lt;main class=&apos;dashboard-content&apos;&gt;\n\t\t&lt;div class=&apos;workspace-title&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-bar-32&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;h1&gt;Sales operations&lt;/h1&gt;&lt;p&gt;Pipeline movement, commercial handoffs, delivery commitments, and return resolution.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;kpi-grid&apos; aria-label=&apos;Operational summary&apos;&gt;\n\t\t\t&lt;div class=&apos;kpi zcs-card&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-goal-65&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;div class=&apos;kpi-value&apos;&gt;&lt;%=newLeads.count()%&gt;&lt;/div&gt;&lt;div class=&apos;kpi-label&apos;&gt;New leads&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;kpi zcs-card&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-list&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;div class=&apos;kpi-value&apos;&gt;&lt;%=activeOrders.count()%&gt;&lt;/div&gt;&lt;div class=&apos;kpi-label&apos;&gt;Active orders&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;kpi zcs-card&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-cart&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;div class=&apos;kpi-value&apos;&gt;&lt;%=poHandoffs.count()%&gt;&lt;/div&gt;&lt;div class=&apos;kpi-label&apos;&gt;PO handoffs&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;kpi exception zcs-card&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;div class=&apos;kpi-value&apos;&gt;&lt;%=overdueOrders%&gt;&lt;/div&gt;&lt;div class=&apos;kpi-label&apos;&gt;Orders overdue&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;kpi exception zcs-card&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-receipt&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;div class=&apos;kpi-value&apos;&gt;&lt;%=overdueInvoices%&gt;&lt;/div&gt;&lt;div class=&apos;kpi-label&apos;&gt;Invoices over 30 days&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;kpi zcs-card&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-box&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;div class=&apos;kpi-value&apos;&gt;&lt;%=returnWork.count()%&gt;&lt;/div&gt;&lt;div class=&apos;kpi-label&apos;&gt;Return requests&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;section-grid&apos;&gt;\n\t\t\t&lt;section class=&apos;work-section zcs-card&apos;&gt;&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;span class=&apos;section-icon&apos;&gt;&lt;i class=&apos;zc-li-outline business-goal-65&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Lead qualification&lt;/h2&gt;&lt;div class=&apos;section-subtitle&apos;&gt;Newest opportunities awaiting movement&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;section-count&apos;&gt;&lt;%=newLeads.count()%&gt; open&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;section-body&apos;&gt;&lt;%if(newLeads.count() == 0){%&gt;&lt;div class=&apos;empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;span class=&apos;empty-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;h3&gt;Lead queue is clear&lt;/h3&gt;&lt;p&gt;New customer requirements will appear here for qualification.&lt;/p&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th&gt;Lead&lt;/th&gt;&lt;th&gt;Customer&lt;/th&gt;&lt;th&gt;Contact&lt;/th&gt;&lt;th&gt;Date&lt;/th&gt;&lt;th&gt;Expected value&lt;/th&gt;&lt;th&gt;Handoff&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%for each leadRec in newLeads{%&gt;&lt;tr&gt;&lt;td&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Report:All_Leads?ID=&lt;%=leadRec.ID%&gt;&apos;&gt;&lt;%=ifnull(leadRec.Lead_ID,&quot;Lead&quot;)%&gt;&lt;/a&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ifnull(leadRec.Customer_Company_Name,&quot;Customer not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;muted&apos;&gt;&lt;%=ifnull(leadRec.Contact_Person,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;muted&apos;&gt;&lt;%=ifnull(leadRec.Lead_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ifnull(leadRec.Expected_Price,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;a class=&apos;row-action&apos; href=&apos;#Form:Create_Sales_Order?Lead=&lt;%=leadRec.ID%&gt;&amp;Requirement_Source=Customer Request&apos;&gt;Create order&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t\t&lt;section class=&apos;work-section zcs-card&apos;&gt;&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;span class=&apos;section-icon&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-list&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Sales order commitments&lt;/h2&gt;&lt;div class=&apos;section-subtitle&apos;&gt;Customer promises and sourcing readiness&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;section-count&apos;&gt;&lt;%=activeOrders.count()%&gt; active&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;section-body&apos;&gt;&lt;%if(activeOrders.count() == 0){%&gt;&lt;div class=&apos;empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;span class=&apos;empty-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;h3&gt;No active sales orders&lt;/h3&gt;&lt;p&gt;There are no customer orders requiring follow-up.&lt;/p&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th&gt;Order&lt;/th&gt;&lt;th&gt;Order date&lt;/th&gt;&lt;th&gt;Requested delivery&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;th&gt;Timing&lt;/th&gt;&lt;th&gt;Detail&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%for each orderRec in activeOrders{statusText=ifnull(orderRec.Status,&quot;Status not set&quot;);overdue=false;if(orderRec.Requested_Delivery_Date != null &amp;&amp; orderRec.Requested_Delivery_Date &lt; zoho.currentdate){overdue=true;}%&gt;&lt;tr&gt;&lt;td&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=orderRec.ID%&gt;&apos;&gt;&lt;%=ifnull(orderRec.Sales_Order_ID,&quot;Order&quot;)%&gt;&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;muted&apos;&gt;&lt;%=ifnull(orderRec.Sales_Order_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ifnull(orderRec.Requested_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;%=statusText%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;%if(overdue){%&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-red zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;Overdue&lt;/span&gt;&lt;%}else{%&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-green zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;On track&lt;/span&gt;&lt;%}%&gt;&lt;/td&gt;&lt;td&gt;&lt;a class=&apos;row-action&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=orderRec.ID%&gt;&apos;&gt;Open&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t\t&lt;section class=&apos;work-section zcs-card&apos;&gt;&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;span class=&apos;section-icon&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-cart&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Purchase-order handoffs&lt;/h2&gt;&lt;div class=&apos;section-subtitle&apos;&gt;Supplier, approval, and delivery transitions&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;section-count&apos;&gt;&lt;%=poHandoffs.count()%&gt; open&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;section-body&apos;&gt;&lt;%if(poHandoffs.count() == 0){%&gt;&lt;div class=&apos;empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;span class=&apos;empty-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;h3&gt;No PO handoffs&lt;/h3&gt;&lt;p&gt;Open purchase orders will appear here.&lt;/p&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th&gt;Purchase order&lt;/th&gt;&lt;th&gt;PO date&lt;/th&gt;&lt;th&gt;Expected delivery&lt;/th&gt;&lt;th&gt;Currency&lt;/th&gt;&lt;th&gt;Value&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;th&gt;Detail&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%for each poRec in poHandoffs{%&gt;&lt;tr&gt;&lt;td&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=poRec.ID%&gt;&apos;&gt;&lt;%=ifnull(poRec.Purchase_Order_ID,&quot;PO&quot;)%&gt;&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;muted&apos;&gt;&lt;%=ifnull(poRec.PO_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ifnull(poRec.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;muted&apos;&gt;&lt;%=ifnull(poRec.Currency,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ifnull(poRec.Total_Customer_Price,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-orange zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;%=ifnull(poRec.Status,&quot;Status not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;a class=&apos;row-action&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=poRec.ID%&gt;&apos;&gt;Open&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t\t&lt;section class=&apos;work-section zcs-card&apos;&gt;&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;span class=&apos;section-icon&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-receipt&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Supplier invoicing&lt;/h2&gt;&lt;div class=&apos;section-subtitle&apos;&gt;Unpaid invoices, oldest first&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;section-count&apos;&gt;&lt;%=unpaidInvoices.count()%&gt; unpaid&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;section-body&apos;&gt;&lt;%if(unpaidInvoices.count() == 0){%&gt;&lt;div class=&apos;empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;span class=&apos;empty-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;h3&gt;No unpaid invoices&lt;/h3&gt;&lt;p&gt;All recorded supplier invoices are paid.&lt;/p&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th&gt;Invoice&lt;/th&gt;&lt;th&gt;Supplier number&lt;/th&gt;&lt;th&gt;Date&lt;/th&gt;&lt;th&gt;Amount&lt;/th&gt;&lt;th&gt;Age&lt;/th&gt;&lt;th&gt;Action&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%for each invoiceRec in unpaidInvoices{aged=false;if(invoiceRec.Invoice_Date != null &amp;&amp; invoiceRec.Invoice_Date &lt; zoho.currentdate.subDay(30)){aged=true;}%&gt;&lt;tr&gt;&lt;td&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Supplier_Invoice_Detail?Supplier_Invoice_ID=&lt;%=invoiceRec.ID%&gt;&apos;&gt;&lt;%=ifnull(invoiceRec.Supplier_Invoice_ID,&quot;Invoice&quot;)%&gt;&lt;/a&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ifnull(invoiceRec.Supplier_Invoice_Number,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;muted&apos;&gt;&lt;%=ifnull(invoiceRec.Invoice_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ifnull(invoiceRec.Currency,&quot;&quot;)%&gt; &lt;%=ifnull(invoiceRec.Invoice_Amount,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;%if(aged){%&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-red zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;Over 30 days&lt;/span&gt;&lt;%}else{%&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-green zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;Current&lt;/span&gt;&lt;%}%&gt;&lt;/td&gt;&lt;td&gt;&lt;a class=&apos;row-action&apos; href=&apos;#Form:Add_Supplier_Invoice?recLinkID=&lt;%=invoiceRec.ID%&gt;&amp;viewLinkName=All_Supplier_Invoices&amp;Action_Mode=Mark Paid&apos;&gt;Record payment&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t\t&lt;section class=&apos;work-section zcs-card&apos;&gt;&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;span class=&apos;section-icon&apos;&gt;&lt;i class=&apos;zc-li-outline transportation-truck-front&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Delivery progress&lt;/h2&gt;&lt;div class=&apos;section-subtitle&apos;&gt;Bookings moving toward receipt&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;section-count&apos;&gt;&lt;%=openBookings.count()%&gt; moving&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;section-body&apos;&gt;&lt;%if(openBookings.count() == 0){%&gt;&lt;div class=&apos;empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;span class=&apos;empty-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;h3&gt;No open deliveries&lt;/h3&gt;&lt;p&gt;There are no logistics bookings awaiting receipt.&lt;/p&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th&gt;Booking&lt;/th&gt;&lt;th&gt;Provider&lt;/th&gt;&lt;th&gt;Route&lt;/th&gt;&lt;th&gt;Expected arrival&lt;/th&gt;&lt;th&gt;Tracking&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%for each bookingRec in openBookings{%&gt;&lt;tr&gt;&lt;td&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Logistics_Booking_Detail?Logistics_Booking_ID=&lt;%=bookingRec.ID%&gt;&apos;&gt;&lt;%=ifnull(bookingRec.Logistics_Booking_ID,&quot;Booking&quot;)%&gt;&lt;/a&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ifnull(bookingRec.Logistics_Provider,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;muted&apos;&gt;&lt;%=ifnull(bookingRec.Pickup_Location,&quot;Origin not set&quot;)%&gt; to &lt;%=ifnull(bookingRec.Warehouse_Destination,&quot;Destination not set&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ifnull(bookingRec.Expected_Arrival_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;muted&apos;&gt;&lt;%=ifnull(bookingRec.Tracking_Reference,&quot;Pending&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;%=ifnull(bookingRec.Status,&quot;Status not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t\t&lt;section class=&apos;work-section zcs-card&apos;&gt;&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;span class=&apos;section-icon&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-box&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Return resolution&lt;/h2&gt;&lt;div class=&apos;section-subtitle&apos;&gt;Recent requests awaiting ownership&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;section-count&apos;&gt;&lt;%=returnWork.count()%&gt; requests&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;section-body&apos;&gt;&lt;%if(returnWork.count() == 0){%&gt;&lt;div class=&apos;empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;span class=&apos;empty-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;h3&gt;No return requests&lt;/h3&gt;&lt;p&gt;New requests will appear here for review and resolution.&lt;/p&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th&gt;Return&lt;/th&gt;&lt;th&gt;Request date&lt;/th&gt;&lt;th&gt;Issue&lt;/th&gt;&lt;th&gt;Responsibility&lt;/th&gt;&lt;th&gt;Next step&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%for each returnRec in returnWork{%&gt;&lt;tr&gt;&lt;td&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Return_Request_Detail?Return_Request_ID=&lt;%=returnRec.ID%&gt;&apos;&gt;&lt;%=ifnull(returnRec.Return_Request_ID,&quot;Return&quot;)%&gt;&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;muted&apos;&gt;&lt;%=ifnull(returnRec.Return_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ifnull(returnRec.Issue_Description,&quot;No description&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ifnull(returnRec.Damage_Responsibility,&quot;Pending review&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;a class=&apos;row-action&apos; href=&apos;#Page:Return_Request_Detail?Return_Request_ID=&lt;%=returnRec.ID%&gt;&apos;&gt;Review&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;/div&gt;\n\t&lt;/main&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Sales_Order_Detail(int Sales_Order_ID)
		{
					displayname = "Sales Order Detail"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Order_Detail' elementName='Order_Detail'>\n\t\t\t\t\t<![CDATA[htmlpage Order_Detail()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\norders = Create_Sales_Order[ID == input.Sales_Order_ID];\n%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row-wrap{flex-wrap:wrap}.zcs-align-items-center{align-items:center}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-22{font-size:1.375rem}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-text-left{text-align:left}.zcs-no-underline{text-decoration:none}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-badge{width:max-content;white-space:nowrap;border:1px solid}.zcs-badge-green{background:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-yellow{background:#FCF4E6;border-color:#FAAE13;color:#9A6300}.zcs-badge-blue{background:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-orange{background:#F8F0EB;border-color:#F4660C;color:#C44E08}.zcs-badge-grey{background:#e8e8e8;border-color:#5d6470;color:#40454d}.zcs-badge-theme{background:var(--zcs-light-bg-color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}\n.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;min-width:820px}.zcs-table-wrapper thead{position:sticky;top:0;z-index:2}.zcs-table-wrapper th{background:#F9FAFE;white-space:nowrap}.zcs-table-wrapper th,.zcs-table-wrapper td{padding:9px 12px;border-top:1px solid var(--zcs-border-color);font-size:13px;text-align:left;vertical-align:top}.zcs-table-wrapper tbody tr:hover td{background:#F9FAFE}.sod-page{min-height:100%;width:100%;background:var(--zcs-page-bg-color);padding:14px 20px;font:14px Arial,sans-serif;color:var(--zcs-primary-text-color)}.sod-header,.sod-hero,.sod-section{padding:16px}.sod-header{position:relative;border-left:4px solid var(--zcs_brand_color)}.sod-back{width:34px;height:34px;border:1px solid var(--zcs-border-color);border-radius:8px;color:var(--zcs-primary-text-color);flex:none}.sod-eyebrow{font-size:11px;color:var(--zcs-teritiary-text-color);text-transform:uppercase;letter-spacing:.09em}.sod-identity{min-width:220px}.sod-meta{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-top:4px;color:var(--zcs-teritiary-text-color);font-size:12px}.sod-meta span{display:inline-flex;align-items:center;gap:5px}.sod-actions{display:flex;flex-wrap:wrap;gap:8px}.sod-hero{background:#fff}.sod-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.sod-summary-item{display:flex;align-items:center;gap:10px;padding:10px;border:1px solid var(--zcs-border-color);border-radius:8px;background:#F9FAFE}.sod-icon{width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:7px;background:var(--zcs-light-bg-color);color:var(--zcs_brand_color);font-size:16px;flex:none}.sod-label{display:block;color:var(--zcs-teritiary-text-color);font-size:11px;margin-bottom:2px;text-transform:uppercase;letter-spacing:.03em}.sod-value{font-weight:600;overflow-wrap:anywhere}.sod-content{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(310px,.85fr);gap:12px;align-items:start}.sod-stack{display:flex;flex-direction:column;gap:12px}.sod-section{min-width:0}.sod-section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}.sod-title{margin:0;font-size:15px;font-weight:600}.sod-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.sod-kv{padding:8px 10px;border-bottom:1px solid #eef0f4}.sod-copy{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.45}.sod-note-grid,.sod-related{display:grid;grid-template-columns:1fr 1fr;gap:8px}.sod-note{padding:11px;border-radius:8px;background:#F9FAFE}.sod-scroll{height:286px;overflow:auto}.sod-record-scroll{height:286px;overflow:auto;padding-right:4px}.sod-related{height:286px}.sod-related-card{padding:11px;border:1px solid var(--zcs-border-color);border-radius:8px;background:#F9FAFE;min-width:0;overflow:auto}.sod-related-head,.sod-record-head{display:flex;align-items:center;justify-content:space-between;gap:8px;position:sticky;top:-11px;background:#F9FAFE;padding:10px 0;z-index:1}.sod-record{padding:9px 0;border-top:1px solid var(--zcs-border-color);overflow-wrap:anywhere}.sod-empty{min-height:120px;padding:20px;text-align:center;color:var(--zcs-teritiary-text-color);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px}.sod-empty i{font-size:27px;color:var(--zcs_brand_color)}.sod-timeline{list-style:none;margin:0;padding:0}.sod-timeline li{position:relative;padding:0 0 18px 28px}.sod-timeline li:before{content:&apos;&apos;;position:absolute;left:5px;top:5px;width:10px;height:10px;border-radius:50%;background:var(--zcs_brand_color);box-shadow:0 0 0 4px var(--zcs-light-bg-color)}.sod-timeline li:not(:last-child):after{content:&apos;&apos;;position:absolute;left:9px;top:18px;width:1px;height:calc(100% - 9px);background:var(--zcs-border-color)}.sod-route{display:flex;align-items:flex-start;margin-top:14px;overflow-x:auto;padding:2px 0 4px}.sod-route-step{position:relative;flex:1;min-width:105px;text-align:center;color:var(--zcs-teritiary-text-color);font-size:11px}.sod-route-step:not(:last-child):before{content:&apos;&apos;;position:absolute;left:50%;right:-50%;top:13px;height:2px;background:var(--zcs-border-color)}.sod-route-node{position:relative;z-index:1;width:28px;height:28px;margin:0 auto 6px;border:2px solid var(--zcs-border-color);border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:13px}.sod-route-step.on{color:var(--zcs-primary-text-color);font-weight:600}.sod-route-step.on .sod-route-node{border-color:var(--zcs_brand_color);background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.sod-route-step.on:not(:last-child):before{background:var(--zcs_brand_color)}\n#splash-screen{display:none!important}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important;border-radius:0!important}@media(max-width:992px){.sod-page{padding:12px}.sod-content{grid-template-columns:1fr}.sod-summary{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.sod-page{padding:8px}.sod-header,.sod-hero,.sod-section{padding:13px}.sod-summary,.sod-grid,.sod-note-grid,.sod-related{grid-template-columns:1fr}.sod-related{height:auto}.sod-related-card{height:220px}.sod-actions{width:100%}.sod-actions .zcs-button{flex:1;min-width:38px}.sod-actions .zcs-button-text{display:none}.zcs-table-wrapper table{min-width:760px}.sod-route-step{min-width:90px}}\n&lt;/style&gt;\n&lt;div class=&apos;sod-page zcs-box-border zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n&lt;% if(orders.count() == 0) { %&gt;\n\t&lt;header class=&apos;zcs-card sod-header&apos;&gt;&lt;a href=&apos;#Page:Sales_Orders&apos; class=&apos;sod-back zcs-inline-flex zcs-align-items-center zcs-justify-center&apos; title=&apos;Back to sales orders&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-left&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/header&gt;\n\t&lt;div class=&apos;zcs-card zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;div class=&apos;sod-empty&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;h2 class=&apos;zcs-font-18 zcs-mt-12 zcs-mb-0&apos;&gt;Sales order unavailable&lt;/h2&gt;&lt;p&gt;The record was not found or you do not have access.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% } else { order = orders; products = Sales_Order_Product[Parent_Sales_Order == order.ID]; quotes = Add_Supplier_Quote[Sales_Order == order.ID] sort by Quote_Date desc; pos = Create_Purchase_Order[Sales_Order == order.ID] sort by PO_Date desc; invoices = Add_Supplier_Invoice[Sales_Order == order.ID] sort by Invoice_Date desc; logisticLinks = Logistics_Booking_Purchase_Order[Sales_Order == order.ID]; returns = Create_Return_Request[Sales_Order == order.ID] sort by Return_Date desc; histories = Add_History[Sales_Order_Lookup == order.ID] sort by Updated_Date_Time desc; supplierIdentity = Add_Supplier[Email == zoho.loginuserid &amp;&amp; Active == true]; deliveredPOs = Create_Purchase_Order[Sales_Order == order.ID &amp;&amp; Status == &quot;Delivered&quot;]; %&gt;\n\t&lt;header class=&apos;zcs-card sod-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-row-wrap zcs-gap-12&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 sod-identity&apos;&gt;&lt;a href=&apos;#Page:Sales_Orders&apos; class=&apos;sod-back zcs-inline-flex zcs-align-items-center zcs-justify-center&apos; title=&apos;Back to sales orders&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-left&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;div&gt;&lt;div class=&apos;sod-eyebrow&apos;&gt;Sales order&lt;/div&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-row-wrap&apos;&gt;&lt;h1 class=&apos;zcs-font-22 zcs-font-semibold zcs-m-0&apos;&gt;&lt;%=ifnull(order.Sales_Order_ID,&quot;Record &quot; + order.ID)%&gt;&lt;/h1&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;% if(order.Status == &quot;Completed&quot;) { %&gt;zcs-badge-green&lt;% } else if(order.Status == &quot;New&quot;) { %&gt;zcs-badge-blue&lt;% } else { %&gt;zcs-badge-orange&lt;% } %&gt;&apos;&gt;&lt;%=order.Status%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;sod-meta&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;%=if(order.Customer != null,order.Customer.Customer_Name,&quot;Customer not specified&quot;)%&gt;&lt;/span&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-57&apos;&gt;&lt;/i&gt;&lt;%=ifnull(order.Sales_Order_Date,&quot;Date not specified&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;sod-actions&apos;&gt;\n\t\t\t&lt;% if(quotes.count() &gt; 0) { %&gt;&lt;a href=&apos;#Page:Quote_Comparison?Sales_Order_ID=&lt;%=order.ID%&gt;&apos; class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-trend-up&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Compare quotes&lt;/span&gt;&lt;/a&gt;&lt;% } %&gt;\n\t\t\t&lt;% if(order.Selected_Supplier_Quote != null &amp;&amp; pos.count() == 0) { %&gt;&lt;a href=&apos;#Form:Create_Purchase_Order?Sales_Order=&lt;%=order.ID%&gt;&amp;amp;Selected_Supplier_Quote=&lt;%=order.Selected_Supplier_Quote.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos; class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Create PO&lt;/span&gt;&lt;/a&gt;&lt;% } %&gt;\n\t\t\t&lt;% if(order.Status == &quot;New&quot; &amp;&amp; supplierIdentity.count() &gt; 0) { %&gt;&lt;a href=&apos;#Form:Add_Supplier_Quote?Supplier=&lt;%=supplierIdentity.ID%&gt;&amp;amp;Sales_Order=&lt;%=order.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos; class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Create quote&lt;/span&gt;&lt;/a&gt;&lt;% } %&gt;\n\t\t&lt;/div&gt;\n\t&lt;/header&gt;\n\t&lt;section class=&apos;zcs-card sod-hero&apos;&gt;\n\t\t&lt;div class=&apos;sod-summary&apos;&gt;&lt;div class=&apos;sod-summary-item&apos;&gt;&lt;div class=&apos;sod-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-57&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&apos;sod-label&apos;&gt;Requested delivery&lt;/span&gt;&lt;span class=&apos;sod-value&apos;&gt;&lt;%=ifnull(order.Requested_Delivery_Date,&quot;Not specified&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;sod-summary-item&apos;&gt;&lt;div class=&apos;sod-icon&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-bag-09&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&apos;sod-label&apos;&gt;Products&lt;/span&gt;&lt;span class=&apos;sod-value&apos;&gt;&lt;%=products.count()%&gt; requirements&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;sod-summary-item&apos;&gt;&lt;div class=&apos;sod-icon&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&apos;sod-label&apos;&gt;Sourcing&lt;/span&gt;&lt;span class=&apos;sod-value&apos;&gt;&lt;%=quotes.count()%&gt; quotes, &lt;%=pos.count()%&gt; POs&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;sod-summary-item&apos;&gt;&lt;div class=&apos;sod-icon&apos;&gt;&lt;i class=&apos;zc-li-outline transport-truck&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&apos;sod-label&apos;&gt;Fulfillment&lt;/span&gt;&lt;span class=&apos;sod-value&apos;&gt;&lt;%=logisticLinks.count()%&gt; bookings, &lt;%=returns.count()%&gt; returns&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;sod-route&apos; aria-label=&apos;Sales order lifecycle&apos;&gt;&lt;div class=&apos;sod-route-step on&apos;&gt;&lt;div class=&apos;sod-route-node&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-small&apos;&gt;&lt;/i&gt;&lt;/div&gt;Requirement&lt;/div&gt;&lt;div class=&apos;sod-route-step &lt;%if(quotes.count()&gt;0){%&gt;on&lt;%}%&gt;&apos;&gt;&lt;div class=&apos;sod-route-node&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-trend-up&apos;&gt;&lt;/i&gt;&lt;/div&gt;Sourcing&lt;/div&gt;&lt;div class=&apos;sod-route-step &lt;%if(pos.count()&gt;0){%&gt;on&lt;%}%&gt;&apos;&gt;&lt;div class=&apos;sod-route-node&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;/div&gt;Purchasing&lt;/div&gt;&lt;div class=&apos;sod-route-step &lt;%if(invoices.count()&gt;0){%&gt;on&lt;%}%&gt;&apos;&gt;&lt;div class=&apos;sod-route-node&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;/div&gt;Invoicing&lt;/div&gt;&lt;div class=&apos;sod-route-step &lt;%if(logisticLinks.count()&gt;0 || deliveredPOs.count()&gt;0){%&gt;on&lt;%}%&gt;&apos;&gt;&lt;div class=&apos;sod-route-node&apos;&gt;&lt;i class=&apos;zc-li-outline transport-truck&apos;&gt;&lt;/i&gt;&lt;/div&gt;Delivery&lt;/div&gt;&lt;div class=&apos;sod-route-step &lt;%if(returns.count()&gt;0){%&gt;on&lt;%}%&gt;&apos;&gt;&lt;div class=&apos;sod-route-node&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-refresh-69&apos;&gt;&lt;/i&gt;&lt;/div&gt;Returns&lt;/div&gt;&lt;/div&gt;\n\t&lt;/section&gt;\n\t&lt;div class=&apos;sod-content&apos;&gt;&lt;main class=&apos;sod-stack&apos;&gt;\n\t\t&lt;section class=&apos;zcs-card sod-section&apos;&gt;&lt;div class=&apos;sod-section-head&apos;&gt;&lt;h2 class=&apos;sod-title&apos;&gt;Requirement and sourcing status&lt;/h2&gt;&lt;/div&gt;&lt;div class=&apos;sod-grid&apos;&gt;&lt;div class=&apos;sod-kv&apos;&gt;&lt;span class=&apos;sod-label&apos;&gt;Requirement source&lt;/span&gt;&lt;span class=&apos;sod-value&apos;&gt;&lt;%=ifnull(order.Requirement_Source,&quot;Not specified&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;sod-kv&apos;&gt;&lt;span class=&apos;sod-label&apos;&gt;Lead&lt;/span&gt;&lt;span class=&apos;sod-value&apos;&gt;&lt;%=if(order.Lead != null,order.Lead.Lead_ID,&quot;Not linked&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;sod-kv&apos;&gt;&lt;span class=&apos;sod-label&apos;&gt;Recommended supplier&lt;/span&gt;&lt;span class=&apos;sod-value&apos;&gt;&lt;%=if(order.Recommended_Supplier != null,order.Recommended_Supplier.Supplier_Name,&quot;Not recommended&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;sod-kv&apos;&gt;&lt;span class=&apos;sod-label&apos;&gt;Selected quote&lt;/span&gt;&lt;span class=&apos;sod-value&apos;&gt;&lt;%=if(order.Selected_Supplier_Quote != null,order.Selected_Supplier_Quote.Supplier_Quote_ID,&quot;Not selected&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;sod-note-grid zcs-mt-12&apos;&gt;&lt;div class=&apos;sod-note&apos;&gt;&lt;span class=&apos;sod-label&apos;&gt;Customer requirements&lt;/span&gt;&lt;div class=&apos;sod-copy&apos;&gt;&lt;%=ifnull(order.Customer_Requirements,&quot;Not specified&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;sod-note&apos;&gt;&lt;span class=&apos;sod-label&apos;&gt;Additional remarks&lt;/span&gt;&lt;div class=&apos;sod-copy&apos;&gt;&lt;%=ifnull(order.Additional_Remarks,&quot;Not specified&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;zcs-card sod-section&apos;&gt;&lt;div class=&apos;sod-section-head&apos;&gt;&lt;h2 class=&apos;sod-title&apos;&gt;Product requirements&lt;/h2&gt;&lt;span class=&apos;zcs-badge zcs-badge-blue zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=products.count()%&gt;&lt;/span&gt;&lt;/div&gt;&lt;%if(products.count()==0){%&gt;&lt;div class=&apos;sod-empty&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;div&gt;No product requirements&lt;/div&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;zcs-table-wrapper sod-scroll zcs-rounded-sm&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Product&lt;/th&gt;&lt;th&gt;Configuration and technical requirements&lt;/th&gt;&lt;th&gt;Quantity&lt;/th&gt;&lt;th&gt;Availability&lt;/th&gt;&lt;th&gt;Lead time&lt;/th&gt;&lt;th&gt;Selected quote&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%for each productRow in products{%&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;&lt;%=productRow.Product_Name%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;&lt;%=ifnull(productRow.Brand_Make,&quot;&quot;)%&gt; &lt;%=ifnull(productRow.Model,&quot;&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ifnull(productRow.Configuration,&quot;Not specified&quot;)%&gt;&lt;br&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;&lt;%=ifnull(productRow.Technical_Requirements,&quot;&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;%=productRow.Quantity%&gt; &lt;%=ifnull(productRow.Unit_of_Measure,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ifnull(productRow.Required_Availability,&quot;Not specified&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ifnull(productRow.Required_Lead_Time,&quot;Not specified&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=if(productRow.Selected_Supplier_Quote != null,productRow.Selected_Supplier_Quote.Supplier_Quote_ID,&quot;Not selected&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;zcs-card sod-section&apos;&gt;&lt;div class=&apos;sod-section-head&apos;&gt;&lt;h2 class=&apos;sod-title&apos;&gt;Quote comparison and recommendation&lt;/h2&gt;&lt;span class=&apos;zcs-badge zcs-badge-blue zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=quotes.count()%&gt;&lt;/span&gt;&lt;/div&gt;&lt;%if(quotes.count()==0){%&gt;&lt;div class=&apos;sod-empty&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;div&gt;No supplier quotes received&lt;/div&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;zcs-table-wrapper sod-scroll zcs-rounded-sm&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Quote&lt;/th&gt;&lt;th&gt;Supplier&lt;/th&gt;&lt;th&gt;Date&lt;/th&gt;&lt;th&gt;Availability&lt;/th&gt;&lt;th&gt;Lead time&lt;/th&gt;&lt;th&gt;Dispatch&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%for each quote in quotes{%&gt;&lt;tr&gt;&lt;td&gt;&lt;%=quote.Supplier_Quote_ID%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=if(quote.Supplier != null,quote.Supplier.Supplier_Name,&quot;Not specified&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=quote.Quote_Date%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ifnull(quote.Availability,&quot;Not specified&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ifnull(quote.Lead_Time,&quot;Not specified&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ifnull(quote.Dispatch_Location,&quot;Not specified&quot;)%&gt;&lt;/td&gt;&lt;td&gt;&lt;span class=&apos;zcs-badge zcs-px-10 zcs-py-2 zcs-rounded-sm &lt;%if(quote.Status==&quot;Selected&quot;){%&gt;zcs-badge-green&lt;%}else{%&gt;zcs-badge-yellow&lt;%}%&gt;&apos;&gt;&lt;%=quote.Status%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;%}%&gt;&lt;div class=&apos;sod-note-grid zcs-mt-12&apos;&gt;&lt;div class=&apos;sod-note&apos;&gt;&lt;span class=&apos;sod-label&apos;&gt;Recommendation&lt;/span&gt;&lt;div class=&apos;sod-value&apos;&gt;&lt;%=if(order.Recommended_Supplier != null,order.Recommended_Supplier.Supplier_Name,&quot;Awaiting recommendation&quot;)%&gt;&lt;/div&gt;&lt;div class=&apos;sod-copy&apos;&gt;&lt;%=ifnull(order.Comparison_Remarks,&quot;No comparison remarks&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;sod-note&apos;&gt;&lt;span class=&apos;sod-label&apos;&gt;Comparison sheet&lt;/span&gt;&lt;div class=&apos;sod-value&apos;&gt;&lt;%=ifnull(order.Comparison_Sheet,&quot;Not attached&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;zcs-card sod-section&apos;&gt;&lt;div class=&apos;sod-section-head&apos;&gt;&lt;h2 class=&apos;sod-title&apos;&gt;Fulfillment and delivery&lt;/h2&gt;&lt;span class=&apos;zcs-badge zcs-badge-theme zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=logisticLinks.count()%&gt; bookings&lt;/span&gt;&lt;/div&gt;&lt;%if(logisticLinks.count()==0){%&gt;&lt;div class=&apos;sod-empty&apos;&gt;&lt;i class=&apos;zc-li-outline transport-truck&apos;&gt;&lt;/i&gt;&lt;div&gt;No logistics bookings linked&lt;/div&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;sod-record-scroll&apos;&gt;&lt;%for each logisticLink in logisticLinks{ booking=logisticLink.Parent_Logistics_Booking; %&gt;&lt;div class=&apos;sod-record&apos;&gt;&lt;div class=&apos;sod-record-head&apos;&gt;&lt;strong&gt;&lt;%=if(booking != null,booking.Logistics_Booking_ID,&quot;Booking&quot;)%&gt;&lt;/strong&gt;&lt;span class=&apos;zcs-badge zcs-badge-blue zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=if(booking != null,booking.Status,&quot;Linked&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;%if(booking != null){%&gt;&lt;div class=&apos;sod-grid&apos;&gt;&lt;div class=&apos;sod-kv&apos;&gt;&lt;span class=&apos;sod-label&apos;&gt;Provider&lt;/span&gt;&lt;%=ifnull(booking.Logistics_Provider,&quot;Not specified&quot;)%&gt;&lt;/div&gt;&lt;div class=&apos;sod-kv&apos;&gt;&lt;span class=&apos;sod-label&apos;&gt;Tracking&lt;/span&gt;&lt;%=ifnull(booking.Tracking_Reference,&quot;Not specified&quot;)%&gt;&lt;/div&gt;&lt;div class=&apos;sod-kv&apos;&gt;&lt;span class=&apos;sod-label&apos;&gt;Expected arrival&lt;/span&gt;&lt;%=ifnull(booking.Expected_Arrival_Date,&quot;Not specified&quot;)%&gt;&lt;/div&gt;&lt;div class=&apos;sod-kv&apos;&gt;&lt;span class=&apos;sod-label&apos;&gt;Actual arrival&lt;/span&gt;&lt;%=ifnull(booking.Actual_Arrival_Date,&quot;Pending&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;%if(deliveredPOs.count()&gt;0){%&gt;&lt;div class=&apos;sod-note zcs-mt-12&apos;&gt;&lt;span class=&apos;sod-label&apos;&gt;Delivered purchase orders&lt;/span&gt;&lt;strong&gt;&lt;%=deliveredPOs.count()%&gt;&lt;/strong&gt; delivered and eligible for return requests.&lt;/div&gt;&lt;%}%&gt;&lt;/section&gt;\n\t&lt;/main&gt;&lt;aside class=&apos;sod-stack&apos;&gt;\n\t\t&lt;section class=&apos;zcs-card sod-section&apos;&gt;&lt;div class=&apos;sod-section-head&apos;&gt;&lt;h2 class=&apos;sod-title&apos;&gt;Downstream documents&lt;/h2&gt;&lt;/div&gt;&lt;div class=&apos;sod-related&apos;&gt;&lt;div class=&apos;sod-related-card&apos;&gt;&lt;div class=&apos;sod-related-head&apos;&gt;&lt;strong&gt;Purchase orders&lt;/strong&gt;&lt;span class=&apos;zcs-badge zcs-badge-blue zcs-px-10 zcs-py-2&apos;&gt;&lt;%=pos.count()%&gt;&lt;/span&gt;&lt;/div&gt;&lt;%if(pos.count()==0){%&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;None created&lt;/span&gt;&lt;%}else{for each po in pos{%&gt;&lt;div class=&apos;sod-record&apos;&gt;&lt;a href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=po.ID%&gt;&apos;&gt;&lt;%=po.Purchase_Order_ID%&gt;&lt;/a&gt;&lt;br&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;&lt;%=po.Status%&gt; · &lt;%=ifnull(po.Expected_Delivery_Date,&quot;No due date&quot;)%&gt;&lt;/span&gt;&lt;%if(po.Status==&quot;Delivered&quot;){%&gt;&lt;br&gt;&lt;a href=&apos;#Form:Create_Return_Request?Sales_Order=&lt;%=order.ID%&gt;&amp;amp;Purchase_Order=&lt;%=po.ID%&gt;&amp;amp;Customer=&lt;%=order.Customer.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;Create return&lt;/a&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%}}%&gt;&lt;/div&gt;&lt;div class=&apos;sod-related-card&apos;&gt;&lt;div class=&apos;sod-related-head&apos;&gt;&lt;strong&gt;Supplier invoices&lt;/strong&gt;&lt;span class=&apos;zcs-badge zcs-badge-orange zcs-px-10 zcs-py-2&apos;&gt;&lt;%=invoices.count()%&gt;&lt;/span&gt;&lt;/div&gt;&lt;%if(invoices.count()==0){%&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;None received&lt;/span&gt;&lt;%}else{for each invoice in invoices{%&gt;&lt;div class=&apos;sod-record&apos;&gt;&lt;a href=&apos;#Page:Supplier_Invoice_Detail?Supplier_Invoice_ID=&lt;%=invoice.ID%&gt;&apos;&gt;&lt;%=invoice.Supplier_Invoice_ID%&gt;&lt;/a&gt;&lt;br&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;&lt;%=invoice.Status%&gt; · &lt;%=invoice.Invoice_Date%&gt;&lt;/span&gt;&lt;/div&gt;&lt;%}}%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;zcs-card sod-section&apos;&gt;&lt;div class=&apos;sod-section-head&apos;&gt;&lt;h2 class=&apos;sod-title&apos;&gt;Returns&lt;/h2&gt;&lt;span class=&apos;zcs-badge zcs-badge-grey zcs-px-10 zcs-py-2&apos;&gt;&lt;%=returns.count()%&gt;&lt;/span&gt;&lt;/div&gt;&lt;%if(returns.count()==0){%&gt;&lt;div class=&apos;sod-empty&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-refresh-69&apos;&gt;&lt;/i&gt;&lt;div&gt;No return requests&lt;/div&gt;&lt;small&gt;Return actions appear only for delivered purchase orders.&lt;/small&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;sod-record-scroll&apos;&gt;&lt;%for each returnRow in returns{%&gt;&lt;div class=&apos;sod-record&apos;&gt;&lt;strong&gt;&lt;%=returnRow.Return_Request_ID%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;&lt;%=returnRow.Return_Date%&gt; · &lt;%=ifnull(returnRow.Damage_Responsibility,&quot;Responsibility pending&quot;)%&gt;&lt;/span&gt;&lt;div class=&apos;sod-copy&apos;&gt;&lt;%=ifnull(returnRow.Issue_Description,&quot;No issue description&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;zcs-card sod-section&apos;&gt;&lt;div class=&apos;sod-section-head&apos;&gt;&lt;h2 class=&apos;sod-title&apos;&gt;Activity&lt;/h2&gt;&lt;a href=&apos;#Report:All_Histories?Sales_Order_Lookup=&lt;%=order.ID%&gt;&apos;&gt;View report&lt;/a&gt;&lt;/div&gt;&lt;%if(histories.count()==0){%&gt;&lt;div class=&apos;sod-empty&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;div&gt;No history entries&lt;/div&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;sod-record-scroll&apos;&gt;&lt;ul class=&apos;sod-timeline&apos;&gt;&lt;%for each historyRow in histories{%&gt;&lt;li&gt;&lt;div class=&apos;zcs-font-15 zcs-font-semibold&apos;&gt;&lt;%=historyRow.Action_Type%&gt;&lt;/div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;&lt;%=historyRow.Updated_Date_Time%&gt; · &lt;%=if(historyRow.Updated_By != null,historyRow.Updated_By.Employee_Name,ifnull(historyRow.Updated_By_Email,&quot;System&quot;))%&gt;&lt;/div&gt;&lt;%if(historyRow.Previous_Status != null || historyRow.New_Status != null){%&gt;&lt;div class=&apos;zcs-mt-8&apos;&gt;&lt;%=ifnull(historyRow.Previous_Status,&quot;&quot;)%&gt; to &lt;%=ifnull(historyRow.New_Status,&quot;&quot;)%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;%if(historyRow.Comments != null){%&gt;&lt;div class=&apos;sod-copy&apos;&gt;&lt;%=historyRow.Comments%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/li&gt;&lt;%}%&gt;&lt;/ul&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/section&gt;\n\t&lt;/aside&gt;&lt;/div&gt;\n&lt;% } %&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Sales_Orders(string Status_Filter)
		{
					displayname = "Sales Orders"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Sales_Orders_List' elementName='Sales_Orders_List'>\n\t\t\t\t\t<![CDATA[htmlpage Sales_Orders_List()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nstatusFilter = ifnull(input.Status_Filter,&quot;All&quot;);\nif(statusFilter == &quot;&quot;)\n{\n\t\tstatusFilter = &quot;All&quot;;\n}\nallOrders = Create_Sales_Order[ID != 0] sort by Sales_Order_Date desc;\nallCount = allOrders.count();\nneedsQuotesCount = Create_Sales_Order[Status == &quot;New&quot;].count();\ncompareCount = Create_Sales_Order[Status == &quot;Quotes Received&quot;].count();\nreadyCount = Create_Sales_Order[Status == &quot;Quotes Received&quot; &amp;&amp; Selected_Supplier_Quote != null].count();\ndownstreamCount = Create_Sales_Order[Status == &quot;Purchase Order Created&quot; || Status == &quot;Purchase Order Approved&quot; || Status == &quot;Customer Approved&quot; || Status == &quot;Invoice Created&quot; || Status == &quot;Invoice Paid&quot; || Status == &quot;Logistics Pending&quot; || Status == &quot;Products Received&quot;].count();\ncompleteCount = Create_Sales_Order[Status == &quot;Delivered&quot; || Status == &quot;Return Requested&quot;].count();\nif(statusFilter == &quot;Needs Quotes&quot;)\n{\n\t\torders = Create_Sales_Order[Status == &quot;New&quot;] sort by Sales_Order_Date desc;\n}\nelse if(statusFilter == &quot;Compare Quotes&quot;)\n{\n\t\torders = Create_Sales_Order[Status == &quot;Quotes Received&quot;] sort by Sales_Order_Date desc;\n}\nelse if(statusFilter == &quot;Ready for PO&quot;)\n{\n\t\torders = Create_Sales_Order[Status == &quot;Quotes Received&quot; &amp;&amp; Selected_Supplier_Quote != null] sort by Sales_Order_Date desc;\n}\nelse if(statusFilter == &quot;Downstream&quot;)\n{\n\t\torders = Create_Sales_Order[Status == &quot;Purchase Order Created&quot; || Status == &quot;Purchase Order Approved&quot; || Status == &quot;Customer Approved&quot; || Status == &quot;Invoice Created&quot; || Status == &quot;Invoice Paid&quot; || Status == &quot;Logistics Pending&quot; || Status == &quot;Products Received&quot;] sort by Sales_Order_Date desc;\n}\nelse if(statusFilter == &quot;Delivered / Returns&quot;)\n{\n\t\torders = Create_Sales_Order[Status == &quot;Delivered&quot; || Status == &quot;Return Requested&quot;] sort by Sales_Order_Date desc;\n}\nelse if(statusFilter == &quot;All&quot;)\n{\n\t\torders = allOrders;\n}\nelse\n{\n\t\torders = Create_Sales_Order[Status == statusFilter] sort by Sales_Order_Date desc;\n}\n%&gt;\n&lt;style&gt;\n/* ZCS global utility subset used by this single-snippet page. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#f5f4f8;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-row-wrap{flex-wrap:wrap}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-p-20{padding:1.25rem}.zcs-px-6{padding-left:.375rem;padding-right:.375rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-sticky{position:sticky}a{text-decoration:none}#splash-screen{display:none!important}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important}\n*{box-sizing:border-box}.so-page{height:100%;min-height:560px;padding:12px;background:var(--zcs-page-bg-color);color:var(--zcs-primary-text-color);font-family:Arial,sans-serif}.so-shell{height:100%;min-height:536px;display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--zcs-border-color);border-radius:12px;background:var(--zcs-white-color)}.so-header{flex:0 0 auto;padding:14px 18px 12px;border-bottom:1px solid var(--zcs-border-color)}.so-heading{display:flex;align-items:center;gap:10px}.so-heading-icon{width:32px;height:32px;border-radius:8px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:16px}.so-subtitle{margin:3px 0 0;color:var(--zcs-secondary-text-color);font-size:12px}.so-head-count{padding:5px 9px;border:1px solid var(--zcs-border-color);border-radius:6px;background:#faf9fc;color:var(--zcs-secondary-text-color);font-size:12px;white-space:nowrap}.so-kpis{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;padding:10px 14px;border-bottom:1px solid var(--zcs-border-color);background:#fbfafe}.so-kpi{min-width:0;padding:8px 10px;border-left:3px solid #d9d2eb;background:#fff;border-radius:5px}.so-kpi strong{display:block;font-size:16px;line-height:1.15}.so-kpi span{display:block;margin-top:2px;color:var(--zcs-secondary-text-color);font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.so-kpi.attn{border-left-color:#d79a27}.so-kpi.ready{border-left-color:#258a61}.so-kpi.flow{border-left-color:var(--zcs_brand_color)}.so-kpi.done{border-left-color:#4777b8}.so-filters{display:flex;gap:7px;overflow-x:auto;padding:10px 14px;border-bottom:1px solid var(--zcs-border-color);scrollbar-width:none}.so-filters::-webkit-scrollbar{display:none}.so-chip{display:inline-flex;align-items:center;gap:6px;flex:0 0 auto;padding:5px 9px;border:1px solid var(--zcs-border-color);border-radius:14px;background:#fff;color:var(--zcs-secondary-text-color);font-size:12px}.so-chip:hover,.so-chip.active{border-color:var(--zcs_brand_color);background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.so-chip-count{min-width:18px;text-align:center;font-weight:600}.so-viewbar{display:flex;justify-content:space-between;gap:12px;padding:7px 14px;background:#faf9fc;color:var(--zcs-secondary-text-color);font-size:11px}.so-register{flex:1 1 auto;min-height:260px;overflow:auto;padding:0 12px 12px}.zcs-table-wrapper{height:100%;overflow:auto;border:1px solid var(--zcs-border-color);border-radius:6px;background:#fff}.zcs-table-wrapper table{width:100%;min-width:1100px;border-collapse:collapse}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{padding:8px 10px;background:#f7f6fa;box-shadow:0 -1px 0 var(--zcs-border-color) inset;color:var(--zcs-secondary-text-color);font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.035em;white-space:nowrap}.zcs-table-wrapper td{padding:10px;border-top:1px solid var(--zcs-border-color);vertical-align:top;font-size:12px}.zcs-table-wrapper tbody tr:first-child td{border-top:0}.zcs-table-wrapper tbody tr:hover td{background:#fbfafe}.so-order-link{display:inline-flex;align-items:center;gap:6px;color:var(--zcs_brand_color);font-size:13px;font-weight:600}.so-order-link i{font-size:12px}.so-customer{max-width:210px;margin-top:3px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.so-minor{margin-top:3px;color:var(--zcs-secondary-text-color);font-size:11px;line-height:1.35}.so-products{max-width:220px}.so-next{max-width:205px;color:var(--zcs-primary-text-color);font-weight:600;line-height:1.35}.so-next i{margin-right:5px;color:var(--zcs_brand_color)}.zcs-badge{width:auto;white-space:nowrap}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#117551}.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#c83249}.zcs-badge-yellow{background:#fcf4e6;border-color:#d99a1c;color:#95660d}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#245bc5}.zcs-badge-orange{background:#f8f0eb;border-color:#f4660c;color:#b94b08}.zcs-badge-grey{background:#eeeef1;border-color:#777784;color:#4f4f5a}.so-readiness{display:flex;flex-wrap:wrap;gap:5px}.so-signal{display:inline-flex;align-items:center;gap:4px;padding:3px 6px;border-radius:4px;background:#f3f1f7;color:var(--zcs-secondary-text-color);font-size:11px}.so-signal.selected{background:#e7f7f0;color:#157451}.so-actions{display:flex;gap:5px;justify-content:flex-end;white-space:nowrap}.so-action{width:28px;height:28px;border:1px solid var(--zcs-border-color);border-radius:5px;color:var(--zcs-secondary-text-color)}.so-action:hover,.so-action.primary{border-color:var(--zcs_brand_color);background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.so-mobile{display:none}.zcs-nodata-wrapper{flex:1;min-height:260px}.empty-icon{width:44px;height:44px;margin:0 auto;border-radius:50%;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:20px}.empty-link{display:inline-flex;margin-top:12px;padding:7px 12px;border:1px solid var(--zcs_brand_color);border-radius:6px;color:var(--zcs_brand_color);font-size:13px}\n@media(max-width:760px){.so-page{height:auto;min-height:100%;padding:7px}.so-shell{height:auto;min-height:0;overflow:visible}.so-header{padding:12px}.so-head-count{display:none}.so-kpis{grid-template-columns:repeat(2,minmax(0,1fr));padding:9px}.so-kpi:first-child{grid-column:span 2}.so-viewbar{padding:7px 10px}.so-viewbar span:last-child{display:none}.so-register{display:none}.so-mobile{display:grid;gap:9px;padding:9px}.so-card{padding:12px;border:1px solid var(--zcs-border-color);border-radius:8px;background:#fff}.so-card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}.so-card-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:11px}.so-card-field{min-width:0}.so-label{display:block;margin-bottom:2px;color:var(--zcs-teritiary-text-color);font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.035em}.so-value{display:block;font-size:12px;overflow-wrap:anywhere}.so-card .so-products{max-width:none;grid-column:span 2}.so-card-next{margin-top:10px;padding:8px;background:#faf9fc;border-radius:6px}.so-card-actions{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}.so-card-actions .so-action{width:auto;padding:0 8px;gap:5px;font-size:11px}.so-card-actions .so-action span{display:inline}.zcs-nodata-wrapper{min-height:320px}}\n&lt;/style&gt;\n&lt;div class=&apos;so-page&apos;&gt;\n\t&lt;section class=&apos;so-shell&apos;&gt;\n\t\t&lt;header class=&apos;so-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t&lt;div class=&apos;so-heading&apos;&gt;\n\t\t\t\t&lt;div class=&apos;so-heading-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Sales order register&lt;/h2&gt;&lt;p class=&apos;so-subtitle&apos;&gt;Sourcing readiness and fulfillment handoffs at a glance&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;span class=&apos;so-head-count&apos;&gt;&lt;%=allCount%&gt; total orders&lt;/span&gt;\n\t\t&lt;/header&gt;\n\t\t&lt;div class=&apos;so-kpis&apos; aria-label=&apos;Sales order summaries&apos;&gt;\n\t\t\t&lt;div class=&apos;so-kpi&apos;&gt;&lt;strong&gt;&lt;%=allCount%&gt;&lt;/strong&gt;&lt;span&gt;Total orders&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;so-kpi attn&apos;&gt;&lt;strong&gt;&lt;%=needsQuotesCount%&gt;&lt;/strong&gt;&lt;span&gt;Need supplier quotes&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;so-kpi ready&apos;&gt;&lt;strong&gt;&lt;%=readyCount%&gt;&lt;/strong&gt;&lt;span&gt;Ready for PO&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;so-kpi flow&apos;&gt;&lt;strong&gt;&lt;%=downstreamCount%&gt;&lt;/strong&gt;&lt;span&gt;In fulfillment&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;so-kpi done&apos;&gt;&lt;strong&gt;&lt;%=completeCount%&gt;&lt;/strong&gt;&lt;span&gt;Delivered or returns&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;nav class=&apos;so-filters&apos; aria-label=&apos;Sales order lifecycle filters&apos;&gt;\n\t\t\t&lt;a class=&apos;so-chip &lt;%if(statusFilter == &quot;All&quot;){%&gt;active&lt;%}%&gt;&apos; href=&apos;#Page:Sales_Orders?Status_Filter=All&apos;&gt;All &lt;span class=&apos;so-chip-count&apos;&gt;&lt;%=allCount%&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;so-chip &lt;%if(statusFilter == &quot;Needs Quotes&quot;){%&gt;active&lt;%}%&gt;&apos; href=&apos;#Page:Sales_Orders?Status_Filter=Needs%20Quotes&apos;&gt;Needs quotes &lt;span class=&apos;so-chip-count&apos;&gt;&lt;%=needsQuotesCount%&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;so-chip &lt;%if(statusFilter == &quot;Compare Quotes&quot;){%&gt;active&lt;%}%&gt;&apos; href=&apos;#Page:Sales_Orders?Status_Filter=Compare%20Quotes&apos;&gt;Compare quotes &lt;span class=&apos;so-chip-count&apos;&gt;&lt;%=compareCount%&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;so-chip &lt;%if(statusFilter == &quot;Ready for PO&quot;){%&gt;active&lt;%}%&gt;&apos; href=&apos;#Page:Sales_Orders?Status_Filter=Ready%20for%20PO&apos;&gt;Ready for PO &lt;span class=&apos;so-chip-count&apos;&gt;&lt;%=readyCount%&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;so-chip &lt;%if(statusFilter == &quot;Downstream&quot;){%&gt;active&lt;%}%&gt;&apos; href=&apos;#Page:Sales_Orders?Status_Filter=Downstream&apos;&gt;Downstream &lt;span class=&apos;so-chip-count&apos;&gt;&lt;%=downstreamCount%&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;so-chip &lt;%if(statusFilter == &quot;Delivered / Returns&quot;){%&gt;active&lt;%}%&gt;&apos; href=&apos;#Page:Sales_Orders?Status_Filter=Delivered%20%2F%20Returns&apos;&gt;Delivered / returns &lt;span class=&apos;so-chip-count&apos;&gt;&lt;%=completeCount%&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t&lt;/nav&gt;\n\t\t&lt;div class=&apos;so-viewbar&apos;&gt;&lt;span&gt;&lt;strong&gt;&lt;%=orders.count()%&gt;&lt;/strong&gt; orders in &lt;strong&gt;&lt;%=statusFilter%&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span&gt;Quote selection indicates sourcing readiness&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;%if(orders.count() == 0){%&gt;\n\t\t\t&lt;div class=&apos;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;div class=&apos;empty-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-file-search&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mb-0&apos;&gt;No orders match this view&lt;/h5&gt;&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-mt-12 zcs-mb-0&apos;&gt;Choose another lifecycle filter to continue scanning.&lt;/p&gt;&lt;a class=&apos;empty-link&apos; href=&apos;#Page:Sales_Orders?Status_Filter=All&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-refresh-69&apos;&gt;&lt;/i&gt;&amp;nbsp; Show all orders&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;%}else{%&gt;\n\t\t\t&lt;main class=&apos;so-register&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-relative&apos;&gt;\n\t\t\t\t\t&lt;table&gt;\n\t\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-text-left&apos;&gt;Order and customer&lt;/th&gt;&lt;th class=&apos;zcs-text-left&apos;&gt;Status&lt;/th&gt;&lt;th class=&apos;zcs-text-left&apos;&gt;Dates&lt;/th&gt;&lt;th class=&apos;zcs-text-left&apos;&gt;Requirement and products&lt;/th&gt;&lt;th class=&apos;zcs-text-left&apos;&gt;Sourcing readiness&lt;/th&gt;&lt;th class=&apos;zcs-text-left&apos;&gt;Next handoff&lt;/th&gt;&lt;th class=&apos;zcs-text-left&apos;&gt;Actions&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t&lt;%for each orderRec in orders\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tstatusValue = ifnull(orderRec.Status,&quot;Unknown&quot;);\n\t\t\t\t\t\t\t\tsourceValue = ifnull(orderRec.Requirement_Source,&quot;Not specified&quot;);\n\t\t\t\t\t\t\t\torderDateValue = &quot;Not set&quot;;\n\t\t\t\t\t\t\t\tif(orderRec.Sales_Order_Date != null){orderDateValue = orderRec.Sales_Order_Date.toString(&quot;dd MMM yyyy&quot;);}\n\t\t\t\t\t\t\t\tdeliveryDateValue = &quot;Not set&quot;;\n\t\t\t\t\t\t\t\tif(orderRec.Requested_Delivery_Date != null){deliveryDateValue = orderRec.Requested_Delivery_Date.toString(&quot;dd MMM yyyy&quot;);}\n\t\t\t\t\t\t\t\tcustomerName = &quot;Not assigned&quot;;\n\t\t\t\t\t\t\t\tif(orderRec.Customer != null){customerName = ifnull(orderRec.Customer.Customer_Name,&quot;Not assigned&quot;);}\n\t\t\t\t\t\t\t\telse if(orderRec.Lead != null){customerName = ifnull(orderRec.Lead.Customer_Company_Name,&quot;Lead customer not named&quot;);}\n\t\t\t\t\t\t\t\tproducts = Sales_Order_Product[Parent_Sales_Order == orderRec.ID];\n\t\t\t\t\t\t\t\tproductCount = products.count();\n\t\t\t\t\t\t\t\tproductSummary = &quot;No products added&quot;;\n\t\t\t\t\t\t\t\tproductIndex = 0;\n\t\t\t\t\t\t\t\tfor each productRec in products\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tif(productIndex &lt; 2)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tproductName = ifnull(productRec.Product_Name,&quot;Unnamed product&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\tif(productIndex == 0){productSummary = productName;}else{productSummary = productSummary + &quot;, &quot; + productName;}\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\tproductIndex = productIndex + 1;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tif(productCount &gt; 2){productSummary = productSummary + &quot; and &quot; + (productCount - 2) + &quot; more&quot;;}\n\t\t\t\t\t\t\t\tquotes = Add_Supplier_Quote[Sales_Order == orderRec.ID];\n\t\t\t\t\t\t\t\tquoteCount = quotes.count();\n\t\t\t\t\t\t\t\tpurchaseOrders = Create_Purchase_Order[Sales_Order == orderRec.ID];\n\t\t\t\t\t\t\t\tpoCount = purchaseOrders.count();\n\t\t\t\t\t\t\t\tsupplierName = &quot;Not selected&quot;;\n\t\t\t\t\t\t\t\tif(orderRec.Recommended_Supplier != null){supplierName = ifnull(orderRec.Recommended_Supplier.Supplier_Name,&quot;Not selected&quot;);}\n\t\t\t\t\t\t\t\tselectedQuoteId = 0;\n\t\t\t\t\t\t\t\tif(orderRec.Selected_Supplier_Quote != null){selectedQuoteId = orderRec.Selected_Supplier_Quote.ID;}\n\t\t\t\t\t\t\t\tnextStep = &quot;Review order detail&quot;;\n\t\t\t\t\t\t\t\tbadgeClass = &quot;zcs-badge-grey&quot;;\n\t\t\t\t\t\t\t\tif(statusValue == &quot;New&quot;){nextStep = &quot;Collect supplier quotes&quot;;badgeClass = &quot;zcs-badge-yellow&quot;;}\n\t\t\t\t\t\t\t\telse if(statusValue == &quot;Quotes Received&quot; &amp;&amp; selectedQuoteId == 0){nextStep = &quot;Compare quotes and select a supplier&quot;;badgeClass = &quot;zcs-badge-blue&quot;;}\n\t\t\t\t\t\t\t\telse if(statusValue == &quot;Quotes Received&quot; &amp;&amp; selectedQuoteId &gt; 0 &amp;&amp; poCount == 0){nextStep = &quot;Create the purchase order&quot;;badgeClass = &quot;zcs-badge-orange&quot;;}\n\t\t\t\t\t\t\t\telse if(statusValue == &quot;Purchase Order Created&quot;){nextStep = &quot;Approve the purchase order&quot;;badgeClass = &quot;zcs-badge-orange&quot;;}\n\t\t\t\t\t\t\t\telse if(statusValue == &quot;Purchase Order Approved&quot;){nextStep = &quot;Share the purchase order with the customer&quot;;badgeClass = &quot;zcs-badge-blue&quot;;}\n\t\t\t\t\t\t\t\telse if(statusValue == &quot;Customer Approved&quot;){nextStep = &quot;Create and verify the supplier invoice&quot;;badgeClass = &quot;zcs-badge-blue&quot;;}\n\t\t\t\t\t\t\t\telse if(statusValue == &quot;Invoice Created&quot;){nextStep = &quot;Record invoice payment&quot;;badgeClass = &quot;zcs-badge-yellow&quot;;}\n\t\t\t\t\t\t\t\telse if(statusValue == &quot;Invoice Paid&quot; || statusValue == &quot;Logistics Pending&quot;){nextStep = &quot;Arrange and monitor logistics&quot;;badgeClass = &quot;zcs-badge-blue&quot;;}\n\t\t\t\t\t\t\t\telse if(statusValue == &quot;Products Received&quot;){nextStep = &quot;Complete delivery to the customer&quot;;badgeClass = &quot;zcs-badge-blue&quot;;}\n\t\t\t\t\t\t\t\telse if(statusValue == &quot;Delivered&quot;){nextStep = &quot;Monitor for closure or return needs&quot;;badgeClass = &quot;zcs-badge-green&quot;;}\n\t\t\t\t\t\t\t\telse if(statusValue == &quot;Return Requested&quot;){nextStep = &quot;Review and resolve the return&quot;;badgeClass = &quot;zcs-badge-red&quot;;}\n\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td&gt;&lt;a class=&apos;so-order-link&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=orderRec.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-file-text&apos;&gt;&lt;/i&gt;SO &lt;%=ifnull(orderRec.Sales_Order_ID,orderRec.ID)%&gt;&lt;/a&gt;&lt;div class=&apos;so-customer&apos;&gt;&lt;%=customerName%&gt;&lt;/div&gt;&lt;div class=&apos;so-minor&apos;&gt;&lt;%=sourceValue%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline &lt;%=badgeClass%&gt; zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-11&apos;&gt;&lt;%=statusValue%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td&gt;&lt;div&gt;&lt;%=orderDateValue%&gt;&lt;/div&gt;&lt;div class=&apos;so-minor&apos;&gt;Due &lt;%=deliveryDateValue%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td&gt;&lt;div class=&apos;so-products&apos;&gt;&lt;strong&gt;&lt;%=productCount%&gt;&lt;/strong&gt; product&lt;%if(productCount != 1){%&gt;s&lt;%}%&gt;: &lt;%=productSummary%&gt;&lt;/div&gt;&lt;div class=&apos;so-minor&apos;&gt;&lt;%=ifnull(orderRec.Customer_Requirements,&quot;No requirement summary&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td&gt;&lt;div class=&apos;so-readiness&apos;&gt;&lt;span class=&apos;so-signal&apos;&gt;&lt;i class=&apos;zc-li-outline business-coins&apos;&gt;&lt;/i&gt;&lt;%=quoteCount%&gt; quote&lt;%if(quoteCount != 1){%&gt;s&lt;%}%&gt;&lt;/span&gt;&lt;span class=&apos;so-signal &lt;%if(selectedQuoteId &gt; 0){%&gt;selected&lt;%}%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;%if(selectedQuoteId &gt; 0){%&gt;Selected&lt;%}else{%&gt;Not selected&lt;%}%&gt;&lt;/span&gt;&lt;span class=&apos;so-signal&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;%=poCount%&gt; PO&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;so-minor&apos;&gt;&lt;%=supplierName%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td&gt;&lt;div class=&apos;so-next&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;%=nextStep%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td&gt;&lt;div class=&apos;so-actions&apos;&gt;&lt;a class=&apos;so-action zcs-flex zcs-align-items-center zcs-justify-center&apos; title=&apos;Order detail&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=orderRec.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-eye-19&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;%if(quoteCount &gt; 0){%&gt;&lt;a class=&apos;so-action zcs-flex zcs-align-items-center zcs-justify-center&apos; title=&apos;Compare quotes&apos; href=&apos;#Page:Quote_Comparison?Sales_Order_ID=&lt;%=orderRec.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline design-2-layout-11&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;%}%&gt;&lt;%if(selectedQuoteId &gt; 0 &amp;&amp; poCount == 0){%&gt;&lt;a class=&apos;so-action primary zcs-flex zcs-align-items-center zcs-justify-center&apos; title=&apos;Create PO&apos; href=&apos;#Form:Create_Purchase_Order?Sales_Order=&lt;%=orderRec.ID%&gt;&amp;amp;Selected_Supplier_Quote=&lt;%=selectedQuoteId%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;%}%&gt;&lt;a class=&apos;so-action zcs-flex zcs-align-items-center zcs-justify-center&apos; title=&apos;History&apos; href=&apos;#Page:History?Sales_Order_ID=&lt;%=orderRec.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/main&gt;\n\t\t\t&lt;main class=&apos;so-mobile&apos;&gt;\n\t\t\t&lt;%for each mobileOrderRec in orders\n\t\t\t{\n\t\t\t\t\tmobileStatusValue = ifnull(mobileOrderRec.Status,&quot;Unknown&quot;);\n\t\t\t\t\tmobileSourceValue = ifnull(mobileOrderRec.Requirement_Source,&quot;Not specified&quot;);\n\t\t\t\t\tmobileOrderDate = &quot;Not set&quot;;\n\t\t\t\t\tif(mobileOrderRec.Sales_Order_Date != null){mobileOrderDate = mobileOrderRec.Sales_Order_Date.toString(&quot;dd MMM yyyy&quot;);}\n\t\t\t\t\tmobileDeliveryDate = &quot;Not set&quot;;\n\t\t\t\t\tif(mobileOrderRec.Requested_Delivery_Date != null){mobileDeliveryDate = mobileOrderRec.Requested_Delivery_Date.toString(&quot;dd MMM yyyy&quot;);}\n\t\t\t\t\tmobileCustomer = &quot;Not assigned&quot;;\n\t\t\t\t\tif(mobileOrderRec.Customer != null){mobileCustomer = ifnull(mobileOrderRec.Customer.Customer_Name,&quot;Not assigned&quot;);}\n\t\t\t\t\telse if(mobileOrderRec.Lead != null){mobileCustomer = ifnull(mobileOrderRec.Lead.Customer_Company_Name,&quot;Lead customer not named&quot;);}\n\t\t\t\t\tmobileProducts = Sales_Order_Product[Parent_Sales_Order == mobileOrderRec.ID];\n\t\t\t\t\tmobileProductCount = mobileProducts.count();\n\t\t\t\t\tmobileQuotes = Add_Supplier_Quote[Sales_Order == mobileOrderRec.ID];\n\t\t\t\t\tmobileQuoteCount = mobileQuotes.count();\n\t\t\t\t\tmobilePOs = Create_Purchase_Order[Sales_Order == mobileOrderRec.ID];\n\t\t\t\t\tmobilePOCount = mobilePOs.count();\n\t\t\t\t\tmobileSelectedQuoteId = 0;\n\t\t\t\t\tif(mobileOrderRec.Selected_Supplier_Quote != null){mobileSelectedQuoteId = mobileOrderRec.Selected_Supplier_Quote.ID;}\n\t\t\t\t\tmobileNext = &quot;Review order detail&quot;;\n\t\t\t\t\tmobileBadge = &quot;zcs-badge-grey&quot;;\n\t\t\t\t\tif(mobileStatusValue == &quot;New&quot;){mobileNext = &quot;Collect supplier quotes&quot;;mobileBadge = &quot;zcs-badge-yellow&quot;;}\n\t\t\t\t\telse if(mobileStatusValue == &quot;Quotes Received&quot; &amp;&amp; mobileSelectedQuoteId == 0){mobileNext = &quot;Compare quotes and select a supplier&quot;;mobileBadge = &quot;zcs-badge-blue&quot;;}\n\t\t\t\t\telse if(mobileStatusValue == &quot;Quotes Received&quot; &amp;&amp; mobileSelectedQuoteId &gt; 0 &amp;&amp; mobilePOCount == 0){mobileNext = &quot;Create the purchase order&quot;;mobileBadge = &quot;zcs-badge-orange&quot;;}\n\t\t\t\t\telse if(mobileStatusValue == &quot;Purchase Order Created&quot;){mobileNext = &quot;Approve the purchase order&quot;;mobileBadge = &quot;zcs-badge-orange&quot;;}\n\t\t\t\t\telse if(mobileStatusValue == &quot;Purchase Order Approved&quot;){mobileNext = &quot;Share the purchase order with the customer&quot;;mobileBadge = &quot;zcs-badge-blue&quot;;}\n\t\t\t\t\telse if(mobileStatusValue == &quot;Customer Approved&quot;){mobileNext = &quot;Create and verify the supplier invoice&quot;;mobileBadge = &quot;zcs-badge-blue&quot;;}\n\t\t\t\t\telse if(mobileStatusValue == &quot;Invoice Created&quot;){mobileNext = &quot;Record invoice payment&quot;;mobileBadge = &quot;zcs-badge-yellow&quot;;}\n\t\t\t\t\telse if(mobileStatusValue == &quot;Invoice Paid&quot; || mobileStatusValue == &quot;Logistics Pending&quot;){mobileNext = &quot;Arrange and monitor logistics&quot;;mobileBadge = &quot;zcs-badge-blue&quot;;}\n\t\t\t\t\telse if(mobileStatusValue == &quot;Products Received&quot;){mobileNext = &quot;Complete delivery to the customer&quot;;mobileBadge = &quot;zcs-badge-blue&quot;;}\n\t\t\t\t\telse if(mobileStatusValue == &quot;Delivered&quot;){mobileNext = &quot;Monitor for closure or return needs&quot;;mobileBadge = &quot;zcs-badge-green&quot;;}\n\t\t\t\t\telse if(mobileStatusValue == &quot;Return Requested&quot;){mobileNext = &quot;Review and resolve the return&quot;;mobileBadge = &quot;zcs-badge-red&quot;;}\n\t\t\t%&gt;\n\t\t\t\t&lt;article class=&apos;so-card&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;so-card-head&apos;&gt;&lt;div&gt;&lt;a class=&apos;so-order-link&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=mobileOrderRec.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-file-text&apos;&gt;&lt;/i&gt;SO &lt;%=ifnull(mobileOrderRec.Sales_Order_ID,mobileOrderRec.ID)%&gt;&lt;/a&gt;&lt;div class=&apos;so-customer&apos;&gt;&lt;%=mobileCustomer%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline &lt;%=mobileBadge%&gt; zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-11&apos;&gt;&lt;%=mobileStatusValue%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;so-card-grid&apos;&gt;&lt;div class=&apos;so-card-field&apos;&gt;&lt;span class=&apos;so-label&apos;&gt;Source&lt;/span&gt;&lt;span class=&apos;so-value&apos;&gt;&lt;%=mobileSourceValue%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;so-card-field&apos;&gt;&lt;span class=&apos;so-label&apos;&gt;Order date&lt;/span&gt;&lt;span class=&apos;so-value&apos;&gt;&lt;%=mobileOrderDate%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;so-card-field&apos;&gt;&lt;span class=&apos;so-label&apos;&gt;Requested delivery&lt;/span&gt;&lt;span class=&apos;so-value&apos;&gt;&lt;%=mobileDeliveryDate%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;so-card-field&apos;&gt;&lt;span class=&apos;so-label&apos;&gt;Readiness&lt;/span&gt;&lt;span class=&apos;so-value&apos;&gt;&lt;%=mobileQuoteCount%&gt; quotes, &lt;%=mobilePOCount%&gt; PO&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;so-card-field so-products&apos;&gt;&lt;span class=&apos;so-label&apos;&gt;Requirement&lt;/span&gt;&lt;span class=&apos;so-value&apos;&gt;&lt;%=mobileProductCount%&gt; product&lt;%if(mobileProductCount != 1){%&gt;s&lt;%}%&gt;. &lt;%=ifnull(mobileOrderRec.Customer_Requirements,&quot;No requirement summary&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;so-card-next&apos;&gt;&lt;span class=&apos;so-label&apos;&gt;Next handoff&lt;/span&gt;&lt;span class=&apos;so-value so-next&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;%=mobileNext%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;so-card-actions&apos;&gt;&lt;a class=&apos;so-action zcs-flex zcs-align-items-center zcs-justify-center&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=mobileOrderRec.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-eye-19&apos;&gt;&lt;/i&gt;&lt;span&gt;Detail&lt;/span&gt;&lt;/a&gt;&lt;%if(mobileQuoteCount &gt; 0){%&gt;&lt;a class=&apos;so-action zcs-flex zcs-align-items-center zcs-justify-center&apos; href=&apos;#Page:Quote_Comparison?Sales_Order_ID=&lt;%=mobileOrderRec.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline design-2-layout-11&apos;&gt;&lt;/i&gt;&lt;span&gt;Quotes&lt;/span&gt;&lt;/a&gt;&lt;%}%&gt;&lt;%if(mobileSelectedQuoteId &gt; 0 &amp;&amp; mobilePOCount == 0){%&gt;&lt;a class=&apos;so-action primary zcs-flex zcs-align-items-center zcs-justify-center&apos; href=&apos;#Form:Create_Purchase_Order?Sales_Order=&lt;%=mobileOrderRec.ID%&gt;&amp;amp;Selected_Supplier_Quote=&lt;%=mobileSelectedQuoteId%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;span&gt;Create PO&lt;/span&gt;&lt;/a&gt;&lt;%}%&gt;&lt;a class=&apos;so-action zcs-flex zcs-align-items-center zcs-justify-center&apos; href=&apos;#Page:History?Sales_Order_ID=&lt;%=mobileOrderRec.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span&gt;History&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;/article&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t&lt;/main&gt;\n\t\t&lt;%}%&gt;\n\t&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Sourcing_Dashboard
		{
					displayname = "Sourcing Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Sourcing_Operations' elementName='Sourcing Operations'>\n\t\t\t\t\t<![CDATA[htmlpage Sourcing_Operations()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nordersInSourcing = Create_Sales_Order[Status == &quot;New&quot; || Status == &quot;Quotes Received&quot;] sort by Requested_Delivery_Date asc;\nreceivedQuotes = Add_Supplier_Quote[Status == &quot;Received&quot;] sort by Quote_Date desc;\nselectedQuotes = Add_Supplier_Quote[Status == &quot;Selected&quot;] sort by Quote_Date desc;\nactiveSuppliers = Add_Supplier[Active == true] sort by Supplier_Name asc;\nopenPurchaseOrders = Create_Purchase_Order[Status != &quot;Delivered&quot;] sort by PO_Date desc;\nawaitingQuoteCount = 0;\ncomparisonReadyCount = 0;\nfor each sourcingOrder in ordersInSourcing\n{\n\torderQuoteCount = Add_Supplier_Quote[Sales_Order == sourcingOrder.ID].count();\n\tif(orderQuoteCount == 0)\n\t{\n\t\tawaitingQuoteCount = awaitingQuoteCount + 1;\n\t}\n\tif(orderQuoteCount &gt; 1 &amp;&amp; sourcingOrder.Selected_Supplier_Quote == null)\n\t{\n\t\tcomparisonReadyCount = comparisonReadyCount + 1;\n\t}\n}\nselectedAwaitingPOCount = 0;\nfor each selectedQuote in selectedQuotes\n{\n\tif(Create_Purchase_Order[Selected_Supplier_Quote == selectedQuote.ID].count() == 0)\n\t{\n\t\tselectedAwaitingPOCount = selectedAwaitingPOCount + 1;\n\t}\n}\nactiveSupplierCount = activeSuppliers.count();\n%&gt;\n&lt;style&gt;\n/* ZCS global utility subset for this single-snippet page. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#f6f5fa;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-tertiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5;--column-gap:0px}\n*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-p-0{padding:0}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-20{padding-top:1.25rem;padding-bottom:1.25rem}.zcs-m-0{margin:0}.zcs-mt-6{margin-top:.375rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-22{font-size:1.375rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-tertiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}a{text-decoration:none}\n.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%;width:100%;max-width:none}.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zc-pb-tile-container,.zc-pb-page-content-wrapper .zc-pb-tile-card{padding:0!important;margin:0!important;border-radius:0!important;box-shadow:none!important}#splash-screen{display:none!important}\n.sourcing-shell{min-height:100%;padding:18px;background:var(--zcs-page-bg-color);font:400 14px/1.5 Arial,sans-serif;color:var(--zcs-primary-text-color)}.dashboard-header{padding:22px 24px;background:#f0edfb;border:1px solid #ddd6f4;border-left:4px solid #7056b8;border-radius:12px}.eyebrow{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#7056b8;font-weight:600}.dashboard-header h1{font-size:23px;margin:3px 0 0}.dashboard-header p{max-width:760px;color:var(--zcs-secondary-text-color);margin:5px 0 0}.demand-overview{display:grid;grid-template-columns:minmax(240px,1.25fr) repeat(4,minmax(130px,1fr));gap:10px}.primary-kpi{padding:16px 18px;background:#40345f;color:#fff;border-color:#40345f}.primary-kpi .kpi-label,.primary-kpi .kpi-note{color:#ddd7ee}.kpi-main{font-size:28px;font-weight:600;line-height:1}.kpi{padding:13px 14px;min-width:0}.kpi-top{display:flex;align-items:center;justify-content:space-between;gap:8px}.kpi-icon{width:30px;height:30px;border-radius:8px;background:#eeeafa;color:#684fae;font-size:15px;flex:0 0 auto}.kpi-value{font-size:20px;font-weight:600;line-height:1.1}.kpi-label{font-size:12px;color:var(--zcs-secondary-text-color);margin-top:5px}.kpi-note{font-size:11px;color:var(--zcs-tertiary-text-color);margin-top:2px}.dashboard-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:14px}.span-5{grid-column:span 5}.span-7{grid-column:span 7}.span-12{grid-column:1/-1}.work-card{min-width:0;overflow:hidden}.section-head{min-height:65px;padding:13px 16px;border-bottom:1px solid var(--zcs-border-color);background:#fff}.section-title{min-width:0}.section-title h2{font-size:16px;margin:0}.section-title p{font-size:12px;color:var(--zcs-secondary-text-color);margin:2px 0 0}.section-link{font-size:12px;font-weight:600;color:#654aa8;white-space:nowrap}.section-scroll{height:322px;overflow:auto}.record-list{padding:3px 16px}.record-row{padding:12px 0;border-bottom:1px solid var(--zcs-border-color)}.record-row:last-child{border-bottom:0}.record-link{color:#5e449f;font-weight:600}.meta{font-size:12px;color:var(--zcs-secondary-text-color);margin-top:3px;overflow-wrap:anywhere}.row-actions{margin-top:8px;flex-wrap:wrap}.zcs-button{width:auto;min-width:5rem;min-height:34px}.zcs-primary-button{background:#6850aa;border:1px solid #6850aa;color:#fff}.zcs-primary-outline-button{background:#fff;border:1px solid #7056b8;color:#5e449f}.zcs-button:hover{filter:brightness(.97)}.row-action{min-height:29px;min-width:0;font-size:12px;font-weight:600}.zcs-badge{width:auto;border:1px solid;font-size:12px}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#137b57}.zcs-badge-yellow{background:#fcf4e6;border-color:#d99a17;color:#8a620f}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#245ac2}.zcs-badge-orange{background:#f8f0eb;border-color:#e46b21;color:#a74b13}.zcs-badge-theme{background:#eeeafa;border-color:#7056b8;color:#5e449f}.zcs-progress-bar{height:7px;background:#ece9f3;overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:#7056b8}.progress-row{padding:12px 16px;border-bottom:1px solid var(--zcs-border-color)}.progress-row:last-child{border-bottom:0}.progress-label{min-width:0}.empty{height:100%;min-height:170px;padding:20px}.empty i{font-size:27px;color:#8b7cad}.empty h5{font-size:16px;margin:8px 0 0}.empty p{font-size:12px;color:var(--zcs-secondary-text-color);margin:4px 0 0}.quote-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:start}.quote-identity{min-width:0}.supplier-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;padding:11px}.supplier-card{padding:12px;border:1px solid var(--zcs-border-color);border-radius:9px;background:#fff;min-width:0}.supplier-card h3{font-size:14px;margin:0}.supplier-card p{font-size:12px;color:var(--zcs-secondary-text-color);margin:3px 0 0;overflow-wrap:anywhere}.zcs-table-wrapper{overflow:auto;background:#fff;border:0}.zcs-table-wrapper table{border-collapse:collapse;min-width:760px;line-height:normal}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:#f7f6fb;box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color);vertical-align:middle}.zcs-table-wrapper tbody tr:first-child td{border-top:0}.zcs-table-wrapper tbody tr:hover td{background:#faf9fd}.po-ready{border-top:1px solid var(--zcs-border-color);background:#fbfafe}.po-ready-scroll{max-height:210px;overflow:auto}\n@media(max-width:1180px){.demand-overview{grid-template-columns:repeat(4,minmax(0,1fr))}.primary-kpi{grid-column:1/-1}.span-5,.span-7{grid-column:span 6}}@media(max-width:900px){.dashboard-grid{grid-template-columns:1fr}.span-5,.span-7,.span-12{grid-column:auto}.section-scroll{height:330px}.demand-overview{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.sourcing-shell{padding:11px}.dashboard-header{padding:18px}.demand-overview{grid-template-columns:1fr}.primary-kpi{grid-column:auto}.section-head{align-items:flex-start}.supplier-grid{grid-template-columns:1fr}.zcs-table-wrapper table{min-width:680px}}\n&lt;/style&gt;\n&lt;div class=&apos;sourcing-shell zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n\t&lt;header class=&apos;dashboard-header&apos;&gt;\n\t\t&lt;div class=&apos;eyebrow&apos;&gt;Sourcing operations&lt;/div&gt;\n\t\t&lt;h1&gt;Quote demand and supplier coverage&lt;/h1&gt;\n\t\t&lt;p&gt;Scan requirements, supplier responses, comparison readiness, and purchase-order handoffs from one compact workspace.&lt;/p&gt;\n\t&lt;/header&gt;\n\n\t&lt;section class=&apos;demand-overview&apos; aria-label=&apos;Sourcing activity summary&apos;&gt;\n\t\t&lt;div class=&apos;primary-kpi zcs-card&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div&gt;&lt;div class=&apos;kpi-label&apos;&gt;Active quote demand&lt;/div&gt;&lt;div class=&apos;kpi-main zcs-mt-6&apos;&gt;&lt;%=ordersInSourcing.count()%&gt;&lt;/div&gt;&lt;div class=&apos;kpi-note&apos;&gt;Sales orders currently in sourcing&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&apos; style=&apos;background:#594979;color:#fff&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-list&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;kpi zcs-card&apos;&gt;&lt;div class=&apos;kpi-top&apos;&gt;&lt;span class=&apos;kpi-value&apos;&gt;&lt;%=awaitingQuoteCount%&gt;&lt;/span&gt;&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kpi-label&apos;&gt;Awaiting first quote&lt;/div&gt;&lt;div class=&apos;kpi-note&apos;&gt;Demand without coverage&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;kpi zcs-card&apos;&gt;&lt;div class=&apos;kpi-top&apos;&gt;&lt;span class=&apos;kpi-value&apos;&gt;&lt;%=receivedQuotes.count()%&gt;&lt;/span&gt;&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-tag-content&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kpi-label&apos;&gt;Responses received&lt;/div&gt;&lt;div class=&apos;kpi-note&apos;&gt;Quotes ready to inspect&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;kpi zcs-card&apos;&gt;&lt;div class=&apos;kpi-top&apos;&gt;&lt;span class=&apos;kpi-value&apos;&gt;&lt;%=comparisonReadyCount%&gt;&lt;/span&gt;&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline design-2-layout-11&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kpi-label&apos;&gt;Comparisons ready&lt;/div&gt;&lt;div class=&apos;kpi-note&apos;&gt;Multiple quotes available&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;kpi zcs-card&apos;&gt;&lt;div class=&apos;kpi-top&apos;&gt;&lt;span class=&apos;kpi-value&apos;&gt;&lt;%=selectedAwaitingPOCount%&gt;&lt;/span&gt;&lt;span class=&apos;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kpi-label&apos;&gt;Selected, no PO&lt;/div&gt;&lt;div class=&apos;kpi-note&apos;&gt;&lt;%=activeSupplierCount%&gt; active suppliers&lt;/div&gt;&lt;/div&gt;\n\t&lt;/section&gt;\n\n\t&lt;main class=&apos;dashboard-grid&apos;&gt;\n\t\t&lt;section class=&apos;work-card zcs-card span-5&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;h2&gt;Demand requiring outreach&lt;/h2&gt;&lt;p&gt;Requirements that have not received a supplier quote.&lt;/p&gt;&lt;/div&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Page:Requests_For_Quote&apos;&gt;Request queue&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;section-scroll record-list&apos;&gt;\n\t\t\t\t&lt;%if(awaitingQuoteCount == 0){%&gt;&lt;div class=&apos;empty zcs-wh-full zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;h5&gt;Every active order has coverage&lt;/h5&gt;&lt;p&gt;New requirements will appear here when outreach is needed.&lt;/p&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button row-action zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-md zcs-mt-12&apos; href=&apos;#Form:Create_Sales_Order?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;Create request&lt;/a&gt;&lt;/div&gt;&lt;%}else{for each awaitingOrder in ordersInSourcing{awaitingOrderQuoteCount = Add_Supplier_Quote[Sales_Order == awaitingOrder.ID].count();if(awaitingOrderQuoteCount == 0){customerName = &quot;No customer linked&quot;;if(awaitingOrder.Customer != null){customerName = awaitingOrder.Customer.Customer_Name;}%&gt;\n\t\t\t\t&lt;article class=&apos;record-row&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=awaitingOrder.ID%&gt;&apos;&gt;&lt;%=awaitingOrder.Sales_Order_ID%&gt;&lt;/a&gt;&lt;div class=&apos;meta&apos;&gt;&lt;%=customerName%&gt; | &lt;%=awaitingOrder.Requirement_Source%&gt; | Needed &lt;%=ifnull(awaitingOrder.Requested_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-yellow zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;No response&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;row-actions zcs-flex zcs-gap-8&apos;&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button row-action zcs-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-md&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=awaitingOrder.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-eye-19&apos;&gt;&lt;/i&gt;Detail&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-button row-action zcs-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-md&apos; href=&apos;#Form:Add_Supplier_Quote?zc_LoadIn=dialog&amp;amp;Sales_Order=&lt;%=awaitingOrder.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-tag-content&apos;&gt;&lt;/i&gt;Add response&lt;/a&gt;&lt;/div&gt;&lt;/article&gt;\n\t\t\t\t&lt;%}}%&gt;&lt;div class=&apos;zcs-py-8&apos;&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Form:Create_Sales_Order?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt; Create another sourcing request&lt;/a&gt;&lt;/div&gt;&lt;%}%&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;work-card zcs-card span-7&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;h2&gt;Supplier quote records&lt;/h2&gt;&lt;p&gt;Recent received responses with linked supplier and demand context.&lt;/p&gt;&lt;/div&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Report:All_Supplier_Quotes&apos;&gt;All quotes&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;section-scroll record-list&apos;&gt;\n\t\t\t\t&lt;%if(receivedQuotes.count() == 0){%&gt;&lt;div class=&apos;empty zcs-wh-full zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-tag-content&apos;&gt;&lt;/i&gt;&lt;h5&gt;No received quotes&lt;/h5&gt;&lt;p&gt;Supplier responses will appear here after they are recorded.&lt;/p&gt;&lt;/div&gt;&lt;%}else{for each quoteRecord in receivedQuotes{quoteSupplierName = &quot;Supplier not linked&quot;;quoteOrderName = &quot;Order not linked&quot;;if(quoteRecord.Supplier != null){quoteSupplierName = quoteRecord.Supplier.Supplier_Name;}if(quoteRecord.Sales_Order != null){quoteOrderName = quoteRecord.Sales_Order.Sales_Order_ID;}%&gt;\n\t\t\t\t&lt;article class=&apos;record-row quote-row&apos;&gt;&lt;div class=&apos;quote-identity&apos;&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Report:All_Supplier_Quotes?ID=&lt;%=quoteRecord.ID%&gt;&apos;&gt;&lt;%=quoteRecord.Supplier_Quote_ID%&gt;&lt;/a&gt;&lt;div class=&apos;meta&apos;&gt;&lt;strong&gt;&lt;%=quoteSupplierName%&gt;&lt;/strong&gt; | &lt;%=quoteOrderName%&gt; | Quoted &lt;%=ifnull(quoteRecord.Quote_Date,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-theme zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;Received&lt;/span&gt;&lt;/article&gt;\n\t\t\t\t&lt;%}}%&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;work-card zcs-card span-5&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;h2&gt;Coverage by order&lt;/h2&gt;&lt;p&gt;Responses measured only against the current active supplier count.&lt;/p&gt;&lt;/div&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Report:All_Sales_Orders&apos;&gt;All orders&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;section-scroll&apos;&gt;\n\t\t\t\t&lt;%if(ordersInSourcing.count() == 0){%&gt;&lt;div class=&apos;empty zcs-wh-full zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;h5&gt;No active sourcing demand&lt;/h5&gt;&lt;p&gt;Create a request to begin supplier outreach.&lt;/p&gt;&lt;/div&gt;&lt;%}else{for each progressOrder in ordersInSourcing{progressQuoteCount = Add_Supplier_Quote[Sales_Order == progressOrder.ID].count();responsePercent = 0;if(activeSupplierCount &gt; 0){responsePercent = ((progressQuoteCount * 100) / activeSupplierCount).round(0);if(responsePercent &gt; 100){responsePercent = 100;}}%&gt;\n\t\t\t\t&lt;div class=&apos;progress-row&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;div class=&apos;progress-label&apos;&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=progressOrder.ID%&gt;&apos;&gt;&lt;%=progressOrder.Sales_Order_ID%&gt;&lt;/a&gt;&lt;div class=&apos;meta&apos;&gt;&lt;%=progressQuoteCount%&gt; response&lt;%if(progressQuoteCount != 1){%&gt;s&lt;%}%&gt; from &lt;%=activeSupplierCount%&gt; active suppliers&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-font-13 zcs-font-semibold&apos;&gt;&lt;%=responsePercent%&gt;%&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm zcs-mt-8&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=responsePercent%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;%}}%&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;work-card zcs-card span-7&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;h2&gt;Comparisons ready for decision&lt;/h2&gt;&lt;p&gt;Orders with multiple responses and no selected supplier quote.&lt;/p&gt;&lt;/div&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Report:All_Sales_Orders&apos;&gt;Order report&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;section-scroll record-list&apos;&gt;\n\t\t\t\t&lt;%if(comparisonReadyCount == 0){%&gt;&lt;div class=&apos;empty zcs-wh-full zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;i class=&apos;zc-li-outline design-2-layout-11&apos;&gt;&lt;/i&gt;&lt;h5&gt;No comparisons ready&lt;/h5&gt;&lt;p&gt;At least two responses are needed before a comparison is surfaced.&lt;/p&gt;&lt;/div&gt;&lt;%}else{for each comparisonOrder in ordersInSourcing{comparisonQuoteCount = Add_Supplier_Quote[Sales_Order == comparisonOrder.ID].count();if(comparisonQuoteCount &gt; 1 &amp;&amp; comparisonOrder.Selected_Supplier_Quote == null){%&gt;\n\t\t\t\t&lt;article class=&apos;record-row&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=comparisonOrder.ID%&gt;&apos;&gt;&lt;%=comparisonOrder.Sales_Order_ID%&gt;&lt;/a&gt;&lt;div class=&apos;meta&apos;&gt;&lt;%=comparisonQuoteCount%&gt; quotes | Needed &lt;%=ifnull(comparisonOrder.Requested_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-green zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;Ready&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;row-actions zcs-flex zcs-gap-8&apos;&gt;&lt;a class=&apos;zcs-button zcs-primary-button row-action zcs-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-md&apos; href=&apos;#Page:Quote_Comparison?Sales_Order_ID=&lt;%=comparisonOrder.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline design-2-layout-11&apos;&gt;&lt;/i&gt;Compare&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button row-action zcs-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-md&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=comparisonOrder.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-eye-19&apos;&gt;&lt;/i&gt;Detail&lt;/a&gt;&lt;/div&gt;&lt;/article&gt;\n\t\t\t\t&lt;%}}}%&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;work-card zcs-card span-12&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;h2&gt;Active supplier network&lt;/h2&gt;&lt;p&gt;Partner coverage and recorded response volume for sourcing outreach.&lt;/p&gt;&lt;/div&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Form:Add_Supplier?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt; Add supplier&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;section-scroll&apos;&gt;\n\t\t\t\t&lt;%if(activeSupplierCount == 0){%&gt;&lt;div class=&apos;empty zcs-wh-full zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-handshake&apos;&gt;&lt;/i&gt;&lt;h5&gt;No active suppliers&lt;/h5&gt;&lt;p&gt;Add or activate a supplier before requesting quotes.&lt;/p&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;supplier-grid&apos;&gt;&lt;%for each supplierRecord in activeSuppliers{supplierQuoteCount = Add_Supplier_Quote[Supplier == supplierRecord.ID].count();%&gt;&lt;article class=&apos;supplier-card&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;div&gt;&lt;h3&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Report:All_Suppliers?ID=&lt;%=supplierRecord.ID%&gt;&apos;&gt;&lt;%=supplierRecord.Supplier_Name%&gt;&lt;/a&gt;&lt;/h3&gt;&lt;p&gt;&lt;%=ifnull(supplierRecord.Contact_Person,&quot;No contact&quot;)%&gt; | &lt;%=ifnull(supplierRecord.Country,&quot;Country not set&quot;)%&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;%=supplierQuoteCount%&gt;&lt;/strong&gt; quote response&lt;%if(supplierQuoteCount != 1){%&gt;s&lt;%}%&gt; recorded&lt;/p&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-green zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;Active&lt;/span&gt;&lt;/div&gt;&lt;/article&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%}%&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;work-card zcs-card span-12&apos;&gt;\n\t\t\t&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;h2&gt;Purchase-order handoffs&lt;/h2&gt;&lt;p&gt;Open POs and the next operational handoff implied by each existing status.&lt;/p&gt;&lt;/div&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Report:All_Purchase_Orders&apos;&gt;All purchase orders&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;section-scroll zcs-table-wrapper zcs-relative&apos;&gt;\n\t\t\t\t&lt;%if(openPurchaseOrders.count() == 0){%&gt;&lt;div class=&apos;empty zcs-wh-full zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;h5&gt;No open purchase-order handoffs&lt;/h5&gt;&lt;p&gt;Selected quotes awaiting a PO are shown in the handoff queue below.&lt;/p&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Purchase order&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Supplier&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Sales order&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Status&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Next handoff&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Action&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%for each poRecord in openPurchaseOrders{nextHandoff = &quot;Review status&quot;;badgeClass = &quot;zcs-badge-blue&quot;;if(poRecord.Status == &quot;New&quot;){nextHandoff = &quot;Internal approval&quot;;badgeClass = &quot;zcs-badge-yellow&quot;;}else if(poRecord.Status == &quot;Approved&quot;){nextHandoff = &quot;Share with customer&quot;;badgeClass = &quot;zcs-badge-orange&quot;;}else if(poRecord.Status == &quot;Customer Approved&quot;){nextHandoff = &quot;Supplier invoice&quot;;badgeClass = &quot;zcs-badge-green&quot;;}else if(poRecord.Status == &quot;Invoice Created&quot;){nextHandoff = &quot;Payment confirmation&quot;;}else if(poRecord.Status == &quot;Invoice Paid&quot; || poRecord.Status == &quot;Logistics Pending&quot;){nextHandoff = &quot;Logistics booking&quot;;}else if(poRecord.Status == &quot;Products Received&quot;){nextHandoff = &quot;Delivery confirmation&quot;;}supplierName = &quot;Supplier not linked&quot;;if(poRecord.Supplier != null){supplierName = poRecord.Supplier.Supplier_Name;}salesOrderName = &quot;Order not linked&quot;;if(poRecord.Sales_Order != null){salesOrderName = poRecord.Sales_Order.Sales_Order_ID;}%&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=poRecord.ID%&gt;&apos;&gt;&lt;%=poRecord.Purchase_Order_ID%&gt;&lt;/a&gt;&lt;div class=&apos;meta&apos;&gt;&lt;%=poRecord.PO_Date%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=supplierName%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=salesOrderName%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;zcs-badge &lt;%=badgeClass%&gt; zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=ifnull(poRecord.Status,&quot;Unknown&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=nextHandoff%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button row-action zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-md&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=poRecord.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-eye-19&apos;&gt;&lt;/i&gt;Detail&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;%}%&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;%if(selectedAwaitingPOCount &gt; 0){%&gt;&lt;div class=&apos;po-ready zcs-p-16&apos;&gt;&lt;div&gt;&lt;strong&gt;&lt;%=selectedAwaitingPOCount%&gt; selected quote&lt;%if(selectedAwaitingPOCount != 1){%&gt;s&lt;%}%&gt; need a purchase order&lt;/strong&gt;&lt;div class=&apos;meta&apos;&gt;Create the PO from the selected quote to preserve supplier and source links.&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;po-ready-scroll record-list&apos; style=&apos;padding:0&apos;&gt;&lt;%for each poReadyQuote in selectedQuotes{existingPOCount = Create_Purchase_Order[Selected_Supplier_Quote == poReadyQuote.ID].count();if(existingPOCount == 0){poReadySupplierName = &quot;Supplier not linked&quot;;poReadyOrderName = &quot;Order not linked&quot;;poSupplierID = &quot;&quot;;poOrderID = &quot;&quot;;if(poReadyQuote.Supplier != null){poReadySupplierName = poReadyQuote.Supplier.Supplier_Name;poSupplierID = poReadyQuote.Supplier.ID;}if(poReadyQuote.Sales_Order != null){poReadyOrderName = poReadyQuote.Sales_Order.Sales_Order_ID;poOrderID = poReadyQuote.Sales_Order.ID;}%&gt;&lt;article class=&apos;record-row&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Report:All_Supplier_Quotes?ID=&lt;%=poReadyQuote.ID%&gt;&apos;&gt;&lt;%=poReadyQuote.Supplier_Quote_ID%&gt;&lt;/a&gt;&lt;div class=&apos;meta&apos;&gt;&lt;%=poReadySupplierName%&gt; | &lt;%=poReadyOrderName%&gt;&lt;/div&gt;&lt;/div&gt;&lt;%if(poSupplierID != &quot;&quot; &amp;&amp; poOrderID != &quot;&quot;){%&gt;&lt;a class=&apos;zcs-button zcs-primary-button row-action zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-md&apos; href=&apos;#Form:Create_Purchase_Order?zc_LoadIn=dialog&amp;amp;Supplier=&lt;%=poSupplierID%&gt;&amp;amp;Sales_Order=&lt;%=poOrderID%&gt;&amp;amp;Selected_Supplier_Quote=&lt;%=poReadyQuote.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;Create PO&lt;/a&gt;&lt;%}else{%&gt;&lt;span class=&apos;zcs-badge zcs-badge-yellow zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;Link data required&lt;/span&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/article&gt;&lt;%}}%&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}%&gt;\n\t\t&lt;/section&gt;\n\t&lt;/main&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Supplier_Dashboard
		{
					displayname = "Supplier Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Supplier_Dashboard_Snippet' elementName='Supplier_Dashboard_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Supplier_Dashboard_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nloginEmail = zoho.loginuserid;\nactiveSuppliers = Add_Supplier[Email == loginEmail &amp;&amp; Active == true];\nsupplierCount = activeSuppliers.count();\nidentityReady = supplierCount == 1;\nsupplierId = 0;\nsupplierName = &quot;Supplier&quot;;\nif(identityReady)\n{\n\t\tfor each supplierRec in activeSuppliers\n\t\t{\n\t\t\t\tsupplierId = supplierRec.ID;\n\t\t\t\tsupplierName = supplierRec.Supplier_Name;\n\t\t}\n}\nopenRequests = Create_Sales_Order[ID == 0];\nmyQuotes = Add_Supplier_Quote[ID == 0];\nmyPOs = Create_Purchase_Order[ID == 0];\nmyInvoices = Add_Supplier_Invoice[ID == 0];\nquotesDue = 0;\nactiveDeliveries = 0;\nunpaidInvoices = 0;\nexceptionCount = 0;\nif(identityReady)\n{\n\t\topenRequests = Create_Sales_Order[(Status == &quot;New&quot; || Status == &quot;Quotes Received&quot;) &amp;&amp; (Recommended_Supplier == null || Recommended_Supplier == supplierId)] sort by Requested_Delivery_Date asc;\n\t\tmyQuotes = Add_Supplier_Quote[Supplier == supplierId] sort by Quote_Date descending;\n\t\tmyPOs = Create_Purchase_Order[Supplier == supplierId] sort by Expected_Delivery_Date asc;\n\t\tmyInvoices = Add_Supplier_Invoice[Supplier == supplierId] sort by Invoice_Date descending;\n\t\tfor each requestRec in openRequests\n\t\t{\n\t\t\t\trequestQuote = Add_Supplier_Quote[Supplier == supplierId &amp;&amp; Sales_Order == requestRec.ID];\n\t\t\t\tif(requestQuote.count() == 0)\n\t\t\t\t{\n\t\t\t\t\t\tquotesDue = quotesDue + 1;\n\t\t\t\t}\n\t\t}\n\t\tfor each poCalc in myPOs\n\t\t{\n\t\t\t\tcalcStatus = ifnull(poCalc.Status,&quot;New&quot;);\n\t\t\t\tif(calcStatus != &quot;Products Received&quot; &amp;&amp; calcStatus != &quot;Delivered&quot;)\n\t\t\t\t{\n\t\t\t\t\t\tactiveDeliveries = activeDeliveries + 1;\n\t\t\t\t\t\tif(poCalc.Expected_Delivery_Date != null &amp;&amp; poCalc.Expected_Delivery_Date &lt; zoho.currentdate)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\texceptionCount = exceptionCount + 1;\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t}\n\t\tfor each invCalc in myInvoices\n\t\t{\n\t\t\t\tif(ifnull(invCalc.Status,&quot;New&quot;) != &quot;Paid&quot;)\n\t\t\t\t{\n\t\t\t\t\t\tunpaidInvoices = unpaidInvoices + 1;\n\t\t\t\t}\n\t\t}\n}\n%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:.625rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-medium{font-weight:500}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-sticky{position:sticky}a{text-decoration:none}\n.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%;width:100%}.zc-container-wrapper .zc-main-content .inner,.zc-page-content-wrapper,.zc-pb-page-content-wrapper,.zc-pb-tile-container,.zc-pb-tile-card{max-width:none!important;width:100%!important}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}#splash-screen,.zc-page-loader{display:none!important}\n.zcs-table-wrapper{border:0;background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;line-height:normal;min-width:600px}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:#f8f7fc;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap;color:var(--zcs_secondary_text_color);font-size:12px;text-transform:uppercase;letter-spacing:.03em}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper tbody tr:hover td{background:#faf9fd}.zcs-badge{width:auto;border:1px solid;font-size:12px;white-space:nowrap}.zcs-badge-theme{background:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#167c59}.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#c52e45}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#245bcc}.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#946200}.zcs-badge-orange{background:#f8f0eb;border-color:#f4660c;color:#b64b08}.zcs-badge-grey{background:#eee;border-color:#666;color:#444}.zcs-progress-bar{height:6px;background:var(--zcs_component_hover_color);border-radius:4px;overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}\n.supplier-home{min-height:100%;padding:18px;background:#f6f5f9;color:var(--zcs_primary_text_color);font:14px/1.45 Arial,sans-serif;box-sizing:border-box}.workspace-intro{margin-bottom:12px}.workspace-intro h1{margin:0;font-size:24px}.workspace-intro p{margin:3px 0 0;color:var(--zcs_secondary_text_color)}.summary-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;margin-bottom:12px}.summary-card{position:relative;overflow:hidden;padding:11px 12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:9px;background:#fff}.summary-card:before{position:absolute;content:&quot;&quot;;inset:0 auto 0 0;width:3px;background:#7557b8}.summary-icon{color:#7557b8;font-size:15px}.summary-label{color:var(--zcs_secondary_text_color);font-size:11px;text-transform:uppercase;letter-spacing:.04em}.summary-value{margin-top:2px;font-size:20px;font-weight:700}.summary-sub{color:var(--zcs_secondary_text_color);font-size:11px}.summary-card.warn:before{background:#d58a16}.summary-card.danger:before{background:#d84a60}.summary-card.good:before{background:#179e6c}.workspace-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.panel-card{min-width:0;overflow:hidden;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;background:#fff}.panel-head{height:62px;padding:10px 13px;border-bottom:1px solid var(--zcs_tertiary_border_color);box-sizing:border-box}.panel-icon{width:30px;height:30px;flex:0 0 30px;border-radius:8px;background:#f0ebfa;color:#694aa9;font-size:15px}.panel-title{margin:0;font-size:15px}.panel-note{color:var(--zcs_secondary_text_color);font-size:11px}.panel-count{min-width:22px;padding:2px 7px;border-radius:12px;background:#f0ebfa;color:#694aa9;text-align:center;font-weight:700}.panel-scroll{height:286px;overflow:auto}.empty{height:100%;min-height:250px}.empty i{font-size:22px;color:#9b8dbb}.empty h5{margin:8px 0 0}.empty p{margin:3px 0;color:var(--zcs_secondary_text_color)}.record-link{color:#6846a7;font-weight:600}.muted{color:var(--zcs_secondary_text_color);font-size:12px}.queue{padding:8px}.queue-item{padding:10px;border:1px solid var(--zcs_tertiary_border_color);border-radius:8px}.queue-item+.queue-item{margin-top:7px}.queue-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}.queue-meta{display:grid;grid-template-columns:86px 1fr;gap:4px 8px;margin-top:7px;font-size:12px}.queue-meta span:nth-child(odd){color:var(--zcs_secondary_text_color)}.progress-copy{display:flex;justify-content:space-between;gap:8px;margin-top:7px;font-size:11px;color:var(--zcs_secondary_text_color)}.identity-state{max-width:720px;margin:44px auto;padding:32px;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;background:#fff;text-align:center}.identity-state i{font-size:32px;color:#7557b8}.identity-state p{color:var(--zcs_secondary_text_color)}.action-link{display:inline-flex;align-items:center;gap:6px;padding:6px 9px;border-radius:6px;background:#7557b8;color:#fff;font-size:12px;font-weight:600}\n@media(max-width:1180px){.summary-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:900px){.workspace-grid{grid-template-columns:1fr}}@media(max-width:620px){.supplier-home{padding:10px}.summary-grid{grid-template-columns:repeat(2,1fr)}.panel-scroll{height:320px}.desktop-table{display:none}.workspace-intro h1{font-size:21px}}@media(min-width:621px){.mobile-queue{display:none}}\n&lt;/style&gt;\n&lt;div class=&apos;supplier-home&apos;&gt;\n\t&lt;div class=&apos;workspace-intro&apos;&gt;&lt;h1&gt;Supplier workspace&lt;/h1&gt;&lt;p&gt;&lt;%if(identityReady){%&gt;&lt;strong&gt;&lt;%=supplierName%&gt;&lt;/strong&gt; | &lt;%}%&gt;&lt;%=loginEmail%&gt;&lt;/p&gt;&lt;p&gt;Requests, commercial responses, order commitments, invoices, and delivery risk at a glance.&lt;/p&gt;&lt;/div&gt;\n\t&lt;%if(!identityReady){%&gt;\n\t\t&lt;section class=&apos;identity-state&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-alert-circle&apos;&gt;&lt;/i&gt;&lt;%if(supplierCount == 0){%&gt;&lt;h2&gt;No active supplier account found&lt;/h2&gt;&lt;p&gt;This login is not linked to an active supplier record. Contact your portal administrator to verify &lt;strong&gt;&lt;%=loginEmail%&gt;&lt;/strong&gt;.&lt;/p&gt;&lt;%}else{%&gt;&lt;h2&gt;Supplier account needs review&lt;/h2&gt;&lt;p&gt;More than one active supplier record uses &lt;strong&gt;&lt;%=loginEmail%&gt;&lt;/strong&gt;. For your privacy, no supplier data is shown until an administrator resolves the duplicate records.&lt;/p&gt;&lt;%}%&gt;&lt;/section&gt;\n\t&lt;%}else{%&gt;\n\t\t&lt;section class=&apos;summary-grid&apos;&gt;\n\t\t\t&lt;div class=&apos;summary-card warn&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;summary-label&apos;&gt;RFQs awaiting quote&lt;/span&gt;&lt;i class=&apos;summary-icon zc-li-outline files-archive-drawer&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=quotesDue%&gt;&lt;/div&gt;&lt;div class=&apos;summary-sub&apos;&gt;&lt;%=openRequests.count()%&gt; eligible requests&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;summary-card&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;summary-label&apos;&gt;Quotes&lt;/span&gt;&lt;i class=&apos;summary-icon zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=myQuotes.count()%&gt;&lt;/div&gt;&lt;div class=&apos;summary-sub&apos;&gt;Submitted responses&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;summary-card&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;summary-label&apos;&gt;Purchase orders&lt;/span&gt;&lt;i class=&apos;summary-icon zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=myPOs.count()%&gt;&lt;/div&gt;&lt;div class=&apos;summary-sub&apos;&gt;All assigned orders&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;summary-card warn&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;summary-label&apos;&gt;Unpaid invoices&lt;/span&gt;&lt;i class=&apos;summary-icon zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=unpaidInvoices%&gt;&lt;/div&gt;&lt;div class=&apos;summary-sub&apos;&gt;&lt;%=myInvoices.count()%&gt; total invoices&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;summary-card good&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;summary-label&apos;&gt;Delivery obligations&lt;/span&gt;&lt;i class=&apos;summary-icon zc-li-outline transportation-truck&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=activeDeliveries%&gt;&lt;/div&gt;&lt;div class=&apos;summary-sub&apos;&gt;Open fulfillment commitments&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;summary-card danger&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;summary-label&apos;&gt;Exceptions&lt;/span&gt;&lt;i class=&apos;summary-icon zc-li-outline ui-2-alert-circle&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=exceptionCount%&gt;&lt;/div&gt;&lt;div class=&apos;summary-sub&apos;&gt;Past expected delivery&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t\t&lt;main class=&apos;workspace-grid&apos;&gt;\n\t\t\t&lt;section class=&apos;panel-card&apos;&gt;&lt;div class=&apos;panel-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;panel-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline files-archive-drawer&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2 class=&apos;panel-title&apos;&gt;Request for quotations&lt;/h2&gt;&lt;div class=&apos;panel-note&apos;&gt;Eligible requests and response state&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;panel-count&apos;&gt;&lt;%=openRequests.count()%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;panel-scroll&apos;&gt;\n\t\t\t\t&lt;%if(openRequests.count()==0){%&gt;&lt;div class=&apos;empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div&gt;&lt;i class=&apos;zc-li-outline files-archive-drawer&apos;&gt;&lt;/i&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium&apos;&gt;No open requests&lt;/h5&gt;&lt;p&gt;New eligible requests will appear here.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;zcs-table-wrapper desktop-table&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8 zcs-text-left&apos;&gt;Request&lt;/th&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8 zcs-text-left&apos;&gt;Required by&lt;/th&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8 zcs-text-left&apos;&gt;Requirement&lt;/th&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8 zcs-text-left&apos;&gt;Response&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%for each orderRec in openRequests{existingQuote=Add_Supplier_Quote[Supplier==supplierId &amp;&amp; Sales_Order==orderRec.ID];%&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=orderRec.ID%&gt;&apos;&gt;&lt;%=orderRec.Sales_Order_ID%&gt;&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-12 zcs-py-8&apos;&gt;&lt;%=ifnull(orderRec.Requested_Delivery_Date,&quot;Not specified&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-12 zcs-py-8&apos;&gt;&lt;%=ifnull(orderRec.Customer_Requirements,&quot;Not provided&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-12 zcs-py-8&apos;&gt;&lt;%if(existingQuote.count()==0){%&gt;&lt;a class=&apos;action-link&apos; href=&apos;#Form:Add_Supplier_Quote?Supplier=&lt;%=supplierId%&gt;&amp;amp;Sales_Order=&lt;%=orderRec.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;Submit quote&lt;/a&gt;&lt;%}else{%&gt;&lt;span class=&apos;zcs-badge zcs-badge-green zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;Submitted&lt;/span&gt;&lt;%}%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;div class=&apos;queue mobile-queue&apos;&gt;&lt;%for each orderRec in openRequests{existingQuote=Add_Supplier_Quote[Supplier==supplierId &amp;&amp; Sales_Order==orderRec.ID];%&gt;&lt;article class=&apos;queue-item&apos;&gt;&lt;div class=&apos;queue-top&apos;&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=orderRec.ID%&gt;&apos;&gt;&lt;%=orderRec.Sales_Order_ID%&gt;&lt;/a&gt;&lt;span class=&apos;muted&apos;&gt;&lt;%=ifnull(orderRec.Requested_Delivery_Date,&quot;No date&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;queue-meta&apos;&gt;&lt;span&gt;Requirement&lt;/span&gt;&lt;span&gt;&lt;%=ifnull(orderRec.Customer_Requirements,&quot;Not provided&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-mt-10&apos;&gt;&lt;%if(existingQuote.count()==0){%&gt;&lt;a class=&apos;action-link&apos; href=&apos;#Form:Add_Supplier_Quote?Supplier=&lt;%=supplierId%&gt;&amp;amp;Sales_Order=&lt;%=orderRec.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;Submit quote&lt;/a&gt;&lt;%}else{%&gt;&lt;span class=&apos;zcs-badge zcs-badge-green zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;Quote submitted&lt;/span&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/article&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%}%&gt;\n\t\t\t&lt;/div&gt;&lt;/section&gt;\n\t\t\t&lt;section class=&apos;panel-card&apos;&gt;&lt;div class=&apos;panel-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;panel-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2 class=&apos;panel-title&apos;&gt;Quotes&lt;/h2&gt;&lt;div class=&apos;panel-note&apos;&gt;Commercial response status and timing&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;panel-count&apos;&gt;&lt;%=myQuotes.count()%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;panel-scroll&apos;&gt;&lt;%if(myQuotes.count()==0){%&gt;&lt;div class=&apos;empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div&gt;&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium&apos;&gt;No submitted quotes&lt;/h5&gt;&lt;p&gt;Respond to an eligible RFQ to begin.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;queue&apos;&gt;&lt;%for each quoteRec in myQuotes{quoteStatus=ifnull(quoteRec.Status,&quot;Received&quot;);badge=&quot;zcs-badge-blue&quot;;quoteProgress=35;if(quoteStatus==&quot;Selected&quot;){badge=&quot;zcs-badge-green&quot;;quoteProgress=100;}else if(quoteStatus==&quot;Rejected&quot;){badge=&quot;zcs-badge-grey&quot;;quoteProgress=100;}%&gt;&lt;article class=&apos;queue-item&apos;&gt;&lt;div class=&apos;queue-top&apos;&gt;&lt;div&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Report:All_Supplier_Quotes?ID=&lt;%=quoteRec.ID%&gt;&apos;&gt;&lt;%=quoteRec.Supplier_Quote_ID%&gt;&lt;/a&gt;&lt;div class=&apos;muted&apos;&gt;&lt;%=quoteRec.Sales_Order.Sales_Order_ID%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge &lt;%=badge%&gt; zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=quoteStatus%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;queue-meta&apos;&gt;&lt;span&gt;Quote date&lt;/span&gt;&lt;span&gt;&lt;%=quoteRec.Quote_Date%&gt;&lt;/span&gt;&lt;span&gt;Lead time&lt;/span&gt;&lt;span&gt;&lt;%=ifnull(quoteRec.Lead_Time,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;progress-copy&apos;&gt;&lt;span&gt;Response progress&lt;/span&gt;&lt;span&gt;&lt;%=quoteProgress%&gt;%&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=quoteProgress%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/article&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t\t&lt;section class=&apos;panel-card&apos;&gt;&lt;div class=&apos;panel-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;panel-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2 class=&apos;panel-title&apos;&gt;Purchase orders&lt;/h2&gt;&lt;div class=&apos;panel-note&apos;&gt;Order status and required next step&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;panel-count&apos;&gt;&lt;%=myPOs.count()%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;panel-scroll&apos;&gt;&lt;%if(myPOs.count()==0){%&gt;&lt;div class=&apos;empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium&apos;&gt;No purchase orders&lt;/h5&gt;&lt;p&gt;Selected quotes will move here.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;queue&apos;&gt;&lt;%for each poRec in myPOs{poStatus=ifnull(poRec.Status,&quot;New&quot;);poBadge=&quot;zcs-badge-blue&quot;;nextAction=&quot;Review the order&quot;;poProgress=15;if(poStatus==&quot;Customer Approved&quot;){poBadge=&quot;zcs-badge-yellow&quot;;nextAction=&quot;Submit supplier invoice&quot;;poProgress=35;}else if(poStatus==&quot;Invoice Paid&quot;){poBadge=&quot;zcs-badge-orange&quot;;nextAction=&quot;Prepare dispatch&quot;;poProgress=60;}else if(poStatus==&quot;Logistics Pending&quot;){poBadge=&quot;zcs-badge-orange&quot;;nextAction=&quot;Meet delivery commitment&quot;;poProgress=80;}else if(poStatus==&quot;Products Received&quot; || poStatus==&quot;Delivered&quot;){poBadge=&quot;zcs-badge-green&quot;;nextAction=&quot;No action due&quot;;poProgress=100;}%&gt;&lt;article class=&apos;queue-item&apos;&gt;&lt;div class=&apos;queue-top&apos;&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=poRec.ID%&gt;&apos;&gt;&lt;%=poRec.Purchase_Order_ID%&gt;&lt;/a&gt;&lt;span class=&apos;zcs-badge &lt;%=poBadge%&gt; zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=poStatus%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;queue-meta&apos;&gt;&lt;span&gt;Expected&lt;/span&gt;&lt;span&gt;&lt;%=ifnull(poRec.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;span&gt;Next step&lt;/span&gt;&lt;span&gt;&lt;%if(poStatus==&quot;Customer Approved&quot;){%&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Form:Add_Supplier_Invoice?Supplier=&lt;%=supplierId%&gt;&amp;amp;Purchase_Order=&lt;%=poRec.ID%&gt;&amp;amp;Sales_Order=&lt;%=poRec.Sales_Order.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;%=nextAction%&gt;&lt;/a&gt;&lt;%}else{%&gt;&lt;%=nextAction%&gt;&lt;%}%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;progress-copy&apos;&gt;&lt;span&gt;Fulfillment progress&lt;/span&gt;&lt;span&gt;&lt;%=poProgress%&gt;%&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=poProgress%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/article&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t\t&lt;section class=&apos;panel-card&apos;&gt;&lt;div class=&apos;panel-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;panel-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2 class=&apos;panel-title&apos;&gt;Invoices&lt;/h2&gt;&lt;div class=&apos;panel-note&apos;&gt;Submitted values and payment progress&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;panel-count&apos;&gt;&lt;%=myInvoices.count()%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;panel-scroll&apos;&gt;&lt;%if(myInvoices.count()==0){%&gt;&lt;div class=&apos;empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div&gt;&lt;i class=&apos;zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium&apos;&gt;No invoices submitted&lt;/h5&gt;&lt;p&gt;Invoice-ready orders will show the next step.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;queue&apos;&gt;&lt;%for each invRec in myInvoices{invStatus=ifnull(invRec.Status,&quot;New&quot;);invBadge=&quot;zcs-badge-yellow&quot;;invProgress=50;invNext=&quot;Await payment update&quot;;if(invStatus==&quot;Paid&quot;){invBadge=&quot;zcs-badge-green&quot;;invProgress=100;invNext=&quot;Payment recorded&quot;;}%&gt;&lt;article class=&apos;queue-item&apos;&gt;&lt;div class=&apos;queue-top&apos;&gt;&lt;div&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Supplier_Invoice_Detail?Supplier_Invoice_ID=&lt;%=invRec.ID%&gt;&apos;&gt;&lt;%=invRec.Supplier_Invoice_ID%&gt;&lt;/a&gt;&lt;div class=&apos;muted&apos;&gt;&lt;%=invRec.Supplier_Invoice_Number%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge &lt;%=invBadge%&gt; zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=invStatus%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;queue-meta&apos;&gt;&lt;span&gt;PO&lt;/span&gt;&lt;span&gt;&lt;%if(invRec.Purchase_Order!=null){%&gt;&lt;%=invRec.Purchase_Order.Purchase_Order_ID%&gt;&lt;%}else{%&gt;Not linked&lt;%}%&gt;&lt;/span&gt;&lt;span&gt;Amount&lt;/span&gt;&lt;span&gt;&lt;%=ifnull(invRec.Currency,&quot;&quot;)%&gt; &lt;%=ifnull(invRec.Invoice_Amount,0)%&gt;&lt;/span&gt;&lt;span&gt;Next step&lt;/span&gt;&lt;span&gt;&lt;%=invNext%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;progress-copy&apos;&gt;&lt;span&gt;Payment progress&lt;/span&gt;&lt;span&gt;&lt;%=invProgress%&gt;%&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=invProgress%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/article&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t\t&lt;section class=&apos;panel-card&apos;&gt;&lt;div class=&apos;panel-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;panel-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline transportation-truck&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2 class=&apos;panel-title&apos;&gt;Delivery obligations&lt;/h2&gt;&lt;div class=&apos;panel-note&apos;&gt;Open commitments ordered by expected date&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;panel-count&apos;&gt;&lt;%=activeDeliveries%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;panel-scroll&apos;&gt;&lt;%if(activeDeliveries==0){%&gt;&lt;div class=&apos;empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium&apos;&gt;No open delivery obligations&lt;/h5&gt;&lt;p&gt;Active fulfillment commitments will appear here.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;queue&apos;&gt;&lt;%for each deliveryRec in myPOs{deliveryStatus=ifnull(deliveryRec.Status,&quot;New&quot;);if(deliveryStatus!=&quot;Products Received&quot; &amp;&amp; deliveryStatus!=&quot;Delivered&quot;){deliveryBadge=&quot;zcs-badge-blue&quot;;deliveryProgress=15;if(deliveryStatus==&quot;Customer Approved&quot;){deliveryBadge=&quot;zcs-badge-yellow&quot;;deliveryProgress=35;}else if(deliveryStatus==&quot;Invoice Paid&quot;){deliveryBadge=&quot;zcs-badge-orange&quot;;deliveryProgress=60;}else if(deliveryStatus==&quot;Logistics Pending&quot;){deliveryBadge=&quot;zcs-badge-orange&quot;;deliveryProgress=80;}%&gt;&lt;article class=&apos;queue-item&apos;&gt;&lt;div class=&apos;queue-top&apos;&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=deliveryRec.ID%&gt;&apos;&gt;&lt;%=deliveryRec.Purchase_Order_ID%&gt;&lt;/a&gt;&lt;span class=&apos;zcs-badge &lt;%=deliveryBadge%&gt; zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=deliveryStatus%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;queue-meta&apos;&gt;&lt;span&gt;Expected&lt;/span&gt;&lt;span&gt;&lt;%=ifnull(deliveryRec.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;span&gt;Sales order&lt;/span&gt;&lt;span&gt;&lt;%=deliveryRec.Sales_Order.Sales_Order_ID%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;progress-copy&apos;&gt;&lt;span&gt;Delivery readiness&lt;/span&gt;&lt;span&gt;&lt;%=deliveryProgress%&gt;%&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=deliveryProgress%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/article&gt;&lt;%}}%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t\t&lt;section class=&apos;panel-card&apos;&gt;&lt;div class=&apos;panel-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;panel-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-alert-circle&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2 class=&apos;panel-title&apos;&gt;Exceptions&lt;/h2&gt;&lt;div class=&apos;panel-note&apos;&gt;Open orders past their expected delivery date&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;panel-count&apos;&gt;&lt;%=exceptionCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;panel-scroll&apos;&gt;&lt;%if(exceptionCount==0){%&gt;&lt;div class=&apos;empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium&apos;&gt;No delivery exceptions&lt;/h5&gt;&lt;p&gt;Open commitments are within their recorded dates.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;queue&apos;&gt;&lt;%for each exceptionRec in myPOs{exceptionStatus=ifnull(exceptionRec.Status,&quot;New&quot;);if(exceptionStatus!=&quot;Products Received&quot; &amp;&amp; exceptionStatus!=&quot;Delivered&quot; &amp;&amp; exceptionRec.Expected_Delivery_Date!=null &amp;&amp; exceptionRec.Expected_Delivery_Date&lt;zoho.currentdate){%&gt;&lt;article class=&apos;queue-item&apos;&gt;&lt;div class=&apos;queue-top&apos;&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=exceptionRec.ID%&gt;&apos;&gt;&lt;%=exceptionRec.Purchase_Order_ID%&gt;&lt;/a&gt;&lt;span class=&apos;zcs-badge zcs-badge-red zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;Past expected date&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;queue-meta&apos;&gt;&lt;span&gt;Expected&lt;/span&gt;&lt;span&gt;&lt;%=exceptionRec.Expected_Delivery_Date%&gt;&lt;/span&gt;&lt;span&gt;Status&lt;/span&gt;&lt;span&gt;&lt;%=exceptionStatus%&gt;&lt;/span&gt;&lt;span&gt;Required&lt;/span&gt;&lt;span&gt;Review the order and delivery commitment&lt;/span&gt;&lt;/div&gt;&lt;/article&gt;&lt;%}}%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;/main&gt;\n\t&lt;%}%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Supplier_Invoice_Detail(int Supplier_Invoice_ID)
		{
					displayname = "Supplier Invoice Detail"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Supplier_Invoice_Detail_Snippet' elementName='Supplier_Invoice_Detail'>\n\t\t\t\t\t<![CDATA[htmlpage Supplier_Invoice_Detail_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\ninvoiceList = Add_Supplier_Invoice[ID == input.Supplier_Invoice_ID];\n%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#f3f3f4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--column-gap:0px}*{box-sizing:border-box}#splash-screen{display:none!important}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%;width:100%}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-p-0{padding:0}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-10{padding-top:10px;padding-bottom:10px}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:4px}.zcs-mt-8{margin-top:8px}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-xl{border-radius:12px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-22{font-size:22px}.zcs-font-24{font-size:24px}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-col-2{flex:0 0 16.666%;max-width:16.666%}.zcs-col-10{flex:0 0 83.333%;max-width:83.333%}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}a{text-decoration:none}\n.invoice-page{min-height:100vh;background:var(--zcs-page-bg-color);color:var(--zcs-primary-text-color);font:14px/1.45 Arial,sans-serif}.invoice-shell{max-width:1540px;margin:auto;padding:16px}.zcs-page-header{background:#fff;border:1px solid var(--zcs-border-color);border-radius:12px;padding:16px 20px}.zcs-back{width:34px;height:34px;border:1px solid var(--zcs-border-color);border-radius:7px;color:var(--zcs-teritiary-text-color);flex:none}.identity{min-width:0}.identity h1{font-size:20px;margin:0;overflow-wrap:anywhere}.identity p{margin:2px 0 0;color:var(--zcs-secondary-text-color);overflow-wrap:anywhere}.header-actions{flex-wrap:wrap}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-button-icon{width:16px}.zcs-badge{width:auto;white-space:nowrap;border:1px solid}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#137d59}.zcs-badge-yellow{background:#fcf4e6;border-color:#d28a10;color:#9a6208}.zcs-badge-grey{background:#f1f2f4;border-color:#77798b;color:#55576b}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#245fcf}.content{margin-top:14px}.finance-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.finance-card{padding:14px 16px;border:1px solid var(--zcs-border-color);border-radius:10px;background:#fff;min-width:0}.finance-card .metric-label,.kv label{display:block;font-size:12px;color:var(--zcs-teritiary-text-color);margin-bottom:4px}.finance-card strong{display:block;font-size:18px;line-height:1.25;overflow-wrap:anywhere}.finance-card .metric-detail{display:block;margin-top:4px;font-size:12px;color:var(--zcs-secondary-text-color);overflow-wrap:anywhere}.detail-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(360px,.85fr);gap:14px}.section-head{min-height:36px;margin-bottom:12px}.section-head h2{font-size:16px;margin:0}.section-note{font-size:12px;color:var(--zcs-teritiary-text-color)}.section-icon{width:32px;height:32px;border-radius:8px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);font-size:16px;flex:none}.zcs-labelvalue-wrapper ul{list-style:none}.kv{padding:8px 14px 8px 0;min-width:0;width:50%}.kv span{display:block;font-weight:500;overflow-wrap:anywhere}.scroll-section{height:300px;overflow:auto;padding-right:4px}.source-card{padding:12px;border:1px solid var(--zcs-border-color);border-radius:9px;background:#fff;color:var(--zcs-primary-text-color)}.source-card+.source-card{margin-top:8px}.source-card:hover{background:#f9fafe}.source-main{min-width:0}.source-main strong{display:block;overflow-wrap:anywhere}.source-state{margin-top:3px;font-size:12px}.source-state.ok{color:#137d59}.source-state.missing{color:#9a6208}.source-card i{color:var(--zcs_brand_color);font-size:18px}.evidence-row{padding:11px 12px;border:1px solid var(--zcs-border-color);border-radius:9px;color:var(--zcs-primary-text-color);background:#fff}.evidence-row i{font-size:19px;color:var(--zcs_brand_color)}.evidence-copy{min-width:0}.evidence-copy strong,.evidence-copy small{display:block;overflow-wrap:anywhere}.note{white-space:pre-wrap;overflow-wrap:anywhere}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:#fff;overflow:auto;max-height:360px}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:940px}.zcs-table-wrapper thead{top:0;z-index:1}.zcs-table-wrapper th{background:#f9fafe;box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color);vertical-align:top}.zcs-table-wrapper tbody tr:hover td{background:#f9fafe}.empty{min-height:120px;padding:22px;text-align:center;color:var(--zcs-secondary-text-color);background:#f9fafe;border:1px dashed var(--zcs-border-color);border-radius:9px}.empty i{display:block;margin-bottom:8px;color:var(--zcs_brand_color)}.audit-scroll{height:360px;overflow:auto;padding:4px 4px 4px 0}.zcs-tl-indicator{width:44px;left:16.666%}.zcs-tl-dot{width:11px;height:11px;background:var(--zcs_brand_color);border:1px solid #fff;box-shadow:0 2px 6px #c4dee4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:&apos;&apos;;position:absolute;width:1px;height:calc(100% + 20px);background:#e1e1e1;top:5px}.timeline-body{padding-left:50px}.link{color:var(--zcs_brand_color);font-weight:600}.not-found{min-height:70vh}.source-summary{padding:10px 12px;margin-bottom:10px;background:#f9fafe;border-radius:8px;color:var(--zcs-secondary-text-color);font-size:12px}\n@media(max-width:1000px){.finance-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.detail-grid{grid-template-columns:1fr}}\n@media(max-width:700px){.invoice-shell{padding:10px}.zcs-page-header{align-items:flex-start;flex-direction:column}.finance-grid{grid-template-columns:1fr}.kv{width:100%}.header-actions,.header-actions .zcs-button{width:100%}.scroll-section{height:280px}.zcs-tl-li{flex-direction:column}.zcs-tl-indicator{left:0}.zcs-tl-time{text-align:left;padding-left:46px;margin-bottom:6px}.timeline-body{padding-left:46px}.zcs-col-2,.zcs-col-10{max-width:100%;flex-basis:100%}}\n&lt;/style&gt;\n&lt;div class=&apos;invoice-page&apos;&gt;&lt;div class=&apos;invoice-shell&apos;&gt;\n&lt;%if(invoiceList.count() == 0){%&gt;\n&lt;div class=&apos;not-found zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;section class=&apos;zcs-card zcs-p-20 zcs-w-full&apos;&gt;&lt;div class=&apos;empty&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle-remove-10 zcs-font-24&apos;&gt;&lt;/i&gt;&lt;h2&gt;Supplier invoice not found&lt;/h2&gt;&lt;p&gt;The requested invoice is unavailable or outside your access.&lt;/p&gt;&lt;a class=&apos;link&apos; href=&apos;#Page:Supplier_Invoices&apos;&gt;Back to supplier invoices&lt;/a&gt;&lt;/div&gt;&lt;/section&gt;&lt;/div&gt;\n&lt;%}else{\ninvoice = invoiceList;\nproducts = Supplier_Invoice_Product[Parent_Supplier_Invoice == invoice.ID];\nhistory = Add_History[Supplier_Invoice_Lookup == invoice.ID] sort by Updated_Date_Time desc;\nstatusValue = ifnull(invoice.Status,&quot;Unknown&quot;); statusBadge = &quot;zcs-badge-grey&quot;; statusIcon = &quot;ui-2-help&quot;; if(statusValue == &quot;Paid&quot;){statusBadge=&quot;zcs-badge-green&quot;;statusIcon=&quot;ui-1-check-circle-08&quot;;}else if(statusValue == &quot;New&quot;){statusBadge=&quot;zcs-badge-yellow&quot;;statusIcon=&quot;ui-2-time&quot;;}\npoExists = false; soExists = false; poID = 0; soID = 0; poLabel = &quot;Not linked&quot;; soLabel = &quot;Not linked&quot;;\nif(invoice.Purchase_Order != null){poID=invoice.Purchase_Order.ID; relatedPO=Create_Purchase_Order[ID == poID]; if(relatedPO.count()&gt;0){poExists=true;poLabel=ifnull(relatedPO.Purchase_Order_ID,&quot;Purchase order&quot;);}}\nif(invoice.Sales_Order != null){soID=invoice.Sales_Order.ID; relatedSO=Create_Sales_Order[ID == soID]; if(relatedSO.count()&gt;0){soExists=true;soLabel=ifnull(relatedSO.Sales_Order_ID,&quot;Sales order&quot;);}}\nsupplierName = &quot;Not set&quot;; supplierID = &quot;Not set&quot;; supplierContact = &quot;Not set&quot;; supplierEmail = &quot;Not set&quot;;\nif(invoice.Supplier != null){supplierName=ifnull(invoice.Supplier.Supplier_Name,&quot;Not set&quot;);supplierID=ifnull(invoice.Supplier.Supplier_ID,&quot;Not set&quot;);supplierContact=ifnull(invoice.Supplier.Contact_Person,&quot;Not set&quot;);supplierEmail=ifnull(invoice.Supplier.Email,&quot;Not set&quot;);}\nsourceCount = 0; if(poExists){sourceCount=sourceCount+1;} if(soExists){sourceCount=sourceCount+1;}\n%&gt;\n&lt;header class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-box-border&apos;&gt;\n&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 identity&apos;&gt;&lt;a href=&apos;#Page:Supplier_Invoices&apos; class=&apos;zcs-back zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zcs-back-icon zcs-font-22 zc-li-outline arrows-1-tail-left&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;div class=&apos;identity&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;h1&gt;Invoice &lt;%=invoice.Supplier_Invoice_ID%&gt;&lt;/h1&gt;&lt;span class=&apos;zcs-badge zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=statusBadge%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=statusIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=statusValue%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;p&gt;&lt;%=ifnull(invoice.Supplier_Invoice_Number,&quot;Supplier invoice&quot;)%&gt; | &lt;%=supplierName%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;div class=&apos;header-actions zcs-flex zcs-gap-8&apos;&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Report:All_Histories?Supplier_Invoice_Lookup=&lt;%=invoice.ID%&gt;&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span&gt;Full history&lt;/span&gt;&lt;/a&gt;&lt;%if(statusValue == &quot;New&quot;){%&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Form:Add_Supplier_Invoice?recLinkID=&lt;%=invoice.ID%&gt;&amp;amp;viewLinkName=All_Supplier_Invoices&amp;amp;Action_Mode=Mark Paid&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;Mark paid&lt;/span&gt;&lt;/a&gt;&lt;%}%&gt;&lt;/div&gt;\n&lt;/header&gt;\n&lt;main class=&apos;content zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n&lt;section class=&apos;finance-grid&apos;&gt;&lt;div class=&apos;finance-card&apos;&gt;&lt;span class=&apos;metric-label&apos;&gt;Invoice total&lt;/span&gt;&lt;strong&gt;&lt;%=ifnull(invoice.Currency,&quot;&quot;)%&gt; &lt;%=ifnull(invoice.Invoice_Amount,0)%&gt;&lt;/strong&gt;&lt;span class=&apos;metric-detail&apos;&gt;Recorded invoice value&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;finance-card&apos;&gt;&lt;span class=&apos;metric-label&apos;&gt;Payment status&lt;/span&gt;&lt;strong&gt;&lt;%=statusValue%&gt;&lt;/strong&gt;&lt;span class=&apos;metric-detail&apos;&gt;Current finance state&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;finance-card&apos;&gt;&lt;span class=&apos;metric-label&apos;&gt;Paid date&lt;/span&gt;&lt;strong&gt;&lt;%=ifnull(invoice.Paid_Date,&quot;Not recorded&quot;)%&gt;&lt;/strong&gt;&lt;span class=&apos;metric-detail&apos;&gt;Settlement date&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;finance-card&apos;&gt;&lt;span class=&apos;metric-label&apos;&gt;Payment reference&lt;/span&gt;&lt;strong&gt;&lt;%=ifnull(invoice.Payment_Reference,&quot;Not recorded&quot;)%&gt;&lt;/strong&gt;&lt;span class=&apos;metric-detail&apos;&gt;Bank or remittance reference&lt;/span&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;div class=&apos;detail-grid&apos;&gt;\n&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;section-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Invoice identity&lt;/h2&gt;&lt;div class=&apos;section-note&apos;&gt;Commercial and supplier metadata&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;zcs-labelvalue-wrapper&apos;&gt;&lt;ul class=&apos;zcs-row zcs-p-0 zcs-m-0&apos;&gt;&lt;li class=&apos;kv&apos;&gt;&lt;label&gt;Invoice ID&lt;/label&gt;&lt;span&gt;&lt;%=invoice.Supplier_Invoice_ID%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;kv&apos;&gt;&lt;label&gt;Supplier invoice number&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(invoice.Supplier_Invoice_Number,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;kv&apos;&gt;&lt;label&gt;Invoice date&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(invoice.Invoice_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;kv&apos;&gt;&lt;label&gt;Currency&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(invoice.Currency,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;kv&apos;&gt;&lt;label&gt;Supplier&lt;/label&gt;&lt;span&gt;&lt;%=supplierName%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;kv&apos;&gt;&lt;label&gt;Supplier ID&lt;/label&gt;&lt;span&gt;&lt;%=supplierID%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;kv&apos;&gt;&lt;label&gt;Contact&lt;/label&gt;&lt;span&gt;&lt;%=supplierContact%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;kv&apos;&gt;&lt;label&gt;Email&lt;/label&gt;&lt;span&gt;&lt;%=supplierEmail%&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;section-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Source verification&lt;/h2&gt;&lt;div class=&apos;section-note&apos;&gt;Resolvable purchasing and sales records&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-badge-blue&apos;&gt;&lt;%=sourceCount%&gt; of 2&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;scroll-section&apos;&gt;&lt;div class=&apos;source-summary&apos;&gt;&lt;%=sourceCount%&gt; source documents verified. Missing references remain visible but are not routed.&lt;/div&gt;&lt;%if(poExists){%&gt;&lt;a class=&apos;source-card zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=poID%&gt;&apos;&gt;&lt;span class=&apos;source-main&apos;&gt;&lt;strong&gt;&lt;%=poLabel%&gt;&lt;/strong&gt;&lt;span class=&apos;source-state ok zcs-flex zcs-align-items-center zcs-gap-6&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;Purchase order verified&lt;/span&gt;&lt;/span&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;%}else{%&gt;&lt;div class=&apos;source-card zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;source-main&apos;&gt;&lt;strong&gt;Purchase order&lt;/strong&gt;&lt;span class=&apos;source-state missing zcs-flex zcs-align-items-center zcs-gap-6&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;Missing or unavailable&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;%}%&gt;&lt;%if(soExists){%&gt;&lt;a class=&apos;source-card zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=soID%&gt;&apos;&gt;&lt;span class=&apos;source-main&apos;&gt;&lt;strong&gt;&lt;%=soLabel%&gt;&lt;/strong&gt;&lt;span class=&apos;source-state ok zcs-flex zcs-align-items-center zcs-gap-6&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;Sales order verified&lt;/span&gt;&lt;/span&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;%}else{%&gt;&lt;div class=&apos;source-card zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;span class=&apos;source-main&apos;&gt;&lt;strong&gt;Sales order&lt;/strong&gt;&lt;span class=&apos;source-state missing zcs-flex zcs-align-items-center zcs-gap-6&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;Missing or unavailable&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;/div&gt;\n&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;section-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Product lines&lt;/h2&gt;&lt;div class=&apos;section-note&apos;&gt;Quantities and commercial values&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-badge-grey&apos;&gt;&lt;%=products.count()%&gt; lines&lt;/span&gt;&lt;/div&gt;&lt;%if(products.count()==0){%&gt;&lt;div class=&apos;empty&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple zcs-font-24&apos;&gt;&lt;/i&gt;&lt;strong&gt;No invoice products&lt;/strong&gt;&lt;div&gt;No product lines are recorded for this invoice.&lt;/div&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;zcs-table-wrapper zcs-rounded-md&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Product&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Part / model&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Configuration&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Quantity&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Unit price&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Line total&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Remarks&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%for each item in products{%&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10&apos;&gt;&lt;strong&gt;&lt;%=item.Product_Name%&gt;&lt;/strong&gt;&lt;small class=&apos;zcs-flex zcs-color-tertiary&apos;&gt;&lt;%=item.Product_ID%&gt; | &lt;%=ifnull(item.Brand_Make,&quot;Not set&quot;)%&gt;&lt;/small&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10&apos;&gt;&lt;%=ifnull(item.Manufacturer_Part_Number,&quot;Not set&quot;)%&gt;&lt;small class=&apos;zcs-flex zcs-color-tertiary&apos;&gt;&lt;%=ifnull(item.Model,&quot;Not set&quot;)%&gt;&lt;/small&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10&apos;&gt;&lt;%=ifnull(item.Configuration,&quot;Not set&quot;)%&gt;&lt;small class=&apos;zcs-flex zcs-color-tertiary&apos;&gt;&lt;%=ifnull(item.Unit_of_Measure,&quot;Not set&quot;)%&gt;&lt;/small&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-text-right&apos;&gt;&lt;%=ifnull(item.Quantity,0)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-text-right&apos;&gt;&lt;%=ifnull(item.Currency,invoice.Currency)%&gt; &lt;%=ifnull(item.Unit_Price,0)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-text-right zcs-font-semibold&apos;&gt;&lt;%=ifnull(item.Currency,invoice.Currency)%&gt; &lt;%=ifnull(item.Total_Price,0)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10&apos;&gt;&lt;%=ifnull(item.Remarks,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/section&gt;\n&lt;div class=&apos;detail-grid&apos;&gt;&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;section-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-currency-dollar&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Payment evidence&lt;/h2&gt;&lt;div class=&apos;section-note&apos;&gt;Settlement data captured on the invoice&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;zcs-labelvalue-wrapper&apos;&gt;&lt;ul class=&apos;zcs-row zcs-p-0 zcs-m-0&apos;&gt;&lt;li class=&apos;kv&apos;&gt;&lt;label&gt;Status&lt;/label&gt;&lt;span&gt;&lt;%=statusValue%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;kv&apos;&gt;&lt;label&gt;Amount&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(invoice.Currency,&quot;&quot;)%&gt; &lt;%=ifnull(invoice.Invoice_Amount,0)%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;kv&apos;&gt;&lt;label&gt;Paid date&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(invoice.Paid_Date,&quot;Not recorded&quot;)%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;kv&apos;&gt;&lt;label&gt;Reference&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(invoice.Payment_Reference,&quot;Not recorded&quot;)%&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;kv zcs-w-full&apos; style=&apos;width:100%&apos;&gt;&lt;label&gt;Remarks&lt;/label&gt;&lt;span class=&apos;note&apos;&gt;&lt;%=ifnull(invoice.Payment_Remarks,&quot;Not recorded&quot;)%&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/section&gt;&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;section-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Document evidence&lt;/h2&gt;&lt;div class=&apos;section-note&apos;&gt;Supplier invoice attachment&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;%if(invoice.Invoice_Attachment == null || invoice.Invoice_Attachment == &quot;&quot;){%&gt;&lt;div class=&apos;empty&apos;&gt;&lt;i class=&apos;zc-li-outline files-single zcs-font-24&apos;&gt;&lt;/i&gt;&lt;strong&gt;No attachment&lt;/strong&gt;&lt;div&gt;No supplier document is recorded.&lt;/div&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;a class=&apos;evidence-row zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos; href=&apos;&lt;%=invoice.Invoice_Attachment%&gt;&apos; target=&apos;_blank&apos;&gt;&lt;span class=&apos;evidence-copy zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;strong&gt;Supplier invoice document&lt;/strong&gt;&lt;small class=&apos;zcs-color-tertiary&apos;&gt;Open recorded evidence&lt;/small&gt;&lt;/span&gt;&lt;/span&gt;&lt;i class=&apos;zc-li-outline arrows-2-square-download&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;%}%&gt;&lt;/section&gt;&lt;/div&gt;\n&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;section-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Audit activity&lt;/h2&gt;&lt;div class=&apos;section-note&apos;&gt;Newest event first&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&apos;link&apos; href=&apos;#Report:All_Histories?Supplier_Invoice_Lookup=&lt;%=invoice.ID%&gt;&apos;&gt;View full history&lt;/a&gt;&lt;/div&gt;&lt;%if(history.count()==0){%&gt;&lt;div class=&apos;empty&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time zcs-font-24&apos;&gt;&lt;/i&gt;&lt;strong&gt;No audit activity&lt;/strong&gt;&lt;div&gt;No history events are recorded for this invoice.&lt;/div&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;zcs-timeline-wrapper audit-scroll&apos;&gt;&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0&apos;&gt;&lt;%for each event in history{%&gt;&lt;li class=&apos;zcs-tl-li zcs-row zcs-relative&apos;&gt;&lt;div class=&apos;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&apos;&gt;&lt;span class=&apos;zcs-tl-dot zcs-rounded-xl zcs-mt-8 zcs-relative&apos;&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&apos;zcs-col-2 zcs-tl-time zcs-font-13 zcs-color-tertiary zcs-text-right&apos;&gt;&lt;%=event.Updated_Date_Time%&gt;&lt;/span&gt;&lt;div class=&apos;timeline-body zcs-flex zcs-direction-column zcs-col-10&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;strong class=&apos;zcs-font-15&apos;&gt;&lt;%=event.Action_Type%&gt;&lt;/strong&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;%=ifnull(event.Updated_By.Employee_Name,ifnull(event.Updated_By_Email,&quot;System&quot;))%&gt;&lt;/span&gt;&lt;/div&gt;&lt;%if(event.Previous_Status != null || event.New_Status != null){%&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;&lt;%=ifnull(event.Previous_Status,&quot;Not set&quot;)%&gt; to &lt;%=ifnull(event.New_Status,ifnull(event.Status,&quot;Not set&quot;))%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;p class=&apos;note zcs-m-0 zcs-mt-4&apos;&gt;&lt;%=ifnull(event.Comments,ifnull(event.Subform_Details_Change_Summary,&quot;No additional details&quot;))%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;&lt;%}%&gt;&lt;/ul&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/section&gt;\n&lt;/main&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Supplier_Invoices
		{
					displayname = "Supplier Invoices"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Supplier_Invoices_List' elementName='Supplier_Invoices_List'>\n\t\t\t\t\t<![CDATA[htmlpage Supplier_Invoices_List()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\ninvoices = Add_Supplier_Invoice[ID != 0] sort by Invoice_Date desc;\nnewCount = Add_Supplier_Invoice[Status == &quot;New&quot;].count();\npaidCount = Add_Supplier_Invoice[Status == &quot;Paid&quot;].count();\nreviewCount = invoices.count() - newCount - paidCount;\n%&gt;\n&lt;style&gt;\n/* ZCS global utilities used on this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#f3f3f4;--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color)}*{box-sizing:border-box}a{text-decoration:none}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-px-6{padding-left:6px;padding-right:6px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-10{padding-top:10px;padding-bottom:10px}.zcs-py-12{padding-top:12px;padding-bottom:12px}.zcs-p-20{padding:20px}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:10px}.zcs-mt-12{margin-top:12px}.zcs-mb-0{margin-bottom:0}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-rounded-sm{border-radius:4px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-18{font-size:18px}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-tertiary{color:var(--zcs-secondary-text-color)}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-sticky{position:sticky}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}\n#splash-screen{display:none!important}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%;width:100%}.zc-container-wrapper .zc-main-content .inner,.zc-page-content-wrapper,.zc-pb-page-content-wrapper,.zc-pb-tile-container,.zc-pb-tile-card{width:100%!important;max-width:none!important}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}\n/* horizontal-tab-horizontal-tab-with-count */.zcs-horizontal-tabhead{box-shadow:0 -1px 0 var(--zcs-border-color) inset;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;list-style:none}.zcs-horizontal-tabhead::-webkit-scrollbar{display:none}.zcs-horizontal-tabitem{list-style:none;border-bottom:2px solid transparent;white-space:nowrap}.zcs-horizontal-tablink{cursor:pointer;color:var(--zcs-secondary-text-color)}.zcs-horizontal-tabcount{min-width:20px;background:var(--zcs-page-bg-color)}\n/* table-simple-table */.zcs-table-wrapper{height:470px;border:1px solid var(--zcs-border-color);background:var(--zcs-white-color);overflow:auto;border-radius:0 0 10px 10px}.zcs-table-wrapper table{min-width:1180px;line-height:normal;border-collapse:collapse}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:#f9fafe;box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color);vertical-align:top}.zcs-table-wrapper tbody tr:hover td{background:#f9fafe}\n/* badge-badge-with-icon */.zcs-badge{width:auto;white-space:nowrap;border:1px solid}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#117c56}.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#8a5d00}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#245dcf}.zcs-badge-orange{background:#f8f0eb;border-color:#f4660c;color:#b84908}.zcs-badge-grey{background:#e8e8e8;border-color:#777;color:#424242}\n.invoice-page{min-height:620px;background:var(--zcs-page-bg-color);padding:14px;font:14px/1.45 Arial,sans-serif;color:var(--zcs-primary-text-color)}.register-header{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 16px}.title-wrap{display:flex;align-items:center;gap:10px}.title-icon{display:inline-flex;width:36px;height:36px;align-items:center;justify-content:center;border-radius:8px;background:var(--zcs_component_hover_color);color:var(--zcs-theme-brand-color);font-size:19px}.page-title{font-size:20px;line-height:1.2;font-weight:600;margin:0}.page-subtitle{margin:3px 0 0;color:var(--zcs-secondary-text-color);font-size:13px}.summary-strip{display:flex;gap:8px;flex-wrap:wrap}.summary-item{min-width:92px;padding:7px 10px;border-left:3px solid var(--zcs-border-color);background:#fff}.summary-item.awaiting{border-left-color:#faae13}.summary-item.paid{border-left-color:#179e6c}.summary-value{display:block;font-size:17px;font-weight:600;line-height:1.1}.summary-label{color:var(--zcs-secondary-text-color);font-size:11px}.register-shell{margin-top:10px;overflow:hidden}.tab-input{position:absolute;opacity:0;pointer-events:none}.tab-input:nth-of-type(1):checked~.register-shell .tab-all,.tab-input:nth-of-type(2):checked~.register-shell .tab-new,.tab-input:nth-of-type(3):checked~.register-shell .tab-paid,.tab-input:nth-of-type(4):checked~.register-shell .tab-review{border-bottom-color:var(--zcs-theme-brand-color)}.tab-input:nth-of-type(1):checked~.register-shell .tab-all label,.tab-input:nth-of-type(2):checked~.register-shell .tab-new label,.tab-input:nth-of-type(3):checked~.register-shell .tab-paid label,.tab-input:nth-of-type(4):checked~.register-shell .tab-review label{color:var(--zcs-theme-brand-color)}.invoice-row,.filter-empty{display:none}.tab-input:nth-of-type(1):checked~.register-shell .invoice-row{display:table-row}.tab-input:nth-of-type(2):checked~.register-shell .status-new,.tab-input:nth-of-type(3):checked~.register-shell .status-paid,.tab-input:nth-of-type(4):checked~.register-shell .status-review{display:table-row}.tab-input:nth-of-type(1):checked~.register-shell .empty-all,.tab-input:nth-of-type(2):checked~.register-shell .empty-new,.tab-input:nth-of-type(3):checked~.register-shell .empty-paid,.tab-input:nth-of-type(4):checked~.register-shell .empty-review{display:flex}.primary-link{font-size:14px;font-weight:600;color:var(--zcs-theme-brand-color)}.subtle{display:block;margin-top:3px;color:var(--zcs-secondary-text-color);font-size:12px;overflow-wrap:anywhere}.supplier-name{display:block;font-weight:600}.amount{display:block;font-size:15px;font-weight:600;text-align:right;white-space:nowrap}.order-stack{display:grid;gap:3px}.order-line{display:flex;gap:6px}.order-key{width:22px;color:var(--zcs-secondary-text-color);font-size:11px;font-weight:600}.badge-stack{display:grid;justify-items:start;gap:5px}.evidence{display:grid;gap:2px}.actions{display:flex;align-items:center;gap:6px;justify-content:flex-end;white-space:nowrap}.invoice-action{display:inline-flex;align-items:center;gap:5px;padding:6px 8px;border-radius:5px;color:var(--zcs-theme-brand-color);font-size:12px;font-weight:500}.invoice-action:hover{background:var(--zcs_component_hover_color)}.invoice-action.primary{background:var(--zcs-theme-brand-color);color:var(--zcs_brand_foreground_color)}.zcs-nodata-wrapper{min-height:300px;align-items:center;justify-content:center;text-align:center;background:#fff}.empty-icon{display:inline-flex;width:46px;height:46px;align-items:center;justify-content:center;border-radius:10px;background:#e8efff;color:#2a6ffc;font-size:23px}.zcs-nodata-header{margin:10px 0 0}.zcs-nodata-desc{margin:6px 0 0;color:var(--zcs-secondary-text-color)}.mobile-label{display:none}\n@media(max-width:760px){.invoice-page{padding:10px}.register-header{align-items:flex-start;flex-direction:column}.summary-strip{width:100%}.summary-item{flex:1}.zcs-horizontal-tabhead{gap:2px}.zcs-horizontal-tablink{padding-left:8px;padding-right:8px}.zcs-table-wrapper{height:auto;border:0;background:transparent;overflow:visible;padding:10px}.zcs-table-wrapper table,.zcs-table-wrapper thead,.zcs-table-wrapper tbody{display:block;min-width:0;width:100%}.zcs-table-wrapper thead{display:none}.zcs-table-wrapper tbody{display:grid;gap:10px}.tab-input:nth-of-type(1):checked~.register-shell .invoice-row,.tab-input:nth-of-type(2):checked~.register-shell .status-new,.tab-input:nth-of-type(3):checked~.register-shell .status-paid,.tab-input:nth-of-type(4):checked~.register-shell .status-review{display:grid}.invoice-row{grid-template-columns:1fr 1fr;background:#fff;border:1px solid var(--zcs-border-color);border-radius:10px;padding:14px;gap:12px}.zcs-table-wrapper td{display:block!important;border:0!important;padding:0!important}.zcs-table-wrapper td:nth-child(1),.zcs-table-wrapper td:nth-child(2){grid-column:span 1}.zcs-table-wrapper td:nth-child(3),.zcs-table-wrapper td:nth-child(4),.zcs-table-wrapper td:nth-child(5),.zcs-table-wrapper td:nth-child(6){grid-column:1/-1;padding-top:10px!important;border-top:1px solid var(--zcs-border-color)!important}.mobile-label{display:block;margin-bottom:4px;color:var(--zcs-secondary-text-color);font-size:11px;text-transform:uppercase}.amount{text-align:left}.actions{justify-content:flex-start;flex-wrap:wrap}.zcs-nodata-wrapper{min-height:260px}}\n@media(max-width:430px){.invoice-row{grid-template-columns:1fr}.zcs-table-wrapper td{grid-column:1!important}.summary-item{min-width:calc(50% - 4px)}}\n&lt;/style&gt;\n&lt;div class=&apos;invoice-page&apos;&gt;\n&lt;header class=&apos;register-header zcs-card&apos;&gt;&lt;div class=&apos;title-wrap&apos;&gt;&lt;span class=&apos;title-icon&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-content-03&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h1 class=&apos;page-title&apos;&gt;Supplier invoice register&lt;/h1&gt;&lt;p class=&apos;page-subtitle&apos;&gt;Finance status, order linkage and payment evidence&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;summary-strip&apos;&gt;&lt;div class=&apos;summary-item&apos;&gt;&lt;span class=&apos;summary-value&apos;&gt;&lt;%=invoices.count()%&gt;&lt;/span&gt;&lt;span class=&apos;summary-label&apos;&gt;Total invoices&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;summary-item awaiting&apos;&gt;&lt;span class=&apos;summary-value&apos;&gt;&lt;%=newCount%&gt;&lt;/span&gt;&lt;span class=&apos;summary-label&apos;&gt;Awaiting payment&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;summary-item paid&apos;&gt;&lt;span class=&apos;summary-value&apos;&gt;&lt;%=paidCount%&gt;&lt;/span&gt;&lt;span class=&apos;summary-label&apos;&gt;Paid&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;summary-item&apos;&gt;&lt;span class=&apos;summary-value&apos;&gt;&lt;%=reviewCount%&gt;&lt;/span&gt;&lt;span class=&apos;summary-label&apos;&gt;Needs review&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/header&gt;\n&lt;input class=&apos;tab-input&apos; type=&apos;radio&apos; name=&apos;invoice-status&apos; id=&apos;invoice-all&apos; checked&gt;&lt;input class=&apos;tab-input&apos; type=&apos;radio&apos; name=&apos;invoice-status&apos; id=&apos;invoice-new&apos;&gt;&lt;input class=&apos;tab-input&apos; type=&apos;radio&apos; name=&apos;invoice-status&apos; id=&apos;invoice-paid&apos;&gt;&lt;input class=&apos;tab-input&apos; type=&apos;radio&apos; name=&apos;invoice-status&apos; id=&apos;invoice-review&apos;&gt;\n&lt;section class=&apos;register-shell zcs-card&apos;&gt;&lt;ul class=&apos;zcs-horizontal-tabhead zcs-flex zcs-gap-8 zcs-px-10 zcs-m-0&apos;&gt;&lt;li class=&apos;zcs-horizontal-tabitem tab-all&apos;&gt;&lt;label class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium&apos; for=&apos;invoice-all&apos;&gt;All &lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12 zcs-text-center&apos;&gt;&lt;%=invoices.count()%&gt;&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;&lt;li class=&apos;zcs-horizontal-tabitem tab-new&apos;&gt;&lt;label class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium&apos; for=&apos;invoice-new&apos;&gt;Awaiting &lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12 zcs-text-center&apos;&gt;&lt;%=newCount%&gt;&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;&lt;li class=&apos;zcs-horizontal-tabitem tab-paid&apos;&gt;&lt;label class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium&apos; for=&apos;invoice-paid&apos;&gt;Paid &lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12 zcs-text-center&apos;&gt;&lt;%=paidCount%&gt;&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;&lt;li class=&apos;zcs-horizontal-tabitem tab-review&apos;&gt;&lt;label class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium&apos; for=&apos;invoice-review&apos;&gt;Review &lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12 zcs-text-center&apos;&gt;&lt;%=reviewCount%&gt;&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;&lt;/ul&gt;\n&lt;%if(invoices.count() == 0){%&gt;&lt;div class=&apos;filter-empty empty-all zcs-nodata-wrapper&apos;&gt;&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;span class=&apos;empty-icon&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-content-03&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium&apos;&gt;No supplier invoices&lt;/h5&gt;&lt;p class=&apos;zcs-nodata-desc&apos;&gt;Invoices will appear here once they are recorded.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}%&gt;\n&lt;%if(newCount == 0){%&gt;&lt;div class=&apos;filter-empty empty-new zcs-nodata-wrapper&apos;&gt;&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;span class=&apos;empty-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium&apos;&gt;Nothing awaiting payment&lt;/h5&gt;&lt;p class=&apos;zcs-nodata-desc&apos;&gt;No invoices are currently marked New.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}%&gt;\n&lt;%if(paidCount == 0){%&gt;&lt;div class=&apos;filter-empty empty-paid zcs-nodata-wrapper&apos;&gt;&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;span class=&apos;empty-icon&apos;&gt;&lt;i class=&apos;zc-li-outline loader-dots-06&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium&apos;&gt;No paid invoices&lt;/h5&gt;&lt;p class=&apos;zcs-nodata-desc&apos;&gt;Paid records appear after payment evidence is captured.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}%&gt;\n&lt;%if(reviewCount == 0){%&gt;&lt;div class=&apos;filter-empty empty-review zcs-nodata-wrapper&apos;&gt;&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;span class=&apos;empty-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium&apos;&gt;No statuses need review&lt;/h5&gt;&lt;p class=&apos;zcs-nodata-desc&apos;&gt;Every invoice has a recognized finance status.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}%&gt;\n&lt;%if(invoices.count() &gt; 0){%&gt;&lt;div class=&apos;zcs-table-wrapper zcs-box-border&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-10 zcs-text-left zcs-font-13 zcs-font-medium&apos;&gt;Invoice&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-10 zcs-text-left zcs-font-13 zcs-font-medium&apos;&gt;Supplier&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-10 zcs-text-left zcs-font-13 zcs-font-medium&apos;&gt;Order linkage&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-10 zcs-text-right zcs-font-13 zcs-font-medium&apos;&gt;Amount&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-10 zcs-text-left zcs-font-13 zcs-font-medium&apos;&gt;Finance and evidence&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-10 zcs-text-right zcs-font-13 zcs-font-medium&apos;&gt;Actions&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%for each invoice in invoices { statusValue=ifnull(invoice.Status,&quot;&quot;);statusClass=&quot;status-review&quot;;paymentBadge=&quot;zcs-badge-grey&quot;;paymentIcon=&quot;ui-2-time&quot;;paymentLabel=&quot;Status not set&quot;;if(statusValue == &quot;New&quot;){statusClass=&quot;status-new&quot;;paymentBadge=&quot;zcs-badge-yellow&quot;;paymentIcon=&quot;loader-dots-06&quot;;paymentLabel=&quot;Awaiting payment&quot;;}else if(statusValue == &quot;Paid&quot;){statusClass=&quot;status-paid&quot;;paymentBadge=&quot;zcs-badge-green&quot;;paymentIcon=&quot;ui-1-check-circle-08&quot;;paymentLabel=&quot;Paid&quot;;}else if(statusValue != &quot;&quot;){paymentLabel=&quot;Review: &quot; + statusValue;}supplierLabel=&quot;Not set&quot;;if(invoice.Supplier != null){supplierLabel=ifnull(invoice.Supplier.Supplier_Name,&quot;Not set&quot;);}poLabel=&quot;Not linked&quot;;soLabel=&quot;Not linked&quot;;linksMatch=false;if(invoice.Purchase_Order != null){poLabel=ifnull(invoice.Purchase_Order.Purchase_Order_ID,&quot;Linked PO&quot;);}if(invoice.Sales_Order != null){soLabel=ifnull(invoice.Sales_Order.Sales_Order_ID,&quot;Linked SO&quot;);}if(invoice.Purchase_Order != null &amp;&amp; invoice.Sales_Order != null &amp;&amp; invoice.Purchase_Order.Sales_Order == invoice.Sales_Order){linksMatch=true;}verifyBadge=&quot;zcs-badge-orange&quot;;verifyIcon=&quot;ui-2-time&quot;;verifyLabel=&quot;Linkage needs review&quot;;if(linksMatch){verifyBadge=&quot;zcs-badge-blue&quot;;verifyIcon=&quot;ui-1-check-circle-08&quot;;verifyLabel=&quot;PO and SO verified&quot;;}currencyLabel=ifnull(invoice.Currency,&quot;Currency not set&quot;);evidenceBadge=&quot;zcs-badge-orange&quot;;evidenceIcon=&quot;ui-2-time&quot;;evidenceLabel=&quot;Evidence incomplete&quot;;if(invoice.Paid_Date != null &amp;&amp; ifnull(invoice.Payment_Reference,&quot;&quot;) != &quot;&quot;){evidenceBadge=&quot;zcs-badge-blue&quot;;evidenceIcon=&quot;ui-1-check-circle-08&quot;;evidenceLabel=&quot;Evidence recorded&quot;;}%&gt;\n&lt;tr class=&apos;invoice-row &lt;%=statusClass%&gt;&apos;&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10&apos;&gt;&lt;span class=&apos;mobile-label&apos;&gt;Invoice&lt;/span&gt;&lt;a class=&apos;primary-link&apos; href=&apos;#Page:Supplier_Invoice_Detail?Supplier_Invoice_ID=&lt;%=invoice.ID%&gt;&apos;&gt;Invoice &lt;%=invoice.Supplier_Invoice_ID%&gt;&lt;/a&gt;&lt;span class=&apos;subtle&apos;&gt;Supplier no. &lt;%=ifnull(invoice.Supplier_Invoice_Number,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;span class=&apos;subtle&apos;&gt;Dated &lt;%=ifnull(invoice.Invoice_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10&apos;&gt;&lt;span class=&apos;mobile-label&apos;&gt;Supplier&lt;/span&gt;&lt;span class=&apos;supplier-name&apos;&gt;&lt;%=supplierLabel%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10&apos;&gt;&lt;span class=&apos;mobile-label&apos;&gt;Order linkage&lt;/span&gt;&lt;div class=&apos;order-stack&apos;&gt;&lt;span class=&apos;order-line&apos;&gt;&lt;span class=&apos;order-key&apos;&gt;PO&lt;/span&gt;&lt;%=poLabel%&gt;&lt;/span&gt;&lt;span class=&apos;order-line&apos;&gt;&lt;span class=&apos;order-key&apos;&gt;SO&lt;/span&gt;&lt;%=soLabel%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12 &lt;%=verifyBadge%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=verifyIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;%=verifyLabel%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10&apos;&gt;&lt;span class=&apos;mobile-label&apos;&gt;Amount&lt;/span&gt;&lt;span class=&apos;amount&apos;&gt;&lt;%=currencyLabel%&gt; &lt;%=ifnull(invoice.Invoice_Amount,0)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10&apos;&gt;&lt;span class=&apos;mobile-label&apos;&gt;Finance and evidence&lt;/span&gt;&lt;div class=&apos;badge-stack&apos;&gt;&lt;span class=&apos;zcs-badge zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12 &lt;%=paymentBadge%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=paymentIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;%=paymentLabel%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12 &lt;%=evidenceBadge%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=evidenceIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;%=evidenceLabel%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;evidence&apos;&gt;&lt;span class=&apos;subtle&apos;&gt;Paid date: &lt;%=ifnull(invoice.Paid_Date,&quot;Not recorded&quot;)%&gt;&lt;/span&gt;&lt;span class=&apos;subtle&apos;&gt;Reference: &lt;%=ifnull(invoice.Payment_Reference,&quot;Not recorded&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10&apos;&gt;&lt;span class=&apos;mobile-label&apos;&gt;Actions&lt;/span&gt;&lt;div class=&apos;actions&apos;&gt;&lt;a class=&apos;invoice-action&apos; href=&apos;#Page:Supplier_Invoice_Detail?Supplier_Invoice_ID=&lt;%=invoice.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-eye-17&apos;&gt;&lt;/i&gt;Detail&lt;/a&gt;&lt;%if(statusValue == &quot;New&quot;){%&gt;&lt;a class=&apos;invoice-action primary&apos; href=&apos;#Form:Add_Supplier_Invoice?recLinkID=&lt;%=invoice.ID%&gt;&amp;amp;viewLinkName=All_Supplier_Invoices&amp;amp;Action_Mode=Mark Paid&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;Mark paid&lt;/a&gt;&lt;%}%&gt;&lt;a class=&apos;invoice-action&apos; href=&apos;#Report:All_Histories?Supplier_Invoice_Lookup=&lt;%=invoice.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;History&lt;/a&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%}%&gt;\n&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/section&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Supplier_Quotes
		{
					displayname = "Supplier Quotes"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Supplier_Quotes_List' elementName='Supplier_Quotes_List'>\n\t\t\t\t\t<![CDATA[htmlpage Supplier_Quotes_List()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nquotes = Add_Supplier_Quote[ID != 0] sort by Quote_Date descending;\nallCount = quotes.count();\nreceivedCount = Add_Supplier_Quote[Status == &quot;Received&quot;].count();\nselectedCount = Add_Supplier_Quote[Status == &quot;Selected&quot;].count();\nrejectedCount = Add_Supplier_Quote[Status == &quot;Rejected&quot;].count();\n%&gt;\n&lt;style&gt;\n/* ZCS utilities used by this page (zcs-global) */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#f5f6f8;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-p-20{padding:1.25rem}.zcs-px-8{padding-left:.5rem;padding-right:.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:.625rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-22{font-size:1.375rem}.zcs-font-medium{font-weight:500}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-sticky{position:sticky}.zcs-relative{position:relative}.zcs-card{background:var(--zcs-white-color);border:1px solid #e5e7ec;border-radius:10px}a{text-decoration:none}\n/* ZCS components: header-heading-with-actions, table-simple-table, badge-filled-outlined-badge, card-template-default, no-data-no-data-text-only, small-things-icon-with-text */\n.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%;width:100%}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-container,.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{border-radius:0!important;width:100%!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important}#splash-screen{display:none!important}\n.quotes-page{width:100%;min-height:100%;padding:14px;background:var(--zcs-page-bg-color);color:var(--zcs-primary-text-color);font:14px/1.45 Arial,sans-serif}.quotes-shell{overflow:hidden}.zcs-page-header{padding:17px 20px;background:#fff;border-bottom:1px solid var(--zcs-border-color)}.title-icon{width:36px;height:36px;border-radius:8px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);font-size:18px;flex:0 0 auto}.header-copy h1{font-size:20px;font-weight:600}.header-copy p{margin:2px 0 0;color:var(--zcs-secondary-text-color);font-size:13px}.register-strip{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:10px 14px;background:#fff;border-bottom:1px solid var(--zcs-border-color);flex-wrap:wrap}.summary{display:flex;align-items:center;gap:6px;flex-wrap:wrap}.summary-item{display:inline-flex;align-items:center;gap:6px;padding:5px 9px;background:#f7f8fb;border:1px solid var(--zcs-border-color);border-radius:6px}.summary-value{font-weight:700;color:var(--zcs-primary-text-color)}.summary-label{font-size:12px;color:var(--zcs-secondary-text-color)}.strip-note{color:var(--zcs-secondary-text-color);font-size:12px}.strip-note i{margin-right:5px;color:var(--zcs-theme-brand-color)}.quotes-body{height:540px;max-height:calc(100vh - 190px);min-height:340px;padding:12px}.zcs-table-wrapper{height:100%;border:1px solid var(--zcs-border-color);background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;line-height:normal;min-width:1050px}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:#f7f8fb;box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap;color:var(--zcs-secondary-text-color);font-size:11px;text-transform:uppercase;letter-spacing:.04em}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color);vertical-align:middle}.zcs-table-wrapper tbody tr:hover td{background:#fafbfc}.primary{font-weight:600;color:var(--zcs-primary-text-color)}.quote-key{color:var(--zcs-theme-brand-color)}.muted{color:var(--zcs-secondary-text-color);font-size:12px;margin-top:2px}.money{font-size:16px;font-weight:700;white-space:nowrap;color:var(--zcs-primary-text-color)}.coverage{display:flex;flex-wrap:wrap;gap:3px;margin-top:4px}.mini{padding:2px 5px;border-radius:4px;background:#f1f2f6;color:var(--zcs-secondary-text-color);font-size:10px}.zcs-badge{width:auto;white-space:nowrap;border:1px solid}.zcs-badge-green{background:#eaf8f2;border-color:#70c4a4;color:#117653}.zcs-badge-red{background:#fceff1;border-color:#e7a6b0;color:#a83043}.zcs-badge-blue{background:#edf3ff;border-color:#a9c2f2;color:#285da8}.zcs-badge-yellow{background:#fff7e8;border-color:#e8c783;color:#8b6518}.ready,.waiting{display:flex;align-items:center;gap:5px;font-weight:600}.ready{color:#117653}.waiting{color:#8b6518}.actions{display:flex;gap:5px}.icon-link{width:30px;height:30px;border:1px solid var(--zcs-border-color);border-radius:6px;color:var(--zcs-secondary-text-color);background:#fff}.icon-link:hover{border-color:var(--zcs-theme-brand-color);color:var(--zcs-theme-brand-color);background:var(--zcs-light-bg-color)}.empty{min-height:300px;text-align:center}.empty i{font-size:28px;color:var(--zcs-theme-brand-color)}\n@media(max-width:760px){.quotes-page{padding:8px}.zcs-page-header{padding:14px}.header-copy p{font-size:12px}.register-strip{padding:9px 10px}.strip-note{width:100%}.quotes-body{height:auto;max-height:none;min-height:0;padding:9px}.zcs-table-wrapper{height:auto;border:0;background:transparent;overflow:visible}.zcs-table-wrapper table,.zcs-table-wrapper tbody{display:block;min-width:0}.zcs-table-wrapper thead{display:none}.zcs-table-wrapper tr{display:grid;grid-template-columns:1fr 1fr;margin-bottom:10px;background:#fff;border:1px solid var(--zcs-border-color);border-radius:9px;overflow:hidden}.zcs-table-wrapper td{display:block;padding:9px 11px;border-top:1px solid var(--zcs-border-color);min-width:0}.zcs-table-wrapper td:before{content:attr(data-label);display:block;margin-bottom:3px;color:var(--zcs-secondary-text-color);font-size:9px;font-weight:600;text-transform:uppercase;letter-spacing:.05em}.zcs-table-wrapper td:first-child{grid-column:1/-1;border-top:0}.zcs-table-wrapper td:nth-child(2){grid-column:1/-1}.zcs-table-wrapper td:last-child{grid-column:1/-1}.actions{justify-content:flex-end}}@media(max-width:480px){.summary-item{padding:4px 7px}.zcs-table-wrapper tr{grid-template-columns:1fr}.zcs-table-wrapper td,.zcs-table-wrapper td:first-child,.zcs-table-wrapper td:nth-child(2),.zcs-table-wrapper td:last-child{grid-column:auto}.actions{justify-content:flex-start}}\n&lt;/style&gt;\n&lt;div class=&apos;quotes-page zcs-box-border&apos;&gt;\n\t&lt;section class=&apos;quotes-shell zcs-card&apos;&gt;\n\t\t&lt;header class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;&lt;div class=&apos;title-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;header-copy&apos;&gt;&lt;h1 class=&apos;zcs-m-0&apos;&gt;Supplier quote register&lt;/h1&gt;&lt;p&gt;Compare supplier response, quoted value, coverage, and selection status.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/header&gt;\n\t\t&lt;div class=&apos;register-strip&apos;&gt;&lt;div class=&apos;summary&apos;&gt;&lt;div class=&apos;summary-item&apos;&gt;&lt;span class=&apos;summary-value&apos;&gt;&lt;%=allCount%&gt;&lt;/span&gt;&lt;span class=&apos;summary-label&apos;&gt;All&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;summary-item&apos;&gt;&lt;span class=&apos;summary-value&apos;&gt;&lt;%=receivedCount%&gt;&lt;/span&gt;&lt;span class=&apos;summary-label&apos;&gt;Received&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;summary-item&apos;&gt;&lt;span class=&apos;summary-value&apos;&gt;&lt;%=selectedCount%&gt;&lt;/span&gt;&lt;span class=&apos;summary-label&apos;&gt;Selected&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;summary-item&apos;&gt;&lt;span class=&apos;summary-value&apos;&gt;&lt;%=rejectedCount%&gt;&lt;/span&gt;&lt;span class=&apos;summary-label&apos;&gt;Rejected&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;strip-note&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-filter&apos;&gt;&lt;/i&gt;Status overview; newest responses first&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;quotes-body&apos;&gt;\n\t\t&lt;% if(allCount == 0){ %&gt;\n\t\t\t&lt;div class=&apos;empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-mt-10 zcs-mb-0&apos;&gt;No supplier quotes&lt;/h5&gt;&lt;p class=&apos;zcs-color-secondary&apos;&gt;Responses will appear here when supplier quotes are recorded.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;% } else { %&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8 zcs-text-left&apos;&gt;Quote / order&lt;/th&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8 zcs-text-left&apos;&gt;Supplier&lt;/th&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8 zcs-text-left&apos;&gt;Response&lt;/th&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8 zcs-text-right&apos;&gt;Quoted value&lt;/th&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8 zcs-text-left&apos;&gt;Coverage&lt;/th&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8 zcs-text-left&apos;&gt;Status&lt;/th&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8 zcs-text-left&apos;&gt;Comparison&lt;/th&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8 zcs-text-left&apos;&gt;Open&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t&lt;% for each quote in quotes {\n\t\t\t\titems = Supplier_Quote_Product[Parent_Supplier_Quote == quote.ID];\n\t\t\t\tlineCount = items.count();\n\t\t\t\ttotalPrice = ifnull(items.sum(Supplier_Total_Price),0);\n\t\t\t\texactCount = Supplier_Quote_Product[Parent_Supplier_Quote == quote.ID &amp;&amp; Configuration_Match == &quot;Exact Match&quot;].count();\n\t\t\t\tpartialCount = Supplier_Quote_Product[Parent_Supplier_Quote == quote.ID &amp;&amp; (Configuration_Match == &quot;Partial Match&quot; || Configuration_Match == &quot;Alternative&quot;)].count();\n\t\t\t\tmismatchCount = Supplier_Quote_Product[Parent_Supplier_Quote == quote.ID &amp;&amp; Configuration_Match == &quot;Does Not Match&quot;].count();\n\t\t\t\torderQuoteCount = 0;\n\t\t\t\torderLabel = &quot;Not linked&quot;;\n\t\t\t\torderID = 0;\n\t\t\t\tif(quote.Sales_Order != null){orderQuoteCount = Add_Supplier_Quote[Sales_Order == quote.Sales_Order].count(); orderLabel = ifnull(quote.Sales_Order.Sales_Order_ID,&quot;Unlabelled order&quot;); orderID = quote.Sales_Order.ID;}\n\t\t\t\tsupplierLabel = &quot;Supplier not recorded&quot;;\n\t\t\t\tif(quote.Supplier != null){supplierLabel = ifnull(quote.Supplier.Supplier_Name,&quot;Unnamed supplier&quot;);}\n\t\t\t\tquoteLabel = ifnull(quote.Supplier_Quote_ID,&quot;Quote &quot; + quote.ID);\n\t\t\t\tcurrencyLabel = ifnull(quote.Currency,&quot;Currency not set&quot;);\n\t\t\t\tstatusLabel = ifnull(quote.Status,&quot;Status not set&quot;);\n\t\t\t\tquoteDateLabel = ifnull(quote.Quote_Date,&quot;Not recorded&quot;);\n\t\t\t\tavailabilityLabel = ifnull(quote.Availability,&quot;Not specified&quot;);\n\t\t\t\tleadLabel = ifnull(quote.Lead_Time,&quot;Not specified&quot;);\n\t\t\t\tbadgeClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\tif(statusLabel == &quot;Selected&quot;){badgeClass = &quot;zcs-badge-green&quot;;}else if(statusLabel == &quot;Rejected&quot;){badgeClass = &quot;zcs-badge-red&quot;;}else if(statusLabel == &quot;Status not set&quot;){badgeClass = &quot;zcs-badge-yellow&quot;;}\n\t\t\t\tcomparisonReady = orderQuoteCount &gt; 1 &amp;&amp; lineCount &gt; 0;\n\t\t\t%&gt;\n\t\t\t\t&lt;tr&gt;&lt;td data-label=&apos;Quote / order&apos; class=&apos;zcs-px-12 zcs-py-10&apos;&gt;&lt;div class=&apos;primary quote-key&apos;&gt;&lt;%=quoteLabel%&gt;&lt;/div&gt;&lt;div class=&apos;muted&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-delivery-fast&apos;&gt;&lt;/i&gt; &lt;%=orderLabel%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td data-label=&apos;Supplier&apos; class=&apos;zcs-px-12 zcs-py-10&apos;&gt;&lt;div class=&apos;primary&apos;&gt;&lt;%=supplierLabel%&gt;&lt;/div&gt;&lt;div class=&apos;muted&apos;&gt;&lt;%=ifnull(quote.Dispatch_Location,&quot;Dispatch location not set&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td data-label=&apos;Response&apos; class=&apos;zcs-px-12 zcs-py-10&apos;&gt;&lt;div&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-60&apos;&gt;&lt;/i&gt; &lt;%=quoteDateLabel%&gt;&lt;/div&gt;&lt;div class=&apos;muted&apos;&gt;Availability: &lt;%=availabilityLabel%&gt;&lt;/div&gt;&lt;div class=&apos;muted&apos;&gt;Lead: &lt;%=leadLabel%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td data-label=&apos;Quoted value&apos; class=&apos;zcs-px-12 zcs-py-10 zcs-text-right&apos;&gt;&lt;div class=&apos;money&apos;&gt;&lt;%=currencyLabel%&gt; &lt;%=totalPrice%&gt;&lt;/div&gt;&lt;div class=&apos;muted&apos;&gt;&lt;%=lineCount%&gt; line items&lt;/div&gt;&lt;/td&gt;&lt;td data-label=&apos;Coverage&apos; class=&apos;zcs-px-12 zcs-py-10&apos;&gt;&lt;div class=&apos;primary&apos;&gt;&lt;%=lineCount%&gt; configurations&lt;/div&gt;&lt;div class=&apos;coverage&apos;&gt;&lt;span class=&apos;mini&apos;&gt;&lt;%=exactCount%&gt; exact&lt;/span&gt;&lt;span class=&apos;mini&apos;&gt;&lt;%=partialCount%&gt; partial&lt;/span&gt;&lt;span class=&apos;mini&apos;&gt;&lt;%=mismatchCount%&gt; unmatched&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td data-label=&apos;Status&apos; class=&apos;zcs-px-12 zcs-py-10&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline &lt;%=badgeClass%&gt; zcs-inline-flex zcs-align-items-center zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=statusLabel%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td data-label=&apos;Comparison&apos; class=&apos;zcs-px-12 zcs-py-10&apos;&gt;&lt;% if(comparisonReady){ %&gt;&lt;div class=&apos;ready&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;Ready&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;muted&apos;&gt;&lt;%=orderQuoteCount%&gt; order quotes&lt;/div&gt;&lt;% } else if(orderID == 0){ %&gt;&lt;div class=&apos;waiting&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-link-72&apos;&gt;&lt;/i&gt;&lt;span&gt;Order required&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;muted&apos;&gt;Cannot compare&lt;/div&gt;&lt;% } else if(lineCount == 0){ %&gt;&lt;div class=&apos;waiting&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;span&gt;Items required&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;muted&apos;&gt;&lt;%=orderQuoteCount%&gt; quote(s)&lt;/div&gt;&lt;% } else { %&gt;&lt;div class=&apos;waiting&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span&gt;Awaiting response&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;muted&apos;&gt;1 order quote&lt;/div&gt;&lt;% } %&gt;&lt;/td&gt;&lt;td data-label=&apos;Open&apos; class=&apos;zcs-px-12 zcs-py-10&apos;&gt;&lt;div class=&apos;actions&apos;&gt;&lt;a title=&apos;Quote detail&apos; aria-label=&apos;Quote detail&apos; class=&apos;icon-link zcs-flex zcs-align-items-center zcs-justify-center&apos; href=&apos;#Report:All_Supplier_Quotes?ID=&lt;%=quote.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-eye-17&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;% if(orderID != 0){ %&gt;&lt;a title=&apos;Quote comparison&apos; aria-label=&apos;Quote comparison&apos; class=&apos;icon-link zcs-flex zcs-align-items-center zcs-justify-center&apos; href=&apos;#Page:Quote_Comparison?Sales_Order_ID=&lt;%=orderID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline design-app&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;% } %&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t&lt;% } %&gt;\n\t\t&lt;/div&gt;\n\t&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Hide_Data as "Hide Data"
			{
			
							type =  form
							form = Add_Approval_Setup
			
							record event = on add or edit
			
							field rules
							{
								actions  (Approver_Type == "Role" || Approver_Type is null)
								{
									hide users;
								}
								actions  (Approver_Type == "User" || Approver_Type is null)
								{
									hide Approver_Role;
								}
							}
			
						
			}

			Hide_Data3 as "Hide Data"
			{
			
							type =  form
							form = Add_Approval_Setup
			
							record event = on add or edit
			
							field rules
							{
								actions 
								{
									hide Hidden;
								}
							}
			
						
			}

			On_Load_Scripts5 as "On-Load Scripts"
			{
			
							type =  form
							form = Add_Approval_Setup
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Approval_Setup_For != null)
													{
														disable Approval_Setup_For;
													}
									)
								}
							}
			
						
			}

			On_success3 as "On success"
			{
			
							type =  form
							form = Add_Approval_Setup
			
							record event = on add
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														for each  flow in Add_Approval_Setup[ID != input.ID && Approval_Setup_For == input.Approval_Setup_For && Sequence_Order >= input.Sequence_Order]
													{
														flow.Sequence_Order=ifnull(flow.Sequence_Order,0) + 1;
														flow.Previous_Sequence_Number=ifnull(flow.Previous_Sequence_Number,0) + 1;
													}
													if(input.Previous_Sequence_Number == null)
													{
														input.Previous_Sequence_Number = 0;
													}
													if(input.Sequence_Order == null)
													{
														input.Sequence_Order = 0;
													}
													// openUrl("#Script:page.parent.refresh","parent window");
									)
								}
							}
			
						
			}

			On_success4 as "On success"
			{
			
							type =  form
							form = Add_Approval_Setup
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														openUrl("#Page:Approval_Setup?zc_LoadIn=embed-embedDiv&recID=" + input.Approval_Setup_For,"same window");
									)
								}
							}
			
						
			}

			Validation as "Validation"
			{
			
							type =  form
							form = Add_Approval_Setup
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														// today = zoho.currentdate;
													// currMonth = today.getMonth();
													// currYear = today.getYear();
													// currentDay = today.getDay();
													// startDate = today.toStartOfMonth();
													// endDate = startDate.addDay(9);
													// if(currentDay < 1 || currentDay > 10)
													// {
													// 	alert "Preference submission is currently closed. Please contact HR for assistance.";
													// 	cancel submit;
													// }
													if(input.Approver_Type == "Role" && input.Approver_Role == null)
													{
														alert "Please Select Approver Role to Proceed.";
														cancel submit;
													}
													if(input.Approver_Type == "User" && input.users == null)
													{
														alert "Please Select User to Proceed.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Add_Customer_On_Load as "Add Customer On Load"
			{
			    type = form
			    form = Add_Customer
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                hide Hidden_Section;
			                disable Created_Date_Time;
			                disable Last_Updated_Date_Time;
			            )
			        }
			    }
			}

			Add_Customer_On_Success as "Update Customer Timestamp"
			{
			    type = form
			    form = Add_Customer
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                customer_record = Add_Customer[ID == input.ID];
			                customer_record.Last_Updated_Date_Time = zoho.currenttime;
			            )
			        }
			    }
			}

			Add_History_On_Load as "Add History On Load"
			{
			    type = form
			    form = Add_History
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                hide Audit_Context;
			                disable Action_Type;
			                disable Status;
			                disable Previous_Status;
			                disable New_Status;
			                disable Updated_By;
			                disable Updated_By_Email;
			                disable Updated_Date_Time;
			                employee_record = Add_Employee[Email == zoho.loginuserid];
			                if(employee_record.count() > 0)
			                {
			                    input.Updated_By = employee_record.ID;
			                }
			            )
			        }
			    }
			}

			Add_History_On_Success as "Finalize History Action"
			{
			    type = form
			    form = Add_History
			    record event = on add
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Action_Type == "Purchase Order Approved" && input.Purchase_Order_Lookup != null)
			                {
			                    po_record = Create_Purchase_Order[ID == input.Purchase_Order_Lookup];
			                    po_record.Status = "Approved";
			                    sales_order_record = Create_Sales_Order[ID == po_record.Sales_Order];
			                    sales_order_record.Status = "Purchase Order Approved";
			                    insert into Add_History
			                    [
			                        Action_Type = "Status Changed"
			                        Status = "Purchase Order Approved"
			                        Previous_Status = "Purchase Order Created"
			                        New_Status = "Purchase Order Approved"
			                        Comments = input.Comments
			                        Sales_Order_Lookup = po_record.Sales_Order
			                        Purchase_Order_Lookup = input.Purchase_Order_Lookup
			                        Updated_By = input.Updated_By
			                        Updated_By_Email = input.Updated_By_Email
			                        Updated_Date_Time = zoho.currenttime
			                    ];
			                }
			            )
			        }
			    }
			}

			Add_Lead_On_Load as "Add Lead On Load"
			{
			    type = form
			    form = Add_Lead
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                hide Hidden;
			                disable Status;
			                disable Action_Mode;
			                disable Customer_Company_Name;
			                disable Contact_Person;
			                disable Email;
			                disable Phone;
			                disable Country;
			                disable Lead_Products.Product_ID;
			                disable Lead_Products.Product_Name;
			                disable Lead_Products.Product_Category;
			                disable Lead_Products.Product_Type;
			                disable Lead_Products.Product_Description;
			                disable Lead_Products.Manufacturer_Part_Number;
			                disable Lead_Products.Internal_Part_Number;
			                disable Lead_Products.Brand_Make;
			                disable Lead_Products.Model;
			                disable Lead_Products.Unit_of_Measure;
			                disable Lead_Products.Expected_Total_Price;
			            )
			        }
			    }
			}

			Add_Lead_On_Success as "Create Lead History"
			{
			    type = form
			    form = Add_Lead
			    record event = on add
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                insert into Add_History
			                [
			                    Action_Type = "Record Created"
			                    Status = input.Status
			                    New_Status = input.Status
			                    Comments = "Lead created"
			                    Lead_Lookup = input.ID
			                    Updated_By_Email = zoho.loginuserid
			                    Updated_Date_Time = zoho.currenttime
			                ];
			            )
			        }
			    }
			}

			Customer_On_User_Input as "Prefill Lead Customer"
			{
			    type = form
			    form = Add_Lead
			    record event = on add or edit
			
			    on user input of Customer
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Customer != null)
			                {
			                    customer_record = Add_Customer[ID == input.Customer];
			                    input.Customer_Company_Name = customer_record.Customer_Name;
			                    input.Contact_Person = customer_record.Contact_Person;
			                    input.Email = customer_record.Email;
			                    input.Phone = customer_record.Phone;
			                    input.Country = customer_record.Country;
			                }
			            )
			        }
			    }
			}

			Lead_Product_On_User_Input as "Snapshot Lead Product"
			{
			    type = form
			    form = Add_Lead
			    record event = on add or edit
			
			    on user input of Lead_Products.Product
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(row.Product != null)
			                {
			                    product_record = Add_Product[ID == row.Product];
			                    row.Product_ID = product_record.Product_ID.toString();
			                    row.Product_Name = product_record.Product_Name;
			                    row.Product_Category = product_record.Product_Category;
			                    row.Product_Type = product_record.Product_Type;
			                    row.Product_Description = product_record.Product_Description;
			                    row.Manufacturer_Part_Number = product_record.Manufacturer_Part_Number;
			                    row.Internal_Part_Number = product_record.Internal_Part_Number;
			                    row.Brand_Make = product_record.Brand_Make;
			                    row.Model = product_record.Model;
			                    row.Unit_of_Measure = product_record.Unit_of_Measure;
			                    row.Configuration = product_record.Configuration_Template;
			                    row.Expected_Unit_Price = product_record.Reference_Selling_Price;
			                    row.Expected_Total_Price = ifnull(row.Quantity,0) * ifnull(row.Expected_Unit_Price,0);
			                    disable row.Product_ID;
			                    disable row.Product_Name;
			                    disable row.Product_Category;
			                    disable row.Product_Type;
			                    disable row.Product_Description;
			                    disable row.Manufacturer_Part_Number;
			                    disable row.Internal_Part_Number;
			                    disable row.Brand_Make;
			                    disable row.Model;
			                    disable row.Unit_of_Measure;
			                    disable row.Expected_Total_Price;
			                }
			            )
			        }
			    }
			}

			Lead_Product_Price_On_User_Input as "Recalculate Lead Product Total"
			{
			    type = form
			    form = Add_Lead
			    record event = on add or edit
			
			    on user input of Lead_Products.Expected_Unit_Price
			    {
			        actions
			        {
			            custom deluge script
			            (
			                row.Expected_Total_Price = ifnull(row.Quantity,0) * ifnull(row.Expected_Unit_Price,0);
			                disable row.Expected_Total_Price;
			            )
			        }
			    }
			}

			Lead_Product_Quantity_On_User_Input as "Calculate Lead Product Total"
			{
			    type = form
			    form = Add_Lead
			    record event = on add or edit
			
			    on user input of Lead_Products.Quantity
			    {
			        actions
			        {
			            custom deluge script
			            (
			                row.Expected_Total_Price = ifnull(row.Quantity,0) * ifnull(row.Expected_Unit_Price,0);
			                disable row.Expected_Total_Price;
			            )
			        }
			    }
			}

			On_Load_Scripts as "On-Load Scripts"
			{
			
							type =  form
							form = Add_Preference
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														style = thisapp.decisionBoxStyle.getDecisionBoxToggleBtnStyle("All","","#6147e5","#dddddd");
