			{
			
							type =  form
							form = Navigation
			
							record event = on add
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														navOptionMap = Map();
													navOptionMap.put("Other_Config",{"Preference"});
													navOptionMap.put("Free_Cash",{"Pending Free Issue","Employee Preference","All Free Issue"});
													liss = navOptionMap.get(input.Page_Name);
													input.Nav_Options:ui.add(liss);
													tabIndex = if(input.Tab == null || input.Tab > liss.size(),0,input.Tab - 1);
													input.Nav_Options = liss.get(tabIndex);
									)
								}
							}
			
						
			}

			Run_Script1 as "Run Script"
			{
			
							type =  form
							form = Navigation
			
							record event = on add
			
							on user input of Nav_Options
							{
								actions 
								{
									custom deluge script
									(
														navOptionMap = Map();
													fetchPreference = Add_Preference[ID != null];
													if(fetchPreference.count() != 0)
													{
														preferenceID = fetchPreference.ID;
														if(fetchPreference.Organization_Logo == "" || fetchPreference.Organization_Logo == null)
														{
															res = invokeurl
															[
																url :"https://files-accl.zohoexternal.com/public/workdrive-external/download/h814669ae0987327a4404804a6236ce5e7438?x-cli-msg=%7B%22linkId%22%3A%226OxchGOzv8B-J8HFH%22%2C%22isFileOwner%22%3Afalse%2C%22version%22%3A%221.0%22%2C%22isWDSupport%22%3Afalse%7D"
																type :GET
															];
															res.setParamName("file");
															res.setFileName("Creator_Logo" + ".png");
															response = invokeurl
															[
																url :"https://www.zohoapis.com/creator/v2.1/data" + zoho.appuri + "report/All_Preferences/" + fetchPreference.ID + "/Organization_Logo/upload"
																type :POST
																files:res
																connection:"creator"
															];
														}
														navOptionMap.put("Other_Config",{"Preference":{"name":"Add_Preference","type":"Form","criteria":"&viewLinkName=All_Preferences&recLinkID=" + preferenceID}});
														navOptionMap.put("Free_Cash",{"Pending Free Issue":{"name":"Pending_Free_Issue_Report","type":"Report","criteria":""},"Employee Preference":{"name":"Employee_Preference","type":"Report","criteria":""},"All Free Issue":{"name":"Add_Free_Issue_Report","type":"Report","criteria":""}});
														if(input.Nav_Options != "" && navOptionMap.containKey(input.Page_Name))
														{
															mapp = navOptionMap.get(input.Page_Name);
															openUrl("#" + if(mapp.get(input.Nav_Options).get("type") != null,mapp.get(input.Nav_Options).get("type"),"Report") + ":" + mapp.get(input.Nav_Options).get("name") + "?zc_LoadIn=embed-showFrame" + if(mapp.get(input.Nav_Options).get("criteria") != null,mapp.get(input.Nav_Options).get("criteria"),""),"same window");
														}
													}
													else
													{
														insert into Add_Preference
														[
															Added_User=zoho.loginuser
															Email_Notification=true
														]
														openUrl("#Script:page.refresh","same window");
													}
									)
								}
							}
			
						
			}

			On_success as "On success"
			{
			
							type =  form
							form = Request_Access
			
							record event = on add
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														if(input.Action_Type == "Provide")
													{
														if(input.Access_Type == "" || input.Access_Type == "User Access")
														{
															if(thisapp.permissions.profileForUser(input.Requester_Email) != "Administrator")
															{
																thisapp.permissions.assignUserInProfile(input.Requester_Email,"Write");
															}
															input.IsOnSuccessCodeExecuted = true;
														}
														else if(input.Access_Type == "Portal Access")
														{
															thisapp.portal.assignUserInProfile(input.Requester_Email,"Customer");
															input.IsOnSuccessCodeExecuted = true;
														}
													}
													else if(input.Action_Type == "Revoke")
													{
														if(input.Access_Type == "" || input.Access_Type == "User Access")
														{
															if(thisapp.permissions.profileForUser(input.Requester_Email) != "Administrator")
															{
																thisapp.permissions.deleteUser(input.Requester_Email);
															}
															input.IsOnSuccessCodeExecuted = true;
														}
														else if(input.Access_Type == "Portal Access")
														{
															thisapp.portal.deleteUser(input.Requester_Email);
															input.IsOnSuccessCodeExecuted = true;
														}
													}
									)
								}
							}
			
						
			}
		}

		functions
		{
			Create_Sales_Order_From_Lead as "Create Sales Order From Lead"
			{
			    type = functions
			    form = Add_Lead
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                sales_order_rows = Collection();
			                for each lead_item in input.Lead_Products
			                {
			                    sales_order_row = Create_Sales_Order.Sales_Order_Products();
			                    sales_order_row.Product = lead_item.Product;
			                    sales_order_row.Product_ID = lead_item.Product_ID;
			                    sales_order_row.Product_Name = lead_item.Product_Name;
			                    sales_order_row.Product_Category = lead_item.Product_Category;
			                    sales_order_row.Product_Type = lead_item.Product_Type;
			                    sales_order_row.Product_Description = lead_item.Product_Description;
			                    sales_order_row.Manufacturer_Part_Number = lead_item.Manufacturer_Part_Number;
			                    sales_order_row.Internal_Part_Number = lead_item.Internal_Part_Number;
			                    sales_order_row.Brand_Make = lead_item.Brand_Make;
			                    sales_order_row.Model = lead_item.Model;
			                    sales_order_row.Unit_of_Measure = lead_item.Unit_of_Measure;
			                    sales_order_row.Configuration = lead_item.Configuration;
			                    sales_order_row.Technical_Requirements = lead_item.Technical_Requirements;
			                    sales_order_row.Quantity = lead_item.Quantity;
			                    sales_order_row.Remarks = lead_item.Remarks;
			                    sales_order_rows.insert(sales_order_row);
			                }
			                sales_order_record_id = insert into Create_Sales_Order
			                [
			                    Customer = input.Customer
			                    Lead = input.ID
			                    Requirement_Source = "Customer Request"
			                    Sales_Order_Date = zoho.currentdate
			                    Sales_Order_Products = sales_order_rows
			                    Customer_Requirements = input.Requirement
			                    Additional_Remarks = "Created from lead"
			                    Status = "New"
			                ];
			                previous_status = input.Status;
			                input.Status = "Sales Order Created";
			                insert into Add_History
			                [
			                    Action_Type = "Sales Order Created"
			                    Status = "Sales Order Created"
			                    Previous_Status = previous_status
			                    New_Status = "Sales Order Created"
			                    Comments = "Sales order created from lead"
			                    Lead_Lookup = input.ID
			                    Sales_Order_Lookup = sales_order_record_id
			                    Updated_By_Email = zoho.loginuserid
			                    Updated_Date_Time = zoho.currenttime
			                ];
			            )
			        }
			    }
			}

			Mark_Lead_Lost as "Mark Lead Lost"
			{
			    type = functions
			    form = Add_Lead
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                previous_status = input.Status;
			                input.Status = "Lost";
			                insert into Add_History
			                [
			                    Action_Type = "Lead Marked Lost"
			                    Status = "Lost"
			                    Previous_Status = previous_status
			                    New_Status = "Lost"
			                    Comments = "Lead marked lost"
			                    Lead_Lookup = input.ID
			                    Updated_By_Email = zoho.loginuserid
			                    Updated_Date_Time = zoho.currenttime
			                ];
			            )
			        }
			    }
			}

			Activate_Product as "Activate Product"
			{
			    type = functions
			    form = Add_Product
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                input.Active = true;
			                input.Last_Updated_Date_Time = zoho.currenttime;
			            )
			        }
			    }
			}

			Deactivate_Product as "Deactivate Product"
			{
			    type = functions
			    form = Add_Product
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                input.Active = false;
			                input.Last_Updated_Date_Time = zoho.currenttime;
			            )
			        }
			    }
			}

			Mark_Supplier_Invoice_Paid as "Mark Supplier Invoice Paid"
			{
			    type = functions
			    form = Add_Supplier_Invoice
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                openUrl("#Form:Add_Supplier_Invoice?recLinkID=" + input.ID + "&viewLinkName=All_Supplier_Invoices&Action_Mode=Mark Paid", "same window");
			            )
			        }
			    }
			}

			Approve_Purchase_Order as "Approve Purchase Order"
			{
			    type = functions
			    form = Create_Purchase_Order
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                openUrl("#Form:Add_History?Purchase_Order_Lookup=" + input.ID + "&Sales_Order_Lookup=" + input.Sales_Order + "&Action_Type=Purchase Order Approved&Status=New&Previous_Status=New&New_Status=Approved&Updated_By_Email=" + zoho.loginuserid, "popup window", "height=650px,width=700px");
			            )
			        }
			    }
			}
		}
	}

	functions
	{
		Deluge
		{
			string Components.ApprovalCard(map params)
			{
			
			                 	common = thisapp.Localization.Common();
			                 	card_dom = "<li class='zc-pra-zigzag-li zc-pra-clearfix'>";
			                 	if(params.get("Show_Add_Before") == true && params.get("Is_Preview") == false || params.get("Is_Preview") == null)
			                 	{
			                 		if(params.get("from") == "Employee_Approval_Setup")
			                 		{
			                 			card_dom = card_dom + "<div class='zc-pra-add-card zc-pra-flt-left'><a href='#Form:Add_Employee_Approvals?Type_field=" + params.get('Type_field') + "&Approval_Template=" + params.get('Template_ID') + "&Requester=" + params.get('Requester_Role_Param') + "&Previous_Sequence_Number=0&Sequence_Order=0&Add_Type=Specific&zc_LoadIn=dialog'><i class='zc-li-outline ui-1-simple-add'></i></a></div>";
			                 		}
			                 		else
			                 		{
			                 			card_dom = card_dom + "<div class='zc-pra-add-card zc-pra-flt-left'><a href='#Form:Add_Approval_Setup?Designation=" + params.get('Type_field') + "&Approval_Template=" + params.get('Template_ID') + "&Requester=" + params.get('Requester_Role_Param') + "&Previous_Sequence_Number=0&Sequence_Order=0&Add_Type=Specific&zc_LoadIn=dialog'><i class='zc-li-outline ui-1-simple-add'></i></a></div>";
			                 		}
			                 	}
			                 	colour_map = {"Open":"#696f73","Approved":"#2ecc71","Rejected":"#e74c3c","Pending":"#dbad48","":""};
			                 	card_dom = card_dom + "<div class='zc-pra-card zc-pra-flt-left'><div class='zc-pra-zcard-header zc-pra-clearfix zc-pra-fw' style='background:" + colour_map.get(params.get("status")) + "'><div class='zc-pra-zcard-title zc-pra-flt-left zc-pra-clearfix'><span class='zc-pra-flt-left zc-pra-no-wrapper'>" + params.get('Sequence_Order') + "</span><h6 class='zc-pra-flt-left'>" + params.get('Level_name') + "</h6></div>";
			                 	if(params.get("Is_Preview") == false || params.get("Is_Preview") == null)
			                 	{
			                 		if(params.get('Type_field') == "Purchase Order" && params.get("Is_Last_Step") == true)
			                 		{
			                 			if(params.get("from") == "Employee_Approval_Setup")
			                 			{
			                 				card_dom = card_dom + "<div class='zc-pra-more-options zc-pra-rounded zc-pra-flt-right'><div class='zc-pra-hover-extend'></div><i class='ui-2-menu-dots zc-li-solid'></i><ul><li><a href='#Form:Add_Employee_Approvals?recLinkID=" + params.get('ID') + "&viewLinkName=Add_Employee_Approvals_Report&zc_LoadIn=dialog'><i class='zc-li-outline ui-1-edit-72'></i><span>" + common.get('zcp.edit') + " </span></a></li></ul></div>";
			                 			}
			                 			else
			                 			{
			                 				card_dom = card_dom + "<div class='zc-pra-more-options zc-pra-rounded zc-pra-flt-right'><div class='zc-pra-hover-extend'></div><i class='ui-2-menu-dots zc-li-solid'></i><ul><li><a href='#Form:Add_Approval_Setup?recLinkID=" + params.get('ID') + "&viewLinkName=All_Approval_Setups&zc_LoadIn=dialog'><i class='zc-li-outline ui-1-edit-72'></i><span>" + common.get('zcp.edit') + " </span></a></li></ul></div>";
			                 			}
			                 		}
			                 		else
			                 		{
			                 			if(params.get("from") == "Employee_Approval_Setup")
			                 			{
			                 				card_dom = card_dom + "<div class='zc-pra-more-options zc-pra-rounded zc-pra-flt-right'><div class='zc-pra-hover-extend'></div><i class='ui-2-menu-dots zc-li-solid'></i><ul><li><a href='#Form:Add_Employee_Approvals?recLinkID=" + params.get('ID') + "&viewLinkName=Add_Employee_Approvals_Report&zc_LoadIn=dialog'><i class='zc-li-outline ui-1-edit-72'></i><span>" + common.get('zcp.edit') + " </span></a></li><li class='zc-pra-color-red'><a href='#Form:Delete_form?Approval_Setup=" + params.get('ID') + "&zc_LoadIn=dialog&zc_Header=false'><i class='zc-li-outline ui-1-circle-remove'></i><span>" + common.get('zcp.remove') + " </span></a></li></ul></div>";
			                 			}
			                 			else
			                 			{
			                 				card_dom = card_dom + "<div class='zc-pra-more-options zc-pra-rounded zc-pra-flt-right'><div class='zc-pra-hover-extend'></div><i class='ui-2-menu-dots zc-li-solid'></i><ul><li><a href='#Form:Add_Approval_Setup?recLinkID=" + params.get('ID') + "&viewLinkName=All_Approval_Setups&zc_LoadIn=dialog'><i class='zc-li-outline ui-1-edit-72'></i><span>" + common.get('zcp.edit') + " </span></a></li><li class='zc-pra-color-red'><a href='#Form:Delete_form?Approval_Setup=" + params.get('ID') + "&zc_LoadIn=dialog&zc_Header=false'><i class='zc-li-outline ui-1-circle-remove'></i><span>" + common.get('zcp.remove') + " </span></a></li></ul></div>";
			                 			}
			                 		}
			                 	}
			                 	// 	for each  role in params.get("Approval_For_Role")
			                 	// 	{
			                 	if(params.get("from") == "Employee_Approval_Setup")
			                 	{
			                 		card_dom = card_dom + "</div><div class='zc-pra-zcard-content'><ul><li><label>Role :</label><div class='zc-pra-zcard-badge'>";
			                 		card_dom = card_dom + "<span>" + params.get('Approver_Role') + " </span>";
			                 		card_dom = card_dom + "</div></li>";
			                 		card_dom = card_dom + "<li>";
			                 		card_dom = card_dom + "<label>User :</label>" + "<span class='zc-pra-color-green' style=color:" + if(params.get('users') == null || params.get('users') == "","Red","") + ";>" + if(params.get('users') == null || params.get('users') == "","Not yet Selected",params.get('users')) + "</span>";
			                 		card_dom = card_dom + "</li>";
			                 		card_dom = card_dom + "</ul></div></div>";
			                 	}
			                 	else
			                 	{
			                 		card_dom = card_dom + "</div><div class='zc-pra-zcard-content'><ul><li><label>" + common.get('zcp.approvalcard.approver') + "</label><div class='zc-pra-zcard-badge'>";
			                 		card_dom = card_dom + "<span>" + params.get('Approver_Role') + " </span>";
			                 		card_dom = card_dom + "</div></li>";
			                 		card_dom = card_dom + "<li>";
			                 		card_dom = card_dom + "<label>User</label>" + "<span class='zc-pra-color-green'>" + if(params.get('users') == null || params.get('users') == "","Employee Can Choose",params.get('users')) + "</span>";
			                 		card_dom = card_dom + "</li>";
			                 		card_dom = card_dom + "</ul></div></div>";
			                 		// 		card_dom = card_dom + "</div><div class='zc-pra-zcard-content'><ul>";
			                 		// 		card_dom = card_dom + "<li>";
			                 		// 		card_dom = card_dom + "<label>" + common.get('zcp.approvalcard.approver') + "</label>" + "<span class='zc-pra-color-green'>" + params.get('Approver_Role') + "</span>";
			                 		// 		card_dom = card_dom + "</li>";
			                 		// 		card_dom = card_dom + "</ul></div></div>";
			                 	}
			                 	if(params.get("Is_Preview") == false || params.get("Is_Preview") == null)
			                 	{
			                 		card_dom = card_dom + "<div class='zc-pra-add-card zc-pra-flt-left'><a href='#Form:Add_Approval_Setup?Designation=" + params.get('Type_field') + "&Approval_Template=" + params.get("Template_ID") + "&Previous_Sequence_Number=" + params.get('Previous_Sequence_Number') + "&Requester=" + params.get('Requester_Role_Param') + "&Sequence_Order=" + params.get('Sequence_Order') + "&Add_Type=Specific&zc_LoadIn=dialog'><i class='zc-li-outline ui-1-simple-add'></i></a></div>";
			                 	}
			                 	else
			                 	{
			                 		card_dom = card_dom + "<div class='zc-pra-add-card zc-pra-flt-left'></div>";
			                 	}
			                 	card_dom = card_dom + "</li>";
			                 	return card_dom;
			                 
			}

			string BaseStyle()
			{
			
