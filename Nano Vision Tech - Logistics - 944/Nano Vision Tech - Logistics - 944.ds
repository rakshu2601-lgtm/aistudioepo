		page All_Mail_Templates1
		{
					displayname = "All Mail Templates"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet311' elementName='HTML Snippet' bgColor='#FFFFFF'>\n\t\t\t\t\t<![CDATA[htmlpage html_snippet311()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;link rel=&quot;stylesheet&quot; href=&quot;https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css&quot; /&gt;\n\n&lt;style&gt;\n\n* {\n\t\tpadding: 0;\n\t\tmargin: 0;\n\t\tborder: none;\n\t\tbox-sizing: border-box;\n\t\t }\n\t div::-webkit-scrollbar, table::-webkit-scrollbar, tr::-webkit-scrollbar, th::-webkit-scrollbar, td::-webkit-scrollbar, ul::-webkit-scrollbar, li::-webkit-scrollbar, a::-webkit-scrollbar, form::-webkit-scrollbar, input::-webkit-scrollbar {\n\t\t display: none;\n\t}\n\tdiv, table, tr, th, td, ul, li, a, form, input {\n\t\t-ms-overflow-style: none;\n\t\tscrollbar-width: none; \n\t}\n\t.zc-pb-embed-placeholder-content {\n\t\toverflow: hidden;\n\t}\n\t.zc-header .header_top_bar {\n\t\theight: 66px !important;\n\t}\n\tdiv#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder{\n\t\theight: 100% !important;\n\t\tborder: unset !important;\n\t}\n\t.zc_live_adminbar .zc-container-wrapper {\n\t\theight:100% !important;\n\t}\n\t.Layout.elemContainment {\n\t\tpadding: unset !important;\n\t}\n.zc_live_adminbar .zc-container-wrapper {\n\t\theight: 100% !important;\n\t}\n:root {\n\t--primary-color: #467eee;\n}\n\n/* ===== LAYOUT ===== */\n.innerMainDiv {\n\twidth: 100%;\n\theight: 100%;\n}\n.boxContainer {\n\twidth: 100%;\n\theight: 100%;\n\tdisplay: flex;\n\tflex-direction: column;\n\tborder-radius: 10px;\n\t/*border: 1px solid #ededed;*/\n\tbackground: #fff;\n\toverflow: hidden;\n}\n.boxHeader {\n\tbackground: #ffffff;\n\theight: 50px;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tpadding: 0 20px;\n\tfont-weight: 600;\n\tcolor: #000;\n\tborder-bottom: 1px solid #ededed;\n}\n.boxHeader a {\n\ttext-decoration: none;\n\tbackground: var(--primary-color);\n\tcolor: #fff;\n\tpadding: 8px 16px;\n\tborder-radius: 8px;\n\tfont-weight: 500;\n\tfont-size: 14px;\n\ttransition: all 0.3s ease;\n}\n.boxHeader a:hover {\n\tbackground: var(--menu_selected_hover_bg_color);\n}\n.boxContent {\n\tflex: 1;\n\tpadding: 20px;\n\toverflow: auto;\n\tdisplay: flex;\n\tgap: 20px;\n\twidth: 100%;\n\theight: 100%;\n\tflex-wrap: wrap;\n\t\n\talign-content: flex-start;\n}\n\n/* ===== MAIL TEMPLATE CARDS ===== */\n\n.mail-card {\n\tbackground: #f8f8f8;\n\t\tborder: 1px solid #ededed;\n\t\tborder-radius: 16px;\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\tmax-width: 50%;\n\t\twidth: 300px;\n\t\tvertical-align: top;\n\t\ttransition: all 0.3s ease;\n\toverflow: hidden;\n}\n.mail-card:hover {\n\tbackground: #eeebfa;\n}\n\n/* Dashed separator after each card */\n.mail-card:not(:last-child)::after {\n\tcontent: &quot;&quot;;\n\tposition: absolute;\n\ttop: 10px;\n\tright: -10px;\n\twidth: 1px;\n\theight: 95%;\n\t/*border-right: 2px dashed #ccc;*/\n}\n\n/* Header Section */\n.card-header {\n\tpadding: 15px 20px;\n\tdisplay: flex;\n\tjustify-content: space-between;\n\talign-items: flex-start;\n\t\n}\n.card-header .subject {\n\tfont-size: 16px;\n\t\tfont-weight: 600;\n\t\tcolor: #6147e5;\n\tword-break: break-word;\n\twhite-space: nowrap;\n\t\toverflow: hidden;\n\t\ttext-overflow: ellipsis;\n}\n.card-header .options-container {\n\tposition: relative;\n\t    transform: rotate(90deg);\n}\n.options-toggle {\n\tbackground: none;\n\tborder: none;\n\tfont-size: 18px;\n\tcolor: #a0aec0;\n\tcursor: pointer;\n}\n.options-menu {\n\tposition: absolute;\n\ttop: 100%;\n\tright: 0;\n\tbackground: #fff;\n\tborder-radius: 10px;\n\tbox-shadow: 0 10px 30px rgba(0,0,0,0.15);\n\twidth: 180px;\n\tdisplay: none;\n\tborder: 1px solid #e2e8f0;\n\tz-index: 5;\n}\n.options-menu a {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 10px;\n\tpadding: 12px 15px;\n\ttext-decoration: none;\n\tcolor: #4a5568;\n\tfont-size: 14px;\n\ttransition: 0.2s;\n}\n.options-menu a:hover {\n\tbackground: #f7fafc;\n\tcolor: var(--primary-color);\n}\n.options-toggle:focus + .options-menu,\n.options-menu:hover {\n\tdisplay: block;\n}\n\n/* Body Section */\n.mail-card:hover .card-body{\n\t\tbackground: #eeebfa;\n}\n.card-body {\n\tpadding: 15px 20px;\n\toverflow: hidden;\n\tdisplay: flex;\n\theight: calc(100% - 53px);\n\tflex-direction: column;\n\tjustify-content: space-between;\n\tbackground: #ffffff;\n}\n.mail-preview {\n\tfont-size: 14px;\n\t\tcolor: #4a5568;\n\t\tline-height: 1.6;\n\t\tword-wrap: break-word;\n\t\theight: calc(100% - 39px);\n\t\toverflow: auto;\n}\n.mail-meta {\n\tmargin-top: 12px;\n\t\tdisplay: flex;\n\t\tjustify-content: space-between;\n\t\talign-items: center;\n\t\tflex-wrap: wrap;\n\t\tgap: 6px;\n}\n.mail-to {\n\tfont-size: 13px;\n\tcolor: #718096;\n\tfont-weight: 500;\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 6px;\n}\n.mail-to i {\n\tcolor: var(--primary-color);\n}\n.status-badge {\n\tpadding: 6px 12px;\n\tborder-radius: 20px;\n\tfont-size: 12px;\n\tfont-weight: 600;\n\ttext-transform: uppercase;\n}\n.status-active {\n\tbackground: #d1fae5;\n\tcolor: #065f46;\n}\n.status-inactive {\n\tbackground: #fee2e2;\n\tcolor: #991b1b;\n}\n\n/* Empty State */\n.noDetailDiv {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: center;\n\theight: 100%;\n\tcolor: #626262;\n\tfont-weight: 500;\n\twidth: 100%;\n}\n@media (max-width:768px){\n\t.mail-card {\n\t\twidth: 90%;\n\t\tmin-width: 90%;\n\t}\n}\n&lt;/style&gt;\n\n&lt;div class=&quot;innerMainDiv&quot;&gt;\n\t&lt;div class=&quot;boxContainer&quot;&gt;\n\t\t&lt;div class=&quot;boxHeader&quot;&gt;\n\t\t\t&lt;div&gt;All Mail Templates&lt;/div&gt;\n\t\t\t&lt;a href=&quot;#Form:Create_Template?zc_LoadIn=embed-embedDiv&amp;zc_Header=false&amp;zc_NextUrl=#Script:page.refresh&amp;&quot;&gt;+ Add Template&lt;/a&gt;\n\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;boxContent&quot;&gt;\n&lt;%\n\tfetchSalesOrder = Create_Template[ID != null];\n\tif(fetchSalesOrder.count() != 0)\n\t{\n\t\tfetchSalesOrder1 = Create_Template[ID != null].distinct(Email_For);\n\t\tfor each  rec in fetchSalesOrder1\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;mail-card&quot;&gt;\n\t\t\t&lt;a class=&quot;card-header&quot; href=&quot;#Page:All_Mail_Templates?zc_LoadIn=embed-embedDiv&amp;recID=&lt;%=rec%&gt;&quot;&gt;\n\t  &lt;div class=&quot;subject&quot;&gt;&lt;%=rec%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;options-container&quot;&gt;\n\t\t\t\t\t&lt;button class=&quot;options-toggle&quot;&gt;&lt;i class=&quot;fas fa-ellipsis-v&quot;&gt;&lt;/i&gt;&lt;/button&gt;\n\t\t\t\t\t\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/a&gt;\n\t\t \n\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;style&gt;\n/*.zc-content-loader div {\n display: none !important;\n}*/\n\t.main_container_img {\n\t\t\t\twidth: 100%;\n\t\t\t\theight: 100%;\n\t\t\t\tdisplay: flex;\n\t\t\t\tjustify-content: center;\n\t\t\t\talign-items: center;\n\t\t\t\tpadding: 15px;\n\t\t}\n\t.img_c {\n\t\t\t\tanimation: fadeInZoom 0.2s ease-in-out forwards;\n\t\t\t\tobject-fit: contain;\n\t\t\t\twidth: 10%;\n\t\t}\n\t\t&lt;/style&gt;\n&lt;div class=&quot;main_container_img&quot;&gt;\n&lt;div style=&quot;display: flex ; width: 100%; height: 100%; flex-direction: column; justify-content: center; align-content: center; align-items: center;&quot;&gt;\n\t\t&lt;img class=&quot;img_c&quot; src=&quot;https://files-accl.zohoexternal.com/public/workdrive-external/download/c4yc5f4e45a3a037f4ceeb726dfdca8d7e886?x-cli-msg=%7B%22linkId%22%3A%226OxchGZlnBc-J8HFH%22%2C%22isFileOwner%22%3Afalse%2C%22version%22%3A%221.0%22%2C%22isWDSupport%22%3Afalse%7D&quot;&gt;\n\t&lt;div style=&quot;color: #2f305d; font-weight:600;&quot;&gt; No Data Available&lt;/div&gt;&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Approval_Setup(string module, int recID)
		{
					displayname = "Approval_Setup"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet4' elementName='HTML Snippet' bgColor='#FFFFFF'>\n\t\t\t\t\t<![CDATA[htmlpage html_snippet4()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;style&gt;\n.zc-content-loader div {\n display: none !important;\n}\n\t* {\n\t\tpadding: 0;\n\t\tmargin: 0;\n\t\tborder: none;\n\t\tbox-sizing: border-box;\n\t\t }\n\t.zc-pb-embed-placeholder-content {\n\t\toverflow: hidden;\n\t}\n\t.zc-header .header_top_bar {\n\t\theight: 66px !important;\n\t}\n\t.zcform_Delete_form .first-column .form-label {\n\t\twidth: unset !important;\n}\n.zcform_Delete_form .zcpopup .popupbox form .zc-footer-wrapper .formbutton .zc-live-primary-btn\n{\n\tdisplay: unset !important;\n}\n.zcform_Delete_form .zcpopup .statelessFormWidth .form-action .zc-live-primary-btn {\n\tmargin: 0 10px 0 0 !important;\n}\n.zcform_Delete_form  .zcpopup.compact .popupbox-wrapper .popupbox.formWithinPopup .popupboxOuter .form-outer-wrapper form .formContainer {\n\t\tpadding: 0px 30px !important;\n}\n// \t.zc-freezer.zc-freezer-layer {\n// \t\tdisplay: none !important;\n// \t}\n// \t.popupbox-wrapper {\n// \t\tpadding: 14px;\n// \t\tmargin-left: 240px;\n// \t\ttop: 36px;\n// \t\tbottom: 0;\n// \t\tright: 0;\n// \t\tleft: 0;\n// \t\tbackground-color: #f3f4f8;\n// \t\tbox-sizing: border-box;\n// \t\toverflow: hidden;\n// \t\tborder-left: 1px solid rgba(0, 0, 0, 0.05);\n// \t}\n// \t.popupbox {\n// \t\twidth: 100%;\n// \t\theight: 100%;\n// \t\tmax-width: 100% !important;\n// \t\tmax-height: 100% !important;\n// \t\tmargin: unset !important;\n// \t}\n\tdiv#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder{\n\t\theight: 100% !important;\n\t\tborder: unset !important;\n\t}\n\t.Layout.elemContainment {\n\t\tpadding: unset !important;\n\t}\n// \t.inner .page_content_wrapper.zc-page-content-wrapper {\n// \t\ttop: 40px !important;\n// \t\tbottom: 0 !important;\n// \t\twidth: 100% !important;\n// \t\tmargin: 0 !important;\n// \t}\n\t\n&lt;/style&gt;\n&lt;style&gt;\n/* Decision box(Search - cancel icon) */ .zc-pra-filter .form-group.zc-decisionbox-field-group { width: auto; height: 36px; position: absolute; right: 7px; top: 0px; z-index: 1; margin: 0px; } .zc-pra-filter .form-group .decision-box-field { display: none; } .zc-pra-filter .form-outer-wrapper .formColumn .zc-decisionbox-field-group .form-label.decision-box-label { height: 36px; font-size: 0px; line-height: 36px; padding: 0px; } .zc-pra-filter .form-label.decision-box-label:before { content: &apos;\\ed84&apos;; font-family: &apos;ZC Live Outline&apos;; font-size: 17px; } .zc-pra-filter .form-label.decision-box-label:hover:before { color: #EE3131; } .zc-pra-filter .form-group .cogLoader { margin: 11px 3px; }.zc-rtl-wrapper .zc-pra-filter .formColumn:not(.first-column) .form-group:not(:first-child) { margin-left: 0px; margin-right: 20px; } .zc-rtl-wrapper .zc-pra-filter .formContainer .formColumn.second-column { float: left; } /* Placeholder */ .zc-rtl-wrapper .zc-pra-filter .first-column .form-group label .zc-label-text:after { margin-left: 0px; margin-right: 18px; } .zc-rtl-wrapper .zc-pra-filter .form-group.zc-Search_Key-group .form-field:before, .zc-rtl-wrapper .zc-pra-filter .form-group.zc-Search-group .form-field:before { left: auto; right: 12px; } /* Decision box(Search - cancel icon) */ .zc-rtl-wrapper .zc-pra-filter .form-group.zc-decisionbox-field-group { right: auto; left: 7px; }.zc-pra-more-options { border: 1px solid; text-align: center; cursor: pointer; position: relative; } .zc-pra-more-options.zc-pra-square { width: 36px; height: 36px; background-color: #FFFFFF; border-color: #EBECF0; border-radius: 6px; color: #666D79; } .zc-pra-more-options.zc-pra-rounded { width: 30px; height: 30px; background-color: transparent; border-color: transparent; border-radius: 50%; color: #666D79; } .zc-pra-more-options .zc-pra-hover-extend { width: calc(160px / 2); height: 20px; position: absolute; z-index: 0; right: 0px; bottom: -7px; display: none; } .zc-pra-more-options .fa.fa-bars, .zc-pra-more-options .fa.fa-ellipsis-h, .zc-pra-more-options .ui-2-menu-dots { vertical-align: top; } .zc-pra-more-options .fa.fa-bars { line-height: 34px; } .zc-pra-more-options .fa.fa-ellipsis-h, .zc-pra-more-options .ui-2-menu-dots { line-height: 28px; } .zc-pra-more-options.zc-pra-square ul { top: 40px; } .zc-pra-more-options.zc-pra-rounded ul { top: 34px; } .zc-pra-more-options ul { width: 160px; background-color: #FFFFFF; box-shadow: 0 2px 9px 0 #d8d8d880; border: 1px solid #EBECF0; border-radius: 6px; padding: 8px; position: absolute; right: 0px; z-index: 2; display: none; } .zc-pra-more-options ul li { list-style-type: none; } .zc-pra-more-options ul li:not(:last-child) { margin-bottom: 4px; } .zc-pra-more-options ul li a { width: 100%; display: inline-block; vertical-align: top; font-size: 14px; font-weight: 400; line-height: 20px; color: #131635; text-align: left; padding: 8px; border-radius: 6px; } .zc-pra-more-options ul li a i, .zc-pra-more-options ul li a span { float: left; } .zc-pra-more-options ul li.zc-pra-color-red a i, .zc-pra-more-options ul li.zc-pra-color-red a span { color: #E71F43; } .zc-pra-more-options ul li a i { width: 14px; line-height: 20px; margin-right: 8px; } .zc-pra-more-options ul li a i+span { width: calc(100% - 22px); } .zc-pra-more-options.zc-pra-square:hover { border-color: var(--theme_brand_color); color: var(--theme_brand_color); } .zc-pra-more-options.zc-pra-rounded:hover { background-color: #EAECF0; color: #131635; } .zc-pra-more-options:hover&gt;.zc-pra-hover-extend, .zc-pra-more-options:hover ul { display: block; } .zc-pra-more-options ul li a:hover { background-color: var(--left_pane_section_selected); } .zc-pra-more-options ul li.zc-pra-color-red a:hover { background-color: #E71F431A; } .zc-pra-more-options i { font-style: normal; }.zc-rtl-wrapper .zc-pra-more-options .zc-pra-hover-extend, .zc-rtl-wrapper .zc-pra-more-options ul { right: auto; left: 0px; } .zc-rtl-wrapper .zc-pra-more-options ul li a { text-align: right; } .zc-rtl-wrapper .zc-pra-more-options ul li a i, .zc-rtl-wrapper .zc-pra-more-options ul li a span { float: right; } .zc-rtl-wrapper .zc-pra-more-options ul li a i { margin-right: 0px; margin-left: 8px; }.zc-pra-custom-detail-content { height: calc(100% - 68px); padding: 30px 0px; overflow-x: hidden; } .zc-pra-filter .select2-container.select2-allowclear .select2-choice abbr { display: none; } ul.zc-pra-zigzag-wrapper { width: 725px; position: relative; margin: 0px auto 20px; display: flex; justify-content: center; } ul.zc-pra-zigzag-wrapper:nth-child(odd) { justify-content: flex-start; } ul.zc-pra-zigzag-wrapper li.zc-pra-zigzag-li { display: flex; flex-direction: row; align-items: center; } ul.zc-pra-zigzag-wrapper li .zc-pra-card { width: 300px; box-shadow: 0 2px 9px 0 #d8d8d880; position: relative; z-index: 1; } .zc-pra-zcard-header { padding: 10px 16px; border-bottom: 1px solid #EBECF0; } .zc-pra-zcard-title { width: calc(100% - 30px); padding: 5px 0px; } .zc-pra-no-wrapper { width: 20px; height: 20px; border-radius: 4px; margin-right: 8px; background-color: var(--section_menu_active_bg_color); color: var(--theme_brand_color); font-size: 14px; font-weight: 500; line-height: 20px; text-align: center; } .zc-pra-zcard-title h6 { width: calc(100% - 28px); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .zc-pra-zcard-content { padding: 16px; } .zc-pra-zcard-content ul li { list-style-type: none; } .zc-pra-zcard-content ul li:not(:last-child) { margin-bottom: 8px; } .zc-pra-zcard-content label, .zc-pra-zcard-content span { font-size: 14px; line-height: 29px; display: inline-block; vertical-align: top; } .zc-pra-zcard-content label { width: 80px; font-weight: 400; color: #666D79; padding-right: 8px; } .zc-pra-zcard-badge { display: inline-block; vertical-align: top; } .zc-pra-zcard-content span { color: #131635; font-weight: 500; } .zc-pra-zcard-content span.zc-pra-currency-value { margin: 0px; } .zc-pra-zcard-badge span { background-color: var(--section_menu_active_bg_color); padding: 4px 8px; border-radius: 4px; line-height: 21px; } .zc-pra-zcard-content &gt; ul &gt; li &gt; span, .zc-pra-zcard-content &gt; ul &gt; li &gt; div { width: calc(100% - 80px); } .zc-pra-zcard-content span.zc-pra-color-green { color: #179E6C; } .zc-pra-zcard-content .zc-pra-img-wrapper { width: 30px; height: 30px; border-radius: 50%; margin: 6px 8px 6px 0px; } .zc-pra-zcard-content .zc-pra-img-wrapper img { width: 100%; height: 100%; border-radius: 50%; object-fit: contain; } .zc-pra-zcard-content .zc-pra-img-txt-wrapper { width: calc(100% - 38px); } .zc-pra-img-txt-wrapper span { line-height: 1.5; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .zc-pra-img-txt-wrapper span.zc-pra-sm-txt { font-size: 12px; color: #666D79; margin-top: 3px; } \n.zc-pra-fwh {\n\t\twidth: 100%;\n\t\theight: 100%;\n}\nul.zc-pra-zigzag-wrapper li .zc-pra-card{\n\toverflow: hidden;\n}\n.zc-pra-zcard-header{\n\tbackground: var(--theme_brand_color);\n}\n.zc-pra-page-container h6{\n\tcolor: #ffffff !important;\n}\n.zc-pra-more-options .ui-2-menu-dots{\n\t    color: #ffffff;\n}\n.zc-pra-more-options:hover .ui-2-menu-dots {\n\t\tcolor:  var(--theme_brand_color); \n}\n\n.zc-pra-nodata {\n\t\tposition: relative;\n\t\ttext-align: center;\n}\n.zc-pra-nodata-content {\n\t\tposition: absolute;\n\t\ttop: 50%;\n\t\tleft: 50%;\n\t\ttransform: translate(-50%, -50%);\n}\n.zc-pra-more-options ul li a:hover {\n\t\tbackground-color: #ebf0ff;\n}\n.zc_live_adminbar .zc-container-wrapper {\n\t\theight: 100%;\n\t}\n\t.zc-pra-nodata-btns {\n\t\tmargin-top: 24px;\n}\n.zc-pra-no-wrapper {\n\t\tbackground-color: var(--secondary_color) !important;\n}\n.zc-pra-zcard-badge span {\n\t background-color: var(--secondary_color) !important;\n\tcolor: var(--theme_brand_color) !important;\n}\n.zc-pra-page-content{\n\tpadding: unset !important;\n}\n\n&lt;/style&gt;\n&lt;%\n\tapprovalFlows = Add_Approval_Setup[Approval_Setup_For == input.recID &amp;&amp; (Status == null || Status == &quot;Active&quot;)] sort by Sequence_Order;\n\tflowsList = List();\n\tfor each  flow in approvalFlows\n\t{\n\t\tapproverRole = &quot;Not assigned&quot;;\n\t\tif(flow.Approver_Role != null){approverRole = flow.Approver_Role.Role;}\n\t\tflowsList.add({&quot;Level_Name&quot;:flow.Level_Name,&quot;Approver_Role&quot;:approverRole,&quot;Approver_Type&quot;:flow.Approver_Type,&quot;ID&quot;:flow.ID,&quot;Previous_Sequence_Number&quot;:flow.Sequence_Order,&quot;Is_Last_Step&quot;:flow.Is_Last_Step,&quot;Requester_Role_Param&quot;:flow.Added_User,&quot;users&quot;:flow.users});\n\t}\n\t%&gt;\n&lt;style&gt;\n/*trmp*/\n.zc-pra-setup .divEmbedContainer {\n\theight: calc(100% - 87px) !important;\n}\nul.zc-pra-horizontal-tabhead {\n\t\tdisplay: none !important;\n}\n\n.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper .zc-pb-page-content-wrapper {\n\tborder-radius:unset !important;\n}\n.zc-pra-card.zc-pra-horizontal-tabpanel {\n\theight: calc(100% - 70px) ;\n\tborder: unset !important;\n\t}\n\t.zc-pra-page-content, .zc-pra-custom-detail-content, .zc-pra-horizontal-tabbody{\n\t   height: 100% !important;\t\n\t}\n\t\n/*end*/\n&lt;%=thisapp.styles.CommonStyles()%&gt;\n&lt;%=thisapp.PageStyles.Custom_Approval_Template()%&gt;\n&lt;%=thisapp.PageStyles.Custom_Approval_Details()%&gt;\n\n&lt;/style&gt;\n&lt;div class=&apos;zc-pra-page-container zc-pra-system-detail&apos;&gt;\n\t&lt;div class=&apos;zc-pra-page-container-inner zc-pra-fwh&apos;&gt;\n\t\t&lt;div class=&apos;zc-pra-page-header zc-pra-clearfix zc-pra-fw&apos; style=&quot;padding: 10px !important; border-bottom: unset;&quot;&gt;\n\t\t\t&lt;div class=&apos;zc-pra-flt-left zc-pra-clearfix zc-pra-header-title&apos;&gt;\n\t\t\t\t&lt;a class=&apos;zc-pra-flt-left zc-pra-back-icon&apos; href=&apos;#Page:All_Approval_Setup?zc_LoadIn=embed-embedDiv&apos;&gt;\n\t\t\t\t\t&lt;span class=&apos;fa fa-angle-left&apos;&gt;&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;h5 class=&apos;zc-pra-flt-left&apos;&gt;Back&lt;/h5&gt;\n\t\t\t&lt;/div&gt;\n\n&lt;/div&gt;\n\t\t&lt;div class=&apos;zc-pra-page-content&apos;&gt;\n\t\t\t&lt;div class=&apos;zc-pra-card zc-pra-horizontal-tabpanel&apos;&gt;\n\t\t\t\t&lt;ul class=&apos;zc-pra-horizontal-tabhead&apos;&gt;\n\t\t\t\t\t&lt;li&gt; \n\t\t\t\t\t\t&lt;a href=&apos;#Page:Approval_Setup?recID=1&amp;module=Purchase-Request&apos; class=&apos;Purchase-Request&apos;&gt; Vendor Onboard Approval&lt;/a&gt; \n\t\t\t  \t\t&lt;/li&gt;\n\t\t\t\t\t&lt;li&gt;\n\t\t\t\t\t\t&lt;a href=&apos;#Page:Approval_Setup?recID=2&amp;module=Purchase-Order&apos; class=&apos;Purchase-Order&apos;&gt;Invoice Approval&lt;/a&gt; \n\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\n\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;div class=&apos;zc-pra-horizontal-tabbody&apos;&gt;\n\t\t\t\t\t&lt;!--&lt;div class=&apos;zc-pra-filter&apos; elName=&apos;zc-component&apos; formLinkName=&apos;Approval_Filter_Form&apos; params=&apos;&apos;&gt;&lt;/div&gt;--&gt;\n\t\t\t\t\t&lt;div class=&apos;zc-pra-custom-detail-content zc-pra-fwh &apos;&gt;\n&lt;%\n\tif(approvalFlows.count() &gt; 0)\n\t{\n\t\ti = 0;\n\t\tcounter = 1;\n\t\tfor each  item in flowsList\n\t\t{\n\t\t\tif(counter.isOdd())\n\t\t\t{\n\t\t\t\tif(counter &gt; 1)\n\t\t\t\t{\n\t\t\t\t\ti = i + 1;\n\t\t\t\t}\n\t\t\t\tsecondLiIndex = i + 1;\n\t\t\t\tif(i &lt; flowsList.size())\n\t\t\t\t{\n\t\t\t\t\t%&gt;\n&lt;ul class=&apos;zc-pra-zigzag-wrapper&apos;&gt;\n\t\n\t\t\t\t\t\t\t&lt;%=thisapp.Components.ApprovalCard({&quot;ID&quot;:flowsList.get(i).get(&quot;ID&quot;),&quot;Sequence_Order&quot;:i + 1,&quot;Level_name&quot;:flowsList.get(i).get(&apos;Level_Name&apos;),&quot;Approval_For_Role&quot;:flowsList.get(i).get(&quot;Approval_For_Role&quot;),&quot;Approver_Type&quot;:flowsList.get(i).get(&apos;Approver_Type&apos;),&quot;Approver_Role&quot;:flowsList.get(i).get(&quot;Approver_Role&quot;),&quot;Previous_Sequence_Number&quot;:flowsList.get(i).get(&quot;Previous_Sequence_Number&quot;),&quot;Show_Add_Before&quot;:if(counter == 1,true,false),&quot;Type_field&quot;:input.recID,&quot;Template_ID&quot;:input.recID,&quot;Approver_User&quot;:flowsList.get(i).get(&apos;Approver_User&apos;),&quot;Is_Preview&quot;:false,&quot;Price_From&quot;:flowsList.get(i).get(&quot;Price_From&quot;),&quot;Price_To&quot;:flowsList.get(i).get(&quot;Price_To&quot;),&quot;Is_Last_Step&quot;:flowsList.get(i).get(&quot;Is_Last_Step&quot;),&quot;Requester_Role_Param&quot;:flowsList.get(i).get(&quot;Requester_Role_Param&quot;),&quot;users&quot;:flowsList.get(i).get(&quot;users&quot;)})%&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t\tif(secondLiIndex &lt; flowsList.size())\n\t\t\t\t{\n\t\t\t\t\t%&gt;\n&lt;%=thisapp.Components.ApprovalCard({&quot;ID&quot;:flowsList.get(secondLiIndex).get(&quot;ID&quot;),&quot;Sequence_Order&quot;:secondLiIndex + 1,&quot;Level_name&quot;:flowsList.get(secondLiIndex).get(&apos;Level_Name&apos;),&quot;Approval_For_Role&quot;:flowsList.get(secondLiIndex).get(&quot;Approval_For_Role&quot;),&quot;Approver_Type&quot;:flowsList.get(secondLiIndex).get(&apos;Approver_Type&apos;),&quot;Approver_Role&quot;:flowsList.get(secondLiIndex).get(&quot;Approver_Role&quot;),&quot;Previous_Sequence_Number&quot;:flowsList.get(secondLiIndex).get(&quot;Previous_Sequence_Number&quot;),&quot;Show_Add_Before&quot;:false,&quot;Type_field&quot;:input.recID,&quot;Template_ID&quot;:input.recID,&quot;Approver_User&quot;:flowsList.get(secondLiIndex).get(&apos;Approver_User&apos;),&quot;Is_Preview&quot;:false,&quot;Price_From&quot;:flowsList.get(secondLiIndex).get(&quot;Price_From&quot;),&quot;Price_To&quot;:flowsList.get(secondLiIndex).get(&quot;Price_To&quot;),&quot;Is_Last_Step&quot;:flowsList.get(secondLiIndex).get(&quot;Is_Last_Step&quot;),&quot;Requester_Role_Param&quot;:flowsList.get(secondLiIndex).get(&quot;Requester_Role_Param&quot;),&quot;users&quot;:flowsList.get(secondLiIndex).get(&quot;users&quot;)})%&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;/ul&gt;\n&lt;%\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tsingleIndex = i + 1;\n\t\t\t\tif(singleIndex &lt; flowsList.size())\n\t\t\t\t{\n\t\t\t\t\t%&gt;\n&lt;ul class=&apos;zc-pra-zigzag-wrapper&apos;&gt;\n&lt;%=thisapp.Components.ApprovalCard({&quot;ID&quot;:flowsList.get(singleIndex).get(&quot;ID&quot;),&quot;Sequence_Order&quot;:singleIndex + 1,&quot;Level_name&quot;:flowsList.get(singleIndex).get(&apos;Level_Name&apos;),&quot;Approval_For_Role&quot;:flowsList.get(singleIndex).get(&quot;Approval_For_Role&quot;),&quot;Approver_Type&quot;:flowsList.get(singleIndex).get(&apos;Approver_Type&apos;),&quot;Approver_Role&quot;:flowsList.get(singleIndex).get(&quot;Approver_Role&quot;),&quot;Previous_Sequence_Number&quot;:flowsList.get(singleIndex).get(&quot;Previous_Sequence_Number&quot;),&quot;Show_Add_Before&quot;:false,&quot;Type_field&quot;:input.recID,&quot;Template_ID&quot;:input.recID,&quot;Approver_User&quot;:flowsList.get(singleIndex).get(&apos;Approver_User&apos;),&quot;Is_Preview&quot;:false,&quot;Price_From&quot;:flowsList.get(singleIndex).get(&quot;Price_From&quot;),&quot;Price_To&quot;:flowsList.get(singleIndex).get(&quot;Price_To&quot;),&quot;Is_Last_Step&quot;:flowsList.get(singleIndex).get(&quot;Is_Last_Step&quot;),&quot;Requester_Role_Param&quot;:flowsList.get(singleIndex).get(&quot;Requester_Role_Param&quot;),&quot;users&quot;:flowsList.get(singleIndex).get(&quot;users&quot;)})%&gt;\n\t\t\t\t\t\t&lt;/ul&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\ti = i + 1;\n\t\t\tcounter = counter + 1;\n\t\t}\n\t}\n\telse\n\t{\n\t\timg_src = &quot;&quot;;\n\t\tlastRec = Add_Approval_Setup[Approval_Setup_For == input.recID] sort by Sequence_Order desc range from 0 to 0;\n\t\tif(lastRec.count() &gt; 0)\n\t\t{\n\t\t\tpreviousSequenceNumber = lastRec.Sequence_Order;\n\t\t}\n\t\telse\n\t\t{\n\t\t\tpreviousSequenceNumber = 0;\n\t\t}\n\t\t%&gt;\n&lt;div class=&apos;zc-pra-nodata zc-pra-fwh&apos;&gt;\n\t\t&lt;div class=&apos;zc-pra-nodata-content&apos;&gt;\n\t\t\t\t&lt;img alt=&quot;No Data&quot; src=&quot;data:image/svg+xml;base64,&quot;&gt;\n\t\t\t\t&lt;h6&gt; No Data &lt;/h6&gt;\n\t\t\t\t&lt;div class=&apos;zc-pra-nodata-btns&apos;&gt;\n\t\t\t\t &lt;a class=&apos;zc-live-primary-btn&apos; href=&apos;#Form:Add_Approval_Setup?Add_Type=Specific&amp;zc_LoadIn=dialog&amp;Type_field=&lt;%=input.recID%&gt;&amp;Sequence_Order=0&amp;Sequence_Order_Display=0&amp;Previous_Sequence_Number=0&apos;&gt; Add Step &lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Confirmation_Page(string message, string nextLabel, string nextUrl, string title)
		{
					displayname = "Confirmation Page"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet8' elementName='HTML Snippet' bgColor='transparent'>\n\t\t\t\t\t<![CDATA[htmlpage html_snippet8()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tsuccessTitle = ifnull(input.title,&quot;&quot;).trim();\n\tif(successTitle == &quot;&quot;)\n\t{\n\t\tsuccessTitle = &quot;Operation completed&quot;;\n\t}\n\tsuccessMessage = ifnull(input.message,&quot;&quot;).trim();\n\tif(successMessage == &quot;&quot;)\n\t{\n\t\tsuccessMessage = &quot;Your operation was completed successfully.&quot;;\n\t}\n\tactionLabel = ifnull(input.nextLabel,&quot;&quot;).trim();\n\tif(actionLabel == &quot;&quot;)\n\t{\n\t\tactionLabel = &quot;Continue&quot;;\n\t}\n\tactionUrl = ifnull(input.nextUrl,&quot;&quot;).trim();\n%&gt;\n&lt;style&gt;\n/* ZCS global utilities used by this page, from zcs-global. */\n:root{--zcs-page-bg-color:#f3f3f4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}\n*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-w-full{width:100%}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-20{margin-top:1.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-box-border{box-sizing:border-box}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-text-center{text-align:center}a{text-decoration:none}\n/* ZCS component CSS: button-primary-button-no-icon. */\n.zcs-button{width:auto;min-width:7rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-button:active,.zcs-primary-button:focus{background-color:var(--zcs_component_hover_color);outline:2px solid var(--zcs_brand_color);outline-offset:2px}\n/* Adapted ZCS no-data-no-data-with-button structure for a compact confirmation state. */\nhtml,body,div#zppagesLive,div#elementsContainer,.Layout.elemContainment,.zcpage-elemContainer,.zc-pb-formreport-placeholder,.zc-pb-page-content-wrapper,.zc-pb-tile-container,.zc-pb-tile-card{width:100%!important;min-height:100%!important;margin:0!important}.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zc-pb-tile-container,.zc-pb-page-content-wrapper .zc-pb-tile-card{padding:0!important;border-radius:0!important}.zc-pb-page-content-wrapper .zc-pb-tile-card{border:0!important;box-shadow:none!important}#splash-screen{display:none!important}\n.confirmation-page{min-height:100vh;padding:clamp(16px,5vw,40px);background:var(--zcs-page-bg-color);font-family:Arial,sans-serif}.confirmation-card{width:min(100%,460px);padding:clamp(24px,5vw,32px);background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px;box-shadow:0 8px 24px rgba(30,35,60,.06)}.confirmation-icon{width:56px;height:56px;margin:0 auto;border-radius:50%;background:#e8f7f1;color:#179e6c;font-size:30px}.confirmation-message{max-width:360px;margin-left:auto;margin-right:auto}.zcs-nodata-btn-wrapper{width:100%}@media(max-width:520px){.confirmation-page{padding:12px}.confirmation-card{padding:24px 20px}.zcs-button{width:100%}}\n&lt;/style&gt;\n&lt;div class=&apos;confirmation-page zcs-nodata-wrapper zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t&lt;main class=&apos;confirmation-card zcs-nodata-content zcs-box-border&apos; aria-labelledby=&apos;confirmation-title&apos;&gt;\n\t\t&lt;div class=&apos;confirmation-icon zcs-flex zcs-align-items-center zcs-justify-center&apos; aria-hidden=&apos;true&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;h1 id=&apos;confirmation-title&apos; class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-20 zcs-mx-0 zcs-mb-0&apos;&gt;&lt;%=successTitle%&gt;&lt;/h1&gt;\n\t\t&lt;p class=&apos;confirmation-message zcs-nodata-desc zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-mt-12 zcs-mb-0&apos;&gt;&lt;%=successMessage%&gt;&lt;/p&gt;\n&lt;%\n\tif(actionUrl != &quot;&quot;)\n\t{\n%&gt;\n\t\t&lt;div class=&apos;zcs-nodata-btn-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-mt-20&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=actionUrl%&gt;&apos;&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;&lt;%=actionLabel%&gt;&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t&lt;/main&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Detail_View_Page(int recID, string reportName)
		{
					displayname = "Record Preview"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Detail_View_Snippet' elementName='Detail View Snippet' bgColor='transparent'>\n\t\t\t\t\t<![CDATA[htmlpage Detail_View_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\trequestedReport = ifnull(input.reportName,&quot;&quot;);\n\tallowedReports = {&quot;Create_Template_Report&quot;};\n\tvalidTarget = allowedReports.contains(requestedReport);\n\tvalidRecord = input.recID != null &amp;&amp; input.recID &gt; 0;\n\theading = &quot;Mail template details&quot;;\n%&gt;\n&lt;style&gt;\n\t/* ZCS global theme tokens and utilities used by this single-snippet page. */\n\t:root {\n\t\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t\t--zcs-light-bg-color: var(--zcs_brand_light_color);\n\t\t--zcs-page-bg-color: #f5f6f8;\n\t\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t\t--zcs-border-color: var(--zcs_tertiary_border_color);\n\t\t--zcs-white-color: #ffffff;\n\t\tfont-size: 16px;\n\t\tline-height: 1.5;\n\t}\n\t* { box-sizing: border-box; }\n\t.zcs-flex { display: flex; }\n\t.zcs-inline-flex { display: inline-flex; }\n\t.zcs-direction-column { flex-direction: column; }\n\t.zcs-align-items-center { align-items: center; }\n\t.zcs-justify-center { justify-content: center; }\n\t.zcs-justify-space-between { justify-content: space-between; }\n\t.zcs-gap-4 { gap: .25rem; }\n\t.zcs-gap-8 { gap: .5rem; }\n\t.zcs-gap-12 { gap: .75rem; }\n\t.zcs-w-full { width: 100%; }\n\t.zcs-wh-full { width: 100%; height: 100%; }\n\t.zcs-p-20 { padding: 1.25rem; }\n\t.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n\t.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }\n\t.zcs-m-0 { margin: 0; }\n\t.zcs-mt-6 { margin-top: .375rem; }\n\t.zcs-mt-10 { margin-top: .625rem; }\n\t.zcs-rounded-md { border-radius: .375rem; }\n\t.zcs-rounded-lg { border-radius: .5rem; }\n\t.zcs-rounded-half { border-radius: 50%; }\n\t.zcs-font-12 { font-size: .75rem; }\n\t.zcs-font-14 { font-size: .875rem; }\n\t.zcs-font-18 { font-size: 1.125rem; }\n\t.zcs-font-20 { font-size: 1.25rem; }\n\t.zcs-font-normal { font-weight: 400; }\n\t.zcs-font-medium { font-weight: 500; }\n\t.zcs-font-semibold { font-weight: 600; }\n\t.zcs-lh-body { line-height: 1.5; }\n\t.zcs-lh-heading { line-height: 1.25; }\n\t.zcs-color-primary { color: var(--zcs-primary-text-color); }\n\t.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n\t.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n\t.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n\t.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\t.zcs-text-center { text-align: center; }\n\t.zcs-overflow-hidden { overflow: hidden; }\n\t.zcs-box-border { box-sizing: border-box; }\n\t.zcs-card { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 8px; }\n\n\t.zc-pb-page-content-wrapper div#zppagesLive,\n\t.zc-pb-page-content-wrapper div#elementsContainer,\n\t.zc-pb-page-content-wrapper .elemContainment,\n\t.zc-pb-page-content-wrapper .zcpage-elemContainer,\n\t.Layout.elemContainment,\n\t.column-container .zc-pb-tile-container {\n\t\twidth: 100% !important;\n\t\theight: 100% !important;\n\t}\n\t.zc-container-wrapper .zc-main-content .inner .zc-page-content-wrapper .zc-pb-page-content-wrapper .elemContainment,\n\t.zc-full-height .zc-page-content-wrapper .zc-pb-page-content-wrapper .elemContainment,\n\t.zc-pb-page-content-wrapper .zc-pb-tile-container,\n\t.column-container .zc-pb-tile-container,\n\t.Layout.elemContainment { padding: 0 !important; }\n\t.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card {\n\t\tborder-radius: 0 !important;\n\t\tbox-shadow: none !important;\n\t}\n\t#splash-screen { display: none !important; }\n\n\t.detail-page {\n\t\twidth: 100%;\n\t\theight: 100vh;\n\t\tmin-height: 360px;\n\t\tpadding: 12px;\n\t\tbackground: var(--zcs-page-bg-color);\n\t}\n\t.detail-shell {\n\t\twidth: min(100%, 1180px);\n\t\theight: 100%;\n\t\tmin-height: 0;\n\t\tmargin: 0 auto;\n\t}\n\t.zcs-page-header {\n\t\tflex: 0 0 auto;\n\t\tmin-height: 56px;\n\t\tborder-bottom: 1px solid var(--zcs-border-color);\n\t}\n\t.header-main { min-width: 0; }\n\t.zcs-back {\n\t\twidth: 32px;\n\t\theight: 32px;\n\t\tflex: 0 0 32px;\n\t\tcolor: var(--zcs-teritiary-text-color);\n\t\tbackground: var(--zcs-light-bg-color);\n\t\ttext-decoration: none;\n\t}\n\t.zcs-back:hover { color: var(--zcs-primary-text-color); }\n\t.detail-title { min-width: 0; }\n\t.detail-status {\n\t\tflex: 0 0 auto;\n\t\tpadding: 3px 8px;\n\t\tcolor: var(--zcs-theme-brand-color);\n\t\tbackground: var(--zcs-light-bg-color);\n\t}\n\t.detail-content {\n\t\tmin-height: 0;\n\t\tflex: 1 1 auto;\n\t\tpadding: 8px;\n\t\tbackground: var(--zcs-page-bg-color);\n\t}\n\t.detail-frame-wrap {\n\t\twidth: 100%;\n\t\theight: 100%;\n\t\tmin-height: 280px;\n\t\toverflow: hidden;\n\t\tbackground: var(--zcs-white-color);\n\t\tborder: 1px solid var(--zcs-border-color);\n\t\tborder-radius: 6px;\n\t}\n\t.detail-frame {\n\t\tdisplay: block;\n\t\twidth: 100%;\n\t\theight: 100%;\n\t\tborder: 0;\n\t\tbackground: var(--zcs-white-color);\n\t}\n\t.detail-state {\n\t\twidth: 100%;\n\t\theight: 100%;\n\t\tmin-height: 280px;\n\t\tbackground: var(--zcs-white-color);\n\t}\n\t.detail-state-content { width: min(100%, 430px); }\n\t.detail-state-icon {\n\t\twidth: 44px;\n\t\theight: 44px;\n\t\tmargin: 0 auto;\n\t\tcolor: var(--zcs-theme-brand-color);\n\t\tbackground: var(--zcs-light-bg-color);\n\t}\n\t@media (max-width: 576px) {\n\t\t.detail-page { padding: 0; min-height: 320px; }\n\t\t.detail-shell { border: 0; border-radius: 0; }\n\t\t.zcs-page-header { padding: 10px 12px; }\n\t\t.detail-content { padding: 0; }\n\t\t.detail-frame-wrap { border-width: 0; border-radius: 0; }\n\t\t.detail-status { display: none; }\n\t}\n\t.zc-rtl-wrapper .zcs-back-icon { rotate: 180deg; }\n&lt;/style&gt;\n\n&lt;main class=&apos;detail-page zcs-box-border&apos;&gt;\n\t&lt;section class=&apos;detail-shell zcs-card zcs-flex zcs-direction-column zcs-overflow-hidden&apos;&gt;\n\t\t&lt;header class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-16 zcs-py-12 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;header-main zcs-flex zcs-align-items-center zcs-gap-12 zcs-ellipsis&apos;&gt;\n\t\t\t\t&lt;a href=&apos;#Script:page.parent.back&apos; class=&apos;zcs-back zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-md&apos; aria-label=&apos;Go back&apos; title=&apos;Go back&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zcs-back-icon zcs-font-20 zc-li-outline arrows-1-tail-left&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;div class=&apos;detail-title zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&apos;&gt;\n\t\t\t\t\t&lt;span class=&apos;zcs-font-12 zcs-font-medium zcs-lh-body zcs-color-tertiary&apos;&gt;Record preview&lt;/span&gt;\n\t\t\t\t\t&lt;h1 class=&apos;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;&lt;%=heading%&gt;&lt;/h1&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\tif(validTarget &amp;&amp; validRecord)\n\t{\n%&gt;\n\t\t\t&lt;span class=&apos;detail-status zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-md zcs-font-12 zcs-font-semibold&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;\n\t\t\t\tApproved preview\n\t\t\t&lt;/span&gt;\n&lt;%\n\t}\n%&gt;\n\t\t&lt;/header&gt;\n\t\t&lt;div class=&apos;detail-content zcs-flex zcs-direction-column zcs-box-border&apos;&gt;\n&lt;%\n\tif(validTarget &amp;&amp; validRecord)\n\t{\n\t\tsummaryUrl = zoho.appuri + &quot;record-summary/Create_Template_Report/&quot; + input.recID + &quot;/&quot;;\n%&gt;\n\t\t\t&lt;div class=&apos;detail-frame-wrap&apos;&gt;\n\t\t\t\t&lt;iframe class=&apos;detail-frame&apos; src=&apos;&lt;%=summaryUrl%&gt;&apos; title=&apos;&lt;%=heading%&gt;&apos;&gt;&lt;/iframe&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tstateHeading = &quot;Invalid record reference&quot;;\n\t\tstateMessage = &quot;A valid record ID is required to open this approved preview.&quot;;\n\t\tif(!validTarget)\n\t\t{\n\t\t\tstateHeading = &quot;Unsupported preview target&quot;;\n\t\t\tstateMessage = &quot;This utility can only open the approved mail template report.&quot;;\n\t\t}\n%&gt;\n\t\t\t&lt;div class=&apos;detail-state zcs-card zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t\t&lt;div class=&apos;detail-state-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;span class=&apos;detail-state-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-circle-remove zcs-font-20&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/span&gt;\n\t\t\t\t\t&lt;h2 class=&apos;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-m-0&apos;&gt;&lt;%=stateHeading%&gt;&lt;/h2&gt;\n\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-mt-6 zcs-m-0&apos;&gt;&lt;%=stateMessage%&gt;&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t\t&lt;/div&gt;\n\t&lt;/section&gt;\n&lt;/main&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page History(int Sales_Order_ID)
		{
					displayname = "History"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='History_Timeline' elementName='History_Timeline'>\n\t\t\t\t\t<![CDATA[htmlpage History_Timeline()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nhistories = Add_History[Sales_Order_Lookup == input.Sales_Order_ID] sort by Updated_Date_Time desc;\norderRec = Create_Sales_Order[ID == input.Sales_Order_ID];\norderFound = orderRec.count() &gt; 0;\norderNumber = input.Sales_Order_ID;\norderCustomer = &quot;Customer not recorded&quot;;\norderDate = &quot;Date not recorded&quot;;\norderStatus = &quot;Status not recorded&quot;;\nif(orderFound)\n{\n\t\torderNumber = ifnull(orderRec.Sales_Order_ID,input.Sales_Order_ID);\n\t\tif(orderRec.Customer != null)\n\t\t{\n\t\t\t\torderCustomer = ifnull(orderRec.Customer.Customer_Name,&quot;Customer not recorded&quot;);\n\t\t}\n\t\torderDate = ifnull(orderRec.Sales_Order_Date,&quot;Date not recorded&quot;);\n\t\torderStatus = ifnull(orderRec.Status,&quot;Status not recorded&quot;);\n}\n%&gt;\n&lt;style&gt;\n/* zcs-global: utility subset used by this single page snippet */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color,#6147E5);--zcs-light-bg-color:var(--zcs_brand_light_color,#F1EDFF);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color,#1C1C40);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#65657A);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color,#878895);--zcs-border-color:var(--zcs_tertiary_border_color,#E7E7EE);--zcs-white-color:#FFF}*{box-sizing:border-box}#splash-screen{display:none!important}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-row-wrap{flex-wrap:wrap}.zcs-gap-4{gap:4px}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-p-0{padding:0}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-m-0{margin:0}.zcs-wh-full{width:100%;height:100%}.zcs-relative{position:relative}.zcs-rounded-sm{border-radius:4px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-text-center{text-align:center}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}\n/* timeline-timeline-advanced */\n.zcs-timeline-wrapper{min-width:0}.zcs-tl-li{display:grid;grid-template-columns:132px 32px minmax(0,1fr);align-items:start}.zcs-tl-time{text-align:right;padding-top:3px;line-height:1.4}.zcs-tl-indicator{display:flex;justify-content:center;min-height:100%}.zcs-tl-dot{width:12px;height:12px;margin-top:4px;border-radius:50%;background:var(--event-color);border:3px solid #fff;box-shadow:0 0 0 3px var(--event-soft);position:relative;z-index:1}.timeline-list{list-style:none;background:linear-gradient(var(--zcs-border-color),var(--zcs-border-color)) 147px 0/1px 100% no-repeat}\n/* badge-badge-with-icon */\n.zcs-badge{width:auto;white-space:nowrap;border:1px solid}.zcs-badge-theme{background:var(--zcs_component_hover_color,#F1EDFF);border-color:var(--zcs_brand_color,#6147E5);color:var(--zcs_brand_color,#6147E5)}.zcs-badge-green{background:#E4FCF3;border-color:#179E6C;color:#147A55}.zcs-badge-red{background:#FDE3E6;border-color:#FE455D;color:#C6243A}.zcs-badge-blue{background:#E8EFFF;border-color:#2A6FFC;color:#245CC4}.zcs-badge-orange{background:#F8F0EB;border-color:#F4660C;color:#B94C08}\n.history-page{height:100%;min-height:620px;overflow:hidden;background:var(--zcs-page-bg-color);padding:14px;font:14px/1.5 Arial,sans-serif;color:var(--zcs-primary-text-color)}.history-header{padding:14px 18px;background:#fff;border:1px solid var(--zcs-border-color);border-radius:12px}.heading-icon{width:36px;height:36px;border-radius:9px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);font-size:18px;flex:0 0 auto}.title-line h1{font-size:20px;margin:0}.title-line p{margin:1px 0 0;color:var(--zcs-secondary-text-color);font-size:12px}.event-count{padding:6px 10px;border-radius:7px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);font-weight:600;white-space:nowrap}.order-context{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:12px}.context-item{padding:7px 10px;border-radius:7px;background:#F9FAFE;min-width:0}.context-item label,.detail-label,.status-block label{display:block;color:var(--zcs-teritiary-text-color);font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.04em}.context-item strong{display:block;margin-top:1px;overflow-wrap:anywhere;font-size:13px}.history-shell{height:470px;margin-top:12px;overflow:hidden}.section-head{height:52px;padding:10px 16px;border-bottom:1px solid var(--zcs-border-color)}.section-head h2{font-size:16px;margin:0}.section-head p{font-size:11px;margin:0;color:var(--zcs-secondary-text-color)}.history-scroll{height:calc(100% - 52px);overflow:auto;padding:16px 18px 20px;scrollbar-gutter:stable}.event-card{padding:13px 14px;background:#fff;border:1px solid var(--zcs-border-color);border-radius:9px;box-shadow:0 2px 8px rgba(35,38,70,.04);min-width:0}.event-title{overflow-wrap:anywhere}.actor{margin-top:5px;color:var(--zcs-secondary-text-color);font-size:12px}.actor i{color:var(--event-color)}.status-flow{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:9px;padding:8px 10px;border-radius:7px;background:#F9FAFE}.status-block strong{font-size:12px}.status-arrow{color:var(--zcs-teritiary-text-color)}.detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:9px}.detail-block{padding:9px 10px;background:#FAFAFE;border:1px solid var(--zcs-border-color);border-radius:7px;white-space:pre-wrap;overflow-wrap:anywhere;font-size:13px}.related-links{margin-top:9px;padding-top:9px;border-top:1px solid var(--zcs-border-color)}.related-label{width:100%;color:var(--zcs-teritiary-text-color);font-size:10px;font-weight:600;text-transform:uppercase}.related-link{display:inline-flex;align-items:center;gap:5px;padding:4px 8px;border:1px solid var(--zcs-border-color);border-radius:6px;color:var(--zcs-theme-brand-color);font-size:11px;font-weight:600;text-decoration:none;background:#fff}.related-link:hover{background:var(--zcs-light-bg-color)}.zcs-nodata-wrapper{height:calc(100% - 52px);min-height:280px}.empty-icon{width:46px;height:46px;margin:auto;border-radius:12px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color)}.zcs-nodata-header{margin:10px 0 0}.zcs-nodata-desc{max-width:400px;margin:5px auto 0;color:var(--zcs-secondary-text-color)}\n@media(max-width:768px){.history-page{min-height:690px;padding:10px}.history-header{padding:12px}.title-line{align-items:flex-start;flex-direction:column}.title-copy{align-items:flex-start}.order-context{grid-template-columns:repeat(2,minmax(0,1fr))}.history-shell{height:500px}.history-scroll{padding:14px 10px}.timeline-list{background-position:5px 0}.zcs-tl-li{grid-template-columns:22px minmax(0,1fr);grid-template-areas:&apos;dot time&apos; &apos;dot card&apos;;row-gap:5px}.zcs-tl-time{grid-area:time;text-align:left;padding:0}.zcs-tl-indicator{grid-area:dot;justify-content:flex-start}.event-card{grid-area:card;padding:11px}.event-top{align-items:flex-start;flex-direction:column}.detail-grid{grid-template-columns:1fr}.section-head p{display:none}}\n@media(max-width:420px){.order-context{grid-template-columns:1fr}.history-shell{height:515px}.heading-icon{display:none}}\n&lt;/style&gt;\n&lt;div class=&apos;history-page&apos;&gt;\n\t&lt;header class=&apos;history-header&apos;&gt;\n\t\t&lt;div class=&apos;title-line zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t&lt;div class=&apos;title-copy zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;&lt;span class=&apos;heading-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-2-time&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h1&gt;Sales order activity&lt;/h1&gt;&lt;p&gt;Newest activity first&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;event-count zcs-inline-flex zcs-align-items-center zcs-gap-6&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=histories.count()%&gt; events&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;order-context zcs-labelvalue-wrapper zcs-labelvalue-with-bg&apos;&gt;\n\t\t\t&lt;div class=&apos;context-item&apos;&gt;&lt;label&gt;Sales order&lt;/label&gt;&lt;strong&gt;&lt;%=orderNumber%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;context-item&apos;&gt;&lt;label&gt;Customer&lt;/label&gt;&lt;strong&gt;&lt;%=orderCustomer%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;context-item&apos;&gt;&lt;label&gt;Order date&lt;/label&gt;&lt;strong&gt;&lt;%=orderDate%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;context-item&apos;&gt;&lt;label&gt;Current status&lt;/label&gt;&lt;strong&gt;&lt;%=orderStatus%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/header&gt;\n\t&lt;section class=&apos;history-shell zcs-card&apos;&gt;\n\t\t&lt;div class=&apos;section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div&gt;&lt;h2&gt;Activity timeline&lt;/h2&gt;&lt;p&gt;Timestamp, actor, notes, transitions, and related records&lt;/p&gt;&lt;/div&gt;&lt;i class=&apos;zc-li-outline arrows-2-time zcs-font-20 zcs-color-tertiary&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t&lt;%if(histories.count() == 0){%&gt;\n\t\t\t&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;div class=&apos;empty-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-2-time zcs-font-20&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-color-primary&apos;&gt;No activity recorded&lt;/h5&gt;&lt;p class=&apos;zcs-nodata-desc zcs-font-14&apos;&gt;Events will appear here when this sales order is created, updated, or progresses through its workflow.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;%}else{%&gt;\n\t\t\t&lt;div class=&apos;zcs-timeline-wrapper history-scroll&apos;&gt;&lt;ul class=&apos;timeline-list zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t&lt;%for each hist in histories{\n\t\t\t\tactionType = ifnull(hist.Action_Type,&quot;Activity recorded&quot;);\n\t\t\t\teventStatus = ifnull(hist.Status,&quot;Activity&quot;);\n\t\t\t\teventTime = ifnull(hist.Updated_Date_Time,&quot;Time not recorded&quot;);\n\t\t\t\tbadgeClass = &quot;zcs-badge-theme&quot;; eventColor = &quot;#6147E5&quot;; eventSoft = &quot;#F1EDFF&quot;; eventIcon = &quot;business-notes&quot;;\n\t\t\t\tif(actionType == &quot;Record Created&quot; || actionType == &quot;Products Received&quot; || actionType == &quot;Delivery Confirmed&quot; || actionType == &quot;Customer Approval Recorded&quot; || actionType == &quot;Purchase Order Approved&quot;){badgeClass = &quot;zcs-badge-green&quot;;eventColor = &quot;#179E6C&quot;;eventSoft = &quot;#E4FCF3&quot;;eventIcon = &quot;ui-1-check-circle-08&quot;;}\n\t\t\t\telse if(actionType == &quot;Lead Marked Lost&quot;){badgeClass = &quot;zcs-badge-red&quot;;eventColor = &quot;#FE455D&quot;;eventSoft = &quot;#FDE3E6&quot;;eventIcon = &quot;ui-1-circle-remove&quot;;}\n\t\t\t\telse if(actionType == &quot;Subform Updated&quot; || actionType == &quot;Status Changed&quot;){badgeClass = &quot;zcs-badge-blue&quot;;eventColor = &quot;#2A6FFC&quot;;eventSoft = &quot;#E8EFFF&quot;;eventIcon = &quot;arrows-2-time&quot;;}\n\t\t\t\telse if(actionType.contains(&quot;Created&quot;)){badgeClass = &quot;zcs-badge-orange&quot;;eventColor = &quot;#F4660C&quot;;eventSoft = &quot;#F8F0EB&quot;;eventIcon = &quot;files-single&quot;;}\n\t\t\t\tactorName = ifnull(hist.Updated_By_Email,&quot;System workflow&quot;);\n\t\t\t\tif(hist.Updated_By != null){actorName = ifnull(hist.Updated_By.Employee_Name,actorName);}\n\t\t\t\tif(actorName == &quot;&quot;){actorName = &quot;System workflow&quot;;}\n\t\t\t\thasRelated = hist.Lead_Lookup != null || hist.Sales_Order_Lookup != null || hist.Supplier_Quote_Lookup != null || hist.Purchase_Order_Lookup != null || hist.Supplier_Invoice_Lookup != null || hist.Logistics_Booking_Lookup != null || hist.Return_Request_Lookup != null;\n\t\t\t%&gt;\n\t\t\t\t&lt;li class=&apos;zcs-tl-li zcs-relative&apos; style=&apos;--event-color:&lt;%=eventColor%&gt;;--event-soft:&lt;%=eventSoft%&gt;&apos;&gt;\n\t\t\t\t\t&lt;time class=&apos;zcs-tl-time zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;%=eventTime%&gt;&lt;/time&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-tl-indicator&apos;&gt;&lt;span class=&apos;zcs-tl-dot&apos;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;article class=&apos;event-card&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;event-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;h3 class=&apos;event-title zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-m-0&apos;&gt;&lt;%=actionType%&gt;&lt;/h3&gt;&lt;span class=&apos;zcs-badge zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-4 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12 &lt;%=badgeClass%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=eventIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=eventStatus%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;actor zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-4&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-29&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=actorName%&gt;&lt;/span&gt;&lt;%if(hist.Updated_By_Email != null &amp;&amp; hist.Updated_By_Email != &quot;&quot; &amp;&amp; actorName != hist.Updated_By_Email){%&gt;&lt;span&gt;| &lt;%=hist.Updated_By_Email%&gt;&lt;/span&gt;&lt;%}%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;%if(hist.Previous_Status != null || hist.New_Status != null){%&gt;&lt;div class=&apos;status-flow&apos;&gt;&lt;div class=&apos;status-block&apos;&gt;&lt;label&gt;Previous&lt;/label&gt;&lt;strong&gt;&lt;%=ifnull(hist.Previous_Status,&quot;Not recorded&quot;)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;i class=&apos;status-arrow zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;div class=&apos;status-block&apos;&gt;&lt;label&gt;New&lt;/label&gt;&lt;strong&gt;&lt;%=ifnull(hist.New_Status,eventStatus)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}%&gt;\n\t\t\t\t\t\t&lt;%if((hist.Comments != null &amp;&amp; hist.Comments != &quot;&quot;) || (hist.Subform_Details_Change_Summary != null &amp;&amp; hist.Subform_Details_Change_Summary != &quot;&quot;)){%&gt;&lt;div class=&apos;detail-grid&apos;&gt;&lt;%if(hist.Comments != null &amp;&amp; hist.Comments != &quot;&quot;){%&gt;&lt;div class=&apos;detail-block&apos;&gt;&lt;span class=&apos;detail-label&apos;&gt;Note&lt;/span&gt;&lt;%=hist.Comments%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;%if(hist.Subform_Details_Change_Summary != null &amp;&amp; hist.Subform_Details_Change_Summary != &quot;&quot;){%&gt;&lt;div class=&apos;detail-block&apos;&gt;&lt;span class=&apos;detail-label&apos;&gt;Change summary&lt;/span&gt;&lt;%=hist.Subform_Details_Change_Summary%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%}%&gt;\n\t\t\t\t\t\t&lt;%if(hasRelated){%&gt;&lt;div class=&apos;related-links zcs-flex zcs-row-wrap zcs-gap-8&apos;&gt;&lt;span class=&apos;related-label&apos;&gt;Related records&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;%if(hist.Lead_Lookup != null){%&gt;&lt;a class=&apos;related-link&apos; href=&apos;#Report:All_Leads?ID=&lt;%=hist.Lead_Lookup.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;Lead &lt;%=hist.Lead_Lookup.Lead_ID%&gt;&lt;/a&gt;&lt;%}%&gt;\n\t\t\t\t\t\t\t&lt;%if(hist.Sales_Order_Lookup != null){%&gt;&lt;a class=&apos;related-link&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=hist.Sales_Order_Lookup.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;Order &lt;%=hist.Sales_Order_Lookup.Sales_Order_ID%&gt;&lt;/a&gt;&lt;%}%&gt;\n\t\t\t\t\t\t\t&lt;%if(hist.Supplier_Quote_Lookup != null){%&gt;&lt;a class=&apos;related-link&apos; href=&apos;#Report:All_Supplier_Quotes?ID=&lt;%=hist.Supplier_Quote_Lookup.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;Quote &lt;%=hist.Supplier_Quote_Lookup.Supplier_Quote_ID%&gt;&lt;/a&gt;&lt;%}%&gt;\n\t\t\t\t\t\t\t&lt;%if(hist.Purchase_Order_Lookup != null){%&gt;&lt;a class=&apos;related-link&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=hist.Purchase_Order_Lookup.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;PO &lt;%=hist.Purchase_Order_Lookup.Purchase_Order_ID%&gt;&lt;/a&gt;&lt;%}%&gt;\n\t\t\t\t\t\t\t&lt;%if(hist.Supplier_Invoice_Lookup != null){%&gt;&lt;a class=&apos;related-link&apos; href=&apos;#Page:Supplier_Invoice_Detail?Supplier_Invoice_ID=&lt;%=hist.Supplier_Invoice_Lookup.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline files-3-pdf&apos;&gt;&lt;/i&gt;Invoice &lt;%=hist.Supplier_Invoice_Lookup.Supplier_Invoice_ID%&gt;&lt;/a&gt;&lt;%}%&gt;\n\t\t\t\t\t\t\t&lt;%if(hist.Logistics_Booking_Lookup != null){%&gt;&lt;a class=&apos;related-link&apos; href=&apos;#Page:Logistics_Booking_Detail?Logistics_Booking_ID=&lt;%=hist.Logistics_Booking_Lookup.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline transportation-truck-front&apos;&gt;&lt;/i&gt;Booking &lt;%=hist.Logistics_Booking_Lookup.Logistics_Booking_ID%&gt;&lt;/a&gt;&lt;%}%&gt;\n\t\t\t\t\t\t\t&lt;%if(hist.Return_Request_Lookup != null){%&gt;&lt;a class=&apos;related-link&apos; href=&apos;#Page:Return_Request_Detail?Return_Request_ID=&lt;%=hist.Return_Request_Lookup.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-box&apos;&gt;&lt;/i&gt;Return &lt;%=hist.Return_Request_Lookup.Return_Request_ID%&gt;&lt;/a&gt;&lt;%}%&gt;\n\t\t\t\t\t\t&lt;/div&gt;&lt;%}%&gt;\n\t\t\t\t\t&lt;/article&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t&lt;/ul&gt;&lt;/div&gt;\n\t\t&lt;%}%&gt;\n\t&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Lead_Detail(int Lead_ID)
		{
					displayname = "Lead Detail"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Lead_Detail_Snippet' elementName='Lead_Detail_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Lead_Detail_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;style&gt;\n/* ZCS global utility subset used by this page; included once. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#f3f3f4;--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);font-size:16px;line-height:1.5}*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-row-wrap{flex-wrap:wrap}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-box-border{box-sizing:border-box}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-22{font-size:1.375rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary,.zcs-color-tertiary{color:var(--zcs-secondary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}\n/* ZCS components: Leads CRM, Heading with Actions, Badge with Icon, Quick Actions. */\n.zcs-button{width:auto;min-width:5rem;min-height:36px;border:0}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-button:hover{filter:brightness(.97)}.zcs-badge{width:auto;white-space:nowrap}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#2a6ffc}.zcs-quick-action-item{list-style:none}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}.zcs-icon-wrapper{width:36px;height:36px;background:#f5f4fa;color:#4b4274}.zcs-bg-blue{background:#f8f8ff}\n.lead-page{min-height:100%;padding:16px;background:var(--zcs-page-bg-color);font:14px/1.5 Arial,sans-serif;color:var(--zcs-primary-text-color)}.lead-shell{max-width:1320px;margin:auto}.page-header{padding:0 0 12px}.back-link{color:var(--zcs-secondary-text-color)}.back-link:hover{color:var(--zcs_brand_color)}.actions{display:flex;flex-wrap:wrap;gap:8px}.identity{display:grid;grid-template-columns:minmax(0,1fr) minmax(250px,340px);gap:18px;padding:18px;margin-bottom:14px}.identity-main{display:flex;align-items:center;gap:14px;min-width:0}.identity-icon{width:46px;height:46px;flex:0 0 46px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:21px}.eyebrow,.label{color:var(--zcs-secondary-text-color);font-size:12px}.identity-title{margin:1px 0 0;font-size:22px;letter-spacing:-.01em}.identity-copy{margin:5px 0 0;color:var(--zcs-secondary-text-color)}.reference-panel{padding:13px 14px;border:1px solid var(--zcs_tertiary_border_color);border-radius:9px}.reference-row{display:flex;justify-content:space-between;gap:16px}.reference-row+.reference-row{margin-top:8px;padding-top:8px;border-top:1px solid var(--zcs_tertiary_border_color)}.reference-value{font-weight:600;text-align:right;word-break:break-word}.content-grid{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:14px}.main-stack,.side-stack{display:grid;gap:14px;align-content:start}.section{padding:18px}.section-head{display:flex;align-items:flex-start;gap:11px;margin-bottom:14px}.section-head h2{margin:0;font-size:17px}.section-head p{margin:3px 0 0;color:var(--zcs-secondary-text-color)}.step-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.step{padding:13px;border:1px solid var(--zcs_tertiary_border_color);border-radius:9px;background:#fff}.step-number{width:25px;height:25px;display:inline-flex;align-items:center;justify-content:center;border-radius:50%;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-weight:600}.step h3{margin:9px 0 3px;font-size:14px}.step p{margin:0;color:var(--zcs-secondary-text-color);font-size:13px}.check-list,.quick-list{list-style:none;margin:0;padding:0;display:grid;gap:12px}.check-list li{display:flex;gap:10px;align-items:flex-start}.check-list i{margin-top:3px;color:var(--zcs_brand_color)}.soft-note{padding:13px;border-left:3px solid var(--zcs_brand_color);background:var(--zcs_component_hover_color);border-radius:0 8px 8px 0;color:var(--zcs-secondary-text-color)}.quick-list a{display:flex;align-items:center;gap:10px;color:var(--zcs-primary-text-color)}.quick-list i{color:var(--zcs_brand_color)}.footer-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}\n@media(max-width:900px){.identity,.content-grid{grid-template-columns:1fr}.step-list{grid-template-columns:1fr}.side-stack{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.lead-page{padding:10px}.page-header{align-items:flex-start}.actions{width:100%}.actions a{flex:1}.identity{padding:14px}.identity-main{align-items:flex-start}.side-stack{grid-template-columns:1fr}.reference-row{align-items:flex-start}.footer-actions a{width:100%}}\n&lt;/style&gt;\n&lt;div class=&apos;lead-page&apos;&gt;\n\t&lt;div class=&apos;lead-shell&apos;&gt;\n\t\t&lt;header class=&apos;page-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-row-wrap zcs-gap-12&apos;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;a class=&apos;back-link zcs-inline-flex zcs-align-items-center zcs-gap-8&apos; href=&apos;#Page:Leads&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-left&apos;&gt;&lt;/i&gt;&lt;span&gt;Leads&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;div class=&apos;zcs-font-18 zcs-font-medium zcs-mt-4&apos;&gt;Lead handoff&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;actions&apos;&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Report:All_Leads?ID=&lt;%=input.Lead_ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;span&gt;Open lead record&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/header&gt;\n\n\t\t&lt;section class=&apos;zcs-card identity&apos;&gt;\n\t\t\t&lt;div class=&apos;identity-main&apos;&gt;\n\t\t\t\t&lt;div class=&apos;identity-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-xl&apos;&gt;&lt;i class=&apos;zc-li-outline business-goal-65&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;div class=&apos;eyebrow&apos;&gt;Operational lead reference&lt;/div&gt;\n\t\t\t\t\t&lt;h1 class=&apos;identity-title&apos;&gt;Lead &lt;%=input.Lead_ID%&gt;&lt;/h1&gt;\n\t\t\t\t\t&lt;p class=&apos;identity-copy&apos;&gt;Use this handoff view to confirm ownership, prepare the next action, and continue in the authoritative lead report.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;reference-panel zcs-bg-blue&apos;&gt;\n\t\t\t\t&lt;div class=&apos;reference-row&apos;&gt;&lt;span class=&apos;label&apos;&gt;Lead ID&lt;/span&gt;&lt;span class=&apos;reference-value&apos;&gt;&lt;%=input.Lead_ID%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;reference-row&apos;&gt;&lt;span class=&apos;label&apos;&gt;Source of truth&lt;/span&gt;&lt;span class=&apos;reference-value&apos;&gt;All Leads report&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;reference-row&apos;&gt;&lt;span class=&apos;label&apos;&gt;Workspace state&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;i class=&apos;zc-li-outline loader-dots-06&apos;&gt;&lt;/i&gt;&lt;span&gt;Ready for review&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&apos;content-grid&apos;&gt;\n\t\t\t&lt;main class=&apos;main-stack&apos;&gt;\n\t\t\t\t&lt;section class=&apos;zcs-card section&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;section-head&apos;&gt;&lt;div class=&apos;zcs-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h2&gt;Review before handoff&lt;/h2&gt;&lt;p&gt;Complete the shortest path from lead review to operational ownership.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;step-list&apos;&gt;\n\t\t\t\t\t\t&lt;article class=&apos;step&apos;&gt;&lt;span class=&apos;step-number&apos;&gt;1&lt;/span&gt;&lt;h3&gt;Validate the record&lt;/h3&gt;&lt;p&gt;Confirm customer, contact, requirement, requested products, assignment, and current status in All Leads.&lt;/p&gt;&lt;/article&gt;\n\t\t\t\t\t\t&lt;article class=&apos;step&apos;&gt;&lt;span class=&apos;step-number&apos;&gt;2&lt;/span&gt;&lt;h3&gt;Confirm ownership&lt;/h3&gt;&lt;p&gt;Make sure the responsible team and immediate follow-up are clear before work moves forward.&lt;/p&gt;&lt;/article&gt;\n\t\t\t\t\t\t&lt;article class=&apos;step&apos;&gt;&lt;span class=&apos;step-number&apos;&gt;3&lt;/span&gt;&lt;h3&gt;Advance the workflow&lt;/h3&gt;&lt;p&gt;Update the lead in the report, then continue to sales-order processing when the lead is ready.&lt;/p&gt;&lt;/article&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&apos;zcs-card section&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;section-head&apos;&gt;&lt;div class=&apos;zcs-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half&apos;&gt;&lt;i class=&apos;zc-li-outline business-progress&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;h2&gt;Operational handoff&lt;/h2&gt;&lt;p&gt;Use these checkpoints to keep sales and operations aligned.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;ul class=&apos;check-list&apos;&gt;\n\t\t\t\t\t\t&lt;li&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;strong&gt;Commercial context:&lt;/strong&gt; confirm the requirement and requested product scope are understandable to the receiving team.&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;strong&gt;Responsibility:&lt;/strong&gt; confirm who owns the next contact, update, or conversion step.&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;strong&gt;Readiness:&lt;/strong&gt; use the lead report to make status changes before opening downstream sales-order work.&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t&lt;div class=&apos;footer-actions&apos;&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Report:All_Leads?ID=&lt;%=input.Lead_ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;span&gt;Review or update lead&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Page:Sales_Orders&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-list&apos;&gt;&lt;/i&gt;&lt;span&gt;View sales orders&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\t\t\t&lt;/main&gt;\n\n\t\t\t&lt;aside class=&apos;side-stack&apos;&gt;\n\t\t\t\t&lt;section class=&apos;zcs-card section zcs-quick-actions-wrapper&apos;&gt;\n\t\t\t\t\t&lt;h2 class=&apos;zcs-font-16 zcs-font-semibold zcs-m-0&apos;&gt;Record actions&lt;/h2&gt;\n\t\t\t\t\t&lt;ul class=&apos;quick-list zcs-mt-12&apos;&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item&apos;&gt;&lt;a class=&apos;zcs-quick-action-link&apos; href=&apos;#Report:All_Leads?ID=&lt;%=input.Lead_ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;span&gt;Open authoritative record&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item&apos;&gt;&lt;a class=&apos;zcs-quick-action-link&apos; href=&apos;#Page:Leads&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-left&apos;&gt;&lt;/i&gt;&lt;span&gt;Return to lead pipeline&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item&apos;&gt;&lt;a class=&apos;zcs-quick-action-link&apos; href=&apos;#Page:Sales_Orders&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-list&apos;&gt;&lt;/i&gt;&lt;span&gt;Open sales orders&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;/section&gt;\n\t\t\t\t&lt;section class=&apos;zcs-card section&apos;&gt;\n\t\t\t\t\t&lt;h2 class=&apos;zcs-font-16 zcs-font-semibold zcs-m-0&apos;&gt;Working guidance&lt;/h2&gt;\n\t\t\t\t\t&lt;div class=&apos;soft-note zcs-mt-12&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt; This page intentionally shows only the parameter-driven lead reference. Review and change record data in All Leads.&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\t\t\t&lt;/aside&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Leads
		{
					displayname = "Leads"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Lead_Management' elementName='Lead_Management'>\n\t\t\t\t\t<![CDATA[htmlpage Lead_Management()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nallCount = Add_Lead.count();\nnewCount = Add_Lead[Status == &quot;New&quot;].count();\ncreatedCount = Add_Lead[Status == &quot;Sales Order Created&quot;].count();\nlostCount = Add_Lead[Status == &quot;Lost&quot;].count();\nleads = Add_Lead[ID != 0] sort by Lead_Date desc;\n%&gt;\n&lt;style&gt;\n/* ZCS global utilities used on this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#f4f6f8;--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);font-size:16px;line-height:1.5}*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-14{padding-left:.875rem;padding-right:.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-9{padding-top:.5625rem;padding-bottom:.5625rem}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-text-left{text-align:left}.zcs-w-full{width:100%}.zcs-m-0{margin:0}.zcs-sticky{position:sticky}a{text-decoration:none}\n.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%;width:100%}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important}#splash-screen,.zc-pb-page-loader{display:none!important}\n.leads-page{min-height:100%;padding:18px;background:var(--zcs-page-bg-color);font:14px/1.45 Arial,sans-serif;color:var(--zcs-primary-text-color)}.leads-shell{max-width:1600px;margin:auto}.zcs-page-header{padding:2px 2px 14px}.title-wrap{min-width:0}.title-icon{width:34px;height:34px;border:1px solid var(--zcs_tertiary_border_color);background:var(--zcs-white-color);color:var(--zcs_brand_color);border-radius:9px;font-size:17px;flex:0 0 auto}.page-title{font-size:24px;letter-spacing:-.02em}.page-subtitle,.register-note,.muted{color:var(--zcs-secondary-text-color)}.page-subtitle,.register-note{margin:2px 0 0}\n.summary-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;margin-bottom:12px;overflow:hidden}.summary-item{padding:10px 14px;border-right:1px solid var(--zcs_tertiary_border_color);display:flex;align-items:center;justify-content:space-between;gap:10px}.summary-item:last-child{border-right:0}.summary-label{color:var(--zcs-secondary-text-color);font-size:12px}.summary-value{font-size:18px}.summary-new i{color:#2a6ffc}.summary-won i{color:#179e6c}.summary-lost i{color:#c8485b}\n.register{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;overflow:hidden}.register-head{padding:12px 14px;border-bottom:1px solid var(--zcs_tertiary_border_color)}.register-title{font-size:16px}.record-count{color:var(--zcs-secondary-text-color);white-space:nowrap}.zcs-table-wrapper{height:560px;overflow:auto;background:var(--zcs-white-color)}.zcs-table-wrapper table{border-collapse:collapse;min-width:1280px}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:#f7f8fa;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap;color:var(--zcs-secondary-text-color);font-size:12px;font-weight:600}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:middle}.zcs-table-wrapper tbody tr:first-child td{border-top:0}.zcs-table-wrapper tbody tr:hover td{background:#fafbfc}.identity{min-width:170px}.lead-link{font-weight:600;color:var(--zcs_brand_color)}.company{display:block;font-weight:500;margin-top:2px}.subline{display:block;color:var(--zcs-secondary-text-color);font-size:12px;margin-top:2px}.contact{min-width:190px}.need{max-width:220px;white-space:normal}.value{font-weight:600;white-space:nowrap}.owner{display:inline-flex;align-items:center;gap:6px;white-space:nowrap}.owner-icon{width:25px;height:25px;border-radius:50%;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);display:inline-flex;align-items:center;justify-content:center}.product-count{display:inline-flex;align-items:center;justify-content:center;min-width:28px;height:25px;border-radius:6px;background:#f0f2f6;font-weight:600}.zcs-badge{width:auto;border:1px solid;white-space:nowrap;font-size:12px}.zcs-badge-blue{background:#eef3ff;border-color:#bdd0ff;color:#245dc1}.zcs-badge-green{background:#e9f8f2;border-color:#b8e6d4;color:#147b58}.zcs-badge-red{background:#fbedef;border-color:#efc2c9;color:#a93447}.zcs-badge-grey{background:#f1f2f4;border-color:#d7d9de;color:#515660}.row-actions{white-space:nowrap}.record-action{color:var(--zcs-secondary-text-color);border:1px solid var(--zcs_tertiary_border_color);background:#fff}.record-action:hover{color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.record-action.primary{color:var(--zcs_brand_color);border-color:var(--zcs_brand_color)}\n.mobile-list{display:none}.mobile-card{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;padding:13px}.mobile-top,.mobile-footer{display:flex;align-items:center;justify-content:space-between;gap:10px}.mobile-contact{margin:10px 0;padding:9px 0;border-top:1px solid var(--zcs_tertiary_border_color);border-bottom:1px solid var(--zcs_tertiary_border_color)}.mobile-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:11px}.mobile-label{display:block;color:var(--zcs-secondary-text-color);font-size:11px;margin-bottom:2px}.empty{min-height:300px;text-align:center}.empty-icon{width:50px;height:50px;margin:0 auto 10px;border-radius:12px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:22px}.empty p{margin:6px 0 0}\n@media(max-width:900px){.summary-strip{grid-template-columns:1fr 1fr}.summary-item:nth-child(2){border-right:0}.summary-item:nth-child(-n+2){border-bottom:1px solid var(--zcs_tertiary_border_color)}.desktop-table{display:none}.mobile-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;padding:10px;background:#f7f8fa}.register-head{padding:11px 12px}}\n@media(max-width:620px){.leads-page{padding:10px}.zcs-page-header{padding-bottom:10px}.page-title{font-size:21px}.page-subtitle{font-size:12px}.summary-item{padding:9px 10px}.summary-value{font-size:16px}.mobile-list{grid-template-columns:1fr}.register-note{display:none}}\n&lt;/style&gt;\n&lt;div class=&apos;leads-page&apos;&gt;&lt;div class=&apos;leads-shell&apos;&gt;\n\t&lt;header class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center&apos;&gt;\n\t\t&lt;div class=&apos;title-wrap zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;&lt;span class=&apos;title-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-menu-left&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h1 class=&apos;page-title zcs-m-0&apos;&gt;Lead register&lt;/h1&gt;&lt;p class=&apos;page-subtitle&apos;&gt;Pipeline ownership, contact context and value at a glance.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;/header&gt;\n\t&lt;div class=&apos;summary-strip&apos; aria-label=&apos;Pipeline summary&apos;&gt;\n\t\t&lt;div class=&apos;summary-item&apos;&gt;&lt;span&gt;&lt;span class=&apos;summary-label&apos;&gt;All leads&lt;/span&gt;&lt;/span&gt;&lt;strong class=&apos;summary-value&apos;&gt;&lt;%=allCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;summary-item summary-new&apos;&gt;&lt;span class=&apos;zcs-flex zcs-align-items-center zcs-gap-6&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-send&apos;&gt;&lt;/i&gt;&lt;span class=&apos;summary-label&apos;&gt;New&lt;/span&gt;&lt;/span&gt;&lt;strong class=&apos;summary-value&apos;&gt;&lt;%=newCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;summary-item summary-won&apos;&gt;&lt;span class=&apos;zcs-flex zcs-align-items-center zcs-gap-6&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span class=&apos;summary-label&apos;&gt;Sales order created&lt;/span&gt;&lt;/span&gt;&lt;strong class=&apos;summary-value&apos;&gt;&lt;%=createdCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;summary-item summary-lost&apos;&gt;&lt;span class=&apos;zcs-flex zcs-align-items-center zcs-gap-6&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;&lt;span class=&apos;summary-label&apos;&gt;Lost&lt;/span&gt;&lt;/span&gt;&lt;strong class=&apos;summary-value&apos;&gt;&lt;%=lostCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;section class=&apos;register&apos;&gt;\n\t\t&lt;div class=&apos;register-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;register-title zcs-m-0&apos;&gt;Operational pipeline&lt;/h2&gt;&lt;p class=&apos;register-note&apos;&gt;Newest first. Open a record for full context.&lt;/p&gt;&lt;/div&gt;&lt;span class=&apos;record-count&apos;&gt;&lt;%=allCount%&gt; records&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;%if(allCount == 0){%&gt;\n\t\t\t&lt;div class=&apos;empty zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;div class=&apos;zcs-p-20 zcs-text-left&apos;&gt;&lt;div class=&apos;empty-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-send&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-medium zcs-m-0&apos;&gt;No leads in the register&lt;/h3&gt;&lt;p class=&apos;muted&apos;&gt;New leads will appear here with their owner and pipeline status.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;%}else{%&gt;\n\t\t\t&lt;div class=&apos;desktop-table zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-14 zcs-py-9 zcs-text-left&apos;&gt;Lead&lt;/th&gt;&lt;th class=&apos;zcs-px-14 zcs-py-9 zcs-text-left&apos;&gt;Contact&lt;/th&gt;&lt;th class=&apos;zcs-px-14 zcs-py-9 zcs-text-left&apos;&gt;Requirement&lt;/th&gt;&lt;th class=&apos;zcs-px-14 zcs-py-9 zcs-text-left&apos;&gt;Value&lt;/th&gt;&lt;th class=&apos;zcs-px-14 zcs-py-9 zcs-text-left&apos;&gt;Lead date&lt;/th&gt;&lt;th class=&apos;zcs-px-14 zcs-py-9 zcs-text-left&apos;&gt;Owner&lt;/th&gt;&lt;th class=&apos;zcs-px-14 zcs-py-9 zcs-text-left&apos;&gt;Status&lt;/th&gt;&lt;th class=&apos;zcs-px-14 zcs-py-9 zcs-text-left&apos;&gt;Products&lt;/th&gt;&lt;th class=&apos;zcs-px-14 zcs-py-9 zcs-text-left&apos;&gt;Actions&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t&lt;%for each lead in leads\n\t\t\t{\n\t\t\t\tproductCount = Lead_Product[Parent_Lead == lead.ID].count();\n\t\t\t\tbadgeClass = &quot;zcs-badge-grey&quot;;\n\t\t\t\tif(lead.Status == &quot;New&quot;)\n\t\t\t\t{\n\t\t\t\t\tbadgeClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\t}\n\t\t\t\telse if(lead.Status == &quot;Sales Order Created&quot;)\n\t\t\t\t{\n\t\t\t\t\tbadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t}\n\t\t\t\telse if(lead.Status == &quot;Lost&quot;)\n\t\t\t\t{\n\t\t\t\t\tbadgeClass = &quot;zcs-badge-red&quot;;\n\t\t\t\t}\n\t\t\t%&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;td class=&apos;identity zcs-px-14 zcs-py-9&apos;&gt;&lt;a class=&apos;lead-link&apos; href=&apos;#Page:Lead_Detail?Lead_ID=&lt;%=lead.ID%&gt;&apos;&gt;&lt;%=lead.Lead_ID%&gt;&lt;/a&gt;&lt;span class=&apos;company&apos;&gt;&lt;%=ifnull(lead.Customer_Company_Name,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;span class=&apos;subline&apos;&gt;&lt;%=ifnull(lead.Lead_Source,&quot;Source not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;contact zcs-px-14 zcs-py-9&apos;&gt;&lt;span class=&apos;zcs-font-medium&apos;&gt;&lt;%=ifnull(lead.Contact_Person,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;span class=&apos;subline&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-email-83&apos;&gt;&lt;/i&gt; &lt;%=ifnull(lead.Email,ifnull(lead.Phone,&quot;No contact details&quot;))%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-14 zcs-py-9&apos;&gt;&lt;div class=&apos;need&apos;&gt;&lt;%=ifnull(lead.Requirement,&quot;Not specified&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-14 zcs-py-9&apos;&gt;&lt;span class=&apos;value&apos;&gt;$&lt;%=ifnull(lead.Expected_Price,0)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-14 zcs-py-9&apos;&gt;&lt;%=lead.Lead_Date%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-14 zcs-py-9&apos;&gt;&lt;span class=&apos;owner&apos;&gt;&lt;span class=&apos;owner-icon&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-05&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;%=ifnull(lead.Sales_Agent,&quot;Unassigned&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-14 zcs-py-9&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=badgeClass%&gt;&apos;&gt;&lt;%=ifnull(lead.Status,&quot;Unknown&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-14 zcs-py-9&apos;&gt;&lt;span class=&apos;product-count&apos;&gt;&lt;%=productCount%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;row-actions zcs-px-14 zcs-py-9&apos;&gt;&lt;a class=&apos;record-action primary zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-sm&apos; href=&apos;#Page:Lead_Detail?Lead_ID=&lt;%=lead.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;Open&lt;/a&gt; &lt;a class=&apos;record-action zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-sm&apos; href=&apos;#Report:All_Histories?Lead_Lookup=&lt;%=lead.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;History&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t&lt;/tr&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;mobile-list&apos;&gt;\n\t\t\t&lt;%for each lead in leads\n\t\t\t{\n\t\t\t\tproductCount = Lead_Product[Parent_Lead == lead.ID].count();\n\t\t\t\tbadgeClass = &quot;zcs-badge-grey&quot;;\n\t\t\t\tif(lead.Status == &quot;New&quot;)\n\t\t\t\t{\n\t\t\t\t\tbadgeClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\t}\n\t\t\t\telse if(lead.Status == &quot;Sales Order Created&quot;)\n\t\t\t\t{\n\t\t\t\t\tbadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t}\n\t\t\t\telse if(lead.Status == &quot;Lost&quot;)\n\t\t\t\t{\n\t\t\t\t\tbadgeClass = &quot;zcs-badge-red&quot;;\n\t\t\t\t}\n\t\t\t%&gt;\n\t\t\t\t&lt;article class=&apos;mobile-card&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;mobile-top&apos;&gt;&lt;div&gt;&lt;a class=&apos;lead-link&apos; href=&apos;#Page:Lead_Detail?Lead_ID=&lt;%=lead.ID%&gt;&apos;&gt;&lt;%=lead.Lead_ID%&gt;&lt;/a&gt;&lt;span class=&apos;subline&apos;&gt;&lt;%=ifnull(lead.Customer_Company_Name,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=badgeClass%&gt;&apos;&gt;&lt;%=ifnull(lead.Status,&quot;Unknown&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;mobile-contact&apos;&gt;&lt;strong&gt;&lt;%=ifnull(lead.Contact_Person,&quot;-&quot;)%&gt;&lt;/strong&gt;&lt;span class=&apos;subline&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-email-83&apos;&gt;&lt;/i&gt; &lt;%=ifnull(lead.Email,ifnull(lead.Phone,&quot;No contact details&quot;))%&gt;&lt;/span&gt;&lt;span class=&apos;subline&apos;&gt;&lt;%=ifnull(lead.Requirement,&quot;Not specified&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;mobile-grid&apos;&gt;&lt;div&gt;&lt;span class=&apos;mobile-label&apos;&gt;Value&lt;/span&gt;&lt;strong&gt;$&lt;%=ifnull(lead.Expected_Price,0)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&apos;mobile-label&apos;&gt;Owner&lt;/span&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline users-single-05&apos;&gt;&lt;/i&gt; &lt;%=ifnull(lead.Sales_Agent,&quot;Unassigned&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&apos;mobile-label&apos;&gt;Lead date&lt;/span&gt;&lt;%=lead.Lead_Date%&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&apos;mobile-label&apos;&gt;Products&lt;/span&gt;&lt;%=productCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;mobile-footer&apos;&gt;&lt;span class=&apos;subline&apos;&gt;&lt;%=ifnull(lead.Lead_Source,&quot;Source not set&quot;)%&gt;&lt;/span&gt;&lt;span&gt;&lt;a class=&apos;record-action primary zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-sm&apos; href=&apos;#Page:Lead_Detail?Lead_ID=&lt;%=lead.ID%&gt;&apos;&gt;Open &lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt; &lt;a class=&apos;record-action zcs-inline-flex zcs-align-items-center zcs-px-10 zcs-py-6 zcs-rounded-sm&apos; href=&apos;#Report:All_Histories?Lead_Lookup=&lt;%=lead.ID%&gt;&apos; title=&apos;History&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;/article&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;%}%&gt;\n\t&lt;/section&gt;\n&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Logistics_Booking_Detail(int Logistics_Booking_ID)
		{
					displayname = "Logistics Booking Detail"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Logistics_Booking_Detail_Snippet' elementName='Logistics_Booking_Detail'>\n\t\t\t\t\t<![CDATA[htmlpage Logistics_Booking_Detail_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nbookingList = Create_Logistics_Booking[ID == input.Logistics_Booking_ID];\n%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color,#6147E5);--zcs-light-bg-color:var(--zcs_brand_light_color,#f1edff);--zcs-page-bg-color:#f5f6f8;--zcs-primary-text-color:var(--zcs_primary_text_color,#1c1c40);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#65657a);--zcs-border-color:var(--zcs_tertiary_border_color,#e3e7ef);--zcs-white-color:#fff;--column-gap:0px}*{box-sizing:border-box}html,body{width:100%;margin:0}#splash-screen{display:none!important}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%;width:100%}.zc-pb-page-content-wrapper .zc-pb-tile-container,.zc-pb-page-content-wrapper .zc-pb-tile-card{padding:0!important;border-radius:0!important;box-shadow:none!important}.zcs-flex,.zcs-row{display:flex}.zcs-row{flex-wrap:wrap}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-row-wrap{flex-wrap:wrap}.zcs-gap-4{gap:4px}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-gap-24{gap:24px}.zcs-p-0{padding:0}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:8px}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-half{border-radius:50%}.zcs-font-12{font-size:12px}.zcs-font-14{font-size:14px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-tertiary{color:var(--zcs-secondary-text-color)}.zcs-color-red{color:#c9344d}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:10px;box-shadow:0 1px 2px rgba(28,28,64,.035)}.zcs-button{width:auto;min-width:0;min-height:32px;text-decoration:none}.zcs-primary-button{background:var(--zcs_brand_color,#6147E5);color:var(--zcs_brand_foreground_color,#fff)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color,#6147E5);background:#fff;color:var(--zcs_brand_color,#6147E5)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color,#f1edff)}.zcs-button-icon{width:16px}.zcs-badge{width:max-content;white-space:nowrap;border:1px solid;font-size:12px}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#116d50}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#2458bf}.zcs-badge-yellow{background:#fff4d8;border-color:#d88b00;color:#775000}.zcs-badge-red{background:#fde3e6;border-color:#d83a52;color:#a62539}.detail{min-height:100%;width:100%;overflow:auto;background:var(--zcs-page-bg-color);padding:14px;font:14px/1.42 Arial,sans-serif;color:var(--zcs-primary-text-color)}.stack{display:flex;flex-direction:column;gap:12px;max-width:1580px;margin:auto}.hero{padding:14px 16px;background:#fff;border:1px solid var(--zcs-border-color);border-radius:10px}.hero h1{font-size:21px;font-weight:650;margin:2px 0;color:var(--zcs-primary-text-color)}.hero a{text-decoration:none}.hero-copy{color:var(--zcs-secondary-text-color);font-size:13px}.back-link{color:var(--zcs-secondary-text-color);font-size:12px;font-weight:600}.hero-icon{width:38px;height:38px;border-radius:9px;background:var(--zcs-light-bg-color);color:var(--zcs_brand_color,#6147E5);font-size:19px}.actions{justify-content:flex-end}.workflow-actions{padding:10px 12px}.workflow-label{font-size:12px;color:var(--zcs-secondary-text-color);font-weight:600;text-transform:uppercase;letter-spacing:.04em}.section-title{font-size:15px;font-weight:650;margin:0 0 10px}.info-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px 18px}.kv{min-width:0}.kv label{display:block;color:var(--zcs-secondary-text-color);font-size:11px;margin-bottom:2px;text-transform:uppercase;letter-spacing:.03em}.kv strong,.kv span{display:block;overflow-wrap:anywhere}.summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.summary{padding:12px 14px;border:1px solid var(--zcs-border-color);border-radius:9px;background:#fff}.summary label{display:block;color:var(--zcs-secondary-text-color);font-size:11px}.summary strong{font-size:18px}.milestones{padding:12px 18px}.milestone-list{display:grid;grid-template-columns:repeat(5,1fr);margin:0;padding:0;list-style:none}.milestone{text-align:center;position:relative;color:var(--zcs-secondary-text-color)}.milestone:not(:last-child):before{content:&apos;&apos;;position:absolute;top:13px;left:50%;width:100%;height:2px;background:var(--zcs-border-color)}.milestone.done:not(:last-child):before{background:#179e6c}.milestone-dot{position:relative;z-index:1;width:27px;height:27px;margin:0 auto 5px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#fff;border:2px solid var(--zcs-border-color);font-size:12px}.milestone.done .milestone-dot{background:#179e6c;border-color:#179e6c;color:#fff}.milestone.current .milestone-dot{border-color:var(--zcs_brand_color,#6147E5);color:var(--zcs_brand_color,#6147E5);box-shadow:0 0 0 3px var(--zcs-light-bg-color)}.milestone span{font-size:11px;font-weight:600}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:12px}.empty{min-height:120px;padding:24px;text-align:center;color:var(--zcs-secondary-text-color);background:#fafbfe;border:1px dashed var(--zcs-border-color);border-radius:8px;display:flex;flex-direction:column;align-items:center;justify-content:center}.empty i{display:block;font-size:23px;color:var(--zcs_brand_color,#6147E5);margin-bottom:6px}.empty h3,.empty p{margin:4px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:10px}.section-count{font-size:11px;color:var(--zcs-secondary-text-color);font-weight:500}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:#fff;overflow:auto;border-radius:7px;height:310px}.zcs-table-wrapper table{border-collapse:collapse;min-width:900px}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:#f7f8fc;box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap;font-size:12px;font-weight:600}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color);vertical-align:top;font-size:13px}.zcs-table-wrapper tbody tr:hover td{background:#fafbfe}.mobile-list{display:none;height:310px;overflow:auto}.record-card{padding:12px;border:1px solid var(--zcs-border-color);border-radius:7px}.record-card h4{margin:0 0 6px}.record-meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;color:var(--zcs-secondary-text-color);font-size:12px}.text-block{white-space:pre-wrap;overflow-wrap:anywhere}.docs{display:flex;flex-wrap:wrap;gap:8px}.doc{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--zcs-border-color);border-radius:7px;color:var(--zcs-primary-text-color);text-decoration:none}.link{color:var(--zcs_brand_color,#6147E5);font-weight:600;text-decoration:none}.exception-strip{border-left:3px solid #d83a52!important}.timeline-content{padding-left:44px}.timeline-scroll{height:260px;overflow:auto;padding-right:6px}.zcs-tl-indicator{width:34px;left:0}.zcs-tl-dot{width:10px;height:10px;background:var(--zcs_brand_color,#6147E5);border:1px solid #fff;box-shadow:0 2px 6px #c4dee4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:&apos;&apos;;position:absolute;width:1px;height:calc(100% + 24px);background:#e1e1e1;top:6px}@media(max-width:1000px){.info-grid,.summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.two-col{grid-template-columns:1fr}.hero-row{align-items:flex-start}.workflow-actions&gt;div{align-items:flex-start;flex-direction:column}.actions{justify-content:flex-start;width:100%}}@media(max-width:620px){.detail{height:auto;padding:9px}.hero{padding:12px}.hero h1{font-size:18px}.hero-icon{display:none}.info-grid,.summary-grid{grid-template-columns:1fr}.actions .zcs-button{flex:1 1 calc(50% - 8px)}.zcs-table-wrapper{display:none}.mobile-list{display:flex}.zcs-card{padding:12px!important}.timeline-content{padding-left:36px}.milestone-list{grid-template-columns:1fr;gap:10px}.milestone{display:flex;align-items:center;gap:9px;text-align:left}.milestone:not(:last-child):before{top:22px;left:13px;width:2px;height:calc(100% + 10px)}.milestone-dot{margin:0}.milestone span{font-size:12px}}\n&lt;/style&gt;\n&lt;div class=&apos;detail&apos;&gt;\n&lt;%if(bookingList.count() == 0){%&gt;\n\t&lt;div class=&apos;zcs-card empty&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-search-zoom-out zcs-font-24&apos;&gt;&lt;/i&gt;&lt;h3&gt;Logistics booking not found&lt;/h3&gt;&lt;p&gt;No accessible record matches this Logistics_Booking_ID.&lt;/p&gt;&lt;a class=&apos;link&apos; href=&apos;#Page:Logistics_Bookings&apos;&gt;Back to bookings&lt;/a&gt;&lt;/div&gt;\n&lt;%}else{ b=bookingList; poRows=Logistics_Booking_Purchase_Order[Parent_Logistics_Booking == b.ID]; products=Logistics_Booking_Product[Parent_Logistics_Booking == b.ID]; qcRows=Logistics_Quality_Check_Product[Parent_Logistics_Booking == b.ID]; histories=Add_History[Logistics_Booking_Lookup == b.ID] sort by Updated_Date_Time desc; expectedTotal=0; receivedTotal=0; damagedTotal=0; acceptedTotal=0; rejectedTotal=0; inspectedTotal=0; receiptComplete=true; receiptBalanced=true; for each rp in products { expectedTotal=expectedTotal + ifnull(rp.Expected_Quantity,0); receivedTotal=receivedTotal + ifnull(rp.Received_Quantity,0); damagedTotal=damagedTotal + ifnull(rp.Damaged_Quantity,0); acceptedTotal=acceptedTotal + ifnull(rp.Accepted_Quantity,0); rejectedTotal=rejectedTotal + ifnull(rp.Rejected_Quantity,0); if(ifnull(rp.Received_Quantity,0) &lt; ifnull(rp.Expected_Quantity,0)){receiptComplete=false;} if(ifnull(rp.Accepted_Quantity,0) + ifnull(rp.Rejected_Quantity,0) != ifnull(rp.Received_Quantity,0)){receiptBalanced=false;} } if(products.count()==0){receiptComplete=false;receiptBalanced=false;} qcComplete=true; qcExceptions=0; if(qcRows.count()==0){qcComplete=false;} for each qcr in qcRows { inspectedTotal=inspectedTotal + ifnull(qcr.Inspected_Quantity,0); if(qcr.Quality_Result == null || ifnull(qcr.Inspected_Quantity,0) &lt; ifnull(qcr.Received_Quantity,0)){qcComplete=false;} if(qcr.Quality_Result == &quot;Failed&quot; || qcr.Quality_Result == &quot;Partially Passed&quot; || ifnull(qcr.Rejected_Quantity,0) &gt; 0 || qcr.Defect_Details != null){qcExceptions=qcExceptions + 1;} } if(inspectedTotal &lt; receivedTotal){qcComplete=false;} canAddPO=(b.Status == &quot;New&quot; &amp;&amp; Create_Purchase_Order[Status == &quot;Invoice Paid&quot;].count() &gt; poRows.count()); canReceipt=(b.Status == &quot;New&quot; &amp;&amp; poRows.count()&gt;0 &amp;&amp; products.count()&gt;0 &amp;&amp; receiptComplete==false); canQC=(b.Status == &quot;New&quot; &amp;&amp; receivedTotal&gt;0 &amp;&amp; qcComplete==false); canMark=(b.Status == &quot;New&quot; &amp;&amp; receiptComplete &amp;&amp; receiptBalanced &amp;&amp; qcComplete);%&gt;\n&lt;div class=&apos;stack&apos;&gt;\n&lt;header class=&apos;hero&apos;&gt;&lt;div class=&apos;hero-row zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;&lt;div class=&apos;hero-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;a class=&apos;back-link&apos; href=&apos;#Page:Logistics_Bookings&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-left&apos;&gt;&lt;/i&gt; Logistics bookings&lt;/a&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-row-wrap&apos;&gt;&lt;h1&gt;&lt;%=b.Logistics_Booking_ID%&gt;&lt;/h1&gt;&lt;span class=&apos;zcs-badge zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=if(b.Status==&quot;Products Received&quot;,&quot;zcs-badge-green&quot;,&quot;zcs-badge-blue&quot;)%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=if(b.Status==&quot;Products Received&quot;,&quot;ui-1-check-circle-08&quot;,&quot;loader-dots-06&quot;)%&gt;&apos;&gt;&lt;/i&gt;&lt;%=b.Status%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;hero-copy&apos;&gt;&lt;%=ifnull(b.Logistics_Provider,&quot;Provider not set&quot;)%&gt; | &lt;%=ifnull(b.Warehouse_Destination,&quot;Destination not set&quot;)%&gt; | Tracking &lt;%=ifnull(b.Tracking_Reference,&quot;not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;%if(histories.count()&gt;0){%&gt;&lt;a class=&apos;link zcs-font-12&apos; href=&apos;#Report:All_Histories?Logistics_Booking_Lookup=&lt;%=b.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt; History&lt;/a&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/header&gt;&lt;%if(canAddPO || canReceipt || canQC || canMark){%&gt;&lt;section class=&apos;zcs-card workflow-actions&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;span class=&apos;workflow-label&apos;&gt;Next available action&lt;/span&gt;&lt;div class=&apos;actions zcs-flex zcs-row-wrap zcs-gap-8&apos;&gt;&lt;%if(canAddPO){%&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Form:Create_Logistics_Booking?recLinkID=&lt;%=b.ID%&gt;&amp;amp;viewLinkName=All_Logistics_Bookings&amp;amp;Action_Mode=Add PO&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-circle-add&apos;&gt;&lt;/i&gt;&lt;span&gt;Add PO&lt;/span&gt;&lt;/a&gt;&lt;%}%&gt;&lt;%if(canReceipt){%&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Form:Create_Logistics_Booking?recLinkID=&lt;%=b.ID%&gt;&amp;amp;viewLinkName=All_Logistics_Bookings&amp;amp;Action_Mode=Receipt&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;&lt;span&gt;Record receipt&lt;/span&gt;&lt;/a&gt;&lt;%}%&gt;&lt;%if(canQC){%&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Form:Create_Logistics_Booking?recLinkID=&lt;%=b.ID%&gt;&amp;amp;viewLinkName=All_Logistics_Bookings&amp;amp;Action_Mode=QC&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;Run QC&lt;/span&gt;&lt;/a&gt;&lt;%}%&gt;&lt;%if(canMark){%&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Form:Create_Logistics_Booking?recLinkID=&lt;%=b.ID%&gt;&amp;amp;viewLinkName=All_Logistics_Bookings&amp;amp;Action_Mode=Products Received&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;Mark received&lt;/span&gt;&lt;/a&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;&lt;%}%&gt;\n&lt;section class=&apos;zcs-card milestones&apos;&gt;&lt;h2 class=&apos;section-title&apos;&gt;Shipment milestones&lt;/h2&gt;&lt;ul class=&apos;milestone-list&apos;&gt;&lt;li class=&apos;milestone done&apos;&gt;&lt;div class=&apos;milestone-dot&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-small&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span&gt;Booked&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;milestone &lt;%=if(poRows.count()&gt;0,&quot;done&quot;,&quot;current&quot;)%&gt;&apos;&gt;&lt;div class=&apos;milestone-dot&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span&gt;PO linked&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;milestone &lt;%=if(receivedTotal&gt;0,&quot;done&quot;,if(poRows.count()&gt;0,&quot;current&quot;,&quot;&quot;))%&gt;&apos;&gt;&lt;div class=&apos;milestone-dot&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span&gt;Received&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;milestone &lt;%=if(qcComplete,&quot;done&quot;,if(receivedTotal&gt;0,&quot;current&quot;,&quot;&quot;))%&gt;&apos;&gt;&lt;div class=&apos;milestone-dot&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span&gt;Quality checked&lt;/span&gt;&lt;/li&gt;&lt;li class=&apos;milestone &lt;%=if(b.Status==&quot;Products Received&quot;,&quot;done&quot;,if(canMark,&quot;current&quot;,&quot;&quot;))%&gt;&apos;&gt;&lt;div class=&apos;milestone-dot&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-small&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span&gt;Completed&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/section&gt;\n&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;&lt;div class=&apos;section-head&apos; style=&apos;margin-bottom:12px&apos;&gt;&lt;h2 class=&apos;section-title&apos; style=&apos;margin:0&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-57&apos;&gt;&lt;/i&gt; Shipment information&lt;/h2&gt;&lt;span class=&apos;section-count&apos;&gt;Booking record&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;info-grid&apos;&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Booking date&lt;/label&gt;&lt;strong&gt;&lt;%=ifnull(b.Booking_Date,&quot;Not set&quot;)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Provider&lt;/label&gt;&lt;strong&gt;&lt;%=ifnull(b.Logistics_Provider,&quot;Not set&quot;)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Pickup location&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(b.Pickup_Location,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Warehouse destination&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(b.Warehouse_Destination,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Expected arrival&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(b.Expected_Arrival_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Actual arrival&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(b.Actual_Arrival_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Tracking reference&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(b.Tracking_Reference,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Suppliers&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(b.Suppliers,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;section class=&apos;summary-grid&apos;&gt;&lt;div class=&apos;summary&apos;&gt;&lt;label&gt;Linked purchase orders&lt;/label&gt;&lt;strong&gt;&lt;%=poRows.count()%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;summary&apos;&gt;&lt;label&gt;Expected / received&lt;/label&gt;&lt;strong&gt;&lt;%=expectedTotal%&gt; / &lt;%=receivedTotal%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;summary&apos;&gt;&lt;label&gt;Inspected / damaged&lt;/label&gt;&lt;strong&gt;&lt;%=inspectedTotal%&gt; / &lt;%=damagedTotal%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;summary&apos;&gt;&lt;label&gt;Accepted / rejected&lt;/label&gt;&lt;strong&gt;&lt;%=acceptedTotal%&gt; / &lt;%=rejectedTotal%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;/section&gt;&lt;%if(receivedTotal &gt; expectedTotal || receiptBalanced==false || qcExceptions&gt;0){%&gt;&lt;section class=&apos;zcs-card zcs-p-16 exception-strip&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-red zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-alert-circle&apos;&gt;&lt;/i&gt; Exception&lt;/span&gt;&lt;strong&gt;Receiving review required&lt;/strong&gt;&lt;/div&gt;&lt;p class=&apos;zcs-mb-0&apos;&gt;&lt;%if(receivedTotal &gt; expectedTotal){%&gt;Received quantity exceeds expected quantity. &lt;%}%&gt;&lt;%if(receiptBalanced==false){%&gt;Accepted and rejected quantities do not reconcile to received quantities. &lt;%}%&gt;&lt;%if(qcExceptions&gt;0){%&gt;&lt;%=qcExceptions%&gt; QC finding(s) include defects, rejection, or a non-passing result.&lt;%}%&gt;&lt;/p&gt;&lt;/section&gt;&lt;%}%&gt;\n&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h2 class=&apos;section-title&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt; Linked purchase orders&lt;/h2&gt;&lt;span class=&apos;section-count&apos;&gt;&lt;%=poRows.count()%&gt; linked&lt;/span&gt;&lt;/div&gt;&lt;%if(poRows.count()==0){%&gt;&lt;div class=&apos;empty&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;strong&gt;No purchase orders linked&lt;/strong&gt;&lt;span&gt;Link an eligible paid purchase order to begin receiving.&lt;/span&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Purchase order&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Supplier&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Sales order&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;PO date&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Amount&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;Invoice paid&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;Remarks&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%for each po in poRows{%&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%if(po.Purchase_Order != null){%&gt;&lt;a class=&apos;link&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=po.Purchase_Order.ID%&gt;&apos;&gt;&lt;%=po.Purchase_Order.Purchase_Order_ID%&gt;&lt;/a&gt;&lt;%}else{%&gt;Not linked&lt;%}%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%if(po.Supplier != null){%&gt;&lt;%=po.Supplier.Supplier_Name%&gt;&lt;%}else{%&gt;Not set&lt;%}%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%if(po.Sales_Order != null){%&gt;&lt;a class=&apos;link&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=po.Sales_Order.ID%&gt;&apos;&gt;&lt;%=po.Sales_Order.Sales_Order_ID%&gt;&lt;/a&gt;&lt;%}else{%&gt;Not linked&lt;%}%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(po.Purchase_Order_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=ifnull(po.Currency,&quot;&quot;)%&gt; &lt;%=ifnull(po.Purchase_Order_Amount,0)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(po.Invoice_Paid_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(po.Remarks,&quot;&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;div class=&apos;mobile-list zcs-direction-column zcs-gap-12&apos;&gt;&lt;%for each pom in poRows{%&gt;&lt;div class=&apos;record-card&apos;&gt;&lt;h4&gt;&lt;%if(pom.Purchase_Order != null){%&gt;&lt;a class=&apos;link&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=pom.Purchase_Order.ID%&gt;&apos;&gt;&lt;%=pom.Purchase_Order.Purchase_Order_ID%&gt;&lt;/a&gt;&lt;%}else{%&gt;Purchase order not linked&lt;%}%&gt;&lt;/h4&gt;&lt;div class=&apos;record-meta&apos;&gt;&lt;span&gt;&lt;%if(pom.Supplier != null){%&gt;&lt;%=pom.Supplier.Supplier_Name%&gt;&lt;%}else{%&gt;Supplier not set&lt;%}%&gt;&lt;/span&gt;&lt;span&gt;&lt;%=ifnull(pom.Currency,&quot;&quot;)%&gt; &lt;%=ifnull(pom.Purchase_Order_Amount,0)%&gt;&lt;/span&gt;&lt;span&gt;PO: &lt;%=ifnull(pom.Purchase_Order_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;span&gt;Paid: &lt;%=ifnull(pom.Invoice_Paid_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/section&gt;\n&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h2 class=&apos;section-title&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt; Products and receiving&lt;/h2&gt;&lt;span class=&apos;section-count&apos;&gt;&lt;%=products.count()%&gt; product rows&lt;/span&gt;&lt;/div&gt;&lt;%if(products.count()==0){%&gt;&lt;div class=&apos;empty&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;&lt;strong&gt;No products ready for receiving&lt;/strong&gt;&lt;span&gt;Product, serial and receipt quantities will appear here.&lt;/span&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;Product&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;PO / supplier&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;Configuration&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Expected&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Received&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Damaged&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Accepted / rejected&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;Serials and remarks&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%for each p in products{%&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;strong&gt;&lt;%=p.Product_Name%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;%=ifnull(p.Product_ID,&quot;&quot;)%&gt; | &lt;%=ifnull(p.Brand_Make,&quot;&quot;)%&gt; &lt;%=ifnull(p.Model,&quot;&quot;)%&gt;&lt;br&gt;&lt;%=ifnull(p.Manufacturer_Part_Number,&quot;&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=p.Purchase_Order.Purchase_Order_ID%&gt;&lt;br&gt;&lt;%=ifnull(p.Supplier.Supplier_Name,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(p.Configuration,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=ifnull(p.Expected_Quantity,0)%&gt; &lt;%=ifnull(p.Unit_of_Measure,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=ifnull(p.Received_Quantity,0)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=ifnull(p.Damaged_Quantity,0)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=ifnull(p.Accepted_Quantity,0)%&gt; / &lt;%=ifnull(p.Rejected_Quantity,0)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;strong&gt;&lt;%=ifnull(p.Serial_Number_Details,&quot;No serials&quot;)%&gt;&lt;/strong&gt;&lt;br&gt;&lt;%=ifnull(p.Receiving_Remarks,&quot;&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;div class=&apos;mobile-list zcs-direction-column zcs-gap-12&apos;&gt;&lt;%for each pm in products{%&gt;&lt;div class=&apos;record-card&apos;&gt;&lt;h4&gt;&lt;%=pm.Product_Name%&gt;&lt;/h4&gt;&lt;div class=&apos;record-meta&apos;&gt;&lt;span&gt;Expected: &lt;%=ifnull(pm.Expected_Quantity,0)%&gt;&lt;/span&gt;&lt;span&gt;Received: &lt;%=ifnull(pm.Received_Quantity,0)%&gt;&lt;/span&gt;&lt;span&gt;Accepted: &lt;%=ifnull(pm.Accepted_Quantity,0)%&gt;&lt;/span&gt;&lt;span&gt;Rejected: &lt;%=ifnull(pm.Rejected_Quantity,0)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p&gt;&lt;strong&gt;Serials:&lt;/strong&gt; &lt;%=ifnull(pm.Serial_Number_Details,&quot;Not set&quot;)%&gt;&lt;/p&gt;&lt;p&gt;&lt;%=ifnull(pm.Receiving_Remarks,&quot;&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/section&gt;\n&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h2 class=&apos;section-title&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt; Quality control&lt;/h2&gt;&lt;span class=&apos;section-count&apos;&gt;&lt;%=qcRows.count()%&gt; checks | &lt;%=qcExceptions%&gt; exceptions&lt;/span&gt;&lt;/div&gt;&lt;%if(qcRows.count()==0){%&gt;&lt;div class=&apos;empty&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;strong&gt;No quality checks recorded&lt;/strong&gt;&lt;span&gt;QC results and defect findings will appear after receiving begins.&lt;/span&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;Product / serial&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;PO&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Received / inspected&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Accepted / rejected&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;Result&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;Defects&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;Remarks&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%for each qc in qcRows{qcb=&quot;zcs-badge-yellow&quot;;if(qc.Quality_Result==&quot;Passed&quot;){qcb=&quot;zcs-badge-green&quot;;}else if(qc.Quality_Result==&quot;Failed&quot;){qcb=&quot;zcs-badge-red&quot;;}%&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;strong&gt;&lt;%=qc.Product_Name%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;%=ifnull(qc.Brand_Make,&quot;&quot;)%&gt; &lt;%=ifnull(qc.Model,&quot;&quot;)%&gt; | &lt;%=ifnull(qc.Serial_Number,&quot;No serial&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=qc.Purchase_Order.Purchase_Order_ID%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=ifnull(qc.Received_Quantity,0)%&gt; / &lt;%=ifnull(qc.Inspected_Quantity,0)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=ifnull(qc.Accepted_Quantity,0)%&gt; / &lt;%=ifnull(qc.Rejected_Quantity,0)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;zcs-badge zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=qcb%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=if(qc.Quality_Result==&quot;Passed&quot;,&quot;ui-1-check-circle-08&quot;,if(qc.Quality_Result==&quot;Failed&quot;,&quot;ui-1-circle-remove&quot;,&quot;ui-2-alert-circle&quot;))%&gt;&apos;&gt;&lt;/i&gt;&lt;%=ifnull(qc.Quality_Result,&quot;Pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(qc.Defect_Details,&quot;No defects recorded&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(qc.Inspection_Remarks,&quot;&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;div class=&apos;mobile-list zcs-direction-column zcs-gap-12&apos;&gt;&lt;%for each qcm in qcRows{%&gt;&lt;div class=&apos;record-card&apos;&gt;&lt;h4&gt;&lt;%=qcm.Product_Name%&gt; | &lt;%=ifnull(qcm.Quality_Result,&quot;Pending&quot;)%&gt;&lt;/h4&gt;&lt;div class=&apos;record-meta&apos;&gt;&lt;span&gt;Inspected: &lt;%=ifnull(qcm.Inspected_Quantity,0)%&gt;&lt;/span&gt;&lt;span&gt;Accepted: &lt;%=ifnull(qcm.Accepted_Quantity,0)%&gt;&lt;/span&gt;&lt;span&gt;Rejected: &lt;%=ifnull(qcm.Rejected_Quantity,0)%&gt;&lt;/span&gt;&lt;span&gt;Serial: &lt;%=ifnull(qcm.Serial_Number,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p&gt;&lt;strong&gt;Defects:&lt;/strong&gt; &lt;%=ifnull(qcm.Defect_Details,&quot;None recorded&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/section&gt;\n&lt;div class=&apos;two-col&apos;&gt;&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;&lt;h2 class=&apos;section-title&apos;&gt;Receiving and quality team&lt;/h2&gt;&lt;div class=&apos;info-grid&apos; style=&apos;grid-template-columns:repeat(2,minmax(0,1fr))&apos;&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Received by&lt;/label&gt;&lt;strong&gt;&lt;%=ifnull(b.Received_By.Employee_Name,&quot;Not set&quot;)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Received date&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(b.Received_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Quality checked by&lt;/label&gt;&lt;strong&gt;&lt;%=ifnull(b.Quality_Checked_By.Employee_Name,&quot;Not set&quot;)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Quality check date&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(b.Quality_Check_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Quality check summary&lt;/label&gt;&lt;p class=&apos;text-block&apos;&gt;&lt;%=ifnull(b.Quality_Check_Summary,&quot;Not set&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Receiving remarks&lt;/label&gt;&lt;p class=&apos;text-block&apos;&gt;&lt;%=ifnull(b.Receiving_Remarks,&quot;Not set&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/section&gt;&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;&lt;h2 class=&apos;section-title&apos;&gt;Documents and completion&lt;/h2&gt;&lt;div class=&apos;docs&apos;&gt;&lt;%if(b.Transport_Documents != null){%&gt;&lt;a class=&apos;doc&apos; href=&apos;#Report:All_Logistics_Bookings?ID=&lt;%=b.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;span&gt;Transport documents&lt;/span&gt;&lt;/a&gt;&lt;%}else{%&gt;&lt;div class=&apos;empty&apos;&gt;No transport document uploaded&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;p class=&apos;zcs-color-tertiary&apos;&gt;&lt;%if(canMark){%&gt;Receipt quantities and QC results are complete. The booking can be marked received.&lt;%}else if(b.Status==&quot;Products Received&quot;){%&gt;Receipt and QC are completed.&lt;%}else{%&gt;Mark Received becomes available when every product is fully received and quality results cover inspected quantities.&lt;%}%&gt;&lt;/p&gt;&lt;/section&gt;&lt;/div&gt;\n&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos; style=&apos;margin-bottom:18px&apos;&gt;&lt;h2 class=&apos;section-title&apos; style=&apos;margin:0&apos;&gt;Booking history&lt;/h2&gt;&lt;a class=&apos;link&apos; href=&apos;#Report:All_Histories?Logistics_Booking_Lookup=&lt;%=b.ID%&gt;&apos;&gt;Open report&lt;/a&gt;&lt;/div&gt;&lt;%if(histories.count()==0){%&gt;&lt;div class=&apos;empty&apos;&gt;No history entries&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;timeline-scroll&apos;&gt;&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-24 zcs-p-0 zcs-m-0&apos;&gt;&lt;%for each h in histories{%&gt;&lt;li class=&apos;zcs-tl-li zcs-relative&apos; style=&apos;list-style:none&apos;&gt;&lt;div class=&apos;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&apos;&gt;&lt;span class=&apos;zcs-tl-dot zcs-rounded-half zcs-mt-8 zcs-relative&apos;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;timeline-content&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&apos;&gt;&lt;strong class=&apos;zcs-font-16&apos;&gt;&lt;%=h.Action_Type%&gt;&lt;/strong&gt;&lt;%if(h.Status != null || h.New_Status != null){%&gt;&lt;span class=&apos;zcs-badge zcs-badge-blue zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;%=ifnull(h.New_Status,h.Status)%&gt;&lt;/span&gt;&lt;%}%&gt;&lt;/div&gt;&lt;div class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;%=h.Updated_Date_Time%&gt; by &lt;%=ifnull(h.Updated_By.Employee_Name,h.Updated_By_Email)%&gt;&lt;%if(h.Previous_Status != null){%&gt; | &lt;%=h.Previous_Status%&gt; to &lt;%=ifnull(h.New_Status,h.Status)%&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%if(h.Comments != null){%&gt;&lt;p class=&apos;zcs-mt-8 zcs-mb-0&apos;&gt;&lt;%=h.Comments%&gt;&lt;/p&gt;&lt;%}%&gt;&lt;%if(h.Subform_Details_Change_Summary != null){%&gt;&lt;p class=&apos;zcs-mt-8 zcs-mb-0 zcs-color-tertiary&apos;&gt;&lt;%=h.Subform_Details_Change_Summary%&gt;&lt;/p&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/li&gt;&lt;%}%&gt;&lt;/ul&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/section&gt;\n&lt;/div&gt;&lt;%}%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Logistics_Bookings
		{
					displayname = "Logistics Bookings"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Logistics_Bookings_List' elementName='Logistics_Bookings_List'>\n\t\t\t\t\t<![CDATA[htmlpage Logistics_Bookings_List()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nbookings = Create_Logistics_Booking[ID != 0] sort by Booking_Date desc;\neligiblePaidCount = 0;\nfor each paidPO in Create_Purchase_Order[Status == &quot;Invoice Paid&quot;]\n{\n\t\tif(Logistics_Booking_Purchase_Order[Purchase_Order == paidPO.ID].count() == 0)\n\t\t{\n\t\t\t\teligiblePaidCount = eligiblePaidCount + 1;\n\t\t}\n}\nnewCount = 0;\nreceiptCount = 0;\nqcCountSummary = 0;\ncompletedCount = 0;\nexceptionCount = 0;\noverdueCount = 0;\nfor each summaryBooking in bookings\n{\n\t\tsummaryStatus = ifnull(summaryBooking.Status,&quot;Unknown&quot;);\n\t\tsummaryPORows = Logistics_Booking_Purchase_Order[Parent_Logistics_Booking == summaryBooking.ID];\n\t\tsummaryProductRows = Logistics_Booking_Product[Parent_Logistics_Booking == summaryBooking.ID];\n\t\tsummaryQCRows = Logistics_Quality_Check_Product[Parent_Logistics_Booking == summaryBooking.ID];\n\t\tsummaryReceiptDone = summaryBooking.Received_Date != null;\n\t\tsummaryQCDone = summaryBooking.Quality_Check_Date != null;\n\t\tsummaryCompleted = summaryStatus == &quot;Products Received&quot;;\n\t\tsummaryQuantityIssue = false;\n\t\tsummaryDamageIssue = false;\n\t\tsummaryQCIssue = false;\n\t\tfor each summaryProduct in summaryProductRows\n\t\t{\n\t\t\t\tif(ifnull(summaryProduct.Received_Quantity,0) &lt; ifnull(summaryProduct.Expected_Quantity,0)){summaryQuantityIssue = true;}\n\t\t\t\tif(ifnull(summaryProduct.Damaged_Quantity,0) &gt; 0 || ifnull(summaryProduct.Rejected_Quantity,0) &gt; 0){summaryDamageIssue = true;}\n\t\t}\n\t\tfor each summaryQC in summaryQCRows\n\t\t{\n\t\t\t\tif(summaryQC.Quality_Result == &quot;Failed&quot; || summaryQC.Quality_Result == &quot;Partially Passed&quot; || ifnull(summaryQC.Rejected_Quantity,0) &gt; 0){summaryQCIssue = true;}\n\t\t}\n\t\tsummaryOverdue = summaryBooking.Expected_Arrival_Date != null &amp;&amp; summaryBooking.Expected_Arrival_Date &lt; zoho.currentdate &amp;&amp; summaryBooking.Actual_Arrival_Date == null &amp;&amp; !summaryCompleted;\n\t\tsummaryHasException = summaryBooking.Tracking_Reference == null || summaryBooking.Tracking_Reference == &quot;&quot; || summaryPORows.count() == 0 || summaryProductRows.count() == 0 || summaryOverdue || summaryQuantityIssue || summaryDamageIssue || summaryQCIssue || (summaryReceiptDone &amp;&amp; !summaryQCDone);\n\t\tif(summaryStatus == &quot;New&quot;){newCount = newCount + 1;}\n\t\tif(summaryReceiptDone &amp;&amp; !summaryQCDone){receiptCount = receiptCount + 1;}\n\t\tif(summaryQCDone &amp;&amp; !summaryCompleted){qcCountSummary = qcCountSummary + 1;}\n\t\tif(summaryCompleted){completedCount = completedCount + 1;}\n\t\tif(summaryHasException){exceptionCount = exceptionCount + 1;}\n\t\tif(summaryOverdue){overdueCount = overdueCount + 1;}\n}\n%&gt;\n&lt;style&gt;\n/* ZCS global utility subset used by this page (zcs-global) */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color,#6147e5);--zcs-page-bg-color:#f3f3f4;--zcs-primary-text-color:var(--zcs_primary_text_color,#1c1c40);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#65657a);--zcs-border-color:var(--zcs_tertiary_border_color,#e7e7ee);--zcs-white-color:#fff;font-size:16px;line-height:1.5}*{box-sizing:border-box}a{text-decoration:none}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-direction-column{flex-direction:column}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-p-0{padding:0}.zcs-p-20{padding:1.25rem}.zcs-px-8{padding-left:.5rem;padding-right:.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-24{font-size:1.5rem}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-tertiary{color:var(--zcs-secondary-text-color)}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:10px}.zcs-sticky{position:sticky}.zcs-m-0{margin:0}\n/* ZCS horizontal-tab-horizontal-tab-with-count */\n.zcs-horizontal-tabhead{box-shadow:0 -1px 0 var(--zcs-border-color) inset;overflow-x:auto;overflow-y:hidden;list-style:none}.zcs-horizontal-tabitem{list-style:none;border-bottom:2px solid transparent;white-space:nowrap}.zcs-horizontal-tablink{color:var(--zcs-secondary-text-color)}.zcs-horizontal-tabcount{min-width:20px;background:var(--zcs-page-bg-color)}\n/* ZCS table-table-with-custom-action-button-icon */\n.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:#fff;overflow:auto;border-radius:8px}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper thead{top:0;z-index:3}.zcs-table-wrapper th{background:#f9fafe;box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap;text-align:left;font-weight:600}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color);vertical-align:top}.zcs-table-wrapper tbody tr:hover td{background:#fafafe}.zcs-custom-btn{display:inline-flex;align-items:center;gap:5px;border:1px solid var(--zcs-border-color);background:#fff;color:var(--zcs-primary-text-color);transition:.2s}.zcs-custom-btn:hover{border-color:var(--zcs_brand_color,#6147e5);color:var(--zcs_brand_color,#6147e5);background:var(--zcs_component_hover_color,#f1edff)}\n/* ZCS badge-filled-outlined-badge */\n.zcs-badge{width:auto;border:1px solid}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#137a55}.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#8a5b00}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#1d55c5}.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#b52035}.zcs-badge-grey{background:#eee;border-color:#777;color:#4d4d55}\n/* ZCS progress-bar-range-bar-with-text */\n.zcs-progress-bar{height:7px;background:var(--zcs_component_hover_color,#ece9fa);border-radius:4px;overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color,#6147e5)}\n.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%}.zc-container-wrapper .zc-main-content .inner .zc-page-content-wrapper .zc-pb-page-content-wrapper .elemContainment,.zc-full-height .zc-page-content-wrapper .zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important;border-radius:0!important}#splash-screen{display:none!important}\n.logistics-page{height:100%;overflow:hidden;background:var(--zcs-page-bg-color);padding:14px;font:14px/1.45 Arial,sans-serif;color:var(--zcs-primary-text-color)}.page-header{padding:4px 2px 12px}.page-header h1{margin:0 0 3px;font-size:22px;font-weight:600}.page-header p{margin:0;color:var(--zcs-secondary-text-color);font-size:13px}.summary-strip{display:grid;grid-template-columns:repeat(5,minmax(120px,1fr));gap:8px;margin-bottom:10px}.summary-card{padding:10px 12px;background:#fff;border:1px solid var(--zcs-border-color);border-radius:8px}.summary-card i{font-size:16px;color:var(--zcs_brand_color,#6147e5)}.summary-value{font-size:18px;font-weight:600;line-height:1.1}.summary-label{font-size:11px;color:var(--zcs-secondary-text-color);margin-top:3px}.filter-input{position:absolute;opacity:0;pointer-events:none}.filter-bar{background:#fff;border:1px solid var(--zcs-border-color);border-radius:8px 8px 0 0;overflow:hidden}.filter-bar .zcs-horizontal-tabhead{padding-left:6px}.filter-bar label{cursor:pointer}.filter-input:focus+.filter-bar label[for=&apos;filter-all&apos;]{outline:2px solid var(--zcs_brand_color,#6147e5);outline-offset:-2px}#filter-all:checked~.filter-bar label[for=&apos;filter-all&apos;],#filter-new:checked~.filter-bar label[for=&apos;filter-new&apos;],#filter-receipt:checked~.filter-bar label[for=&apos;filter-receipt&apos;],#filter-qc:checked~.filter-bar label[for=&apos;filter-qc&apos;],#filter-complete:checked~.filter-bar label[for=&apos;filter-complete&apos;],#filter-exception:checked~.filter-bar label[for=&apos;filter-exception&apos;],#filter-overdue:checked~.filter-bar label[for=&apos;filter-overdue&apos;]{color:var(--zcs_brand_color,#6147e5)}#filter-all:checked~.filter-bar label[for=&apos;filter-all&apos;] li,#filter-new:checked~.filter-bar label[for=&apos;filter-new&apos;] li,#filter-receipt:checked~.filter-bar label[for=&apos;filter-receipt&apos;] li,#filter-qc:checked~.filter-bar label[for=&apos;filter-qc&apos;] li,#filter-complete:checked~.filter-bar label[for=&apos;filter-complete&apos;] li,#filter-exception:checked~.filter-bar label[for=&apos;filter-exception&apos;] li,#filter-overdue:checked~.filter-bar label[for=&apos;filter-overdue&apos;] li{border-bottom-color:var(--zcs_brand_color,#6147e5)}.register-shell{height:calc(100% - 188px);overflow:hidden}.register-scroll{height:100%;border-radius:0 0 8px 8px}.register-table{min-width:1160px}.shipment-row{display:none}#filter-all:checked~.register-shell .shipment-row,#filter-new:checked~.register-shell .is-new,#filter-receipt:checked~.register-shell .is-receipt,#filter-qc:checked~.register-shell .is-qc,#filter-complete:checked~.register-shell .is-complete,#filter-exception:checked~.register-shell .has-exception,#filter-overdue:checked~.register-shell .is-overdue{display:table-row}.record-link{font-weight:600;color:var(--zcs_brand_color,#6147e5)}.subtle{display:block;color:var(--zcs-secondary-text-color);font-size:12px;margin-top:3px}.route{min-width:145px}.dates{min-width:135px}.scope{min-width:115px}.progress-cell{min-width:165px}.progress-label{display:flex;justify-content:space-between;margin-bottom:5px;font-size:12px}.milestone-dots{display:flex;justify-content:space-between;margin-top:6px}.milestone-dots span{width:7px;height:7px;border-radius:50%;background:#d8d8e2}.milestone-dots span.done{background:var(--zcs_brand_color,#6147e5)}.exception-stack{display:flex;flex-direction:column;align-items:flex-start;gap:4px;min-width:145px}.actions{display:flex;flex-wrap:wrap;gap:5px;min-width:150px}.empty{height:100%;min-height:260px;text-align:center}.empty h3{margin:10px 0 4px;font-size:18px}.empty p{max-width:520px;margin:0 auto;color:var(--zcs-secondary-text-color)}\n@media(max-width:760px){.logistics-page{height:auto;min-height:100%;overflow:auto;padding:10px}.page-header h1{font-size:20px}.summary-strip{grid-template-columns:repeat(2,1fr)}.summary-card:last-child{grid-column:1/-1}.filter-bar{position:sticky;top:0;z-index:5}.register-shell{height:auto;overflow:visible}.register-scroll{height:auto;border:0;background:transparent;overflow:visible}.register-table{min-width:0;display:block}.register-table thead{display:none}.register-table tbody{display:block}.register-table .shipment-row{grid-template-columns:1fr 1fr;background:#fff;border:1px solid var(--zcs-border-color);border-radius:10px;margin:10px 0;overflow:hidden}.register-table td{display:block;border:0!important;padding:10px 12px!important}.register-table td:first-child{grid-column:1/-1;background:#f9fafe}.register-table td:last-child{grid-column:1/-1}.register-table td:before{content:attr(data-label);display:block;margin-bottom:3px;color:var(--zcs-secondary-text-color);font-size:10px;font-weight:600;text-transform:uppercase}.register-table td:first-child:before{display:none}#filter-all:checked~.register-shell .shipment-row,#filter-new:checked~.register-shell .is-new,#filter-receipt:checked~.register-shell .is-receipt,#filter-qc:checked~.register-shell .is-qc,#filter-complete:checked~.register-shell .is-complete,#filter-exception:checked~.register-shell .has-exception,#filter-overdue:checked~.register-shell .is-overdue{display:grid}.progress-cell,.actions,.exception-stack,.route,.dates,.scope{min-width:0}.actions .zcs-custom-btn{flex:1 1 auto;justify-content:center}}\n@media(max-width:430px){.register-table .shipment-row{grid-template-columns:1fr}.register-table td,.register-table td:first-child,.register-table td:last-child{grid-column:1}.summary-strip{grid-template-columns:1fr 1fr}}\n&lt;/style&gt;\n&lt;div class=&apos;logistics-page&apos;&gt;\n\t&lt;header class=&apos;page-header&apos;&gt;&lt;h1&gt;Shipment register&lt;/h1&gt;&lt;p&gt;Read milestones, delays, and receiving exceptions at a glance.&lt;/p&gt;&lt;/header&gt;\n\t&lt;div class=&apos;summary-strip&apos;&gt;\n\t\t&lt;div class=&apos;summary-card zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;i class=&apos;zc-li-outline files-3-box&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=bookings.count()%&gt;&lt;/div&gt;&lt;div class=&apos;summary-label&apos;&gt;Total bookings&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;summary-card zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;i class=&apos;zc-li-outline loader-dots-06&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=newCount%&gt;&lt;/div&gt;&lt;div class=&apos;summary-label&apos;&gt;Open shipments&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;summary-card zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-alert-circle&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=exceptionCount%&gt;&lt;/div&gt;&lt;div class=&apos;summary-label&apos;&gt;With exceptions&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;summary-card zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=overdueCount%&gt;&lt;/div&gt;&lt;div class=&apos;summary-label&apos;&gt;Arrival overdue&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;summary-card zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-bill&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=eligiblePaidCount%&gt;&lt;/div&gt;&lt;div class=&apos;summary-label&apos;&gt;Paid orders ready to book&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;input class=&apos;filter-input&apos; type=&apos;radio&apos; name=&apos;shipment-filter&apos; id=&apos;filter-all&apos; checked&gt;\n\t&lt;input class=&apos;filter-input&apos; type=&apos;radio&apos; name=&apos;shipment-filter&apos; id=&apos;filter-new&apos;&gt;\n\t&lt;input class=&apos;filter-input&apos; type=&apos;radio&apos; name=&apos;shipment-filter&apos; id=&apos;filter-receipt&apos;&gt;\n\t&lt;input class=&apos;filter-input&apos; type=&apos;radio&apos; name=&apos;shipment-filter&apos; id=&apos;filter-qc&apos;&gt;\n\t&lt;input class=&apos;filter-input&apos; type=&apos;radio&apos; name=&apos;shipment-filter&apos; id=&apos;filter-complete&apos;&gt;\n\t&lt;input class=&apos;filter-input&apos; type=&apos;radio&apos; name=&apos;shipment-filter&apos; id=&apos;filter-exception&apos;&gt;\n\t&lt;input class=&apos;filter-input&apos; type=&apos;radio&apos; name=&apos;shipment-filter&apos; id=&apos;filter-overdue&apos;&gt;\n\t&lt;nav class=&apos;filter-bar zcs-horizontal-tabpanel&apos; aria-label=&apos;Shipment milestone and status filters&apos;&gt;&lt;ul class=&apos;zcs-horizontal-tabhead zcs-flex zcs-gap-6 zcs-m-0 zcs-p-0&apos;&gt;\n\t\t&lt;label for=&apos;filter-all&apos;&gt;&lt;li class=&apos;zcs-horizontal-tabitem&apos;&gt;&lt;span class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-10&apos;&gt;&lt;span&gt;All&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=bookings.count()%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;/label&gt;\n\t\t&lt;label for=&apos;filter-new&apos;&gt;&lt;li class=&apos;zcs-horizontal-tabitem&apos;&gt;&lt;span class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-10&apos;&gt;&lt;span&gt;New&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=newCount%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;/label&gt;\n\t\t&lt;label for=&apos;filter-receipt&apos;&gt;&lt;li class=&apos;zcs-horizontal-tabitem&apos;&gt;&lt;span class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-10&apos;&gt;&lt;span&gt;Receipt recorded&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=receiptCount%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;/label&gt;\n\t\t&lt;label for=&apos;filter-qc&apos;&gt;&lt;li class=&apos;zcs-horizontal-tabitem&apos;&gt;&lt;span class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-10&apos;&gt;&lt;span&gt;QC recorded&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=qcCountSummary%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;/label&gt;\n\t\t&lt;label for=&apos;filter-complete&apos;&gt;&lt;li class=&apos;zcs-horizontal-tabitem&apos;&gt;&lt;span class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-10&apos;&gt;&lt;span&gt;Completed&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=completedCount%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;/label&gt;\n\t\t&lt;label for=&apos;filter-exception&apos;&gt;&lt;li class=&apos;zcs-horizontal-tabitem&apos;&gt;&lt;span class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-10&apos;&gt;&lt;span&gt;Exceptions&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=exceptionCount%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;/label&gt;\n\t\t&lt;label for=&apos;filter-overdue&apos;&gt;&lt;li class=&apos;zcs-horizontal-tabitem&apos;&gt;&lt;span class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-10&apos;&gt;&lt;span&gt;Overdue&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12&apos;&gt;&lt;%=overdueCount%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;/label&gt;\n\t&lt;/ul&gt;&lt;/nav&gt;\n\t&lt;section class=&apos;register-shell&apos;&gt;\n\t&lt;%if(bookings.count() == 0){%&gt;\n\t\t&lt;div class=&apos;empty zcs-card zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;i class=&apos;zc-li-outline files-3-box zcs-font-24 zcs-color-tertiary&apos;&gt;&lt;/i&gt;&lt;h3&gt;No logistics bookings&lt;/h3&gt;&lt;p&gt;Bookings appear here after an eligible invoice-paid purchase order is assigned to a shipment.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;%}else{%&gt;\n\t\t&lt;div class=&apos;register-scroll zcs-table-wrapper&apos;&gt;&lt;table class=&apos;register-table zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8&apos;&gt;Booking / provider&lt;/th&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8&apos;&gt;Route / tracking&lt;/th&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8&apos;&gt;Dates&lt;/th&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8&apos;&gt;Scope&lt;/th&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8&apos;&gt;Milestone&lt;/th&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8&apos;&gt;Exceptions&lt;/th&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8&apos;&gt;Status&lt;/th&gt;&lt;th class=&apos;zcs-px-12 zcs-py-8&apos;&gt;Actions&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t&lt;%for each booking in bookings\n\t\t{\n\t\t\t\tstatusValue = ifnull(booking.Status,&quot;Unknown&quot;);\n\t\t\t\tpoRows = Logistics_Booking_Purchase_Order[Parent_Logistics_Booking == booking.ID];\n\t\t\t\tproductRows = Logistics_Booking_Product[Parent_Logistics_Booking == booking.ID];\n\t\t\t\tqcRows = Logistics_Quality_Check_Product[Parent_Logistics_Booking == booking.ID];\n\t\t\t\tpoCount = poRows.count(); productCount = productRows.count(); qcCount = qcRows.count();\n\t\t\t\treceiptDone = booking.Received_Date != null;\n\t\t\t\tqcDone = booking.Quality_Check_Date != null;\n\t\t\t\tcompleted = statusValue == &quot;Products Received&quot;;\n\t\t\t\treadyToComplete = receiptDone &amp;&amp; qcDone &amp;&amp; productCount &gt; 0 &amp;&amp; qcCount &gt; 0;\n\t\t\t\tquantityIssue = false; damageIssue = false; qcIssue = false;\n\t\t\t\tfor each productRow in productRows\n\t\t\t\t{\n\t\t\t\t\t\texpectedQty = ifnull(productRow.Expected_Quantity,0);\n\t\t\t\t\t\treceivedQty = ifnull(productRow.Received_Quantity,0);\n\t\t\t\t\t\tif(receivedQty &lt; expectedQty){quantityIssue = true; readyToComplete = false;}\n\t\t\t\t\t\tif(ifnull(productRow.Damaged_Quantity,0) &gt; 0 || ifnull(productRow.Rejected_Quantity,0) &gt; 0){damageIssue = true;}\n\t\t\t\t\t\tinspectedQty = ifnull(Logistics_Quality_Check_Product[Logistics_Booking_Product == productRow.ID].sum(Inspected_Quantity),0);\n\t\t\t\t\t\tif(inspectedQty &lt; receivedQty){readyToComplete = false;}\n\t\t\t\t}\n\t\t\t\tfor each qcRow in qcRows\n\t\t\t\t{\n\t\t\t\t\t\tif(qcRow.Quality_Result == &quot;Failed&quot; || qcRow.Quality_Result == &quot;Partially Passed&quot; || ifnull(qcRow.Rejected_Quantity,0) &gt; 0){qcIssue = true;}\n\t\t\t\t}\n\t\t\t\toverdue = booking.Expected_Arrival_Date != null &amp;&amp; booking.Expected_Arrival_Date &lt; zoho.currentdate &amp;&amp; booking.Actual_Arrival_Date == null &amp;&amp; !completed;\n\t\t\t\thasException = booking.Tracking_Reference == null || booking.Tracking_Reference == &quot;&quot; || poCount == 0 || productCount == 0 || overdue || quantityIssue || damageIssue || qcIssue || (receiptDone &amp;&amp; !qcDone);\n\t\t\t\tprogress = 25; milestoneLabel = &quot;Booked&quot;;\n\t\t\t\tif(receiptDone){progress = 50; milestoneLabel = &quot;Receipt recorded&quot;;}\n\t\t\t\tif(qcDone){progress = 75; milestoneLabel = &quot;QC recorded&quot;;}\n\t\t\t\tif(completed){progress = 100; milestoneLabel = &quot;Completed&quot;;}\n\t\t\t\tbadgeClass = &quot;zcs-badge-grey&quot;; badgeIcon = &quot;ui-2-help&quot;;\n\t\t\t\tif(statusValue == &quot;New&quot;){badgeClass = &quot;zcs-badge-blue&quot;; badgeIcon = &quot;loader-dots-06&quot;;}\n\t\t\t\tif(completed){badgeClass = &quot;zcs-badge-green&quot;; badgeIcon = &quot;ui-1-check-circle-08&quot;;}\n\t\t\t\trowClass = &quot;shipment-row&quot;;\n\t\t\t\tif(statusValue == &quot;New&quot;){rowClass = rowClass + &quot; is-new&quot;;}\n\t\t\t\tif(receiptDone &amp;&amp; !qcDone){rowClass = rowClass + &quot; is-receipt&quot;;}\n\t\t\t\tif(qcDone &amp;&amp; !completed){rowClass = rowClass + &quot; is-qc&quot;;}\n\t\t\t\tif(completed){rowClass = rowClass + &quot; is-complete&quot;;}\n\t\t\t\tif(hasException){rowClass = rowClass + &quot; has-exception&quot;;}\n\t\t\t\tif(overdue){rowClass = rowClass + &quot; is-overdue&quot;;}\n\t\t%&gt;\n\t\t\t&lt;tr class=&apos;&lt;%=rowClass%&gt;&apos;&gt;\n\t\t\t\t&lt;td data-label=&apos;Booking / provider&apos; class=&apos;zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Logistics_Booking_Detail?Logistics_Booking_ID=&lt;%=booking.ID%&gt;&apos;&gt;Booking &lt;%=booking.Logistics_Booking_ID%&gt;&lt;/a&gt;&lt;span class=&apos;subtle&apos;&gt;&lt;%=ifnull(booking.Logistics_Provider,&quot;Provider not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t&lt;td data-label=&apos;Route / tracking&apos; class=&apos;route zcs-px-12 zcs-py-8&apos;&gt;&lt;span class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos;&gt;&lt;i class=&apos;zc-li-outline location-pin&apos;&gt;&lt;/i&gt;&lt;%=ifnull(booking.Pickup_Location,&quot;Origin not set&quot;)%&gt;&lt;/span&gt;&lt;span class=&apos;subtle&apos;&gt;To &lt;%=ifnull(booking.Warehouse_Destination,&quot;destination not set&quot;)%&gt;&lt;/span&gt;&lt;span class=&apos;subtle&apos;&gt;Tracking: &lt;%=ifnull(booking.Tracking_Reference,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t&lt;td data-label=&apos;Dates&apos; class=&apos;dates zcs-px-12 zcs-py-8&apos;&gt;Booked: &lt;%=ifnull(booking.Booking_Date,&quot;Not set&quot;)%&gt;&lt;span class=&apos;subtle&apos;&gt;Expected: &lt;%=ifnull(booking.Expected_Arrival_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;span class=&apos;subtle&apos;&gt;Actual: &lt;%=ifnull(booking.Actual_Arrival_Date,&quot;Pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t&lt;td data-label=&apos;Scope&apos; class=&apos;scope zcs-px-12 zcs-py-8&apos;&gt;&lt;strong&gt;&lt;%=poCount%&gt;&lt;/strong&gt; purchase orders&lt;span class=&apos;subtle&apos;&gt;&lt;%=productCount%&gt; products · &lt;%=qcCount%&gt; QC rows&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t&lt;td data-label=&apos;Milestone&apos; class=&apos;progress-cell zcs-px-12 zcs-py-8&apos;&gt;&lt;div class=&apos;progress-label&apos;&gt;&lt;span&gt;&lt;%=milestoneLabel%&gt;&lt;/span&gt;&lt;strong&gt;&lt;%=progress%&gt;%&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=progress%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;milestone-dots&apos; aria-label=&apos;Booked, receipt, quality check, complete&apos;&gt;&lt;span class=&apos;done&apos;&gt;&lt;/span&gt;&lt;span class=&apos;&lt;%if(receiptDone){%&gt;done&lt;%}%&gt;&apos;&gt;&lt;/span&gt;&lt;span class=&apos;&lt;%if(qcDone){%&gt;done&lt;%}%&gt;&apos;&gt;&lt;/span&gt;&lt;span class=&apos;&lt;%if(completed){%&gt;done&lt;%}%&gt;&apos;&gt;&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t&lt;td data-label=&apos;Exceptions&apos; class=&apos;zcs-px-12 zcs-py-8&apos;&gt;&lt;div class=&apos;exception-stack&apos;&gt;&lt;%if(booking.Tracking_Reference == null || booking.Tracking_Reference == &quot;&quot;){%&gt;&lt;span class=&apos;zcs-badge zcs-badge-red zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-sm zcs-px-8 zcs-py-2 zcs-font-12&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;Missing tracking&lt;/span&gt;&lt;%}%&gt;&lt;%if(poCount == 0 || productCount == 0){%&gt;&lt;span class=&apos;zcs-badge zcs-badge-red zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-sm zcs-px-8 zcs-py-2 zcs-font-12&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;Missing shipment links&lt;/span&gt;&lt;%}%&gt;&lt;%if(overdue){%&gt;&lt;span class=&apos;zcs-badge zcs-badge-red zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-sm zcs-px-8 zcs-py-2 zcs-font-12&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;Arrival overdue&lt;/span&gt;&lt;%}%&gt;&lt;%if(quantityIssue){%&gt;&lt;span class=&apos;zcs-badge zcs-badge-yellow zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-sm zcs-px-8 zcs-py-2 zcs-font-12&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-alert-circle&apos;&gt;&lt;/i&gt;Quantity short&lt;/span&gt;&lt;%}%&gt;&lt;%if(damageIssue || qcIssue){%&gt;&lt;span class=&apos;zcs-badge zcs-badge-red zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-sm zcs-px-8 zcs-py-2 zcs-font-12&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-alert-circle&apos;&gt;&lt;/i&gt;QC exception&lt;/span&gt;&lt;%}%&gt;&lt;%if(receiptDone &amp;&amp; !qcDone){%&gt;&lt;span class=&apos;zcs-badge zcs-badge-yellow zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-sm zcs-px-8 zcs-py-2 zcs-font-12&apos;&gt;&lt;i class=&apos;zc-li-outline loader-dots-06&apos;&gt;&lt;/i&gt;QC pending&lt;/span&gt;&lt;%}%&gt;&lt;%if(!hasException){%&gt;&lt;span class=&apos;zcs-badge zcs-badge-green zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-sm zcs-px-8 zcs-py-2 zcs-font-12&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;Clear&lt;/span&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t&lt;td data-label=&apos;Status&apos; class=&apos;zcs-px-12 zcs-py-8&apos;&gt;&lt;span class=&apos;zcs-badge &lt;%=badgeClass%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=badgeIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;%=statusValue%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t&lt;td data-label=&apos;Actions&apos; class=&apos;zcs-px-12 zcs-py-8&apos;&gt;&lt;div class=&apos;actions&apos;&gt;&lt;a class=&apos;zcs-custom-btn zcs-px-10 zcs-py-6 zcs-rounded-sm&apos; href=&apos;#Page:Logistics_Booking_Detail?Logistics_Booking_ID=&lt;%=booking.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-eye-17&apos;&gt;&lt;/i&gt;View&lt;/a&gt;&lt;%if(statusValue == &quot;New&quot; &amp;&amp; !receiptDone){%&gt;&lt;a class=&apos;zcs-custom-btn zcs-px-10 zcs-py-6 zcs-rounded-sm&apos; href=&apos;#Form:Create_Logistics_Booking?recLinkID=&lt;%=booking.ID%&gt;&amp;amp;viewLinkName=All_Logistics_Bookings&amp;amp;Action_Mode=Receipt&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline files-3-box&apos;&gt;&lt;/i&gt;Receipt&lt;/a&gt;&lt;%}else if(statusValue == &quot;New&quot; &amp;&amp; receiptDone &amp;&amp; !qcDone){%&gt;&lt;a class=&apos;zcs-custom-btn zcs-px-10 zcs-py-6 zcs-rounded-sm&apos; href=&apos;#Form:Create_Logistics_Booking?recLinkID=&lt;%=booking.ID%&gt;&amp;amp;viewLinkName=All_Logistics_Bookings&amp;amp;Action_Mode=Quality Check&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;QC&lt;/a&gt;&lt;%}else if(statusValue == &quot;New&quot; &amp;&amp; readyToComplete){%&gt;&lt;a class=&apos;zcs-custom-btn zcs-px-10 zcs-py-6 zcs-rounded-sm&apos; href=&apos;#Form:Create_Logistics_Booking?recLinkID=&lt;%=booking.ID%&gt;&amp;amp;viewLinkName=All_Logistics_Bookings&amp;amp;Action_Mode=Products Received&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-small&apos;&gt;&lt;/i&gt;Complete&lt;/a&gt;&lt;%}%&gt;&lt;a class=&apos;zcs-custom-btn zcs-px-10 zcs-py-6 zcs-rounded-sm&apos; href=&apos;#Report:All_Histories?Logistics_Booking_Lookup=&lt;%=booking.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;History&lt;/a&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t&lt;/tr&gt;\n\t\t&lt;%}%&gt;\n\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t&lt;%}%&gt;\n\t&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Logistics_Dashboard
		{
					displayname = "Logistics Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Logistics_Operations' elementName='Logistics_Operations'>\n\t\t\t\t\t<![CDATA[htmlpage Logistics_Operations()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\npaidPOs = Create_Purchase_Order[Status == &quot;Invoice Paid&quot;] sort by Expected_Delivery_Date asc;\ninboundBookings = Create_Logistics_Booking[Status == &quot;New&quot;] sort by Expected_Arrival_Date asc;\nreceiptRows = Logistics_Booking_Product[Parent_Logistics_Booking.Status == &quot;New&quot;] sort by Product_Name asc;\nqcExceptions = Logistics_Quality_Check_Product[Quality_Result == &quot;Failed&quot; || Quality_Result == &quot;Partially Passed&quot;] sort by ID desc;\ndeliveryReadyPOs = Create_Purchase_Order[Status == &quot;Products Received&quot;] sort by Expected_Delivery_Date asc;\nrecentDeliveries = Create_Purchase_Order[Status == &quot;Delivered&quot; &amp;&amp; Delivery_Date &gt;= zoho.currentdate.subDay(30)] sort by Delivery_Date desc;\npaidCount = paidPOs.count();\ninboundCount = inboundBookings.count();\nreceiptWorkCount = 0;\nfor each receiptCalc in receiptRows\n{\n\t\texpectedCalc = ifnull(receiptCalc.Expected_Quantity,0);\n\t\treceivedCalc = ifnull(receiptCalc.Received_Quantity,0);\n\t\tif(receivedCalc &lt; expectedCalc)\n\t\t{\n\t\t\t\treceiptWorkCount = receiptWorkCount + 1;\n\t\t}\n}\nqcExceptionCount = qcExceptions.count();\nreadyCount = deliveryReadyPOs.count();\nrecentCount = recentDeliveries.count();\n%&gt;\n&lt;style&gt;\n/* zcs-global utility subset, included once for this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;--zcs-page-bg-color:#f7f6fb;--zcs-thead-color:#f7f5fc;font-size:16px;line-height:1.5}*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-p-0{padding:0}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-rounded-sm{border-radius:.25rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-24{font-size:1.5rem}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-card{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.zcs-list-none{list-style:none}\n/* badge-filled-badge */.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent;color:#fff}.zcs-badge-theme{background:#6f4bb8}.zcs-badge-green{background:#179e6c}.zcs-badge-yellow{background:#c98412}.zcs-badge-blue{background:#496fc8}.zcs-badge-orange{background:#e36d22}.zcs-badge-red{background:#d74657}\n/* table-simple-table */.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:690px}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper thead th{background:var(--zcs-thead-color);box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper tbody td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tbody tr:hover td{background:#faf9fd}\n/* progress-bar-range-bar-with-texts */.zcs-progress-bar{height:7px;background:#ece8f4;border-radius:4px}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:#7350b8}\n/* stepper-in-progress adapted for compact lifecycle routes */.route{display:flex;align-items:center;margin-top:10px;min-width:390px}.route-step{display:flex;align-items:center;flex:1;color:var(--zcs-teritiary-text-color);font-size:11px;white-space:nowrap}.route-step:before{content:&apos;&apos;;width:9px;height:9px;border-radius:50%;border:2px solid #d7d1e2;background:#fff;margin-right:5px}.route-step:not(:last-child):after{content:&apos;&apos;;height:2px;background:#ded9e8;flex:1;margin:0 6px}.route-step.done{color:#523781;font-weight:600}.route-step.done:before,.route-step.done:not(:last-child):after{border-color:#7350b8;background:#7350b8}\n/* card-template-default, no-data-no-data-text-only, and page composition */\ndiv#zppagesLive,div#elementsContainer,.Layout.elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%!important;padding:0!important}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}#splash-screen{display:none!important}.logistics-dashboard{width:100%;min-height:100%;padding:18px;background:var(--zcs-page-bg-color);font-family:Arial,sans-serif;font-size:14px;color:var(--zcs-primary-text-color)}.dashboard-header{padding:22px 24px;background:linear-gradient(135deg,#38245f,#65429b 62%,#8061b4);color:#fff;border-radius:14px}.dashboard-header h1{color:#fff}.dashboard-header p{margin-top:5px;color:rgba(255,255,255,.84)}.lifecycle-strip{display:grid;grid-template-columns:repeat(6,minmax(115px,1fr));gap:10px;margin-top:12px}.summary-card{padding:13px 14px;min-height:78px;border-top:3px solid #8061b4}.summary-card.attention{border-top-color:#d74657}.summary-card.success{border-top-color:#179e6c}.summary-value{font-size:22px;font-weight:600;line-height:1.2}.summary-label{margin-top:5px;color:var(--zcs-secondary-text-color);font-size:12px}.ops-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:14px}.ops-section{overflow:hidden;min-width:0}.section-head{height:66px;padding:12px 15px;border-bottom:1px solid var(--zcs_tertiary_border_color);background:#fcfbfe}.section-title{display:flex;align-items:center;gap:9px}.section-icon{width:30px;height:30px;border-radius:8px;background:#eee9f7;color:#63439a;display:inline-flex;align-items:center;justify-content:center;font-size:16px}.section-head h2{font-size:16px;font-weight:600;margin:0}.section-total{margin-top:2px;color:var(--zcs-secondary-text-color);font-size:12px}.section-body{height:310px;overflow:auto;padding:8px 12px}.record-list{list-style:none;margin:0;padding:0}.record-item{padding:11px 4px;border-bottom:1px solid var(--zcs_tertiary_border_color)}.record-item:last-child{border-bottom:0}.record-top{display:flex;align-items:center;justify-content:space-between;gap:8px}.record-title,.action-link{color:#63439a;font-weight:600;text-decoration:none}.record-title{color:var(--zcs-primary-text-color)}.record-title:hover,.action-link:hover{text-decoration:underline}.record-meta{display:flex;flex-wrap:wrap;gap:5px 14px;margin-top:6px;color:var(--zcs-secondary-text-color);font-size:13px}.no-data{height:100%;min-height:180px}.wide{grid-column:1/-1}.wide .section-body{height:340px;padding:0}.progress-wrap{margin-top:9px}.progress-copy{display:flex;justify-content:space-between;margin-bottom:4px;font-size:12px;color:var(--zcs-secondary-text-color)}.mobile-cards{display:none}\n@media(max-width:1100px){.lifecycle-strip{grid-template-columns:repeat(3,1fr)}}@media(max-width:760px){.logistics-dashboard{padding:10px}.lifecycle-strip{grid-template-columns:repeat(2,1fr)}.ops-grid{grid-template-columns:1fr}.wide{grid-column:auto}.section-body,.wide .section-body{height:330px;padding:8px}.desktop-table{display:none}.mobile-cards{display:block}.record-item{padding:11px}.route{overflow:auto;padding-bottom:4px}.dashboard-header{padding:18px}}\n&lt;/style&gt;\n&lt;div class=&apos;logistics-dashboard&apos;&gt;\n\t&lt;header class=&apos;dashboard-header&apos;&gt;&lt;h1 class=&apos;zcs-font-24 zcs-font-semibold zcs-m-0&apos;&gt;Logistics Operations&lt;/h1&gt;&lt;p class=&apos;zcs-font-14 zcs-m-0&apos;&gt;Booking through receiving, quality control, delivery, and completion.&lt;/p&gt;&lt;/header&gt;\n\t&lt;div class=&apos;lifecycle-strip&apos;&gt;\n\t\t&lt;div class=&apos;summary-card zcs-card&apos;&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=paidCount%&gt;&lt;/div&gt;&lt;div class=&apos;summary-label&apos;&gt;Awaiting booking&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;summary-card zcs-card&apos;&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=inboundCount%&gt;&lt;/div&gt;&lt;div class=&apos;summary-label&apos;&gt;Inbound shipments&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;summary-card zcs-card&apos;&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=receiptWorkCount%&gt;&lt;/div&gt;&lt;div class=&apos;summary-label&apos;&gt;Receiving rows open&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;summary-card zcs-card attention&apos;&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=qcExceptionCount%&gt;&lt;/div&gt;&lt;div class=&apos;summary-label&apos;&gt;QC exceptions&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;summary-card zcs-card&apos;&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=readyCount%&gt;&lt;/div&gt;&lt;div class=&apos;summary-label&apos;&gt;Ready for delivery&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;summary-card zcs-card success&apos;&gt;&lt;div class=&apos;summary-value&apos;&gt;&lt;%=recentCount%&gt;&lt;/div&gt;&lt;div class=&apos;summary-label&apos;&gt;Completed in 30 days&lt;/div&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;main class=&apos;ops-grid&apos;&gt;\n\t\t&lt;section class=&apos;ops-section zcs-card&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;span class=&apos;section-icon&apos;&gt;&lt;i class=&apos;zc-li-outline files-file-add&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Bookings&lt;/h2&gt;&lt;div class=&apos;section-total&apos;&gt;&lt;%=paidCount%&gt; paid orders ready to book&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;section-body&apos;&gt;\n\t\t\t&lt;%if(paidCount == 0){%&gt;&lt;div class=&apos;zcs-nodata-wrapper no-data zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08 zcs-font-24&apos;&gt;&lt;/i&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-m-0&apos;&gt;No paid orders require booking&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;ul class=&apos;record-list&apos;&gt;&lt;%for each po in paidPOs{supplierName=&quot;Not set&quot;;if(po.Supplier != null){supplierName=ifnull(po.Supplier.Supplier_Name,&quot;Not set&quot;);}%&gt;&lt;li class=&apos;record-item&apos;&gt;&lt;div class=&apos;record-top&apos;&gt;&lt;a class=&apos;record-title&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=po.ID%&gt;&apos;&gt;PO &lt;%=po.Purchase_Order_ID%&gt;&lt;/a&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-theme zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;Invoice Paid&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;record-meta&apos;&gt;&lt;span&gt;&lt;%=supplierName%&gt;&lt;/span&gt;&lt;span&gt;Expected &lt;%=ifnull(po.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;span&gt;&lt;%=ifnull(po.Currency,&quot;&quot;)%&gt; &lt;%=ifnull(po.Supplier_Price,0)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;route&apos;&gt;&lt;span class=&apos;route-step done&apos;&gt;Paid&lt;/span&gt;&lt;span class=&apos;route-step&apos;&gt;Booked&lt;/span&gt;&lt;span class=&apos;route-step&apos;&gt;Received&lt;/span&gt;&lt;span class=&apos;route-step&apos;&gt;QC&lt;/span&gt;&lt;span class=&apos;route-step&apos;&gt;Delivered&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;&lt;%}%&gt;&lt;/ul&gt;&lt;%}%&gt;\n\t\t&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;ops-section zcs-card&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;span class=&apos;section-icon&apos;&gt;&lt;i class=&apos;zc-li-outline transportation-truck-front&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Inbound Shipments&lt;/h2&gt;&lt;div class=&apos;section-total&apos;&gt;&lt;%=inboundCount%&gt; active bookings&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;section-body&apos;&gt;\n\t\t\t&lt;%if(inboundCount == 0){%&gt;&lt;div class=&apos;no-data zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div&gt;&lt;i class=&apos;zc-li-outline transportation-truck-front zcs-font-24&apos;&gt;&lt;/i&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium&apos;&gt;No shipments are currently inbound&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;ul class=&apos;record-list&apos;&gt;&lt;%for each booking in inboundBookings{%&gt;&lt;li class=&apos;record-item&apos;&gt;&lt;div class=&apos;record-top&apos;&gt;&lt;a class=&apos;record-title&apos; href=&apos;#Page:Logistics_Booking_Detail?Logistics_Booking_ID=&lt;%=booking.ID%&gt;&apos;&gt;Booking &lt;%=booking.Logistics_Booking_ID%&gt;&lt;/a&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;Inbound&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;record-meta&apos;&gt;&lt;span&gt;&lt;%=ifnull(booking.Logistics_Provider,&quot;Provider not set&quot;)%&gt;&lt;/span&gt;&lt;span&gt;&lt;%=ifnull(booking.Pickup_Location,&quot;Origin not set&quot;)%&gt; to &lt;%=ifnull(booking.Warehouse_Destination,&quot;Destination not set&quot;)%&gt;&lt;/span&gt;&lt;span&gt;ETA &lt;%=ifnull(booking.Expected_Arrival_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;span&gt;Tracking &lt;%=ifnull(booking.Tracking_Reference,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;route&apos;&gt;&lt;span class=&apos;route-step done&apos;&gt;Paid&lt;/span&gt;&lt;span class=&apos;route-step done&apos;&gt;Booked&lt;/span&gt;&lt;span class=&apos;route-step&apos;&gt;Received&lt;/span&gt;&lt;span class=&apos;route-step&apos;&gt;QC&lt;/span&gt;&lt;span class=&apos;route-step&apos;&gt;Delivered&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;&lt;%}%&gt;&lt;/ul&gt;&lt;%}%&gt;\n\t\t&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;ops-section zcs-card wide&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;span class=&apos;section-icon&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-box&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Receiving&lt;/h2&gt;&lt;div class=&apos;section-total&apos;&gt;&lt;%=receiptWorkCount%&gt; product rows with quantities outstanding&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;section-body&apos;&gt;\n\t\t\t&lt;%if(receiptWorkCount == 0){%&gt;&lt;div class=&apos;no-data zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium&apos;&gt;All inbound quantities are recorded&lt;/h5&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;zcs-table-wrapper desktop-table zcs-relative&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Booking&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Product&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Expected&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Received&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Remaining&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Progress&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Workflow&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%for each receiptLine in receiptRows{expected=ifnull(receiptLine.Expected_Quantity,0);received=ifnull(receiptLine.Received_Quantity,0);remaining=expected-received;if(remaining &gt; 0){receiptPercent=0;if(expected &gt; 0){receiptPercent=(received * 100) / expected;}%&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=receiptLine.Parent_Logistics_Booking.Logistics_Booking_ID%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(receiptLine.Product_Name,&quot;Product&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=expected%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=received%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=remaining%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=receiptPercent%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;a class=&apos;action-link&apos; href=&apos;#Page:Logistics_Booking_Detail?Logistics_Booking_ID=&lt;%=receiptLine.Parent_Logistics_Booking.ID%&gt;&apos;&gt;Record receipt&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;ul class=&apos;record-list mobile-cards&apos;&gt;&lt;%for each rowCard in receiptRows{cardExpected=ifnull(rowCard.Expected_Quantity,0);cardReceived=ifnull(rowCard.Received_Quantity,0);cardRemaining=cardExpected-cardReceived;if(cardRemaining &gt; 0){cardPercent=0;if(cardExpected &gt; 0){cardPercent=(cardReceived * 100) / cardExpected;}%&gt;&lt;li class=&apos;record-item&apos;&gt;&lt;a class=&apos;record-title&apos; href=&apos;#Page:Logistics_Booking_Detail?Logistics_Booking_ID=&lt;%=rowCard.Parent_Logistics_Booking.ID%&gt;&apos;&gt;&lt;%=ifnull(rowCard.Product_Name,&quot;Product&quot;)%&gt;&lt;/a&gt;&lt;div class=&apos;record-meta&apos;&gt;&lt;span&gt;Booking &lt;%=rowCard.Parent_Logistics_Booking.Logistics_Booking_ID%&gt;&lt;/span&gt;&lt;span&gt;&lt;%=cardReceived%&gt; of &lt;%=cardExpected%&gt; received&lt;/span&gt;&lt;span&gt;&lt;%=cardRemaining%&gt; remaining&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;progress-wrap&apos;&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=cardPercent%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;&lt;%}}%&gt;&lt;/ul&gt;&lt;%}%&gt;\n\t\t&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;ops-section zcs-card&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;span class=&apos;section-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-search-zoom-in&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Quality Control&lt;/h2&gt;&lt;div class=&apos;section-total&apos;&gt;&lt;%=qcExceptionCount%&gt; checks need disposition&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;section-body&apos;&gt;\n\t\t\t&lt;%if(qcExceptionCount == 0){%&gt;&lt;div class=&apos;no-data zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium&apos;&gt;No quality checks need attention&lt;/h5&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;ul class=&apos;record-list&apos;&gt;&lt;%for each qcStage in qcExceptions{qcStageClass=&quot;zcs-badge-orange&quot;;if(qcStage.Quality_Result == &quot;Failed&quot;){qcStageClass=&quot;zcs-badge-red&quot;;}%&gt;&lt;li class=&apos;record-item&apos;&gt;&lt;div class=&apos;record-top&apos;&gt;&lt;a class=&apos;record-title&apos; href=&apos;#Page:Logistics_Booking_Detail?Logistics_Booking_ID=&lt;%=qcStage.Parent_Logistics_Booking.ID%&gt;&apos;&gt;&lt;%=ifnull(qcStage.Product_Name,&quot;Product&quot;)%&gt;&lt;/a&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled &lt;%=qcStageClass%&gt; zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;%=ifnull(qcStage.Quality_Result,&quot;Review&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;record-meta&apos;&gt;&lt;span&gt;Booking &lt;%=qcStage.Parent_Logistics_Booking.Logistics_Booking_ID%&gt;&lt;/span&gt;&lt;span&gt;Inspected &lt;%=ifnull(qcStage.Inspected_Quantity,0)%&gt;&lt;/span&gt;&lt;span&gt;Rejected &lt;%=ifnull(qcStage.Rejected_Quantity,0)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;&lt;%}%&gt;&lt;/ul&gt;&lt;%}%&gt;\n\t\t&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;ops-section zcs-card&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;span class=&apos;section-icon&apos;&gt;&lt;i class=&apos;zc-li-outline transportation-delivery-fast&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Delivery&lt;/h2&gt;&lt;div class=&apos;section-total&apos;&gt;&lt;%=readyCount%&gt; received orders ready for handoff&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;section-body&apos;&gt;\n\t\t\t&lt;%if(readyCount == 0){%&gt;&lt;div class=&apos;no-data zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium&apos;&gt;No orders are ready for delivery&lt;/h5&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;ul class=&apos;record-list&apos;&gt;&lt;%for each readyPO in deliveryReadyPOs{customerName=&quot;Not set&quot;;if(readyPO.Customer != null){customerName=ifnull(readyPO.Customer.Customer_Name,&quot;Not set&quot;);}%&gt;&lt;li class=&apos;record-item&apos;&gt;&lt;div class=&apos;record-top&apos;&gt;&lt;a class=&apos;record-title&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=readyPO.ID%&gt;&apos;&gt;PO &lt;%=readyPO.Purchase_Order_ID%&gt;&lt;/a&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-green zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;Ready&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;record-meta&apos;&gt;&lt;span&gt;Customer &lt;%=customerName%&gt;&lt;/span&gt;&lt;span&gt;Target &lt;%=ifnull(readyPO.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;route&apos;&gt;&lt;span class=&apos;route-step done&apos;&gt;Paid&lt;/span&gt;&lt;span class=&apos;route-step done&apos;&gt;Booked&lt;/span&gt;&lt;span class=&apos;route-step done&apos;&gt;Received&lt;/span&gt;&lt;span class=&apos;route-step done&apos;&gt;QC&lt;/span&gt;&lt;span class=&apos;route-step&apos;&gt;Delivered&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;&lt;%}%&gt;&lt;/ul&gt;&lt;%}%&gt;\n\t\t&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;ops-section zcs-card&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;span class=&apos;section-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-alert-circle&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Exceptions&lt;/h2&gt;&lt;div class=&apos;section-total&apos;&gt;&lt;%=qcExceptionCount%&gt; failed or partially passed checks&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;section-body&apos;&gt;\n\t\t\t&lt;%if(qcExceptionCount == 0){%&gt;&lt;div class=&apos;no-data zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium&apos;&gt;No quality exceptions require attention&lt;/h5&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;ul class=&apos;record-list&apos;&gt;&lt;%for each qc in qcExceptions{badgeClass=&quot;zcs-badge-orange&quot;;if(qc.Quality_Result == &quot;Failed&quot;){badgeClass=&quot;zcs-badge-red&quot;;}%&gt;&lt;li class=&apos;record-item&apos;&gt;&lt;div class=&apos;record-top&apos;&gt;&lt;a class=&apos;record-title&apos; href=&apos;#Page:Logistics_Booking_Detail?Logistics_Booking_ID=&lt;%=qc.Parent_Logistics_Booking.ID%&gt;&apos;&gt;&lt;%=ifnull(qc.Product_Name,&quot;Product&quot;)%&gt;&lt;/a&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled &lt;%=badgeClass%&gt; zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;%=ifnull(qc.Quality_Result,&quot;Review&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;record-meta&apos;&gt;&lt;span&gt;Booking &lt;%=qc.Parent_Logistics_Booking.Logistics_Booking_ID%&gt;&lt;/span&gt;&lt;span&gt;&lt;%=ifnull(qc.Defect_Details,&quot;No defect detail entered&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;&lt;%}%&gt;&lt;/ul&gt;&lt;%}%&gt;\n\t\t&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;ops-section zcs-card&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;div class=&apos;section-title&apos;&gt;&lt;span class=&apos;section-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Completion&lt;/h2&gt;&lt;div class=&apos;section-total&apos;&gt;&lt;%=recentCount%&gt; delivered in the last 30 days&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;section-body&apos;&gt;\n\t\t\t&lt;%if(recentCount == 0){%&gt;&lt;div class=&apos;no-data zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium&apos;&gt;No recent delivery completions&lt;/h5&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;ul class=&apos;record-list&apos;&gt;&lt;%for each deliveredPO in recentDeliveries{deliveredCustomer=&quot;Not set&quot;;deliveredByName=&quot;Not set&quot;;if(deliveredPO.Customer != null){deliveredCustomer=ifnull(deliveredPO.Customer.Customer_Name,&quot;Not set&quot;);}if(deliveredPO.Delivered_By != null){deliveredByName=ifnull(deliveredPO.Delivered_By.Employee_Name,&quot;Not set&quot;);}%&gt;&lt;li class=&apos;record-item&apos;&gt;&lt;div class=&apos;record-top&apos;&gt;&lt;a class=&apos;record-title&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=deliveredPO.ID%&gt;&apos;&gt;PO &lt;%=deliveredPO.Purchase_Order_ID%&gt;&lt;/a&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-green zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;Delivered&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;record-meta&apos;&gt;&lt;span&gt;Customer &lt;%=deliveredCustomer%&gt;&lt;/span&gt;&lt;span&gt;Completed &lt;%=ifnull(deliveredPO.Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;span&gt;Delivered by &lt;%=deliveredByName%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;route&apos;&gt;&lt;span class=&apos;route-step done&apos;&gt;Paid&lt;/span&gt;&lt;span class=&apos;route-step done&apos;&gt;Booked&lt;/span&gt;&lt;span class=&apos;route-step done&apos;&gt;Received&lt;/span&gt;&lt;span class=&apos;route-step done&apos;&gt;QC&lt;/span&gt;&lt;span class=&apos;route-step done&apos;&gt;Delivered&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;&lt;%}%&gt;&lt;/ul&gt;&lt;%}%&gt;\n\t\t&lt;/div&gt;&lt;/section&gt;\n\t&lt;/main&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Other_Config(int Tab)
		{
					displayname = "Other Config"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet' elementName='HTML Snippet' bgColor='#FFFFFF'>\n\t\t\t\t\t<![CDATA[htmlpage html_snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%=thisapp.styles.getReportNavigationTemplate(1,&quot;&quot;,&quot;&quot;,&quot;#818181&quot;,&quot;&quot;,&quot;&quot;)%&gt;\n&lt;div class=&quot;MainDiv&quot;&gt;\n\t&lt;div class=&quot;shiftChart&quot;&gt;\n\t\t\t\t\t\t&lt;div elName=&apos;zc-component&apos; formLinkName=&apos;Navigation&apos; class=&quot;dashboard-nav navigation underline-model&quot; params=&apos;zc_Header=false&amp;zc_Focus=false&amp;Page_Name=Other_Config&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div elName=&apos;zc-component&apos; class=&quot;show-div&quot; name=&quot;showFrame&quot;&gt;&lt;/div&gt;\n\t\t\t\t &lt;/div&gt;\n\t\t &lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Preference(string subtab, string tab)
		{
					displayname = "Setup"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet2' elementName='HTML Snippet' bgColor='#FFFFFF'>\n\t\t\t\t\t<![CDATA[htmlpage html_snippet2()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tpage_link_name = &quot;Preference&quot;;\n\tlanguage = thisapp.Localization.Pages();\n\tcommon = thisapp.Localization.Common();\n\ttab_map = thisapp.Page.Get_Tabs(page_link_name);\n\ttab_keys = tab_map.keys();\n\tinput.tab = if(input.tab == &quot;&quot; || input.tab == null,tab_keys.get(0),input.tab);\n\tinput.tab = if(!tab_keys.contains(input.tab),tab_keys.get(0),input.tab);\n\tinput.subtab = if(input.subtab == null || input.subtab == &quot;null&quot;, &quot;&quot;, input.subtab);\n\tif(input.tab != &quot;&quot; &amp;&amp; input.tab != &quot;null&quot; &amp;&amp; input.tab != null)\n\t{\n\t\t%&gt;\n&lt;style&gt;\n/*temp*/\n.zcform_Delete_form .form-action.formbutton {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: center;\n}\n.zcform_Create_Template .label-left .second-column, .zcform_Create_Template .label-right .second-column {\n\t\twidth: calc(100% - 670px) !important;\n}\n.zcform_Create_Template .second-column .notes-field {\n\t\twidth: 100% !important;\n}\nform[name=&quot;Delete_form&quot;].label-left {\n\t\twidth: 370px !important;\n\t}\n.zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead li a:hover {\n\t\tbackground: var(--component_hover_color);\n}\n.zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead li a{\n\tborder-radius: 99px !important;\n}\n.zc-pra-setup .zc-pra-page-container-inner{\n\t    padding: 0px 10px 0 10px !important;\n}\n.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper.zc-page-content-wrapper .elemContainment {\n\t\tpadding: unset !important;\n}\n.zc_live_adminbar .zc-container-wrapper {\n\t\theight: 100% !important; \n\t}\n\t.zc_live_adminbar .zc-container-wrapper {\n\t\theight: 100% !important;\n\t}\ndiv#zppagesLive,\ndiv#elementsContainer,\n.Layout.elemContainment,\ndiv#row_1,\n.zc-pb-formreport-placeholder {\n\theight: 100% !important;\n}\n.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper .view-outer-wrapper .view-header .zc-new-report-header{\n\t  height: unset !important; \n\t padding: unset !important; \n}\n .zc-pra-page-container .view-header .zc-new-report-header {\n\t height: unset !important; \n}\n.zc-pra-setup .zc-reporttype-list .list-view-inner {\nborder: unset !important; \nborder-radius: unset !important; \n}\n .zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper .view-outer-wrapper .view-header.zc-show-new-menu .view-options.zc-report-newheader {\n\t\ttop: -0.625rem !important;\n}\n.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper .view-outer-wrapper .view-header {\n\tborder: unset !important;}\n/*temp*/\n&lt;%=thisapp.styles.CommonStyles()%&gt;\n&lt;%=thisapp.PageStyles.Setup(input.tab)%&gt;\n/* Active state */\n.zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead li a.&lt;%=if(input.tab.isEmpty() == false &amp;&amp; input.subtab.isEmpty() == false,input.subtab,input.tab)%&gt; {\n\t  background-color: var(--theme_brand_color) !important;\n\t\tcolor: white !important;\n\t\tfont-weight: 600;\n\t \n}\n.zc-content-loader, .zc-content-loader div {\n\t \tdisplay: none !important;\n}\n&lt;/style&gt;\n\n&lt;div class=&apos;zc-pra-page-container zc-pra-setup&apos;&gt;\n\t&lt;div class=&apos;zc-pra-page-container-inner zc-pra-fwh&apos;&gt;\n\t\t&lt;div class=&apos;zc-pra-card zc-pra-fwh&apos;&gt;\n\t\t\t&lt;div class=&apos;zc-pra-page-header&apos;&gt;\n\t\t\t\t&lt;h5&gt; &lt;%=language.get(&quot;zcp.setup.setup.title&quot;)%&gt; &lt;/h5&gt;\n\t\t\t\t&lt;p&gt; &lt;%=language.get(&quot;zcp.setup.setuppending&quot;)%&gt; &lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zc-pra-page-content zc-pra-vertical-tabpanel zc-pra-clearfix zc-pra-fwh&apos;&gt;\n\t\t\t&lt;ul class=&apos;zc-pra-vertical-tabhead zc-pra-flt-left&apos;&gt;\n&lt;%\n\t\tid_index = 1;\n\t\tfor each  tab_id in tab_map\n\t\t{\n\t\t\ttab_key = tab_map.toCollection().getKey(tab_id);\n\t\t\t%&gt;\n&lt;li &lt;%=if(tab_id.get(&quot;sub_menu&quot;) != null,&quot;class=zc-pra-vertical-tab-comp&quot;,null)%&gt;&gt;\n\t\t&lt;input name=&quot;zc-pra-tab&quot; type=&quot;checkbox&quot;  id=&apos;tab&lt;%=id_index%&gt;&apos; &lt;%=if(input.tab == tab_key,&quot;checked&quot;,null)%&gt;&gt; \n\t\t&lt;label for=&quot;tab&lt;%=id_index%&gt;&quot;&gt;\n&lt;%\n\t\t\tif(tab_id.get(&quot;sub_menu&quot;) == null)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;a href=&apos;#Page:&lt;%=page_link_name%&gt;?tab=&lt;%=tab_key%&gt;&apos; class=&apos;&lt;%=tab_key%&gt;&apos;&gt; &lt;%=tab_id.get(&quot;Display&quot;)%&gt; &lt;/a&gt;\n&lt;%\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;a  class=&apos;&lt;%=tab_key%&gt;&apos;&gt; &lt;%=tab_id.get(&quot;Display&quot;)%&gt;&lt;/a&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/label&gt;\n&lt;%\n\t\t\tif(tab_id.get(&quot;sub_menu&quot;) != null)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;ul class=&apos;zc-pra-vertical-tabsubmenu&apos;&gt;\n&lt;%\n\t\t\t\tsub_id_index = 1;\n\t\t\t\tsub_menu = tab_id.get(&quot;sub_menu&quot;);\n\t\t\t\tfor each  sub_item in sub_menu\n\t\t\t\t{\n\t\t\t\t\tsub_menu_key = sub_menu.toCollection().getKey(sub_item);\n\t\t\t\t\t%&gt;\n&lt;li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;input type=&apos;checkbox&apos; name=&apos;zc-pra-subtab&apos; id=&apos;subtab&lt;%=id_index + &quot;&quot; + sub_id_index%&gt;&apos; &lt;%=if(input.subtab == sub_menu_key,&quot;checked&quot;,null)%&gt;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;label for=&apos;subtab&lt;%=id_index + &quot;&quot; + sub_id_index%&gt;&apos;&gt; &lt;a class=&apos;&lt;%=sub_menu_key%&gt;&apos; href=&quot;#Page:&lt;%=page_link_name%&gt;?tab=&lt;%=tab_key%&gt;&amp;subtab=&lt;%=sub_menu_key%&gt;&quot;&gt; &lt;%=sub_item.get(&quot;Display&quot;)%&gt; &lt;/a&gt; &lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;/li&gt;\n&lt;%\n\t\t\t\t\tsub_id_index = sub_id_index + 1;\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;/ul&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/li&gt;\n&lt;%\n\t\t\tid_index = id_index + 1;\n\t\t}\n\t\t%&gt;\n&lt;/ul&gt;\n\n\t\t\t\t&lt;div class=&apos;zc-pra-vertical-tabbody zc-pra-flt-left &lt;%=input.tab%&gt;&apos;&gt;\n&lt;%\n\t\tif(tab_keys.contains(input.tab))\n\t\t{\n\t\t\tparam = &quot;&quot;;\n\t\t\tif(tab_map.get(input.tab).get(&quot;Comp&quot;) == &quot;Form&quot;)\n\t\t\t{\n\t\t\t\tif(tab_map.get(input.tab).get(&quot;Link&quot;) == &quot;Add_Preference&quot;)\n\t\t\t\t{\n\t\t\t\t\tfetchPreference = Add_Preference[ID != null];\n\t\t\t\t\tif(fetchPreference.count() != 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tpreferenceID = fetchPreference.ID;\n\t\t\t\t\t\tif(fetchPreference.Organization_Logo == &quot;&quot; || fetchPreference.Organization_Logo == null)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tres = invokeurl\n\t\t\t\t\t\t\t[\n\t\t\t\t\t\t\t\turl :&quot;https://files-accl.zohoexternal.com/public/workdrive-external/download/h814669ae0987327a4404804a6236ce5e7438?x-cli-msg=%7B%22linkId%22%3A%226OxchGOzv8B-J8HFH%22%2C%22isFileOwner%22%3Afalse%2C%22version%22%3A%221.0%22%2C%22isWDSupport%22%3Afalse%7D&quot;\n\t\t\t\t\t\t\t\ttype :GET\n\t\t\t\t\t\t\t];\n\t\t\t\t\t\t\tres.setParamName(&quot;file&quot;);\n\t\t\t\t\t\t\tres.setFileName(&quot;Creator_Logo&quot; + &quot;.png&quot;);\n\t\t\t\t\t\t\tresponse = invokeurl\n\t\t\t\t\t\t\t[\n\t\t\t\t\t\t\t\turl :&quot;https://www.zohoapis.com/creator/v2.1/data&quot; + zoho.appuri + &quot;report/All_Preferences/&quot; + fetchPreference.ID + &quot;/Organization_Logo/upload&quot;\n\t\t\t\t\t\t\t\ttype :POST\n\t\t\t\t\t\t\t\tfiles:res\n\t\t\t\t\t\t\t\tconnection:&quot;creator&quot;\n\t\t\t\t\t\t\t];\n\t\t\t\t\t\t}\n\t\t\t\t\t\t%&gt;\n&lt;div elName=&apos;zc-component&apos; name=&apos;embedDiv&apos; formLinkName=&apos;Add_Preference&apos; params=&apos;viewLinkName=All_Preferences&amp;recLinkID=&lt;%=fetchPreference.ID%&gt;&apos;&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\tinsert into Add_Preference\n\t\t\t\t\t\t[\n\t\t\t\t\t\t\tAdded_User=zoho.loginuser\n\t\t\t\t\t\t\tEmail_Notification=true\n\t\t\t\t\t\t]\n\t\t\t\t\t\topenUrl(&quot;#Script:page.refresh&quot;,&quot;same window&quot;);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\t%&gt;\n&lt;div elName=&apos;zc-component&apos; name=&apos;embedDiv&apos; formLinkName=&apos;&lt;%=tab_map.get(input.tab).get(&quot;Link&quot;)%&gt;&apos; params=&apos;&lt;%=param%&gt;zc_NextUrl=#Script:page.reload&apos;&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tif(input.tab in {&quot;categories&quot;,&quot;brands&quot;,&quot;departments&quot;})\n\t\t\t\t{\n\t\t\t\t\t%&gt;\n&lt;style&gt;\n&lt;%=thisapp.PageStyles.Preferences_Report_Filter()%&gt;\n&lt;/style&gt;\n&lt;div class=&apos;zc-pra-filter&apos; elName=&apos;zc-component&apos; formLinkName=&apos;Preferences_Filter&apos; params=&apos;zc_Header=false&amp;Report=&lt;%=tab_map.get(input.tab).get(&quot;Link&quot;)%&gt;&amp;Page=Preferences&amp;zc_Focus=false&apos;&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;div elName=&apos;zc-component&apos; name=&apos;embedDiv&apos; viewLinkName=&apos;&lt;%=tab_map.get(input.tab).get(&quot;Link&quot;)%&gt;&apos; params=&apos;zc_Footer=false&amp;zc_Search=false&amp;zc_MoreAction=false&amp;zc_ColMenu=false&amp;zc_RecSelect=false&apos;&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Product_Detail(int Product_ID)
		{
					displayname = "Product Detail"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Product_Detail_Snippet' elementName='Product_Detail_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Product_Detail_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nproductList = Add_Product[ID == input.Product_ID];\nleadRows = Lead_Product[Product == input.Product_ID] sort by ID desc;\nsoRows = Sales_Order_Product[Product == input.Product_ID] sort by ID desc;\nquoteRows = Supplier_Quote_Product[Product == input.Product_ID] sort by ID desc;\npoRows = Purchase_Order_Product[Product == input.Product_ID] sort by ID desc;\ninvoiceRows = Supplier_Invoice_Product[Product == input.Product_ID] sort by ID desc;\nlogisticsRows = Logistics_Booking_Product[Product == input.Product_ID] sort by ID desc;\nreturnRows = Return_Request_Product[Product == input.Product_ID] sort by ID desc;\n%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#f5f6f8;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-white-color:#fff;--zcs-border-color:var(--zcs_tertiary_border_color);font-size:16px;line-height:1.5}*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-p-0{padding:0}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:.625rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-box-border{box-sizing:border-box}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-22{font-size:1.375rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-sticky{position:sticky}a{text-decoration:none}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important;border-radius:0!important}#splash-screen{display:none!important}\n.product-detail-page{min-height:100%;padding:18px;background:var(--zcs-page-bg-color);font:14px/1.5 Arial,sans-serif;color:var(--zcs-primary-text-color)}.detail-shell{max-width:1480px;margin:auto}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.identity-header{padding:16px 18px;margin-bottom:14px}.identity-main{min-width:0}.zcs-back{width:34px;height:34px;border:1px solid var(--zcs_tertiary_border_color);border-radius:8px;color:var(--zcs_tertiary_text_color);flex:0 0 auto}.zcs-back:hover{background:var(--zcs_component_hover_color)}.identity-kicker{font-size:12px;color:var(--zcs_brand_color);font-weight:700;letter-spacing:.04em;text-transform:uppercase}.identity-title{font-size:23px;line-height:1.2;margin:2px 0 4px;overflow-wrap:anywhere}.identity-meta{display:flex;gap:7px;flex-wrap:wrap;color:var(--zcs-secondary-text-color)}.meta-chip{padding:2px 7px;background:#f4f5f8;border-radius:5px}.header-side{display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}.zcs-badge{width:auto;border:1px solid;gap:6px}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#087c51}.zcs-badge-grey{background:#ececf1;border-color:#686875;color:#35353d}.overview-grid{display:grid;grid-template-columns:240px minmax(0,1fr);gap:14px;margin-bottom:14px}.media-card,.spec-card,.narrative-card,.lifecycle-card,.usage-card{padding:16px}.product-image{height:180px;display:flex;align-items:center;justify-content:center;border:1px solid var(--zcs_tertiary_border_color);border-radius:9px;background:#f8f9fc;overflow:hidden}.product-image img{width:100%;height:100%;object-fit:contain}.product-image i{font-size:42px;color:var(--zcs_brand_color)}.document-list{display:grid;gap:7px;margin-top:10px}.document-link{display:flex;align-items:center;gap:7px;padding:7px 8px;border:1px solid var(--zcs_tertiary_border_color);border-radius:6px;color:var(--zcs_brand_color);overflow-wrap:anywhere}.document-link.is-empty{color:var(--zcs-secondary-text-color);background:#fafafa}.section-title{font-size:15px;font-weight:650;margin:0}.section-caption{font-size:12px;color:var(--zcs-secondary-text-color);margin-top:2px}.spec-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:12px}.spec-item{padding:10px 11px;background:#f9fafe;border:1px solid #eceef4;border-radius:8px;min-width:0}.spec-label{display:block;font-size:11px;color:var(--zcs_tertiary_text_color);margin-bottom:3px}.spec-value{display:block;font-weight:600;overflow-wrap:anywhere}.narrative-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-bottom:14px}.narrative-head{display:flex;align-items:center;gap:8px;margin-bottom:9px}.narrative-head i{color:var(--zcs_brand_color);font-size:17px}.field-value{white-space:pre-wrap;overflow-wrap:anywhere}.lifecycle-card{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:14px}.lifecycle-items{display:flex;gap:22px;flex-wrap:wrap}.lifecycle-item span{display:block}.lifecycle-label{font-size:11px;color:var(--zcs_tertiary_text_color)}.lifecycle-value{font-weight:600}.usage-summary{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}.usage-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.usage-titlebar{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px}.section-heading{display:flex;align-items:center;gap:9px}.section-icon{width:31px;height:31px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;background:#e8efff;color:#2a6ffc}.tone-green{background:#e8faf3;color:#179e6c}.tone-orange{background:#fff2e9;color:#c85308}.tone-purple{background:#f4edff;color:#713ab7}.count-pill{background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);padding:2px 8px;border-radius:10px;font-size:12px;font-weight:700}.zcs-table-wrapper{height:248px;max-height:248px;border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto;border-radius:7px}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:700px}.zcs-table-wrapper thead{top:0;z-index:1}.zcs-table-wrapper th{background:#f4f6fa;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper tbody tr:hover td{background:#f9fafe}.record-link{color:var(--zcs_brand_color);font-weight:650}.semantic-tag{display:inline-flex;padding:2px 6px;border-radius:5px;background:#f0f3f8;color:var(--zcs-secondary-text-color);font-size:12px}.zcs-nodata-wrapper{min-height:110px;color:var(--zcs-secondary-text-color)}\n@media(max-width:1100px){.spec-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:850px){.product-detail-page{padding:12px}.overview-grid{grid-template-columns:1fr}.media-card{display:grid;grid-template-columns:190px 1fr;gap:12px}.spec-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.narrative-grid,.usage-grid{grid-template-columns:1fr}.identity-header,.lifecycle-card{align-items:flex-start;flex-direction:column}.header-side{justify-content:flex-start}}@media(max-width:560px){.product-detail-page{padding:8px}.identity-header,.media-card,.spec-card,.narrative-card,.lifecycle-card,.usage-card{padding:12px}.media-card{display:block}.product-image{height:190px}.spec-grid{grid-template-columns:1fr}.identity-title{font-size:20px}.zcs-table-wrapper{height:260px;max-height:260px}.lifecycle-items{gap:12px}.header-side{width:100%}.zcs-button{flex:1}}\n&lt;/style&gt;\n&lt;div class=&apos;product-detail-page&apos;&gt;&lt;div class=&apos;detail-shell&apos;&gt;\n&lt;% if(productList.count() == 0) { %&gt;\n\t&lt;div class=&apos;zcs-card zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-ban&apos; style=&apos;font-size:30px;color:var(--zcs_brand_color)&apos;&gt;&lt;/i&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;Product not found&lt;/h5&gt;&lt;div&gt;Check the Product_ID parameter or return to the product catalog.&lt;/div&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Page:Products&apos; style=&apos;margin-top:14px&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-left&apos;&gt;&lt;/i&gt;&lt;span&gt;Products&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% } else { product = productList; %&gt;\n\t&lt;header class=&apos;zcs-card identity-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&apos;&gt;\n\t\t&lt;div class=&apos;identity-main zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;&lt;a href=&apos;#Page:Products&apos; class=&apos;zcs-back zcs-flex zcs-align-items-center zcs-justify-center&apos; title=&apos;Back to products&apos;&gt;&lt;i class=&apos;zcs-font-22 zc-li-outline arrows-1-tail-left&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;div&gt;&lt;div class=&apos;identity-kicker&apos;&gt;Product &lt;%=product.Product_ID%&gt;&lt;/div&gt;&lt;h1 class=&apos;identity-title&apos;&gt;&lt;%=product.Product_Name%&gt;&lt;/h1&gt;&lt;div class=&apos;identity-meta&apos;&gt;&lt;span class=&apos;meta-chip&apos;&gt;&lt;%=ifnull(product.Product_Category,&quot;Uncategorized&quot;)%&gt;&lt;/span&gt;&lt;span class=&apos;meta-chip&apos;&gt;&lt;%=ifnull(product.Product_Type,&quot;Type not set&quot;)%&gt;&lt;/span&gt;&lt;span class=&apos;meta-chip&apos;&gt;&lt;%=ifnull(product.Internal_Part_Number,&quot;Part number not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;header-side&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=if(product.Active == true,&quot;zcs-badge-green&quot;,&quot;zcs-badge-grey&quot;)%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=if(product.Active == true,&quot;ui-1-check-circle-08&quot;,&quot;ui-1-circle-remove&quot;)%&gt;&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=if(product.Active == true,&quot;Active&quot;,&quot;Inactive&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Form:Add_Product?recLinkID=&lt;%=product.ID%&gt;&amp;viewLinkName=All_Products&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;span&gt;Edit&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t&lt;/header&gt;\n\t&lt;div class=&apos;overview-grid&apos;&gt;\n\t\t&lt;section class=&apos;zcs-card media-card&apos;&gt;&lt;div class=&apos;product-image&apos;&gt;&lt;% if(product.Product_Image != null &amp;&amp; product.Product_Image != &quot;&quot;) { %&gt;&lt;img src=&apos;&lt;%=product.Product_Image%&gt;&apos; alt=&apos;&lt;%=product.Product_Name%&gt;&apos;&gt;&lt;% } else { %&gt;&lt;i class=&apos;zc-li-outline design-image&apos;&gt;&lt;/i&gt;&lt;% } %&gt;&lt;/div&gt;&lt;div class=&apos;document-list&apos;&gt;&lt;% if(product.Product_Datasheet != null &amp;&amp; product.Product_Datasheet != &quot;&quot;) { %&gt;&lt;a class=&apos;document-link&apos; href=&apos;&lt;%=product.Product_Datasheet%&gt;&apos; target=&apos;_blank&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;&lt;span&gt;Product datasheet&lt;/span&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;span class=&apos;document-link is-empty&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;&lt;span&gt;No datasheet&lt;/span&gt;&lt;/span&gt;&lt;% } %&gt;&lt;% if(product.Additional_Attachments != null &amp;&amp; product.Additional_Attachments != &quot;&quot;) { %&gt;&lt;a class=&apos;document-link&apos; href=&apos;&lt;%=product.Additional_Attachments%&gt;&apos; target=&apos;_blank&apos;&gt;&lt;i class=&apos;zc-li-outline files-folder-15&apos;&gt;&lt;/i&gt;&lt;span&gt;Additional attachments&lt;/span&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;span class=&apos;document-link is-empty&apos;&gt;&lt;i class=&apos;zc-li-outline files-folder-15&apos;&gt;&lt;/i&gt;&lt;span&gt;No additional attachments&lt;/span&gt;&lt;/span&gt;&lt;% } %&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;zcs-card spec-card&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;section-title&apos;&gt;Specifications&lt;/h2&gt;&lt;div class=&apos;section-caption&apos;&gt;Identity, commercial references, and supply attributes&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;spec-grid&apos;&gt;\n\t\t\t&lt;div class=&apos;spec-item&apos;&gt;&lt;span class=&apos;spec-label&apos;&gt;Brand / Make&lt;/span&gt;&lt;span class=&apos;spec-value&apos;&gt;&lt;%=ifnull(product.Brand_Make,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;spec-item&apos;&gt;&lt;span class=&apos;spec-label&apos;&gt;Model&lt;/span&gt;&lt;span class=&apos;spec-value&apos;&gt;&lt;%=ifnull(product.Model,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;spec-item&apos;&gt;&lt;span class=&apos;spec-label&apos;&gt;Manufacturer Part Number&lt;/span&gt;&lt;span class=&apos;spec-value&apos;&gt;&lt;%=ifnull(product.Manufacturer_Part_Number,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;spec-item&apos;&gt;&lt;span class=&apos;spec-label&apos;&gt;Unit of Measure&lt;/span&gt;&lt;span class=&apos;spec-value&apos;&gt;&lt;%=ifnull(product.Unit_of_Measure,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;spec-item&apos;&gt;&lt;span class=&apos;spec-label&apos;&gt;Currency&lt;/span&gt;&lt;span class=&apos;spec-value&apos;&gt;&lt;%=ifnull(product.Default_Currency,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;spec-item&apos;&gt;&lt;span class=&apos;spec-label&apos;&gt;Reference Cost&lt;/span&gt;&lt;span class=&apos;spec-value&apos;&gt;&lt;%=ifnull(product.Reference_Cost,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;spec-item&apos;&gt;&lt;span class=&apos;spec-label&apos;&gt;Reference Selling Price&lt;/span&gt;&lt;span class=&apos;spec-value&apos;&gt;&lt;%=ifnull(product.Reference_Selling_Price,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;spec-item&apos;&gt;&lt;span class=&apos;spec-label&apos;&gt;Warranty Period&lt;/span&gt;&lt;span class=&apos;spec-value&apos;&gt;&lt;%=ifnull(product.Warranty_Period,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;spec-item&apos;&gt;&lt;span class=&apos;spec-label&apos;&gt;Country of Origin&lt;/span&gt;&lt;span class=&apos;spec-value&apos;&gt;&lt;%=ifnull(product.Country_of_Origin,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;spec-item&apos;&gt;&lt;span class=&apos;spec-label&apos;&gt;Product ID&lt;/span&gt;&lt;span class=&apos;spec-value&apos;&gt;&lt;%=product.Product_ID%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;spec-item&apos;&gt;&lt;span class=&apos;spec-label&apos;&gt;Category&lt;/span&gt;&lt;span class=&apos;spec-value&apos;&gt;&lt;%=ifnull(product.Product_Category,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;spec-item&apos;&gt;&lt;span class=&apos;spec-label&apos;&gt;Type&lt;/span&gt;&lt;span class=&apos;spec-value&apos;&gt;&lt;%=ifnull(product.Product_Type,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;&lt;/section&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;narrative-grid&apos;&gt;&lt;section class=&apos;zcs-card narrative-card&apos;&gt;&lt;div class=&apos;narrative-head&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;&lt;h2 class=&apos;section-title&apos;&gt;Product description&lt;/h2&gt;&lt;/div&gt;&lt;div class=&apos;field-value&apos;&gt;&lt;%=ifnull(product.Product_Description,&quot;No description provided.&quot;)%&gt;&lt;/div&gt;&lt;/section&gt;&lt;section class=&apos;zcs-card narrative-card&apos;&gt;&lt;div class=&apos;narrative-head&apos;&gt;&lt;i class=&apos;zc-li-outline design-ruler-pencil&apos;&gt;&lt;/i&gt;&lt;h2 class=&apos;section-title&apos;&gt;Technical specifications&lt;/h2&gt;&lt;/div&gt;&lt;div class=&apos;field-value&apos;&gt;&lt;%=ifnull(product.Technical_Specifications,&quot;No specifications provided.&quot;)%&gt;&lt;/div&gt;&lt;/section&gt;&lt;section class=&apos;zcs-card narrative-card&apos;&gt;&lt;div class=&apos;narrative-head&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-settings-90&apos;&gt;&lt;/i&gt;&lt;h2 class=&apos;section-title&apos;&gt;Configuration template&lt;/h2&gt;&lt;/div&gt;&lt;div class=&apos;field-value&apos;&gt;&lt;%=ifnull(product.Configuration_Template,&quot;No configuration template provided.&quot;)%&gt;&lt;/div&gt;&lt;/section&gt;&lt;/div&gt;\n\t&lt;section class=&apos;zcs-card lifecycle-card&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;section-title&apos;&gt;Lifecycle&lt;/h2&gt;&lt;div class=&apos;section-caption&apos;&gt;Master record stewardship and availability state&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;lifecycle-items&apos;&gt;&lt;div class=&apos;lifecycle-item&apos;&gt;&lt;span class=&apos;lifecycle-label&apos;&gt;State&lt;/span&gt;&lt;span class=&apos;lifecycle-value&apos;&gt;&lt;%=if(product.Active == true,&quot;Active&quot;,&quot;Inactive&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;lifecycle-item&apos;&gt;&lt;span class=&apos;lifecycle-label&apos;&gt;Created&lt;/span&gt;&lt;span class=&apos;lifecycle-value&apos;&gt;&lt;%=ifnull(product.Created_Date_Time,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;lifecycle-item&apos;&gt;&lt;span class=&apos;lifecycle-label&apos;&gt;Last updated&lt;/span&gt;&lt;span class=&apos;lifecycle-value&apos;&gt;&lt;%=ifnull(product.Last_Updated_Date_Time,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Report:All_Products?ID=&lt;%=product.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt; Open record&lt;/a&gt;&lt;/section&gt;\n\t&lt;div class=&apos;usage-summary&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;section-title&apos;&gt;Operational usage&lt;/h2&gt;&lt;div class=&apos;section-caption&apos;&gt;Demand through returns, with each list independently scrollable&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;count-pill&apos;&gt;&lt;%=leadRows.count() + soRows.count() + quoteRows.count() + poRows.count() + invoiceRows.count() + logisticsRows.count() + returnRows.count()%&gt; total&lt;/span&gt;&lt;/div&gt;\n\t&lt;div class=&apos;usage-grid&apos;&gt;\n&lt;%\nsectionNames = {&quot;Leads&quot;,&quot;Sales orders&quot;,&quot;Supplier quotes&quot;,&quot;Purchase orders&quot;,&quot;Supplier invoices&quot;,&quot;Logistics&quot;,&quot;Returns&quot;};\nsectionCounts = {leadRows.count(),soRows.count(),quoteRows.count(),poRows.count(),invoiceRows.count(),logisticsRows.count(),returnRows.count()};\nfor each index i in sectionNames\n{\n%&gt;&lt;section class=&apos;zcs-card usage-card&apos;&gt;&lt;div class=&apos;usage-titlebar&apos;&gt;&lt;div class=&apos;section-heading&apos;&gt;&lt;span class=&apos;section-icon &lt;%=if(i == 0 || i == 3,&quot;tone-green&quot;,if(i == 1 || i == 4,&quot;tone-orange&quot;,if(i == 2 || i == 6,&quot;tone-purple&quot;,&quot;&quot;)))%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=if(i == 0,&quot;users-single-05&quot;,if(i == 1,&quot;e-commerce-shopping-cart-simple&quot;,if(i == 2,&quot;business-handshake&quot;,if(i == 3,&quot;files-single-copy-04&quot;,if(i == 4,&quot;files-single-copy-04&quot;,if(i == 5,&quot;transportation-truck-front&quot;,&quot;arrows-1-reply&quot;))))))%&gt;&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2 class=&apos;section-title&apos;&gt;&lt;%=sectionNames.get(i)%&gt;&lt;/h2&gt;&lt;div class=&apos;section-caption&apos;&gt;Related product records&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;count-pill&apos;&gt;&lt;%=sectionCounts.get(i)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Transaction&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Configuration / Requirement&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Quantity&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Details&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%\nif(i == 0) { for each leadItem in leadRows { %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;% if(leadItem.Parent_Lead != null) { %&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Lead_Detail?Lead_ID=&lt;%=leadItem.Parent_Lead.ID%&gt;&apos;&gt;&lt;%=leadItem.Parent_Lead.Lead_ID%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;span class=&apos;semantic-tag&apos;&gt;Lead unavailable&lt;/span&gt;&lt;% } %&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(leadItem.Configuration,&quot;-&quot;)%&gt;&lt;br&gt;&lt;span class=&apos;zcs-color-secondary&apos;&gt;&lt;%=ifnull(leadItem.Technical_Requirements,&quot;&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=leadItem.Quantity%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;Expected unit: &lt;%=ifnull(leadItem.Expected_Unit_Price,&quot;-&quot;)%&gt;&lt;br&gt;&lt;%=ifnull(leadItem.Remarks,&quot;&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } }\nelse if(i == 1) { for each salesItem in soRows { %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;% if(salesItem.Parent_Sales_Order != null) { %&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=salesItem.Parent_Sales_Order.ID%&gt;&apos;&gt;&lt;%=salesItem.Parent_Sales_Order.Sales_Order_ID%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;span class=&apos;semantic-tag&apos;&gt;Order unavailable&lt;/span&gt;&lt;% } %&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(salesItem.Configuration,&quot;-&quot;)%&gt;&lt;br&gt;&lt;span class=&apos;zcs-color-secondary&apos;&gt;&lt;%=ifnull(salesItem.Technical_Requirements,&quot;&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=salesItem.Quantity%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;Availability: &lt;%=ifnull(salesItem.Required_Availability,&quot;-&quot;)%&gt;&lt;br&gt;Lead time: &lt;%=ifnull(salesItem.Required_Lead_Time,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } }\nelse if(i == 2) { for each quoteItem in quoteRows { %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;% if(quoteItem.Parent_Supplier_Quote != null) { %&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Supplier_Quotes&apos;&gt;&lt;%=quoteItem.Parent_Supplier_Quote.Supplier_Quote_ID%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;span class=&apos;semantic-tag&apos;&gt;Quote unavailable&lt;/span&gt;&lt;% } %&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(quoteItem.Offered_Configuration,&quot;-&quot;)%&gt;&lt;br&gt;&lt;span class=&apos;zcs-color-secondary&apos;&gt;&lt;%=ifnull(quoteItem.Configuration_Match,&quot;&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=quoteItem.Quoted_Quantity%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=quoteItem.Currency%&gt; &lt;%=quoteItem.Supplier_Total_Price%&gt;&lt;br&gt;&lt;%=ifnull(quoteItem.Availability,&quot;-&quot;)%&gt; / &lt;%=ifnull(quoteItem.Lead_Time,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } }\nelse if(i == 3) { for each purchaseItem in poRows { %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;% if(purchaseItem.Parent_Purchase_Order != null) { %&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=purchaseItem.Parent_Purchase_Order.ID%&gt;&apos;&gt;&lt;%=purchaseItem.Parent_Purchase_Order.Purchase_Order_ID%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;span class=&apos;semantic-tag&apos;&gt;PO unavailable&lt;/span&gt;&lt;% } %&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(purchaseItem.Approved_Configuration,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=purchaseItem.Quantity%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=purchaseItem.Currency%&gt; &lt;%=purchaseItem.Customer_Total_Price%&gt;&lt;br&gt;&lt;%=ifnull(purchaseItem.Remarks,&quot;&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } }\nelse if(i == 4) { for each invoiceItem in invoiceRows { %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;% if(invoiceItem.Parent_Supplier_Invoice != null) { %&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Supplier_Invoice_Detail?Supplier_Invoice_ID=&lt;%=invoiceItem.Parent_Supplier_Invoice.ID%&gt;&apos;&gt;&lt;%=invoiceItem.Parent_Supplier_Invoice.Supplier_Invoice_ID%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;span class=&apos;semantic-tag&apos;&gt;Invoice unavailable&lt;/span&gt;&lt;% } %&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(invoiceItem.Configuration,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=invoiceItem.Quantity%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=invoiceItem.Currency%&gt; &lt;%=invoiceItem.Total_Price%&gt;&lt;br&gt;&lt;%=ifnull(invoiceItem.Remarks,&quot;&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } }\nelse if(i == 5) { for each logisticsItem in logisticsRows { %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;% if(logisticsItem.Parent_Logistics_Booking != null) { %&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Logistics_Booking_Detail?Logistics_Booking_ID=&lt;%=logisticsItem.Parent_Logistics_Booking.ID%&gt;&apos;&gt;&lt;%=logisticsItem.Parent_Logistics_Booking.Logistics_Booking_ID%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;span class=&apos;semantic-tag&apos;&gt;Booking unavailable&lt;/span&gt;&lt;% } %&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(logisticsItem.Configuration,&quot;-&quot;)%&gt;&lt;br&gt;&lt;span class=&apos;zcs-color-secondary&apos;&gt;&lt;%=ifnull(logisticsItem.Serial_Number_Details,&quot;&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Expected &lt;%=logisticsItem.Expected_Quantity%&gt;&lt;br&gt;Received &lt;%=ifnull(logisticsItem.Received_Quantity,0)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;Accepted &lt;%=ifnull(logisticsItem.Accepted_Quantity,0)%&gt; / Rejected &lt;%=ifnull(logisticsItem.Rejected_Quantity,0)%&gt;&lt;br&gt;&lt;%=ifnull(logisticsItem.Receiving_Remarks,&quot;&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } }\nelse { for each returnItem in returnRows { %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;% if(returnItem.Parent_Return_Request != null) { %&gt;&lt;a class=&apos;record-link&apos; href=&apos;#Page:Return_Request_Detail?Return_Request_ID=&lt;%=returnItem.Parent_Return_Request.ID%&gt;&apos;&gt;&lt;%=returnItem.Parent_Return_Request.Return_Request_ID%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;span class=&apos;semantic-tag&apos;&gt;Return unavailable&lt;/span&gt;&lt;% } %&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(returnItem.Configuration,&quot;-&quot;)%&gt;&lt;br&gt;&lt;span class=&apos;zcs-color-secondary&apos;&gt;Serial: &lt;%=ifnull(returnItem.Serial_Number,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=returnItem.Return_Quantity%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(returnItem.Damage_Responsibility,&quot;-&quot;)%&gt;&lt;br&gt;&lt;%=ifnull(returnItem.Defect_Description,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } }\nif(sectionCounts.get(i) == 0) { %&gt;&lt;tr&gt;&lt;td colspan=&apos;4&apos;&gt;&lt;div class=&apos;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-p-20&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-copy-04&apos; style=&apos;font-size:22px&apos;&gt;&lt;/i&gt;&lt;div&gt;No related &lt;%=sectionNames.get(i)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% }\n%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/section&gt;&lt;%\n}\n%&gt;\n\t&lt;/div&gt;\n&lt;% } %&gt;\n&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Products
		{
					displayname = "Products"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Product_Catalog' elementName='Product_Catalog'>\n\t\t\t\t\t<![CDATA[htmlpage Product_Catalog()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nproducts = Add_Product[ID != 0] sort by Product_Name asc;\nallCount = products.count();\nactiveCount = Add_Product[Active == true].count();\ninactiveCount = Add_Product[Active == false].count();\ncategories = List();\ncategoryCounts = Map();\nfor each categoryProduct in products\n{\n\t\tcategoryName = ifnull(categoryProduct.Product_Category,&quot;Uncategorized&quot;);\n\t\tif(!categories.contains(categoryName))\n\t\t{\n\t\t\t\tcategories.add(categoryName);\n\t\t\t\tcategoryCounts.put(categoryName,0);\n\t\t}\n\t\tcategoryCounts.put(categoryName,categoryCounts.get(categoryName) + 1);\n}\ncategories.sort(true);\n%&gt;\n&lt;style&gt;\n/* ZCS global utility layer, included once for this page. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;--zcs-border-color:var(--zcs_tertiary_border_color);font-size:16px;line-height:1.5}*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-p-20{padding:1.25rem}.zcs-px-6{padding-left:.375rem;padding-right:.375rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-box-border{box-sizing:border-box}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-18{font-size:1.125rem}.zcs-font-22{font-size:1.375rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-20{margin-top:1.25rem}.zcs-sticky{position:sticky}.zcs-relative{position:relative}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}a{text-decoration:none}\n.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%;width:100%}.zc-container-wrapper .zc-main-content .inner,.zc-page-content-wrapper,.zc-pb-page-content-wrapper,.zc-pb-page-content-wrapper .zc-pb-tile-container,.zc-pb-page-content-wrapper .zc-pb-tile-card{width:100%!important;max-width:none!important;padding:0!important;margin:0!important;border-radius:0!important;box-shadow:none!important}#splash-screen,.zc-pb-page-content-wrapper .page-loader{display:none!important}\n.products-page{min-height:100%;padding:16px;background:var(--zcs-page-bg-color);font:14px/1.45 Arial,sans-serif;color:var(--zcs-primary-text-color)}.products-shell{width:100%;max-width:1480px;margin:auto}.zcs-page-header{padding:14px 16px;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;background:#fff}.header-mark{display:grid;place-items:center;width:36px;height:36px;border-radius:8px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:18px}.products-title{margin:0;font-size:22px;font-weight:600}.products-subtitle{margin:2px 0 0;color:var(--zcs-secondary-text-color);font-size:13px}\n.status-context{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:10px 0}.context-card{display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:8px;background:#fff}.context-icon{display:grid;place-items:center;width:30px;height:30px;border-radius:7px;font-size:15px}.context-icon.all{color:#2A6FFC;background:#E8EFFF}.context-icon.active{color:#179E6C;background:#E4FCF3}.context-icon.inactive{color:#555;background:#e8e8e8}.context-value{font-size:17px;font-weight:600;line-height:1}.context-label{margin-top:2px;color:var(--zcs-secondary-text-color);font-size:11px}\n.catalog-panel{border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;background:#fff;overflow:hidden}.catalog-radio{position:absolute;opacity:0;pointer-events:none}.zcs-horizontal-tabhead{display:flex;gap:12px;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;padding:0 12px;margin:0}.zcs-horizontal-tabhead::-webkit-scrollbar{display:none}.zcs-horizontal-tabitem{list-style:none;border-bottom:2px solid transparent;white-space:nowrap}.zcs-horizontal-tablink{display:flex;align-items:center;justify-content:center;gap:7px;padding:10px 8px;color:var(--zcs_tertiary_text_color);cursor:pointer;font-weight:500}.zcs-horizontal-tabcount{min-width:20px;background:var(--zcs-page-bg-color);padding:1px 6px;border-radius:4px;text-align:center;font-size:11px}#tab-all:checked~.zcs-horizontal-tabhead label[for=&apos;tab-all&apos;],#tab-active:checked~.zcs-horizontal-tabhead label[for=&apos;tab-active&apos;],#tab-inactive:checked~.zcs-horizontal-tabhead label[for=&apos;tab-inactive&apos;]{border-bottom-color:var(--zcs_brand_color)}#tab-all:checked~.zcs-horizontal-tabhead label[for=&apos;tab-all&apos;] .zcs-horizontal-tablink,#tab-active:checked~.zcs-horizontal-tabhead label[for=&apos;tab-active&apos;] .zcs-horizontal-tablink,#tab-inactive:checked~.zcs-horizontal-tabhead label[for=&apos;tab-inactive&apos;] .zcs-horizontal-tablink{color:var(--zcs_brand_color)}\n&lt;% for each index categoryIndex in categories { %&gt;#tab-category-&lt;%=categoryIndex%&gt;:checked~.zcs-horizontal-tabhead label[for=&apos;tab-category-&lt;%=categoryIndex%&gt;&apos;]{border-bottom-color:var(--zcs_brand_color)}#tab-category-&lt;%=categoryIndex%&gt;:checked~.zcs-horizontal-tabhead label[for=&apos;tab-category-&lt;%=categoryIndex%&gt;&apos;] .zcs-horizontal-tablink{color:var(--zcs_brand_color)}#tab-category-&lt;%=categoryIndex%&gt;:checked~.catalog-content .product-row:not(.category-&lt;%=categoryIndex%&gt;){display:none}&lt;% } %&gt;#tab-active:checked~.catalog-content .product-row:not(.state-active),#tab-inactive:checked~.catalog-content .product-row:not(.state-inactive){display:none}\n.catalog-content{padding:12px}.register-caption{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 9px}.register-title{font-weight:600}.register-note{color:var(--zcs-secondary-text-color);font-size:12px}.zcs-table-wrapper{height:520px;max-height:520px;border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto;border-radius:6px}.zcs-table-wrapper table{border-collapse:collapse;min-width:1050px;line-height:normal}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:#F9FAFE;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap;font-weight:600}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:middle}.zcs-table-wrapper tbody tr:first-child td{border-top:0}.zcs-table-wrapper tbody tr:hover td{background:#F9FAFE}.identity{min-width:235px}.product-name{display:block;font-weight:600;color:var(--zcs_brand_color)}.product-ids{display:flex;flex-wrap:wrap;gap:3px 10px;margin-top:3px;color:var(--zcs-secondary-text-color);font-size:11px}.classification{font-weight:500}.spec-line{display:block;margin-top:3px;color:var(--zcs-secondary-text-color);font-size:11px}.zcs-badge{width:auto;border:1px solid}.zcs-badge-green{background:#E4FCF3;border-color:#179E6C;color:#137d58}.zcs-badge-grey{background:#e8e8e8;border-color:#686868;color:#444}.action-list{display:flex;align-items:center;gap:5px}.zcs-custom-action-icon{display:grid;place-items:center;width:30px;height:30px;border:1px solid var(--zcs_tertiary_border_color);border-radius:50%;color:var(--zcs-secondary-text-color)}.zcs-custom-action-icon:hover{border-color:var(--zcs_brand_color);background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.zcs-nodata-wrapper{min-height:360px}.nodata-icon{display:grid;place-items:center;width:58px;height:58px;margin:auto;border-radius:14px;background:#E8EFFF;color:#2A6FFC;font-size:25px}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color)}\n@media(max-width:760px){.products-page{padding:8px}.zcs-page-header{padding:12px}.products-title{font-size:19px}.status-context{grid-template-columns:1fr 1fr}.context-card:first-child{grid-column:1/-1}.catalog-content{padding:8px}.register-caption{align-items:flex-start;flex-direction:column;gap:2px}.zcs-table-wrapper{height:570px;max-height:570px}.zcs-table-wrapper table,.zcs-table-wrapper thead,.zcs-table-wrapper tbody,.zcs-table-wrapper tr,.zcs-table-wrapper th,.zcs-table-wrapper td{display:block;min-width:0}.zcs-table-wrapper thead{display:none}.zcs-table-wrapper tr{padding:11px;border-bottom:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tr:last-child{border-bottom:0}.zcs-table-wrapper td{border:0;padding:4px 0}.zcs-table-wrapper td:before{content:attr(data-label);display:block;color:var(--zcs-secondary-text-color);font-size:10px;text-transform:uppercase;letter-spacing:.03em}.identity:before,.actions-cell:before{display:none!important}.action-list{margin-top:7px}.products-subtitle{max-width:280px}}\n&lt;/style&gt;\n&lt;div class=&apos;products-page&apos;&gt;&lt;div class=&apos;products-shell&apos;&gt;\n\t&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-gap-8 zcs-box-border&apos;&gt;&lt;span class=&apos;header-mark&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&apos;zcs-ellipsis&apos;&gt;&lt;h1 class=&apos;products-title&apos;&gt;Products&lt;/h1&gt;&lt;p class=&apos;products-subtitle&apos;&gt;Product identity, classification, manufacturer specifications, and lifecycle availability.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&apos;status-context&apos;&gt;&lt;div class=&apos;context-card&apos;&gt;&lt;span class=&apos;context-icon all&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;div class=&apos;context-value&apos;&gt;&lt;%=allCount%&gt;&lt;/div&gt;&lt;div class=&apos;context-label&apos;&gt;Catalog records&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;context-card&apos;&gt;&lt;span class=&apos;context-icon active&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;div class=&apos;context-value&apos;&gt;&lt;%=activeCount%&gt;&lt;/div&gt;&lt;div class=&apos;context-label&apos;&gt;Active&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;context-card&apos;&gt;&lt;span class=&apos;context-icon inactive&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;div class=&apos;context-value&apos;&gt;&lt;%=inactiveCount%&gt;&lt;/div&gt;&lt;div class=&apos;context-label&apos;&gt;Inactive&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&apos;catalog-panel&apos;&gt;\n\t\t&lt;input class=&apos;catalog-radio&apos; type=&apos;radio&apos; name=&apos;catalog-tab&apos; id=&apos;tab-all&apos; checked&gt;&lt;input class=&apos;catalog-radio&apos; type=&apos;radio&apos; name=&apos;catalog-tab&apos; id=&apos;tab-active&apos;&gt;&lt;input class=&apos;catalog-radio&apos; type=&apos;radio&apos; name=&apos;catalog-tab&apos; id=&apos;tab-inactive&apos;&gt;&lt;% for each index categoryIndex in categories { %&gt;&lt;input class=&apos;catalog-radio&apos; type=&apos;radio&apos; name=&apos;catalog-tab&apos; id=&apos;tab-category-&lt;%=categoryIndex%&gt;&apos;&gt;&lt;% } %&gt;\n\t\t&lt;div class=&apos;zcs-horizontal-tabhead&apos;&gt;&lt;label class=&apos;zcs-horizontal-tabitem&apos; for=&apos;tab-all&apos;&gt;&lt;span class=&apos;zcs-horizontal-tablink&apos;&gt;&lt;span&gt;All&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount&apos;&gt;&lt;%=allCount%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/label&gt;&lt;label class=&apos;zcs-horizontal-tabitem&apos; for=&apos;tab-active&apos;&gt;&lt;span class=&apos;zcs-horizontal-tablink&apos;&gt;&lt;span&gt;Active&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount&apos;&gt;&lt;%=activeCount%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/label&gt;&lt;label class=&apos;zcs-horizontal-tabitem&apos; for=&apos;tab-inactive&apos;&gt;&lt;span class=&apos;zcs-horizontal-tablink&apos;&gt;&lt;span&gt;Inactive&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount&apos;&gt;&lt;%=inactiveCount%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/label&gt;&lt;% for each index categoryIndex in categories { categoryName = categories.get(categoryIndex); %&gt;&lt;label class=&apos;zcs-horizontal-tabitem&apos; for=&apos;tab-category-&lt;%=categoryIndex%&gt;&apos;&gt;&lt;span class=&apos;zcs-horizontal-tablink&apos;&gt;&lt;span&gt;&lt;%=categoryName%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount&apos;&gt;&lt;%=categoryCounts.get(categoryName)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/label&gt;&lt;% } %&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;catalog-content&apos;&gt;\n\t\t&lt;% if(allCount == 0) { %&gt;&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;&lt;span class=&apos;nodata-icon&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-m-0&apos;&gt;No products available&lt;/h5&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-mt-12&apos;&gt;Add the first product to establish the master catalog.&lt;/p&gt;&lt;div class=&apos;zcs-flex zcs-justify-center zcs-mt-20&apos;&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Form:Add_Product&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;span&gt;Add Product&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } else { %&gt;\n\t\t\t&lt;div class=&apos;register-caption&apos;&gt;&lt;span class=&apos;register-title&apos;&gt;Product register&lt;/span&gt;&lt;span class=&apos;register-note&apos;&gt;Select a product name for its complete record.&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Product identity&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Classification&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Manufacturer specification&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Lifecycle&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Actions&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t&lt;% for each product in products { productCategory=ifnull(product.Product_Category,&quot;Uncategorized&quot;); categoryIndex=categories.indexOf(productCategory); stateClass=if(product.Active == true,&quot;state-active&quot;,&quot;state-inactive&quot;); %&gt;&lt;tr class=&apos;product-row category-&lt;%=categoryIndex%&gt; &lt;%=stateClass%&gt;&apos;&gt;&lt;td data-label=&apos;Product identity&apos; class=&apos;identity zcs-px-16 zcs-py-8&apos;&gt;&lt;a class=&apos;product-name&apos; href=&apos;#Page:Product_Detail?Product_ID=&lt;%=product.ID%&gt;&apos;&gt;&lt;%=product.Product_Name%&gt;&lt;/a&gt;&lt;span class=&apos;product-ids&apos;&gt;&lt;span&gt;Product &lt;%=product.Product_ID%&gt;&lt;/span&gt;&lt;span&gt;Internal &lt;%=ifnull(product.Internal_Part_Number,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td data-label=&apos;Classification&apos; class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;classification&apos;&gt;&lt;%=productCategory%&gt;&lt;/span&gt;&lt;span class=&apos;spec-line&apos;&gt;&lt;%=ifnull(product.Product_Type,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td data-label=&apos;Manufacturer specification&apos; class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;classification&apos;&gt;&lt;%=ifnull(product.Brand_Make,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;span class=&apos;spec-line&apos;&gt;Model &lt;%=ifnull(product.Model,&quot;-&quot;)%&gt; · MPN &lt;%=ifnull(product.Manufacturer_Part_Number,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td data-label=&apos;Lifecycle&apos; class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=if(product.Active == true,&quot;zcs-badge-green&quot;,&quot;zcs-badge-grey&quot;)%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=if(product.Active == true,&quot;ui-1-check-circle-08&quot;,&quot;ui-1-circle-remove&quot;)%&gt;&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=if(product.Active == true,&quot;Active&quot;,&quot;Inactive&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td data-label=&apos;Actions&apos; class=&apos;actions-cell zcs-px-16 zcs-py-8&apos;&gt;&lt;div class=&apos;action-list&apos;&gt;&lt;a class=&apos;zcs-custom-action-icon&apos; title=&apos;View detail&apos; aria-label=&apos;View product detail&apos; href=&apos;#Page:Product_Detail?Product_ID=&lt;%=product.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;a class=&apos;zcs-custom-action-icon&apos; title=&apos;Edit product&apos; aria-label=&apos;Edit product&apos; href=&apos;#Form:Add_Product?recLinkID=&lt;%=product.ID%&gt;&amp;viewLinkName=All_Products&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;a class=&apos;zcs-custom-action-icon&apos; title=&apos;&lt;%=if(product.Active == true,&quot;Deactivate&quot;,&quot;Activate&quot;)%&gt; product&apos; aria-label=&apos;&lt;%=if(product.Active == true,&quot;Deactivate&quot;,&quot;Activate&quot;)%&gt; product&apos; href=&apos;#Report:All_Products?ID=&lt;%=product.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=if(product.Active == true,&quot;ui-1-circle-remove&quot;,&quot;ui-1-check-circle-08&quot;)%&gt;&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t&lt;% } %&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Purchase_Order_Detail(int Purchase_Order_ID)
		{
					displayname = "Purchase Order Detail"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Purchase_Order_Detail_View' elementName='Purchase_Order_Detail_View'>\n\t\t\t\t\t<![CDATA[htmlpage Purchase_Order_Detail_View()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\npoList = Create_Purchase_Order[ID == input.Purchase_Order_ID];\n%&gt;\n&lt;style&gt;\n/* ZCS global utility subset and component styles: zcs-global, procurement detail, stepper, table, badge, no-data, timeline, outline button, key-value */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#f5f6f8;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-thead-color:#f7f8fb;--zcs-tr-h-color:#f8f9fc}\n*{box-sizing:border-box}#splash-screen{display:none!important}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-row-wrap{flex-wrap:wrap}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-half{border-radius:50%}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary,.zcs-color-tertiary{color:var(--zcs-secondary-text-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-no-underline{text-decoration:none}.zcs-overflow-auto{overflow:auto}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:10px}\na{text-decoration:none}.zcs-button{width:auto;min-width:5rem;min-height:34px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}.zcs-button-icon{width:16px}.zcs-badge{width:max-content;white-space:nowrap;border:1px solid}.zcs-badge-filled.zcs-badge-theme{background:var(--zcs-light-bg-color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled.zcs-badge-yellow{background:#fcf4e6;border-color:#d99212;color:#8a5908}.zcs-badge-filled.zcs-badge-orange{background:#f8f0eb;border-color:#f4660c;color:#a63e00}.zcs-badge-filled.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#174bb9}.zcs-badge-filled.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#087d55}.zcs-badge-filled.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#af1730}.zcs-badge-filled.zcs-badge-grey{background:#eee;border-color:#666;color:#333}\n.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:#fff;overflow:auto;border-radius:7px;height:318px}.zcs-table-wrapper table{border-collapse:collapse;min-width:900px;line-height:normal}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:var(--zcs-thead-color);box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap;font-weight:600;text-align:left}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color);vertical-align:top}.zcs-table-wrapper tbody tr:hover td{background:var(--zcs-tr-h-color)}\n.po-page{min-height:100%;width:100%;overflow:auto;background:var(--zcs-page-bg-color);padding:14px;font:14px/1.45 Arial,sans-serif;color:var(--zcs-primary-text-color)}.po-shell{max-width:1540px;margin:auto}.stack{display:flex;flex-direction:column;gap:12px}.hero{padding:14px 16px}.identity{min-width:0}.hero-title{font-size:21px;margin:0;letter-spacing:-.2px}.hero-sub{color:var(--zcs-secondary-text-color);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.icon-box{width:38px;height:38px;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:9px;background:var(--zcs-light-bg-color);color:var(--zcs_brand_color);font-size:18px}.zcs-back{color:var(--zcs-secondary-text-color);display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;margin-bottom:7px}.zcs-back:hover,.link{color:var(--zcs_brand_color)}.actions{justify-content:flex-end}.next-step{margin-top:12px;padding:9px 12px;border-left:3px solid var(--zcs_brand_color);background:var(--zcs-light-bg-color);border-radius:5px;font-size:13px}.section{padding:15px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}.section-title{font-size:16px;font-weight:600;margin:0;display:flex;align-items:center;gap:8px}.section-title i{color:var(--zcs_brand_color)}.two-col{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(320px,.75fr);gap:12px;align-items:start}.kv-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--zcs-border-color);border:1px solid var(--zcs-border-color);border-radius:7px;overflow:hidden}.kv{background:#fff;padding:10px 12px;min-width:0}.kv label{display:block;color:var(--zcs-secondary-text-color);font-size:11px;text-transform:uppercase;letter-spacing:.35px;margin-bottom:2px}.kv strong,.kv span,.kv a{display:block;overflow-wrap:anywhere}.link{font-weight:600}.commercial-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.metric{padding:11px 12px;background:#f8f9fc;border:1px solid #eef0f5;border-radius:7px}.metric label{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.3px;color:var(--zcs-secondary-text-color)}.metric strong{font-size:16px}.metric.total{background:var(--zcs-light-bg-color);border-color:var(--zcs_brand_color)}.empty{height:210px;padding:20px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:var(--zcs-secondary-text-color)}.empty i{font-size:24px;color:var(--zcs_brand_color);margin-bottom:6px}.cards-scroll{height:270px;overflow:auto;padding-right:4px}.record-card{padding:11px 12px;border:1px solid var(--zcs-border-color);border-radius:7px;background:#fff}.record-card+.record-card{margin-top:8px}.record-meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px 10px;margin-top:7px;color:var(--zcs-secondary-text-color);font-size:12px}.text-value{white-space:pre-wrap;overflow-wrap:anywhere;margin:4px 0 12px}.progress-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:0}.progress-step{position:relative;padding:8px 5px;text-align:center;color:var(--zcs-secondary-text-color);font-size:12px}.progress-step:before{content:&apos;&apos;;position:absolute;top:18px;left:0;right:0;height:2px;background:#e4e6ec;z-index:0}.progress-step:first-child:before{left:50%}.progress-step:last-child:before{right:50%}.progress-step i{position:relative;z-index:1;display:flex;width:22px;height:22px;margin:0 auto 5px;align-items:center;justify-content:center;border-radius:50%;background:#f1f2f6}.progress-step.done{color:#087d55}.progress-step.done:before{background:#179e6c}.progress-step.done i{background:#e4fcf3}.progress-step.current{color:var(--zcs_brand_color);font-weight:600}.progress-step.current i{background:var(--zcs-light-bg-color);box-shadow:0 0 0 2px var(--zcs_brand_color)}.timeline-scroll{height:340px;overflow:auto}.zcs-tl-li{list-style:none;min-height:64px}.zcs-tl-indicator{width:30px;left:0}.zcs-tl-dot{width:10px;height:10px;background:var(--zcs_brand_color);border:2px solid #fff;box-shadow:0 0 0 2px var(--zcs-light-bg-color)}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:&apos;&apos;;position:absolute;width:1px;height:calc(100% + 24px);background:#dfe1e8;top:10px}.timeline-body{padding-left:38px}.mobile-products{display:none}\n@media(max-width:980px){.two-col{grid-template-columns:1fr}.actions{justify-content:flex-start}.hero-row{align-items:flex-start}.cards-scroll{height:300px}}\n@media(max-width:620px){.po-page{padding:8px}.section,.hero{padding:12px}.hero-row{flex-direction:column}.hero-title{font-size:19px}.kv-grid,.commercial-grid,.record-meta{grid-template-columns:1fr}.actions{width:100%}.actions .zcs-button{flex:1 1 calc(50% - 8px);min-width:0}.progress-grid{display:flex;overflow-x:auto}.progress-step{min-width:116px}.desktop-products{display:none}.mobile-products{display:flex;height:318px;overflow:auto}.empty{height:180px}}\n&lt;/style&gt;\n&lt;div class=&apos;po-page&apos;&gt;&lt;div class=&apos;po-shell&apos;&gt;\n&lt;%if(poList.count() == 0){%&gt;\n&lt;div class=&apos;zcs-card zcs-nodata-wrapper empty&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-search-zoom-out&apos;&gt;&lt;/i&gt;&lt;h3 class=&apos;zcs-m-0&apos;&gt;Purchase order not found&lt;/h3&gt;&lt;p&gt;No accessible purchase order matches the supplied identifier.&lt;/p&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Page:Purchase_Orders&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-left&apos;&gt;&lt;/i&gt;&lt;span&gt;Purchase orders&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n&lt;%}else{\npo = poList;\npoStatus = ifnull(po.Status,&quot;New&quot;).toString();\nsupplierName = &quot;Not set&quot;; customerName = &quot;Not set&quot;; salesOrderLabel = &quot;Not set&quot;; salesOrderID = null; sourceType = &quot;Not set&quot;; sourceLead = &quot;Not set&quot;; sourceRequirements = &quot;Not set&quot;; sourceRequestedDate = &quot;Not set&quot;; quoteLabel = &quot;Not set&quot;; quoteDate = &quot;Not set&quot;; quoteAvailability = &quot;Not set&quot;; quoteLeadTime = &quot;Not set&quot;; quoteRemarks = &quot;No supplier remarks&quot;; deliveredBy = &quot;Not set&quot;;\nif(po.Supplier != null){supplierName=ifnull(po.Supplier.Supplier_Name,&quot;Not set&quot;);}\nif(po.Customer != null){customerName=ifnull(po.Customer.Customer_Name,&quot;Not set&quot;);}\nif(po.Sales_Order != null){salesOrderID=po.Sales_Order.ID;salesOrderLabel=ifnull(po.Sales_Order.Sales_Order_ID,&quot;Not set&quot;);sourceType=ifnull(po.Sales_Order.Requirement_Source,&quot;Not set&quot;);sourceRequirements=ifnull(po.Sales_Order.Customer_Requirements,&quot;Not set&quot;);sourceRequestedDate=ifnull(po.Sales_Order.Requested_Delivery_Date,&quot;Not set&quot;);if(po.Sales_Order.Lead != null){sourceLead=po.Sales_Order.Lead.toString();}}\nquoteProducts = Supplier_Quote_Product[ID == 0];\nif(po.Selected_Supplier_Quote != null){quoteLabel=ifnull(po.Selected_Supplier_Quote.Supplier_Quote_ID,&quot;Not set&quot;);quoteDate=ifnull(po.Selected_Supplier_Quote.Quote_Date,&quot;Not set&quot;);quoteAvailability=ifnull(po.Selected_Supplier_Quote.Availability,&quot;Not set&quot;);quoteLeadTime=ifnull(po.Selected_Supplier_Quote.Lead_Time,&quot;Not set&quot;);quoteRemarks=ifnull(po.Selected_Supplier_Quote.Supplier_Remarks,&quot;No supplier remarks&quot;);quoteProducts=Supplier_Quote_Product[Parent_Supplier_Quote == po.Selected_Supplier_Quote];}\nif(po.Delivered_By != null){deliveredBy=ifnull(po.Delivered_By.Employee_Name,&quot;Not set&quot;);}\nproducts = Purchase_Order_Product[Parent_Purchase_Order == po.ID]; invoices = Add_Supplier_Invoice[Purchase_Order == po.ID] sort by Invoice_Date desc; bookingLinks = Logistics_Booking_Purchase_Order[Purchase_Order == po.ID]; receiptRows = Logistics_Booking_Product[Purchase_Order == po.ID]; qcRows = Logistics_Quality_Check_Product[Purchase_Order == po.ID]; returns = Create_Return_Request[Purchase_Order == po.ID] sort by Return_Date desc; histories = Add_History[Purchase_Order_Lookup == po.ID] sort by Updated_Date_Time desc;\nbadgeClass=&quot;zcs-badge-theme&quot;; if(poStatus==&quot;New&quot;){badgeClass=&quot;zcs-badge-yellow&quot;;}else if(poStatus==&quot;Approved&quot; || poStatus==&quot;Customer Approved&quot;){badgeClass=&quot;zcs-badge-orange&quot;;}else if(poStatus==&quot;Delivered&quot;){badgeClass=&quot;zcs-badge-green&quot;;}else if(poStatus==&quot;Invoice Paid&quot; || poStatus==&quot;Logistics Pending&quot; || poStatus==&quot;Products Received&quot;){badgeClass=&quot;zcs-badge-blue&quot;;}\nnextStep=&quot;Review current fulfillment records&quot;; if(poStatus==&quot;New&quot;){nextStep=&quot;Approve the purchase order&quot;;}else if(poStatus==&quot;Approved&quot; &amp;&amp; po.Shared_With_Customer != true){nextStep=&quot;Share the approved order with the customer&quot;;}else if(poStatus==&quot;Approved&quot;){nextStep=&quot;Record customer approval&quot;;}else if(poStatus==&quot;Customer Approved&quot;){nextStep=&quot;Create the supplier invoice&quot;;}else if(poStatus==&quot;Invoice Created&quot;){nextStep=&quot;Record supplier invoice payment&quot;;}else if(poStatus==&quot;Invoice Paid&quot;){nextStep=&quot;Create a logistics booking&quot;;}else if(poStatus==&quot;Logistics Pending&quot;){nextStep=&quot;Receive products and complete quality checks&quot;;}else if(poStatus==&quot;Products Received&quot;){nextStep=&quot;Confirm customer delivery&quot;;}else if(poStatus==&quot;Delivered&quot;){nextStep=&quot;Fulfillment complete; create a return only when required&quot;;}\n%&gt;\n&lt;div class=&apos;stack&apos;&gt;\n&lt;section class=&apos;zcs-card hero&apos;&gt;&lt;a href=&apos;#Page:Purchase_Orders&apos; class=&apos;zcs-back&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-left&apos;&gt;&lt;/i&gt;&lt;span&gt;Purchase orders&lt;/span&gt;&lt;/a&gt;&lt;div class=&apos;hero-row zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&apos;&gt;&lt;div class=&apos;identity zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;&lt;span class=&apos;icon-box&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&apos;identity&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&apos;&gt;&lt;h1 class=&apos;hero-title&apos;&gt;&lt;%=po.Purchase_Order_ID%&gt;&lt;/h1&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=badgeClass%&gt;&apos;&gt;&lt;%=poStatus%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;hero-sub&apos;&gt;&lt;%=supplierName%&gt; to &lt;%=customerName%&gt; · &lt;%=ifnull(po.PO_Date,&quot;Date not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;actions zcs-flex zcs-row-wrap zcs-gap-8&apos;&gt;\n&lt;%if(poStatus==&quot;New&quot; &amp;&amp; salesOrderID != null){%&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Form:Add_History?Purchase_Order_Lookup=&lt;%=po.ID%&gt;&amp;amp;Sales_Order_Lookup=&lt;%=salesOrderID%&gt;&amp;amp;Action_Type=Purchase Order Approved&amp;amp;Status=New&amp;amp;Previous_Status=New&amp;amp;New_Status=Approved&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;Approve&lt;/span&gt;&lt;/a&gt;&lt;%}else if(poStatus==&quot;Approved&quot; &amp;&amp; po.Shared_With_Customer != true){%&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Form:Create_Purchase_Order?recLinkID=&lt;%=po.ID%&gt;&amp;amp;viewLinkName=All_Purchase_Orders&amp;amp;Action_Mode=Share With Customer&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-share-66&apos;&gt;&lt;/i&gt;&lt;span&gt;Share&lt;/span&gt;&lt;/a&gt;&lt;%}else if(poStatus==&quot;Approved&quot; &amp;&amp; po.Shared_With_Customer==true){%&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Form:Create_Purchase_Order?recLinkID=&lt;%=po.ID%&gt;&amp;amp;viewLinkName=All_Purchase_Orders&amp;amp;Action_Mode=Customer Approval&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;Customer approval&lt;/span&gt;&lt;/a&gt;&lt;%}else if(poStatus==&quot;Customer Approved&quot;){%&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Form:Add_Supplier_Invoice?Purchase_Order=&lt;%=po.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;&lt;span&gt;Create invoice&lt;/span&gt;&lt;/a&gt;&lt;%}else if(poStatus==&quot;Invoice Paid&quot;){%&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Form:Create_Logistics_Booking?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;&lt;span&gt;Book logistics&lt;/span&gt;&lt;/a&gt;&lt;%}else if(poStatus==&quot;Products Received&quot;){%&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Form:Create_Purchase_Order?recLinkID=&lt;%=po.ID%&gt;&amp;amp;viewLinkName=All_Purchase_Orders&amp;amp;Action_Mode=Confirm Delivery&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;&lt;span&gt;Confirm delivery&lt;/span&gt;&lt;/a&gt;&lt;%}else if(poStatus==&quot;Delivered&quot;){%&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Form:Create_Return_Request?Purchase_Order=&lt;%=po.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-4-restore&apos;&gt;&lt;/i&gt;&lt;span&gt;Create return&lt;/span&gt;&lt;/a&gt;&lt;%}%&gt;\n&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Report:All_Purchase_Orders?ID=&lt;%=po.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;&lt;span&gt;PO record&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;next-step&apos;&gt;&lt;strong&gt;Next step:&lt;/strong&gt; &lt;%=nextStep%&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;div class=&apos;two-col&apos;&gt;&lt;div class=&apos;stack&apos;&gt;\n&lt;section class=&apos;zcs-card section&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h2 class=&apos;section-title&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;Commercial details&lt;/h2&gt;&lt;/div&gt;&lt;div class=&apos;commercial-grid&apos;&gt;&lt;div class=&apos;metric&apos;&gt;&lt;label&gt;Supplier price&lt;/label&gt;&lt;strong&gt;&lt;%=po.Currency%&gt; &lt;%=ifnull(po.Supplier_Price,0)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;metric&apos;&gt;&lt;label&gt;Shipping&lt;/label&gt;&lt;strong&gt;&lt;%=po.Currency%&gt; &lt;%=ifnull(po.Shipping_Charge,0)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;metric&apos;&gt;&lt;label&gt;Customs duty&lt;/label&gt;&lt;strong&gt;&lt;%=po.Currency%&gt; &lt;%=ifnull(po.Customs_Duty_Via_Freight,0)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;metric&apos;&gt;&lt;label&gt;Additional margin&lt;/label&gt;&lt;strong&gt;&lt;%=po.Currency%&gt; &lt;%=ifnull(po.Additional_Margin,0)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;metric&apos;&gt;&lt;label&gt;Subtotal&lt;/label&gt;&lt;strong&gt;&lt;%=po.Currency%&gt; &lt;%=ifnull(po.Subtotal,0)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;metric total&apos;&gt;&lt;label&gt;Customer total&lt;/label&gt;&lt;strong&gt;&lt;%=po.Currency%&gt; &lt;%=ifnull(po.Total_Customer_Price,0)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;kv-grid&apos; style=&apos;margin-top:12px&apos;&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;PO date&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(po.PO_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Expected delivery&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(po.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Dispatch location&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(po.Dispatch_Location,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Currency&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(po.Currency,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;section class=&apos;zcs-card section&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h2 class=&apos;section-title&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;Product lines&lt;/h2&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-theme zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;%=products.count()%&gt; lines&lt;/span&gt;&lt;/div&gt;&lt;%if(products.count()==0){%&gt;&lt;div class=&apos;empty&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;No product lines&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;zcs-table-wrapper desktop-products&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;Product&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;Configuration&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Quantity&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Supplier total&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Customer total&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;Remarks&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%for each item in products{%&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;strong&gt;&lt;%=ifnull(item.Product_Name,&quot;Product&quot;)%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;%=ifnull(item.Product_ID,&quot;&quot;)%&gt; &lt;%=ifnull(item.Brand_Make,&quot;&quot;)%&gt; &lt;%=ifnull(item.Model,&quot;&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(item.Approved_Configuration,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=ifnull(item.Quantity,0)%&gt; &lt;%=ifnull(item.Unit_of_Measure,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=item.Currency%&gt; &lt;%=ifnull(item.Supplier_Total_Price,0)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=item.Currency%&gt; &lt;%=ifnull(item.Customer_Total_Price,0)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(item.Remarks,&quot;&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;div class=&apos;mobile-products zcs-direction-column zcs-gap-12&apos;&gt;&lt;%for each mobileItem in products{%&gt;&lt;div class=&apos;record-card&apos;&gt;&lt;strong&gt;&lt;%=ifnull(mobileItem.Product_Name,&quot;Product&quot;)%&gt;&lt;/strong&gt;&lt;div class=&apos;record-meta&apos;&gt;&lt;span&gt;&lt;%=ifnull(mobileItem.Quantity,0)%&gt; &lt;%=ifnull(mobileItem.Unit_of_Measure,&quot;&quot;)%&gt;&lt;/span&gt;&lt;span&gt;Supplier: &lt;%=mobileItem.Currency%&gt; &lt;%=ifnull(mobileItem.Supplier_Total_Price,0)%&gt;&lt;/span&gt;&lt;span&gt;Customer: &lt;%=mobileItem.Currency%&gt; &lt;%=ifnull(mobileItem.Customer_Total_Price,0)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/section&gt;\n&lt;section class=&apos;zcs-card section&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h2 class=&apos;section-title&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;Shipment and QC progress&lt;/h2&gt;&lt;/div&gt;&lt;%stage=0;if(poStatus==&quot;Invoice Paid&quot;){stage=1;}else if(poStatus==&quot;Logistics Pending&quot;){stage=2;}else if(poStatus==&quot;Products Received&quot;){stage=4;}else if(poStatus==&quot;Delivered&quot;){stage=5;}%&gt;&lt;div class=&apos;progress-grid&apos;&gt;&lt;%steps={&quot;Payment cleared&quot;,&quot;Logistics booked&quot;,&quot;In transit&quot;,&quot;Received and QC&quot;,&quot;Delivered&quot;};for each index i in steps{stepClass=&quot;&quot;;if(stage&gt;i){stepClass=&quot;done&quot;;}else if(stage==i+1){stepClass=&quot;current&quot;;}%&gt;&lt;div class=&apos;progress-step &lt;%=stepClass%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=if(stage&gt;i,&quot;ui-1-check-circle-08&quot;,&quot;ui-2-time&quot;)%&gt;&apos;&gt;&lt;/i&gt;&lt;%=steps.get(i)%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:16px&apos;&gt;&lt;%if(receiptRows.count()==0 &amp;&amp; qcRows.count()==0){%&gt;&lt;div class=&apos;empty&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;No receipt or quality-check lines&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;Product&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;Serial details&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;Expected / received&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;Accepted / rejected&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8&apos;&gt;QC result&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;%for each receipt in receiptRows{relatedQC=Logistics_Quality_Check_Product[Logistics_Booking_Product==receipt.ID];%&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;strong&gt;&lt;%=ifnull(receipt.Product_Name,&quot;Product&quot;)%&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(receipt.Serial_Number_Details,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(receipt.Expected_Quantity,0)%&gt; / &lt;%=ifnull(receipt.Received_Quantity,0)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(receipt.Accepted_Quantity,0)%&gt; / &lt;%=ifnull(receipt.Rejected_Quantity,0)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%if(relatedQC.count()==0){%&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-yellow zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;Pending&lt;/span&gt;&lt;%}else{for each qc in relatedQC{%&gt;&lt;strong&gt;&lt;%=ifnull(qc.Quality_Result,&quot;Recorded&quot;)%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;&lt;%=ifnull(qc.Defect_Details,&quot;No defects recorded&quot;)%&gt;&lt;/span&gt;&lt;%}}%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%}%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;section class=&apos;zcs-card section&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h2 class=&apos;section-title&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-4-restore&apos;&gt;&lt;/i&gt;Returns&lt;/h2&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-orange zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;%=returns.count()%&gt;&lt;/span&gt;&lt;/div&gt;&lt;%if(returns.count()==0){%&gt;&lt;div class=&apos;empty&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-4-restore&apos;&gt;&lt;/i&gt;No return requests&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;cards-scroll&apos;&gt;&lt;%for each ret in returns{%&gt;&lt;div class=&apos;record-card&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;a class=&apos;link&apos; href=&apos;#Page:Return_Request_Detail?Return_Request_ID=&lt;%=ret.ID%&gt;&apos;&gt;&lt;%=ret.Return_Request_ID%&gt;&lt;/a&gt;&lt;span&gt;&lt;%=ifnull(ret.Return_Date,&quot;Date not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;record-meta&apos;&gt;&lt;span&gt;&lt;%=ifnull(ret.Damage_Responsibility,&quot;Responsibility not set&quot;)%&gt;&lt;/span&gt;&lt;span&gt;&lt;%=Return_Request_Product[Parent_Return_Request==ret.ID].count()%&gt; product lines&lt;/span&gt;&lt;/div&gt;&lt;p class=&apos;zcs-mb-0&apos;&gt;&lt;%=ifnull(ret.Issue_Description,&quot;No issue description&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/section&gt;\n&lt;/div&gt;&lt;aside class=&apos;stack&apos;&gt;\n&lt;section class=&apos;zcs-card section&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h2 class=&apos;section-title&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-02&apos;&gt;&lt;/i&gt;Supplier, customer and source&lt;/h2&gt;&lt;/div&gt;&lt;div class=&apos;kv-grid&apos;&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Supplier&lt;/label&gt;&lt;strong&gt;&lt;%=supplierName%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Customer&lt;/label&gt;&lt;strong&gt;&lt;%=customerName%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Sales order&lt;/label&gt;&lt;%if(salesOrderID!=null){%&gt;&lt;a class=&apos;link&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=salesOrderID%&gt;&apos;&gt;&lt;%=salesOrderLabel%&gt;&lt;/a&gt;&lt;%}else{%&gt;&lt;span&gt;Not set&lt;/span&gt;&lt;%}%&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Requirement source&lt;/label&gt;&lt;span&gt;&lt;%=sourceType%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Source lead&lt;/label&gt;&lt;span&gt;&lt;%=sourceLead%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Requested delivery&lt;/label&gt;&lt;span&gt;&lt;%=sourceRequestedDate%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Selected quote&lt;/label&gt;&lt;strong&gt;&lt;%=quoteLabel%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Quote date&lt;/label&gt;&lt;span&gt;&lt;%=quoteDate%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Availability&lt;/label&gt;&lt;span&gt;&lt;%=quoteAvailability%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Lead time&lt;/label&gt;&lt;span&gt;&lt;%=quoteLeadTime%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Source requirements&lt;/label&gt;&lt;p class=&apos;text-value&apos;&gt;&lt;%=sourceRequirements%&gt;&lt;/p&gt;&lt;label&gt;Supplier remarks&lt;/label&gt;&lt;p class=&apos;text-value&apos;&gt;&lt;%=quoteRemarks%&gt;&lt;/p&gt;&lt;/div&gt;&lt;div class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;%=quoteProducts.count()%&gt; quoted product lines&lt;/div&gt;&lt;/section&gt;\n&lt;section class=&apos;zcs-card section&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h2 class=&apos;section-title&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;Invoices and payment&lt;/h2&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;%=invoices.count()%&gt;&lt;/span&gt;&lt;/div&gt;&lt;%if(invoices.count()==0){%&gt;&lt;div class=&apos;empty&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;No supplier invoices&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;cards-scroll&apos;&gt;&lt;%for each inv in invoices{invStatus=ifnull(inv.Status,&quot;New&quot;);%&gt;&lt;div class=&apos;record-card&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;a class=&apos;link&apos; href=&apos;#Page:Supplier_Invoice_Detail?Supplier_Invoice_ID=&lt;%=inv.ID%&gt;&apos;&gt;&lt;%=inv.Supplier_Invoice_ID%&gt;&lt;/a&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=if(invStatus==&quot;Paid&quot;,&quot;zcs-badge-green&quot;,&quot;zcs-badge-yellow&quot;)%&gt;&apos;&gt;&lt;%=invStatus%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;record-meta&apos;&gt;&lt;span&gt;Invoice: &lt;%=ifnull(inv.Supplier_Invoice_Number,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;span&gt;&lt;%=ifnull(inv.Invoice_Date,&quot;Date not set&quot;)%&gt;&lt;/span&gt;&lt;span&gt;&lt;%=ifnull(inv.Currency,po.Currency)%&gt; &lt;%=ifnull(inv.Invoice_Amount,0)%&gt;&lt;/span&gt;&lt;span&gt;Paid: &lt;%=ifnull(inv.Paid_Date,&quot;Not yet&quot;)%&gt;&lt;/span&gt;&lt;span&gt;Reference: &lt;%=ifnull(inv.Payment_Reference,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;%if(invStatus==&quot;New&quot;){%&gt;&lt;p class=&apos;zcs-mb-0&apos;&gt;&lt;a class=&apos;link&apos; href=&apos;#Form:Add_Supplier_Invoice?recLinkID=&lt;%=inv.ID%&gt;&amp;amp;viewLinkName=All_Supplier_Invoices&amp;amp;Action_Mode=Mark Paid&amp;amp;zc_LoadIn=dialog&apos;&gt;Mark paid&lt;/a&gt;&lt;/p&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/section&gt;\n&lt;section class=&apos;zcs-card section&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h2 class=&apos;section-title&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;Logistics and delivery&lt;/h2&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;%=bookingLinks.count()%&gt;&lt;/span&gt;&lt;/div&gt;&lt;%if(bookingLinks.count()==0){%&gt;&lt;div class=&apos;empty&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;No logistics booking&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;cards-scroll&apos;&gt;&lt;%for each bookingLink in bookingLinks{bookingList=Create_Logistics_Booking[ID==bookingLink.Parent_Logistics_Booking];if(bookingList.count()&gt;0){booking=bookingList;%&gt;&lt;div class=&apos;record-card&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;a class=&apos;link&apos; href=&apos;#Page:Logistics_Booking_Detail?Logistics_Booking_ID=&lt;%=booking.ID%&gt;&apos;&gt;&lt;%=booking.Logistics_Booking_ID%&gt;&lt;/a&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;%=ifnull(booking.Status,&quot;New&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;record-meta&apos;&gt;&lt;span&gt;&lt;%=ifnull(booking.Logistics_Provider,&quot;Provider not set&quot;)%&gt;&lt;/span&gt;&lt;span&gt;Tracking: &lt;%=ifnull(booking.Tracking_Reference,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;span&gt;Expected: &lt;%=ifnull(booking.Expected_Arrival_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;span&gt;Actual: &lt;%=ifnull(booking.Actual_Arrival_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;span&gt;QC lines: &lt;%=qcRows.count()%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}}%&gt;&lt;/div&gt;&lt;%}%&gt;&lt;div class=&apos;kv-grid&apos; style=&apos;margin-top:12px&apos;&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Delivery date&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(po.Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Delivered by&lt;/label&gt;&lt;span&gt;&lt;%=deliveredBy%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Confirmed&lt;/label&gt;&lt;strong&gt;&lt;%=if(po.Delivery_Confirmation==true,&quot;Yes&quot;,&quot;No&quot;)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Remarks&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(po.Delivery_Remarks,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;section class=&apos;zcs-card section&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h2 class=&apos;section-title&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;Timeline&lt;/h2&gt;&lt;a class=&apos;link&apos; href=&apos;#Report:All_Histories?Purchase_Order_Lookup=&lt;%=po.ID%&gt;&apos;&gt;Open history&lt;/a&gt;&lt;/div&gt;&lt;%if(histories.count()==0){%&gt;&lt;div class=&apos;empty&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;No history entries&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;timeline-scroll zcs-timeline-wrapper&apos;&gt;&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-24 zcs-p-0 zcs-m-0&apos;&gt;&lt;%for each hist in histories{%&gt;&lt;li class=&apos;zcs-tl-li zcs-relative&apos;&gt;&lt;div class=&apos;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&apos;&gt;&lt;span class=&apos;zcs-tl-dot zcs-rounded-half zcs-mt-8 zcs-relative&apos;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;timeline-body&apos;&gt;&lt;strong&gt;&lt;%=ifnull(hist.Action_Type,&quot;Update&quot;)%&gt;&lt;/strong&gt;&lt;div class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;%=ifnull(hist.Updated_Date_Time,&quot;&quot;)%&gt; by &lt;%=ifnull(hist.Updated_By_Email,&quot;System&quot;)%&gt;&lt;/div&gt;&lt;%if(hist.Comments!=null){%&gt;&lt;p class=&apos;zcs-mt-8 zcs-mb-0&apos;&gt;&lt;%=hist.Comments%&gt;&lt;/p&gt;&lt;%}%&gt;&lt;/div&gt;&lt;/li&gt;&lt;%}%&gt;&lt;/ul&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/section&gt;\n&lt;/aside&gt;&lt;/div&gt;\n&lt;section class=&apos;zcs-card section&apos;&gt;&lt;div class=&apos;section-head&apos;&gt;&lt;h2 class=&apos;section-title&apos;&gt;&lt;i class=&apos;zc-li-outline files-single&apos;&gt;&lt;/i&gt;Terms and supporting record&lt;/h2&gt;&lt;/div&gt;&lt;div class=&apos;two-col&apos;&gt;&lt;div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Commercial terms&lt;/label&gt;&lt;p class=&apos;text-value&apos;&gt;&lt;%=ifnull(po.Commercial_Terms,&quot;Not set&quot;)%&gt;&lt;/p&gt;&lt;label&gt;Technical specifications&lt;/label&gt;&lt;p class=&apos;text-value&apos;&gt;&lt;%=ifnull(po.Technical_Specifications,&quot;Not set&quot;)%&gt;&lt;/p&gt;&lt;label&gt;Additional remarks&lt;/label&gt;&lt;p class=&apos;text-value&apos;&gt;&lt;%=ifnull(po.Additional_Remarks,&quot;Not set&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;kv-grid&apos;&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Shared with customer&lt;/label&gt;&lt;strong&gt;&lt;%=if(po.Shared_With_Customer==true,&quot;Yes&quot;,&quot;No&quot;)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Shared date&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(po.Shared_With_Customer_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Approval date&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(po.Customer_Approval_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Approval comments&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(po.Customer_Approval_Comments,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;PO document&lt;/label&gt;&lt;a class=&apos;link&apos; href=&apos;#Report:All_Purchase_Orders?ID=&lt;%=po.ID%&gt;&apos;&gt;Open record&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;kv&apos;&gt;&lt;label&gt;Delivery evidence&lt;/label&gt;&lt;span&gt;&lt;%=if(po.Delivery_Attachment!=null,&quot;Attached&quot;,&quot;Not attached&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;/div&gt;&lt;%}%&gt;\n&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Purchase_Orders
		{
					displayname = "Purchase Orders"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Purchase_Orders_List' elementName='Purchase_Orders_List'>\n\t\t\t\t\t<![CDATA[htmlpage Purchase_Orders_List()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\npos = Create_Purchase_Order[ID != 0] sort by PO_Date desc;\nnewCount = Create_Purchase_Order[Status == &quot;New&quot;].count();\napprovedCount = Create_Purchase_Order[Status == &quot;Approved&quot;].count();\ncustomerApprovedCount = Create_Purchase_Order[Status == &quot;Customer Approved&quot;].count();\ninvoiceCreatedCount = Create_Purchase_Order[Status == &quot;Invoice Created&quot;].count();\ninvoicePaidCount = Create_Purchase_Order[Status == &quot;Invoice Paid&quot;].count();\nlogisticsPendingCount = Create_Purchase_Order[Status == &quot;Logistics Pending&quot;].count();\nproductsReceivedCount = Create_Purchase_Order[Status == &quot;Products Received&quot;].count();\ndeliveredCount = Create_Purchase_Order[Status == &quot;Delivered&quot;].count();\nactionCount = newCount + approvedCount + customerApprovedCount;\nfinanceCount = invoiceCreatedCount;\nfulfillmentCount = invoicePaidCount + logisticsPendingCount + productsReceivedCount;\nopenCount = actionCount + financeCount + fulfillmentCount;\n%&gt;\n&lt;style&gt;\n/* ZCS global utility subset used by this single-snippet page. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color,#6147e5);--zcs-light-bg-color:var(--zcs_brand_light_color,#f1efff);--zcs-page-bg-color:#f3f3f4;--zcs-primary-text-color:var(--zcs_primary_text_color,#1c1c40);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#65657a);--zcs-border-color:var(--zcs_tertiary_border_color,#e5e5ec);--zcs-white-color:#fff;--zcs-primary-btn-text-color:var(--zcs_brand_foreground_color,#fff);--zcs-thead-color:#f8f8fb;--zcs-tr-h-color:#fafaff}\n*{box-sizing:border-box}a{text-decoration:none}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-px-6{padding-left:6px;padding-right:6px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-12{padding-top:12px;padding-bottom:12px}.zcs-m-0{margin:0}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-18{font-size:18px}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-tertiary{color:var(--zcs-secondary-text-color)}.zcs-w-full{width:100%}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}\n#splash-screen{display:none!important}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{width:100%!important;height:100%!important}.zc-container-wrapper .zc-main-content .inner,.zc-page-content-wrapper,.zc-pb-page-content-wrapper,.zc-pb-tile-container,.zc-pb-tile-card{width:100%!important;max-width:none!important}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}\n.po-page{min-height:100%;padding:20px;background:#f7f7f9;font:14px/1.45 Arial,sans-serif;color:var(--zcs-primary-text-color)}.po-header{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:14px}.po-title{display:flex;align-items:center;gap:12px}.po-title-icon{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);font-size:20px}.po-header h1{margin:0 0 2px;font-size:23px;font-weight:600;line-height:1.2}.po-header p{margin:0;color:var(--zcs-secondary-text-color)}.po-total{padding:6px 10px;border:1px solid var(--zcs-border-color);border-radius:8px;background:#fff;color:var(--zcs-secondary-text-color);white-space:nowrap}.po-total strong{color:var(--zcs-primary-text-color);font-size:17px}\n.summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:14px}.summary-card{display:flex;align-items:center;gap:10px;padding:12px 14px}.summary-icon{display:flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:8px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);font-size:17px}.summary-copy span{display:block;color:var(--zcs-secondary-text-color);font-size:12px}.summary-copy strong{font-size:18px;font-weight:600}\n.tab-input{position:absolute;opacity:0;pointer-events:none}.register{overflow:hidden}.zcs-horizontal-tabhead{display:flex;gap:5px;overflow-x:auto;overflow-y:hidden;margin:0;padding:8px 10px;list-style:none;border-bottom:1px solid var(--zcs-border-color);scrollbar-width:none}.zcs-horizontal-tabhead::-webkit-scrollbar{display:none}.zcs-horizontal-tabitem{list-style:none;white-space:nowrap}.zcs-horizontal-tablink{display:flex;align-items:center;gap:7px;padding:7px 10px;border:1px solid transparent;border-radius:16px;color:var(--zcs-secondary-text-color);cursor:pointer}.zcs-horizontal-tabcount{min-width:20px;padding:1px 5px;border-radius:10px;background:var(--zcs-page-bg-color);font-size:11px;text-align:center}.tab-input:nth-of-type(1):checked~.register .tab-all label,.tab-input:nth-of-type(2):checked~.register .tab-action label,.tab-input:nth-of-type(3):checked~.register .tab-finance label,.tab-input:nth-of-type(4):checked~.register .tab-fulfillment label,.tab-input:nth-of-type(5):checked~.register .tab-complete label{border-color:var(--zcs-theme-brand-color);background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color)}\n.table-scroll{height:500px;overflow:auto}.zcs-table-wrapper table{min-width:1080px;border-collapse:collapse}.zcs-table-wrapper thead{position:sticky;top:0;z-index:2}.zcs-table-wrapper th{padding:10px 12px;background:var(--zcs-thead-color);border-bottom:1px solid var(--zcs-border-color);color:var(--zcs-secondary-text-color);font-size:12px;font-weight:600;text-align:left;white-space:nowrap}.zcs-table-wrapper td{padding:11px 12px;border-top:1px solid var(--zcs-border-color);vertical-align:middle}.zcs-table-wrapper tbody tr:hover td{background:var(--zcs-tr-h-color)}.po-row{display:none}.tab-input:nth-of-type(1):checked~.register .po-row,.tab-input:nth-of-type(2):checked~.register .group-action,.tab-input:nth-of-type(3):checked~.register .group-finance,.tab-input:nth-of-type(4):checked~.register .group-fulfillment,.tab-input:nth-of-type(5):checked~.register .group-complete{display:table-row}.primary-link{color:var(--zcs-theme-brand-color);font-weight:600}.subtext{display:block;margin-top:2px;color:var(--zcs-secondary-text-color);font-size:12px}.money{font-weight:600;color:#09598e;white-space:nowrap}.date-cell{white-space:nowrap}.readiness{min-width:150px}.readiness-line{display:flex;justify-content:space-between;gap:8px;margin-bottom:5px;font-size:11px}.readiness-line span:first-child{color:var(--zcs-secondary-text-color)}.zcs-progress-bar{height:6px;border-radius:4px;background:var(--zcs-light-bg-color)}.zcs-progress-bar-indicator{height:100%;border-radius:inherit;background:var(--zcs-theme-brand-color)}\n.zcs-badge{width:auto;border:1px solid;font-size:12px;white-space:nowrap}.zcs-badge-theme{background:var(--zcs-light-bg-color);border-color:var(--zcs-theme-brand-color);color:var(--zcs-theme-brand-color)}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#0b7e55}.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#8b600d}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#1754c7}.zcs-badge-orange{background:#f8f0eb;border-color:#f4660c;color:#b94b0b}.zcs-badge-grey{background:#eee;border-color:#686878;color:#535363}.actions{display:flex;align-items:center;gap:6px;white-space:nowrap}.zcs-custom-btn,.zcs-custom-action-icon{display:inline-flex;align-items:center;justify-content:center;gap:5px;min-height:30px;border:1px solid var(--zcs-theme-brand-color);border-radius:6px;background:#fff;color:var(--zcs-theme-brand-color);font-size:12px}.zcs-custom-btn{padding:5px 9px}.zcs-custom-btn.action-primary{background:var(--zcs-theme-brand-color);color:var(--zcs-primary-btn-text-color)}.zcs-custom-action-icon{width:30px;border-color:var(--zcs-border-color);color:var(--zcs-secondary-text-color)}\n.mobile-list{display:none;padding:10px}.mobile-card{display:none;padding:14px;margin-bottom:10px}.mobile-head,.mobile-meta,.mobile-footer{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.mobile-meta{display:grid;grid-template-columns:1fr 1fr;margin:12px 0}.mobile-meta label{display:block;color:var(--zcs-secondary-text-color);font-size:11px;text-transform:uppercase}.mobile-footer{align-items:center;margin-top:12px}.next-step{display:flex;align-items:flex-start;gap:8px;min-width:0;color:var(--zcs-secondary-text-color);font-size:12px}.next-step i{margin-top:2px;color:var(--zcs-theme-brand-color)}\n.empty-state,.filtered-empty{min-height:320px;display:flex;align-items:center;justify-content:center;padding:20px;text-align:center}.filtered-empty{display:none}.empty-icon{display:flex;align-items:center;justify-content:center;width:46px;height:46px;margin:0 auto 10px;border-radius:12px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);font-size:22px}.empty-state h5,.filtered-empty h5{margin:0;font-size:17px;font-weight:500}.empty-state p,.filtered-empty p{margin:5px 0 0;color:var(--zcs-secondary-text-color)}.tab-input:nth-of-type(2):checked~.register .empty-action,.tab-input:nth-of-type(3):checked~.register .empty-finance,.tab-input:nth-of-type(4):checked~.register .empty-fulfillment,.tab-input:nth-of-type(5):checked~.register .empty-complete{display:flex}\n@media(max-width:850px){.po-page{padding:14px}.summary-grid{grid-template-columns:1fr 1fr}.table-scroll{display:block;height:auto;overflow:visible;border:0}.zcs-table-wrapper table{display:block;min-width:0}.zcs-table-wrapper thead{display:none}.zcs-table-wrapper tbody{display:block}.po-row{padding:14px;margin:10px;border:1px solid var(--zcs-border-color);border-radius:10px;background:#fff}.tab-input:nth-of-type(1):checked~.register .po-row,.tab-input:nth-of-type(2):checked~.register .group-action,.tab-input:nth-of-type(3):checked~.register .group-finance,.tab-input:nth-of-type(4):checked~.register .group-fulfillment,.tab-input:nth-of-type(5):checked~.register .group-complete{display:grid;grid-template-columns:1fr 1fr;gap:10px}.zcs-table-wrapper td{display:block;padding:0;border:0}.zcs-table-wrapper td:nth-child(1),.zcs-table-wrapper td:nth-child(3),.zcs-table-wrapper td:nth-child(7),.zcs-table-wrapper td:nth-child(8){grid-column:1/-1}.zcs-table-wrapper tbody tr:hover td{background:transparent}.mobile-list{display:none}}@media(max-width:540px){.po-header{align-items:flex-start}.po-header p{font-size:12px}.summary-grid{grid-template-columns:1fr 1fr}.summary-card{padding:10px}.tab-input:nth-of-type(1):checked~.register .po-row,.tab-input:nth-of-type(2):checked~.register .group-action,.tab-input:nth-of-type(3):checked~.register .group-finance,.tab-input:nth-of-type(4):checked~.register .group-fulfillment,.tab-input:nth-of-type(5):checked~.register .group-complete{grid-template-columns:1fr}.zcs-table-wrapper td{grid-column:1!important}.actions{width:100%;flex-wrap:wrap}.zcs-custom-btn{flex:1 1 auto}}\n&lt;/style&gt;\n&lt;div class=&apos;po-page&apos;&gt;\n\t&lt;header class=&apos;po-header&apos;&gt;\n\t\t&lt;div class=&apos;po-title&apos;&gt;&lt;span class=&apos;po-title-icon&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h1&gt;Purchase Orders&lt;/h1&gt;&lt;p&gt;Approval, finance, delivery, and completion register&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;po-total&apos;&gt;&lt;strong&gt;&lt;%=pos.count()%&gt;&lt;/strong&gt; total orders&lt;/div&gt;\n\t&lt;/header&gt;\n\t&lt;section class=&apos;summary-grid&apos;&gt;\n\t\t&lt;div class=&apos;summary-card zcs-card&apos;&gt;&lt;span class=&apos;summary-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&apos;summary-copy&apos;&gt;&lt;span&gt;Approval and sharing&lt;/span&gt;&lt;strong&gt;&lt;%=actionCount%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;summary-card zcs-card&apos;&gt;&lt;span class=&apos;summary-icon&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&apos;summary-copy&apos;&gt;&lt;span&gt;Finance handoff&lt;/span&gt;&lt;strong&gt;&lt;%=financeCount%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;summary-card zcs-card&apos;&gt;&lt;span class=&apos;summary-icon&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&apos;summary-copy&apos;&gt;&lt;span&gt;Delivery readiness&lt;/span&gt;&lt;strong&gt;&lt;%=fulfillmentCount%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;summary-card zcs-card&apos;&gt;&lt;span class=&apos;summary-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&apos;summary-copy&apos;&gt;&lt;span&gt;Completed delivery&lt;/span&gt;&lt;strong&gt;&lt;%=deliveredCount%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;/section&gt;\n\t&lt;input class=&apos;tab-input&apos; type=&apos;radio&apos; name=&apos;po-status&apos; id=&apos;po-all&apos; checked&gt;&lt;input class=&apos;tab-input&apos; type=&apos;radio&apos; name=&apos;po-status&apos; id=&apos;po-action&apos;&gt;&lt;input class=&apos;tab-input&apos; type=&apos;radio&apos; name=&apos;po-status&apos; id=&apos;po-finance&apos;&gt;&lt;input class=&apos;tab-input&apos; type=&apos;radio&apos; name=&apos;po-status&apos; id=&apos;po-fulfillment&apos;&gt;&lt;input class=&apos;tab-input&apos; type=&apos;radio&apos; name=&apos;po-status&apos; id=&apos;po-complete&apos;&gt;\n\t&lt;section class=&apos;register zcs-card&apos;&gt;\n\t\t&lt;ul class=&apos;zcs-horizontal-tabhead&apos;&gt;\n\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem tab-all&apos;&gt;&lt;label class=&apos;zcs-horizontal-tablink&apos; for=&apos;po-all&apos;&gt;All &lt;span class=&apos;zcs-horizontal-tabcount&apos;&gt;&lt;%=pos.count()%&gt;&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem tab-action&apos;&gt;&lt;label class=&apos;zcs-horizontal-tablink&apos; for=&apos;po-action&apos;&gt;Approval and sharing &lt;span class=&apos;zcs-horizontal-tabcount&apos;&gt;&lt;%=actionCount%&gt;&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem tab-finance&apos;&gt;&lt;label class=&apos;zcs-horizontal-tablink&apos; for=&apos;po-finance&apos;&gt;Finance &lt;span class=&apos;zcs-horizontal-tabcount&apos;&gt;&lt;%=financeCount%&gt;&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem tab-fulfillment&apos;&gt;&lt;label class=&apos;zcs-horizontal-tablink&apos; for=&apos;po-fulfillment&apos;&gt;Delivery &lt;span class=&apos;zcs-horizontal-tabcount&apos;&gt;&lt;%=fulfillmentCount%&gt;&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem tab-complete&apos;&gt;&lt;label class=&apos;zcs-horizontal-tablink&apos; for=&apos;po-complete&apos;&gt;Completed &lt;span class=&apos;zcs-horizontal-tabcount&apos;&gt;&lt;%=deliveredCount%&gt;&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t&lt;/ul&gt;\n\t\t&lt;%if(pos.count() == 0){%&gt;\n\t\t\t&lt;div class=&apos;empty-state&apos;&gt;&lt;div&gt;&lt;span class=&apos;empty-icon&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;h5&gt;No purchase orders&lt;/h5&gt;&lt;p&gt;Orders will appear here after a supplier selection is converted into a purchase order.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;%}else{%&gt;\n\t\t\t&lt;div class=&apos;table-scroll zcs-table-wrapper&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Purchase order&lt;/th&gt;&lt;th&gt;Customer and sales order&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;th&gt;Dates&lt;/th&gt;&lt;th&gt;Products&lt;/th&gt;&lt;th&gt;Order value&lt;/th&gt;&lt;th&gt;Readiness&lt;/th&gt;&lt;th&gt;Actions&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t&lt;%for each po in pos {\n\t\t\t\t\tstatusValue=ifnull(po.Status,&quot;Unknown&quot;); statusClass=&quot;group-action&quot;; badgeClass=&quot;zcs-badge-theme&quot;; badgeIcon=&quot;loader-dots-06&quot;; nextStep=&quot;Review missing status&quot;; progress=10; progressLabel=&quot;Needs review&quot;; actionLabel=&quot;&quot;; actionIcon=&quot;arrows-1-tail-right&quot;; actionUrl=&quot;&quot;;\n\t\t\t\t\tif(statusValue == &quot;New&quot;){badgeClass=&quot;zcs-badge-yellow&quot;;nextStep=&quot;Approve purchase order&quot;;progress=12;progressLabel=&quot;Approval&quot;;if(po.Sales_Order != null){actionLabel=&quot;Approve&quot;;actionIcon=&quot;ui-1-check-circle-08&quot;;}}\n\t\t\t\t\telse if(statusValue == &quot;Approved&quot;){badgeClass=&quot;zcs-badge-orange&quot;;progress=25;progressLabel=&quot;Sharing&quot;;if(po.Shared_With_Customer == true){nextStep=&quot;Record customer approval&quot;;actionLabel=&quot;Customer approval&quot;;actionIcon=&quot;ui-1-check-circle-08&quot;;}else{nextStep=&quot;Share with customer&quot;;actionLabel=&quot;Share&quot;;actionIcon=&quot;ui-1-share-66&quot;;}}\n\t\t\t\t\telse if(statusValue == &quot;Customer Approved&quot;){badgeClass=&quot;zcs-badge-blue&quot;;nextStep=&quot;Create supplier invoice&quot;;progress=38;progressLabel=&quot;Finance ready&quot;;actionLabel=&quot;Create invoice&quot;;actionIcon=&quot;files-single-copy-04&quot;;}\n\t\t\t\t\telse if(statusValue == &quot;Invoice Created&quot;){statusClass=&quot;group-finance&quot;;badgeClass=&quot;zcs-badge-blue&quot;;nextStep=&quot;Complete payment&quot;;progress=50;progressLabel=&quot;Payment&quot;;actionLabel=&quot;Review invoice&quot;;actionIcon=&quot;files-single-copy-04&quot;;}\n\t\t\t\t\telse if(statusValue == &quot;Invoice Paid&quot;){statusClass=&quot;group-fulfillment&quot;;badgeClass=&quot;zcs-badge-green&quot;;nextStep=&quot;Create logistics booking&quot;;progress=63;progressLabel=&quot;Logistics ready&quot;;actionLabel=&quot;Create logistics&quot;;actionIcon=&quot;transport-delivery-fast&quot;;}\n\t\t\t\t\telse if(statusValue == &quot;Logistics Pending&quot;){statusClass=&quot;group-fulfillment&quot;;badgeClass=&quot;zcs-badge-blue&quot;;nextStep=&quot;Track shipment and receiving&quot;;progress=75;progressLabel=&quot;In transit&quot;;actionLabel=&quot;View logistics&quot;;actionIcon=&quot;transport-delivery-fast&quot;;}\n\t\t\t\t\telse if(statusValue == &quot;Products Received&quot;){statusClass=&quot;group-fulfillment&quot;;badgeClass=&quot;zcs-badge-green&quot;;nextStep=&quot;Confirm customer delivery&quot;;progress=88;progressLabel=&quot;Delivery ready&quot;;actionLabel=&quot;Confirm delivery&quot;;actionIcon=&quot;ui-1-check-circle-08&quot;;}\n\t\t\t\t\telse if(statusValue == &quot;Delivered&quot;){statusClass=&quot;group-complete&quot;;badgeClass=&quot;zcs-badge-green&quot;;badgeIcon=&quot;ui-1-check-circle-08&quot;;nextStep=&quot;Delivery complete&quot;;progress=100;progressLabel=&quot;Complete&quot;;actionLabel=&quot;Create return&quot;;actionIcon=&quot;arrows-4-restore&quot;;}\n\t\t\t\t\tproductCount=Purchase_Order_Product[Parent_Purchase_Order == po.ID].count(); supplierName=&quot;Supplier not set&quot;; customerName=&quot;Customer not set&quot;; salesOrderName=&quot;Sales order not set&quot;; salesOrderID=&quot;&quot;; if(po.Supplier != null){supplierName=ifnull(po.Supplier.Supplier_Name,&quot;Supplier not set&quot;);} if(po.Customer != null){customerName=ifnull(po.Customer.Customer_Name,&quot;Customer not set&quot;);} if(po.Sales_Order != null){salesOrderName=ifnull(po.Sales_Order.Sales_Order_ID,&quot;Sales order not set&quot;);salesOrderID=po.Sales_Order.ID.toString();}\n\t\t\t\t\tif(statusValue == &quot;New&quot; &amp;&amp; actionLabel != &quot;&quot;){actionUrl=&quot;#Form:Add_History?Purchase_Order_Lookup=&quot; + po.ID + &quot;&amp;amp;Sales_Order_Lookup=&quot; + salesOrderID + &quot;&amp;amp;Action_Type=Purchase Order Approved&amp;amp;Status=New&amp;amp;Previous_Status=New&amp;amp;New_Status=Approved&amp;amp;zc_LoadIn=dialog&quot;;}\n\t\t\t\t\telse if(statusValue == &quot;Approved&quot; &amp;&amp; po.Shared_With_Customer == true){actionUrl=&quot;#Form:Create_Purchase_Order?recLinkID=&quot; + po.ID + &quot;&amp;amp;viewLinkName=All_Purchase_Orders&amp;amp;Action_Mode=Customer Approval&amp;amp;zc_LoadIn=dialog&quot;;}\n\t\t\t\t\telse if(statusValue == &quot;Approved&quot;){actionUrl=&quot;#Form:Create_Purchase_Order?recLinkID=&quot; + po.ID + &quot;&amp;amp;viewLinkName=All_Purchase_Orders&amp;amp;Action_Mode=Share With Customer&amp;amp;zc_LoadIn=dialog&quot;;}\n\t\t\t\t\telse if(statusValue == &quot;Customer Approved&quot;){actionUrl=&quot;#Form:Add_Supplier_Invoice?Purchase_Order=&quot; + po.ID + &quot;&amp;amp;zc_LoadIn=dialog&quot;;}\n\t\t\t\t\telse if(statusValue == &quot;Invoice Created&quot;){actionUrl=&quot;#Report:All_Supplier_Invoices?Purchase_Order=&quot; + po.ID;}\n\t\t\t\t\telse if(statusValue == &quot;Invoice Paid&quot;){actionUrl=&quot;#Form:Create_Logistics_Booking?zc_LoadIn=dialog&quot;;}\n\t\t\t\t\telse if(statusValue == &quot;Logistics Pending&quot;){actionUrl=&quot;#Report:All_Logistics_Bookings?Purchase_Orders=&quot; + po.ID;}\n\t\t\t\t\telse if(statusValue == &quot;Products Received&quot;){actionUrl=&quot;#Form:Create_Purchase_Order?recLinkID=&quot; + po.ID + &quot;&amp;amp;viewLinkName=All_Purchase_Orders&amp;amp;Action_Mode=Confirm Delivery&amp;amp;zc_LoadIn=dialog&quot;;}\n\t\t\t\t\telse if(statusValue == &quot;Delivered&quot;){actionUrl=&quot;#Form:Create_Return_Request?Purchase_Order=&quot; + po.ID + &quot;&amp;amp;zc_LoadIn=dialog&quot;;}\n\t\t\t\t%&gt;\n\t\t\t\t\t&lt;tr class=&apos;po-row &lt;%=statusClass%&gt;&apos;&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;a class=&apos;primary-link&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=po.ID%&gt;&apos;&gt;&lt;%=ifnull(po.Purchase_Order_ID,&quot;PO record&quot;)%&gt;&lt;/a&gt;&lt;span class=&apos;subtext&apos;&gt;&lt;%=supplierName%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;strong&gt;&lt;%=customerName%&gt;&lt;/strong&gt;&lt;%if(salesOrderID != &quot;&quot;){%&gt;&lt;a class=&apos;subtext primary-link&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=salesOrderID%&gt;&apos;&gt;&lt;%=salesOrderName%&gt;&lt;/a&gt;&lt;%}else{%&gt;&lt;span class=&apos;subtext&apos;&gt;&lt;%=salesOrderName%&gt;&lt;/span&gt;&lt;%}%&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;span class=&apos;zcs-badge zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=badgeClass%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=badgeIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;%=statusValue%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;date-cell&apos;&gt;&lt;%=ifnull(po.PO_Date,&quot;Not set&quot;)%&gt;&lt;span class=&apos;subtext&apos;&gt;Due &lt;%=ifnull(po.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;strong&gt;&lt;%=productCount%&gt;&lt;/strong&gt; product&lt;%=if(productCount == 1,&quot;&quot;,&quot;s&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;money&apos;&gt;&lt;%=ifnull(po.Currency,&quot;&quot;)%&gt; &lt;%=ifnull(po.Total_Customer_Price,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;div class=&apos;readiness&apos;&gt;&lt;div class=&apos;readiness-line&apos;&gt;&lt;span&gt;&lt;%=progressLabel%&gt;&lt;/span&gt;&lt;strong&gt;&lt;%=progress%&gt;%&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=progress%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;subtext&apos;&gt;&lt;%=nextStep%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;div class=&apos;actions&apos;&gt;&lt;a class=&apos;zcs-custom-action-icon&apos; title=&apos;Detail&apos; aria-label=&apos;Detail&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=po.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-zoom-split&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;%if(actionUrl != &quot;&quot;){%&gt;&lt;a class=&apos;zcs-custom-btn action-primary&apos; href=&apos;&lt;%=actionUrl%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=actionIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;%=actionLabel%&gt;&lt;/a&gt;&lt;%}%&gt;&lt;a class=&apos;zcs-custom-action-icon&apos; title=&apos;History&apos; aria-label=&apos;History&apos; href=&apos;#Report:All_Histories?Purchase_Order_Lookup=&lt;%=po.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;article class=&apos;mobile-card zcs-card &lt;%=statusClass%&gt;&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;mobile-head&apos;&gt;&lt;div&gt;&lt;a class=&apos;primary-link zcs-font-15&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=po.ID%&gt;&apos;&gt;&lt;%=ifnull(po.Purchase_Order_ID,&quot;PO record&quot;)%&gt;&lt;/a&gt;&lt;span class=&apos;subtext&apos;&gt;&lt;%=supplierName%&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 &lt;%=badgeClass%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=badgeIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;%=statusValue%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;mobile-meta&apos;&gt;&lt;div&gt;&lt;label&gt;Customer&lt;/label&gt;&lt;strong&gt;&lt;%=customerName%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;label&gt;Sales order&lt;/label&gt;&lt;%if(salesOrderID != &quot;&quot;){%&gt;&lt;a class=&apos;primary-link&apos; href=&apos;#Page:Sales_Order_Detail?Sales_Order_ID=&lt;%=salesOrderID%&gt;&apos;&gt;&lt;%=salesOrderName%&gt;&lt;/a&gt;&lt;%}else{%&gt;&lt;span&gt;&lt;%=salesOrderName%&gt;&lt;/span&gt;&lt;%}%&gt;&lt;/div&gt;&lt;div&gt;&lt;label&gt;Expected delivery&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(po.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;label&gt;Order value&lt;/label&gt;&lt;strong class=&apos;money&apos;&gt;&lt;%=ifnull(po.Currency,&quot;&quot;)%&gt; &lt;%=ifnull(po.Total_Customer_Price,0)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;readiness&apos;&gt;&lt;div class=&apos;readiness-line&apos;&gt;&lt;span&gt;&lt;%=progressLabel%&gt;&lt;/span&gt;&lt;strong&gt;&lt;%=progress%&gt;%&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=progress%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;mobile-footer&apos;&gt;&lt;div class=&apos;next-step&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=nextStep%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;actions&apos;&gt;&lt;a class=&apos;zcs-custom-btn&apos; href=&apos;#Page:Purchase_Order_Detail?Purchase_Order_ID=&lt;%=po.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-zoom-split&apos;&gt;&lt;/i&gt;Detail&lt;/a&gt;&lt;%if(actionUrl != &quot;&quot;){%&gt;&lt;a class=&apos;zcs-custom-btn action-primary&apos; href=&apos;&lt;%=actionUrl%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=actionIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;%=actionLabel%&gt;&lt;/a&gt;&lt;%}%&gt;&lt;a class=&apos;zcs-custom-action-icon&apos; title=&apos;History&apos; aria-label=&apos;History&apos; href=&apos;#Report:All_Histories?Purchase_Order_Lookup=&lt;%=po.ID%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/article&gt;\n\t\t\t\t&lt;%}%&gt;\n\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;mobile-list&apos;&gt;&lt;/div&gt;\n\t\t\t&lt;%if(actionCount == 0){%&gt;&lt;div class=&apos;filtered-empty empty-action&apos;&gt;&lt;div&gt;&lt;span class=&apos;empty-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;h5&gt;No approval or sharing work&lt;/h5&gt;&lt;p&gt;No purchase orders currently need this handoff.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}%&gt;\n\t\t\t&lt;%if(financeCount == 0){%&gt;&lt;div class=&apos;filtered-empty empty-finance&apos;&gt;&lt;div&gt;&lt;span class=&apos;empty-icon&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;h5&gt;No finance handoffs&lt;/h5&gt;&lt;p&gt;No purchase orders are waiting on invoice or payment work.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}%&gt;\n\t\t\t&lt;%if(fulfillmentCount == 0){%&gt;&lt;div class=&apos;filtered-empty empty-fulfillment&apos;&gt;&lt;div&gt;&lt;span class=&apos;empty-icon&apos;&gt;&lt;i class=&apos;zc-li-outline transport-delivery-fast&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;h5&gt;No delivery-readiness work&lt;/h5&gt;&lt;p&gt;No paid orders are in logistics or receiving.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}%&gt;\n\t\t\t&lt;%if(deliveredCount == 0){%&gt;&lt;div class=&apos;filtered-empty empty-complete&apos;&gt;&lt;div&gt;&lt;span class=&apos;empty-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;h5&gt;No completed deliveries&lt;/h5&gt;&lt;p&gt;Completed deliveries will appear here.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;%}%&gt;\n\t\t&lt;%}%&gt;\n\t&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

