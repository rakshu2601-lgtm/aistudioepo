			string ImportantFunctions.getSignatureURL(string SignatureName, int recID, string fieldLinkName, string reportName, string publicLink)
			{
			
			                 	if(input.SignatureName != "")
			                 	{
			                 		if(input.publicLink != "")
			                 		{
			                 			// 			if(input.SignatureName.contains("lowqual"))
			                 			// 		    {
			                 			// 		   	imagefile = input.SignatureName.getSuffix("fieldName/image/").getPrefix("\" lowqual");
			                 			// 			}
			                 			// 			prod_img = "https://creatorapp.zohopublic.com" + zoho.appuri + "report/All_Service_Closures/" + rec.ID + "/Customer_Signature/download-file/hqmgS1K8TPVAUyA1w2wbfdE3kq9K3zKDjPevZOrvpkTaykbMBBKqjeGtfmAYrrevxuyA1ppZhRDeRmBUBpzk2y2upX9msezHsDBT?filepath=/" + rec.Customer_Signature;
			                 			prod_img = "https://creatorapp.zohopublic.com" + zoho.appuri + "report/" + input.reportName + "/" + input.recID + "/" + input.fieldLinkName + "/download-file/" + input.publicLink + "?filepath=/" + input.SignatureName;
			                 		}
			                 		else
			                 		{
			                 			prod_img = thisapp.ImportantFunctions.getImageURL(input.SignatureName,input.fieldLinkName,input.reportName,input.recID);
			                 		}
			                 	}
			                 	else
			                 	{
			                 		prod_img = "https://files-accl.zohoexternal.com/public/workdrive-external/download/1aent25160252f45749d0a527538d0fabb776?x-cli-msg=%7B%22linkId%22%3A%226OxchHwUjPM-J8HFH%22%2C%22isFileOwner%22%3Afalse%2C%22version%22%3A%221.0%22%2C%22isWDSupport%22%3Afalse%7D";
			                 	}
			                 	return prod_img;
			                 
			}

			string styles.getStarStyleWithFormRadio(string selectedClr, string unselectedClr)
			{
			
			                 	return "<style>.choice-table-row .choice-table-cell span .customRadio+label::before { content: '★'; font-size: 18px; color: " + if(unselectedClr != "",unselectedClr,"lightgray") + "; } .form-field .tempContDiv .choice-table-cell { padding: 0 20px 0 0 !important; } .choice-table-row .choice-table-cell span .customRadio+label, .choice-table-row .choice-table-cell span .customCheckbox+label { top: 0; border: unset !important; display: flex; align-items: center; outline: unset !important; } .choice-table-cell:has(~ .choice-table-cell .customRadio:checked) span .customRadio+label::before, .choice-table-cell span .customRadio:checked +label::before{ color: " + if(unselectedClr != "",selectedClr,"gold") + "; } .customRadio+label+.choice-label-text, .customRadio:checked+label:after { display: none; }</style>";
			                 
			}

			bool isNotificationEnabled(string type)
			{
			
			                 	fetchPreference = Add_Preference[ID != null];
			                 	if(fetchPreference.count() != 0)
			                 	{
			                 		if(type == "Email")
			                 		{
			                 			return fetchPreference.Email_Notification;
			                 		}
			                 		else if(type == "App")
			                 		{
			                 			return fetchPreference.App_Notification;
			                 		}
			                 	}
			                 	return false;
			                 
			}

			collection modifyMemoContent(int templateID, int vendorID, int invoiceID, int invoiceID1)
			{
			
			                 	nullList = {"",null};
			                 	fetchTemplate = Create_Template[ID == input.templateID];
			                 	returnContent = "";
			                 	returnSubj = "";
			                 	if(fetchTemplate.count() != 0)
			                 	{
			                		returnContent = fetchTemplate.Template_1;
			                 		returnSubj = fetchTemplate.Template_Subject;
			                 		fetchRequest = Add_Preference[ID == input.vendorID];
			                 		emailFor = fetchTemplate.Email_For;
			                 		dynContentMap = Map();
			                 		if(emailFor in {"Transfer Request Initiation","Transfer Request Approval","Transfer Request Rejection"})
			                 		{
			                 			dynContentMap.put("Request_ID",fetchRequest.ID);
			                 		}
			                 		for each  rec in dynContentMap.Keys()
			                 		{
			                 			// 			dynContent1 = "<" + rec + ">";
			                 			// 			dynContent2 = "&lt;" + rec + "&gt;";
			                 			dynContent1 = "${" + rec + "}";
			                 			dynContent2 = "&#36;&#123;" + rec + "&#125;";
			                 			if(returnContent.contains(dynContent1))
			                 			{
			                 				returnContent = returnContent.replaceAll(dynContent1,dynContentMap.get(rec),true);
			                 			}
			                 			if(returnContent.contains(dynContent2))
			                 			{
			                 				returnContent = returnContent.replaceAll(dynContent2,dynContentMap.get(rec),true);
			                 			}
			                 			if(returnSubj.contains(dynContent1))
			                 			{
			                 				returnSubj = returnSubj.replaceAll(dynContent1,dynContentMap.get(rec),true);
			                 			}
			                 			if(returnSubj.contains(dynContent2))
			                 			{
			                 				returnSubj = returnSubj.replaceAll(dynContent2,dynContentMap.get(rec),true);
			                 			}
			                 		}
			                 	}
			                 	return {"subj":returnSubj,"content":returnContent};
			                 
			}

			int searchKeyCount(string content, string target, int count)
			{
			
			                 	if(content.contains(target))
			                 	{
			                 		content = content.getsuffix(target);
			                 		return thisapp.searchKeyCount(content,target,count + 1);
			                 	}
			                 	return count;
			                 
			}

