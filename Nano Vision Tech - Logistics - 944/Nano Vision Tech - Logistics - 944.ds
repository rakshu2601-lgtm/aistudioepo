	        report Approval_Setup_For_Report { icon = "business-hierarchy-54" }
	        report Create_Template_Report { icon = "business-notes" }
	        report Request_Access_Report { icon = "business-safe" }
	    }
	    space Admin
	    {
	        displayname = "Admin"
	        icon = "business-building"
	        section Admin_Dashboard_Section { displayname = "Dashboard" icon = "business-chart" page Admin_Dashboard { icon = "business-chart-pie-36" } }
	        section Masters { displayname = "Masters" icon = "business-contacts" report All_Customers { icon = "business-business-contact-85" } report All_Suppliers { icon = "business-handshake" } report All_Products { icon = "tech-computer" } }
	        section Operations { displayname = "Operations" icon = "business-progress" report All_Leads { icon = "business-goal-65" } report All_Sales_Orders { icon = "shopping-list" } report All_Histories { icon = "business-notes" } }
	        section SharedAnalytics_Section { type = shared_user_report_section displayname = "Reports" icon = "business-chart-bar-33" }
	    }
	    space Sales { displayname = "Sales" icon = "business-money-growth" section Sales_Dashboard_Section { displayname = "Dashboard" icon = "business-chart" page Sales_Dashboard { icon = "business-chart-bar-32" } } section Sales_Work { displayname = "Sales Work" icon = "business-goal-64" page Leads { icon = "business-goal-65" } page Sales_Orders { icon = "shopping-list" } page Purchase_Orders { icon = "shopping-cart" } page Supplier_Invoices { icon = "business-cheque" } page Return_Requests { icon = "shopping-box-ribbon" } } }
	    space RD { displayname = "R&D" icon = "business-bulb-61" section RD_Dashboard_Section { displayname = "Dashboard" icon = "business-chart" page RD_Dashboard { icon = "business-board-29" } } section Market_Requirements { displayname = "Market Requirements" icon = "business-bulb-63" page Products { icon = "tech-computer" } page Quote_Comparison { icon = "business-chart-bar-32" } } }
	    space Sourcing { displayname = "Sourcing" icon = "business-handshake" section Sourcing_Dashboard_Section { displayname = "Dashboard" icon = "business-chart" page Sourcing_Dashboard { icon = "business-chart-bar-32" } } section Sourcing_Work { displayname = "Sourcing" icon = "shopping-tag" page Supplier_Quotes { icon = "shopping-tag-content" } report All_Supplier_Quotes { icon = "shopping-tag-line" } report All_Purchase_Orders { icon = "shopping-cart-modern" } } }
	    space Logistics { displayname = "Logistics" icon = "transportation-truck-front" section Logistics_Dashboard_Section { displayname = "Dashboard" icon = "business-chart" page Logistics_Dashboard { icon = "shopping-delivery-track" } } section Logistics_Work { displayname = "Logistics Work" icon = "shopping-delivery" page Logistics_Bookings { icon = "transportation-truck-front" } report All_Logistics_Bookings { icon = "shopping-delivery-time" } report All_Supplier_Invoices { icon = "shopping-receipt" } report All_Return_Requests { icon = "shopping-box" } } }
	    space Supplier { displayname = "Supplier" icon = "business-factory" section Supplier_Dashboard_Section { displayname = "Dashboard" icon = "business-chart" page Supplier_Dashboard { icon = "business-laptop-71" } } section Supplier_Work { displayname = "Supplier Work" icon = "business-handshake" page Requests_For_Quote { icon = "shopping-tag" } } }
	    preference { icon { style = outline show = {space,section,component} } }
	}
	customize
	{
	    layout = twocolumn
	    font = "lato"
	    style = "3"
	    color options
	    {
	        name = "Nano Vision Blue"
	        brand color = "#6147E5"
	        type = "custom"
	        dark mode color = "#6147E5"
	    }
	    logo
	    {
	        preference = "app_icon"
	    }
	}
	}

	translation
	{
	
	{"Language_Settings":{"LANGAGUE_WITH_LOGIN":"browser"}}
	
	}

	connections
	{
	
			creator
			(
				displayname = "Creator"
				auth per env = true
				connector = zoho_oauth
				permissions = {"ZohoCreator.bulk.CREATE","ZohoCreator.bulk.READ","ZohoCreator.dashboard.READ","ZohoCreator.form.CREATE","ZohoCreator.meta.application.READ","ZohoCreator.meta.form.READ","ZohoCreator.report.CREATE","ZohoCreator.report.DELETE","ZohoCreator.report.READ","ZohoCreator.report.UPDATE"}
			)
		
	}
}
