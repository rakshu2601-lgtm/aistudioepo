	reports
	{
		default list All_Approval_Setups
		{
		
					displayName = "All Approval Setups"
					show all rows from Add_Approval_Setup    
					(
						Level_Name as "Level Name"
						Approver_Type as "Approver Type"
						Sequence_Order as "Sequence Order"
						Previous_Sequence_Number as "Previous Sequence Number"
						Status
						Approval_Setup_For as "Approval Setup For"
					)
				
		}

		default list All_Customers
		{
		    displayName = "All Customers"
		    show all rows from Add_Customer
		    (
		        Customer_ID as "Customer ID"
		        Customer_Name as "Customer Name"
		        Contact_Person as "Contact Person"
		        Email
		        Phone
		        (
		            displayformat = plainnumber
		        )
		        Country
		        Active
		    )
		    sort by
		    (
		        Customer_Name ascending
		    )
		}

		default list All_Employees
		{
		
					displayName = "All Employees"
					show all rows from Add_Employee    
					(
						Role
						(
							width = 224px
						)
						Reporting_Manager as "Reporting Manager"
						Employee_Name  as "Employee Name"
			 			(
							width = 282px
			 			)
						Employee_ID as "Employee ID"
						(
							width = 233px
						)
						Gender
						(
							width = 202px
						)
						Profile_Image as "Profile Image"
						(
							width = 137px
						)
						Email
						Phone as "Mobile Number"
						(
							displayformat = plainnumber 
						)
						Date_of_Birth as "Date of Birth"
					)
				
		}

		default list All_Histories
		{
		    displayName = "All Histories"
		    show all rows from Add_History
		    (
		        Action_Type as "Action Type"
		        Status
		        Previous_Status as "Previous Status"
		        New_Status as "New Status"
		        Comments
		        Lead_Lookup as "Lead"
		        Sales_Order_Lookup as "Sales Order"
		        Supplier_Quote_Lookup as "Supplier Quote"
		        Purchase_Order_Lookup as "Purchase Order"
		        Supplier_Invoice_Lookup as "Supplier Invoice"
		        Logistics_Booking_Lookup as "Logistics Booking"
		        Return_Request_Lookup as "Return Request"
		        Updated_By as "Updated By"
		        Updated_By_Email as "Updated By Email"
		        Updated_Date_Time as "Updated Date Time"
		    )
		    filters
		    (
		        Action_Type
		        Status
		        Updated_By
		        Updated_Date_Time
		    )
		    sort by
		    (
		        Updated_Date_Time descending
		    )
		}

		default list All_Leads
		{
		    displayName = "All Leads"
		    show all rows from Add_Lead
		    (
		        Lead_ID as "Lead ID"
		        Lead_Source as "Lead Source"
		        Customer
		        Customer_Company_Name as "Customer Company Name"
		        Contact_Person as "Contact Person"
		        Email
		        Phone
		        Country
		        Expected_Price as "Expected Price"
		        Sales_Agent as "Sales Agent"
		        Lead_Date as "Lead Date"
		        Status
		        custom action "Create Sales Order"
		        (
		            workflow = Create_Sales_Order_From_Lead
		            show action for each record = true
		            column header = "Create Sales Order"
		            success message = "Sales order created"
		            condition = (Status == "New")
		            confirmation before execution
		            (
		                message for individual record = "Create a sales order from this lead?"
		                confirm button text = "Create"
		                cancel button text = "Cancel"
		            )
		        )
		        custom action "Mark Lost"
		        (
		            workflow = Mark_Lead_Lost
		            show action for each record = true
		            column header = "Mark Lost"
		            success message = "Lead marked lost"
		            condition = (Status == "New")
		            confirmation before execution
		            (
		                message for individual record = "Mark this lead as lost?"
		                confirm button text = "Mark Lost"
		                cancel button text = "Cancel"
		            )
		        )
		    )
		    filters
		    (
		        Lead_Source
		        Sales_Agent
		        Lead_Date
		        Status
		    )
		    sort by
		    (
		        Lead_Date descending
		    )
		}

		default list All_Preferences
		{
		
					displayName = "All Preferences"
					show all rows from Add_Preference    
					(
						Organization_Logo as "Organization Logo"
						Email_Notification as "Email Notification"
						App_Notification as "App Notification"
					)
				
		}

		default list All_Products
		{
		    displayName = "All Products"
		    show all rows from Add_Product
		    (
		        Product_ID as "Product ID"
		        Product_Name as "Product Name"
		        Product_Category as "Product Category"
		        Product_Type as "Product Type"
		        Brand_Make as "Brand / Make"
		        Model
		        Internal_Part_Number as "Internal Part Number"
		        Unit_of_Measure as "Unit of Measure"
		        Default_Currency as "Default Currency"
		        Reference_Cost as "Reference Cost"
		        Reference_Selling_Price as "Reference Selling Price"
		        Active
		        custom action "Activate"
		        (
		            workflow = Activate_Product
		            show action for each record = true
		            column header = "Activate"
		            success message = "Product activated"
		            condition = (Active == false)
		            confirmation before execution
		            (
		                message for individual record = "Activate this product?"
		                confirm button text = "Activate"
		                cancel button text = "Cancel"
		            )
		        )
		        custom action "Deactivate"
		        (
		            workflow = Deactivate_Product
		            show action for each record = true
		            column header = "Deactivate"
		            success message = "Product deactivated"
		            condition = (Active == true)
		            confirmation before execution
		            (
		                message for individual record = "Deactivate this product?"
		                confirm button text = "Deactivate"
		                cancel button text = "Cancel"
		            )
		        )
		    )
		    filters
		    (
		        Product_Category
		        Product_Type
		        Active
		    )
		    sort by
		    (
		        Product_Name ascending
		    )
		}

		default list All_Roles
		{
		
					displayName = "All Roles"
					show all rows from Add_Role    
					(
						Role
					)
				
		}

		default list All_Suppliers
		{
		    displayName = "All Suppliers"
		    show all rows from Add_Supplier
		    (
		        Supplier_ID as "Supplier ID"
		        Supplier_Name as "Supplier Name"
		        Contact_Person as "Contact Person"
		        Email
		        Phone
		        (
		            displayformat = plainnumber
		        )
		        Country
		        Active
		    )
		    sort by
		    (
		        Supplier_Name ascending
		    )
		}

		default list All_Supplier_Invoices
		{
		    displayName = "All Supplier Invoices"
		    show all rows from Add_Supplier_Invoice
		    (
		        Supplier_Invoice_ID as "Supplier Invoice ID"
		        Supplier
		        Purchase_Order as "Purchase Order"
		        Sales_Order as "Sales Order"
		        Supplier_Invoice_Number as "Supplier Invoice Number"
		        Invoice_Date as "Invoice Date"
		        Invoice_Amount as "Invoice Amount"
		        Currency
		        Paid_Date as "Paid Date"
		        Payment_Reference as "Payment Reference"
		        Status
		        custom action "Mark Paid"
		        (
		            workflow = Mark_Supplier_Invoice_Paid
		            show action for each record = true
		            column header = "Mark Paid"
		            condition = (Status == "New")
		        )
		    )
		    filters
		    (
		        Supplier
		        Purchase_Order
		        Invoice_Date
		        Currency
		        Status
		    )
		    sort by
		    (
		        Invoice_Date descending
		    )
		}

		default list All_Supplier_Quotes
		{
		    displayName = "All Supplier Quotes"
		    show all rows from Add_Supplier_Quote
		    (
		        Supplier_Quote_ID as "Supplier Quote ID"
		        Supplier
		        Sales_Order as "Sales Order"
		        Quote_Date as "Quote Date"
		        Currency
		        Availability
		        Lead_Time as "Lead Time"
		        Dispatch_Location as "Dispatch Location"
		        Status
		    )
		    filters
		    (
		        Supplier
		        Sales_Order
		        Quote_Date
		        Currency
		        Status
		    )
		    sort by
		    (
		        Quote_Date descending
		    )
		}

		default list Approval_Setup_For_Report
		{
		
					displayName = "Approval Setup For Report"
					show all rows from Approval_Setup_For    
					(
						Approval_Setup_For as "Approval Setup For"
					)
				
		}

		default list All_Logistics_Bookings
		{
		    displayName = "All Logistics Bookings"
		    show all rows from Create_Logistics_Booking
		    (
		        Logistics_Booking_ID as "Logistics Booking ID"
		        Booking_Date as "Booking Date"
		        Logistics_Provider as "Logistics Provider"
		        Suppliers
		        Pickup_Location as "Pickup Location"
		        Warehouse_Destination as "Warehouse Destination"
		        Expected_Arrival_Date as "Expected Arrival Date"
		        Actual_Arrival_Date as "Actual Arrival Date"
		        Tracking_Reference as "Tracking Reference"
		        Received_By as "Received By"
		        Received_Date as "Received Date"
		        Quality_Checked_By as "Quality Checked By"
		        Quality_Check_Date as "Quality Check Date"
		        Status
		    )
		    filters
		    (
		        Booking_Date
		        Logistics_Provider
		        Suppliers
		        Expected_Arrival_Date
		        Status
		    )
		    sort by
		    (
		        Booking_Date descending
		    )
		}

		default list All_Purchase_Orders
		{
		    displayName = "All Purchase Orders"
		    show all rows from Create_Purchase_Order
		    (
		        Purchase_Order_ID as "Purchase Order ID"
		        Supplier
		        Sales_Order as "Sales Order"
		        Selected_Supplier_Quote as "Selected Supplier Quote"
		        Customer
		        PO_Date as "PO Date"
		        Expected_Delivery_Date as "Expected Delivery Date"
		        Currency
		        Supplier_Price as "Supplier Price"
		        Total_Customer_Price as "Total Customer Price"
		        Shared_With_Customer as "Shared with Customer"
		        Status
		        custom action "Approve Purchase Order"
		        (
		            workflow = Approve_Purchase_Order
		            show action for each record = true
		            column header = "Approve Purchase Order"
		            condition = (Status == "New")
		        )
		    )
		    filters
		    (
		        Supplier
		        Customer
		        PO_Date
		        Currency
		        Status
		    )
		    sort by
		    (
		        PO_Date descending
		    )
		}

		default list All_Return_Requests
		{
		    displayName = "All Return Requests"
		    show all rows from Create_Return_Request
		    (
		        Return_Request_ID as "Return Request ID"
		        Customer
		        Sales_Order as "Sales Order"
		        Purchase_Order as "Purchase Order"
		        Return_Date as "Return Date"
		        Damage_Responsibility as "Damage Responsibility"
		        Issue_Description as "Issue Description"
		        Created_By as "Created By"
		        Created_By_Email as "Created By Email"
		        Created_Date_Time as "Created Date Time"
		    )
		    filters
		    (
		        Customer
		        Sales_Order
		        Purchase_Order
		        Return_Date
		        Damage_Responsibility
		        Created_By
		    )
		    sort by
		    (
		        Return_Date descending
		    )
		}

		default list All_Sales_Orders
		{
		    displayName = "All Sales Orders"
		    show all rows from Create_Sales_Order
		    (
		        Sales_Order_ID as "Sales Order ID"
		        Customer
		        Lead
		        Requirement_Source as "Requirement Source"
		        Sales_Order_Date as "Sales Order Date"
		        Requested_Delivery_Date as "Requested Delivery Date"
		        Recommended_Supplier as "Recommended Supplier"
		        Selected_Supplier_Quote as "Selected Supplier Quote"
		        Status
		    )
		    filters
		    (
		        Customer
		        Requirement_Source
		        Sales_Order_Date
		        Status
		    )
		    sort by
		    (
		        Sales_Order_Date descending
		    )
		}

		custom Create_Template_Report
		{
		    displayName = "All Mail Templates"
		    show all rows from Create_Template
		    (
		        Select_Template.Template_1
		        Select_Template.Active
		    )
		    customlayouts
		    (
		        template
		        (
		            displayname = "Custom Layout 1"
		            content = "<panel><pr width='fill' height='fill'><pc padding='16px' bgColor='#F9FAFE' width='100%' hAlign='left' vAlign='middle'><pr width='fill' height='fill'><pc width='90%' hAlign='left' vAlign='middle'><text color='#000000' size='16px' type='field' lineHeight='24' numOfLines='3' value='Select_Template.Template_1'></text></pc><pc width='10%' hAlign='right' vAlign='middle'><image color='#828286' width='24px' height='24px' type='icon' value='arrows-2-small-right' size='22px' cornerRadius='12px' iconType='outline'/></pc></pr></pc></pr></panel>"
		        )
		    )
		}

		default list Request_Access_Report
		{
		
					displayName = "Request_Access Report"
					show all rows from Request_Access    
					(
						Access_Type as " Access_Type "
						Requester_Email
						IsOnSuccessCodeExecuted
						Action_Type
					)
				
		}
	}

	pages
	{
		page Admin_Dashboard
		{
					displayname = "Admin Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Admin_Overview' elementName='Admin_Overview'>\n\t\t\t\t\t<![CDATA[htmlpage Admin_Overview()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\ncustomerCount = Add_Customer.count();\nactiveCustomerCount = Add_Customer[Active == true].count();\nsupplierCount = Add_Supplier.count();\nactiveSupplierCount = Add_Supplier[Active == true].count();\nproductCount = Add_Product.count();\nactiveProductCount = Add_Product[Active == true].count();\nnewLeadCount = Add_Lead[Status == &quot;New&quot;].count();\nopenSalesOrderCount = Create_Sales_Order[Status != &quot;Delivered&quot;].count();\nreceivedQuoteCount = Add_Supplier_Quote[Status == &quot;Received&quot;].count();\nopenPOCount = Create_Purchase_Order[Status != &quot;Delivered&quot;].count();\nunpaidInvoiceCount = Add_Supplier_Invoice[Status == &quot;New&quot;].count();\nopenLogisticsCount = Create_Logistics_Booking[Status == &quot;New&quot;].count();\nreturnCount = Create_Return_Request.count();\nrecentHistoryCount = Add_History[Updated_Date_Time &gt;= zoho.currenttime.subDay(7)].count();\nreadinessExceptionCount = (customerCount - activeCustomerCount) + (supplierCount - activeSupplierCount) + (productCount - activeProductCount);\npriorityExceptionCount = unpaidInvoiceCount + openLogisticsCount + returnCount;\ncustomerReadinessPct = if(customerCount &gt; 0,(activeCustomerCount * 100 / customerCount).round(0),100);\nsupplierReadinessPct = if(supplierCount &gt; 0,(activeSupplierCount * 100 / supplierCount).round(0),100);\nproductReadinessPct = if(productCount &gt; 0,(activeProductCount * 100 / productCount).round(0),100);\ninactiveCustomers = Add_Customer[Active == false] sort by Last_Updated_Date_Time desc range from 0 to 5;\ninactiveSuppliers = Add_Supplier[Active == false] sort by Last_Updated_Date_Time desc range from 0 to 5;\ninactiveProducts = Add_Product[Active == false] sort by Last_Updated_Date_Time desc range from 0 to 5;\nnewLeads = Add_Lead[Status == &quot;New&quot;] sort by Lead_Date desc range from 0 to 7;\nactiveSalesOrders = Create_Sales_Order[Status != &quot;Delivered&quot;] sort by Sales_Order_Date desc range from 0 to 7;\nreceivedQuotes = Add_Supplier_Quote[Status == &quot;Received&quot;] sort by Quote_Date desc range from 0 to 7;\nactivePurchaseOrders = Create_Purchase_Order[Status != &quot;Delivered&quot;] sort by PO_Date desc range from 0 to 7;\nunpaidInvoices = Add_Supplier_Invoice[Status == &quot;New&quot;] sort by Invoice_Date asc range from 0 to 9;\nopenLogistics = Create_Logistics_Booking[Status == &quot;New&quot;] sort by Expected_Arrival_Date asc range from 0 to 7;\nreturnRequests = Create_Return_Request[ID != 0] sort by Return_Date desc range from 0 to 7;\nrecentHistory = Add_History[Updated_Date_Time &gt;= zoho.currenttime.subDay(7)] sort by Updated_Date_Time desc range from 0 to 11;\n%&gt;\n&lt;style&gt;\n/* ZCS global utility rules used by this page, included once. */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:.625rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-rounded-sm{border-radius:.25rem}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-sticky{position:sticky}.zcs-card{background:var(--zcs-white-color);border:1px solid #E5E7EF;border-radius:12px}a{text-decoration:none}\n/* Full-width Creator canvas overrides. */\nhtml,body,div#zppagesLive,div#elementsContainer,.Layout.elemContainment,.zcpage-elemContainer,.zc-pb-formreport-placeholder,.zc-pb-page-content-wrapper,.zc-pb-tile-container,.zc-pb-tile-card{width:100%!important;min-height:100%;box-sizing:border-box}.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zc-pb-tile-container,.zc-pb-page-content-wrapper .zc-pb-tile-card{padding:0!important;margin:0!important;border-radius:0!important;box-shadow:none!important}#splash-screen,.zc-page-loader,.cogLoader{display:none!important}\n.admin-workspace{min-height:100%;padding:18px;background:#F6F5FA;font:400 14px/1.5 Arial,sans-serif;color:var(--zcs-primary-text-color)}\n.workspace-header{padding:18px 20px;border:1px solid #DED9EE;border-radius:14px;background:linear-gradient(135deg,#fff 0%,#F3F0FF 100%);display:flex;align-items:center;gap:14px}.header-mark{width:42px;height:42px;flex:none;border-radius:11px;background:#EAE4FF;color:#6246C9;display:flex;align-items:center;justify-content:center;font-size:19px}.header-copy{flex:1;min-width:0}.eyebrow{margin:0 0 2px!important;color:#7058C7!important;font-size:10px!important;font-weight:700;text-transform:uppercase;letter-spacing:.09em}.workspace-header h1{font-size:22px}.workspace-header p{margin-top:3px;max-width:780px}.priority-summary{flex:none;display:flex;align-items:center;gap:9px;padding:8px 11px;border-radius:9px;background:#FFF0F2;border:1px solid #F2B8C1;color:#A72B42}.priority-summary i{font-size:17px}.priority-summary strong{font-size:17px}.priority-summary span{font-size:11px;display:block}\n.context-row{display:grid;grid-template-columns:repeat(7,minmax(105px,1fr));gap:8px;margin-top:10px}.context-tile{padding:9px 11px;min-height:54px;border-color:#E4E0EE}.context-tile span{display:block;color:var(--zcs-secondary-text-color);font-size:10px;text-transform:uppercase;letter-spacing:.05em}.context-tile strong{display:block;margin-top:1px;font-size:17px;font-weight:600}.context-tile small{color:var(--zcs-secondary-text-color);font-size:11px}\n.health-strip{margin-top:12px;padding:13px 15px;border-color:#E1DCEF}.health-heading{display:flex;align-items:center;justify-content:space-between;gap:12px}.health-heading h2{font-size:15px}.health-grid{display:grid;grid-template-columns:repeat(3,minmax(130px,1fr)) minmax(260px,1.2fr);gap:18px;margin-top:10px;align-items:end}.zcs-progress-bar-wrapper p{display:flex;justify-content:space-between;gap:8px;margin:0 0 5px;font-size:11px;color:var(--zcs-secondary-text-color)}.zcs-progress-bar{height:7px;background:#ECE9F4}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:#7458D6}.exception-mix{display:flex;gap:7px;justify-content:flex-end;flex-wrap:wrap}.exception-mix span{padding:5px 8px;border-radius:6px;background:#F7F5FC;color:#625D70;font-size:11px}.exception-mix i{margin-right:3px;color:#8A6CDE}\n.section-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:14px}.ops-section{min-width:0;overflow:hidden;border-color:#E1DDEA;box-shadow:0 3px 12px rgba(47,35,78,.04)}.ops-section.wide{grid-column:1/-1}.section-header{min-height:56px;padding:9px 14px;border-bottom:1px solid #E9E6F0;display:flex;align-items:center;justify-content:space-between;gap:12px;background:#FCFBFE}.section-heading{min-width:0;display:flex;align-items:center;gap:9px}.section-icon{width:31px;height:31px;flex:none;border-radius:8px;display:flex;align-items:center;justify-content:center;background:#EEE9FF;color:#684ACB;font-size:15px}.section-heading h2{font-size:15px}.section-heading p{margin:1px 0 0;color:var(--zcs-secondary-text-color);font-size:11px}.section-link{white-space:nowrap;color:#684ACB;font-weight:600;font-size:11px}.section-link i{margin-left:3px}.section-body{height:292px;overflow:auto;background:#fff}.section-body.tall{height:330px}.subgroup{padding:11px 12px}.subgroup+.subgroup{border-top:1px solid #EAE7F0}.subgroup-title{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:7px}.subgroup-title h3{font-size:12px;margin:0}.subgroup-title span{font-size:11px;color:var(--zcs-secondary-text-color)}\n.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:var(--zcs-white-color);overflow:auto;border-radius:6px}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:560px}.zcs-table-wrapper table thead{top:0;z-index:1}.zcs-table-wrapper table thead th{background:#F8F7FC;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap;font-size:11px;color:#605B6C}.zcs-table-wrapper table tbody td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top;font-size:12px}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background:#FAF9FD}.cell-primary{font-weight:500}.cell-secondary{display:block;margin-top:2px;color:var(--zcs-secondary-text-color);font-size:11px}.record-id{font-variant-numeric:tabular-nums;white-space:nowrap}\n.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-red{background:#FFF0F2;border-color:#ECA9B5;color:#A72B42}.zcs-badge-yellow{background:#FFF8E8;border-color:#E7C16A;color:#8A6408}.zcs-badge-blue{background:#EEF2FF;border-color:#9CAFEA;color:#3F57A3}.zcs-badge-green{background:#EAF8F1;border-color:#8AC8AB;color:#217653}.zcs-badge-grey{background:#F2F1F4;border-color:#AAA6B0;color:#5D5864}.empty{min-height:92px;padding:18px;color:var(--zcs-secondary-text-color)}.empty i{display:block;margin-bottom:6px;color:#8266D6;font-size:21px}.history-table table{min-width:760px}\n@media(max-width:1180px){.context-row{grid-template-columns:repeat(4,minmax(105px,1fr))}.health-grid{grid-template-columns:repeat(3,1fr)}.exception-mix{grid-column:1/-1;justify-content:flex-start}}\n@media(max-width:860px){.admin-workspace{padding:13px}.workspace-header{align-items:flex-start;flex-wrap:wrap}.header-copy{flex-basis:calc(100% - 60px)}.priority-summary{margin-left:56px}.section-grid{grid-template-columns:1fr}.ops-section.wide{grid-column:auto}.context-row{grid-template-columns:repeat(2,minmax(0,1fr))}.health-grid{grid-template-columns:1fr}.exception-mix{grid-column:auto}.section-body,.section-body.tall{height:350px}}\n@media(max-width:520px){.admin-workspace{padding:9px}.workspace-header{padding:14px}.workspace-header h1{font-size:20px}.header-mark{display:none}.header-copy{flex-basis:100%}.priority-summary{width:100%;margin-left:0;box-sizing:border-box}.context-row{grid-template-columns:1fr 1fr}.health-heading{align-items:flex-start;flex-direction:column}.section-header{align-items:flex-start}.section-link{margin-top:6px}.section-body,.section-body.tall{height:380px}.subgroup{padding:9px}}\n&lt;/style&gt;\n&lt;div class=&apos;admin-workspace zcs-box-border&apos;&gt;\n\t&lt;header class=&apos;workspace-header&apos;&gt;\n\t\t&lt;div class=&apos;header-mark&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;header-copy&apos;&gt;&lt;p class=&apos;eyebrow&apos;&gt;Administrator workspace&lt;/p&gt;&lt;h1 class=&apos;zcs-m-0&apos;&gt;Cross-module operations&lt;/h1&gt;&lt;p class=&apos;zcs-m-0 zcs-color-secondary&apos;&gt;Live readiness, demand, sourcing, finance, shipment, return, and audit queues.&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;priority-summary&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;&lt;%=priorityExceptionCount%&gt;&lt;/strong&gt;&lt;span&gt;priority exceptions&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;/header&gt;\n\n\t&lt;div class=&apos;context-row&apos;&gt;\n\t\t&lt;div class=&apos;context-tile zcs-card&apos;&gt;&lt;span&gt;Customers&lt;/span&gt;&lt;strong&gt;&lt;%=customerCount%&gt;&lt;/strong&gt;&lt;small&gt;&lt;%=activeCustomerCount%&gt; active&lt;/small&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;context-tile zcs-card&apos;&gt;&lt;span&gt;Suppliers&lt;/span&gt;&lt;strong&gt;&lt;%=supplierCount%&gt;&lt;/strong&gt;&lt;small&gt;&lt;%=activeSupplierCount%&gt; active&lt;/small&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;context-tile zcs-card&apos;&gt;&lt;span&gt;Products&lt;/span&gt;&lt;strong&gt;&lt;%=productCount%&gt;&lt;/strong&gt;&lt;small&gt;&lt;%=activeProductCount%&gt; active&lt;/small&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;context-tile zcs-card&apos;&gt;&lt;span&gt;New leads&lt;/span&gt;&lt;strong&gt;&lt;%=newLeadCount%&gt;&lt;/strong&gt;&lt;small&gt;awaiting handoff&lt;/small&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;context-tile zcs-card&apos;&gt;&lt;span&gt;Open sales&lt;/span&gt;&lt;strong&gt;&lt;%=openSalesOrderCount%&gt;&lt;/strong&gt;&lt;small&gt;not delivered&lt;/small&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;context-tile zcs-card&apos;&gt;&lt;span&gt;Open POs&lt;/span&gt;&lt;strong&gt;&lt;%=openPOCount%&gt;&lt;/strong&gt;&lt;small&gt;not delivered&lt;/small&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;context-tile zcs-card&apos;&gt;&lt;span&gt;Recent events&lt;/span&gt;&lt;strong&gt;&lt;%=recentHistoryCount%&gt;&lt;/strong&gt;&lt;small&gt;last 7 days&lt;/small&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;section class=&apos;health-strip zcs-card&apos;&gt;\n\t\t&lt;div class=&apos;health-heading&apos;&gt;&lt;div&gt;&lt;p class=&apos;eyebrow&apos;&gt;Status distribution&lt;/p&gt;&lt;h2 class=&apos;zcs-m-0&apos;&gt;Operational health&lt;/h2&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-red zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=readinessExceptionCount%&gt; inactive master records&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;health-grid&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-progress-bar-wrapper&apos;&gt;&lt;p&gt;&lt;span&gt;Customer readiness&lt;/span&gt;&lt;strong&gt;&lt;%=customerReadinessPct%&gt;%&lt;/strong&gt;&lt;/p&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=customerReadinessPct%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-progress-bar-wrapper&apos;&gt;&lt;p&gt;&lt;span&gt;Supplier readiness&lt;/span&gt;&lt;strong&gt;&lt;%=supplierReadinessPct%&gt;%&lt;/strong&gt;&lt;/p&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=supplierReadinessPct%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-progress-bar-wrapper&apos;&gt;&lt;p&gt;&lt;span&gt;Product readiness&lt;/span&gt;&lt;strong&gt;&lt;%=productReadinessPct%&gt;%&lt;/strong&gt;&lt;/p&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=productReadinessPct%&gt;%&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;exception-mix&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt; Finance &lt;strong&gt;&lt;%=unpaidInvoiceCount%&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt; Logistics &lt;strong&gt;&lt;%=openLogisticsCount%&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt; Returns &lt;strong&gt;&lt;%=returnCount%&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/section&gt;\n\n\t&lt;div class=&apos;section-grid&apos;&gt;\n\t\t&lt;section class=&apos;ops-section zcs-card&apos;&gt;\n\t\t\t&lt;div class=&apos;section-header&apos;&gt;&lt;div class=&apos;section-heading&apos;&gt;&lt;span class=&apos;section-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-m-0&apos;&gt;Master-data readiness&lt;/h2&gt;&lt;p&gt;&lt;%=readinessExceptionCount%&gt; inactive records need review&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Page:Products&apos;&gt;Product catalog &lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;section-body tall&apos;&gt;\n\t\t\t\t&lt;div class=&apos;subgroup&apos;&gt;&lt;div class=&apos;subgroup-title&apos;&gt;&lt;h3&gt;Inactive customers&lt;/h3&gt;&lt;span&gt;&lt;%=customerCount - activeCustomerCount%&gt; total&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;% if(inactiveCustomers.count() &gt; 0) { %&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Customer&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Contact&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Country&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;% for each customerRec in inactiveCustomers { %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;cell-primary&apos;&gt;&lt;%=ifnull(customerRec.Customer_Name,&quot;Not named&quot;)%&gt;&lt;/span&gt;&lt;span class=&apos;cell-secondary&apos;&gt;Customer &lt;%=customerRec.Customer_ID%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(customerRec.Contact_Person,&quot;Not supplied&quot;)%&gt;&lt;span class=&apos;cell-secondary&apos;&gt;&lt;%=ifnull(customerRec.Email,&quot;No email&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(customerRec.Country,&quot;Not supplied&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;% } else { %&gt;&lt;div class=&apos;empty zcs-text-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;All customers are active.&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;subgroup&apos;&gt;&lt;div class=&apos;subgroup-title&apos;&gt;&lt;h3&gt;Inactive suppliers&lt;/h3&gt;&lt;span&gt;&lt;%=supplierCount - activeSupplierCount%&gt; total&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;% if(inactiveSuppliers.count() &gt; 0) { %&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Supplier&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Contact&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Country&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;% for each supplierRec in inactiveSuppliers { %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;cell-primary&apos;&gt;&lt;%=ifnull(supplierRec.Supplier_Name,&quot;Not named&quot;)%&gt;&lt;/span&gt;&lt;span class=&apos;cell-secondary&apos;&gt;Supplier &lt;%=supplierRec.Supplier_ID%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(supplierRec.Contact_Person,&quot;Not supplied&quot;)%&gt;&lt;span class=&apos;cell-secondary&apos;&gt;&lt;%=ifnull(supplierRec.Email,&quot;No email&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(supplierRec.Country,&quot;Not supplied&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;% } else { %&gt;&lt;div class=&apos;empty zcs-text-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;All suppliers are active.&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;subgroup&apos;&gt;&lt;div class=&apos;subgroup-title&apos;&gt;&lt;h3&gt;Inactive products&lt;/h3&gt;&lt;span&gt;&lt;%=productCount - activeProductCount%&gt; total&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;% if(inactiveProducts.count() &gt; 0) { %&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Product&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Category&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Part number&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;% for each productRec in inactiveProducts { %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;cell-primary&apos;&gt;&lt;%=ifnull(productRec.Product_Name,&quot;Not named&quot;)%&gt;&lt;/span&gt;&lt;span class=&apos;cell-secondary&apos;&gt;Product &lt;%=productRec.Product_ID%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(productRec.Product_Category,&quot;Not categorized&quot;)%&gt;&lt;span class=&apos;cell-secondary&apos;&gt;&lt;%=ifnull(productRec.Product_Type,&quot;No type&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(productRec.Internal_Part_Number,&quot;Not supplied&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;% } else { %&gt;&lt;div class=&apos;empty zcs-text-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;All products are active.&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;ops-section zcs-card&apos;&gt;\n\t\t\t&lt;div class=&apos;section-header&apos;&gt;&lt;div class=&apos;section-heading&apos;&gt;&lt;span class=&apos;section-icon&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-m-0&apos;&gt;Active sales work&lt;/h2&gt;&lt;p&gt;New demand and orders still in progress&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Page:Sales_Orders&apos;&gt;Sales orders &lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;section-body tall&apos;&gt;\n\t\t\t\t&lt;div class=&apos;subgroup&apos;&gt;&lt;div class=&apos;subgroup-title&apos;&gt;&lt;h3&gt;New leads&lt;/h3&gt;&lt;span&gt;&lt;%=newLeadCount%&gt; total&lt;/span&gt;&lt;/div&gt;&lt;% if(newLeads.count() &gt; 0) { %&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Lead&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Customer&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Requirement&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Expected&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;% for each leadRec in newLeads { %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 record-id&apos;&gt;Lead &lt;%=leadRec.Lead_ID%&gt;&lt;span class=&apos;cell-secondary&apos;&gt;&lt;%=ifnull(leadRec.Lead_Date,&quot;No date&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(leadRec.Customer_Company_Name,&quot;Not supplied&quot;)%&gt;&lt;span class=&apos;cell-secondary&apos;&gt;&lt;%=ifnull(leadRec.Contact_Person,&quot;No contact&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(leadRec.Requirement,&quot;No requirement summary&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=ifnull(leadRec.Expected_Price,0)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;% } else { %&gt;&lt;div class=&apos;empty zcs-text-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;No new leads awaiting review.&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;subgroup&apos;&gt;&lt;div class=&apos;subgroup-title&apos;&gt;&lt;h3&gt;Open sales orders&lt;/h3&gt;&lt;span&gt;&lt;%=openSalesOrderCount%&gt; total&lt;/span&gt;&lt;/div&gt;&lt;% if(activeSalesOrders.count() &gt; 0) { %&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Order&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Customer&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Requested delivery&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;% for each salesOrderRec in activeSalesOrders { %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 record-id&apos;&gt;SO &lt;%=salesOrderRec.Sales_Order_ID%&gt;&lt;span class=&apos;cell-secondary&apos;&gt;&lt;%=ifnull(salesOrderRec.Sales_Order_Date,&quot;No date&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(salesOrderRec.Customer,&quot;Not linked&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(salesOrderRec.Requested_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=ifnull(salesOrderRec.Status,&quot;Unknown&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;% } else { %&gt;&lt;div class=&apos;empty zcs-text-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;No active sales orders.&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;ops-section zcs-card&apos;&gt;\n\t\t\t&lt;div class=&apos;section-header&apos;&gt;&lt;div class=&apos;section-heading&apos;&gt;&lt;span class=&apos;section-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-m-0&apos;&gt;Sourcing work&lt;/h2&gt;&lt;p&gt;Supplier responses and purchase-order handoffs&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Page:Purchase_Orders&apos;&gt;Purchase orders &lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;section-body tall&apos;&gt;\n\t\t\t\t&lt;div class=&apos;subgroup&apos;&gt;&lt;div class=&apos;subgroup-title&apos;&gt;&lt;h3&gt;Quotes received&lt;/h3&gt;&lt;span&gt;&lt;%=receivedQuoteCount%&gt; total&lt;/span&gt;&lt;/div&gt;&lt;% if(receivedQuotes.count() &gt; 0) { %&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Quote&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Supplier&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Sales order&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Lead time&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;% for each supplierQuoteRec in receivedQuotes { %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 record-id&apos;&gt;Quote &lt;%=supplierQuoteRec.Supplier_Quote_ID%&gt;&lt;span class=&apos;cell-secondary&apos;&gt;&lt;%=ifnull(supplierQuoteRec.Quote_Date,&quot;No date&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(supplierQuoteRec.Supplier,&quot;Not linked&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(supplierQuoteRec.Sales_Order,&quot;Not linked&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(supplierQuoteRec.Lead_Time,&quot;Not supplied&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;% } else { %&gt;&lt;div class=&apos;empty zcs-text-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;No received quotes awaiting handoff.&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;subgroup&apos;&gt;&lt;div class=&apos;subgroup-title&apos;&gt;&lt;h3&gt;Open purchase orders&lt;/h3&gt;&lt;span&gt;&lt;%=openPOCount%&gt; total&lt;/span&gt;&lt;/div&gt;&lt;% if(activePurchaseOrders.count() &gt; 0) { %&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;PO&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Supplier&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Expected&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;% for each purchaseOrderRec in activePurchaseOrders { %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 record-id&apos;&gt;PO &lt;%=purchaseOrderRec.Purchase_Order_ID%&gt;&lt;span class=&apos;cell-secondary&apos;&gt;&lt;%=ifnull(purchaseOrderRec.PO_Date,&quot;No date&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(purchaseOrderRec.Supplier,&quot;Not linked&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(purchaseOrderRec.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-yellow zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=ifnull(purchaseOrderRec.Status,&quot;Unknown&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;% } else { %&gt;&lt;div class=&apos;empty zcs-text-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;No open purchase orders.&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;ops-section zcs-card&apos;&gt;\n\t\t\t&lt;div class=&apos;section-header&apos;&gt;&lt;div class=&apos;section-heading&apos;&gt;&lt;span class=&apos;section-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-m-0&apos;&gt;Finance exceptions&lt;/h2&gt;&lt;p&gt;Unpaid supplier invoices requiring follow-up&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Page:Supplier_Invoices&apos;&gt;Invoices &lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;section-body&apos;&gt;&lt;% if(unpaidInvoices.count() &gt; 0) { %&gt;&lt;div class=&apos;subgroup&apos;&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Invoice&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Supplier&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Purchase order&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;Amount&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;% for each supplierInvoiceRec in unpaidInvoices { %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;cell-primary&apos;&gt;&lt;%=ifnull(supplierInvoiceRec.Supplier_Invoice_Number,&quot;Not numbered&quot;)%&gt;&lt;/span&gt;&lt;span class=&apos;cell-secondary&apos;&gt;&lt;%=ifnull(supplierInvoiceRec.Invoice_Date,&quot;No date&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(supplierInvoiceRec.Supplier,&quot;Not linked&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(supplierInvoiceRec.Purchase_Order,&quot;Not linked&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right&apos;&gt;&lt;%=ifnull(supplierInvoiceRec.Currency,&quot;&quot;)%&gt; &lt;%=ifnull(supplierInvoiceRec.Invoice_Amount,0)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } else { %&gt;&lt;div class=&apos;empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;No unpaid supplier invoices.&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;ops-section wide zcs-card&apos;&gt;\n\t\t\t&lt;div class=&apos;section-header&apos;&gt;&lt;div class=&apos;section-heading&apos;&gt;&lt;span class=&apos;section-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-m-0&apos;&gt;Logistics and returns exceptions&lt;/h2&gt;&lt;p&gt;Open shipments and return requests requiring operational ownership&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Page:Logistics_Bookings&apos;&gt;Logistics &lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;section-body tall&apos;&gt;&lt;div class=&apos;subgroup&apos;&gt;&lt;div class=&apos;subgroup-title&apos;&gt;&lt;h3&gt;Open logistics bookings&lt;/h3&gt;&lt;span&gt;&lt;%=openLogisticsCount%&gt; total&lt;/span&gt;&lt;/div&gt;&lt;% if(openLogistics.count() &gt; 0) { %&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Booking&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Provider&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Route&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Expected arrival&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Tracking&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;% for each logisticsRec in openLogistics { %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 record-id&apos;&gt;Booking &lt;%=logisticsRec.Logistics_Booking_ID%&gt;&lt;span class=&apos;cell-secondary&apos;&gt;&lt;%=ifnull(logisticsRec.Booking_Date,&quot;No date&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(logisticsRec.Logistics_Provider,&quot;Not supplied&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(logisticsRec.Pickup_Location,&quot;Unknown&quot;)%&gt;&lt;span class=&apos;cell-secondary&apos;&gt;to &lt;%=ifnull(logisticsRec.Warehouse_Destination,&quot;unknown&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(logisticsRec.Expected_Arrival_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(logisticsRec.Tracking_Reference,&quot;Not supplied&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;% } else { %&gt;&lt;div class=&apos;empty zcs-text-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;No open logistics bookings.&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;subgroup&apos;&gt;&lt;div class=&apos;subgroup-title&apos;&gt;&lt;h3&gt;Return requests&lt;/h3&gt;&lt;span&gt;&lt;%=returnCount%&gt; total&lt;/span&gt;&lt;/div&gt;&lt;% if(returnRequests.count() &gt; 0) { %&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Request&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Customer&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Purchase order&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Issue&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Responsibility&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;% for each returnRequestRec in returnRequests { %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 record-id&apos;&gt;Return &lt;%=returnRequestRec.Return_Request_ID%&gt;&lt;span class=&apos;cell-secondary&apos;&gt;&lt;%=ifnull(returnRequestRec.Return_Date,&quot;No date&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(returnRequestRec.Customer,&quot;Not linked&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(returnRequestRec.Purchase_Order,&quot;Not linked&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(returnRequestRec.Issue_Description,&quot;No issue summary&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(returnRequestRec.Damage_Responsibility,&quot;Not assigned&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;% } else { %&gt;&lt;div class=&apos;empty zcs-text-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;No return requests.&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;ops-section wide zcs-card&apos;&gt;\n\t\t\t&lt;div class=&apos;section-header&apos;&gt;&lt;div class=&apos;section-heading&apos;&gt;&lt;span class=&apos;section-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-m-0&apos;&gt;Recent history&lt;/h2&gt;&lt;p&gt;Newest operational changes from the last 7 days&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&apos;section-link&apos; href=&apos;#Report:All_Histories&apos;&gt;History report &lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;section-body history-table&apos;&gt;&lt;% if(recentHistory.count() &gt; 0) { %&gt;&lt;div class=&apos;subgroup&apos;&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;When&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Action&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Status change&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Updated by&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left&apos;&gt;Comments&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;% for each historyRec in recentHistory { %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(historyRec.Updated_Date_Time,&quot;No timestamp&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;cell-primary&apos;&gt;&lt;%=ifnull(historyRec.Action_Type,&quot;Update&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(historyRec.Previous_Status,&quot;Not recorded&quot;)%&gt;&lt;span class=&apos;cell-secondary&apos;&gt;to &lt;%=ifnull(historyRec.New_Status,ifnull(historyRec.Status,&quot;Not recorded&quot;))%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(historyRec.Updated_By,&quot;System&quot;)%&gt;&lt;span class=&apos;cell-secondary&apos;&gt;&lt;%=ifnull(historyRec.Updated_By_Email,&quot;&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;%=ifnull(historyRec.Comments,ifnull(historyRec.Subform_Details_Change_Summary,&quot;No comments&quot;))%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } else { %&gt;&lt;div class=&apos;empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;&lt;div&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;No operational history in the last 7 days.&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page All_Approval_Setup
		{
					displayname = "All Approval Setup"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet31' elementName='HTML Snippet' bgColor='#FFFFFF'>\n\t\t\t\t\t<![CDATA[htmlpage html_snippet31()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;link rel=&quot;stylesheet&quot; href=&quot;https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css&quot; /&gt;\n\n&lt;style&gt;\n\n* {\n\t\tpadding: 0;\n\t\tmargin: 0;\n\t\tborder: none;\n\t\tbox-sizing: border-box;\n\t\t }\n\t div::-webkit-scrollbar, table::-webkit-scrollbar, tr::-webkit-scrollbar, th::-webkit-scrollbar, td::-webkit-scrollbar, ul::-webkit-scrollbar, li::-webkit-scrollbar, a::-webkit-scrollbar, form::-webkit-scrollbar, input::-webkit-scrollbar {\n\t\t display: none;\n\t}\n\tdiv, table, tr, th, td, ul, li, a, form, input {\n\t\t-ms-overflow-style: none;\n\t\tscrollbar-width: none; \n\t}\n\t.zc-pb-embed-placeholder-content {\n\t\toverflow: hidden;\n\t}\n\t.zc-header .header_top_bar {\n\t\theight: 66px !important;\n\t}\n\tdiv#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder{\n\t\theight: 100% !important;\n\t\tborder: unset !important;\n\t}\n\t.zc_live_adminbar .zc-container-wrapper {\n\t\theight:100% !important;\n\t}\n\t.Layout.elemContainment {\n\t\tpadding: unset !important;\n\t}\n.zc_live_adminbar .zc-container-wrapper {\n\t\theight: 100% !important;\n\t}\n:root {\n\t--primary-color: #467eee;\n}\n\n/* ===== LAYOUT ===== */\n.innerMainDiv {\n\twidth: 100%;\n\theight: 100%;\n}\n.boxContainer {\n\twidth: 100%;\n\theight: 100%;\n\tdisplay: flex;\n\tflex-direction: column;\n\tborder-radius: 10px;\n\t/*border: 1px solid #ededed;*/\n\tbackground: #fff;\n\toverflow: hidden;\n}\n.boxHeader {\n\tbackground: #ffffff;\n\theight: 50px;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tpadding: 0 20px;\n\tfont-weight: 600;\n\tcolor: #000;\n\tborder-bottom: 1px solid #ededed;\n}\n.boxHeader a {\n\ttext-decoration: none;\n\tbackground: var(--primary-color);\n\tcolor: #fff;\n\tpadding: 8px 16px;\n\tborder-radius: 8px;\n\tfont-weight: 500;\n\tfont-size: 14px;\n\ttransition: all 0.3s ease;\n}\n.boxHeader a:hover {\n\tbackground: var(--menu_selected_hover_bg_color);\n}\n.boxContent {\n\tflex: 1;\n\tpadding: 20px;\n\toverflow: auto;\n\tdisplay: flex;\n\tgap: 20px;\n\twidth: 100%;\n\theight: 100%;\n\tflex-wrap: wrap;\n\t\n\talign-content: flex-start;\n}\n\n/* ===== MAIL TEMPLATE CARDS ===== */\n.mail-preview &gt; div:first-child,\n.mail-preview &gt; div:last-child {\n\t\tdisplay: none !important;\n}\n.mail-card {\n\tbackground: #f8f8f8;\n\t\tborder: 1px solid #ededed;\n\t\tborder-radius: 16px;\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\tmax-width: 50%;\n\t\twidth: 300px;\n\t\tvertical-align: top;\n\t\ttransition: all 0.3s ease;\n\toverflow: hidden;\n}\n.mail-card:hover {\n\tbackground: #eeebfa;\n}\n\n/* Dashed separator after each card */\n.mail-card:not(:last-child)::after {\n\tcontent: &quot;&quot;;\n\tposition: absolute;\n\ttop: 10px;\n\tright: -10px;\n\twidth: 1px;\n\theight: 95%;\n\t/*border-right: 2px dashed #ccc;*/\n}\n\n/* Header Section */\n.card-header {\n\tpadding: 15px 20px;\n\tdisplay: flex;\n\tjustify-content: space-between;\n\talign-items: flex-start;\n\t\n}\n.card-header .subject {\n\tfont-size: 16px;\n\t\tfont-weight: 600;\n\t\tcolor: #6147e5;\n\tword-break: break-word;\n\twhite-space: nowrap;\n\t\toverflow: hidden;\n\t\ttext-overflow: ellipsis;\n}\n.card-header .options-container {\n\tposition: relative;\n\t    transform: rotate(90deg);\n}\n.options-toggle {\n\tbackground: none;\n\tborder: none;\n\tfont-size: 18px;\n\tcolor: #a0aec0;\n\tcursor: pointer;\n}\n.options-menu {\n\tposition: absolute;\n\ttop: 100%;\n\tright: 0;\n\tbackground: #fff;\n\tborder-radius: 10px;\n\tbox-shadow: 0 10px 30px rgba(0,0,0,0.15);\n\twidth: 180px;\n\tdisplay: none;\n\tborder: 1px solid #e2e8f0;\n\tz-index: 5;\n}\n.options-menu a {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 10px;\n\tpadding: 12px 15px;\n\ttext-decoration: none;\n\tcolor: #4a5568;\n\tfont-size: 14px;\n\ttransition: 0.2s;\n}\n.options-menu a:hover {\n\tbackground: #f7fafc;\n\tcolor: var(--primary-color);\n}\n.options-toggle:focus + .options-menu,\n.options-menu:hover {\n\tdisplay: block;\n}\n\n/* Body Section */\n.mail-card:hover .card-body{\n\t\tbackground: #eeebfa;\n}\n.card-body {\n\tpadding: 15px 20px;\n\toverflow: hidden;\n\tdisplay: flex;\n\theight: calc(100% - 53px);\n\tflex-direction: column;\n\tjustify-content: space-between;\n\tbackground: #ffffff;\n}\n.mail-preview {\n\tfont-size: 14px;\n\t\tcolor: #4a5568;\n\t\tline-height: 1.6;\n\t\tword-wrap: break-word;\n\t\theight: calc(100% - 39px);\n\t\toverflow: auto;\n}\n.mail-meta {\n\tmargin-top: 12px;\n\t\tdisplay: flex;\n\t\tjustify-content: space-between;\n\t\talign-items: center;\n\t\tflex-wrap: wrap;\n\t\tgap: 6px;\n}\n.mail-to {\n\tfont-size: 13px;\n\tcolor: #718096;\n\tfont-weight: 500;\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 6px;\n}\n.mail-to i {\n\tcolor: var(--primary-color);\n}\n.status-badge {\n\tpadding: 6px 12px;\n\tborder-radius: 20px;\n\tfont-size: 12px;\n\tfont-weight: 600;\n\ttext-transform: uppercase;\n}\n.status-active {\n\tbackground: #d1fae5;\n\tcolor: #065f46;\n}\n.status-inactive {\n\tbackground: #fee2e2;\n\tcolor: #991b1b;\n}\n\n/* Empty State */\n.noDetailDiv {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: center;\n\theight: 100%;\n\tcolor: #626262;\n\tfont-weight: 500;\n\twidth: 100%;\n}\n@media (max-width:768px){\n\t.mail-card {\n\t\twidth: 90%;\n\t\tmin-width: 90%;\n\t}\n}\n&lt;/style&gt;\n\n&lt;div class=&quot;innerMainDiv&quot;&gt;\n\t&lt;div class=&quot;boxContainer&quot;&gt;\n\t\t&lt;div class=&quot;boxHeader&quot;&gt;\n\t\t\t&lt;div&gt;All Approval Setup&lt;/div&gt;\n\t\t\t&lt;a href=&quot;#Form:Add_Approval_Setup?zc_LoadIn=dialog&amp;zc_Header=false&amp;zc_NextUrl=#Script:page.refresh&quot;&gt;+ Add Approval Setup&lt;/a&gt;\n\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;boxContent&quot;&gt;\n&lt;%\n\tfetchSalesOrder = Add_Approval_Setup[Approval_Setup_For != null];\n\tif(fetchSalesOrder.count() != 0)\n\t{\n\t\tfetchSalesOrder1 = Add_Approval_Setup[ID != null].distinct(Approval_Setup_For);\n\t\tfor each  rec in fetchSalesOrder1\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;mail-card&quot;&gt;\n\t\t\t&lt;div class=&quot;card-header&quot;&gt;\n\t  &lt;a class=&quot;subject&quot; href=&quot;#Page:Approval_Setup?zc_LoadIn=embed-embedDiv&amp;recID=&lt;%=rec%&gt;&amp;module=&lt;%=Approval_Setup_For[ID == rec].Approval_Setup_For%&gt;&quot;&gt;&lt;%=Approval_Setup_For[ID == rec].Approval_Setup_For%&gt;&lt;/a&gt;\n\t\t\t\t&lt;div class=&quot;options-container&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;options-toggle&quot; aria-hidden=&quot;true&quot;&gt;&lt;i class=&quot;fas fa-ellipsis-v&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t \n\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;style&gt;\n/*.zc-content-loader div {\n display: none !important;\n}*/\n\t.main_container_img {\n\t\t\t\twidth: 100%;\n\t\t\t\theight: 100%;\n\t\t\t\tdisplay: flex;\n\t\t\t\tjustify-content: center;\n\t\t\t\talign-items: center;\n\t\t\t\tpadding: 15px;\n\t\t}\n\t.img_c {\n\t\t\t\tanimation: fadeInZoom 0.2s ease-in-out forwards;\n\t\t\t\tobject-fit: contain;\n\t\t\t\twidth: 10%;\n\t\t}\n\t\t&lt;/style&gt;\n&lt;div class=&quot;main_container_img&quot;&gt;\n&lt;div style=&quot;display: flex ; width: 100%; height: 100%; flex-direction: column; justify-content: center; align-content: center; align-items: center;&quot;&gt;\n\t\t&lt;img class=&quot;img_c&quot; src=&quot;https://files-accl.zohoexternal.com/public/workdrive-external/download/c4yc5f4e45a3a037f4ceeb726dfdca8d7e886?x-cli-msg=%7B%22linkId%22%3A%226OxchGZlnBc-J8HFH%22%2C%22isFileOwner%22%3Afalse%2C%22version%22%3A%221.0%22%2C%22isWDSupport%22%3Afalse%7D&quot;&gt;\n\t&lt;div style=&quot;color: #2f305d; font-weight:600;&quot;&gt; No Data Available&lt;/div&gt;&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page All_Mail_Templates(string recID)
		{
					displayname = "All Mail Templates"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet3' elementName='HTML Snippet' bgColor='#FFFFFF'>\n\t\t\t\t\t<![CDATA[htmlpage html_snippet3()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;link rel=&quot;stylesheet&quot; href=&quot;https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css&quot; /&gt;\n\n&lt;style&gt;\n* {\n\t\tpadding: 0;\n\t\tmargin: 0;\n\t\tborder: none;\n\t\tbox-sizing: border-box;\n\t\t }\n\t div::-webkit-scrollbar, table::-webkit-scrollbar, tr::-webkit-scrollbar, th::-webkit-scrollbar, td::-webkit-scrollbar, ul::-webkit-scrollbar, li::-webkit-scrollbar, a::-webkit-scrollbar, form::-webkit-scrollbar, input::-webkit-scrollbar {\n\t\t display: none;\n\t}\n\tdiv, table, tr, th, td, ul, li, a, form, input {\n\t\t-ms-overflow-style: none;\n\t\tscrollbar-width: none; \n\t}\n\t.zc-pb-embed-placeholder-content {\n\t\toverflow: hidden;\n\t}\n\t.zc-header .header_top_bar {\n\t\theight: 66px !important;\n\t}\n\tdiv#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder{\n\t\theight: 100% !important;\n\t\tborder: unset !important;\n\t}\n\t.zc_live_adminbar .zc-container-wrapper {\n\t\theight:100% !important;\n\t}\n\t.Layout.elemContainment {\n\t\tpadding: unset !important;\n\t}\n.zc_live_adminbar .zc-container-wrapper {\n\t\theight: 100% !important;\n\t}\n:root {\n\t--primary-color: #467eee;\n}\n\n/* ===== LAYOUT ===== */\n.innerMainDiv {\n\twidth: 100%;\n\theight: 100%;\n}\n.boxContainer {\n\twidth: 100%;\n\theight: 100%;\n\tdisplay: flex;\n\tflex-direction: column;\n\tborder-radius: 10px;\n\t/*border: 1px solid #ededed;*/\n\tbackground: #fff;\n\toverflow: hidden;\n}\n.boxHeader {\n\tbackground: #ffffff;\n\theight: 50px;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tpadding: 0 20px;\n\tfont-weight: 600;\n\tcolor: #000;\n\tborder-bottom: 1px solid #ededed;\n}\n.boxHeader .ass {\n\ttext-decoration: none;\n\tbackground: var(--primary-color);\n\tcolor: #fff;\n\tpadding: 8px 16px;\n\tborder-radius: 8px;\n\tfont-weight: 500;\n\tfont-size: 14px;\n\ttransition: all 0.3s ease;\n}\n.boxHeader .ass:hover {\n\tbackground: var(--menu_selected_hover_bg_color);\n}\n.boxContent {\n\tflex: 1;\n\tpadding: 20px;\n\toverflow: auto;\n\tdisplay: flex;\n\tgap: 20px;\n\twidth: 100%;\n\theight: 100%;\n\tflex-wrap: wrap;\n\t\n\talign-content: flex-start;\n}\n\n/* ===== MAIL TEMPLATE CARDS ===== */\n\n.mail-card {\n\tbackground: #f8f8f8;\n\t\tborder: 1px solid #ededed;\n\t\tborder-radius: 16px;\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\tmax-width: 50%;\n\t\twidth: 515px;\n\t\theight: 400px;\n\t\tvertical-align: top;\n\t\ttransition: all 0.3s ease;\n\toverflow: hidden;\n}\n.mail-card:hover {\n\tbackground: #eeebfa;\n}\n\n/* Dashed separator after each card */\n.mail-card:not(:last-child)::after {\n\tcontent: &quot;&quot;;\n\tposition: absolute;\n\ttop: 10px;\n\tright: -10px;\n\twidth: 1px;\n\theight: 95%;\n\t/*border-right: 2px dashed #ccc;*/\n}\n\n/* Header Section */\n.card-header {\n\tpadding: 15px 20px;\n\tdisplay: flex;\n\tjustify-content: space-between;\n\talign-items: flex-start;\n\tborder-bottom: 1px solid #ececee;\n}\n.card-header .subject {\n\tfont-size: 17px;\n\tfont-weight: 700;\n\tcolor: #1a202c;\n\tword-break: break-word;\n}\n.card-header .options-container {\n\tposition: relative;\n}\n.options-toggle {\n\tbackground: none;\n\tborder: none;\n\tfont-size: 18px;\n\tcolor: #a0aec0;\n\tcursor: pointer;\n}\n.options-menu {\n\tposition: absolute;\n\ttop: 100%;\n\tright: 0;\n\tbackground: #fff;\n\tborder-radius: 10px;\n\tbox-shadow: 0 10px 30px rgba(0,0,0,0.15);\n\twidth: 180px;\n\tdisplay: none;\n\tborder: 1px solid #e2e8f0;\n\tz-index: 5;\n}\n.options-menu a {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 10px;\n\tpadding: 12px 15px;\n\ttext-decoration: none;\n\tcolor: #4a5568;\n\tfont-size: 14px;\n\ttransition: 0.2s;\n}\n.options-menu a:hover {\n\tbackground: #f7fafc;\n\tcolor: var(--primary-color);\n}\n.options-toggle:focus + .options-menu,\n.options-menu:hover {\n\tdisplay: block;\n}\n\n/* Body Section */\n.mail-card:hover .card-body{\n\t\tbackground: #eeebfa;\n}\n.card-body {\n\tpadding: 15px 20px;\n\toverflow: hidden;\n\tdisplay: flex;\n\theight: calc(100% - 53px);\n\tflex-direction: column;\n\tjustify-content: space-between;\n\tbackground: #ffffff;\n}\n.mail-preview {\n\tfont-size: 14px;\n\t\tcolor: #4a5568;\n\t\tline-height: 1.6;\n\t\tword-wrap: break-word;\n\t\theight: calc(100% - 39px);\n\t\toverflow: auto;\n}\n.mail-meta {\n\tmargin-top: 12px;\n\t\tdisplay: flex;\n\t\tjustify-content: space-between;\n\t\talign-items: center;\n\t\tflex-wrap: wrap;\n\t\tgap: 6px;\n}\n.mail-to {\n\tfont-size: 13px;\n\tcolor: #718096;\n\tfont-weight: 500;\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 6px;\n}\n.mail-to i {\n\tcolor: var(--primary-color);\n}\n.status-badge {\n\tpadding: 6px 12px;\n\tborder-radius: 20px;\n\tfont-size: 12px;\n\tfont-weight: 600;\n\ttext-transform: uppercase;\n}\n.status-active {\n\tbackground: #d1fae5;\n\tcolor: #065f46;\n}\n.status-inactive {\n\tbackground: #fee2e2;\n\tcolor: #991b1b;\n}\n\n/* Empty State */\n.noDetailDiv {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: center;\n\theight: 100%;\n\tcolor: #626262;\n\tfont-weight: 500;\n}\n@media (max-width:768px){\n\t.mail-card {\n\t\twidth: 90%;\n\t\tmin-width: 90%;\n\t}\n}\n.boxHeader span {\n\t\tfont-size: 16px;\n\t\tfont-weight: 500;\n\t\tline-height: 22px;\n\t\tcolor: #666D79;\n\t\tmargin: 0px 4px 0px 0px;\n}\n.boxHeader:hover span {\n\t\tcolor: #131635;\n}\n.boxHeader h5 {\n\t\tfont-size: 18px;\n\t\tfont-weight: 500;\n\t\tline-height: 22px;\n\t\tletter-spacing: 0.1px;\n\t\tcolor: #131635;\n}\n.fa-angle-left:before {\n\t\tfont-family: &quot;FontAwesome&quot; !important; \n\t\tcontent: &quot;\\f104&quot;;\n}\n&lt;/style&gt;\n\n&lt;div class=&quot;innerMainDiv&quot;&gt;\n\t&lt;div class=&quot;boxContainer&quot;&gt;\n\t\t&lt;div class=&quot;boxHeader&quot;&gt;\n\t\t &lt;div class=&quot;zc-pra-flt-left zc-pra-clearfix zc-pra-header-title&quot; style=&quot;display: flex; align-items: center;&quot;&gt;\n\t\t\t\t&lt;a href=&quot;#Page:All_Mail_Templates1?zc_LoadIn=embed-embedDiv&quot; class=&quot;zc-pra-flt-left zc-pra-back-icon&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;fa fa-angle-left&quot;&gt;&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;h5 class=&quot;&quot;&gt;Back&lt;/h5&gt;\n\t\t\t&lt;/div&gt;\n\t \n\t\t\t&lt;a class=&quot;ass&quot; href=&quot;#Form:Create_Template?zc_LoadIn=embed-embedDiv&amp;zc_Header=false&amp;zc_NextUrl=#Script:page.refresh&amp;Email_For=&lt;%=input.recID%&gt;&quot;&gt;+ Add Template&lt;/a&gt;\n\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;boxContent&quot;&gt;\n&lt;%\n\tfetchSalesOrder = Create_Template[Email_For == input.recID];\n\tif(fetchSalesOrder.count() != 0)\n\t{\n\t\tfor each  rec in fetchSalesOrder\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;mail-card&quot;&gt;\n\t\t\t&lt;div class=&quot;card-header&quot;&gt;\n\t\t\t\t&lt;div class=&quot;subject&quot;&gt;&lt;%=rec.Title%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;options-container&quot;&gt;\n\t\t\t\t\t&lt;button class=&quot;options-toggle&quot;&gt;&lt;i class=&quot;fas fa-ellipsis-v&quot;&gt;&lt;/i&gt;&lt;/button&gt;\n\t\t\t\t\t&lt;div class=&quot;options-menu&quot;&gt;\n\t\t\t\t\t\t &lt;a href=&quot;#Form:Create_Template?zc_LoadIn=dialog&amp;zc_Header=false&amp;zc_NextUrl=#Script:page.refresh&amp;recLinkID=&lt;%=rec.ID%&gt;&amp;viewLinkName=Create_Template_Report&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&quot;fas fa-edit&quot;&gt;&lt;/i&gt; Edit\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t &lt;a href=&quot;#Page:Detail_View_Page?zc_LoadIn=dialog&amp;reportName=Create_Template_Report&amp;recID=&lt;%=rec.ID%&gt;&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&quot;fas fa-eye&quot;&gt;&lt;/i&gt; View Details\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;a href=&quot;#&quot;&gt;&lt;i class=&quot;fas fa-trash&quot;&gt;&lt;/i&gt;Delete&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;card-body&quot;&gt;\n\t\t\t\t&lt;div class=&quot;mail-preview&quot;&gt;&lt;%=rec.Template_1%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;mail-meta&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;mail-to&quot;&gt;&lt;i class=&quot;fas fa-envelope&quot;&gt;&lt;/i&gt; Mail For: &lt;%=rec.Email_For%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;status-badge &lt;%=if(!rec.Active,&quot;status-inactive &quot;,&quot;status-active&quot;)%&gt;&apos;&gt;\n\t\t\t\t\t\t&lt;%=if(!rec.Active,&quot;Inactive &quot;,&quot;Active&quot;)%&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;style&gt;\n/*.zc-content-loader div {\n display: none !important;\n}*/\n\t.main_container_img {\n\t\t\t\twidth: 100%;\n\t\t\t\theight: 100%;\n\t\t\t\tdisplay: flex;\n\t\t\t\tjustify-content: center;\n\t\t\t\talign-items: center;\n\t\t\t\tpadding: 15px;\n\t\t}\n\t.img_c {\n\t\t\t\tanimation: fadeInZoom 0.2s ease-in-out forwards;\n\t\t\t\tobject-fit: contain;\n\t\t\t\twidth: 10%;\n\t\t}\n\t\t&lt;/style&gt;\n&lt;div class=&quot;main_container_img&quot;&gt;\n&lt;div style=&quot;display: flex ; width: 100%; height: 100%; flex-direction: column; justify-content: center; align-content: center; align-items: center;&quot;&gt;\n\t\t&lt;img class=&quot;img_c&quot; src=&quot;https://files-accl.zohoexternal.com/public/workdrive-external/download/c4yc5f4e45a3a037f4ceeb726dfdca8d7e886?x-cli-msg=%7B%22linkId%22%3A%226OxchGZlnBc-J8HFH%22%2C%22isFileOwner%22%3Afalse%2C%22version%22%3A%221.0%22%2C%22isWDSupport%22%3Afalse%7D&quot;&gt;\n\t&lt;div style=&quot;color: #2f305d; font-weight:600;&quot;&gt; No Data Available&lt;/div&gt;&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
