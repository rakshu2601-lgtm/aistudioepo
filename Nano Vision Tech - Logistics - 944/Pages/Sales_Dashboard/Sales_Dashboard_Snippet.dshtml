<%
newLeads = Add_Lead[Status == "New"] sort by Lead_Date desc;
activeOrders = Create_Sales_Order[Status != "Delivered" && Status != "Return Requested"] sort by Requested_Delivery_Date asc;
poHandoffs = Create_Purchase_Order[Status != "Delivered"] sort by Expected_Delivery_Date asc;
unpaidInvoices = Add_Supplier_Invoice[Status != "Paid"] sort by Invoice_Date asc;
openBookings = Create_Logistics_Booking[Status != "Products Received"] sort by Expected_Arrival_Date asc;
returnWork = Create_Return_Request[ID != 0] sort by Return_Date desc;
overdueOrders = 0;
for each orderItem in activeOrders
{
  if(orderItem.Requested_Delivery_Date != null && orderItem.Requested_Delivery_Date < zoho.currentdate)
  {
    overdueOrders = overdueOrders + 1;
  }
}
overdueInvoices = 0;
for each invoiceItem in unpaidInvoices
{
  if(invoiceItem.Invoice_Date != null && invoiceItem.Invoice_Date < zoho.currentdate.subDay(30))
  {
    overdueInvoices = overdueInvoices + 1;
  }
}
%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#f7f6fb;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-thead-color:#f7f5fc;--zcs-tr-h-color:#faf9fd;--violet-soft:#f1edff;--violet-mid:#7357c7;--green-soft:#e8f8f1;--red-soft:#fdecef;--amber-soft:#fff4dc;--blue-soft:#eaf2ff}
*{box-sizing:border-box}#splash-screen{display:none!important}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%!important}.zc-container-wrapper .zc-main-content .inner,.zc-page-content-wrapper,.zc-pb-page-content-wrapper{width:100%!important;max-width:none!important}.zc-pb-page-content-wrapper .zc-pb-tile-container,.zc-pb-page-content-wrapper .zc-pb-tile-card{padding:0!important;border-radius:0!important;box-shadow:none!important}
.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-rounded-sm{border-radius:4px}.zcs-font-12{font-size:12px}.zcs-font-14{font-size:14px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-lh-body{line-height:1.5}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-sticky{position:sticky}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-theme{background:var(--violet-soft);border-color:#c8bafa;color:#6548bd}.zcs-badge-green{background:var(--green-soft);border-color:#61bd98;color:#147c58}.zcs-badge-red{background:var(--red-soft);border-color:#ed91a0;color:#c42e48}.zcs-badge-yellow{background:var(--amber-soft);border-color:#e9be59;color:#8e6508}.zcs-badge-blue{background:var(--blue-soft);border-color:#88ace9;color:#315fba}.zcs-badge-orange{background:#fff0e6;border-color:#e8a070;color:#ae560f}
.sales-dashboard{min-height:100%;background:var(--zcs-page-bg-color);font:14px/1.45 Arial,sans-serif;color:var(--zcs-primary-text-color)}.dashboard-content{max-width:1760px;margin:auto;padding:18px 20px 26px}.workspace-title{display:flex;align-items:center;gap:10px;margin:0 0 12px}.workspace-title i{width:34px;height:34px;border-radius:10px;background:var(--violet-soft);color:var(--violet-mid);display:flex;align-items:center;justify-content:center;font-size:18px}.workspace-title h1{font-size:20px;line-height:1.2;margin:0}.workspace-title p{font-size:12px;color:var(--zcs-secondary-text-color);margin:2px 0 0}.kpi-grid{display:grid;grid-template-columns:repeat(6,minmax(112px,1fr));gap:8px;margin-bottom:14px}.kpi{min-height:64px;padding:10px 12px;border-radius:10px}.kpi-icon{width:30px;height:30px;border-radius:8px;background:var(--violet-soft);color:var(--violet-mid);font-size:15px;flex:0 0 auto}.kpi-value{font-size:18px;font-weight:600;line-height:1.1}.kpi-label{font-size:11px;color:var(--zcs-secondary-text-color);margin-top:2px}.kpi.exception .kpi-icon{background:var(--red-soft);color:#c42e48}.kpi.exception .kpi-value{color:#c42e48}.section-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.work-section{height:342px;overflow:hidden;display:flex;flex-direction:column;border-top:3px solid #baa7ef}.section-head{padding:11px 14px 10px;border-bottom:1px solid var(--zcs-border-color);min-height:59px}.section-title{display:flex;align-items:center;gap:9px;min-width:0}.section-icon{width:30px;height:30px;display:flex;align-items:center;justify-content:center;border-radius:8px;background:var(--violet-soft);color:var(--violet-mid);font-size:15px;flex:0 0 auto}.section-head h2{font-size:15px;margin:0;line-height:1.2}.section-subtitle{font-size:11px;color:var(--zcs-secondary-text-color);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.section-count{font-size:11px;font-weight:600;color:#6548bd;background:var(--violet-soft);border:1px solid #d8cdf8;border-radius:999px;padding:2px 8px;white-space:nowrap}.section-body{height:280px;overflow:auto}.zcs-table-wrapper{height:100%;overflow:auto;background:var(--zcs-white-color)}.zcs-table-wrapper table{width:100%;min-width:620px;border-collapse:collapse;line-height:normal}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:var(--zcs-thead-color);box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap;font-size:11px;font-weight:600;color:var(--zcs-secondary-text-color);padding:8px 10px;text-align:left}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color);padding:9px 10px;font-size:12px;vertical-align:middle}.zcs-table-wrapper tbody tr:first-child td{border-top:0}.zcs-table-wrapper tbody tr:hover td{background:var(--zcs-tr-h-color)}.record-link,.row-action{color:var(--violet-mid);text-decoration:none;font-weight:600;white-space:nowrap}.muted{color:var(--zcs-secondary-text-color)}.empty-state{height:100%;min-height:210px;flex-direction:column;padding:24px;color:var(--zcs-secondary-text-color)}.empty-icon{width:42px;height:42px;border-radius:12px;background:var(--green-soft);color:#17835f;font-size:20px;margin-bottom:9px}.empty-state h3{font-size:14px;color:var(--zcs-primary-text-color);margin:0 0 3px}.empty-state p{font-size:12px;margin:0;text-align:center;max-width:300px}
@media(max-width:1180px){.kpi-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:820px){.dashboard-content{padding:14px}.section-grid{grid-template-columns:1fr}.work-section{height:330px}.section-body{height:268px}}@media(max-width:520px){.dashboard-content{padding:10px}.kpi-grid{grid-template-columns:repeat(2,1fr)}.workspace-title p,.section-subtitle{display:none}.work-section{height:320px}.section-body{height:258px}}
</style>
<div class='sales-dashboard'>
  <main class='dashboard-content'>
    <div class='workspace-title'><i class='zc-li-outline business-chart-bar-32'></i><div><h1>Sales operations</h1><p>Pipeline movement, commercial handoffs, delivery commitments, and return resolution.</p></div></div>
    <div class='kpi-grid' aria-label='Operational summary'>
      <div class='kpi zcs-card'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><span class='kpi-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline business-goal-65'></i></span><div><div class='kpi-value'><%=newLeads.count()%></div><div class='kpi-label'>New leads</div></div></div></div>
      <div class='kpi zcs-card'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><span class='kpi-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline shopping-list'></i></span><div><div class='kpi-value'><%=activeOrders.count()%></div><div class='kpi-label'>Active orders</div></div></div></div>
      <div class='kpi zcs-card'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><span class='kpi-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline shopping-cart'></i></span><div><div class='kpi-value'><%=poHandoffs.count()%></div><div class='kpi-label'>PO handoffs</div></div></div></div>
      <div class='kpi exception zcs-card'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><span class='kpi-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-2-time'></i></span><div><div class='kpi-value'><%=overdueOrders%></div><div class='kpi-label'>Orders overdue</div></div></div></div>
      <div class='kpi exception zcs-card'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><span class='kpi-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline shopping-receipt'></i></span><div><div class='kpi-value'><%=overdueInvoices%></div><div class='kpi-label'>Invoices over 30 days</div></div></div></div>
      <div class='kpi zcs-card'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><span class='kpi-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline shopping-box'></i></span><div><div class='kpi-value'><%=returnWork.count()%></div><div class='kpi-label'>Return requests</div></div></div></div>
    </div>
    <div class='section-grid'>
      <section class='work-section zcs-card'><div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between'><div class='section-title'><span class='section-icon'><i class='zc-li-outline business-goal-65'></i></span><div><h2>Lead qualification</h2><div class='section-subtitle'>Newest opportunities awaiting movement</div></div></div><span class='section-count'><%=newLeads.count()%> open</span></div><div class='section-body'><%if(newLeads.count() == 0){%><div class='empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center'><span class='empty-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-1-check-circle-08'></i></span><h3>Lead queue is clear</h3><p>New customer requirements will appear here for qualification.</p></div><%}else{%><div class='zcs-table-wrapper'><table><thead class='zcs-sticky'><tr><th>Lead</th><th>Customer</th><th>Contact</th><th>Date</th><th>Expected value</th><th>Handoff</th></tr></thead><tbody><%for each leadRec in newLeads{%><tr><td><a class='record-link' href='#Report:All_Leads?ID=<%=leadRec.ID%>'><%=ifnull(leadRec.Lead_ID,"Lead")%></a></td><td><%=ifnull(leadRec.Customer_Company_Name,"Customer not set")%></td><td class='muted'><%=ifnull(leadRec.Contact_Person,"Not set")%></td><td class='muted'><%=ifnull(leadRec.Lead_Date,"Not set")%></td><td><%=ifnull(leadRec.Expected_Price,"Not set")%></td><td><a class='row-action' href='#Form:Create_Sales_Order?Lead=<%=leadRec.ID%>&Requirement_Source=Customer Request'>Create order</a></td></tr><%}%></tbody></table></div><%}%></div></section>
      <section class='work-section zcs-card'><div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between'><div class='section-title'><span class='section-icon'><i class='zc-li-outline shopping-list'></i></span><div><h2>Sales order commitments</h2><div class='section-subtitle'>Customer promises and sourcing readiness</div></div></div><span class='section-count'><%=activeOrders.count()%> active</span></div><div class='section-body'><%if(activeOrders.count() == 0){%><div class='empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center'><span class='empty-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-1-check-circle-08'></i></span><h3>No active sales orders</h3><p>There are no customer orders requiring follow-up.</p></div><%}else{%><div class='zcs-table-wrapper'><table><thead class='zcs-sticky'><tr><th>Order</th><th>Order date</th><th>Requested delivery</th><th>Status</th><th>Timing</th><th>Detail</th></tr></thead><tbody><%for each orderRec in activeOrders{statusText=ifnull(orderRec.Status,"Status not set");overdue=false;if(orderRec.Requested_Delivery_Date != null && orderRec.Requested_Delivery_Date < zoho.currentdate){overdue=true;}%><tr><td><a class='record-link' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=orderRec.ID%>'><%=ifnull(orderRec.Sales_Order_ID,"Order")%></a></td><td class='muted'><%=ifnull(orderRec.Sales_Order_Date,"Not set")%></td><td><%=ifnull(orderRec.Requested_Delivery_Date,"Not set")%></td><td><span class='zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'><%=statusText%></span></td><td><%if(overdue){%><span class='zcs-badge zcs-badge-filled-outline zcs-badge-red zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'>Overdue</span><%}else{%><span class='zcs-badge zcs-badge-filled-outline zcs-badge-green zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'>On track</span><%}%></td><td><a class='row-action' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=orderRec.ID%>'>Open</a></td></tr><%}%></tbody></table></div><%}%></div></section>
      <section class='work-section zcs-card'><div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between'><div class='section-title'><span class='section-icon'><i class='zc-li-outline shopping-cart'></i></span><div><h2>Purchase-order handoffs</h2><div class='section-subtitle'>Supplier, approval, and delivery transitions</div></div></div><span class='section-count'><%=poHandoffs.count()%> open</span></div><div class='section-body'><%if(poHandoffs.count() == 0){%><div class='empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center'><span class='empty-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-1-check-circle-08'></i></span><h3>No PO handoffs</h3><p>Open purchase orders will appear here.</p></div><%}else{%><div class='zcs-table-wrapper'><table><thead class='zcs-sticky'><tr><th>Purchase order</th><th>PO date</th><th>Expected delivery</th><th>Currency</th><th>Value</th><th>Status</th><th>Detail</th></tr></thead><tbody><%for each poRec in poHandoffs{%><tr><td><a class='record-link' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=poRec.ID%>'><%=ifnull(poRec.Purchase_Order_ID,"PO")%></a></td><td class='muted'><%=ifnull(poRec.PO_Date,"Not set")%></td><td><%=ifnull(poRec.Expected_Delivery_Date,"Not set")%></td><td class='muted'><%=ifnull(poRec.Currency,"Not set")%></td><td><%=ifnull(poRec.Total_Customer_Price,"Not set")%></td><td><span class='zcs-badge zcs-badge-filled-outline zcs-badge-orange zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'><%=ifnull(poRec.Status,"Status not set")%></span></td><td><a class='row-action' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=poRec.ID%>'>Open</a></td></tr><%}%></tbody></table></div><%}%></div></section>
      <section class='work-section zcs-card'><div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between'><div class='section-title'><span class='section-icon'><i class='zc-li-outline shopping-receipt'></i></span><div><h2>Supplier invoicing</h2><div class='section-subtitle'>Unpaid invoices, oldest first</div></div></div><span class='section-count'><%=unpaidInvoices.count()%> unpaid</span></div><div class='section-body'><%if(unpaidInvoices.count() == 0){%><div class='empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center'><span class='empty-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-1-check-circle-08'></i></span><h3>No unpaid invoices</h3><p>All recorded supplier invoices are paid.</p></div><%}else{%><div class='zcs-table-wrapper'><table><thead class='zcs-sticky'><tr><th>Invoice</th><th>Supplier number</th><th>Date</th><th>Amount</th><th>Age</th><th>Action</th></tr></thead><tbody><%for each invoiceRec in unpaidInvoices{aged=false;if(invoiceRec.Invoice_Date != null && invoiceRec.Invoice_Date < zoho.currentdate.subDay(30)){aged=true;}%><tr><td><a class='record-link' href='#Page:Supplier_Invoice_Detail?Supplier_Invoice_ID=<%=invoiceRec.ID%>'><%=ifnull(invoiceRec.Supplier_Invoice_ID,"Invoice")%></a></td><td><%=ifnull(invoiceRec.Supplier_Invoice_Number,"Not set")%></td><td class='muted'><%=ifnull(invoiceRec.Invoice_Date,"Not set")%></td><td><%=ifnull(invoiceRec.Currency,"")%> <%=ifnull(invoiceRec.Invoice_Amount,"Not set")%></td><td><%if(aged){%><span class='zcs-badge zcs-badge-filled-outline zcs-badge-red zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'>Over 30 days</span><%}else{%><span class='zcs-badge zcs-badge-filled-outline zcs-badge-green zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'>Current</span><%}%></td><td><a class='row-action' href='#Form:Add_Supplier_Invoice?recLinkID=<%=invoiceRec.ID%>&viewLinkName=All_Supplier_Invoices&Action_Mode=Mark Paid'>Record payment</a></td></tr><%}%></tbody></table></div><%}%></div></section>
      <section class='work-section zcs-card'><div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between'><div class='section-title'><span class='section-icon'><i class='zc-li-outline transportation-truck-front'></i></span><div><h2>Delivery progress</h2><div class='section-subtitle'>Bookings moving toward receipt</div></div></div><span class='section-count'><%=openBookings.count()%> moving</span></div><div class='section-body'><%if(openBookings.count() == 0){%><div class='empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center'><span class='empty-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-1-check-circle-08'></i></span><h3>No open deliveries</h3><p>There are no logistics bookings awaiting receipt.</p></div><%}else{%><div class='zcs-table-wrapper'><table><thead class='zcs-sticky'><tr><th>Booking</th><th>Provider</th><th>Route</th><th>Expected arrival</th><th>Tracking</th><th>Status</th></tr></thead><tbody><%for each bookingRec in openBookings{%><tr><td><a class='record-link' href='#Page:Logistics_Booking_Detail?Logistics_Booking_ID=<%=bookingRec.ID%>'><%=ifnull(bookingRec.Logistics_Booking_ID,"Booking")%></a></td><td><%=ifnull(bookingRec.Logistics_Provider,"Not set")%></td><td class='muted'><%=ifnull(bookingRec.Pickup_Location,"Origin not set")%> to <%=ifnull(bookingRec.Warehouse_Destination,"Destination not set")%></td><td><%=ifnull(bookingRec.Expected_Arrival_Date,"Not set")%></td><td class='muted'><%=ifnull(bookingRec.Tracking_Reference,"Pending")%></td><td><span class='zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'><%=ifnull(bookingRec.Status,"Status not set")%></span></td></tr><%}%></tbody></table></div><%}%></div></section>
      <section class='work-section zcs-card'><div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between'><div class='section-title'><span class='section-icon'><i class='zc-li-outline shopping-box'></i></span><div><h2>Return resolution</h2><div class='section-subtitle'>Recent requests awaiting ownership</div></div></div><span class='section-count'><%=returnWork.count()%> requests</span></div><div class='section-body'><%if(returnWork.count() == 0){%><div class='empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center'><span class='empty-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-1-check-circle-08'></i></span><h3>No return requests</h3><p>New requests will appear here for review and resolution.</p></div><%}else{%><div class='zcs-table-wrapper'><table><thead class='zcs-sticky'><tr><th>Return</th><th>Request date</th><th>Issue</th><th>Responsibility</th><th>Next step</th></tr></thead><tbody><%for each returnRec in returnWork{%><tr><td><a class='record-link' href='#Page:Return_Request_Detail?Return_Request_ID=<%=returnRec.ID%>'><%=ifnull(returnRec.Return_Request_ID,"Return")%></a></td><td class='muted'><%=ifnull(returnRec.Return_Date,"Not set")%></td><td><%=ifnull(returnRec.Issue_Description,"No description")%></td><td><%=ifnull(returnRec.Damage_Responsibility,"Pending review")%></td><td><a class='row-action' href='#Page:Return_Request_Detail?Return_Request_ID=<%=returnRec.ID%>'>Review</a></td></tr><%}%></tbody></table></div><%}%></div></section>
    </div>
  </main>
</div>