<%
paidPOs = Create_Purchase_Order[Status == "Invoice Paid"] sort by Expected_Delivery_Date asc;
inboundBookings = Create_Logistics_Booking[Status == "New"] sort by Expected_Arrival_Date asc;
receiptRows = Logistics_Booking_Product[Parent_Logistics_Booking.Status == "New"] sort by Product_Name asc;
qcExceptions = Logistics_Quality_Check_Product[Quality_Result == "Failed" || Quality_Result == "Partially Passed"] sort by ID desc;
deliveryReadyPOs = Create_Purchase_Order[Status == "Products Received"] sort by Expected_Delivery_Date asc;
recentDeliveries = Create_Purchase_Order[Status == "Delivered" && Delivery_Date >= zoho.currentdate.subDay(30)] sort by Delivery_Date desc;
paidCount = paidPOs.count();
inboundCount = inboundBookings.count();
receiptWorkCount = 0;
for each receiptCalc in receiptRows
{
    expectedCalc = ifnull(receiptCalc.Expected_Quantity,0);
    receivedCalc = ifnull(receiptCalc.Received_Quantity,0);
    if(receivedCalc < expectedCalc)
    {
        receiptWorkCount = receiptWorkCount + 1;
    }
}
qcExceptionCount = qcExceptions.count();
readyCount = deliveryReadyPOs.count();
recentCount = recentDeliveries.count();
%>
<style>
/* zcs-global utility subset, included once for this page */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;--zcs-page-bg-color:#f7f6fb;--zcs-thead-color:#f7f5fc;font-size:16px;line-height:1.5}*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-p-0{padding:0}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-rounded-sm{border-radius:.25rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-24{font-size:1.5rem}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-card{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.zcs-list-none{list-style:none}
/* badge-filled-badge */.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent;color:#fff}.zcs-badge-theme{background:#6f4bb8}.zcs-badge-green{background:#179e6c}.zcs-badge-yellow{background:#c98412}.zcs-badge-blue{background:#496fc8}.zcs-badge-orange{background:#e36d22}.zcs-badge-red{background:#d74657}
/* table-simple-table */.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:690px}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper thead th{background:var(--zcs-thead-color);box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper tbody td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tbody tr:hover td{background:#faf9fd}
/* progress-bar-range-bar-with-texts */.zcs-progress-bar{height:7px;background:#ece8f4;border-radius:4px}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:#7350b8}
/* stepper-in-progress adapted for compact lifecycle routes */.route{display:flex;align-items:center;margin-top:10px;min-width:390px}.route-step{display:flex;align-items:center;flex:1;color:var(--zcs-teritiary-text-color);font-size:11px;white-space:nowrap}.route-step:before{content:'';width:9px;height:9px;border-radius:50%;border:2px solid #d7d1e2;background:#fff;margin-right:5px}.route-step:not(:last-child):after{content:'';height:2px;background:#ded9e8;flex:1;margin:0 6px}.route-step.done{color:#523781;font-weight:600}.route-step.done:before,.route-step.done:not(:last-child):after{border-color:#7350b8;background:#7350b8}
/* card-template-default, no-data-no-data-text-only, and page composition */
div#zppagesLive,div#elementsContainer,.Layout.elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%!important;padding:0!important}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}#splash-screen{display:none!important}.logistics-dashboard{width:100%;min-height:100%;padding:18px;background:var(--zcs-page-bg-color);font-family:Arial,sans-serif;font-size:14px;color:var(--zcs-primary-text-color)}.dashboard-header{padding:22px 24px;background:linear-gradient(135deg,#38245f,#65429b 62%,#8061b4);color:#fff;border-radius:14px}.dashboard-header h1{color:#fff}.dashboard-header p{margin-top:5px;color:rgba(255,255,255,.84)}.lifecycle-strip{display:grid;grid-template-columns:repeat(6,minmax(115px,1fr));gap:10px;margin-top:12px}.summary-card{padding:13px 14px;min-height:78px;border-top:3px solid #8061b4}.summary-card.attention{border-top-color:#d74657}.summary-card.success{border-top-color:#179e6c}.summary-value{font-size:22px;font-weight:600;line-height:1.2}.summary-label{margin-top:5px;color:var(--zcs-secondary-text-color);font-size:12px}.ops-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:14px}.ops-section{overflow:hidden;min-width:0}.section-head{height:66px;padding:12px 15px;border-bottom:1px solid var(--zcs_tertiary_border_color);background:#fcfbfe}.section-title{display:flex;align-items:center;gap:9px}.section-icon{width:30px;height:30px;border-radius:8px;background:#eee9f7;color:#63439a;display:inline-flex;align-items:center;justify-content:center;font-size:16px}.section-head h2{font-size:16px;font-weight:600;margin:0}.section-total{margin-top:2px;color:var(--zcs-secondary-text-color);font-size:12px}.section-body{height:310px;overflow:auto;padding:8px 12px}.record-list{list-style:none;margin:0;padding:0}.record-item{padding:11px 4px;border-bottom:1px solid var(--zcs_tertiary_border_color)}.record-item:last-child{border-bottom:0}.record-top{display:flex;align-items:center;justify-content:space-between;gap:8px}.record-title,.action-link{color:#63439a;font-weight:600;text-decoration:none}.record-title{color:var(--zcs-primary-text-color)}.record-title:hover,.action-link:hover{text-decoration:underline}.record-meta{display:flex;flex-wrap:wrap;gap:5px 14px;margin-top:6px;color:var(--zcs-secondary-text-color);font-size:13px}.no-data{height:100%;min-height:180px}.wide{grid-column:1/-1}.wide .section-body{height:340px;padding:0}.progress-wrap{margin-top:9px}.progress-copy{display:flex;justify-content:space-between;margin-bottom:4px;font-size:12px;color:var(--zcs-secondary-text-color)}.mobile-cards{display:none}
@media(max-width:1100px){.lifecycle-strip{grid-template-columns:repeat(3,1fr)}}@media(max-width:760px){.logistics-dashboard{padding:10px}.lifecycle-strip{grid-template-columns:repeat(2,1fr)}.ops-grid{grid-template-columns:1fr}.wide{grid-column:auto}.section-body,.wide .section-body{height:330px;padding:8px}.desktop-table{display:none}.mobile-cards{display:block}.record-item{padding:11px}.route{overflow:auto;padding-bottom:4px}.dashboard-header{padding:18px}}
</style>
<div class='logistics-dashboard'>
  <header class='dashboard-header'><h1 class='zcs-font-24 zcs-font-semibold zcs-m-0'>Logistics Operations</h1><p class='zcs-font-14 zcs-m-0'>Booking through receiving, quality control, delivery, and completion.</p></header>
  <div class='lifecycle-strip'>
    <div class='summary-card zcs-card'><div class='summary-value'><%=paidCount%></div><div class='summary-label'>Awaiting booking</div></div><div class='summary-card zcs-card'><div class='summary-value'><%=inboundCount%></div><div class='summary-label'>Inbound shipments</div></div><div class='summary-card zcs-card'><div class='summary-value'><%=receiptWorkCount%></div><div class='summary-label'>Receiving rows open</div></div><div class='summary-card zcs-card attention'><div class='summary-value'><%=qcExceptionCount%></div><div class='summary-label'>QC exceptions</div></div><div class='summary-card zcs-card'><div class='summary-value'><%=readyCount%></div><div class='summary-label'>Ready for delivery</div></div><div class='summary-card zcs-card success'><div class='summary-value'><%=recentCount%></div><div class='summary-label'>Completed in 30 days</div></div>
  </div>
  <main class='ops-grid'>
    <section class='ops-section zcs-card'><div class='section-head'><div class='section-title'><span class='section-icon'><i class='zc-li-outline files-file-add'></i></span><div><h2>Bookings</h2><div class='section-total'><%=paidCount%> paid orders ready to book</div></div></div></div><div class='section-body'>
      <%if(paidCount == 0){%><div class='zcs-nodata-wrapper no-data zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><i class='zc-li-outline ui-1-check-circle-08 zcs-font-24'></i><h5 class='zcs-font-18 zcs-font-medium zcs-m-0'>No paid orders require booking</h5></div></div><%}else{%><ul class='record-list'><%for each po in paidPOs{supplierName="Not set";if(po.Supplier != null){supplierName=ifnull(po.Supplier.Supplier_Name,"Not set");}%><li class='record-item'><div class='record-top'><a class='record-title' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=po.ID%>'>PO <%=po.Purchase_Order_ID%></a><span class='zcs-badge zcs-badge-filled zcs-badge-theme zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'>Invoice Paid</span></div><div class='record-meta'><span><%=supplierName%></span><span>Expected <%=ifnull(po.Expected_Delivery_Date,"Not set")%></span><span><%=ifnull(po.Currency,"")%> <%=ifnull(po.Supplier_Price,0)%></span></div><div class='route'><span class='route-step done'>Paid</span><span class='route-step'>Booked</span><span class='route-step'>Received</span><span class='route-step'>QC</span><span class='route-step'>Delivered</span></div></li><%}%></ul><%}%>
    </div></section>
    <section class='ops-section zcs-card'><div class='section-head'><div class='section-title'><span class='section-icon'><i class='zc-li-outline transportation-truck-front'></i></span><div><h2>Inbound Shipments</h2><div class='section-total'><%=inboundCount%> active bookings</div></div></div></div><div class='section-body'>
      <%if(inboundCount == 0){%><div class='no-data zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div><i class='zc-li-outline transportation-truck-front zcs-font-24'></i><h5 class='zcs-font-18 zcs-font-medium'>No shipments are currently inbound</h5></div></div><%}else{%><ul class='record-list'><%for each booking in inboundBookings{%><li class='record-item'><div class='record-top'><a class='record-title' href='#Page:Logistics_Booking_Detail?Logistics_Booking_ID=<%=booking.ID%>'>Booking <%=booking.Logistics_Booking_ID%></a><span class='zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'>Inbound</span></div><div class='record-meta'><span><%=ifnull(booking.Logistics_Provider,"Provider not set")%></span><span><%=ifnull(booking.Pickup_Location,"Origin not set")%> to <%=ifnull(booking.Warehouse_Destination,"Destination not set")%></span><span>ETA <%=ifnull(booking.Expected_Arrival_Date,"Not set")%></span><span>Tracking <%=ifnull(booking.Tracking_Reference,"Not set")%></span></div><div class='route'><span class='route-step done'>Paid</span><span class='route-step done'>Booked</span><span class='route-step'>Received</span><span class='route-step'>QC</span><span class='route-step'>Delivered</span></div></li><%}%></ul><%}%>
    </div></section>
    <section class='ops-section zcs-card wide'><div class='section-head'><div class='section-title'><span class='section-icon'><i class='zc-li-outline e-commerce-box'></i></span><div><h2>Receiving</h2><div class='section-total'><%=receiptWorkCount%> product rows with quantities outstanding</div></div></div></div><div class='section-body'>
      <%if(receiptWorkCount == 0){%><div class='no-data zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><h5 class='zcs-font-18 zcs-font-medium'>All inbound quantities are recorded</h5></div><%}else{%><div class='zcs-table-wrapper desktop-table zcs-relative'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Booking</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Product</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Expected</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Received</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Remaining</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Progress</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Workflow</th></tr></thead><tbody><%for each receiptLine in receiptRows{expected=ifnull(receiptLine.Expected_Quantity,0);received=ifnull(receiptLine.Received_Quantity,0);remaining=expected-received;if(remaining > 0){receiptPercent=0;if(expected > 0){receiptPercent=(received * 100) / expected;}%><tr><td class='zcs-px-16 zcs-py-8'><%=receiptLine.Parent_Logistics_Booking.Logistics_Booking_ID%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(receiptLine.Product_Name,"Product")%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=expected%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=received%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=remaining%></td><td class='zcs-px-16 zcs-py-8'><div class='zcs-progress-bar'><div class='zcs-progress-bar-indicator' style='width:<%=receiptPercent%>%'></div></div></td><td class='zcs-px-16 zcs-py-8'><a class='action-link' href='#Page:Logistics_Booking_Detail?Logistics_Booking_ID=<%=receiptLine.Parent_Logistics_Booking.ID%>'>Record receipt</a></td></tr><%}}%></tbody></table></div><ul class='record-list mobile-cards'><%for each rowCard in receiptRows{cardExpected=ifnull(rowCard.Expected_Quantity,0);cardReceived=ifnull(rowCard.Received_Quantity,0);cardRemaining=cardExpected-cardReceived;if(cardRemaining > 0){cardPercent=0;if(cardExpected > 0){cardPercent=(cardReceived * 100) / cardExpected;}%><li class='record-item'><a class='record-title' href='#Page:Logistics_Booking_Detail?Logistics_Booking_ID=<%=rowCard.Parent_Logistics_Booking.ID%>'><%=ifnull(rowCard.Product_Name,"Product")%></a><div class='record-meta'><span>Booking <%=rowCard.Parent_Logistics_Booking.Logistics_Booking_ID%></span><span><%=cardReceived%> of <%=cardExpected%> received</span><span><%=cardRemaining%> remaining</span></div><div class='progress-wrap'><div class='zcs-progress-bar'><div class='zcs-progress-bar-indicator' style='width:<%=cardPercent%>%'></div></div></div></li><%}}%></ul><%}%>
    </div></section>
    <section class='ops-section zcs-card'><div class='section-head'><div class='section-title'><span class='section-icon'><i class='zc-li-outline ui-1-search-zoom-in'></i></span><div><h2>Quality Control</h2><div class='section-total'><%=qcExceptionCount%> checks need disposition</div></div></div></div><div class='section-body'>
      <%if(qcExceptionCount == 0){%><div class='no-data zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><h5 class='zcs-font-18 zcs-font-medium'>No quality checks need attention</h5></div><%}else{%><ul class='record-list'><%for each qcStage in qcExceptions{qcStageClass="zcs-badge-orange";if(qcStage.Quality_Result == "Failed"){qcStageClass="zcs-badge-red";}%><li class='record-item'><div class='record-top'><a class='record-title' href='#Page:Logistics_Booking_Detail?Logistics_Booking_ID=<%=qcStage.Parent_Logistics_Booking.ID%>'><%=ifnull(qcStage.Product_Name,"Product")%></a><span class='zcs-badge zcs-badge-filled <%=qcStageClass%> zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'><%=ifnull(qcStage.Quality_Result,"Review")%></span></div><div class='record-meta'><span>Booking <%=qcStage.Parent_Logistics_Booking.Logistics_Booking_ID%></span><span>Inspected <%=ifnull(qcStage.Inspected_Quantity,0)%></span><span>Rejected <%=ifnull(qcStage.Rejected_Quantity,0)%></span></div></li><%}%></ul><%}%>
    </div></section>
    <section class='ops-section zcs-card'><div class='section-head'><div class='section-title'><span class='section-icon'><i class='zc-li-outline transportation-delivery-fast'></i></span><div><h2>Delivery</h2><div class='section-total'><%=readyCount%> received orders ready for handoff</div></div></div></div><div class='section-body'>
      <%if(readyCount == 0){%><div class='no-data zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><h5 class='zcs-font-18 zcs-font-medium'>No orders are ready for delivery</h5></div><%}else{%><ul class='record-list'><%for each readyPO in deliveryReadyPOs{customerName="Not set";if(readyPO.Customer != null){customerName=ifnull(readyPO.Customer.Customer_Name,"Not set");}%><li class='record-item'><div class='record-top'><a class='record-title' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=readyPO.ID%>'>PO <%=readyPO.Purchase_Order_ID%></a><span class='zcs-badge zcs-badge-filled zcs-badge-green zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'>Ready</span></div><div class='record-meta'><span>Customer <%=customerName%></span><span>Target <%=ifnull(readyPO.Expected_Delivery_Date,"Not set")%></span></div><div class='route'><span class='route-step done'>Paid</span><span class='route-step done'>Booked</span><span class='route-step done'>Received</span><span class='route-step done'>QC</span><span class='route-step'>Delivered</span></div></li><%}%></ul><%}%>
    </div></section>
    <section class='ops-section zcs-card'><div class='section-head'><div class='section-title'><span class='section-icon'><i class='zc-li-outline ui-1-alert-circle'></i></span><div><h2>Exceptions</h2><div class='section-total'><%=qcExceptionCount%> failed or partially passed checks</div></div></div></div><div class='section-body'>
      <%if(qcExceptionCount == 0){%><div class='no-data zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><h5 class='zcs-font-18 zcs-font-medium'>No quality exceptions require attention</h5></div><%}else{%><ul class='record-list'><%for each qc in qcExceptions{badgeClass="zcs-badge-orange";if(qc.Quality_Result == "Failed"){badgeClass="zcs-badge-red";}%><li class='record-item'><div class='record-top'><a class='record-title' href='#Page:Logistics_Booking_Detail?Logistics_Booking_ID=<%=qc.Parent_Logistics_Booking.ID%>'><%=ifnull(qc.Product_Name,"Product")%></a><span class='zcs-badge zcs-badge-filled <%=badgeClass%> zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'><%=ifnull(qc.Quality_Result,"Review")%></span></div><div class='record-meta'><span>Booking <%=qc.Parent_Logistics_Booking.Logistics_Booking_ID%></span><span><%=ifnull(qc.Defect_Details,"No defect detail entered")%></span></div></li><%}%></ul><%}%>
    </div></section>
    <section class='ops-section zcs-card'><div class='section-head'><div class='section-title'><span class='section-icon'><i class='zc-li-outline ui-1-check-circle-08'></i></span><div><h2>Completion</h2><div class='section-total'><%=recentCount%> delivered in the last 30 days</div></div></div></div><div class='section-body'>
      <%if(recentCount == 0){%><div class='no-data zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><h5 class='zcs-font-18 zcs-font-medium'>No recent delivery completions</h5></div><%}else{%><ul class='record-list'><%for each deliveredPO in recentDeliveries{deliveredCustomer="Not set";deliveredByName="Not set";if(deliveredPO.Customer != null){deliveredCustomer=ifnull(deliveredPO.Customer.Customer_Name,"Not set");}if(deliveredPO.Delivered_By != null){deliveredByName=ifnull(deliveredPO.Delivered_By.Employee_Name,"Not set");}%><li class='record-item'><div class='record-top'><a class='record-title' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=deliveredPO.ID%>'>PO <%=deliveredPO.Purchase_Order_ID%></a><span class='zcs-badge zcs-badge-filled zcs-badge-green zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-sm zcs-px-10 zcs-py-2'><i class='zc-li-outline ui-1-check-circle-08'></i><span>Delivered</span></span></div><div class='record-meta'><span>Customer <%=deliveredCustomer%></span><span>Completed <%=ifnull(deliveredPO.Delivery_Date,"Not set")%></span><span>Delivered by <%=deliveredByName%></span></div><div class='route'><span class='route-step done'>Paid</span><span class='route-step done'>Booked</span><span class='route-step done'>Received</span><span class='route-step done'>QC</span><span class='route-step done'>Delivered</span></div></li><%}%></ul><%}%>
    </div></section>
  </main>
</div>