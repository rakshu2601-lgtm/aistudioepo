<%
products = Add_Product[ID != 0] sort by Product_Name asc;
allCount = products.count();
activeCount = Add_Product[Active == true].count();
inactiveCount = Add_Product[Active == false].count();
categories = List();
categoryCounts = Map();
for each categoryProduct in products
{
    categoryName = ifnull(categoryProduct.Product_Category,"Uncategorized");
    if(!categories.contains(categoryName))
    {
        categories.add(categoryName);
        categoryCounts.put(categoryName,0);
    }
    categoryCounts.put(categoryName,categoryCounts.get(categoryName) + 1);
}
categories.sort(true);
%>
<style>
/* ZCS global utility layer, included once for this page. */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;--zcs-border-color:var(--zcs_tertiary_border_color);font-size:16px;line-height:1.5}*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-p-20{padding:1.25rem}.zcs-px-6{padding-left:.375rem;padding-right:.375rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-box-border{box-sizing:border-box}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-18{font-size:1.125rem}.zcs-font-22{font-size:1.375rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-20{margin-top:1.25rem}.zcs-sticky{position:sticky}.zcs-relative{position:relative}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}a{text-decoration:none}
.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%;width:100%}.zc-container-wrapper .zc-main-content .inner,.zc-page-content-wrapper,.zc-pb-page-content-wrapper,.zc-pb-page-content-wrapper .zc-pb-tile-container,.zc-pb-page-content-wrapper .zc-pb-tile-card{width:100%!important;max-width:none!important;padding:0!important;margin:0!important;border-radius:0!important;box-shadow:none!important}#splash-screen,.zc-pb-page-content-wrapper .page-loader{display:none!important}
.products-page{min-height:100%;padding:16px;background:var(--zcs-page-bg-color);font:14px/1.45 Arial,sans-serif;color:var(--zcs-primary-text-color)}.products-shell{width:100%;max-width:1480px;margin:auto}.zcs-page-header{padding:14px 16px;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;background:#fff}.header-mark{display:grid;place-items:center;width:36px;height:36px;border-radius:8px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:18px}.products-title{margin:0;font-size:22px;font-weight:600}.products-subtitle{margin:2px 0 0;color:var(--zcs-secondary-text-color);font-size:13px}
.status-context{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:10px 0}.context-card{display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:8px;background:#fff}.context-icon{display:grid;place-items:center;width:30px;height:30px;border-radius:7px;font-size:15px}.context-icon.all{color:#2A6FFC;background:#E8EFFF}.context-icon.active{color:#179E6C;background:#E4FCF3}.context-icon.inactive{color:#555;background:#e8e8e8}.context-value{font-size:17px;font-weight:600;line-height:1}.context-label{margin-top:2px;color:var(--zcs-secondary-text-color);font-size:11px}
.catalog-panel{border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;background:#fff;overflow:hidden}.catalog-radio{position:absolute;opacity:0;pointer-events:none}.zcs-horizontal-tabhead{display:flex;gap:12px;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;padding:0 12px;margin:0}.zcs-horizontal-tabhead::-webkit-scrollbar{display:none}.zcs-horizontal-tabitem{list-style:none;border-bottom:2px solid transparent;white-space:nowrap}.zcs-horizontal-tablink{display:flex;align-items:center;justify-content:center;gap:7px;padding:10px 8px;color:var(--zcs_tertiary_text_color);cursor:pointer;font-weight:500}.zcs-horizontal-tabcount{min-width:20px;background:var(--zcs-page-bg-color);padding:1px 6px;border-radius:4px;text-align:center;font-size:11px}#tab-all:checked~.zcs-horizontal-tabhead label[for='tab-all'],#tab-active:checked~.zcs-horizontal-tabhead label[for='tab-active'],#tab-inactive:checked~.zcs-horizontal-tabhead label[for='tab-inactive']{border-bottom-color:var(--zcs_brand_color)}#tab-all:checked~.zcs-horizontal-tabhead label[for='tab-all'] .zcs-horizontal-tablink,#tab-active:checked~.zcs-horizontal-tabhead label[for='tab-active'] .zcs-horizontal-tablink,#tab-inactive:checked~.zcs-horizontal-tabhead label[for='tab-inactive'] .zcs-horizontal-tablink{color:var(--zcs_brand_color)}
<% for each index categoryIndex in categories { %>#tab-category-<%=categoryIndex%>:checked~.zcs-horizontal-tabhead label[for='tab-category-<%=categoryIndex%>']{border-bottom-color:var(--zcs_brand_color)}#tab-category-<%=categoryIndex%>:checked~.zcs-horizontal-tabhead label[for='tab-category-<%=categoryIndex%>'] .zcs-horizontal-tablink{color:var(--zcs_brand_color)}#tab-category-<%=categoryIndex%>:checked~.catalog-content .product-row:not(.category-<%=categoryIndex%>){display:none}<% } %>#tab-active:checked~.catalog-content .product-row:not(.state-active),#tab-inactive:checked~.catalog-content .product-row:not(.state-inactive){display:none}
.catalog-content{padding:12px}.register-caption{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 9px}.register-title{font-weight:600}.register-note{color:var(--zcs-secondary-text-color);font-size:12px}.zcs-table-wrapper{height:520px;max-height:520px;border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto;border-radius:6px}.zcs-table-wrapper table{border-collapse:collapse;min-width:1050px;line-height:normal}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:#F9FAFE;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap;font-weight:600}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:middle}.zcs-table-wrapper tbody tr:first-child td{border-top:0}.zcs-table-wrapper tbody tr:hover td{background:#F9FAFE}.identity{min-width:235px}.product-name{display:block;font-weight:600;color:var(--zcs_brand_color)}.product-ids{display:flex;flex-wrap:wrap;gap:3px 10px;margin-top:3px;color:var(--zcs-secondary-text-color);font-size:11px}.classification{font-weight:500}.spec-line{display:block;margin-top:3px;color:var(--zcs-secondary-text-color);font-size:11px}.zcs-badge{width:auto;border:1px solid}.zcs-badge-green{background:#E4FCF3;border-color:#179E6C;color:#137d58}.zcs-badge-grey{background:#e8e8e8;border-color:#686868;color:#444}.action-list{display:flex;align-items:center;gap:5px}.zcs-custom-action-icon{display:grid;place-items:center;width:30px;height:30px;border:1px solid var(--zcs_tertiary_border_color);border-radius:50%;color:var(--zcs-secondary-text-color)}.zcs-custom-action-icon:hover{border-color:var(--zcs_brand_color);background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.zcs-nodata-wrapper{min-height:360px}.nodata-icon{display:grid;place-items:center;width:58px;height:58px;margin:auto;border-radius:14px;background:#E8EFFF;color:#2A6FFC;font-size:25px}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color)}
@media(max-width:760px){.products-page{padding:8px}.zcs-page-header{padding:12px}.products-title{font-size:19px}.status-context{grid-template-columns:1fr 1fr}.context-card:first-child{grid-column:1/-1}.catalog-content{padding:8px}.register-caption{align-items:flex-start;flex-direction:column;gap:2px}.zcs-table-wrapper{height:570px;max-height:570px}.zcs-table-wrapper table,.zcs-table-wrapper thead,.zcs-table-wrapper tbody,.zcs-table-wrapper tr,.zcs-table-wrapper th,.zcs-table-wrapper td{display:block;min-width:0}.zcs-table-wrapper thead{display:none}.zcs-table-wrapper tr{padding:11px;border-bottom:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tr:last-child{border-bottom:0}.zcs-table-wrapper td{border:0;padding:4px 0}.zcs-table-wrapper td:before{content:attr(data-label);display:block;color:var(--zcs-secondary-text-color);font-size:10px;text-transform:uppercase;letter-spacing:.03em}.identity:before,.actions-cell:before{display:none!important}.action-list{margin-top:7px}.products-subtitle{max-width:280px}}
</style>
<div class='products-page'><div class='products-shell'>
  <div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-gap-8 zcs-box-border'><span class='header-mark'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i></span><div class='zcs-ellipsis'><h1 class='products-title'>Products</h1><p class='products-subtitle'>Product identity, classification, manufacturer specifications, and lifecycle availability.</p></div></div>
  <div class='status-context'><div class='context-card'><span class='context-icon all'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i></span><div><div class='context-value'><%=allCount%></div><div class='context-label'>Catalog records</div></div></div><div class='context-card'><span class='context-icon active'><i class='zc-li-outline ui-1-check-circle-08'></i></span><div><div class='context-value'><%=activeCount%></div><div class='context-label'>Active</div></div></div><div class='context-card'><span class='context-icon inactive'><i class='zc-li-outline ui-1-circle-remove'></i></span><div><div class='context-value'><%=inactiveCount%></div><div class='context-label'>Inactive</div></div></div></div>
  <div class='catalog-panel'>
    <input class='catalog-radio' type='radio' name='catalog-tab' id='tab-all' checked><input class='catalog-radio' type='radio' name='catalog-tab' id='tab-active'><input class='catalog-radio' type='radio' name='catalog-tab' id='tab-inactive'><% for each index categoryIndex in categories { %><input class='catalog-radio' type='radio' name='catalog-tab' id='tab-category-<%=categoryIndex%>'><% } %>
    <div class='zcs-horizontal-tabhead'><label class='zcs-horizontal-tabitem' for='tab-all'><span class='zcs-horizontal-tablink'><span>All</span><span class='zcs-horizontal-tabcount'><%=allCount%></span></span></label><label class='zcs-horizontal-tabitem' for='tab-active'><span class='zcs-horizontal-tablink'><span>Active</span><span class='zcs-horizontal-tabcount'><%=activeCount%></span></span></label><label class='zcs-horizontal-tabitem' for='tab-inactive'><span class='zcs-horizontal-tablink'><span>Inactive</span><span class='zcs-horizontal-tabcount'><%=inactiveCount%></span></span></label><% for each index categoryIndex in categories { categoryName = categories.get(categoryIndex); %><label class='zcs-horizontal-tabitem' for='tab-category-<%=categoryIndex%>'><span class='zcs-horizontal-tablink'><span><%=categoryName%></span><span class='zcs-horizontal-tabcount'><%=categoryCounts.get(categoryName)%></span></span></label><% } %></div>
    <div class='catalog-content'>
    <% if(allCount == 0) { %><div class='zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-nodata-content zcs-p-20 zcs-box-border'><span class='nodata-icon'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i></span><h5 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-m-0'>No products available</h5><p class='zcs-font-14 zcs-color-tertiary zcs-mt-12'>Add the first product to establish the master catalog.</p><div class='zcs-flex zcs-justify-center zcs-mt-20'><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Form:Add_Product'><i class='zc-li-outline ui-1-simple-add'></i><span>Add Product</span></a></div></div></div><% } else { %>
      <div class='register-caption'><span class='register-title'>Product register</span><span class='register-note'>Select a product name for its complete record.</span></div>
      <div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Product identity</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Classification</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Manufacturer specification</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Lifecycle</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Actions</th></tr></thead><tbody>
      <% for each product in products { productCategory=ifnull(product.Product_Category,"Uncategorized"); categoryIndex=categories.indexOf(productCategory); stateClass=if(product.Active == true,"state-active","state-inactive"); %><tr class='product-row category-<%=categoryIndex%> <%=stateClass%>'><td data-label='Product identity' class='identity zcs-px-16 zcs-py-8'><a class='product-name' href='#Page:Product_Detail?Product_ID=<%=product.ID%>'><%=product.Product_Name%></a><span class='product-ids'><span>Product <%=product.Product_ID%></span><span>Internal <%=ifnull(product.Internal_Part_Number,"-")%></span></span></td><td data-label='Classification' class='zcs-px-16 zcs-py-8'><span class='classification'><%=productCategory%></span><span class='spec-line'><%=ifnull(product.Product_Type,"-")%></span></td><td data-label='Manufacturer specification' class='zcs-px-16 zcs-py-8'><span class='classification'><%=ifnull(product.Brand_Make,"-")%></span><span class='spec-line'>Model <%=ifnull(product.Model,"-")%> · MPN <%=ifnull(product.Manufacturer_Part_Number,"-")%></span></td><td data-label='Lifecycle' class='zcs-px-16 zcs-py-8'><span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 <%=if(product.Active == true,"zcs-badge-green","zcs-badge-grey")%>'><i class='zc-li-outline <%=if(product.Active == true,"ui-1-check-circle-08","ui-1-circle-remove")%>'></i><span><%=if(product.Active == true,"Active","Inactive")%></span></span></td><td data-label='Actions' class='actions-cell zcs-px-16 zcs-py-8'><div class='action-list'><a class='zcs-custom-action-icon' title='View detail' aria-label='View product detail' href='#Page:Product_Detail?Product_ID=<%=product.ID%>'><i class='zc-li-outline arrows-1-tail-right'></i></a><a class='zcs-custom-action-icon' title='Edit product' aria-label='Edit product' href='#Form:Add_Product?recLinkID=<%=product.ID%>&viewLinkName=All_Products'><i class='zc-li-outline ui-1-edit-72'></i></a><a class='zcs-custom-action-icon' title='<%=if(product.Active == true,"Deactivate","Activate")%> product' aria-label='<%=if(product.Active == true,"Deactivate","Activate")%> product' href='#Report:All_Products?ID=<%=product.ID%>'><i class='zc-li-outline <%=if(product.Active == true,"ui-1-circle-remove","ui-1-check-circle-08")%>'></i></a></div></td></tr><% } %>
      </tbody></table></div>
    <% } %>
    </div>
  </div>
</div></div>