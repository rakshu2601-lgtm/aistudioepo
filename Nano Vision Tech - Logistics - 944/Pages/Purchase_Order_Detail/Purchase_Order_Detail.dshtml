<%
poList = Create_Purchase_Order[ID == input.Purchase_Order_ID];
%>
<style>
/* ZCS global utility subset and component styles: zcs-global, procurement detail, stepper, table, badge, no-data, timeline, outline button, key-value */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#f5f6f8;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-thead-color:#f7f8fb;--zcs-tr-h-color:#f8f9fc}
*{box-sizing:border-box}#splash-screen{display:none!important}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-row-wrap{flex-wrap:wrap}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-half{border-radius:50%}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary,.zcs-color-tertiary{color:var(--zcs-secondary-text-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-no-underline{text-decoration:none}.zcs-overflow-auto{overflow:auto}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:10px}
a{text-decoration:none}.zcs-button{width:auto;min-width:5rem;min-height:34px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}.zcs-button-icon{width:16px}.zcs-badge{width:max-content;white-space:nowrap;border:1px solid}.zcs-badge-filled.zcs-badge-theme{background:var(--zcs-light-bg-color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled.zcs-badge-yellow{background:#fcf4e6;border-color:#d99212;color:#8a5908}.zcs-badge-filled.zcs-badge-orange{background:#f8f0eb;border-color:#f4660c;color:#a63e00}.zcs-badge-filled.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#174bb9}.zcs-badge-filled.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#087d55}.zcs-badge-filled.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#af1730}.zcs-badge-filled.zcs-badge-grey{background:#eee;border-color:#666;color:#333}
.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:#fff;overflow:auto;border-radius:7px;height:318px}.zcs-table-wrapper table{border-collapse:collapse;min-width:900px;line-height:normal}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:var(--zcs-thead-color);box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap;font-weight:600;text-align:left}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color);vertical-align:top}.zcs-table-wrapper tbody tr:hover td{background:var(--zcs-tr-h-color)}
.po-page{min-height:100%;width:100%;overflow:auto;background:var(--zcs-page-bg-color);padding:14px;font:14px/1.45 Arial,sans-serif;color:var(--zcs-primary-text-color)}.po-shell{max-width:1540px;margin:auto}.stack{display:flex;flex-direction:column;gap:12px}.hero{padding:14px 16px}.identity{min-width:0}.hero-title{font-size:21px;margin:0;letter-spacing:-.2px}.hero-sub{color:var(--zcs-secondary-text-color);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.icon-box{width:38px;height:38px;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:9px;background:var(--zcs-light-bg-color);color:var(--zcs_brand_color);font-size:18px}.zcs-back{color:var(--zcs-secondary-text-color);display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;margin-bottom:7px}.zcs-back:hover,.link{color:var(--zcs_brand_color)}.actions{justify-content:flex-end}.next-step{margin-top:12px;padding:9px 12px;border-left:3px solid var(--zcs_brand_color);background:var(--zcs-light-bg-color);border-radius:5px;font-size:13px}.section{padding:15px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}.section-title{font-size:16px;font-weight:600;margin:0;display:flex;align-items:center;gap:8px}.section-title i{color:var(--zcs_brand_color)}.two-col{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(320px,.75fr);gap:12px;align-items:start}.kv-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--zcs-border-color);border:1px solid var(--zcs-border-color);border-radius:7px;overflow:hidden}.kv{background:#fff;padding:10px 12px;min-width:0}.kv label{display:block;color:var(--zcs-secondary-text-color);font-size:11px;text-transform:uppercase;letter-spacing:.35px;margin-bottom:2px}.kv strong,.kv span,.kv a{display:block;overflow-wrap:anywhere}.link{font-weight:600}.commercial-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.metric{padding:11px 12px;background:#f8f9fc;border:1px solid #eef0f5;border-radius:7px}.metric label{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.3px;color:var(--zcs-secondary-text-color)}.metric strong{font-size:16px}.metric.total{background:var(--zcs-light-bg-color);border-color:var(--zcs_brand_color)}.empty{height:210px;padding:20px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:var(--zcs-secondary-text-color)}.empty i{font-size:24px;color:var(--zcs_brand_color);margin-bottom:6px}.cards-scroll{height:270px;overflow:auto;padding-right:4px}.record-card{padding:11px 12px;border:1px solid var(--zcs-border-color);border-radius:7px;background:#fff}.record-card+.record-card{margin-top:8px}.record-meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px 10px;margin-top:7px;color:var(--zcs-secondary-text-color);font-size:12px}.text-value{white-space:pre-wrap;overflow-wrap:anywhere;margin:4px 0 12px}.progress-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:0}.progress-step{position:relative;padding:8px 5px;text-align:center;color:var(--zcs-secondary-text-color);font-size:12px}.progress-step:before{content:'';position:absolute;top:18px;left:0;right:0;height:2px;background:#e4e6ec;z-index:0}.progress-step:first-child:before{left:50%}.progress-step:last-child:before{right:50%}.progress-step i{position:relative;z-index:1;display:flex;width:22px;height:22px;margin:0 auto 5px;align-items:center;justify-content:center;border-radius:50%;background:#f1f2f6}.progress-step.done{color:#087d55}.progress-step.done:before{background:#179e6c}.progress-step.done i{background:#e4fcf3}.progress-step.current{color:var(--zcs_brand_color);font-weight:600}.progress-step.current i{background:var(--zcs-light-bg-color);box-shadow:0 0 0 2px var(--zcs_brand_color)}.timeline-scroll{height:340px;overflow:auto}.zcs-tl-li{list-style:none;min-height:64px}.zcs-tl-indicator{width:30px;left:0}.zcs-tl-dot{width:10px;height:10px;background:var(--zcs_brand_color);border:2px solid #fff;box-shadow:0 0 0 2px var(--zcs-light-bg-color)}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:'';position:absolute;width:1px;height:calc(100% + 24px);background:#dfe1e8;top:10px}.timeline-body{padding-left:38px}.mobile-products{display:none}
@media(max-width:980px){.two-col{grid-template-columns:1fr}.actions{justify-content:flex-start}.hero-row{align-items:flex-start}.cards-scroll{height:300px}}
@media(max-width:620px){.po-page{padding:8px}.section,.hero{padding:12px}.hero-row{flex-direction:column}.hero-title{font-size:19px}.kv-grid,.commercial-grid,.record-meta{grid-template-columns:1fr}.actions{width:100%}.actions .zcs-button{flex:1 1 calc(50% - 8px);min-width:0}.progress-grid{display:flex;overflow-x:auto}.progress-step{min-width:116px}.desktop-products{display:none}.mobile-products{display:flex;height:318px;overflow:auto}.empty{height:180px}}
</style>
<div class='po-page'><div class='po-shell'>
<%if(poList.count() == 0){%>
<div class='zcs-card zcs-nodata-wrapper empty'><i class='zc-li-outline ui-1-search-zoom-out'></i><h3 class='zcs-m-0'>Purchase order not found</h3><p>No accessible purchase order matches the supplied identifier.</p><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Page:Purchase_Orders'><i class='zc-li-outline arrows-1-tail-left'></i><span>Purchase orders</span></a></div>
<%}else{
po = poList;
poStatus = ifnull(po.Status,"New").toString();
supplierName = "Not set"; customerName = "Not set"; salesOrderLabel = "Not set"; salesOrderID = null; sourceType = "Not set"; sourceLead = "Not set"; sourceRequirements = "Not set"; sourceRequestedDate = "Not set"; quoteLabel = "Not set"; quoteDate = "Not set"; quoteAvailability = "Not set"; quoteLeadTime = "Not set"; quoteRemarks = "No supplier remarks"; deliveredBy = "Not set";
if(po.Supplier != null){supplierName=ifnull(po.Supplier.Supplier_Name,"Not set");}
if(po.Customer != null){customerName=ifnull(po.Customer.Customer_Name,"Not set");}
if(po.Sales_Order != null){salesOrderID=po.Sales_Order.ID;salesOrderLabel=ifnull(po.Sales_Order.Sales_Order_ID,"Not set");sourceType=ifnull(po.Sales_Order.Requirement_Source,"Not set");sourceRequirements=ifnull(po.Sales_Order.Customer_Requirements,"Not set");sourceRequestedDate=ifnull(po.Sales_Order.Requested_Delivery_Date,"Not set");if(po.Sales_Order.Lead != null){sourceLead=po.Sales_Order.Lead.toString();}}
quoteProducts = Supplier_Quote_Product[ID == 0];
if(po.Selected_Supplier_Quote != null){quoteLabel=ifnull(po.Selected_Supplier_Quote.Supplier_Quote_ID,"Not set");quoteDate=ifnull(po.Selected_Supplier_Quote.Quote_Date,"Not set");quoteAvailability=ifnull(po.Selected_Supplier_Quote.Availability,"Not set");quoteLeadTime=ifnull(po.Selected_Supplier_Quote.Lead_Time,"Not set");quoteRemarks=ifnull(po.Selected_Supplier_Quote.Supplier_Remarks,"No supplier remarks");quoteProducts=Supplier_Quote_Product[Parent_Supplier_Quote == po.Selected_Supplier_Quote];}
if(po.Delivered_By != null){deliveredBy=ifnull(po.Delivered_By.Employee_Name,"Not set");}
products = Purchase_Order_Product[Parent_Purchase_Order == po.ID]; invoices = Add_Supplier_Invoice[Purchase_Order == po.ID] sort by Invoice_Date desc; bookingLinks = Logistics_Booking_Purchase_Order[Purchase_Order == po.ID]; receiptRows = Logistics_Booking_Product[Purchase_Order == po.ID]; qcRows = Logistics_Quality_Check_Product[Purchase_Order == po.ID]; returns = Create_Return_Request[Purchase_Order == po.ID] sort by Return_Date desc; histories = Add_History[Purchase_Order_Lookup == po.ID] sort by Updated_Date_Time desc;
badgeClass="zcs-badge-theme"; if(poStatus=="New"){badgeClass="zcs-badge-yellow";}else if(poStatus=="Approved" || poStatus=="Customer Approved"){badgeClass="zcs-badge-orange";}else if(poStatus=="Delivered"){badgeClass="zcs-badge-green";}else if(poStatus=="Invoice Paid" || poStatus=="Logistics Pending" || poStatus=="Products Received"){badgeClass="zcs-badge-blue";}
nextStep="Review current fulfillment records"; if(poStatus=="New"){nextStep="Approve the purchase order";}else if(poStatus=="Approved" && po.Shared_With_Customer != true){nextStep="Share the approved order with the customer";}else if(poStatus=="Approved"){nextStep="Record customer approval";}else if(poStatus=="Customer Approved"){nextStep="Create the supplier invoice";}else if(poStatus=="Invoice Created"){nextStep="Record supplier invoice payment";}else if(poStatus=="Invoice Paid"){nextStep="Create a logistics booking";}else if(poStatus=="Logistics Pending"){nextStep="Receive products and complete quality checks";}else if(poStatus=="Products Received"){nextStep="Confirm customer delivery";}else if(poStatus=="Delivered"){nextStep="Fulfillment complete; create a return only when required";}
%>
<div class='stack'>
<section class='zcs-card hero'><a href='#Page:Purchase_Orders' class='zcs-back'><i class='zc-li-outline arrows-1-tail-left'></i><span>Purchase orders</span></a><div class='hero-row zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16'><div class='identity zcs-flex zcs-align-items-center zcs-gap-12'><span class='icon-box'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i></span><div class='identity'><div class='zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8'><h1 class='hero-title'><%=po.Purchase_Order_ID%></h1><span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 <%=badgeClass%>'><%=poStatus%></span></div><div class='hero-sub'><%=supplierName%> to <%=customerName%> · <%=ifnull(po.PO_Date,"Date not set")%></div></div></div><div class='actions zcs-flex zcs-row-wrap zcs-gap-8'>
<%if(poStatus=="New" && salesOrderID != null){%><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Form:Add_History?Purchase_Order_Lookup=<%=po.ID%>&amp;Sales_Order_Lookup=<%=salesOrderID%>&amp;Action_Type=Purchase Order Approved&amp;Status=New&amp;Previous_Status=New&amp;New_Status=Approved&amp;zc_LoadIn=dialog'><i class='zc-li-outline ui-1-check-circle-08'></i><span>Approve</span></a><%}else if(poStatus=="Approved" && po.Shared_With_Customer != true){%><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Form:Create_Purchase_Order?recLinkID=<%=po.ID%>&amp;viewLinkName=All_Purchase_Orders&amp;Action_Mode=Share With Customer&amp;zc_LoadIn=dialog'><i class='zc-li-outline ui-1-share-66'></i><span>Share</span></a><%}else if(poStatus=="Approved" && po.Shared_With_Customer==true){%><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Form:Create_Purchase_Order?recLinkID=<%=po.ID%>&amp;viewLinkName=All_Purchase_Orders&amp;Action_Mode=Customer Approval&amp;zc_LoadIn=dialog'><i class='zc-li-outline ui-1-check-circle-08'></i><span>Customer approval</span></a><%}else if(poStatus=="Customer Approved"){%><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Form:Add_Supplier_Invoice?Purchase_Order=<%=po.ID%>&amp;zc_LoadIn=dialog'><i class='zc-li-outline files-single-copy-04'></i><span>Create invoice</span></a><%}else if(poStatus=="Invoice Paid"){%><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Form:Create_Logistics_Booking?zc_LoadIn=dialog'><i class='zc-li-outline transport-delivery-fast'></i><span>Book logistics</span></a><%}else if(poStatus=="Products Received"){%><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Form:Create_Purchase_Order?recLinkID=<%=po.ID%>&amp;viewLinkName=All_Purchase_Orders&amp;Action_Mode=Confirm Delivery&amp;zc_LoadIn=dialog'><i class='zc-li-outline transport-delivery-fast'></i><span>Confirm delivery</span></a><%}else if(poStatus=="Delivered"){%><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Form:Create_Return_Request?Purchase_Order=<%=po.ID%>&amp;zc_LoadIn=dialog'><i class='zc-li-outline arrows-4-restore'></i><span>Create return</span></a><%}%>
<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Report:All_Purchase_Orders?ID=<%=po.ID%>'><i class='zc-li-outline files-single'></i><span>PO record</span></a></div></div><div class='next-step'><strong>Next step:</strong> <%=nextStep%></div></section>
<div class='two-col'><div class='stack'>
<section class='zcs-card section'><div class='section-head'><h2 class='section-title'><i class='zc-li-outline files-single'></i>Commercial details</h2></div><div class='commercial-grid'><div class='metric'><label>Supplier price</label><strong><%=po.Currency%> <%=ifnull(po.Supplier_Price,0)%></strong></div><div class='metric'><label>Shipping</label><strong><%=po.Currency%> <%=ifnull(po.Shipping_Charge,0)%></strong></div><div class='metric'><label>Customs duty</label><strong><%=po.Currency%> <%=ifnull(po.Customs_Duty_Via_Freight,0)%></strong></div><div class='metric'><label>Additional margin</label><strong><%=po.Currency%> <%=ifnull(po.Additional_Margin,0)%></strong></div><div class='metric'><label>Subtotal</label><strong><%=po.Currency%> <%=ifnull(po.Subtotal,0)%></strong></div><div class='metric total'><label>Customer total</label><strong><%=po.Currency%> <%=ifnull(po.Total_Customer_Price,0)%></strong></div></div><div class='kv-grid' style='margin-top:12px'><div class='kv'><label>PO date</label><span><%=ifnull(po.PO_Date,"Not set")%></span></div><div class='kv'><label>Expected delivery</label><span><%=ifnull(po.Expected_Delivery_Date,"Not set")%></span></div><div class='kv'><label>Dispatch location</label><span><%=ifnull(po.Dispatch_Location,"Not set")%></span></div><div class='kv'><label>Currency</label><span><%=ifnull(po.Currency,"Not set")%></span></div></div></section>
<section class='zcs-card section'><div class='section-head'><h2 class='section-title'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i>Product lines</h2><span class='zcs-badge zcs-badge-filled zcs-badge-theme zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'><%=products.count()%> lines</span></div><%if(products.count()==0){%><div class='empty'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i>No product lines</div><%}else{%><div class='zcs-table-wrapper desktop-products'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8'>Product</th><th class='zcs-px-16 zcs-py-8'>Configuration</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Quantity</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Supplier total</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Customer total</th><th class='zcs-px-16 zcs-py-8'>Remarks</th></tr></thead><tbody><%for each item in products{%><tr><td class='zcs-px-16 zcs-py-8'><strong><%=ifnull(item.Product_Name,"Product")%></strong><br><span class='zcs-font-12 zcs-color-tertiary'><%=ifnull(item.Product_ID,"")%> <%=ifnull(item.Brand_Make,"")%> <%=ifnull(item.Model,"")%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(item.Approved_Configuration,"Not set")%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=ifnull(item.Quantity,0)%> <%=ifnull(item.Unit_of_Measure,"")%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=item.Currency%> <%=ifnull(item.Supplier_Total_Price,0)%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=item.Currency%> <%=ifnull(item.Customer_Total_Price,0)%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(item.Remarks,"")%></td></tr><%}%></tbody></table></div><div class='mobile-products zcs-direction-column zcs-gap-12'><%for each mobileItem in products{%><div class='record-card'><strong><%=ifnull(mobileItem.Product_Name,"Product")%></strong><div class='record-meta'><span><%=ifnull(mobileItem.Quantity,0)%> <%=ifnull(mobileItem.Unit_of_Measure,"")%></span><span>Supplier: <%=mobileItem.Currency%> <%=ifnull(mobileItem.Supplier_Total_Price,0)%></span><span>Customer: <%=mobileItem.Currency%> <%=ifnull(mobileItem.Customer_Total_Price,0)%></span></div></div><%}%></div><%}%></section>
<section class='zcs-card section'><div class='section-head'><h2 class='section-title'><i class='zc-li-outline ui-1-check-circle-08'></i>Shipment and QC progress</h2></div><%stage=0;if(poStatus=="Invoice Paid"){stage=1;}else if(poStatus=="Logistics Pending"){stage=2;}else if(poStatus=="Products Received"){stage=4;}else if(poStatus=="Delivered"){stage=5;}%><div class='progress-grid'><%steps={"Payment cleared","Logistics booked","In transit","Received and QC","Delivered"};for each index i in steps{stepClass="";if(stage>i){stepClass="done";}else if(stage==i+1){stepClass="current";}%><div class='progress-step <%=stepClass%>'><i class='zc-li-outline <%=if(stage>i,"ui-1-check-circle-08","ui-2-time")%>'></i><%=steps.get(i)%></div><%}%></div><div style='margin-top:16px'><%if(receiptRows.count()==0 && qcRows.count()==0){%><div class='empty'><i class='zc-li-outline ui-1-check-circle-08'></i>No receipt or quality-check lines</div><%}else{%><div class='zcs-table-wrapper'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8'>Product</th><th class='zcs-px-16 zcs-py-8'>Serial details</th><th class='zcs-px-16 zcs-py-8'>Expected / received</th><th class='zcs-px-16 zcs-py-8'>Accepted / rejected</th><th class='zcs-px-16 zcs-py-8'>QC result</th></tr></thead><tbody><%for each receipt in receiptRows{relatedQC=Logistics_Quality_Check_Product[Logistics_Booking_Product==receipt.ID];%><tr><td class='zcs-px-16 zcs-py-8'><strong><%=ifnull(receipt.Product_Name,"Product")%></strong></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(receipt.Serial_Number_Details,"Not set")%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(receipt.Expected_Quantity,0)%> / <%=ifnull(receipt.Received_Quantity,0)%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(receipt.Accepted_Quantity,0)%> / <%=ifnull(receipt.Rejected_Quantity,0)%></td><td class='zcs-px-16 zcs-py-8'><%if(relatedQC.count()==0){%><span class='zcs-badge zcs-badge-filled zcs-badge-yellow zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'>Pending</span><%}else{for each qc in relatedQC{%><strong><%=ifnull(qc.Quality_Result,"Recorded")%></strong><br><span class='zcs-font-12'><%=ifnull(qc.Defect_Details,"No defects recorded")%></span><%}}%></td></tr><%}%></tbody></table></div><%}%></div></section>
<section class='zcs-card section'><div class='section-head'><h2 class='section-title'><i class='zc-li-outline arrows-4-restore'></i>Returns</h2><span class='zcs-badge zcs-badge-filled zcs-badge-orange zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'><%=returns.count()%></span></div><%if(returns.count()==0){%><div class='empty'><i class='zc-li-outline arrows-4-restore'></i>No return requests</div><%}else{%><div class='cards-scroll'><%for each ret in returns{%><div class='record-card'><div class='zcs-flex zcs-justify-space-between zcs-gap-8'><a class='link' href='#Page:Return_Request_Detail?Return_Request_ID=<%=ret.ID%>'><%=ret.Return_Request_ID%></a><span><%=ifnull(ret.Return_Date,"Date not set")%></span></div><div class='record-meta'><span><%=ifnull(ret.Damage_Responsibility,"Responsibility not set")%></span><span><%=Return_Request_Product[Parent_Return_Request==ret.ID].count()%> product lines</span></div><p class='zcs-mb-0'><%=ifnull(ret.Issue_Description,"No issue description")%></p></div><%}%></div><%}%></section>
</div><aside class='stack'>
<section class='zcs-card section'><div class='section-head'><h2 class='section-title'><i class='zc-li-outline users-single-02'></i>Supplier, customer and source</h2></div><div class='kv-grid'><div class='kv'><label>Supplier</label><strong><%=supplierName%></strong></div><div class='kv'><label>Customer</label><strong><%=customerName%></strong></div><div class='kv'><label>Sales order</label><%if(salesOrderID!=null){%><a class='link' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=salesOrderID%>'><%=salesOrderLabel%></a><%}else{%><span>Not set</span><%}%></div><div class='kv'><label>Requirement source</label><span><%=sourceType%></span></div><div class='kv'><label>Source lead</label><span><%=sourceLead%></span></div><div class='kv'><label>Requested delivery</label><span><%=sourceRequestedDate%></span></div><div class='kv'><label>Selected quote</label><strong><%=quoteLabel%></strong></div><div class='kv'><label>Quote date</label><span><%=quoteDate%></span></div><div class='kv'><label>Availability</label><span><%=quoteAvailability%></span></div><div class='kv'><label>Lead time</label><span><%=quoteLeadTime%></span></div></div><div class='kv'><label>Source requirements</label><p class='text-value'><%=sourceRequirements%></p><label>Supplier remarks</label><p class='text-value'><%=quoteRemarks%></p></div><div class='zcs-font-12 zcs-color-tertiary'><%=quoteProducts.count()%> quoted product lines</div></section>
<section class='zcs-card section'><div class='section-head'><h2 class='section-title'><i class='zc-li-outline files-single-copy-04'></i>Invoices and payment</h2><span class='zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'><%=invoices.count()%></span></div><%if(invoices.count()==0){%><div class='empty'><i class='zc-li-outline files-single-copy-04'></i>No supplier invoices</div><%}else{%><div class='cards-scroll'><%for each inv in invoices{invStatus=ifnull(inv.Status,"New");%><div class='record-card'><div class='zcs-flex zcs-justify-space-between zcs-gap-8'><a class='link' href='#Page:Supplier_Invoice_Detail?Supplier_Invoice_ID=<%=inv.ID%>'><%=inv.Supplier_Invoice_ID%></a><span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 <%=if(invStatus=="Paid","zcs-badge-green","zcs-badge-yellow")%>'><%=invStatus%></span></div><div class='record-meta'><span>Invoice: <%=ifnull(inv.Supplier_Invoice_Number,"Not set")%></span><span><%=ifnull(inv.Invoice_Date,"Date not set")%></span><span><%=ifnull(inv.Currency,po.Currency)%> <%=ifnull(inv.Invoice_Amount,0)%></span><span>Paid: <%=ifnull(inv.Paid_Date,"Not yet")%></span><span>Reference: <%=ifnull(inv.Payment_Reference,"Not set")%></span></div><%if(invStatus=="New"){%><p class='zcs-mb-0'><a class='link' href='#Form:Add_Supplier_Invoice?recLinkID=<%=inv.ID%>&amp;viewLinkName=All_Supplier_Invoices&amp;Action_Mode=Mark Paid&amp;zc_LoadIn=dialog'>Mark paid</a></p><%}%></div><%}%></div><%}%></section>
<section class='zcs-card section'><div class='section-head'><h2 class='section-title'><i class='zc-li-outline transport-delivery-fast'></i>Logistics and delivery</h2><span class='zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'><%=bookingLinks.count()%></span></div><%if(bookingLinks.count()==0){%><div class='empty'><i class='zc-li-outline transport-delivery-fast'></i>No logistics booking</div><%}else{%><div class='cards-scroll'><%for each bookingLink in bookingLinks{bookingList=Create_Logistics_Booking[ID==bookingLink.Parent_Logistics_Booking];if(bookingList.count()>0){booking=bookingList;%><div class='record-card'><div class='zcs-flex zcs-justify-space-between zcs-gap-8'><a class='link' href='#Page:Logistics_Booking_Detail?Logistics_Booking_ID=<%=booking.ID%>'><%=booking.Logistics_Booking_ID%></a><span class='zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'><%=ifnull(booking.Status,"New")%></span></div><div class='record-meta'><span><%=ifnull(booking.Logistics_Provider,"Provider not set")%></span><span>Tracking: <%=ifnull(booking.Tracking_Reference,"Not set")%></span><span>Expected: <%=ifnull(booking.Expected_Arrival_Date,"Not set")%></span><span>Actual: <%=ifnull(booking.Actual_Arrival_Date,"Not set")%></span><span>QC lines: <%=qcRows.count()%></span></div></div><%}}%></div><%}%><div class='kv-grid' style='margin-top:12px'><div class='kv'><label>Delivery date</label><span><%=ifnull(po.Delivery_Date,"Not set")%></span></div><div class='kv'><label>Delivered by</label><span><%=deliveredBy%></span></div><div class='kv'><label>Confirmed</label><strong><%=if(po.Delivery_Confirmation==true,"Yes","No")%></strong></div><div class='kv'><label>Remarks</label><span><%=ifnull(po.Delivery_Remarks,"Not set")%></span></div></div></section>
<section class='zcs-card section'><div class='section-head'><h2 class='section-title'><i class='zc-li-outline ui-2-time'></i>Timeline</h2><a class='link' href='#Report:All_Histories?Purchase_Order_Lookup=<%=po.ID%>'>Open history</a></div><%if(histories.count()==0){%><div class='empty'><i class='zc-li-outline ui-2-time'></i>No history entries</div><%}else{%><div class='timeline-scroll zcs-timeline-wrapper'><ul class='zcs-flex zcs-direction-column zcs-gap-24 zcs-p-0 zcs-m-0'><%for each hist in histories{%><li class='zcs-tl-li zcs-relative'><div class='zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute'><span class='zcs-tl-dot zcs-rounded-half zcs-mt-8 zcs-relative'></span></div><div class='timeline-body'><strong><%=ifnull(hist.Action_Type,"Update")%></strong><div class='zcs-font-12 zcs-color-tertiary'><%=ifnull(hist.Updated_Date_Time,"")%> by <%=ifnull(hist.Updated_By_Email,"System")%></div><%if(hist.Comments!=null){%><p class='zcs-mt-8 zcs-mb-0'><%=hist.Comments%></p><%}%></div></li><%}%></ul></div><%}%></section>
</aside></div>
<section class='zcs-card section'><div class='section-head'><h2 class='section-title'><i class='zc-li-outline files-single'></i>Terms and supporting record</h2></div><div class='two-col'><div><div class='kv'><label>Commercial terms</label><p class='text-value'><%=ifnull(po.Commercial_Terms,"Not set")%></p><label>Technical specifications</label><p class='text-value'><%=ifnull(po.Technical_Specifications,"Not set")%></p><label>Additional remarks</label><p class='text-value'><%=ifnull(po.Additional_Remarks,"Not set")%></p></div></div><div class='kv-grid'><div class='kv'><label>Shared with customer</label><strong><%=if(po.Shared_With_Customer==true,"Yes","No")%></strong></div><div class='kv'><label>Shared date</label><span><%=ifnull(po.Shared_With_Customer_Date,"Not set")%></span></div><div class='kv'><label>Approval date</label><span><%=ifnull(po.Customer_Approval_Date,"Not set")%></span></div><div class='kv'><label>Approval comments</label><span><%=ifnull(po.Customer_Approval_Comments,"Not set")%></span></div><div class='kv'><label>PO document</label><a class='link' href='#Report:All_Purchase_Orders?ID=<%=po.ID%>'>Open record</a></div><div class='kv'><label>Delivery evidence</label><span><%=if(po.Delivery_Attachment!=null,"Attached","Not attached")%></span></div></div></div></section>
</div><%}%>
</div></div>