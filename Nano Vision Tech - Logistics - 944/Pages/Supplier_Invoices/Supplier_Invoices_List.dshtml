<%
invoices = Add_Supplier_Invoice[ID != 0] sort by Invoice_Date desc;
newCount = Add_Supplier_Invoice[Status == "New"].count();
paidCount = Add_Supplier_Invoice[Status == "Paid"].count();
reviewCount = invoices.count() - newCount - paidCount;
%>
<style>
/* ZCS global utilities used on this page */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#f3f3f4;--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color)}*{box-sizing:border-box}a{text-decoration:none}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-px-6{padding-left:6px;padding-right:6px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-10{padding-top:10px;padding-bottom:10px}.zcs-py-12{padding-top:12px;padding-bottom:12px}.zcs-p-20{padding:20px}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:10px}.zcs-mt-12{margin-top:12px}.zcs-mb-0{margin-bottom:0}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-rounded-sm{border-radius:4px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-18{font-size:18px}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-tertiary{color:var(--zcs-secondary-text-color)}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-sticky{position:sticky}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}
#splash-screen{display:none!important}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%;width:100%}.zc-container-wrapper .zc-main-content .inner,.zc-page-content-wrapper,.zc-pb-page-content-wrapper,.zc-pb-tile-container,.zc-pb-tile-card{width:100%!important;max-width:none!important}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}
/* horizontal-tab-horizontal-tab-with-count */.zcs-horizontal-tabhead{box-shadow:0 -1px 0 var(--zcs-border-color) inset;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;list-style:none}.zcs-horizontal-tabhead::-webkit-scrollbar{display:none}.zcs-horizontal-tabitem{list-style:none;border-bottom:2px solid transparent;white-space:nowrap}.zcs-horizontal-tablink{cursor:pointer;color:var(--zcs-secondary-text-color)}.zcs-horizontal-tabcount{min-width:20px;background:var(--zcs-page-bg-color)}
/* table-simple-table */.zcs-table-wrapper{height:470px;border:1px solid var(--zcs-border-color);background:var(--zcs-white-color);overflow:auto;border-radius:0 0 10px 10px}.zcs-table-wrapper table{min-width:1180px;line-height:normal;border-collapse:collapse}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:#f9fafe;box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color);vertical-align:top}.zcs-table-wrapper tbody tr:hover td{background:#f9fafe}
/* badge-badge-with-icon */.zcs-badge{width:auto;white-space:nowrap;border:1px solid}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#117c56}.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#8a5d00}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#245dcf}.zcs-badge-orange{background:#f8f0eb;border-color:#f4660c;color:#b84908}.zcs-badge-grey{background:#e8e8e8;border-color:#777;color:#424242}
.invoice-page{min-height:620px;background:var(--zcs-page-bg-color);padding:14px;font:14px/1.45 Arial,sans-serif;color:var(--zcs-primary-text-color)}.register-header{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 16px}.title-wrap{display:flex;align-items:center;gap:10px}.title-icon{display:inline-flex;width:36px;height:36px;align-items:center;justify-content:center;border-radius:8px;background:var(--zcs_component_hover_color);color:var(--zcs-theme-brand-color);font-size:19px}.page-title{font-size:20px;line-height:1.2;font-weight:600;margin:0}.page-subtitle{margin:3px 0 0;color:var(--zcs-secondary-text-color);font-size:13px}.summary-strip{display:flex;gap:8px;flex-wrap:wrap}.summary-item{min-width:92px;padding:7px 10px;border-left:3px solid var(--zcs-border-color);background:#fff}.summary-item.awaiting{border-left-color:#faae13}.summary-item.paid{border-left-color:#179e6c}.summary-value{display:block;font-size:17px;font-weight:600;line-height:1.1}.summary-label{color:var(--zcs-secondary-text-color);font-size:11px}.register-shell{margin-top:10px;overflow:hidden}.tab-input{position:absolute;opacity:0;pointer-events:none}.tab-input:nth-of-type(1):checked~.register-shell .tab-all,.tab-input:nth-of-type(2):checked~.register-shell .tab-new,.tab-input:nth-of-type(3):checked~.register-shell .tab-paid,.tab-input:nth-of-type(4):checked~.register-shell .tab-review{border-bottom-color:var(--zcs-theme-brand-color)}.tab-input:nth-of-type(1):checked~.register-shell .tab-all label,.tab-input:nth-of-type(2):checked~.register-shell .tab-new label,.tab-input:nth-of-type(3):checked~.register-shell .tab-paid label,.tab-input:nth-of-type(4):checked~.register-shell .tab-review label{color:var(--zcs-theme-brand-color)}.invoice-row,.filter-empty{display:none}.tab-input:nth-of-type(1):checked~.register-shell .invoice-row{display:table-row}.tab-input:nth-of-type(2):checked~.register-shell .status-new,.tab-input:nth-of-type(3):checked~.register-shell .status-paid,.tab-input:nth-of-type(4):checked~.register-shell .status-review{display:table-row}.tab-input:nth-of-type(1):checked~.register-shell .empty-all,.tab-input:nth-of-type(2):checked~.register-shell .empty-new,.tab-input:nth-of-type(3):checked~.register-shell .empty-paid,.tab-input:nth-of-type(4):checked~.register-shell .empty-review{display:flex}.primary-link{font-size:14px;font-weight:600;color:var(--zcs-theme-brand-color)}.subtle{display:block;margin-top:3px;color:var(--zcs-secondary-text-color);font-size:12px;overflow-wrap:anywhere}.supplier-name{display:block;font-weight:600}.amount{display:block;font-size:15px;font-weight:600;text-align:right;white-space:nowrap}.order-stack{display:grid;gap:3px}.order-line{display:flex;gap:6px}.order-key{width:22px;color:var(--zcs-secondary-text-color);font-size:11px;font-weight:600}.badge-stack{display:grid;justify-items:start;gap:5px}.evidence{display:grid;gap:2px}.actions{display:flex;align-items:center;gap:6px;justify-content:flex-end;white-space:nowrap}.invoice-action{display:inline-flex;align-items:center;gap:5px;padding:6px 8px;border-radius:5px;color:var(--zcs-theme-brand-color);font-size:12px;font-weight:500}.invoice-action:hover{background:var(--zcs_component_hover_color)}.invoice-action.primary{background:var(--zcs-theme-brand-color);color:var(--zcs_brand_foreground_color)}.zcs-nodata-wrapper{min-height:300px;align-items:center;justify-content:center;text-align:center;background:#fff}.empty-icon{display:inline-flex;width:46px;height:46px;align-items:center;justify-content:center;border-radius:10px;background:#e8efff;color:#2a6ffc;font-size:23px}.zcs-nodata-header{margin:10px 0 0}.zcs-nodata-desc{margin:6px 0 0;color:var(--zcs-secondary-text-color)}.mobile-label{display:none}
@media(max-width:760px){.invoice-page{padding:10px}.register-header{align-items:flex-start;flex-direction:column}.summary-strip{width:100%}.summary-item{flex:1}.zcs-horizontal-tabhead{gap:2px}.zcs-horizontal-tablink{padding-left:8px;padding-right:8px}.zcs-table-wrapper{height:auto;border:0;background:transparent;overflow:visible;padding:10px}.zcs-table-wrapper table,.zcs-table-wrapper thead,.zcs-table-wrapper tbody{display:block;min-width:0;width:100%}.zcs-table-wrapper thead{display:none}.zcs-table-wrapper tbody{display:grid;gap:10px}.tab-input:nth-of-type(1):checked~.register-shell .invoice-row,.tab-input:nth-of-type(2):checked~.register-shell .status-new,.tab-input:nth-of-type(3):checked~.register-shell .status-paid,.tab-input:nth-of-type(4):checked~.register-shell .status-review{display:grid}.invoice-row{grid-template-columns:1fr 1fr;background:#fff;border:1px solid var(--zcs-border-color);border-radius:10px;padding:14px;gap:12px}.zcs-table-wrapper td{display:block!important;border:0!important;padding:0!important}.zcs-table-wrapper td:nth-child(1),.zcs-table-wrapper td:nth-child(2){grid-column:span 1}.zcs-table-wrapper td:nth-child(3),.zcs-table-wrapper td:nth-child(4),.zcs-table-wrapper td:nth-child(5),.zcs-table-wrapper td:nth-child(6){grid-column:1/-1;padding-top:10px!important;border-top:1px solid var(--zcs-border-color)!important}.mobile-label{display:block;margin-bottom:4px;color:var(--zcs-secondary-text-color);font-size:11px;text-transform:uppercase}.amount{text-align:left}.actions{justify-content:flex-start;flex-wrap:wrap}.zcs-nodata-wrapper{min-height:260px}}
@media(max-width:430px){.invoice-row{grid-template-columns:1fr}.zcs-table-wrapper td{grid-column:1!important}.summary-item{min-width:calc(50% - 4px)}}
</style>
<div class='invoice-page'>
<header class='register-header zcs-card'><div class='title-wrap'><span class='title-icon'><i class='zc-li-outline files-single-content-03'></i></span><div><h1 class='page-title'>Supplier invoice register</h1><p class='page-subtitle'>Finance status, order linkage and payment evidence</p></div></div><div class='summary-strip'><div class='summary-item'><span class='summary-value'><%=invoices.count()%></span><span class='summary-label'>Total invoices</span></div><div class='summary-item awaiting'><span class='summary-value'><%=newCount%></span><span class='summary-label'>Awaiting payment</span></div><div class='summary-item paid'><span class='summary-value'><%=paidCount%></span><span class='summary-label'>Paid</span></div><div class='summary-item'><span class='summary-value'><%=reviewCount%></span><span class='summary-label'>Needs review</span></div></div></header>
<input class='tab-input' type='radio' name='invoice-status' id='invoice-all' checked><input class='tab-input' type='radio' name='invoice-status' id='invoice-new'><input class='tab-input' type='radio' name='invoice-status' id='invoice-paid'><input class='tab-input' type='radio' name='invoice-status' id='invoice-review'>
<section class='register-shell zcs-card'><ul class='zcs-horizontal-tabhead zcs-flex zcs-gap-8 zcs-px-10 zcs-m-0'><li class='zcs-horizontal-tabitem tab-all'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium' for='invoice-all'>All <span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12 zcs-text-center'><%=invoices.count()%></span></label></li><li class='zcs-horizontal-tabitem tab-new'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium' for='invoice-new'>Awaiting <span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12 zcs-text-center'><%=newCount%></span></label></li><li class='zcs-horizontal-tabitem tab-paid'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium' for='invoice-paid'>Paid <span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12 zcs-text-center'><%=paidCount%></span></label></li><li class='zcs-horizontal-tabitem tab-review'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium' for='invoice-review'>Review <span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12 zcs-text-center'><%=reviewCount%></span></label></li></ul>
<%if(invoices.count() == 0){%><div class='filter-empty empty-all zcs-nodata-wrapper'><div class='zcs-p-20'><span class='empty-icon'><i class='zc-li-outline files-single-content-03'></i></span><h5 class='zcs-nodata-header zcs-font-18 zcs-font-medium'>No supplier invoices</h5><p class='zcs-nodata-desc'>Invoices will appear here once they are recorded.</p></div></div><%}%>
<%if(newCount == 0){%><div class='filter-empty empty-new zcs-nodata-wrapper'><div class='zcs-p-20'><span class='empty-icon'><i class='zc-li-outline ui-1-check-circle-08'></i></span><h5 class='zcs-nodata-header zcs-font-18 zcs-font-medium'>Nothing awaiting payment</h5><p class='zcs-nodata-desc'>No invoices are currently marked New.</p></div></div><%}%>
<%if(paidCount == 0){%><div class='filter-empty empty-paid zcs-nodata-wrapper'><div class='zcs-p-20'><span class='empty-icon'><i class='zc-li-outline loader-dots-06'></i></span><h5 class='zcs-nodata-header zcs-font-18 zcs-font-medium'>No paid invoices</h5><p class='zcs-nodata-desc'>Paid records appear after payment evidence is captured.</p></div></div><%}%>
<%if(reviewCount == 0){%><div class='filter-empty empty-review zcs-nodata-wrapper'><div class='zcs-p-20'><span class='empty-icon'><i class='zc-li-outline ui-1-check-circle-08'></i></span><h5 class='zcs-nodata-header zcs-font-18 zcs-font-medium'>No statuses need review</h5><p class='zcs-nodata-desc'>Every invoice has a recognized finance status.</p></div></div><%}%>
<%if(invoices.count() > 0){%><div class='zcs-table-wrapper zcs-box-border'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-10 zcs-text-left zcs-font-13 zcs-font-medium'>Invoice</th><th class='zcs-px-16 zcs-py-10 zcs-text-left zcs-font-13 zcs-font-medium'>Supplier</th><th class='zcs-px-16 zcs-py-10 zcs-text-left zcs-font-13 zcs-font-medium'>Order linkage</th><th class='zcs-px-16 zcs-py-10 zcs-text-right zcs-font-13 zcs-font-medium'>Amount</th><th class='zcs-px-16 zcs-py-10 zcs-text-left zcs-font-13 zcs-font-medium'>Finance and evidence</th><th class='zcs-px-16 zcs-py-10 zcs-text-right zcs-font-13 zcs-font-medium'>Actions</th></tr></thead><tbody>
<%for each invoice in invoices { statusValue=ifnull(invoice.Status,"");statusClass="status-review";paymentBadge="zcs-badge-grey";paymentIcon="ui-2-time";paymentLabel="Status not set";if(statusValue == "New"){statusClass="status-new";paymentBadge="zcs-badge-yellow";paymentIcon="loader-dots-06";paymentLabel="Awaiting payment";}else if(statusValue == "Paid"){statusClass="status-paid";paymentBadge="zcs-badge-green";paymentIcon="ui-1-check-circle-08";paymentLabel="Paid";}else if(statusValue != ""){paymentLabel="Review: " + statusValue;}supplierLabel="Not set";if(invoice.Supplier != null){supplierLabel=ifnull(invoice.Supplier.Supplier_Name,"Not set");}poLabel="Not linked";soLabel="Not linked";linksMatch=false;if(invoice.Purchase_Order != null){poLabel=ifnull(invoice.Purchase_Order.Purchase_Order_ID,"Linked PO");}if(invoice.Sales_Order != null){soLabel=ifnull(invoice.Sales_Order.Sales_Order_ID,"Linked SO");}if(invoice.Purchase_Order != null && invoice.Sales_Order != null && invoice.Purchase_Order.Sales_Order == invoice.Sales_Order){linksMatch=true;}verifyBadge="zcs-badge-orange";verifyIcon="ui-2-time";verifyLabel="Linkage needs review";if(linksMatch){verifyBadge="zcs-badge-blue";verifyIcon="ui-1-check-circle-08";verifyLabel="PO and SO verified";}currencyLabel=ifnull(invoice.Currency,"Currency not set");evidenceBadge="zcs-badge-orange";evidenceIcon="ui-2-time";evidenceLabel="Evidence incomplete";if(invoice.Paid_Date != null && ifnull(invoice.Payment_Reference,"") != ""){evidenceBadge="zcs-badge-blue";evidenceIcon="ui-1-check-circle-08";evidenceLabel="Evidence recorded";}%>
<tr class='invoice-row <%=statusClass%>'><td class='zcs-px-16 zcs-py-10'><span class='mobile-label'>Invoice</span><a class='primary-link' href='#Page:Supplier_Invoice_Detail?Supplier_Invoice_ID=<%=invoice.ID%>'>Invoice <%=invoice.Supplier_Invoice_ID%></a><span class='subtle'>Supplier no. <%=ifnull(invoice.Supplier_Invoice_Number,"Not set")%></span><span class='subtle'>Dated <%=ifnull(invoice.Invoice_Date,"Not set")%></span></td><td class='zcs-px-16 zcs-py-10'><span class='mobile-label'>Supplier</span><span class='supplier-name'><%=supplierLabel%></span></td><td class='zcs-px-16 zcs-py-10'><span class='mobile-label'>Order linkage</span><div class='order-stack'><span class='order-line'><span class='order-key'>PO</span><%=poLabel%></span><span class='order-line'><span class='order-key'>SO</span><%=soLabel%></span><span class='zcs-badge zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12 <%=verifyBadge%>'><i class='zc-li-outline <%=verifyIcon%>'></i><%=verifyLabel%></span></div></td><td class='zcs-px-16 zcs-py-10'><span class='mobile-label'>Amount</span><span class='amount'><%=currencyLabel%> <%=ifnull(invoice.Invoice_Amount,0)%></span></td><td class='zcs-px-16 zcs-py-10'><span class='mobile-label'>Finance and evidence</span><div class='badge-stack'><span class='zcs-badge zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12 <%=paymentBadge%>'><i class='zc-li-outline <%=paymentIcon%>'></i><%=paymentLabel%></span><span class='zcs-badge zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12 <%=evidenceBadge%>'><i class='zc-li-outline <%=evidenceIcon%>'></i><%=evidenceLabel%></span></div><div class='evidence'><span class='subtle'>Paid date: <%=ifnull(invoice.Paid_Date,"Not recorded")%></span><span class='subtle'>Reference: <%=ifnull(invoice.Payment_Reference,"Not recorded")%></span></div></td><td class='zcs-px-16 zcs-py-10'><span class='mobile-label'>Actions</span><div class='actions'><a class='invoice-action' href='#Page:Supplier_Invoice_Detail?Supplier_Invoice_ID=<%=invoice.ID%>'><i class='zc-li-outline ui-1-eye-17'></i>Detail</a><%if(statusValue == "New"){%><a class='invoice-action primary' href='#Form:Add_Supplier_Invoice?recLinkID=<%=invoice.ID%>&amp;viewLinkName=All_Supplier_Invoices&amp;Action_Mode=Mark Paid&amp;zc_LoadIn=dialog'><i class='zc-li-outline ui-1-check-circle-08'></i>Mark paid</a><%}%><a class='invoice-action' href='#Report:All_Histories?Supplier_Invoice_Lookup=<%=invoice.ID%>'><i class='zc-li-outline ui-2-time'></i>History</a></div></td></tr>
<%}%>
</tbody></table></div><%}%></section></div>