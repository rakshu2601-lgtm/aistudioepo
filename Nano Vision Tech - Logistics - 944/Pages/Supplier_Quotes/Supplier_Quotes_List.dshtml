<%
quotes = Add_Supplier_Quote[ID != 0] sort by Quote_Date descending;
allCount = quotes.count();
receivedCount = Add_Supplier_Quote[Status == "Received"].count();
selectedCount = Add_Supplier_Quote[Status == "Selected"].count();
rejectedCount = Add_Supplier_Quote[Status == "Rejected"].count();
%>
<style>
/* ZCS utilities used by this page (zcs-global) */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#f5f6f8;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-p-20{padding:1.25rem}.zcs-px-8{padding-left:.5rem;padding-right:.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:.625rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-22{font-size:1.375rem}.zcs-font-medium{font-weight:500}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-sticky{position:sticky}.zcs-relative{position:relative}.zcs-card{background:var(--zcs-white-color);border:1px solid #e5e7ec;border-radius:10px}a{text-decoration:none}
/* ZCS components: header-heading-with-actions, table-simple-table, badge-filled-outlined-badge, card-template-default, no-data-no-data-text-only, small-things-icon-with-text */
.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%;width:100%}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-container,.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{border-radius:0!important;width:100%!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important}#splash-screen{display:none!important}
.quotes-page{width:100%;min-height:100%;padding:14px;background:var(--zcs-page-bg-color);color:var(--zcs-primary-text-color);font:14px/1.45 Arial,sans-serif}.quotes-shell{overflow:hidden}.zcs-page-header{padding:17px 20px;background:#fff;border-bottom:1px solid var(--zcs-border-color)}.title-icon{width:36px;height:36px;border-radius:8px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);font-size:18px;flex:0 0 auto}.header-copy h1{font-size:20px;font-weight:600}.header-copy p{margin:2px 0 0;color:var(--zcs-secondary-text-color);font-size:13px}.register-strip{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:10px 14px;background:#fff;border-bottom:1px solid var(--zcs-border-color);flex-wrap:wrap}.summary{display:flex;align-items:center;gap:6px;flex-wrap:wrap}.summary-item{display:inline-flex;align-items:center;gap:6px;padding:5px 9px;background:#f7f8fb;border:1px solid var(--zcs-border-color);border-radius:6px}.summary-value{font-weight:700;color:var(--zcs-primary-text-color)}.summary-label{font-size:12px;color:var(--zcs-secondary-text-color)}.strip-note{color:var(--zcs-secondary-text-color);font-size:12px}.strip-note i{margin-right:5px;color:var(--zcs-theme-brand-color)}.quotes-body{height:540px;max-height:calc(100vh - 190px);min-height:340px;padding:12px}.zcs-table-wrapper{height:100%;border:1px solid var(--zcs-border-color);background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;line-height:normal;min-width:1050px}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:#f7f8fb;box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap;color:var(--zcs-secondary-text-color);font-size:11px;text-transform:uppercase;letter-spacing:.04em}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color);vertical-align:middle}.zcs-table-wrapper tbody tr:hover td{background:#fafbfc}.primary{font-weight:600;color:var(--zcs-primary-text-color)}.quote-key{color:var(--zcs-theme-brand-color)}.muted{color:var(--zcs-secondary-text-color);font-size:12px;margin-top:2px}.money{font-size:16px;font-weight:700;white-space:nowrap;color:var(--zcs-primary-text-color)}.coverage{display:flex;flex-wrap:wrap;gap:3px;margin-top:4px}.mini{padding:2px 5px;border-radius:4px;background:#f1f2f6;color:var(--zcs-secondary-text-color);font-size:10px}.zcs-badge{width:auto;white-space:nowrap;border:1px solid}.zcs-badge-green{background:#eaf8f2;border-color:#70c4a4;color:#117653}.zcs-badge-red{background:#fceff1;border-color:#e7a6b0;color:#a83043}.zcs-badge-blue{background:#edf3ff;border-color:#a9c2f2;color:#285da8}.zcs-badge-yellow{background:#fff7e8;border-color:#e8c783;color:#8b6518}.ready,.waiting{display:flex;align-items:center;gap:5px;font-weight:600}.ready{color:#117653}.waiting{color:#8b6518}.actions{display:flex;gap:5px}.icon-link{width:30px;height:30px;border:1px solid var(--zcs-border-color);border-radius:6px;color:var(--zcs-secondary-text-color);background:#fff}.icon-link:hover{border-color:var(--zcs-theme-brand-color);color:var(--zcs-theme-brand-color);background:var(--zcs-light-bg-color)}.empty{min-height:300px;text-align:center}.empty i{font-size:28px;color:var(--zcs-theme-brand-color)}
@media(max-width:760px){.quotes-page{padding:8px}.zcs-page-header{padding:14px}.header-copy p{font-size:12px}.register-strip{padding:9px 10px}.strip-note{width:100%}.quotes-body{height:auto;max-height:none;min-height:0;padding:9px}.zcs-table-wrapper{height:auto;border:0;background:transparent;overflow:visible}.zcs-table-wrapper table,.zcs-table-wrapper tbody{display:block;min-width:0}.zcs-table-wrapper thead{display:none}.zcs-table-wrapper tr{display:grid;grid-template-columns:1fr 1fr;margin-bottom:10px;background:#fff;border:1px solid var(--zcs-border-color);border-radius:9px;overflow:hidden}.zcs-table-wrapper td{display:block;padding:9px 11px;border-top:1px solid var(--zcs-border-color);min-width:0}.zcs-table-wrapper td:before{content:attr(data-label);display:block;margin-bottom:3px;color:var(--zcs-secondary-text-color);font-size:9px;font-weight:600;text-transform:uppercase;letter-spacing:.05em}.zcs-table-wrapper td:first-child{grid-column:1/-1;border-top:0}.zcs-table-wrapper td:nth-child(2){grid-column:1/-1}.zcs-table-wrapper td:last-child{grid-column:1/-1}.actions{justify-content:flex-end}}@media(max-width:480px){.summary-item{padding:4px 7px}.zcs-table-wrapper tr{grid-template-columns:1fr}.zcs-table-wrapper td,.zcs-table-wrapper td:first-child,.zcs-table-wrapper td:nth-child(2),.zcs-table-wrapper td:last-child{grid-column:auto}.actions{justify-content:flex-start}}
</style>
<div class='quotes-page zcs-box-border'>
  <section class='quotes-shell zcs-card'>
    <header class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-box-border'>
      <div class='zcs-flex zcs-align-items-center zcs-gap-12'><div class='title-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline files-single'></i></div><div class='header-copy'><h1 class='zcs-m-0'>Supplier quote register</h1><p>Compare supplier response, quoted value, coverage, and selection status.</p></div></div>
    </header>
    <div class='register-strip'><div class='summary'><div class='summary-item'><span class='summary-value'><%=allCount%></span><span class='summary-label'>All</span></div><div class='summary-item'><span class='summary-value'><%=receivedCount%></span><span class='summary-label'>Received</span></div><div class='summary-item'><span class='summary-value'><%=selectedCount%></span><span class='summary-label'>Selected</span></div><div class='summary-item'><span class='summary-value'><%=rejectedCount%></span><span class='summary-label'>Rejected</span></div></div><div class='strip-note'><i class='zc-li-outline ui-1-filter'></i>Status overview; newest responses first</div></div>
    <div class='quotes-body'>
    <% if(allCount == 0){ %>
      <div class='empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center'><div class='zcs-p-20'><i class='zc-li-outline files-single'></i><h5 class='zcs-font-18 zcs-font-medium zcs-mt-10 zcs-mb-0'>No supplier quotes</h5><p class='zcs-color-secondary'>Responses will appear here when supplier quotes are recorded.</p></div></div>
    <% } else { %>
      <div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-12 zcs-py-8 zcs-text-left'>Quote / order</th><th class='zcs-px-12 zcs-py-8 zcs-text-left'>Supplier</th><th class='zcs-px-12 zcs-py-8 zcs-text-left'>Response</th><th class='zcs-px-12 zcs-py-8 zcs-text-right'>Quoted value</th><th class='zcs-px-12 zcs-py-8 zcs-text-left'>Coverage</th><th class='zcs-px-12 zcs-py-8 zcs-text-left'>Status</th><th class='zcs-px-12 zcs-py-8 zcs-text-left'>Comparison</th><th class='zcs-px-12 zcs-py-8 zcs-text-left'>Open</th></tr></thead><tbody>
      <% for each quote in quotes {
        items = Supplier_Quote_Product[Parent_Supplier_Quote == quote.ID];
        lineCount = items.count();
        totalPrice = ifnull(items.sum(Supplier_Total_Price),0);
        exactCount = Supplier_Quote_Product[Parent_Supplier_Quote == quote.ID && Configuration_Match == "Exact Match"].count();
        partialCount = Supplier_Quote_Product[Parent_Supplier_Quote == quote.ID && (Configuration_Match == "Partial Match" || Configuration_Match == "Alternative")].count();
        mismatchCount = Supplier_Quote_Product[Parent_Supplier_Quote == quote.ID && Configuration_Match == "Does Not Match"].count();
        orderQuoteCount = 0;
        orderLabel = "Not linked";
        orderID = 0;
        if(quote.Sales_Order != null){orderQuoteCount = Add_Supplier_Quote[Sales_Order == quote.Sales_Order].count(); orderLabel = ifnull(quote.Sales_Order.Sales_Order_ID,"Unlabelled order"); orderID = quote.Sales_Order.ID;}
        supplierLabel = "Supplier not recorded";
        if(quote.Supplier != null){supplierLabel = ifnull(quote.Supplier.Supplier_Name,"Unnamed supplier");}
        quoteLabel = ifnull(quote.Supplier_Quote_ID,"Quote " + quote.ID);
        currencyLabel = ifnull(quote.Currency,"Currency not set");
        statusLabel = ifnull(quote.Status,"Status not set");
        quoteDateLabel = ifnull(quote.Quote_Date,"Not recorded");
        availabilityLabel = ifnull(quote.Availability,"Not specified");
        leadLabel = ifnull(quote.Lead_Time,"Not specified");
        badgeClass = "zcs-badge-blue";
        if(statusLabel == "Selected"){badgeClass = "zcs-badge-green";}else if(statusLabel == "Rejected"){badgeClass = "zcs-badge-red";}else if(statusLabel == "Status not set"){badgeClass = "zcs-badge-yellow";}
        comparisonReady = orderQuoteCount > 1 && lineCount > 0;
      %>
        <tr><td data-label='Quote / order' class='zcs-px-12 zcs-py-10'><div class='primary quote-key'><%=quoteLabel%></div><div class='muted'><i class='zc-li-outline e-commerce-delivery-fast'></i> <%=orderLabel%></div></td><td data-label='Supplier' class='zcs-px-12 zcs-py-10'><div class='primary'><%=supplierLabel%></div><div class='muted'><%=ifnull(quote.Dispatch_Location,"Dispatch location not set")%></div></td><td data-label='Response' class='zcs-px-12 zcs-py-10'><div><i class='zc-li-outline ui-1-calendar-60'></i> <%=quoteDateLabel%></div><div class='muted'>Availability: <%=availabilityLabel%></div><div class='muted'>Lead: <%=leadLabel%></div></td><td data-label='Quoted value' class='zcs-px-12 zcs-py-10 zcs-text-right'><div class='money'><%=currencyLabel%> <%=totalPrice%></div><div class='muted'><%=lineCount%> line items</div></td><td data-label='Coverage' class='zcs-px-12 zcs-py-10'><div class='primary'><%=lineCount%> configurations</div><div class='coverage'><span class='mini'><%=exactCount%> exact</span><span class='mini'><%=partialCount%> partial</span><span class='mini'><%=mismatchCount%> unmatched</span></div></td><td data-label='Status' class='zcs-px-12 zcs-py-10'><span class='zcs-badge zcs-badge-filled-outline <%=badgeClass%> zcs-inline-flex zcs-align-items-center zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=statusLabel%></span></td><td data-label='Comparison' class='zcs-px-12 zcs-py-10'><% if(comparisonReady){ %><div class='ready'><i class='zc-li-outline ui-1-check-circle-08'></i><span>Ready</span></div><div class='muted'><%=orderQuoteCount%> order quotes</div><% } else if(orderID == 0){ %><div class='waiting'><i class='zc-li-outline ui-2-link-72'></i><span>Order required</span></div><div class='muted'>Cannot compare</div><% } else if(lineCount == 0){ %><div class='waiting'><i class='zc-li-outline files-single'></i><span>Items required</span></div><div class='muted'><%=orderQuoteCount%> quote(s)</div><% } else { %><div class='waiting'><i class='zc-li-outline ui-2-time'></i><span>Awaiting response</span></div><div class='muted'>1 order quote</div><% } %></td><td data-label='Open' class='zcs-px-12 zcs-py-10'><div class='actions'><a title='Quote detail' aria-label='Quote detail' class='icon-link zcs-flex zcs-align-items-center zcs-justify-center' href='#Report:All_Supplier_Quotes?ID=<%=quote.ID%>&amp;zc_LoadIn=dialog'><i class='zc-li-outline ui-1-eye-17'></i></a><% if(orderID != 0){ %><a title='Quote comparison' aria-label='Quote comparison' class='icon-link zcs-flex zcs-align-items-center zcs-justify-center' href='#Page:Quote_Comparison?Sales_Order_ID=<%=orderID%>'><i class='zc-li-outline design-app'></i></a><% } %></div></td></tr>
      <% } %></tbody></table></div>
    <% } %>
    </div>
  </section>
</div>