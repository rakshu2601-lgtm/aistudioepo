<%
bookingList = Create_Logistics_Booking[ID == input.Logistics_Booking_ID];
%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color,#6147E5);--zcs-light-bg-color:var(--zcs_brand_light_color,#f1edff);--zcs-page-bg-color:#f5f6f8;--zcs-primary-text-color:var(--zcs_primary_text_color,#1c1c40);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#65657a);--zcs-border-color:var(--zcs_tertiary_border_color,#e3e7ef);--zcs-white-color:#fff;--column-gap:0px}*{box-sizing:border-box}html,body{width:100%;margin:0}#splash-screen{display:none!important}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%;width:100%}.zc-pb-page-content-wrapper .zc-pb-tile-container,.zc-pb-page-content-wrapper .zc-pb-tile-card{padding:0!important;border-radius:0!important;box-shadow:none!important}.zcs-flex,.zcs-row{display:flex}.zcs-row{flex-wrap:wrap}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-row-wrap{flex-wrap:wrap}.zcs-gap-4{gap:4px}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-gap-24{gap:24px}.zcs-p-0{padding:0}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:8px}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-half{border-radius:50%}.zcs-font-12{font-size:12px}.zcs-font-14{font-size:14px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-tertiary{color:var(--zcs-secondary-text-color)}.zcs-color-red{color:#c9344d}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:10px;box-shadow:0 1px 2px rgba(28,28,64,.035)}.zcs-button{width:auto;min-width:0;min-height:32px;text-decoration:none}.zcs-primary-button{background:var(--zcs_brand_color,#6147E5);color:var(--zcs_brand_foreground_color,#fff)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color,#6147E5);background:#fff;color:var(--zcs_brand_color,#6147E5)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color,#f1edff)}.zcs-button-icon{width:16px}.zcs-badge{width:max-content;white-space:nowrap;border:1px solid;font-size:12px}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#116d50}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#2458bf}.zcs-badge-yellow{background:#fff4d8;border-color:#d88b00;color:#775000}.zcs-badge-red{background:#fde3e6;border-color:#d83a52;color:#a62539}.detail{min-height:100%;width:100%;overflow:auto;background:var(--zcs-page-bg-color);padding:14px;font:14px/1.42 Arial,sans-serif;color:var(--zcs-primary-text-color)}.stack{display:flex;flex-direction:column;gap:12px;max-width:1580px;margin:auto}.hero{padding:14px 16px;background:#fff;border:1px solid var(--zcs-border-color);border-radius:10px}.hero h1{font-size:21px;font-weight:650;margin:2px 0;color:var(--zcs-primary-text-color)}.hero a{text-decoration:none}.hero-copy{color:var(--zcs-secondary-text-color);font-size:13px}.back-link{color:var(--zcs-secondary-text-color);font-size:12px;font-weight:600}.hero-icon{width:38px;height:38px;border-radius:9px;background:var(--zcs-light-bg-color);color:var(--zcs_brand_color,#6147E5);font-size:19px}.actions{justify-content:flex-end}.workflow-actions{padding:10px 12px}.workflow-label{font-size:12px;color:var(--zcs-secondary-text-color);font-weight:600;text-transform:uppercase;letter-spacing:.04em}.section-title{font-size:15px;font-weight:650;margin:0 0 10px}.info-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px 18px}.kv{min-width:0}.kv label{display:block;color:var(--zcs-secondary-text-color);font-size:11px;margin-bottom:2px;text-transform:uppercase;letter-spacing:.03em}.kv strong,.kv span{display:block;overflow-wrap:anywhere}.summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.summary{padding:12px 14px;border:1px solid var(--zcs-border-color);border-radius:9px;background:#fff}.summary label{display:block;color:var(--zcs-secondary-text-color);font-size:11px}.summary strong{font-size:18px}.milestones{padding:12px 18px}.milestone-list{display:grid;grid-template-columns:repeat(5,1fr);margin:0;padding:0;list-style:none}.milestone{text-align:center;position:relative;color:var(--zcs-secondary-text-color)}.milestone:not(:last-child):before{content:'';position:absolute;top:13px;left:50%;width:100%;height:2px;background:var(--zcs-border-color)}.milestone.done:not(:last-child):before{background:#179e6c}.milestone-dot{position:relative;z-index:1;width:27px;height:27px;margin:0 auto 5px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#fff;border:2px solid var(--zcs-border-color);font-size:12px}.milestone.done .milestone-dot{background:#179e6c;border-color:#179e6c;color:#fff}.milestone.current .milestone-dot{border-color:var(--zcs_brand_color,#6147E5);color:var(--zcs_brand_color,#6147E5);box-shadow:0 0 0 3px var(--zcs-light-bg-color)}.milestone span{font-size:11px;font-weight:600}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:12px}.empty{min-height:120px;padding:24px;text-align:center;color:var(--zcs-secondary-text-color);background:#fafbfe;border:1px dashed var(--zcs-border-color);border-radius:8px;display:flex;flex-direction:column;align-items:center;justify-content:center}.empty i{display:block;font-size:23px;color:var(--zcs_brand_color,#6147E5);margin-bottom:6px}.empty h3,.empty p{margin:4px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:10px}.section-count{font-size:11px;color:var(--zcs-secondary-text-color);font-weight:500}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:#fff;overflow:auto;border-radius:7px;height:310px}.zcs-table-wrapper table{border-collapse:collapse;min-width:900px}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:#f7f8fc;box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap;font-size:12px;font-weight:600}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color);vertical-align:top;font-size:13px}.zcs-table-wrapper tbody tr:hover td{background:#fafbfe}.mobile-list{display:none;height:310px;overflow:auto}.record-card{padding:12px;border:1px solid var(--zcs-border-color);border-radius:7px}.record-card h4{margin:0 0 6px}.record-meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;color:var(--zcs-secondary-text-color);font-size:12px}.text-block{white-space:pre-wrap;overflow-wrap:anywhere}.docs{display:flex;flex-wrap:wrap;gap:8px}.doc{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--zcs-border-color);border-radius:7px;color:var(--zcs-primary-text-color);text-decoration:none}.link{color:var(--zcs_brand_color,#6147E5);font-weight:600;text-decoration:none}.exception-strip{border-left:3px solid #d83a52!important}.timeline-content{padding-left:44px}.timeline-scroll{height:260px;overflow:auto;padding-right:6px}.zcs-tl-indicator{width:34px;left:0}.zcs-tl-dot{width:10px;height:10px;background:var(--zcs_brand_color,#6147E5);border:1px solid #fff;box-shadow:0 2px 6px #c4dee4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:'';position:absolute;width:1px;height:calc(100% + 24px);background:#e1e1e1;top:6px}@media(max-width:1000px){.info-grid,.summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.two-col{grid-template-columns:1fr}.hero-row{align-items:flex-start}.workflow-actions>div{align-items:flex-start;flex-direction:column}.actions{justify-content:flex-start;width:100%}}@media(max-width:620px){.detail{height:auto;padding:9px}.hero{padding:12px}.hero h1{font-size:18px}.hero-icon{display:none}.info-grid,.summary-grid{grid-template-columns:1fr}.actions .zcs-button{flex:1 1 calc(50% - 8px)}.zcs-table-wrapper{display:none}.mobile-list{display:flex}.zcs-card{padding:12px!important}.timeline-content{padding-left:36px}.milestone-list{grid-template-columns:1fr;gap:10px}.milestone{display:flex;align-items:center;gap:9px;text-align:left}.milestone:not(:last-child):before{top:22px;left:13px;width:2px;height:calc(100% + 10px)}.milestone-dot{margin:0}.milestone span{font-size:12px}}
</style>
<div class='detail'>
<%if(bookingList.count() == 0){%>
  <div class='zcs-card empty'><i class='zc-li-outline ui-1-search-zoom-out zcs-font-24'></i><h3>Logistics booking not found</h3><p>No accessible record matches this Logistics_Booking_ID.</p><a class='link' href='#Page:Logistics_Bookings'>Back to bookings</a></div>
<%}else{ b=bookingList; poRows=Logistics_Booking_Purchase_Order[Parent_Logistics_Booking == b.ID]; products=Logistics_Booking_Product[Parent_Logistics_Booking == b.ID]; qcRows=Logistics_Quality_Check_Product[Parent_Logistics_Booking == b.ID]; histories=Add_History[Logistics_Booking_Lookup == b.ID] sort by Updated_Date_Time desc; expectedTotal=0; receivedTotal=0; damagedTotal=0; acceptedTotal=0; rejectedTotal=0; inspectedTotal=0; receiptComplete=true; receiptBalanced=true; for each rp in products { expectedTotal=expectedTotal + ifnull(rp.Expected_Quantity,0); receivedTotal=receivedTotal + ifnull(rp.Received_Quantity,0); damagedTotal=damagedTotal + ifnull(rp.Damaged_Quantity,0); acceptedTotal=acceptedTotal + ifnull(rp.Accepted_Quantity,0); rejectedTotal=rejectedTotal + ifnull(rp.Rejected_Quantity,0); if(ifnull(rp.Received_Quantity,0) < ifnull(rp.Expected_Quantity,0)){receiptComplete=false;} if(ifnull(rp.Accepted_Quantity,0) + ifnull(rp.Rejected_Quantity,0) != ifnull(rp.Received_Quantity,0)){receiptBalanced=false;} } if(products.count()==0){receiptComplete=false;receiptBalanced=false;} qcComplete=true; qcExceptions=0; if(qcRows.count()==0){qcComplete=false;} for each qcr in qcRows { inspectedTotal=inspectedTotal + ifnull(qcr.Inspected_Quantity,0); if(qcr.Quality_Result == null || ifnull(qcr.Inspected_Quantity,0) < ifnull(qcr.Received_Quantity,0)){qcComplete=false;} if(qcr.Quality_Result == "Failed" || qcr.Quality_Result == "Partially Passed" || ifnull(qcr.Rejected_Quantity,0) > 0 || qcr.Defect_Details != null){qcExceptions=qcExceptions + 1;} } if(inspectedTotal < receivedTotal){qcComplete=false;} canAddPO=(b.Status == "New" && Create_Purchase_Order[Status == "Invoice Paid"].count() > poRows.count()); canReceipt=(b.Status == "New" && poRows.count()>0 && products.count()>0 && receiptComplete==false); canQC=(b.Status == "New" && receivedTotal>0 && qcComplete==false); canMark=(b.Status == "New" && receiptComplete && receiptBalanced && qcComplete);%>
<div class='stack'>
<header class='hero'><div class='hero-row zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16'><div class='zcs-flex zcs-align-items-center zcs-gap-12'><div class='hero-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline transport-delivery-fast'></i></div><div><a class='back-link' href='#Page:Logistics_Bookings'><i class='zc-li-outline arrows-1-tail-left'></i> Logistics bookings</a><div class='zcs-flex zcs-align-items-center zcs-gap-8 zcs-row-wrap'><h1><%=b.Logistics_Booking_ID%></h1><span class='zcs-badge zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-sm zcs-px-10 zcs-py-2 <%=if(b.Status=="Products Received","zcs-badge-green","zcs-badge-blue")%>'><i class='zc-li-outline <%=if(b.Status=="Products Received","ui-1-check-circle-08","loader-dots-06")%>'></i><%=b.Status%></span></div><div class='hero-copy'><%=ifnull(b.Logistics_Provider,"Provider not set")%> | <%=ifnull(b.Warehouse_Destination,"Destination not set")%> | Tracking <%=ifnull(b.Tracking_Reference,"not set")%></div></div></div><%if(histories.count()>0){%><a class='link zcs-font-12' href='#Report:All_Histories?Logistics_Booking_Lookup=<%=b.ID%>'><i class='zc-li-outline ui-2-time'></i> History</a><%}%></div></header><%if(canAddPO || canReceipt || canQC || canMark){%><section class='zcs-card workflow-actions'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><span class='workflow-label'>Next available action</span><div class='actions zcs-flex zcs-row-wrap zcs-gap-8'><%if(canAddPO){%><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Form:Create_Logistics_Booking?recLinkID=<%=b.ID%>&amp;viewLinkName=All_Logistics_Bookings&amp;Action_Mode=Add PO&amp;zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline ui-1-circle-add'></i><span>Add PO</span></a><%}%><%if(canReceipt){%><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Form:Create_Logistics_Booking?recLinkID=<%=b.ID%>&amp;viewLinkName=All_Logistics_Bookings&amp;Action_Mode=Receipt&amp;zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline transport-delivery-fast'></i><span>Record receipt</span></a><%}%><%if(canQC){%><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Form:Create_Logistics_Booking?recLinkID=<%=b.ID%>&amp;viewLinkName=All_Logistics_Bookings&amp;Action_Mode=QC&amp;zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline ui-1-check-circle-08'></i><span>Run QC</span></a><%}%><%if(canMark){%><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Form:Create_Logistics_Booking?recLinkID=<%=b.ID%>&amp;viewLinkName=All_Logistics_Bookings&amp;Action_Mode=Products Received&amp;zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline ui-1-check-circle-08'></i><span>Mark received</span></a><%}%></div></div></section><%}%>
<section class='zcs-card milestones'><h2 class='section-title'>Shipment milestones</h2><ul class='milestone-list'><li class='milestone done'><div class='milestone-dot'><i class='zc-li-outline ui-1-check-small'></i></div><span>Booked</span></li><li class='milestone <%=if(poRows.count()>0,"done","current")%>'><div class='milestone-dot'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i></div><span>PO linked</span></li><li class='milestone <%=if(receivedTotal>0,"done",if(poRows.count()>0,"current",""))%>'><div class='milestone-dot'><i class='zc-li-outline transport-delivery-fast'></i></div><span>Received</span></li><li class='milestone <%=if(qcComplete,"done",if(receivedTotal>0,"current",""))%>'><div class='milestone-dot'><i class='zc-li-outline ui-1-check-circle-08'></i></div><span>Quality checked</span></li><li class='milestone <%=if(b.Status=="Products Received","done",if(canMark,"current",""))%>'><div class='milestone-dot'><i class='zc-li-outline ui-1-check-small'></i></div><span>Completed</span></li></ul></section>
<section class='zcs-card zcs-p-20'><div class='section-head' style='margin-bottom:12px'><h2 class='section-title' style='margin:0'><i class='zc-li-outline ui-1-calendar-57'></i> Shipment information</h2><span class='section-count'>Booking record</span></div><div class='info-grid'><div class='kv'><label>Booking date</label><strong><%=ifnull(b.Booking_Date,"Not set")%></strong></div><div class='kv'><label>Provider</label><strong><%=ifnull(b.Logistics_Provider,"Not set")%></strong></div><div class='kv'><label>Pickup location</label><span><%=ifnull(b.Pickup_Location,"Not set")%></span></div><div class='kv'><label>Warehouse destination</label><span><%=ifnull(b.Warehouse_Destination,"Not set")%></span></div><div class='kv'><label>Expected arrival</label><span><%=ifnull(b.Expected_Arrival_Date,"Not set")%></span></div><div class='kv'><label>Actual arrival</label><span><%=ifnull(b.Actual_Arrival_Date,"Not set")%></span></div><div class='kv'><label>Tracking reference</label><span><%=ifnull(b.Tracking_Reference,"Not set")%></span></div><div class='kv'><label>Suppliers</label><span><%=ifnull(b.Suppliers,"Not set")%></span></div></div></section>
<section class='summary-grid'><div class='summary'><label>Linked purchase orders</label><strong><%=poRows.count()%></strong></div><div class='summary'><label>Expected / received</label><strong><%=expectedTotal%> / <%=receivedTotal%></strong></div><div class='summary'><label>Inspected / damaged</label><strong><%=inspectedTotal%> / <%=damagedTotal%></strong></div><div class='summary'><label>Accepted / rejected</label><strong><%=acceptedTotal%> / <%=rejectedTotal%></strong></div></section><%if(receivedTotal > expectedTotal || receiptBalanced==false || qcExceptions>0){%><section class='zcs-card zcs-p-16 exception-strip'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><span class='zcs-badge zcs-badge-red zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-sm zcs-px-10 zcs-py-2'><i class='zc-li-outline ui-2-alert-circle'></i> Exception</span><strong>Receiving review required</strong></div><p class='zcs-mb-0'><%if(receivedTotal > expectedTotal){%>Received quantity exceeds expected quantity. <%}%><%if(receiptBalanced==false){%>Accepted and rejected quantities do not reconcile to received quantities. <%}%><%if(qcExceptions>0){%><%=qcExceptions%> QC finding(s) include defects, rejection, or a non-passing result.<%}%></p></section><%}%>
<section class='zcs-card zcs-p-20'><div class='section-head'><h2 class='section-title'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i> Linked purchase orders</h2><span class='section-count'><%=poRows.count()%> linked</span></div><%if(poRows.count()==0){%><div class='empty'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i><strong>No purchase orders linked</strong><span>Link an eligible paid purchase order to begin receiving.</span></div><%}else{%><div class='zcs-table-wrapper'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Purchase order</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Supplier</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Sales order</th><th class='zcs-px-16 zcs-py-8'>PO date</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Amount</th><th class='zcs-px-16 zcs-py-8'>Invoice paid</th><th class='zcs-px-16 zcs-py-8'>Remarks</th></tr></thead><tbody><%for each po in poRows{%><tr><td class='zcs-px-16 zcs-py-8'><%if(po.Purchase_Order != null){%><a class='link' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=po.Purchase_Order.ID%>'><%=po.Purchase_Order.Purchase_Order_ID%></a><%}else{%>Not linked<%}%></td><td class='zcs-px-16 zcs-py-8'><%if(po.Supplier != null){%><%=po.Supplier.Supplier_Name%><%}else{%>Not set<%}%></td><td class='zcs-px-16 zcs-py-8'><%if(po.Sales_Order != null){%><a class='link' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=po.Sales_Order.ID%>'><%=po.Sales_Order.Sales_Order_ID%></a><%}else{%>Not linked<%}%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(po.Purchase_Order_Date,"Not set")%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=ifnull(po.Currency,"")%> <%=ifnull(po.Purchase_Order_Amount,0)%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(po.Invoice_Paid_Date,"Not set")%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(po.Remarks,"")%></td></tr><%}%></tbody></table></div><div class='mobile-list zcs-direction-column zcs-gap-12'><%for each pom in poRows{%><div class='record-card'><h4><%if(pom.Purchase_Order != null){%><a class='link' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=pom.Purchase_Order.ID%>'><%=pom.Purchase_Order.Purchase_Order_ID%></a><%}else{%>Purchase order not linked<%}%></h4><div class='record-meta'><span><%if(pom.Supplier != null){%><%=pom.Supplier.Supplier_Name%><%}else{%>Supplier not set<%}%></span><span><%=ifnull(pom.Currency,"")%> <%=ifnull(pom.Purchase_Order_Amount,0)%></span><span>PO: <%=ifnull(pom.Purchase_Order_Date,"Not set")%></span><span>Paid: <%=ifnull(pom.Invoice_Paid_Date,"Not set")%></span></div></div><%}%></div><%}%></section>
<section class='zcs-card zcs-p-20'><div class='section-head'><h2 class='section-title'><i class='zc-li-outline transport-delivery-fast'></i> Products and receiving</h2><span class='section-count'><%=products.count()%> product rows</span></div><%if(products.count()==0){%><div class='empty'><i class='zc-li-outline transport-delivery-fast'></i><strong>No products ready for receiving</strong><span>Product, serial and receipt quantities will appear here.</span></div><%}else{%><div class='zcs-table-wrapper'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8'>Product</th><th class='zcs-px-16 zcs-py-8'>PO / supplier</th><th class='zcs-px-16 zcs-py-8'>Configuration</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Expected</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Received</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Damaged</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Accepted / rejected</th><th class='zcs-px-16 zcs-py-8'>Serials and remarks</th></tr></thead><tbody><%for each p in products{%><tr><td class='zcs-px-16 zcs-py-8'><strong><%=p.Product_Name%></strong><br><span class='zcs-font-12 zcs-color-tertiary'><%=ifnull(p.Product_ID,"")%> | <%=ifnull(p.Brand_Make,"")%> <%=ifnull(p.Model,"")%><br><%=ifnull(p.Manufacturer_Part_Number,"")%></span></td><td class='zcs-px-16 zcs-py-8'><%=p.Purchase_Order.Purchase_Order_ID%><br><%=ifnull(p.Supplier.Supplier_Name,"Not set")%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(p.Configuration,"Not set")%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=ifnull(p.Expected_Quantity,0)%> <%=ifnull(p.Unit_of_Measure,"")%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=ifnull(p.Received_Quantity,0)%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=ifnull(p.Damaged_Quantity,0)%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=ifnull(p.Accepted_Quantity,0)%> / <%=ifnull(p.Rejected_Quantity,0)%></td><td class='zcs-px-16 zcs-py-8'><strong><%=ifnull(p.Serial_Number_Details,"No serials")%></strong><br><%=ifnull(p.Receiving_Remarks,"")%></td></tr><%}%></tbody></table></div><div class='mobile-list zcs-direction-column zcs-gap-12'><%for each pm in products{%><div class='record-card'><h4><%=pm.Product_Name%></h4><div class='record-meta'><span>Expected: <%=ifnull(pm.Expected_Quantity,0)%></span><span>Received: <%=ifnull(pm.Received_Quantity,0)%></span><span>Accepted: <%=ifnull(pm.Accepted_Quantity,0)%></span><span>Rejected: <%=ifnull(pm.Rejected_Quantity,0)%></span></div><p><strong>Serials:</strong> <%=ifnull(pm.Serial_Number_Details,"Not set")%></p><p><%=ifnull(pm.Receiving_Remarks,"")%></p></div><%}%></div><%}%></section>
<section class='zcs-card zcs-p-20'><div class='section-head'><h2 class='section-title'><i class='zc-li-outline ui-1-check-circle-08'></i> Quality control</h2><span class='section-count'><%=qcRows.count()%> checks | <%=qcExceptions%> exceptions</span></div><%if(qcRows.count()==0){%><div class='empty'><i class='zc-li-outline ui-1-check-circle-08'></i><strong>No quality checks recorded</strong><span>QC results and defect findings will appear after receiving begins.</span></div><%}else{%><div class='zcs-table-wrapper'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8'>Product / serial</th><th class='zcs-px-16 zcs-py-8'>PO</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Received / inspected</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Accepted / rejected</th><th class='zcs-px-16 zcs-py-8'>Result</th><th class='zcs-px-16 zcs-py-8'>Defects</th><th class='zcs-px-16 zcs-py-8'>Remarks</th></tr></thead><tbody><%for each qc in qcRows{qcb="zcs-badge-yellow";if(qc.Quality_Result=="Passed"){qcb="zcs-badge-green";}else if(qc.Quality_Result=="Failed"){qcb="zcs-badge-red";}%><tr><td class='zcs-px-16 zcs-py-8'><strong><%=qc.Product_Name%></strong><br><span class='zcs-font-12 zcs-color-tertiary'><%=ifnull(qc.Brand_Make,"")%> <%=ifnull(qc.Model,"")%> | <%=ifnull(qc.Serial_Number,"No serial")%></span></td><td class='zcs-px-16 zcs-py-8'><%=qc.Purchase_Order.Purchase_Order_ID%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=ifnull(qc.Received_Quantity,0)%> / <%=ifnull(qc.Inspected_Quantity,0)%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=ifnull(qc.Accepted_Quantity,0)%> / <%=ifnull(qc.Rejected_Quantity,0)%></td><td class='zcs-px-16 zcs-py-8'><span class='zcs-badge zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-sm zcs-px-10 zcs-py-2 <%=qcb%>'><i class='zc-li-outline <%=if(qc.Quality_Result=="Passed","ui-1-check-circle-08",if(qc.Quality_Result=="Failed","ui-1-circle-remove","ui-2-alert-circle"))%>'></i><%=ifnull(qc.Quality_Result,"Pending")%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(qc.Defect_Details,"No defects recorded")%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(qc.Inspection_Remarks,"")%></td></tr><%}%></tbody></table></div><div class='mobile-list zcs-direction-column zcs-gap-12'><%for each qcm in qcRows{%><div class='record-card'><h4><%=qcm.Product_Name%> | <%=ifnull(qcm.Quality_Result,"Pending")%></h4><div class='record-meta'><span>Inspected: <%=ifnull(qcm.Inspected_Quantity,0)%></span><span>Accepted: <%=ifnull(qcm.Accepted_Quantity,0)%></span><span>Rejected: <%=ifnull(qcm.Rejected_Quantity,0)%></span><span>Serial: <%=ifnull(qcm.Serial_Number,"Not set")%></span></div><p><strong>Defects:</strong> <%=ifnull(qcm.Defect_Details,"None recorded")%></p></div><%}%></div><%}%></section>
<div class='two-col'><section class='zcs-card zcs-p-20'><h2 class='section-title'>Receiving and quality team</h2><div class='info-grid' style='grid-template-columns:repeat(2,minmax(0,1fr))'><div class='kv'><label>Received by</label><strong><%=ifnull(b.Received_By.Employee_Name,"Not set")%></strong></div><div class='kv'><label>Received date</label><span><%=ifnull(b.Received_Date,"Not set")%></span></div><div class='kv'><label>Quality checked by</label><strong><%=ifnull(b.Quality_Checked_By.Employee_Name,"Not set")%></strong></div><div class='kv'><label>Quality check date</label><span><%=ifnull(b.Quality_Check_Date,"Not set")%></span></div></div><div class='kv'><label>Quality check summary</label><p class='text-block'><%=ifnull(b.Quality_Check_Summary,"Not set")%></p></div><div class='kv'><label>Receiving remarks</label><p class='text-block'><%=ifnull(b.Receiving_Remarks,"Not set")%></p></div></section><section class='zcs-card zcs-p-20'><h2 class='section-title'>Documents and completion</h2><div class='docs'><%if(b.Transport_Documents != null){%><a class='doc' href='#Report:All_Logistics_Bookings?ID=<%=b.ID%>'><i class='zc-li-outline files-single'></i><span>Transport documents</span></a><%}else{%><div class='empty'>No transport document uploaded</div><%}%></div><p class='zcs-color-tertiary'><%if(canMark){%>Receipt quantities and QC results are complete. The booking can be marked received.<%}else if(b.Status=="Products Received"){%>Receipt and QC are completed.<%}else{%>Mark Received becomes available when every product is fully received and quality results cover inspected quantities.<%}%></p></section></div>
<section class='zcs-card zcs-p-20'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12' style='margin-bottom:18px'><h2 class='section-title' style='margin:0'>Booking history</h2><a class='link' href='#Report:All_Histories?Logistics_Booking_Lookup=<%=b.ID%>'>Open report</a></div><%if(histories.count()==0){%><div class='empty'>No history entries</div><%}else{%><div class='timeline-scroll'><ul class='zcs-flex zcs-direction-column zcs-gap-24 zcs-p-0 zcs-m-0'><%for each h in histories{%><li class='zcs-tl-li zcs-relative' style='list-style:none'><div class='zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute'><span class='zcs-tl-dot zcs-rounded-half zcs-mt-8 zcs-relative'></span></div><div class='timeline-content'><div class='zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8'><strong class='zcs-font-16'><%=h.Action_Type%></strong><%if(h.Status != null || h.New_Status != null){%><span class='zcs-badge zcs-badge-blue zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'><%=ifnull(h.New_Status,h.Status)%></span><%}%></div><div class='zcs-font-12 zcs-color-tertiary'><%=h.Updated_Date_Time%> by <%=ifnull(h.Updated_By.Employee_Name,h.Updated_By_Email)%><%if(h.Previous_Status != null){%> | <%=h.Previous_Status%> to <%=ifnull(h.New_Status,h.Status)%><%}%></div><%if(h.Comments != null){%><p class='zcs-mt-8 zcs-mb-0'><%=h.Comments%></p><%}%><%if(h.Subform_Details_Change_Summary != null){%><p class='zcs-mt-8 zcs-mb-0 zcs-color-tertiary'><%=h.Subform_Details_Change_Summary%></p><%}%></div></li><%}%></ul></div><%}%></section>
</div><%}%>
</div>