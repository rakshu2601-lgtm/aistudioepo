<%
orders = Create_Sales_Order[ID == input.Sales_Order_ID];
products = Sales_Order_Product[ID == 0];
%>
<style>
/* ZCS global utility sheet: page-scoped subset used by this snippet */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-row-wrap{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-px-60{padding-left:3.75rem;padding-right:3.75rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-5{margin-top:.3125rem}.zcs-mt-8{margin-top:.5rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-22{font-size:1.375rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-card{background:#fff;border:1px solid #e7e7ee;border-radius:12px}.zcs-button{width:auto;min-width:5rem;min-height:36px;text-decoration:none}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}.zcs-badge{width:auto;white-space:nowrap}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-theme{background:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-green{background:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-red{background:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-yellow{background:#FCF4E6;border-color:#FAAE13;color:#A06309}.zcs-badge-blue{background:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-orange{background:#F8F0EB;border-color:#F4660C;color:#F4660C}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:1280px}.zcs-table-wrapper thead{top:0}.zcs-table-wrapper th{background:#F9FAFE;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper tr:hover td{background:#F9FAFE}.zcs-notes-text a:hover{text-decoration:underline}.zcs-timeline-wrapper ul{list-style:none}.zcs-tl-li{position:relative;padding-left:30px}.zcs-tl-li:before{content:'';position:absolute;left:5px;top:7px;width:10px;height:10px;border-radius:50%;background:var(--zcs_brand_color)}.zcs-tl-li:not(:last-child):after{content:'';position:absolute;left:9px;top:18px;width:1px;height:calc(100% + 24px);background:#E1E1E1}
.qc-page{width:100%;min-height:100vh;box-sizing:border-box;padding:16px;background:var(--zcs-page-bg-color);font:14px/1.45 Arial,sans-serif;color:var(--zcs-primary-text-color)}.qc-shell{width:100%;max-width:1760px;margin:0 auto}.qc-header,.qc-section{padding:16px 18px}.qc-header{position:sticky;top:0;z-index:8;border-color:var(--zcs_tertiary_border_color);box-shadow:0 5px 18px rgba(20,25,45,.07)}.qc-eyebrow,.qc-label{color:var(--zcs-teritiary-text-color);font-size:11px;font-weight:700;letter-spacing:.045em;text-transform:uppercase}.qc-title{margin:0;font-size:21px;font-weight:700;line-height:1.25}.qc-header .zcs-badge{margin-left:8px;vertical-align:middle}.qc-actions{display:flex;flex-wrap:wrap;gap:8px}.qc-summary{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}.qc-summary>div,.qc-decision>div{min-width:0;padding:10px 12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:8px;background:#F9FAFE}.qc-value{font-weight:700;overflow-wrap:anywhere}.qc-copy{white-space:pre-wrap;overflow-wrap:anywhere}.qc-section-title{margin:0;font-size:16px;font-weight:700}.qc-selector-input{position:absolute;opacity:0;pointer-events:none}.qc-selector{display:flex;flex-wrap:wrap;gap:7px}.qc-selector label{display:inline-flex;align-items:center;gap:7px;padding:8px 11px;border:1px solid var(--zcs_tertiary_border_color);border-radius:7px;background:#fff;color:var(--zcs-primary-text-color);cursor:pointer;transition:border-color .15s ease,background .15s ease}.qc-selector label:before{content:'';width:11px;height:11px;border:2px solid var(--zcs_tertiary_border_color);border-radius:50%;box-sizing:border-box}.qc-comparison{display:none}.qc-offer-card{display:none}.qc-highlight{display:inline-flex;align-items:center;margin-top:6px;padding:2px 7px;border:1px solid #179e6c;border-radius:999px;background:#e4fcf3;color:#126e4d;font-size:10px;font-weight:700;white-space:nowrap}.qc-highlight:before{content:'1';display:inline-grid;place-items:center;width:15px;height:15px;margin-right:5px;border-radius:50%;background:#179e6c;color:#fff;font-size:9px}.qc-config{min-width:230px}.qc-price{font-size:14px;font-weight:700;white-space:nowrap}.qc-attach{display:inline-flex;align-items:center;gap:5px;color:var(--zcs_brand_color);overflow-wrap:anywhere}.qc-mobile{display:none}.qc-mobile-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.qc-empty{padding:28px;text-align:center;color:var(--zcs-teritiary-text-color);border:1px dashed var(--zcs_tertiary_border_color);border-radius:10px;background:#F9FAFE}.qc-empty i{display:block;font-size:28px;margin-bottom:8px;color:var(--zcs_brand_color)}.qc-decision{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.qc-sheet{color:var(--zcs_brand_color);font-weight:700}.qc-state-note{padding:10px 12px;border:1px solid #9ee4c9;background:#eafaf4;color:#126e4d;border-radius:8px}.qc-history-scroll{height:260px;overflow:auto;padding-right:8px}.zcs-table-wrapper{height:230px;max-height:230px;border-color:var(--zcs_tertiary_border_color)}.qc-comparison .zcs-table-wrapper{height:390px;max-height:390px}.zcs-table-wrapper table{min-width:1380px}.zcs-table-wrapper thead{z-index:2}.zcs-table-wrapper th{font-size:11px;text-transform:uppercase;letter-spacing:.035em}.zcs-table-wrapper td{font-size:13px}.zcs-table-wrapper tbody td:first-child strong{display:inline-block;padding:2px 7px;border:1px solid var(--zcs_brand_color);border-radius:999px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:12px}.zcs-badge{white-space:nowrap}.zcs-progress-bar{height:6px;background:var(--zcs_component_hover_color)}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}#splash-screen,.zc-page-loader{display:none!important}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper,.zc-pb-page-content-wrapper,.zc-pb-tile-container,.zc-pb-tile-card{width:100%!important;max-width:none!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important;border-radius:0!important}@media(max-width:992px){.qc-summary{grid-template-columns:repeat(3,minmax(0,1fr))}.qc-decision{grid-template-columns:1fr}.qc-page{padding:12px}.qc-header{position:static}}@media(max-width:700px){.qc-page{padding:8px}.qc-header,.qc-section{padding:14px}.qc-title{font-size:19px}.qc-summary{grid-template-columns:1fr 1fr}.qc-actions{width:100%}.qc-actions .zcs-button{flex:1;min-width:42px}.qc-actions .zcs-button-text{display:none}.qc-desktop{display:none}.qc-mobile{display:flex;flex-direction:column;gap:10px;height:560px;max-height:560px;overflow:auto}.qc-offer-card{display:block;padding:14px}.qc-mobile-grid{grid-template-columns:1fr 1fr}.qc-selector{flex-wrap:nowrap;overflow:auto;padding-bottom:3px}.qc-selector label{white-space:nowrap}.qc-comparison{padding:14px}.qc-history-scroll{height:240px}}@media(max-width:440px){.qc-summary,.qc-mobile-grid{grid-template-columns:1fr}.qc-page{padding:6px}}
<% for each productStyle in products { %>#qc-product-<%=productStyle.ID%>:checked ~ .qc-shell .qc-label-<%=productStyle.ID%>{border-color:var(--zcs_brand_color);background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-weight:700}#qc-product-<%=productStyle.ID%>:checked ~ .qc-shell .qc-label-<%=productStyle.ID%>:before{border-color:var(--zcs_brand_color);box-shadow:inset 0 0 0 2px #fff;background:var(--zcs_brand_color)}#qc-product-<%=productStyle.ID%>:checked ~ .qc-shell .qc-product-<%=productStyle.ID%>{display:block}<% } %>
</style>
<div class='qc-page'>
<% if(orders.count() == 0) { %>
<div class='zcs-card qc-empty'><i class='zc-li-outline ui-1-circle-remove'></i><h2 class='zcs-font-18 zcs-m-0'>Sales order not found</h2><p>No accessible record matches this Sales_Order_ID.</p><a class='zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Page:Sales_Orders'>Back to sales orders</a></div>
<% } else { order = orders; products = Sales_Order_Product[Parent_Sales_Order == order.ID]; quotes = Add_Supplier_Quote[Sales_Order == order.ID] sort by Quote_Date desc; histories = Add_History[Sales_Order_Lookup == order.ID] sort by Updated_Date_Time desc; pos = Create_Purchase_Order[Sales_Order == order.ID]; firstProduct = 0; if(products.count() > 0) { firstProduct = products.ID.get(0); } %>
<% for each productRadio in products { %><input class='qc-selector-input' type='radio' name='qc-product' id='qc-product-<%=productRadio.ID%>' <% if(productRadio.ID == firstProduct) { %>checked<% } %>><% } %>
<div class='qc-shell zcs-flex zcs-direction-column zcs-gap-16'>
<header class='zcs-card qc-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-row-wrap zcs-gap-16'>
<div><div class='qc-eyebrow'>Quote comparison</div><h1 class='qc-title'><%=ifnull(order.Sales_Order_ID,"Sales order")%></h1><div class='zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-mt-8'><%=order.Status%></div></div>
<div class='qc-actions'>
<% if(order.Selected_Supplier_Quote != null && pos.count() == 0) { %><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border' href='#Form:Create_Purchase_Order?Sales_Order=<%=order.ID%>&amp;Selected_Supplier_Quote=<%=order.Selected_Supplier_Quote.ID%>&amp;zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline ui-1-simple-add'></i><span class='zcs-button-text'>Create PO</span></a><% } %>
<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border' href='#Page:History?Sales_Order_ID=<%=order.ID%>'><i class='zcs-button-icon zc-li-outline ui-2-time'></i><span class='zcs-button-text'>History</span></a>
</div></header>
<section class='zcs-card qc-section'><div class='qc-summary'><div><div class='qc-label'>Customer</div><div class='qc-value'><%=if(order.Customer != null,order.Customer.Customer_Name,"Not specified")%></div></div><div><div class='qc-label'>Requirement source</div><div class='qc-value'><%=ifnull(order.Requirement_Source,"Not specified")%></div></div><div><div class='qc-label'>Order date</div><div class='qc-value'><%=ifnull(order.Sales_Order_Date,"Not specified")%></div></div><div><div class='qc-label'>Requested delivery</div><div class='qc-value'><%=ifnull(order.Requested_Delivery_Date,"Not specified")%></div></div><div><div class='qc-label'>Coverage</div><div class='qc-value'><%=products.count()%> requirements · <%=quotes.count()%> quotes</div></div></div><div class='qc-copy zcs-mt-8'><span class='qc-label'>Customer requirements</span><br><%=ifnull(order.Customer_Requirements,"Not specified")%></div><% if(products.count() > 0) { %><div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative zcs-mt-8'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Required product</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Configuration</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Quantity</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Availability / lead time</th></tr></thead><tbody><% for each requirement in products { %><tr><td class='zcs-px-16 zcs-py-12'><strong><%=requirement.Product_Name%></strong><div class='zcs-color-tertiary'><%=ifnull(requirement.Brand_Make,"")%> <%=ifnull(requirement.Model,"")%></div></td><td class='zcs-px-16 zcs-py-12 qc-copy'><%=ifnull(requirement.Configuration,ifnull(requirement.Technical_Requirements,"Not specified"))%></td><td class='zcs-px-16 zcs-py-12 zcs-text-right'><%=requirement.Quantity%> <%=ifnull(requirement.Unit_of_Measure,"")%></td><td class='zcs-px-16 zcs-py-12'><%=ifnull(requirement.Required_Availability,"Not specified")%><div class='zcs-color-tertiary'><%=ifnull(requirement.Required_Lead_Time,"Lead time not specified")%></div></td></tr><% } %></tbody></table></div><% } %></section>
<% if(quotes.count() == 0) { %><section class='zcs-card qc-section'><div class='qc-empty'><i class='zc-li-outline business-handshake'></i><h2 class='zcs-font-18 zcs-m-0'>No supplier quotes yet</h2><p>Requirements are ready, but no supplier response can be compared.</p><a class='zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=order.ID%>'>Review sourcing status</a></div></section><% } else { %><section class='zcs-card qc-section'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><h2 class='qc-section-title'>Select product</h2><span class='zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=products.count()%> products</span></div><div class='qc-selector zcs-mt-8'><% for each productLabel in products { %><label class='qc-label-<%=productLabel.ID%>' for='qc-product-<%=productLabel.ID%>'><%=productLabel.Product_Name%><span class='zcs-color-tertiary'>x <%=productLabel.Quantity%></span></label><% } %></div></section>
<% for each productRow in products { offers = Supplier_Quote_Product[Sales_Order_Product == productRow.ID] sort by Supplier_Unit_Price asc; lowestId = 0; bestAvailabilityId = 0; shortestLeadId = 0; if(offers.count() > 0) { lowestId = offers.ID.get(0); availabilityOffers = Supplier_Quote_Product[Sales_Order_Product == productRow.ID] sort by Availability asc; bestAvailabilityId = availabilityOffers.ID.get(0); leadOffers = Supplier_Quote_Product[Sales_Order_Product == productRow.ID] sort by Lead_Time asc; shortestLeadId = leadOffers.ID.get(0); } %>
<section class='zcs-card qc-section qc-comparison qc-product-<%=productRow.ID%>'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><div><h2 class='qc-section-title'><%=productRow.Product_Name%></h2><div class='zcs-color-tertiary'><%=ifnull(productRow.Brand_Make,"")%> <%=ifnull(productRow.Model,"")%> · Requested <%=productRow.Quantity%> <%=ifnull(productRow.Unit_of_Measure,"")%></div></div><span class='zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=offers.count()%> offers</span></div>
<% if(offers.count() == 0) { %><div class='qc-empty zcs-mt-8'>No supplier offer was submitted for this product.</div><% } else { %>
<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative zcs-mt-8 qc-desktop'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Supplier / Quote</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Requested configuration</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Offered configuration</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Match</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Quantity</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Unit price</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Total price</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Availability</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Lead time</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Dispatch / Remarks</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Attachment</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Actions</th></tr></thead><tbody>
<% for each offer in offers { quote = Add_Supplier_Quote[ID == offer.Parent_Supplier_Quote]; variance = offer.Quoted_Quantity - productRow.Quantity; badgeClass = "zcs-badge-yellow"; if(offer.Configuration_Match == "Exact Match" && variance >= 0) { badgeClass = "zcs-badge-green"; } else if(offer.Configuration_Match == "Does Not Match" || variance < 0) { badgeClass = "zcs-badge-red"; } else if(offer.Configuration_Match == "Alternative") { badgeClass = "zcs-badge-orange"; } %><tr><td class='zcs-px-16 zcs-py-12'><strong><%=if(quote.Supplier != null,quote.Supplier.Supplier_Name,"Supplier")%></strong><br><span class='zcs-color-tertiary'><%=quote.Supplier_Quote_ID%> · <%=quote.Status%></span></td><td class='zcs-px-16 zcs-py-12 qc-config qc-copy'><%=ifnull(offer.Requested_Configuration,"Not specified")%></td><td class='zcs-px-16 zcs-py-12 qc-config qc-copy'><%=ifnull(offer.Offered_Configuration,"Not specified")%></td><td class='zcs-px-16 zcs-py-12'><span class='zcs-badge zcs-badge-filled-outline <%=badgeClass%> zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=ifnull(offer.Configuration_Match,"Not assessed")%></span><div class='zcs-font-12 zcs-mt-5 <% if(variance < 0) { %>zcs-color-red<% } else { %>zcs-color-secondary<% } %>'>Quantity variance: <%=variance%></div></td><td class='zcs-px-16 zcs-py-12 zcs-text-right'><%=offer.Quoted_Quantity%> <%=ifnull(offer.Unit_of_Measure,"")%></td><td class='zcs-px-16 zcs-py-12 zcs-text-right'><span class='qc-price'><%=ifnull(offer.Currency,ifnull(quote.Currency,"Currency not set"))%> <%=offer.Supplier_Unit_Price%></span><% if(offer.ID == lowestId) { %><span class='qc-highlight'>Lowest price</span><% } %></td><td class='zcs-px-16 zcs-py-12 zcs-text-right'><span class='qc-price'><%=ifnull(offer.Currency,ifnull(quote.Currency,"Currency not set"))%> <%=offer.Supplier_Total_Price%></span></td><td class='zcs-px-16 zcs-py-12'><%=ifnull(offer.Availability,ifnull(quote.Availability,"Not specified"))%><% if(offer.ID == bestAvailabilityId) { %><span class='qc-highlight'>Best availability</span><% } %></td><td class='zcs-px-16 zcs-py-12'><%=ifnull(offer.Lead_Time,ifnull(quote.Lead_Time,"Not specified"))%><% if(offer.ID == shortestLeadId) { %><span class='qc-highlight'>Shortest lead</span><% } %></td><td class='zcs-px-16 zcs-py-12'><strong><%=ifnull(offer.Dispatch_Location,ifnull(quote.Dispatch_Location,"Not specified"))%></strong><div class='qc-copy zcs-color-tertiary'><%=ifnull(offer.Remarks,ifnull(quote.Supplier_Remarks,"No remarks"))%></div></td><td class='zcs-px-16 zcs-py-12'><% if(quote.Quote_Attachment != null) { %><span class='qc-attach'><i class='zc-li-outline files-single'></i><%=quote.Quote_Attachment%></span><% } else { %><span class='zcs-color-tertiary'>None</span><% } %></td><td class='zcs-px-16 zcs-py-12'><div class='zcs-flex zcs-direction-column zcs-gap-6'><% if(order.Selected_Supplier_Quote == null && quote.Status == "Received") { %><a class='zcs-custom-btn zcs-px-10 zcs-py-6 zcs-rounded-sm' href='#Form:Create_Sales_Order?recLinkID=<%=order.ID%>&amp;viewLinkName=All_Sales_Orders&amp;Recommended_Supplier=<%=quote.Supplier.ID%>&amp;Action_Mode=Recommend Supplier&amp;zc_LoadIn=dialog'>Recommend</a><a class='zcs-custom-btn zcs-px-10 zcs-py-6 zcs-rounded-sm' href='#Form:Create_Sales_Order?recLinkID=<%=order.ID%>&amp;viewLinkName=All_Sales_Orders&amp;Selected_Supplier_Quote=<%=quote.ID%>&amp;Action_Mode=Select Quote&amp;zc_LoadIn=dialog'>Select</a><% } %></div></td></tr><% } %></tbody></table></div>
<div class='qc-mobile'><% for each offerCard in offers { quoteCard = Add_Supplier_Quote[ID == offerCard.Parent_Supplier_Quote]; varianceCard = offerCard.Quoted_Quantity - productRow.Quantity; badgeCard = "zcs-badge-yellow"; if(offerCard.Configuration_Match == "Exact Match" && varianceCard >= 0) { badgeCard = "zcs-badge-green"; } else if(offerCard.Configuration_Match == "Does Not Match" || varianceCard < 0) { badgeCard = "zcs-badge-red"; } %><article class='zcs-card qc-offer-card'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><div><strong><%=if(quoteCard.Supplier != null,quoteCard.Supplier.Supplier_Name,"Supplier")%></strong><div class='zcs-color-tertiary'><%=quoteCard.Supplier_Quote_ID%></div></div><span class='zcs-badge zcs-badge-filled-outline <%=badgeCard%> zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=ifnull(offerCard.Configuration_Match,"Not assessed")%></span></div><div class='qc-mobile-grid zcs-mt-8'><div><div class='qc-label'>Requested configuration</div><div class='qc-copy'><%=ifnull(offerCard.Requested_Configuration,"Not specified")%></div></div><div><div class='qc-label'>Offered configuration</div><div class='qc-copy'><%=ifnull(offerCard.Offered_Configuration,"Not specified")%></div></div><div><div class='qc-label'>Quantity / variance</div><div class='qc-value'><%=offerCard.Quoted_Quantity%> <%=ifnull(offerCard.Unit_of_Measure,"")%> · <%=varianceCard%></div></div><div><div class='qc-label'>Unit / total price</div><div class='qc-value'><%=ifnull(offerCard.Currency,ifnull(quoteCard.Currency,"Currency not set"))%> <%=offerCard.Supplier_Unit_Price%> / <%=ifnull(offerCard.Currency,ifnull(quoteCard.Currency,"Currency not set"))%> <%=offerCard.Supplier_Total_Price%></div><% if(offerCard.ID == lowestId) { %><span class='qc-highlight'>Lowest price</span><% } %></div><div><div class='qc-label'>Availability</div><div><%=ifnull(offerCard.Availability,ifnull(quoteCard.Availability,"Not specified"))%></div></div><div><div class='qc-label'>Lead time</div><div><%=ifnull(offerCard.Lead_Time,ifnull(quoteCard.Lead_Time,"Not specified"))%></div></div></div><div class='qc-label zcs-mt-8'>Remarks</div><div class='qc-copy'><%=ifnull(offerCard.Remarks,ifnull(quoteCard.Supplier_Remarks,"No remarks"))%></div><% if(order.Selected_Supplier_Quote == null && quoteCard.Status == "Received") { %><div class='zcs-flex zcs-gap-8 zcs-mt-8'><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Form:Create_Sales_Order?recLinkID=<%=order.ID%>&amp;viewLinkName=All_Sales_Orders&amp;Recommended_Supplier=<%=quoteCard.Supplier.ID%>&amp;Action_Mode=Recommend Supplier&amp;zc_LoadIn=dialog'>Recommend</a><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Form:Create_Sales_Order?recLinkID=<%=order.ID%>&amp;viewLinkName=All_Sales_Orders&amp;Selected_Supplier_Quote=<%=quoteCard.ID%>&amp;Action_Mode=Select Quote&amp;zc_LoadIn=dialog'>Select</a></div><% } %></article><% } %></div><% } %></section><% } %>
<section class='zcs-card qc-section'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-row-wrap zcs-gap-8'><h2 class='qc-section-title'>Recommendation and selection</h2><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border' href='#Form:Create_Sales_Order?recLinkID=<%=order.ID%>&amp;viewLinkName=All_Sales_Orders&amp;zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline ui-1-edit-72'></i><span>Comparison remarks and sheet</span></a></div><div class='qc-decision zcs-mt-8'><div><div class='qc-label'>Recommended supplier</div><div class='qc-value'><%=if(order.Recommended_Supplier != null,order.Recommended_Supplier.Supplier_Name,"Not recommended")%></div></div><div><div class='qc-label'>Selected supplier quote</div><div class='qc-value'><%=if(order.Selected_Supplier_Quote != null,order.Selected_Supplier_Quote.Supplier_Quote_ID,"Not selected")%></div></div><div><div class='qc-label'>Comparison sheet</div><div class='qc-sheet'><i class='zc-li-outline files-single'></i> <%=ifnull(order.Comparison_Sheet,"No sheet uploaded")%></div></div></div><div class='zcs-notes-wrapper zcs-mt-8'><p class='zcs-notes-text zcs-m-0 zcs-font-14 zcs-font-normal'><span class='zcs-color-tertiary zcs-font-medium'>Comparison remarks: </span><span class='qc-copy'><%=ifnull(order.Comparison_Remarks,"No comparison remarks")%></span></p></div><% if(order.Selected_Supplier_Quote != null) { %><div class='qc-state-note zcs-mt-8'><i class='zc-li-outline ui-1-check-circle-08'></i> Selection recorded. Purchase order creation is available while no purchase order exists.</div><% } %></section>
<section class='zcs-card qc-section'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between'><h2 class='qc-section-title'>Related history</h2><span class='zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=histories.count()%> events</span></div><div class='qc-history-scroll zcs-mt-8'><% if(histories.count() == 0) { %><div class='qc-empty'>No history entries.</div><% } else { %><div class='zcs-timeline-wrapper'><ul class='zcs-flex zcs-direction-column zcs-gap-24 zcs-p-0 zcs-m-0'><% for each historyRow in histories { %><li class='zcs-tl-li'><div class='zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8'><h6 class='zcs-font-16 zcs-font-semibold zcs-m-0'><%=historyRow.Action_Type%></h6><span class='zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=ifnull(historyRow.New_Status,ifnull(historyRow.Status,"Recorded"))%></span></div><div class='zcs-font-13 zcs-color-tertiary'><%=historyRow.Updated_Date_Time%> · <%=if(historyRow.Updated_By != null,historyRow.Updated_By.Employee_Name,ifnull(historyRow.Updated_By_Email,"System"))%></div><% if(historyRow.Previous_Status != null || historyRow.New_Status != null) { %><div class='zcs-mt-8'><%=ifnull(historyRow.Previous_Status,"")%> to <%=ifnull(historyRow.New_Status,"")%></div><% } %><% if(historyRow.Comments != null) { %><div class='qc-copy'><%=historyRow.Comments%></div><% } %><% if(historyRow.Subform_Details_Change_Summary != null) { %><div class='qc-copy zcs-color-secondary'><%=historyRow.Subform_Details_Change_Summary%></div><% } %></li><% } %></ul></div><% } %></div></section>
</div><% } %><% } %></div>