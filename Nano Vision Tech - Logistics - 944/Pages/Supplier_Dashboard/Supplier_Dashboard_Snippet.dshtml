<%
loginEmail = zoho.loginuserid;
activeSuppliers = Add_Supplier[Email == loginEmail && Active == true];
supplierCount = activeSuppliers.count();
identityReady = supplierCount == 1;
supplierId = 0;
supplierName = "Supplier";
if(identityReady)
{
    for each supplierRec in activeSuppliers
    {
        supplierId = supplierRec.ID;
        supplierName = supplierRec.Supplier_Name;
    }
}
openRequests = Create_Sales_Order[ID == 0];
myQuotes = Add_Supplier_Quote[ID == 0];
myPOs = Create_Purchase_Order[ID == 0];
myInvoices = Add_Supplier_Invoice[ID == 0];
quotesDue = 0;
activeDeliveries = 0;
unpaidInvoices = 0;
exceptionCount = 0;
if(identityReady)
{
    openRequests = Create_Sales_Order[(Status == "New" || Status == "Quotes Received") && (Recommended_Supplier == null || Recommended_Supplier == supplierId)] sort by Requested_Delivery_Date asc;
    myQuotes = Add_Supplier_Quote[Supplier == supplierId] sort by Quote_Date descending;
    myPOs = Create_Purchase_Order[Supplier == supplierId] sort by Expected_Delivery_Date asc;
    myInvoices = Add_Supplier_Invoice[Supplier == supplierId] sort by Invoice_Date descending;
    for each requestRec in openRequests
    {
        requestQuote = Add_Supplier_Quote[Supplier == supplierId && Sales_Order == requestRec.ID];
        if(requestQuote.count() == 0)
        {
            quotesDue = quotesDue + 1;
        }
    }
    for each poCalc in myPOs
    {
        calcStatus = ifnull(poCalc.Status,"New");
        if(calcStatus != "Products Received" && calcStatus != "Delivered")
        {
            activeDeliveries = activeDeliveries + 1;
            if(poCalc.Expected_Delivery_Date != null && poCalc.Expected_Delivery_Date < zoho.currentdate)
            {
                exceptionCount = exceptionCount + 1;
            }
        }
    }
    for each invCalc in myInvoices
    {
        if(ifnull(invCalc.Status,"New") != "Paid")
        {
            unpaidInvoices = unpaidInvoices + 1;
        }
    }
}
%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:.625rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-medium{font-weight:500}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-sticky{position:sticky}a{text-decoration:none}
.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%;width:100%}.zc-container-wrapper .zc-main-content .inner,.zc-page-content-wrapper,.zc-pb-page-content-wrapper,.zc-pb-tile-container,.zc-pb-tile-card{max-width:none!important;width:100%!important}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}#splash-screen,.zc-page-loader{display:none!important}
.zcs-table-wrapper{border:0;background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;line-height:normal;min-width:600px}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:#f8f7fc;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap;color:var(--zcs_secondary_text_color);font-size:12px;text-transform:uppercase;letter-spacing:.03em}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper tbody tr:hover td{background:#faf9fd}.zcs-badge{width:auto;border:1px solid;font-size:12px;white-space:nowrap}.zcs-badge-theme{background:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#167c59}.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#c52e45}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#245bcc}.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#946200}.zcs-badge-orange{background:#f8f0eb;border-color:#f4660c;color:#b64b08}.zcs-badge-grey{background:#eee;border-color:#666;color:#444}.zcs-progress-bar{height:6px;background:var(--zcs_component_hover_color);border-radius:4px;overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}
.supplier-home{min-height:100%;padding:18px;background:#f6f5f9;color:var(--zcs_primary_text_color);font:14px/1.45 Arial,sans-serif;box-sizing:border-box}.workspace-intro{margin-bottom:12px}.workspace-intro h1{margin:0;font-size:24px}.workspace-intro p{margin:3px 0 0;color:var(--zcs_secondary_text_color)}.summary-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;margin-bottom:12px}.summary-card{position:relative;overflow:hidden;padding:11px 12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:9px;background:#fff}.summary-card:before{position:absolute;content:"";inset:0 auto 0 0;width:3px;background:#7557b8}.summary-icon{color:#7557b8;font-size:15px}.summary-label{color:var(--zcs_secondary_text_color);font-size:11px;text-transform:uppercase;letter-spacing:.04em}.summary-value{margin-top:2px;font-size:20px;font-weight:700}.summary-sub{color:var(--zcs_secondary_text_color);font-size:11px}.summary-card.warn:before{background:#d58a16}.summary-card.danger:before{background:#d84a60}.summary-card.good:before{background:#179e6c}.workspace-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.panel-card{min-width:0;overflow:hidden;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;background:#fff}.panel-head{height:62px;padding:10px 13px;border-bottom:1px solid var(--zcs_tertiary_border_color);box-sizing:border-box}.panel-icon{width:30px;height:30px;flex:0 0 30px;border-radius:8px;background:#f0ebfa;color:#694aa9;font-size:15px}.panel-title{margin:0;font-size:15px}.panel-note{color:var(--zcs_secondary_text_color);font-size:11px}.panel-count{min-width:22px;padding:2px 7px;border-radius:12px;background:#f0ebfa;color:#694aa9;text-align:center;font-weight:700}.panel-scroll{height:286px;overflow:auto}.empty{height:100%;min-height:250px}.empty i{font-size:22px;color:#9b8dbb}.empty h5{margin:8px 0 0}.empty p{margin:3px 0;color:var(--zcs_secondary_text_color)}.record-link{color:#6846a7;font-weight:600}.muted{color:var(--zcs_secondary_text_color);font-size:12px}.queue{padding:8px}.queue-item{padding:10px;border:1px solid var(--zcs_tertiary_border_color);border-radius:8px}.queue-item+.queue-item{margin-top:7px}.queue-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}.queue-meta{display:grid;grid-template-columns:86px 1fr;gap:4px 8px;margin-top:7px;font-size:12px}.queue-meta span:nth-child(odd){color:var(--zcs_secondary_text_color)}.progress-copy{display:flex;justify-content:space-between;gap:8px;margin-top:7px;font-size:11px;color:var(--zcs_secondary_text_color)}.identity-state{max-width:720px;margin:44px auto;padding:32px;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;background:#fff;text-align:center}.identity-state i{font-size:32px;color:#7557b8}.identity-state p{color:var(--zcs_secondary_text_color)}.action-link{display:inline-flex;align-items:center;gap:6px;padding:6px 9px;border-radius:6px;background:#7557b8;color:#fff;font-size:12px;font-weight:600}
@media(max-width:1180px){.summary-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:900px){.workspace-grid{grid-template-columns:1fr}}@media(max-width:620px){.supplier-home{padding:10px}.summary-grid{grid-template-columns:repeat(2,1fr)}.panel-scroll{height:320px}.desktop-table{display:none}.workspace-intro h1{font-size:21px}}@media(min-width:621px){.mobile-queue{display:none}}
</style>
<div class='supplier-home'>
  <div class='workspace-intro'><h1>Supplier workspace</h1><p><%if(identityReady){%><strong><%=supplierName%></strong> | <%}%><%=loginEmail%></p><p>Requests, commercial responses, order commitments, invoices, and delivery risk at a glance.</p></div>
  <%if(!identityReady){%>
    <section class='identity-state'><i class='zc-li-outline ui-2-alert-circle'></i><%if(supplierCount == 0){%><h2>No active supplier account found</h2><p>This login is not linked to an active supplier record. Contact your portal administrator to verify <strong><%=loginEmail%></strong>.</p><%}else{%><h2>Supplier account needs review</h2><p>More than one active supplier record uses <strong><%=loginEmail%></strong>. For your privacy, no supplier data is shown until an administrator resolves the duplicate records.</p><%}%></section>
  <%}else{%>
    <section class='summary-grid'>
      <div class='summary-card warn'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between'><span class='summary-label'>RFQs awaiting quote</span><i class='summary-icon zc-li-outline files-archive-drawer'></i></div><div class='summary-value'><%=quotesDue%></div><div class='summary-sub'><%=openRequests.count()%> eligible requests</div></div>
      <div class='summary-card'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between'><span class='summary-label'>Quotes</span><i class='summary-icon zc-li-outline ui-1-edit-72'></i></div><div class='summary-value'><%=myQuotes.count()%></div><div class='summary-sub'>Submitted responses</div></div>
      <div class='summary-card'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between'><span class='summary-label'>Purchase orders</span><i class='summary-icon zc-li-outline e-commerce-shopping-cart-simple'></i></div><div class='summary-value'><%=myPOs.count()%></div><div class='summary-sub'>All assigned orders</div></div>
      <div class='summary-card warn'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between'><span class='summary-label'>Unpaid invoices</span><i class='summary-icon zc-li-outline files-single-copy-04'></i></div><div class='summary-value'><%=unpaidInvoices%></div><div class='summary-sub'><%=myInvoices.count()%> total invoices</div></div>
      <div class='summary-card good'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between'><span class='summary-label'>Delivery obligations</span><i class='summary-icon zc-li-outline transportation-truck'></i></div><div class='summary-value'><%=activeDeliveries%></div><div class='summary-sub'>Open fulfillment commitments</div></div>
      <div class='summary-card danger'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between'><span class='summary-label'>Exceptions</span><i class='summary-icon zc-li-outline ui-2-alert-circle'></i></div><div class='summary-value'><%=exceptionCount%></div><div class='summary-sub'>Past expected delivery</div></div>
    </section>
    <main class='workspace-grid'>
      <section class='panel-card'><div class='panel-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><span class='panel-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline files-archive-drawer'></i></span><div><h2 class='panel-title'>Request for quotations</h2><div class='panel-note'>Eligible requests and response state</div></div></div><span class='panel-count'><%=openRequests.count()%></span></div><div class='panel-scroll'>
        <%if(openRequests.count()==0){%><div class='empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div><i class='zc-li-outline files-archive-drawer'></i><h5 class='zcs-font-18 zcs-font-medium'>No open requests</h5><p>New eligible requests will appear here.</p></div></div><%}else{%><div class='zcs-table-wrapper desktop-table'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-12 zcs-py-8 zcs-text-left'>Request</th><th class='zcs-px-12 zcs-py-8 zcs-text-left'>Required by</th><th class='zcs-px-12 zcs-py-8 zcs-text-left'>Requirement</th><th class='zcs-px-12 zcs-py-8 zcs-text-left'>Response</th></tr></thead><tbody><%for each orderRec in openRequests{existingQuote=Add_Supplier_Quote[Supplier==supplierId && Sales_Order==orderRec.ID];%><tr><td class='zcs-px-12 zcs-py-8'><a class='record-link' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=orderRec.ID%>'><%=orderRec.Sales_Order_ID%></a></td><td class='zcs-px-12 zcs-py-8'><%=ifnull(orderRec.Requested_Delivery_Date,"Not specified")%></td><td class='zcs-px-12 zcs-py-8'><%=ifnull(orderRec.Customer_Requirements,"Not provided")%></td><td class='zcs-px-12 zcs-py-8'><%if(existingQuote.count()==0){%><a class='action-link' href='#Form:Add_Supplier_Quote?Supplier=<%=supplierId%>&amp;Sales_Order=<%=orderRec.ID%>&amp;zc_LoadIn=dialog'><i class='zc-li-outline ui-1-simple-add'></i>Submit quote</a><%}else{%><span class='zcs-badge zcs-badge-green zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm'>Submitted</span><%}%></td></tr><%}%></tbody></table></div><div class='queue mobile-queue'><%for each orderRec in openRequests{existingQuote=Add_Supplier_Quote[Supplier==supplierId && Sales_Order==orderRec.ID];%><article class='queue-item'><div class='queue-top'><a class='record-link' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=orderRec.ID%>'><%=orderRec.Sales_Order_ID%></a><span class='muted'><%=ifnull(orderRec.Requested_Delivery_Date,"No date")%></span></div><div class='queue-meta'><span>Requirement</span><span><%=ifnull(orderRec.Customer_Requirements,"Not provided")%></span></div><div class='zcs-mt-10'><%if(existingQuote.count()==0){%><a class='action-link' href='#Form:Add_Supplier_Quote?Supplier=<%=supplierId%>&amp;Sales_Order=<%=orderRec.ID%>&amp;zc_LoadIn=dialog'>Submit quote</a><%}else{%><span class='zcs-badge zcs-badge-green zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm'>Quote submitted</span><%}%></div></article><%}%></div><%}%>
      </div></section>
      <section class='panel-card'><div class='panel-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><span class='panel-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-1-edit-72'></i></span><div><h2 class='panel-title'>Quotes</h2><div class='panel-note'>Commercial response status and timing</div></div></div><span class='panel-count'><%=myQuotes.count()%></span></div><div class='panel-scroll'><%if(myQuotes.count()==0){%><div class='empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div><i class='zc-li-outline ui-1-edit-72'></i><h5 class='zcs-font-18 zcs-font-medium'>No submitted quotes</h5><p>Respond to an eligible RFQ to begin.</p></div></div><%}else{%><div class='queue'><%for each quoteRec in myQuotes{quoteStatus=ifnull(quoteRec.Status,"Received");badge="zcs-badge-blue";quoteProgress=35;if(quoteStatus=="Selected"){badge="zcs-badge-green";quoteProgress=100;}else if(quoteStatus=="Rejected"){badge="zcs-badge-grey";quoteProgress=100;}%><article class='queue-item'><div class='queue-top'><div><a class='record-link' href='#Report:All_Supplier_Quotes?ID=<%=quoteRec.ID%>'><%=quoteRec.Supplier_Quote_ID%></a><div class='muted'><%=quoteRec.Sales_Order.Sales_Order_ID%></div></div><span class='zcs-badge <%=badge%> zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=quoteStatus%></span></div><div class='queue-meta'><span>Quote date</span><span><%=quoteRec.Quote_Date%></span><span>Lead time</span><span><%=ifnull(quoteRec.Lead_Time,"Not set")%></span></div><div class='progress-copy'><span>Response progress</span><span><%=quoteProgress%>%</span></div><div class='zcs-progress-bar'><div class='zcs-progress-bar-indicator' style='width:<%=quoteProgress%>%;'></div></div></article><%}%></div><%}%></div></section>
      <section class='panel-card'><div class='panel-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><span class='panel-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i></span><div><h2 class='panel-title'>Purchase orders</h2><div class='panel-note'>Order status and required next step</div></div></div><span class='panel-count'><%=myPOs.count()%></span></div><div class='panel-scroll'><%if(myPOs.count()==0){%><div class='empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div><i class='zc-li-outline e-commerce-shopping-cart-simple'></i><h5 class='zcs-font-18 zcs-font-medium'>No purchase orders</h5><p>Selected quotes will move here.</p></div></div><%}else{%><div class='queue'><%for each poRec in myPOs{poStatus=ifnull(poRec.Status,"New");poBadge="zcs-badge-blue";nextAction="Review the order";poProgress=15;if(poStatus=="Customer Approved"){poBadge="zcs-badge-yellow";nextAction="Submit supplier invoice";poProgress=35;}else if(poStatus=="Invoice Paid"){poBadge="zcs-badge-orange";nextAction="Prepare dispatch";poProgress=60;}else if(poStatus=="Logistics Pending"){poBadge="zcs-badge-orange";nextAction="Meet delivery commitment";poProgress=80;}else if(poStatus=="Products Received" || poStatus=="Delivered"){poBadge="zcs-badge-green";nextAction="No action due";poProgress=100;}%><article class='queue-item'><div class='queue-top'><a class='record-link' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=poRec.ID%>'><%=poRec.Purchase_Order_ID%></a><span class='zcs-badge <%=poBadge%> zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=poStatus%></span></div><div class='queue-meta'><span>Expected</span><span><%=ifnull(poRec.Expected_Delivery_Date,"Not set")%></span><span>Next step</span><span><%if(poStatus=="Customer Approved"){%><a class='record-link' href='#Form:Add_Supplier_Invoice?Supplier=<%=supplierId%>&amp;Purchase_Order=<%=poRec.ID%>&amp;Sales_Order=<%=poRec.Sales_Order.ID%>&amp;zc_LoadIn=dialog'><%=nextAction%></a><%}else{%><%=nextAction%><%}%></span></div><div class='progress-copy'><span>Fulfillment progress</span><span><%=poProgress%>%</span></div><div class='zcs-progress-bar'><div class='zcs-progress-bar-indicator' style='width:<%=poProgress%>%;'></div></div></article><%}%></div><%}%></div></section>
      <section class='panel-card'><div class='panel-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><span class='panel-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline files-single-copy-04'></i></span><div><h2 class='panel-title'>Invoices</h2><div class='panel-note'>Submitted values and payment progress</div></div></div><span class='panel-count'><%=myInvoices.count()%></span></div><div class='panel-scroll'><%if(myInvoices.count()==0){%><div class='empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div><i class='zc-li-outline files-single-copy-04'></i><h5 class='zcs-font-18 zcs-font-medium'>No invoices submitted</h5><p>Invoice-ready orders will show the next step.</p></div></div><%}else{%><div class='queue'><%for each invRec in myInvoices{invStatus=ifnull(invRec.Status,"New");invBadge="zcs-badge-yellow";invProgress=50;invNext="Await payment update";if(invStatus=="Paid"){invBadge="zcs-badge-green";invProgress=100;invNext="Payment recorded";}%><article class='queue-item'><div class='queue-top'><div><a class='record-link' href='#Page:Supplier_Invoice_Detail?Supplier_Invoice_ID=<%=invRec.ID%>'><%=invRec.Supplier_Invoice_ID%></a><div class='muted'><%=invRec.Supplier_Invoice_Number%></div></div><span class='zcs-badge <%=invBadge%> zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=invStatus%></span></div><div class='queue-meta'><span>PO</span><span><%if(invRec.Purchase_Order!=null){%><%=invRec.Purchase_Order.Purchase_Order_ID%><%}else{%>Not linked<%}%></span><span>Amount</span><span><%=ifnull(invRec.Currency,"")%> <%=ifnull(invRec.Invoice_Amount,0)%></span><span>Next step</span><span><%=invNext%></span></div><div class='progress-copy'><span>Payment progress</span><span><%=invProgress%>%</span></div><div class='zcs-progress-bar'><div class='zcs-progress-bar-indicator' style='width:<%=invProgress%>%;'></div></div></article><%}%></div><%}%></div></section>
      <section class='panel-card'><div class='panel-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><span class='panel-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline transportation-truck'></i></span><div><h2 class='panel-title'>Delivery obligations</h2><div class='panel-note'>Open commitments ordered by expected date</div></div></div><span class='panel-count'><%=activeDeliveries%></span></div><div class='panel-scroll'><%if(activeDeliveries==0){%><div class='empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div><i class='zc-li-outline ui-1-check-circle-08'></i><h5 class='zcs-font-18 zcs-font-medium'>No open delivery obligations</h5><p>Active fulfillment commitments will appear here.</p></div></div><%}else{%><div class='queue'><%for each deliveryRec in myPOs{deliveryStatus=ifnull(deliveryRec.Status,"New");if(deliveryStatus!="Products Received" && deliveryStatus!="Delivered"){deliveryBadge="zcs-badge-blue";deliveryProgress=15;if(deliveryStatus=="Customer Approved"){deliveryBadge="zcs-badge-yellow";deliveryProgress=35;}else if(deliveryStatus=="Invoice Paid"){deliveryBadge="zcs-badge-orange";deliveryProgress=60;}else if(deliveryStatus=="Logistics Pending"){deliveryBadge="zcs-badge-orange";deliveryProgress=80;}%><article class='queue-item'><div class='queue-top'><a class='record-link' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=deliveryRec.ID%>'><%=deliveryRec.Purchase_Order_ID%></a><span class='zcs-badge <%=deliveryBadge%> zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=deliveryStatus%></span></div><div class='queue-meta'><span>Expected</span><span><%=ifnull(deliveryRec.Expected_Delivery_Date,"Not set")%></span><span>Sales order</span><span><%=deliveryRec.Sales_Order.Sales_Order_ID%></span></div><div class='progress-copy'><span>Delivery readiness</span><span><%=deliveryProgress%>%</span></div><div class='zcs-progress-bar'><div class='zcs-progress-bar-indicator' style='width:<%=deliveryProgress%>%;'></div></div></article><%}}%></div><%}%></div></section>
      <section class='panel-card'><div class='panel-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><span class='panel-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-2-alert-circle'></i></span><div><h2 class='panel-title'>Exceptions</h2><div class='panel-note'>Open orders past their expected delivery date</div></div></div><span class='panel-count'><%=exceptionCount%></span></div><div class='panel-scroll'><%if(exceptionCount==0){%><div class='empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div><i class='zc-li-outline ui-1-check-circle-08'></i><h5 class='zcs-font-18 zcs-font-medium'>No delivery exceptions</h5><p>Open commitments are within their recorded dates.</p></div></div><%}else{%><div class='queue'><%for each exceptionRec in myPOs{exceptionStatus=ifnull(exceptionRec.Status,"New");if(exceptionStatus!="Products Received" && exceptionStatus!="Delivered" && exceptionRec.Expected_Delivery_Date!=null && exceptionRec.Expected_Delivery_Date<zoho.currentdate){%><article class='queue-item'><div class='queue-top'><a class='record-link' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=exceptionRec.ID%>'><%=exceptionRec.Purchase_Order_ID%></a><span class='zcs-badge zcs-badge-red zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm'>Past expected date</span></div><div class='queue-meta'><span>Expected</span><span><%=exceptionRec.Expected_Delivery_Date%></span><span>Status</span><span><%=exceptionStatus%></span><span>Required</span><span>Review the order and delivery commitment</span></div></article><%}}%></div><%}%></div></section>
    </main>
  <%}%>
</div>