<%
pos = Create_Purchase_Order[ID != 0] sort by PO_Date desc;
newCount = Create_Purchase_Order[Status == "New"].count();
approvedCount = Create_Purchase_Order[Status == "Approved"].count();
customerApprovedCount = Create_Purchase_Order[Status == "Customer Approved"].count();
invoiceCreatedCount = Create_Purchase_Order[Status == "Invoice Created"].count();
invoicePaidCount = Create_Purchase_Order[Status == "Invoice Paid"].count();
logisticsPendingCount = Create_Purchase_Order[Status == "Logistics Pending"].count();
productsReceivedCount = Create_Purchase_Order[Status == "Products Received"].count();
deliveredCount = Create_Purchase_Order[Status == "Delivered"].count();
actionCount = newCount + approvedCount + customerApprovedCount;
financeCount = invoiceCreatedCount;
fulfillmentCount = invoicePaidCount + logisticsPendingCount + productsReceivedCount;
openCount = actionCount + financeCount + fulfillmentCount;
%>
<style>
/* ZCS global utility subset used by this single-snippet page. */
:root{--zcs-theme-brand-color:var(--zcs_brand_color,#6147e5);--zcs-light-bg-color:var(--zcs_brand_light_color,#f1efff);--zcs-page-bg-color:#f3f3f4;--zcs-primary-text-color:var(--zcs_primary_text_color,#1c1c40);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#65657a);--zcs-border-color:var(--zcs_tertiary_border_color,#e5e5ec);--zcs-white-color:#fff;--zcs-primary-btn-text-color:var(--zcs_brand_foreground_color,#fff);--zcs-thead-color:#f8f8fb;--zcs-tr-h-color:#fafaff}
*{box-sizing:border-box}a{text-decoration:none}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-px-6{padding-left:6px;padding-right:6px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-12{padding-top:12px;padding-bottom:12px}.zcs-m-0{margin:0}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-18{font-size:18px}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-tertiary{color:var(--zcs-secondary-text-color)}.zcs-w-full{width:100%}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}
#splash-screen{display:none!important}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{width:100%!important;height:100%!important}.zc-container-wrapper .zc-main-content .inner,.zc-page-content-wrapper,.zc-pb-page-content-wrapper,.zc-pb-tile-container,.zc-pb-tile-card{width:100%!important;max-width:none!important}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}
.po-page{min-height:100%;padding:20px;background:#f7f7f9;font:14px/1.45 Arial,sans-serif;color:var(--zcs-primary-text-color)}.po-header{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:14px}.po-title{display:flex;align-items:center;gap:12px}.po-title-icon{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);font-size:20px}.po-header h1{margin:0 0 2px;font-size:23px;font-weight:600;line-height:1.2}.po-header p{margin:0;color:var(--zcs-secondary-text-color)}.po-total{padding:6px 10px;border:1px solid var(--zcs-border-color);border-radius:8px;background:#fff;color:var(--zcs-secondary-text-color);white-space:nowrap}.po-total strong{color:var(--zcs-primary-text-color);font-size:17px}
.summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:14px}.summary-card{display:flex;align-items:center;gap:10px;padding:12px 14px}.summary-icon{display:flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:8px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);font-size:17px}.summary-copy span{display:block;color:var(--zcs-secondary-text-color);font-size:12px}.summary-copy strong{font-size:18px;font-weight:600}
.tab-input{position:absolute;opacity:0;pointer-events:none}.register{overflow:hidden}.zcs-horizontal-tabhead{display:flex;gap:5px;overflow-x:auto;overflow-y:hidden;margin:0;padding:8px 10px;list-style:none;border-bottom:1px solid var(--zcs-border-color);scrollbar-width:none}.zcs-horizontal-tabhead::-webkit-scrollbar{display:none}.zcs-horizontal-tabitem{list-style:none;white-space:nowrap}.zcs-horizontal-tablink{display:flex;align-items:center;gap:7px;padding:7px 10px;border:1px solid transparent;border-radius:16px;color:var(--zcs-secondary-text-color);cursor:pointer}.zcs-horizontal-tabcount{min-width:20px;padding:1px 5px;border-radius:10px;background:var(--zcs-page-bg-color);font-size:11px;text-align:center}.tab-input:nth-of-type(1):checked~.register .tab-all label,.tab-input:nth-of-type(2):checked~.register .tab-action label,.tab-input:nth-of-type(3):checked~.register .tab-finance label,.tab-input:nth-of-type(4):checked~.register .tab-fulfillment label,.tab-input:nth-of-type(5):checked~.register .tab-complete label{border-color:var(--zcs-theme-brand-color);background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color)}
.table-scroll{height:500px;overflow:auto}.zcs-table-wrapper table{min-width:1080px;border-collapse:collapse}.zcs-table-wrapper thead{position:sticky;top:0;z-index:2}.zcs-table-wrapper th{padding:10px 12px;background:var(--zcs-thead-color);border-bottom:1px solid var(--zcs-border-color);color:var(--zcs-secondary-text-color);font-size:12px;font-weight:600;text-align:left;white-space:nowrap}.zcs-table-wrapper td{padding:11px 12px;border-top:1px solid var(--zcs-border-color);vertical-align:middle}.zcs-table-wrapper tbody tr:hover td{background:var(--zcs-tr-h-color)}.po-row{display:none}.tab-input:nth-of-type(1):checked~.register .po-row,.tab-input:nth-of-type(2):checked~.register .group-action,.tab-input:nth-of-type(3):checked~.register .group-finance,.tab-input:nth-of-type(4):checked~.register .group-fulfillment,.tab-input:nth-of-type(5):checked~.register .group-complete{display:table-row}.primary-link{color:var(--zcs-theme-brand-color);font-weight:600}.subtext{display:block;margin-top:2px;color:var(--zcs-secondary-text-color);font-size:12px}.money{font-weight:600;color:#09598e;white-space:nowrap}.date-cell{white-space:nowrap}.readiness{min-width:150px}.readiness-line{display:flex;justify-content:space-between;gap:8px;margin-bottom:5px;font-size:11px}.readiness-line span:first-child{color:var(--zcs-secondary-text-color)}.zcs-progress-bar{height:6px;border-radius:4px;background:var(--zcs-light-bg-color)}.zcs-progress-bar-indicator{height:100%;border-radius:inherit;background:var(--zcs-theme-brand-color)}
.zcs-badge{width:auto;border:1px solid;font-size:12px;white-space:nowrap}.zcs-badge-theme{background:var(--zcs-light-bg-color);border-color:var(--zcs-theme-brand-color);color:var(--zcs-theme-brand-color)}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#0b7e55}.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#8b600d}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#1754c7}.zcs-badge-orange{background:#f8f0eb;border-color:#f4660c;color:#b94b0b}.zcs-badge-grey{background:#eee;border-color:#686878;color:#535363}.actions{display:flex;align-items:center;gap:6px;white-space:nowrap}.zcs-custom-btn,.zcs-custom-action-icon{display:inline-flex;align-items:center;justify-content:center;gap:5px;min-height:30px;border:1px solid var(--zcs-theme-brand-color);border-radius:6px;background:#fff;color:var(--zcs-theme-brand-color);font-size:12px}.zcs-custom-btn{padding:5px 9px}.zcs-custom-btn.action-primary{background:var(--zcs-theme-brand-color);color:var(--zcs-primary-btn-text-color)}.zcs-custom-action-icon{width:30px;border-color:var(--zcs-border-color);color:var(--zcs-secondary-text-color)}
.mobile-list{display:none;padding:10px}.mobile-card{display:none;padding:14px;margin-bottom:10px}.mobile-head,.mobile-meta,.mobile-footer{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.mobile-meta{display:grid;grid-template-columns:1fr 1fr;margin:12px 0}.mobile-meta label{display:block;color:var(--zcs-secondary-text-color);font-size:11px;text-transform:uppercase}.mobile-footer{align-items:center;margin-top:12px}.next-step{display:flex;align-items:flex-start;gap:8px;min-width:0;color:var(--zcs-secondary-text-color);font-size:12px}.next-step i{margin-top:2px;color:var(--zcs-theme-brand-color)}
.empty-state,.filtered-empty{min-height:320px;display:flex;align-items:center;justify-content:center;padding:20px;text-align:center}.filtered-empty{display:none}.empty-icon{display:flex;align-items:center;justify-content:center;width:46px;height:46px;margin:0 auto 10px;border-radius:12px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);font-size:22px}.empty-state h5,.filtered-empty h5{margin:0;font-size:17px;font-weight:500}.empty-state p,.filtered-empty p{margin:5px 0 0;color:var(--zcs-secondary-text-color)}.tab-input:nth-of-type(2):checked~.register .empty-action,.tab-input:nth-of-type(3):checked~.register .empty-finance,.tab-input:nth-of-type(4):checked~.register .empty-fulfillment,.tab-input:nth-of-type(5):checked~.register .empty-complete{display:flex}
@media(max-width:850px){.po-page{padding:14px}.summary-grid{grid-template-columns:1fr 1fr}.table-scroll{display:block;height:auto;overflow:visible;border:0}.zcs-table-wrapper table{display:block;min-width:0}.zcs-table-wrapper thead{display:none}.zcs-table-wrapper tbody{display:block}.po-row{padding:14px;margin:10px;border:1px solid var(--zcs-border-color);border-radius:10px;background:#fff}.tab-input:nth-of-type(1):checked~.register .po-row,.tab-input:nth-of-type(2):checked~.register .group-action,.tab-input:nth-of-type(3):checked~.register .group-finance,.tab-input:nth-of-type(4):checked~.register .group-fulfillment,.tab-input:nth-of-type(5):checked~.register .group-complete{display:grid;grid-template-columns:1fr 1fr;gap:10px}.zcs-table-wrapper td{display:block;padding:0;border:0}.zcs-table-wrapper td:nth-child(1),.zcs-table-wrapper td:nth-child(3),.zcs-table-wrapper td:nth-child(7),.zcs-table-wrapper td:nth-child(8){grid-column:1/-1}.zcs-table-wrapper tbody tr:hover td{background:transparent}.mobile-list{display:none}}@media(max-width:540px){.po-header{align-items:flex-start}.po-header p{font-size:12px}.summary-grid{grid-template-columns:1fr 1fr}.summary-card{padding:10px}.tab-input:nth-of-type(1):checked~.register .po-row,.tab-input:nth-of-type(2):checked~.register .group-action,.tab-input:nth-of-type(3):checked~.register .group-finance,.tab-input:nth-of-type(4):checked~.register .group-fulfillment,.tab-input:nth-of-type(5):checked~.register .group-complete{grid-template-columns:1fr}.zcs-table-wrapper td{grid-column:1!important}.actions{width:100%;flex-wrap:wrap}.zcs-custom-btn{flex:1 1 auto}}
</style>
<div class='po-page'>
  <header class='po-header'>
    <div class='po-title'><span class='po-title-icon'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i></span><div><h1>Purchase Orders</h1><p>Approval, finance, delivery, and completion register</p></div></div>
    <div class='po-total'><strong><%=pos.count()%></strong> total orders</div>
  </header>
  <section class='summary-grid'>
    <div class='summary-card zcs-card'><span class='summary-icon'><i class='zc-li-outline ui-1-check-circle-08'></i></span><div class='summary-copy'><span>Approval and sharing</span><strong><%=actionCount%></strong></div></div>
    <div class='summary-card zcs-card'><span class='summary-icon'><i class='zc-li-outline files-single-copy-04'></i></span><div class='summary-copy'><span>Finance handoff</span><strong><%=financeCount%></strong></div></div>
    <div class='summary-card zcs-card'><span class='summary-icon'><i class='zc-li-outline transport-delivery-fast'></i></span><div class='summary-copy'><span>Delivery readiness</span><strong><%=fulfillmentCount%></strong></div></div>
    <div class='summary-card zcs-card'><span class='summary-icon'><i class='zc-li-outline ui-1-check-circle-08'></i></span><div class='summary-copy'><span>Completed delivery</span><strong><%=deliveredCount%></strong></div></div>
  </section>
  <input class='tab-input' type='radio' name='po-status' id='po-all' checked><input class='tab-input' type='radio' name='po-status' id='po-action'><input class='tab-input' type='radio' name='po-status' id='po-finance'><input class='tab-input' type='radio' name='po-status' id='po-fulfillment'><input class='tab-input' type='radio' name='po-status' id='po-complete'>
  <section class='register zcs-card'>
    <ul class='zcs-horizontal-tabhead'>
      <li class='zcs-horizontal-tabitem tab-all'><label class='zcs-horizontal-tablink' for='po-all'>All <span class='zcs-horizontal-tabcount'><%=pos.count()%></span></label></li>
      <li class='zcs-horizontal-tabitem tab-action'><label class='zcs-horizontal-tablink' for='po-action'>Approval and sharing <span class='zcs-horizontal-tabcount'><%=actionCount%></span></label></li>
      <li class='zcs-horizontal-tabitem tab-finance'><label class='zcs-horizontal-tablink' for='po-finance'>Finance <span class='zcs-horizontal-tabcount'><%=financeCount%></span></label></li>
      <li class='zcs-horizontal-tabitem tab-fulfillment'><label class='zcs-horizontal-tablink' for='po-fulfillment'>Delivery <span class='zcs-horizontal-tabcount'><%=fulfillmentCount%></span></label></li>
      <li class='zcs-horizontal-tabitem tab-complete'><label class='zcs-horizontal-tablink' for='po-complete'>Completed <span class='zcs-horizontal-tabcount'><%=deliveredCount%></span></label></li>
    </ul>
    <%if(pos.count() == 0){%>
      <div class='empty-state'><div><span class='empty-icon'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i></span><h5>No purchase orders</h5><p>Orders will appear here after a supplier selection is converted into a purchase order.</p></div></div>
    <%}else{%>
      <div class='table-scroll zcs-table-wrapper'>
        <table class='zcs-w-full'><thead><tr><th>Purchase order</th><th>Customer and sales order</th><th>Status</th><th>Dates</th><th>Products</th><th>Order value</th><th>Readiness</th><th>Actions</th></tr></thead><tbody>
        <%for each po in pos {
          statusValue=ifnull(po.Status,"Unknown"); statusClass="group-action"; badgeClass="zcs-badge-theme"; badgeIcon="loader-dots-06"; nextStep="Review missing status"; progress=10; progressLabel="Needs review"; actionLabel=""; actionIcon="arrows-1-tail-right"; actionUrl="";
          if(statusValue == "New"){badgeClass="zcs-badge-yellow";nextStep="Approve purchase order";progress=12;progressLabel="Approval";if(po.Sales_Order != null){actionLabel="Approve";actionIcon="ui-1-check-circle-08";}}
          else if(statusValue == "Approved"){badgeClass="zcs-badge-orange";progress=25;progressLabel="Sharing";if(po.Shared_With_Customer == true){nextStep="Record customer approval";actionLabel="Customer approval";actionIcon="ui-1-check-circle-08";}else{nextStep="Share with customer";actionLabel="Share";actionIcon="ui-1-share-66";}}
          else if(statusValue == "Customer Approved"){badgeClass="zcs-badge-blue";nextStep="Create supplier invoice";progress=38;progressLabel="Finance ready";actionLabel="Create invoice";actionIcon="files-single-copy-04";}
          else if(statusValue == "Invoice Created"){statusClass="group-finance";badgeClass="zcs-badge-blue";nextStep="Complete payment";progress=50;progressLabel="Payment";actionLabel="Review invoice";actionIcon="files-single-copy-04";}
          else if(statusValue == "Invoice Paid"){statusClass="group-fulfillment";badgeClass="zcs-badge-green";nextStep="Create logistics booking";progress=63;progressLabel="Logistics ready";actionLabel="Create logistics";actionIcon="transport-delivery-fast";}
          else if(statusValue == "Logistics Pending"){statusClass="group-fulfillment";badgeClass="zcs-badge-blue";nextStep="Track shipment and receiving";progress=75;progressLabel="In transit";actionLabel="View logistics";actionIcon="transport-delivery-fast";}
          else if(statusValue == "Products Received"){statusClass="group-fulfillment";badgeClass="zcs-badge-green";nextStep="Confirm customer delivery";progress=88;progressLabel="Delivery ready";actionLabel="Confirm delivery";actionIcon="ui-1-check-circle-08";}
          else if(statusValue == "Delivered"){statusClass="group-complete";badgeClass="zcs-badge-green";badgeIcon="ui-1-check-circle-08";nextStep="Delivery complete";progress=100;progressLabel="Complete";actionLabel="Create return";actionIcon="arrows-4-restore";}
          productCount=Purchase_Order_Product[Parent_Purchase_Order == po.ID].count(); supplierName="Supplier not set"; customerName="Customer not set"; salesOrderName="Sales order not set"; salesOrderID=""; if(po.Supplier != null){supplierName=ifnull(po.Supplier.Supplier_Name,"Supplier not set");} if(po.Customer != null){customerName=ifnull(po.Customer.Customer_Name,"Customer not set");} if(po.Sales_Order != null){salesOrderName=ifnull(po.Sales_Order.Sales_Order_ID,"Sales order not set");salesOrderID=po.Sales_Order.ID.toString();}
          if(statusValue == "New" && actionLabel != ""){actionUrl="#Form:Add_History?Purchase_Order_Lookup=" + po.ID + "&amp;Sales_Order_Lookup=" + salesOrderID + "&amp;Action_Type=Purchase Order Approved&amp;Status=New&amp;Previous_Status=New&amp;New_Status=Approved&amp;zc_LoadIn=dialog";}
          else if(statusValue == "Approved" && po.Shared_With_Customer == true){actionUrl="#Form:Create_Purchase_Order?recLinkID=" + po.ID + "&amp;viewLinkName=All_Purchase_Orders&amp;Action_Mode=Customer Approval&amp;zc_LoadIn=dialog";}
          else if(statusValue == "Approved"){actionUrl="#Form:Create_Purchase_Order?recLinkID=" + po.ID + "&amp;viewLinkName=All_Purchase_Orders&amp;Action_Mode=Share With Customer&amp;zc_LoadIn=dialog";}
          else if(statusValue == "Customer Approved"){actionUrl="#Form:Add_Supplier_Invoice?Purchase_Order=" + po.ID + "&amp;zc_LoadIn=dialog";}
          else if(statusValue == "Invoice Created"){actionUrl="#Report:All_Supplier_Invoices?Purchase_Order=" + po.ID;}
          else if(statusValue == "Invoice Paid"){actionUrl="#Form:Create_Logistics_Booking?zc_LoadIn=dialog";}
          else if(statusValue == "Logistics Pending"){actionUrl="#Report:All_Logistics_Bookings?Purchase_Orders=" + po.ID;}
          else if(statusValue == "Products Received"){actionUrl="#Form:Create_Purchase_Order?recLinkID=" + po.ID + "&amp;viewLinkName=All_Purchase_Orders&amp;Action_Mode=Confirm Delivery&amp;zc_LoadIn=dialog";}
          else if(statusValue == "Delivered"){actionUrl="#Form:Create_Return_Request?Purchase_Order=" + po.ID + "&amp;zc_LoadIn=dialog";}
        %>
          <tr class='po-row <%=statusClass%>'>
            <td><a class='primary-link' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=po.ID%>'><%=ifnull(po.Purchase_Order_ID,"PO record")%></a><span class='subtext'><%=supplierName%></span></td>
            <td><strong><%=customerName%></strong><%if(salesOrderID != ""){%><a class='subtext primary-link' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=salesOrderID%>'><%=salesOrderName%></a><%}else{%><span class='subtext'><%=salesOrderName%></span><%}%></td>
            <td><span class='zcs-badge zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 <%=badgeClass%>'><i class='zc-li-outline <%=badgeIcon%>'></i><%=statusValue%></span></td>
            <td class='date-cell'><%=ifnull(po.PO_Date,"Not set")%><span class='subtext'>Due <%=ifnull(po.Expected_Delivery_Date,"Not set")%></span></td>
            <td><strong><%=productCount%></strong> product<%=if(productCount == 1,"","s")%></td><td class='money'><%=ifnull(po.Currency,"")%> <%=ifnull(po.Total_Customer_Price,0)%></td>
            <td><div class='readiness'><div class='readiness-line'><span><%=progressLabel%></span><strong><%=progress%>%</strong></div><div class='zcs-progress-bar'><div class='zcs-progress-bar-indicator' style='width:<%=progress%>%'></div></div><span class='subtext'><%=nextStep%></span></div></td>
            <td><div class='actions'><a class='zcs-custom-action-icon' title='Detail' aria-label='Detail' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=po.ID%>'><i class='zc-li-outline ui-1-zoom-split'></i></a><%if(actionUrl != ""){%><a class='zcs-custom-btn action-primary' href='<%=actionUrl%>'><i class='zc-li-outline <%=actionIcon%>'></i><%=actionLabel%></a><%}%><a class='zcs-custom-action-icon' title='History' aria-label='History' href='#Report:All_Histories?Purchase_Order_Lookup=<%=po.ID%>'><i class='zc-li-outline ui-2-time'></i></a></div></td>
          </tr>
          <article class='mobile-card zcs-card <%=statusClass%>'>
            <div class='mobile-head'><div><a class='primary-link zcs-font-15' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=po.ID%>'><%=ifnull(po.Purchase_Order_ID,"PO record")%></a><span class='subtext'><%=supplierName%></span></div><span class='zcs-badge zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 <%=badgeClass%>'><i class='zc-li-outline <%=badgeIcon%>'></i><%=statusValue%></span></div>
            <div class='mobile-meta'><div><label>Customer</label><strong><%=customerName%></strong></div><div><label>Sales order</label><%if(salesOrderID != ""){%><a class='primary-link' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=salesOrderID%>'><%=salesOrderName%></a><%}else{%><span><%=salesOrderName%></span><%}%></div><div><label>Expected delivery</label><span><%=ifnull(po.Expected_Delivery_Date,"Not set")%></span></div><div><label>Order value</label><strong class='money'><%=ifnull(po.Currency,"")%> <%=ifnull(po.Total_Customer_Price,0)%></strong></div></div>
            <div class='readiness'><div class='readiness-line'><span><%=progressLabel%></span><strong><%=progress%>%</strong></div><div class='zcs-progress-bar'><div class='zcs-progress-bar-indicator' style='width:<%=progress%>%'></div></div></div>
            <div class='mobile-footer'><div class='next-step'><i class='zc-li-outline arrows-1-tail-right'></i><span><%=nextStep%></span></div><div class='actions'><a class='zcs-custom-btn' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=po.ID%>'><i class='zc-li-outline ui-1-zoom-split'></i>Detail</a><%if(actionUrl != ""){%><a class='zcs-custom-btn action-primary' href='<%=actionUrl%>'><i class='zc-li-outline <%=actionIcon%>'></i><%=actionLabel%></a><%}%><a class='zcs-custom-action-icon' title='History' aria-label='History' href='#Report:All_Histories?Purchase_Order_Lookup=<%=po.ID%>'><i class='zc-li-outline ui-2-time'></i></a></div></div>
          </article>
        <%}%>
        </tbody></table>
      </div>
      <div class='mobile-list'></div>
      <%if(actionCount == 0){%><div class='filtered-empty empty-action'><div><span class='empty-icon'><i class='zc-li-outline ui-1-check-circle-08'></i></span><h5>No approval or sharing work</h5><p>No purchase orders currently need this handoff.</p></div></div><%}%>
      <%if(financeCount == 0){%><div class='filtered-empty empty-finance'><div><span class='empty-icon'><i class='zc-li-outline files-single-copy-04'></i></span><h5>No finance handoffs</h5><p>No purchase orders are waiting on invoice or payment work.</p></div></div><%}%>
      <%if(fulfillmentCount == 0){%><div class='filtered-empty empty-fulfillment'><div><span class='empty-icon'><i class='zc-li-outline transport-delivery-fast'></i></span><h5>No delivery-readiness work</h5><p>No paid orders are in logistics or receiving.</p></div></div><%}%>
      <%if(deliveredCount == 0){%><div class='filtered-empty empty-complete'><div><span class='empty-icon'><i class='zc-li-outline ui-1-check-circle-08'></i></span><h5>No completed deliveries</h5><p>Completed deliveries will appear here.</p></div></div><%}%>
    <%}%>
  </section>
</div>