<%
rdOrders = Create_Sales_Order[Requirement_Source == "R&D Market Need"] sort by Sales_Order_Date desc;
rdOrderCount = rdOrders.count();
rdProducts = Sales_Order_Product[Parent_Sales_Order.Requirement_Source == "R&D Market Need"];
rdProductCount = rdProducts.count();
rdQuotes = Add_Supplier_Quote[Sales_Order.Requirement_Source == "R&D Market Need"] sort by Quote_Date desc;
rdQuoteCount = rdQuotes.count();
rdPOs = Create_Purchase_Order[Sales_Order.Requirement_Source == "R&D Market Need"] sort by PO_Date desc;
rdPOCount = rdPOs.count();
totalDemandQty = 0;
ordersWithQuotes = 0;
comparisonReadyCount = 0;
selectedQuoteCount = 0;
for each demandRow in rdProducts
{
  if(demandRow.Quantity != null)
  {
    totalDemandQty = totalDemandQty + demandRow.Quantity;
  }
}
for each needOrder in rdOrders
{
  quoteCoverageCount = Add_Supplier_Quote[Sales_Order == needOrder.ID].count();
  if(quoteCoverageCount > 0)
  {
    ordersWithQuotes = ordersWithQuotes + 1;
  }
  if(quoteCoverageCount > 1 && needOrder.Selected_Supplier_Quote == null)
  {
    comparisonReadyCount = comparisonReadyCount + 1;
  }
  if(needOrder.Selected_Supplier_Quote != null)
  {
    selectedQuoteCount = selectedQuoteCount + 1;
  }
}
coveragePct = 0;
if(rdOrderCount > 0)
{
  coveragePct = (ordersWithQuotes * 100) / rdOrderCount;
}
%>
<style>
/* ZCS global utility core, included once for this page. */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#F6F5F9;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-col-common{flex:1 1 0;min-width:0}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:10px}.zcs-gap-4{gap:4px}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-gap-14{gap:14px}.zcs-gap-16{gap:16px}.zcs-rounded-sm{border-radius:4px}.zcs-font-11{font-size:11px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-white{color:#fff}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-text-right{text-align:right}.zcs-card{background:var(--zcs-white-color);border:1px solid #E6E3EC;border-radius:10px}a{text-decoration:none}
html,body,div#zppagesLive,div#elementsContainer,.Layout.elemContainment,.zcpage-elemContainer,.zc-pb-page-content-wrapper,.zc-pb-tile-container,.zc-pb-tile-card{width:100%!important;max-width:none!important;min-height:100%;box-sizing:border-box}.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zc-pb-tile-container,.zc-pb-page-content-wrapper .zc-pb-tile-card{padding:0!important;margin:0!important;border-radius:0!important;box-shadow:none!important}#splash-screen,.zc-page-loader,.cogLoader{display:none!important}
.rd-dashboard{min-height:100%;padding:16px;background:var(--zcs-page-bg-color);font:400 14px/1.45 Arial,sans-serif;color:var(--zcs-primary-text-color)}
.intro{padding:18px 20px;border-left:4px solid #7253D6}.eyebrow{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#7253D6}.intro h1{margin:3px 0 4px}.intro p{max-width:760px;margin:0;color:var(--zcs-secondary-text-color)}.scope{max-width:360px;padding-left:18px;border-left:1px solid #DED9E8;color:var(--zcs-secondary-text-color);font-size:12px}.scope b{color:#7253D6}
.summary-grid{display:grid;grid-template-columns:repeat(4,minmax(120px,1fr));gap:10px}.summary{padding:12px 14px;cursor:default}.summary-top{display:flex;align-items:center;justify-content:space-between;color:var(--zcs-secondary-text-color);font-size:12px}.summary-top i{color:#7253D6;font-size:16px}.summary-value{margin-top:4px;font-size:20px;font-weight:600}.lifecycle{padding:15px 18px}.lifecycle-head{margin-bottom:14px}.lifecycle-note{font-size:12px;color:var(--zcs-secondary-text-color)}
.zcs-stepper-wrapper ul{display:flex;list-style:none;padding:0;margin:0;gap:8px}.zcs-stepper{flex:1;display:flex;flex-direction:column;align-items:center;gap:5px;text-align:center;position:relative}.zcs-stepper-status{width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#7253D6;border:4px solid #fff;box-sizing:border-box;z-index:1;color:#fff;font-size:12px}.zcs-stepper:not(:last-child):before{content:'';width:100%;height:1px;border-top:1px solid #7253D6;position:absolute;top:14px;left:50%}.zcs-stepper-text{font-size:12px}.zcs-stepper-sub{font-size:11px;color:var(--zcs-secondary-text-color)}
.workspace{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(340px,.85fr);gap:14px;align-items:start}.stack{display:grid;gap:14px}.section{min-width:0;overflow:hidden}.section-head{min-height:52px;padding:9px 14px;border-bottom:1px solid var(--zcs-border-color);background:#fff}.title-icon{width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border-radius:8px;background:#F0EBFF;color:#7253D6}.section-count{padding:2px 8px;border-radius:10px;background:#F1EFF5;color:var(--zcs-secondary-text-color);font-size:11px;font-weight:600}.section-link,.record-link,.icon-action{color:#6645CD}.section-link,.record-link{font-weight:600}.section-link{font-size:12px;white-space:nowrap}.section-body{height:286px;overflow:auto}.tall{height:320px}
.zcs-table-wrapper{background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;min-width:690px}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:#FAF9FC;white-space:nowrap;box-shadow:0 -1px 0 var(--zcs-border-color) inset;font-size:11px;color:var(--zcs-secondary-text-color);font-weight:600}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color);vertical-align:middle;font-size:13px}.zcs-table-wrapper tbody tr:first-child td{border-top:0}.zcs-table-wrapper tbody tr:hover td{background:#FAF9FC}.meta{font-size:11px;color:var(--zcs-secondary-text-color);margin-top:2px}.muted{color:var(--zcs-secondary-text-color)}
.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent;color:#fff}.zcs-badge-theme{background:#7253D6}.zcs-badge-green{background:#16845C}.zcs-badge-yellow{background:#B97800}.zcs-badge-blue{background:#2A6FFC}.zcs-badge-grey{background:#59606D}.zcs-badge-orange{background:#C95C12}.list{padding:2px 14px}.list-row{padding:11px 0;border-bottom:1px solid var(--zcs-border-color)}.list-row:last-child{border-bottom:0}.record-title{font-weight:600}.qty{min-width:38px;text-align:center;background:#F0EBFF;color:#6645CD;border-radius:6px;padding:4px 7px;font-weight:600}.zcs-button{width:auto;min-height:32px;border:1px solid #7253D6;background:#fff;color:#6645CD;padding:6px 10px;border-radius:6px;font-size:12px;font-weight:600;box-sizing:border-box}.zcs-button:hover{background:var(--zcs_component_hover_color)}.coverage{padding:12px 14px;border-bottom:1px solid var(--zcs-border-color)}.zcs-progress-bar{height:7px;background:var(--zcs_component_hover_color);border-radius:4px}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:#7253D6}.zcs-nodata-wrapper{min-height:210px}.zcs-nodata-content{max-width:390px}.empty-icon{display:block;font-size:26px;color:#8D8798;margin-bottom:7px}
@media(max-width:1120px){.workspace{grid-template-columns:1fr}.section-body{height:310px}.tall{height:330px}}
@media(max-width:720px){.rd-dashboard{padding:9px}.intro{align-items:flex-start;flex-direction:column}.scope{max-width:none;padding:10px 0 0;border-left:0;border-top:1px solid #DED9E8}.summary-grid{grid-template-columns:repeat(2,1fr)}.section-head{align-items:flex-start}.zcs-stepper-wrapper ul{flex-direction:column;gap:14px}.zcs-stepper{flex-direction:row;text-align:left}.zcs-stepper:not(:last-child):before{width:1px;height:100%;border-top:0;border-left:1px solid #7253D6;left:14px;top:14px}.zcs-table-wrapper table{min-width:0}.zcs-table-wrapper thead{display:none}.zcs-table-wrapper tbody tr{display:block;margin:8px;border:1px solid var(--zcs-border-color);border-radius:8px;overflow:hidden}.zcs-table-wrapper tbody td{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%!important;padding:7px 10px!important;box-sizing:border-box;border:0}.zcs-table-wrapper tbody td:before{content:attr(data-label);font-size:11px;color:var(--zcs-secondary-text-color);font-weight:600}.section-body,.tall{height:360px}}
@media(max-width:430px){.summary-grid{grid-template-columns:1fr}.section-head{flex-wrap:wrap}}
</style>
<div class='rd-dashboard zcs-flex zcs-direction-column zcs-gap-14 zcs-box-border'>
  <header class='intro zcs-card zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16'>
    <div><div class='eyebrow'>Research and development</div><h1 class='zcs-font-24 zcs-font-semibold zcs-lh-heading'>Market needs workspace</h1><p>Assess requested products and move each need through supplier evidence, comparison, selection, and downstream purchasing.</p></div>
    <div class='scope'><b>Scoped data</b><br>Only sales orders with Requirement Source set to R&amp;D Market Need are included. Customer Request orders remain outside this workspace.</div>
  </header>

  <div class='summary-grid'>
    <div class='summary zcs-card'><div class='summary-top'><span>Market requirements</span><i class='zc-li-outline ui-2-time'></i></div><div class='summary-value'><%=rdOrderCount%></div></div>
    <div class='summary zcs-card'><div class='summary-top'><span>Units requested</span><i class='zc-li-outline tech-computer'></i></div><div class='summary-value'><%=totalDemandQty%></div></div>
    <div class='summary zcs-card'><div class='summary-top'><span>Supplier quotes</span><i class='zc-li-outline arrows-2-file-download-87'></i></div><div class='summary-value'><%=rdQuoteCount%></div></div>
    <div class='summary zcs-card'><div class='summary-top'><span>Downstream POs</span><i class='zc-li-outline e-commerce-shopping-cart-simple'></i></div><div class='summary-value'><%=rdPOCount%></div></div>
  </div>

  <section class='lifecycle zcs-card'>
    <div class='lifecycle-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div class='zcs-font-16 zcs-font-semibold'>Sourcing lifecycle</div><div class='lifecycle-note'>A compact portfolio view; open records below for detail.</div></div>
    <div class='zcs-stepper-wrapper'><ul>
      <li class='zcs-stepper'><span class='zcs-stepper-status'><i class='zc-li-outline ui-1-check-small'></i></span><span class='zcs-stepper-text'>Need captured</span><span class='zcs-stepper-sub'><%=rdOrderCount%> requirements</span></li>
      <li class='zcs-stepper'><span class='zcs-stepper-status'><i class='zc-li-outline ui-1-check-small'></i></span><span class='zcs-stepper-text'>Demand defined</span><span class='zcs-stepper-sub'><%=rdProductCount%> product lines</span></li>
      <li class='zcs-stepper'><span class='zcs-stepper-status'><i class='zc-li-outline ui-1-check-small'></i></span><span class='zcs-stepper-text'>Evidence received</span><span class='zcs-stepper-sub'><%=ordersWithQuotes%> covered</span></li>
      <li class='zcs-stepper'><span class='zcs-stepper-status'><i class='zc-li-outline ui-1-check-small'></i></span><span class='zcs-stepper-text'>Quote selected</span><span class='zcs-stepper-sub'><%=selectedQuoteCount%> selected</span></li>
      <li class='zcs-stepper'><span class='zcs-stepper-status'><i class='zc-li-outline ui-1-check-small'></i></span><span class='zcs-stepper-text'>PO created</span><span class='zcs-stepper-sub'><%=rdPOCount%> purchase orders</span></li>
    </ul></div>
  </section>

  <div class='workspace'>
    <div class='stack'>
      <section class='section zcs-card'>
        <div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='title-icon zc-li-outline ui-2-time'></i><span class='zcs-font-16 zcs-font-semibold'>Market requirements</span><span class='section-count'><%=rdOrderCount%></span></div><a class='section-link' href='#Report:All_Sales_Orders?Requirement_Source=R%26D%20Market%20Need'>View filtered report</a></div>
        <% if(rdOrderCount > 0) { %><div class='section-body tall zcs-table-wrapper zcs-relative'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Requirement</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Context</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Market need</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Delivery</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Evidence</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Status</th></tr></thead><tbody>
        <% for each orderRec in rdOrders { orderQuoteCount = Add_Supplier_Quote[Sales_Order == orderRec.ID].count(); customerLabel = "Internal market need"; if(orderRec.Customer != null) { customerLabel = orderRec.Customer.Customer_Name; } %><tr><td data-label='Requirement' class='zcs-px-16 zcs-py-8'><a class='record-link' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=orderRec.ID%>'><%=orderRec.Sales_Order_ID%></a><div class='meta'><%=orderRec.Sales_Order_Date%></div></td><td data-label='Context' class='zcs-px-16 zcs-py-8'><%=customerLabel%></td><td data-label='Market need' class='zcs-px-16 zcs-py-8'><%=ifnull(orderRec.Customer_Requirements,"Requirement detail pending")%></td><td data-label='Delivery' class='zcs-px-16 zcs-py-8'><%=ifnull(orderRec.Requested_Delivery_Date,"Not set")%></td><td data-label='Evidence' class='zcs-px-16 zcs-py-8'><span class='zcs-badge zcs-badge-filled <% if(orderQuoteCount > 0) { %>zcs-badge-blue<% } else { %>zcs-badge-grey<% } %> zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'><%=orderQuoteCount%> quotes</span></td><td data-label='Status' class='zcs-px-16 zcs-py-8'><%=ifnull(orderRec.Status,"Status not set")%></td></tr><% } %>
        </tbody></table></div><% } else { %><div class='section-body zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-nodata-content zcs-p-20'><i class='empty-icon zc-li-outline ui-2-time'></i><h5 class='zcs-font-18 zcs-font-medium zcs-m-0'>No market requirements</h5><p class='zcs-color-secondary zcs-mt-10'>Records appear here only when Requirement Source is R&amp;D Market Need.</p></div></div><% } %>
      </section>

      <section class='section zcs-card'>
        <div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='title-icon zc-li-outline arrows-2-file-download-87'></i><span class='zcs-font-16 zcs-font-semibold'>Supplier evidence</span><span class='section-count'><%=rdQuoteCount%></span></div><a class='section-link' href='#Report:All_Supplier_Quotes'>Open quote register</a></div>
        <div class='coverage'><div class='zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6'><div class='zcs-progress-bar'><div class='zcs-progress-bar-indicator' style='width:<%=coveragePct%>%;'></div></div><p class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-m-0'><span><%=ordersWithQuotes%> of <%=rdOrderCount%> requirements have supplier evidence</span><span><%=coveragePct%>%</span></p></div></div>
        <% if(rdQuoteCount > 0) { %><div class='section-body zcs-table-wrapper zcs-relative'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Quote</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Requirement</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Supplier</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Availability</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Lead time</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>State</th></tr></thead><tbody>
        <% for each quoteRec in rdQuotes { supplierLabel = "Supplier not set"; if(quoteRec.Supplier != null) { supplierLabel = quoteRec.Supplier.Supplier_Name; } %><tr><td data-label='Quote' class='zcs-px-16 zcs-py-8'><a class='record-link' href='#Report:All_Supplier_Quotes?ID=<%=quoteRec.ID%>'><%=quoteRec.Supplier_Quote_ID%></a><div class='meta'><%=quoteRec.Quote_Date%></div></td><td data-label='Requirement' class='zcs-px-16 zcs-py-8'><a class='record-link' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=quoteRec.Sales_Order.ID%>'><%=quoteRec.Sales_Order.Sales_Order_ID%></a></td><td data-label='Supplier' class='zcs-px-16 zcs-py-8'><%=supplierLabel%></td><td data-label='Availability' class='zcs-px-16 zcs-py-8'><%=ifnull(quoteRec.Availability,"Not stated")%></td><td data-label='Lead time' class='zcs-px-16 zcs-py-8'><%=ifnull(quoteRec.Lead_Time,"Not stated")%></td><td data-label='State' class='zcs-px-16 zcs-py-8'><span class='zcs-badge zcs-badge-filled <% if(quoteRec.Status == "Selected") { %>zcs-badge-green<% } else { %>zcs-badge-yellow<% } %> zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'><%=ifnull(quoteRec.Status,"Submitted")%></span></td></tr><% } %>
        </tbody></table></div><% } else { %><div class='section-body zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-nodata-content zcs-p-20'><i class='empty-icon zc-li-outline arrows-2-file-download-87'></i><h5 class='zcs-font-18 zcs-font-medium zcs-m-0'>No sourcing evidence yet</h5><p class='zcs-color-secondary zcs-mt-10'>Supplier quotes linked to these market-need orders will appear here.</p></div></div><% } %>
      </section>
    </div>

    <div class='stack'>
      <section class='section zcs-card'>
        <div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='title-icon zc-li-outline tech-computer'></i><span class='zcs-font-16 zcs-font-semibold'>Product demand</span><span class='section-count'><%=rdProductCount%> lines</span></div><a class='section-link' href='#Page:Products'>Product catalog</a></div>
        <% if(rdProductCount > 0) { %><div class='section-body list'><% for each productRec in rdProducts { %><div class='list-row zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div class='zcs-col-common'><div class='record-title'><%=ifnull(productRec.Product_Name,"Unnamed product")%></div><div class='meta'><%=ifnull(productRec.Product_Category,"Category not set")%> | <%=ifnull(productRec.Brand_Make,"Brand not set")%> <%=ifnull(productRec.Model,"")%></div><div class='meta'><a class='record-link' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=productRec.Parent_Sales_Order.ID%>'>Requirement <%=productRec.Parent_Sales_Order.Sales_Order_ID%></a> | <%=ifnull(productRec.Required_Availability,"Availability not set")%></div><div class='meta'><%=ifnull(productRec.Configuration,"Configuration pending")%></div></div><span class='qty'><%=ifnull(productRec.Quantity,0)%></span></div><% } %></div><% } else { %><div class='section-body zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-nodata-content zcs-p-20'><i class='empty-icon zc-li-outline tech-computer'></i><h5 class='zcs-font-18 zcs-font-medium zcs-m-0'>No product demand recorded</h5><p class='zcs-color-secondary zcs-mt-10'>Product lines added to the filtered requirements will appear here.</p></div></div><% } %>
      </section>

      <section class='section zcs-card'>
        <div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='title-icon zc-li-outline business-chart-bar-32'></i><span class='zcs-font-16 zcs-font-semibold'>Ready for comparison</span><span class='section-count'><%=comparisonReadyCount%></span></div></div>
        <div class='section-body list'><% if(comparisonReadyCount > 0) { for each compareOrder in rdOrders { compareQuoteCount = Add_Supplier_Quote[Sales_Order == compareOrder.ID].count(); if(compareQuoteCount > 1 && compareOrder.Selected_Supplier_Quote == null) { %><div class='list-row'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><div><div class='record-title'><%=compareOrder.Sales_Order_ID%></div><div class='meta'><%=compareQuoteCount%> comparable responses; no quote selected</div></div><span class='zcs-badge zcs-badge-filled zcs-badge-green zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'>Ready</span></div><a class='zcs-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-mt-10' href='#Page:Quote_Comparison?Sales_Order_ID=<%=compareOrder.ID%>'><i class='zc-li-outline arrows-1-tail-right'></i><span>Compare quotes</span></a></div><% } } } else { %><div class='zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-nodata-content zcs-p-20'><i class='empty-icon zc-li-outline business-chart-bar-32'></i><h5 class='zcs-font-18 zcs-font-medium zcs-m-0'>Nothing ready to compare</h5><p class='zcs-color-secondary zcs-mt-10'>Readiness requires at least two quotes and no selected quote.</p></div></div><% } %></div>
      </section>

      <section class='section zcs-card'>
        <div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='title-icon zc-li-outline e-commerce-shopping-cart-simple'></i><span class='zcs-font-16 zcs-font-semibold'>Purchase orders</span><span class='section-count'><%=rdPOCount%></span></div><a class='section-link' href='#Report:All_Purchase_Orders'>Open PO register</a></div>
        <% if(rdPOCount > 0) { %><div class='section-body list'><% for each poRec in rdPOs { supplierName = "Supplier not set"; if(poRec.Supplier != null) { supplierName = poRec.Supplier.Supplier_Name; } %><div class='list-row'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div><a class='record-link' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=poRec.ID%>'><%=poRec.Purchase_Order_ID%></a><div class='meta'><%=supplierName%> | Requirement <%=poRec.Sales_Order.Sales_Order_ID%></div><div class='meta'>Created <%=poRec.PO_Date%> | Expected <%=ifnull(poRec.Expected_Delivery_Date,"Not set")%></div></div><a class='icon-action' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=poRec.ID%>' title='Open purchase order'><i class='zc-li-outline arrows-1-tail-right'></i></a></div><div class='zcs-mt-10'><span class='zcs-badge zcs-badge-filled zcs-badge-orange zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2'><%=ifnull(poRec.Status,"Status not set")%></span></div></div><% } %></div><% } else { %><div class='section-body zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-nodata-content zcs-p-20'><i class='empty-icon zc-li-outline e-commerce-shopping-cart-simple'></i><h5 class='zcs-font-18 zcs-font-medium zcs-m-0'>No downstream purchase orders</h5><p class='zcs-color-secondary zcs-mt-10'>Purchase orders created from selected quotes for these requirements will appear here.</p></div></div><% } %>
      </section>
    </div>
  </div>
</div>