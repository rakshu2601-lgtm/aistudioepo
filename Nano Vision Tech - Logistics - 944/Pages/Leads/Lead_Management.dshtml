<%
allCount = Add_Lead.count();
newCount = Add_Lead[Status == "New"].count();
createdCount = Add_Lead[Status == "Sales Order Created"].count();
lostCount = Add_Lead[Status == "Lost"].count();
leads = Add_Lead[ID != 0] sort by Lead_Date desc;
%>
<style>
/* ZCS global utilities used on this page */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#f4f6f8;--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);font-size:16px;line-height:1.5}*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-14{padding-left:.875rem;padding-right:.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-9{padding-top:.5625rem;padding-bottom:.5625rem}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-text-left{text-align:left}.zcs-w-full{width:100%}.zcs-m-0{margin:0}.zcs-sticky{position:sticky}a{text-decoration:none}
.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%;width:100%}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important}#splash-screen,.zc-pb-page-loader{display:none!important}
.leads-page{min-height:100%;padding:18px;background:var(--zcs-page-bg-color);font:14px/1.45 Arial,sans-serif;color:var(--zcs-primary-text-color)}.leads-shell{max-width:1600px;margin:auto}.zcs-page-header{padding:2px 2px 14px}.title-wrap{min-width:0}.title-icon{width:34px;height:34px;border:1px solid var(--zcs_tertiary_border_color);background:var(--zcs-white-color);color:var(--zcs_brand_color);border-radius:9px;font-size:17px;flex:0 0 auto}.page-title{font-size:24px;letter-spacing:-.02em}.page-subtitle,.register-note,.muted{color:var(--zcs-secondary-text-color)}.page-subtitle,.register-note{margin:2px 0 0}
.summary-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;margin-bottom:12px;overflow:hidden}.summary-item{padding:10px 14px;border-right:1px solid var(--zcs_tertiary_border_color);display:flex;align-items:center;justify-content:space-between;gap:10px}.summary-item:last-child{border-right:0}.summary-label{color:var(--zcs-secondary-text-color);font-size:12px}.summary-value{font-size:18px}.summary-new i{color:#2a6ffc}.summary-won i{color:#179e6c}.summary-lost i{color:#c8485b}
.register{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;overflow:hidden}.register-head{padding:12px 14px;border-bottom:1px solid var(--zcs_tertiary_border_color)}.register-title{font-size:16px}.record-count{color:var(--zcs-secondary-text-color);white-space:nowrap}.zcs-table-wrapper{height:560px;overflow:auto;background:var(--zcs-white-color)}.zcs-table-wrapper table{border-collapse:collapse;min-width:1280px}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:#f7f8fa;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap;color:var(--zcs-secondary-text-color);font-size:12px;font-weight:600}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:middle}.zcs-table-wrapper tbody tr:first-child td{border-top:0}.zcs-table-wrapper tbody tr:hover td{background:#fafbfc}.identity{min-width:170px}.lead-link{font-weight:600;color:var(--zcs_brand_color)}.company{display:block;font-weight:500;margin-top:2px}.subline{display:block;color:var(--zcs-secondary-text-color);font-size:12px;margin-top:2px}.contact{min-width:190px}.need{max-width:220px;white-space:normal}.value{font-weight:600;white-space:nowrap}.owner{display:inline-flex;align-items:center;gap:6px;white-space:nowrap}.owner-icon{width:25px;height:25px;border-radius:50%;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);display:inline-flex;align-items:center;justify-content:center}.product-count{display:inline-flex;align-items:center;justify-content:center;min-width:28px;height:25px;border-radius:6px;background:#f0f2f6;font-weight:600}.zcs-badge{width:auto;border:1px solid;white-space:nowrap;font-size:12px}.zcs-badge-blue{background:#eef3ff;border-color:#bdd0ff;color:#245dc1}.zcs-badge-green{background:#e9f8f2;border-color:#b8e6d4;color:#147b58}.zcs-badge-red{background:#fbedef;border-color:#efc2c9;color:#a93447}.zcs-badge-grey{background:#f1f2f4;border-color:#d7d9de;color:#515660}.row-actions{white-space:nowrap}.record-action{color:var(--zcs-secondary-text-color);border:1px solid var(--zcs_tertiary_border_color);background:#fff}.record-action:hover{color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.record-action.primary{color:var(--zcs_brand_color);border-color:var(--zcs_brand_color)}
.mobile-list{display:none}.mobile-card{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;padding:13px}.mobile-top,.mobile-footer{display:flex;align-items:center;justify-content:space-between;gap:10px}.mobile-contact{margin:10px 0;padding:9px 0;border-top:1px solid var(--zcs_tertiary_border_color);border-bottom:1px solid var(--zcs_tertiary_border_color)}.mobile-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:11px}.mobile-label{display:block;color:var(--zcs-secondary-text-color);font-size:11px;margin-bottom:2px}.empty{min-height:300px;text-align:center}.empty-icon{width:50px;height:50px;margin:0 auto 10px;border-radius:12px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:22px}.empty p{margin:6px 0 0}
@media(max-width:900px){.summary-strip{grid-template-columns:1fr 1fr}.summary-item:nth-child(2){border-right:0}.summary-item:nth-child(-n+2){border-bottom:1px solid var(--zcs_tertiary_border_color)}.desktop-table{display:none}.mobile-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;padding:10px;background:#f7f8fa}.register-head{padding:11px 12px}}
@media(max-width:620px){.leads-page{padding:10px}.zcs-page-header{padding-bottom:10px}.page-title{font-size:21px}.page-subtitle{font-size:12px}.summary-item{padding:9px 10px}.summary-value{font-size:16px}.mobile-list{grid-template-columns:1fr}.register-note{display:none}}
</style>
<div class='leads-page'><div class='leads-shell'>
  <header class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center'>
    <div class='title-wrap zcs-flex zcs-align-items-center zcs-gap-12'><span class='title-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-3-menu-left'></i></span><div><h1 class='page-title zcs-m-0'>Lead register</h1><p class='page-subtitle'>Pipeline ownership, contact context and value at a glance.</p></div></div>
  </header>
  <div class='summary-strip' aria-label='Pipeline summary'>
    <div class='summary-item'><span><span class='summary-label'>All leads</span></span><strong class='summary-value'><%=allCount%></strong></div>
    <div class='summary-item summary-new'><span class='zcs-flex zcs-align-items-center zcs-gap-6'><i class='zc-li-outline ui-3-send'></i><span class='summary-label'>New</span></span><strong class='summary-value'><%=newCount%></strong></div>
    <div class='summary-item summary-won'><span class='zcs-flex zcs-align-items-center zcs-gap-6'><i class='zc-li-outline ui-1-check-circle-08'></i><span class='summary-label'>Sales order created</span></span><strong class='summary-value'><%=createdCount%></strong></div>
    <div class='summary-item summary-lost'><span class='zcs-flex zcs-align-items-center zcs-gap-6'><i class='zc-li-outline ui-1-circle-remove'></i><span class='summary-label'>Lost</span></span><strong class='summary-value'><%=lostCount%></strong></div>
  </div>
  <section class='register'>
    <div class='register-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div><h2 class='register-title zcs-m-0'>Operational pipeline</h2><p class='register-note'>Newest first. Open a record for full context.</p></div><span class='record-count'><%=allCount%> records</span></div>
    <%if(allCount == 0){%>
      <div class='empty zcs-flex zcs-align-items-center zcs-justify-center'><div class='zcs-p-20 zcs-text-left'><div class='empty-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-3-send'></i></div><h3 class='zcs-font-18 zcs-font-medium zcs-m-0'>No leads in the register</h3><p class='muted'>New leads will appear here with their owner and pipeline status.</p></div></div>
    <%}else{%>
      <div class='desktop-table zcs-table-wrapper'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-14 zcs-py-9 zcs-text-left'>Lead</th><th class='zcs-px-14 zcs-py-9 zcs-text-left'>Contact</th><th class='zcs-px-14 zcs-py-9 zcs-text-left'>Requirement</th><th class='zcs-px-14 zcs-py-9 zcs-text-left'>Value</th><th class='zcs-px-14 zcs-py-9 zcs-text-left'>Lead date</th><th class='zcs-px-14 zcs-py-9 zcs-text-left'>Owner</th><th class='zcs-px-14 zcs-py-9 zcs-text-left'>Status</th><th class='zcs-px-14 zcs-py-9 zcs-text-left'>Products</th><th class='zcs-px-14 zcs-py-9 zcs-text-left'>Actions</th></tr></thead><tbody>
      <%for each lead in leads
      {
        productCount = Lead_Product[Parent_Lead == lead.ID].count();
        badgeClass = "zcs-badge-grey";
        if(lead.Status == "New")
        {
          badgeClass = "zcs-badge-blue";
        }
        else if(lead.Status == "Sales Order Created")
        {
          badgeClass = "zcs-badge-green";
        }
        else if(lead.Status == "Lost")
        {
          badgeClass = "zcs-badge-red";
        }
      %>
        <tr>
          <td class='identity zcs-px-14 zcs-py-9'><a class='lead-link' href='#Page:Lead_Detail?Lead_ID=<%=lead.ID%>'><%=lead.Lead_ID%></a><span class='company'><%=ifnull(lead.Customer_Company_Name,"-")%></span><span class='subline'><%=ifnull(lead.Lead_Source,"Source not set")%></span></td>
          <td class='contact zcs-px-14 zcs-py-9'><span class='zcs-font-medium'><%=ifnull(lead.Contact_Person,"-")%></span><span class='subline'><i class='zc-li-outline ui-1-email-83'></i> <%=ifnull(lead.Email,ifnull(lead.Phone,"No contact details"))%></span></td>
          <td class='zcs-px-14 zcs-py-9'><div class='need'><%=ifnull(lead.Requirement,"Not specified")%></div></td>
          <td class='zcs-px-14 zcs-py-9'><span class='value'>$<%=ifnull(lead.Expected_Price,0)%></span></td>
          <td class='zcs-px-14 zcs-py-9'><%=lead.Lead_Date%></td>
          <td class='zcs-px-14 zcs-py-9'><span class='owner'><span class='owner-icon'><i class='zc-li-outline users-single-05'></i></span><%=ifnull(lead.Sales_Agent,"Unassigned")%></span></td>
          <td class='zcs-px-14 zcs-py-9'><span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 <%=badgeClass%>'><%=ifnull(lead.Status,"Unknown")%></span></td>
          <td class='zcs-px-14 zcs-py-9'><span class='product-count'><%=productCount%></span></td>
          <td class='row-actions zcs-px-14 zcs-py-9'><a class='record-action primary zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-sm' href='#Page:Lead_Detail?Lead_ID=<%=lead.ID%>'><i class='zc-li-outline arrows-1-tail-right'></i>Open</a> <a class='record-action zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-sm' href='#Report:All_Histories?Lead_Lookup=<%=lead.ID%>'><i class='zc-li-outline ui-2-time'></i>History</a></td>
        </tr>
      <%}%>
      </tbody></table></div>
      <div class='mobile-list'>
      <%for each lead in leads
      {
        productCount = Lead_Product[Parent_Lead == lead.ID].count();
        badgeClass = "zcs-badge-grey";
        if(lead.Status == "New")
        {
          badgeClass = "zcs-badge-blue";
        }
        else if(lead.Status == "Sales Order Created")
        {
          badgeClass = "zcs-badge-green";
        }
        else if(lead.Status == "Lost")
        {
          badgeClass = "zcs-badge-red";
        }
      %>
        <article class='mobile-card'>
          <div class='mobile-top'><div><a class='lead-link' href='#Page:Lead_Detail?Lead_ID=<%=lead.ID%>'><%=lead.Lead_ID%></a><span class='subline'><%=ifnull(lead.Customer_Company_Name,"-")%></span></div><span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 <%=badgeClass%>'><%=ifnull(lead.Status,"Unknown")%></span></div>
          <div class='mobile-contact'><strong><%=ifnull(lead.Contact_Person,"-")%></strong><span class='subline'><i class='zc-li-outline ui-1-email-83'></i> <%=ifnull(lead.Email,ifnull(lead.Phone,"No contact details"))%></span><span class='subline'><%=ifnull(lead.Requirement,"Not specified")%></span></div>
          <div class='mobile-grid'><div><span class='mobile-label'>Value</span><strong>$<%=ifnull(lead.Expected_Price,0)%></strong></div><div><span class='mobile-label'>Owner</span><span><i class='zc-li-outline users-single-05'></i> <%=ifnull(lead.Sales_Agent,"Unassigned")%></span></div><div><span class='mobile-label'>Lead date</span><%=lead.Lead_Date%></div><div><span class='mobile-label'>Products</span><%=productCount%></div></div>
          <div class='mobile-footer'><span class='subline'><%=ifnull(lead.Lead_Source,"Source not set")%></span><span><a class='record-action primary zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-sm' href='#Page:Lead_Detail?Lead_ID=<%=lead.ID%>'>Open <i class='zc-li-outline arrows-1-tail-right'></i></a> <a class='record-action zcs-inline-flex zcs-align-items-center zcs-px-10 zcs-py-6 zcs-rounded-sm' href='#Report:All_Histories?Lead_Lookup=<%=lead.ID%>' title='History'><i class='zc-li-outline ui-2-time'></i></a></span></div>
        </article>
      <%}%>
      </div>
    <%}%>
  </section>
</div></div>