<%
requestList = Create_Return_Request[ID == input.Return_Request_ID];
%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color,#6147E5);--zcs-light-bg-color:var(--zcs_brand_light_color,#F1EDFF);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color,#1C1C40);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#65657A);--zcs-tertiary-text-color:var(--zcs_tertiary_text_color,#878895);--zcs-border-color:var(--zcs_tertiary_border_color,#E7E7EE);--zcs-white-color:#FFF;font-size:16px;line-height:1.5}*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-row-wrap{flex-wrap:wrap}.zcs-gap-4{gap:4px}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-gap-24{gap:24px}.zcs-p-0{padding:0}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-12{padding-top:12px;padding-bottom:12px}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:4px}.zcs-mt-8{margin-top:8px}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-half{border-radius:50%}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-22{font-size:22px}.zcs-font-24{font-size:24px}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-tertiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}a{text-decoration:none}
#splash-screen{display:none!important}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .Layout.elemContainment,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%!important;padding:0!important}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important;border-radius:0!important}
.zcs-badge{width:max-content;white-space:nowrap;border:1px solid}.zcs-badge-green{background:#E4FCF3;border-color:#179E6C;color:#117A55}.zcs-badge-red{background:#FDE3E6;border-color:#FE455D;color:#C52F43}.zcs-badge-blue{background:#E8EFFF;border-color:#2A6FFC;color:#245AC7}.zcs-badge-yellow{background:#FCF4E6;border-color:#FAAE13;color:#966109}.zcs-badge-violet{background:#F7EEFD;border-color:#8200DB;color:#6C1AA5}.zcs-button{width:auto;min-height:36px;border:1px solid var(--zcs-theme-brand-color)}.zcs-primary-button{background:var(--zcs-theme-brand-color);color:#FFF}.zcs-primary-outline-button{background:#FFF;color:var(--zcs-theme-brand-color)}.zcs-toast{border-left:4px solid}.zcs-success-toast{background:#edf7ed;color:#1d4620;border-color:#2e7d32}.zcs-info-toast{background:#e4f6fd;color:#024361;border-color:#0588d1}.zcs-warning-toast{background:#fef4e5;color:#663c01;border-color:#ed6c03}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:#FFF;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:860px}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper thead th{background:#F9FAFE;box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper tbody td{border-top:1px solid var(--zcs-border-color);vertical-align:top}.zcs-table-wrapper tbody tr:hover td{background:#F9FAFE}.zcs-tl-indicator{width:28px;left:0}.zcs-tl-dot{width:10px;height:10px;background:var(--zcs-theme-brand-color);border:1px solid #FFF;box-shadow:0 2px 6px #C4DEE4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:'';position:absolute;width:1px;height:calc(100% + 20px);background:#E1E1E1;top:5px}
.rrd-page{height:100%;overflow:auto;background:var(--zcs-page-bg-color);padding:16px;font:14px/1.5 Arial,sans-serif;color:var(--zcs-primary-text-color)}.rrd-shell{max-width:1500px;margin:auto}.rrd-stack{display:flex;flex-direction:column;gap:16px}.identity{padding:16px 20px}.back-link{width:34px;height:34px;border:1px solid var(--zcs-border-color);color:var(--zcs-secondary-text-color);flex:0 0 auto}.eyebrow{font-size:11px;letter-spacing:.08em;color:var(--zcs-tertiary-text-color);font-weight:600}.identity h1{font-size:22px;margin:1px 0}.identity-meta{color:var(--zcs-secondary-text-color);overflow-wrap:anywhere}.section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px}.section-title{font-size:16px;font-weight:600;margin:0}.section-note,.meta{font-size:12px;color:var(--zcs-secondary-text-color)}.workspace{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(320px,.75fr);gap:16px;align-items:start}.workspace-main,.workspace-side{display:flex;flex-direction:column;gap:16px}.workspace-side{position:sticky;top:16px}.context-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.context-item{padding:13px;background:#F9FAFE;border:1px solid var(--zcs-border-color);border-radius:8px;min-width:0}.context-item label{display:block;font-size:12px;color:var(--zcs-secondary-text-color);margin-bottom:4px}.context-item strong,.context-item span{display:block;overflow-wrap:anywhere}.context-icon{width:30px;height:30px;flex:0 0 30px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color)}.narrative{white-space:pre-wrap;overflow-wrap:anywhere;min-height:88px;padding:14px;background:#F9FAFE;border:1px solid var(--zcs-border-color);border-radius:8px}.resolution-callout{padding:14px;background:var(--zcs-light-bg-color);border-radius:8px}.resolution-callout label{display:block;font-size:12px;color:var(--zcs-secondary-text-color)}.resolution-actions{display:grid;grid-template-columns:1fr;gap:8px;margin-top:14px}.link{color:var(--zcs-theme-brand-color)}.stepper{display:flex;padding:4px 0 2px}.step{flex:1;position:relative;text-align:center;color:var(--zcs-tertiary-text-color)}.step:not(:last-child):before{content:'';position:absolute;top:15px;left:50%;width:100%;height:1px;background:var(--zcs-border-color)}.step-dot{position:relative;z-index:1;width:30px;height:30px;margin:0 auto 6px;border:1px solid var(--zcs-border-color);background:#FFF}.step.done .step-dot{background:#179E6C;border-color:#179E6C;color:#FFF}.step.active .step-dot{border-color:var(--zcs-theme-brand-color);color:var(--zcs-theme-brand-color);background:var(--zcs-light-bg-color)}.step.done:not(:last-child):before{background:#179E6C}.document-link{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 12px;border:1px solid var(--zcs-border-color);border-radius:8px;color:var(--zcs-primary-text-color)}.related-scroll{height:360px;overflow:auto}.history-scroll{height:360px;overflow:auto;padding-right:6px}.timeline-content{padding-left:36px}.history-note,.text-block{white-space:pre-wrap;overflow-wrap:anywhere}.empty{height:140px;color:var(--zcs-secondary-text-color)}.product-cards{display:none}.not-found{min-height:320px}.qty{font-variant-numeric:tabular-nums}
@media(max-width:980px){.workspace{grid-template-columns:1fr}.workspace-side{position:static}.context-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:700px){.rrd-page{height:auto;padding:10px}.identity{align-items:flex-start;flex-direction:column}.context-grid{grid-template-columns:1fr}.stepper{flex-direction:column;gap:12px}.step{display:flex;align-items:center;gap:10px;text-align:left}.step-dot{margin:0}.step:not(:last-child):before{top:28px;left:14px;width:1px;height:28px}.desktop-products{display:none}.product-cards{display:flex;height:420px;overflow:auto}.product-card{padding:14px;border:1px solid var(--zcs-border-color);border-radius:8px}.related-scroll,.history-scroll{height:420px}.zcs-card{padding:14px!important}}
</style>
<div class='rrd-page'><div class='rrd-shell'>
<%if(requestList.count() == 0){%>
<div class='zcs-card not-found zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><i class='zc-li-outline ui-1-search-zoom-out zcs-font-24 zcs-color-theme'></i><h2 class='zcs-font-18 zcs-font-medium'>Return request not found</h2><p class='zcs-color-secondary'>No accessible record matches this Return_Request_ID.</p><a class='link zcs-font-semibold' href='#Page:Return_Requests'><i class='zc-li-outline arrows-1-tail-left'></i> Return requests</a></div></div>
<%}else{request=requestList;products=Return_Request_Product[Parent_Return_Request == request.ID] sort by ID asc;history=Add_History[Return_Request_Lookup == request.ID] sort by Updated_Date_Time desc;latestStatus="Submitted";latestFound=false;for each statusEvent in history{if(!latestFound){latestStatus=ifnull(statusEvent.New_Status,ifnull(statusEvent.Status,"Submitted"));latestFound=true;}}isResolved=latestStatus.toLowerCase().contains("resolved") || latestStatus.toLowerCase().contains("complete") || latestStatus.toLowerCase().contains("closed");isRejected=latestStatus.toLowerCase().contains("reject") || latestStatus.toLowerCase().contains("cancel");statusClass=if(isResolved,"zcs-badge-green",if(isRejected,"zcs-badge-red","zcs-badge-blue"));nextStep=if(isResolved,"Resolution complete",if(isRejected,"Review closure notes",if(request.Damage_Responsibility == "Supplier","Confirm supplier remedy and financial recovery","Record decision, quantities, and customer outcome")));supplierName="Not set";poLabel="Not set";poStatus="Not set";poCurrency="";poValue=0.0;salesOrderLabel="Not set";customerName="Not set";createdBy="Not set";poID=null;salesOrderID=null;if(request.Customer != null){customerName=ifnull(request.Customer.Customer_Name,"Not set");}if(request.Sales_Order != null){salesOrderID=request.Sales_Order.ID;salesOrderLabel=ifnull(request.Sales_Order.Sales_Order_ID,"Not set");}if(request.Purchase_Order != null){poID=request.Purchase_Order.ID;poLabel=ifnull(request.Purchase_Order.Purchase_Order_ID,"Not set");poStatus=ifnull(request.Purchase_Order.Status,"Not set");poCurrency=ifnull(request.Purchase_Order.Currency,"");poValue=ifnull(request.Purchase_Order.Supplier_Price,0.0);if(request.Purchase_Order.Supplier != null){supplierName=ifnull(request.Purchase_Order.Supplier.Supplier_Name,"Not set");}}if(request.Created_By != null){createdBy=ifnull(request.Created_By.Employee_Name,ifnull(request.Created_By_Email,"Not set"));}else{createdBy=ifnull(request.Created_By_Email,"Not set");}totalDelivered=0.0;totalReturned=0.0;estimatedReturnValue=0.0;evidenceCount=0;if(request.Attachments != null && request.Attachments != ""){evidenceCount=evidenceCount + 1;}for each calcItem in products{deliveredQty=ifnull(calcItem.Delivered_Quantity,0.0);returnedQty=ifnull(calcItem.Return_Quantity,0.0);totalDelivered=totalDelivered + deliveredQty;totalReturned=totalReturned + returnedQty;if(calcItem.Attachments != null && calcItem.Attachments != ""){evidenceCount=evidenceCount + 1;}if(calcItem.Purchase_Order_Product != null){unitPrice=ifnull(calcItem.Purchase_Order_Product.Supplier_Unit_Price,0.0);estimatedReturnValue=estimatedReturnValue + (returnedQty * unitPrice);}}returnShare=0.0;if(totalDelivered > 0){returnShare=(totalReturned * 100.0) / totalDelivered;}%>
<div class='rrd-stack'>
<header class='identity zcs-card zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16'><div class='zcs-flex zcs-align-items-center zcs-gap-12'><a class='back-link zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-md' href='#Page:Return_Requests'><i class='zc-li-outline arrows-1-tail-left'></i></a><div><div class='eyebrow'>RETURN REQUEST</div><h1><%=request.Return_Request_ID%></h1><div class='identity-meta'><%=customerName%> | <%=ifnull(request.Return_Date,"Return date not set")%></div></div></div><span class='zcs-badge zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-px-10 zcs-py-2 zcs-rounded-sm <%=statusClass%>'><i class='zc-li-outline <%=if(isResolved,"ui-1-check-circle-08",if(isRejected,"ui-1-circle-remove","loader-dots-06"))%>'></i><%=latestStatus%></span></header>
<div class='zcs-toast <%=if(isResolved,"zcs-success-toast",if(isRejected,"zcs-warning-toast","zcs-info-toast"))%> zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm'><i class='zc-li-outline <%=if(isResolved,"ui-1-check-circle-08",if(isRejected,"ui-3-alert","travel-info"))%>'></i><div><strong>Next step</strong><div><%=nextStep%></div></div></div>
<div class='workspace'><main class='workspace-main'>
<section class='zcs-card zcs-p-20'><div class='section-head'><div><h2 class='section-title'>Return context</h2><div class='section-note'>Source, parties, quantities, and exposure</div></div><span class='zcs-badge zcs-badge-violet zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=products.count()%> products</span></div><div class='context-grid'><div class='context-item zcs-flex zcs-gap-12'><span class='context-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline users-single-02'></i></span><div><label>Customer</label><strong><%=customerName%></strong><span class='meta'>Created by <%=createdBy%></span></div></div><div class='context-item zcs-flex zcs-gap-12'><span class='context-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline business-handshake'></i></span><div><label>Supplier</label><strong><%=supplierName%></strong><span class='meta'>PO status: <%=poStatus%></span></div></div><div class='context-item zcs-flex zcs-gap-12'><span class='context-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline files-single-folded-content'></i></span><div><label>Purchase order</label><%if(poID != null){%><a class='link zcs-font-semibold' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=poID%>'><%=poLabel%></a><%}else{%><strong>Not set</strong><%}%><span class='meta'><%=poCurrency%> <%=poValue%></span></div></div><div class='context-item zcs-flex zcs-gap-12'><span class='context-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i></span><div><label>Sales order</label><%if(salesOrderID != null){%><a class='link zcs-font-semibold' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=salesOrderID%>'><%=salesOrderLabel%></a><%}else{%><strong>Not set</strong><%}%><span class='meta'>Return date: <%=ifnull(request.Return_Date,"Not set")%></span></div></div><div class='context-item zcs-flex zcs-gap-12'><span class='context-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline arrows-2-reload'></i></span><div><label>Returned quantity</label><strong class='qty'><%=totalReturned%> / <%=totalDelivered%></strong><span class='meta'><%=returnShare.round(1)%>% of delivered scope</span></div></div><div class='context-item zcs-flex zcs-gap-12'><span class='context-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline business-coins'></i></span><div><label>Estimated return value</label><strong><%=poCurrency%> <%=estimatedReturnValue.round(2)%></strong><span class='meta'><%=evidenceCount%> attachment groups</span></div></div></div><div class='context-grid zcs-mt-8'><div><h3 class='zcs-font-14 zcs-font-semibold'>Issue description</h3><div class='narrative'><%=ifnull(request.Issue_Description,"No issue description provided")%></div></div><div><h3 class='zcs-font-14 zcs-font-semibold'>Return remarks</h3><div class='narrative'><%=ifnull(request.Return_Remarks,"No resolution remarks recorded")%></div></div></div></section>
<section class='zcs-card zcs-p-20'><div class='section-head'><div><h2 class='section-title'>Affected products</h2><div class='section-note'>Configuration, quantities, defect, responsibility, and evidence</div></div><span class='zcs-badge zcs-badge-blue zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=products.count()%> rows</span></div><%if(products.count()==0){%><div class='empty zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center'><i class='zc-li-outline e-commerce-box zcs-font-22 zcs-color-tertiary'></i><strong>No returned products</strong><span>Add affected products from the return request.</span></div><%}else{%><div class='zcs-table-wrapper desktop-products related-scroll zcs-rounded-md zcs-relative'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Product</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Configuration / serial</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Delivered</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Returned</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Defect / owner</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Evidence / remarks</th></tr></thead><tbody><%for each item in products{%><tr><td class='zcs-px-16 zcs-py-8'><strong><%=ifnull(item.Product_Name,"Unnamed product")%></strong><span class='meta'><%=ifnull(item.Product_ID,"No product ID")%> | <%=ifnull(item.Product_Category,"No category")%></span><span class='meta'><%=ifnull(item.Manufacturer_Part_Number,"No MPN")%> | <%=ifnull(item.Internal_Part_Number,"No internal part")%></span></td><td class='zcs-px-16 zcs-py-8 text-block'><%=ifnull(item.Configuration,"Not set")%><span class='meta'>Serial: <%=ifnull(item.Serial_Number,"Not set")%></span></td><td class='zcs-px-16 zcs-py-8 zcs-text-right qty'><%=ifnull(item.Delivered_Quantity,0)%> <%=ifnull(item.Unit_of_Measure,"")%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-semibold qty'><%=ifnull(item.Return_Quantity,0)%> <%=ifnull(item.Unit_of_Measure,"")%></td><td class='zcs-px-16 zcs-py-8 text-block'><%=ifnull(item.Defect_Description,"No defect description")%><span class='zcs-badge zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm <%=if(item.Damage_Responsibility == "Supplier","zcs-badge-yellow","zcs-badge-blue")%>'><%=ifnull(item.Damage_Responsibility,"Not assigned")%></span></td><td class='zcs-px-16 zcs-py-8'><%if(item.Attachments != null && item.Attachments != ""){%><a class='link zcs-font-semibold' href='<%=item.Attachments%>' target='_blank'><i class='zc-li-outline files-single'></i> Evidence</a><%}else{%><span class='zcs-color-tertiary'>No evidence</span><%}%><span class='meta text-block'><%=ifnull(item.Remarks,"No remarks")%></span></td></tr><%}%></tbody></table></div><div class='product-cards zcs-direction-column zcs-gap-12'><%for each card in products{%><article class='product-card'><div class='zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-12'><div><strong><%=ifnull(card.Product_Name,"Unnamed product")%></strong><div class='meta'><%=ifnull(card.Product_ID,"No product ID")%></div></div><span class='zcs-badge zcs-px-10 zcs-py-2 zcs-rounded-sm <%=if(card.Damage_Responsibility == "Supplier","zcs-badge-yellow","zcs-badge-blue")%>'><%=ifnull(card.Damage_Responsibility,"Not assigned")%></span></div><div class='context-grid zcs-mt-8'><div><span class='meta'>Delivered</span><strong><%=ifnull(card.Delivered_Quantity,0)%></strong></div><div><span class='meta'>Returned</span><strong><%=ifnull(card.Return_Quantity,0)%></strong></div></div><p class='text-block'><%=ifnull(card.Defect_Description,"No defect description")%></p><%if(card.Attachments != null && card.Attachments != ""){%><a class='link zcs-font-semibold' href='<%=card.Attachments%>' target='_blank'><i class='zc-li-outline files-single'></i> Open evidence</a><%}else{%><span class='zcs-color-tertiary'>No product evidence attached</span><%}%></article><%}%></div><%}%></section>
<section class='zcs-card zcs-p-20'><div class='section-head'><div><h2 class='section-title'>Resolution history</h2><div class='section-note'>Latest update first</div></div><a class='link zcs-font-semibold' href='#Report:All_Histories?Return_Request_Lookup=<%=request.ID%>'>Full history <i class='zc-li-outline arrows-1-tail-right'></i></a></div><%if(history.count()==0){%><div class='empty zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center'><i class='zc-li-outline ui-2-time zcs-font-22 zcs-color-tertiary'></i><strong>No history recorded</strong><span>Status and decision updates will appear here.</span></div><%}else{%><div class='history-scroll'><ul class='zcs-flex zcs-direction-column zcs-gap-24 zcs-p-0 zcs-m-0'><%for each event in history{eventBy=ifnull(event.Updated_By_Email,"System");if(event.Updated_By != null){eventBy=ifnull(event.Updated_By.Employee_Name,eventBy);}%><li class='zcs-tl-li zcs-relative' style='list-style:none'><div class='zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute'><span class='zcs-tl-dot zcs-rounded-half zcs-relative'></span></div><div class='timeline-content'><div class='zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8'><strong class='zcs-font-16'><%=event.Action_Type%></strong><span class='zcs-font-12 zcs-color-tertiary'><%=event.Updated_Date_Time%></span></div><div class='zcs-font-13 zcs-color-secondary'>By <%=eventBy%><%if(event.Previous_Status != null || event.New_Status != null){%> | <%=ifnull(event.Previous_Status,"Not set")%> to <%=ifnull(event.New_Status,ifnull(event.Status,"Not set"))%><%}%></div><%if(event.Comments != null && event.Comments != ""){%><p class='history-note zcs-mt-8 zcs-mb-0'><%=event.Comments%></p><%}%><%if(event.Subform_Details_Change_Summary != null && event.Subform_Details_Change_Summary != ""){%><p class='history-note zcs-mt-8 zcs-mb-0 zcs-color-tertiary'><%=event.Subform_Details_Change_Summary%></p><%}%></div></li><%}%></ul></div><%}%></section>
</main><aside class='workspace-side'>
<section class='zcs-card zcs-p-20'><div class='section-head'><div><h2 class='section-title'>Resolution</h2><div class='section-note'><%=history.count()%> recorded updates</div></div><i class='zc-li-outline ui-1-check-circle-08 zcs-font-18 zcs-color-theme'></i></div><div class='stepper'><div class='step done'><div class='step-dot zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half'><i class='zc-li-outline ui-1-check-small'></i></div><strong>Submitted</strong></div><div class='step <%=if(isResolved,"done","active")%>'><div class='step-dot zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half'><i class='zc-li-outline <%=if(isResolved,"ui-1-check-small","loader-dots-06")%>'></i></div><strong>Decision</strong></div><div class='step <%=if(isResolved,"done","")%>'><div class='step-dot zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half'><i class='zc-li-outline <%=if(isResolved,"ui-1-check-small","ui-2-time")%>'></i></div><strong>Resolved</strong></div></div><div class='resolution-callout zcs-mt-8'><label>Decision owner</label><strong><%=ifnull(request.Damage_Responsibility,"Not assigned")%></strong><div class='meta zcs-mt-4'><%=nextStep%></div></div><div class='resolution-actions'><%if(!isResolved && !isRejected){%><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Form:Add_History?Return_Request_Lookup=<%=request.ID%>&amp;Purchase_Order_Lookup=<%=poID%>&amp;Sales_Order_Lookup=<%=salesOrderID%>&amp;Action_Type=Status Changed&amp;zc_LoadIn=dialog'><i class='zc-li-outline ui-1-check-circle-08'></i> Record status</a><%}%><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Form:Create_Return_Request?recLinkID=<%=request.ID%>&amp;viewLinkName=All_Return_Requests&amp;zc_LoadIn=dialog'><i class='zc-li-outline ui-1-edit-72'></i> Update request</a></div></section>
<section class='zcs-card zcs-p-20'><div class='section-head'><div><h2 class='section-title'>Evidence</h2><div class='section-note'><%=evidenceCount%> attachment groups</div></div><i class='zc-li-outline files-folder-15 zcs-font-18 zcs-color-theme'></i></div><%if(request.Attachments == null || request.Attachments == "") {%><div class='empty zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center'><i class='zc-li-outline files-single zcs-font-22 zcs-color-tertiary'></i><strong>No request-level evidence</strong><span>Product evidence remains available in affected products.</span></div><%}else{%><a class='document-link' href='<%=request.Attachments%>' target='_blank'><span class='zcs-flex zcs-align-items-center zcs-gap-12'><i class='zc-li-outline files-folder-15 zcs-font-18'></i><span><strong>Return attachments</strong><small class='meta'>Open submitted evidence</small></span></span><i class='zc-li-outline arrows-2-square-download zcs-color-theme'></i></a><%}%></section>
</aside></div></div><%}%>
</div></div>