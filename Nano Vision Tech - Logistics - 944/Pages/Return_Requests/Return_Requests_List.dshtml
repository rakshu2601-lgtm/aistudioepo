<%
returnRequests = Create_Return_Request[ID != 0] sort by Return_Date desc;
returnTotal = returnRequests.count();
returnUnassignedCount = 0;
returnCompanyCount = 0;
returnSupplierCount = 0;
for each returnSummaryRecord in returnRequests
{
  returnSummaryOwner = ifnull(returnSummaryRecord.Damage_Responsibility,"");
  if(returnSummaryOwner == "Company")
  {
    returnCompanyCount = returnCompanyCount + 1;
  }
  else if(returnSummaryOwner == "Supplier")
  {
    returnSupplierCount = returnSupplierCount + 1;
  }
  else
  {
    returnUnassignedCount = returnUnassignedCount + 1;
  }
}
%>
<style>
/* ZCS global utilities used by this page */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#f5f4f8;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff}
*{box-sizing:border-box}#splash-screen{display:none!important}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%!important}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-w-full{width:100%}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-8{padding-left:8px;padding-right:8px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-6{padding-top:6px;padding-bottom:6px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:8px}.zcs-mt-10{margin-top:10px}.zcs-mt-12{margin-top:12px}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-font-11{font-size:11px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-18{font-size:18px}.zcs-font-22{font-size:22px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}a{text-decoration:none}
.rr-page{min-height:100%;padding:14px;background:var(--zcs-page-bg-color);font:14px/1.45 Arial,sans-serif;color:var(--zcs-primary-text-color)}.rr-header{padding:15px 18px;background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.rr-heading{min-width:0}.rr-icon{width:34px;height:34px;flex:0 0 34px;border-radius:9px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);font-size:17px}.rr-title{font-size:22px}.rr-subtitle{margin:2px 0 0;color:var(--zcs-secondary-text-color);font-size:13px}.rr-total{white-space:nowrap;color:var(--zcs-secondary-text-color);font-size:12px}.rr-total strong{display:block;color:var(--zcs-primary-text-color);font-size:18px;text-align:right}.rr-target{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
.rr-status-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:10px 0}.rr-filter{min-width:0;padding:10px 12px;background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:10px;color:var(--zcs-secondary-text-color);display:flex;align-items:center;justify-content:space-between;gap:8px}.rr-filter span{display:flex;align-items:center;gap:7px;min-width:0}.rr-filter strong{font-size:18px;color:var(--zcs-primary-text-color)}.rr-filter i{color:var(--zcs-theme-brand-color)}.rr-filter:hover{border-color:var(--zcs-theme-brand-color);background:var(--zcs-light-bg-color)}#all:target~.rr-status-strip a[href='#all'],#unassigned:target~.rr-status-strip a[href='#unassigned'],#company:target~.rr-status-strip a[href='#company'],#supplier:target~.rr-status-strip a[href='#supplier']{border-color:var(--zcs-theme-brand-color);box-shadow:0 0 0 1px var(--zcs-theme-brand-color) inset;background:var(--zcs-light-bg-color)}#unassigned:target~.rr-scroll .rr-record:not(.state-unassigned),#company:target~.rr-scroll .rr-record:not(.state-company),#supplier:target~.rr-scroll .rr-record:not(.state-supplier){display:none}
.rr-scroll{height:480px;min-height:320px;overflow:hidden;border-radius:12px}.zcs-table-wrapper{height:100%;border:1px solid var(--zcs-border-color);background:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:1320px}.zcs-table-wrapper thead{top:0;z-index:3}.zcs-table-wrapper thead th{background:#f8f7fb;box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap;color:var(--zcs-secondary-text-color);font-size:12px;text-transform:uppercase;letter-spacing:.03em}.zcs-table-wrapper tbody td{border-top:1px solid var(--zcs-border-color);vertical-align:top;padding-top:12px;padding-bottom:12px}.zcs-table-wrapper tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper tbody tr:hover td{background:#faf9fc}.record-link{font-weight:600;color:var(--zcs-theme-brand-color)}.subtle{display:block;margin-top:3px;color:var(--zcs-secondary-text-color);font-size:12px}.reason{display:block;max-width:260px;white-space:normal}.order-stack{white-space:nowrap}.owner{display:flex;align-items:flex-start;gap:7px}.owner i{margin-top:2px;color:var(--zcs-theme-brand-color)}
.zcs-badge{width:auto;border:1px solid;white-space:nowrap}.zcs-badge-filled-outline.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#147b57}.zcs-badge-filled-outline.zcs-badge-yellow{background:#fcf4e6;border-color:#e6a11a;color:#8a5b00}.zcs-badge-filled-outline.zcs-badge-blue{background:#eee9ff;border-color:#7255c7;color:#6041b4}.zcs-badge-filled-outline.zcs-badge-grey{background:#f1f1f3;border-color:#85858d;color:#55555d}.zcs-primary-outline-button{width:auto;min-width:0;min-height:32px;border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs-theme-brand-color)}.zcs-primary-outline-button:hover{background:var(--zcs-light-bg-color)}
.zcs-nodata-wrapper{height:100%;min-height:320px;background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.empty-icon{width:54px;height:54px;margin:auto;border-radius:50%;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);font-size:24px}.empty-desc{max-width:430px;color:var(--zcs-secondary-text-color)}.mobile-list{display:none;height:100%;overflow:auto}.mobile-card{padding:14px;margin-bottom:9px}.card-head,.card-footer{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.card-grid{margin:12px 0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.kv{min-width:0}.kv-label{display:block;color:var(--zcs-secondary-text-color);font-size:10px;text-transform:uppercase;letter-spacing:.05em}.kv-value{display:block;margin-top:2px;overflow-wrap:anywhere}.card-reason{margin:0 0 12px;padding:10px;border-radius:8px;background:#f8f7fb}.card-owner{margin:0 0 12px}.card-footer{align-items:center;border-top:1px solid var(--zcs-border-color);padding-top:12px}.card-date{color:var(--zcs-secondary-text-color);font-size:12px}
@media(max-width:900px){.rr-page{padding:10px}.rr-status-strip{grid-template-columns:repeat(2,minmax(0,1fr))}.desktop-table{display:none}.mobile-list{display:block}.rr-scroll{height:560px}.rr-total{display:none}}@media(max-width:520px){.rr-header{align-items:flex-start}.rr-icon{display:none}.rr-title{font-size:19px}.rr-status-strip{display:flex;overflow:auto;padding-bottom:2px}.rr-filter{flex:0 0 150px}.card-grid{grid-template-columns:1fr}.zcs-primary-outline-button{min-width:36px}.action-text{display:none}}
</style>
<div class='rr-page'>
  <span id='all' class='rr-target'></span><span id='unassigned' class='rr-target'></span><span id='company' class='rr-target'></span><span id='supplier' class='rr-target'></span>
  <header class='rr-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
    <div class='rr-heading zcs-flex zcs-align-items-center zcs-gap-10'><span class='rr-icon zcs-inline-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline arrows-1-reply-all'></i></span><div><h1 class='rr-title zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Return register</h1><p class='rr-subtitle'>Cause, ownership, resolution state, and linked order context.</p></div></div>
    <div class='rr-total'><strong><%=returnTotal%></strong>total requests</div>
  </header>
  <nav class='rr-status-strip' aria-label='Resolution filters'>
    <a class='rr-filter' href='#all'><span><i class='zc-li-outline ui-1-list-bullet'></i>All returns</span><strong><%=returnTotal%></strong></a>
    <a class='rr-filter' href='#unassigned'><span><i class='zc-li-outline ui-2-time'></i>Unassigned</span><strong><%=returnUnassignedCount%></strong></a>
    <a class='rr-filter' href='#company'><span><i class='zc-li-outline business-briefcase-24'></i>Company owned</span><strong><%=returnCompanyCount%></strong></a>
    <a class='rr-filter' href='#supplier'><span><i class='zc-li-outline transportation-truck-front'></i>Supplier owned</span><strong><%=returnSupplierCount%></strong></a>
  </nav>
  <div class='rr-scroll'>
  <%if(returnTotal == 0){%>
    <section class='zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-nodata-content zcs-p-20 zcs-box-border'><div class='empty-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-1-inbox'></i></div><h2 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0'>No return requests</h2><p class='empty-desc zcs-font-14 zcs-font-normal zcs-lh-body zcs-mt-12 zcs-mx-0 zcs-mb-0'>Return requests will appear here with their reported cause, assigned owner, and linked sales and purchase orders.</p></div></section>
  <%}else{%>
    <div class='zcs-table-wrapper desktop-table zcs-rounded-sm zcs-box-border zcs-relative'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Request</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Cause</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Resolution</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Owner</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Customer</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Linked orders</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Products</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Created by</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Action</th></tr></thead><tbody>
    <%for each returnRegisterRecord in returnRequests{
      registerProductCount=Return_Request_Product[Parent_Return_Request == returnRegisterRecord.ID].count();
      registerResponsibility=ifnull(returnRegisterRecord.Damage_Responsibility,"");
      registerRequestNumber=ifnull(returnRegisterRecord.Return_Request_ID,"Return request");
      registerCustomerName="Not set";if(returnRegisterRecord.Customer != null){registerCustomerName=ifnull(returnRegisterRecord.Customer.Customer_Name,"Not set");}
      registerPurchaseOrderNumber="Not set";if(returnRegisterRecord.Purchase_Order != null){registerPurchaseOrderNumber=ifnull(returnRegisterRecord.Purchase_Order.Purchase_Order_ID,"Not set");}
      registerSalesOrderNumber="Not set";if(returnRegisterRecord.Sales_Order != null){registerSalesOrderNumber=ifnull(returnRegisterRecord.Sales_Order.Sales_Order_ID,"Not set");}
      registerCreatedByName="Not set";if(returnRegisterRecord.Created_By != null){registerCreatedByName=ifnull(returnRegisterRecord.Created_By.Employee_Name.first_name,"Not set");}
      registerReturnDate="Not set";if(returnRegisterRecord.Return_Date != null){registerReturnDate=returnRegisterRecord.Return_Date.toString("dd-MMM-yyyy");}
      registerStateClass="state-unassigned";registerResolution="Needs assignment";registerBadgeClass="zcs-badge-yellow";registerBadgeIcon="ui-2-time";registerOwner="Not assigned";
      if(registerResponsibility == "Company"){registerStateClass="state-company";registerResolution="Internal resolution";registerBadgeClass="zcs-badge-blue";registerBadgeIcon="loader-dots-06";registerOwner="Company";}else if(registerResponsibility == "Supplier"){registerStateClass="state-supplier";registerResolution="Supplier resolution";registerBadgeClass="zcs-badge-green";registerBadgeIcon="ui-1-check-circle-08";registerOwner="Supplier";}%>
      <tr class='rr-record <%=registerStateClass%>'><td class='zcs-px-16'><a class='record-link' href='#Page:Return_Request_Detail?Return_Request_ID=<%=returnRegisterRecord.ID%>'><%=registerRequestNumber%></a><span class='subtle'><i class='zc-li-outline ui-1-calendar-60'></i> <%=registerReturnDate%></span></td><td class='zcs-px-16'><span class='reason'><%=ifnull(returnRegisterRecord.Issue_Description,"No reason provided")%></span></td><td class='zcs-px-16'><span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 <%=registerBadgeClass%>'><i class='zc-li-outline <%=registerBadgeIcon%>'></i><%=registerResolution%></span></td><td class='zcs-px-16'><span class='owner'><i class='zc-li-outline users-single-05'></i><span><%=registerOwner%><span class='subtle'><%=if(registerResponsibility != "",registerResponsibility,"Responsibility not set")%></span></span></span></td><td class='zcs-px-16'><%=registerCustomerName%></td><td class='zcs-px-16'><span class='order-stack'>SO: <%=registerSalesOrderNumber%><span class='subtle'>PO: <%=registerPurchaseOrderNumber%></span></span></td><td class='zcs-px-16'><%=registerProductCount%></td><td class='zcs-px-16'><%=registerCreatedByName%><span class='subtle'><%=ifnull(returnRegisterRecord.Created_By_Email,"")%></span></td><td class='zcs-px-16'><a class='zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-md' href='#Page:Return_Request_Detail?Return_Request_ID=<%=returnRegisterRecord.ID%>'><i class='zc-li-outline ui-1-eye-17'></i><span class='action-text'>Open</span></a></td></tr>
    <%}%></tbody></table></div>
    <div class='mobile-list'><%for each returnMobileRecord in returnRequests{
      mobileProductCount=Return_Request_Product[Parent_Return_Request == returnMobileRecord.ID].count();mobileResponsibility=ifnull(returnMobileRecord.Damage_Responsibility,"");mobileRequestNumber=ifnull(returnMobileRecord.Return_Request_ID,"Return request");
      mobileCustomerName="Not set";if(returnMobileRecord.Customer != null){mobileCustomerName=ifnull(returnMobileRecord.Customer.Customer_Name,"Not set");}
      mobilePurchaseOrderNumber="Not set";if(returnMobileRecord.Purchase_Order != null){mobilePurchaseOrderNumber=ifnull(returnMobileRecord.Purchase_Order.Purchase_Order_ID,"Not set");}
      mobileSalesOrderNumber="Not set";if(returnMobileRecord.Sales_Order != null){mobileSalesOrderNumber=ifnull(returnMobileRecord.Sales_Order.Sales_Order_ID,"Not set");}
      mobileCreatedByName="Not set";if(returnMobileRecord.Created_By != null){mobileCreatedByName=ifnull(returnMobileRecord.Created_By.Employee_Name.first_name,"Not set");}
      mobileReturnDate="Not set";if(returnMobileRecord.Return_Date != null){mobileReturnDate=returnMobileRecord.Return_Date.toString("dd-MMM-yyyy");}
      mobileStateClass="state-unassigned";mobileResolution="Needs assignment";mobileBadgeClass="zcs-badge-yellow";mobileBadgeIcon="ui-2-time";mobileOwner="Not assigned";
      if(mobileResponsibility == "Company"){mobileStateClass="state-company";mobileResolution="Internal resolution";mobileBadgeClass="zcs-badge-blue";mobileBadgeIcon="loader-dots-06";mobileOwner="Company";}else if(mobileResponsibility == "Supplier"){mobileStateClass="state-supplier";mobileResolution="Supplier resolution";mobileBadgeClass="zcs-badge-green";mobileBadgeIcon="ui-1-check-circle-08";mobileOwner="Supplier";}%>
      <article class='rr-record <%=mobileStateClass%> mobile-card zcs-card'><div class='card-head'><div><a class='record-link' href='#Page:Return_Request_Detail?Return_Request_ID=<%=returnMobileRecord.ID%>'><%=mobileRequestNumber%></a><span class='subtle'><%=mobileCustomerName%></span></div><span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 <%=mobileBadgeClass%>'><i class='zc-li-outline <%=mobileBadgeIcon%>'></i><%=mobileResolution%></span></div><div class='card-grid'><div class='kv'><span class='kv-label'>Sales order</span><span class='kv-value'><%=mobileSalesOrderNumber%></span></div><div class='kv'><span class='kv-label'>Purchase order</span><span class='kv-value'><%=mobilePurchaseOrderNumber%></span></div><div class='kv'><span class='kv-label'>Products</span><span class='kv-value'><%=mobileProductCount%></span></div><div class='kv'><span class='kv-label'>Created by</span><span class='kv-value'><%=mobileCreatedByName%><span class='subtle'><%=ifnull(returnMobileRecord.Created_By_Email,"")%></span></span></div></div><p class='card-reason'><span class='kv-label'>Reported cause</span><span class='kv-value'><%=ifnull(returnMobileRecord.Issue_Description,"No reason provided")%></span></p><p class='card-owner owner'><i class='zc-li-outline users-single-05'></i><span><span class='kv-label'>Resolution owner</span><%=mobileOwner%><span class='subtle'><%=if(mobileResponsibility != "",mobileResponsibility,"Responsibility not set")%></span></span></p><div class='card-footer'><span class='card-date'><i class='zc-li-outline ui-1-calendar-60'></i> <%=mobileReturnDate%></span><a class='zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-md' href='#Page:Return_Request_Detail?Return_Request_ID=<%=returnMobileRecord.ID%>'><i class='zc-li-outline ui-1-eye-17'></i><span>Open return</span></a></div></article>
    <%}%></div>
  <%}%>
  </div>
</div>