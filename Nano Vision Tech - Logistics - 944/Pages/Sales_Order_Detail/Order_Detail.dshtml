<%
orders = Create_Sales_Order[ID == input.Sales_Order_ID];
%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row-wrap{flex-wrap:wrap}.zcs-align-items-center{align-items:center}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-22{font-size:1.375rem}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-text-left{text-align:left}.zcs-no-underline{text-decoration:none}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-badge{width:max-content;white-space:nowrap;border:1px solid}.zcs-badge-green{background:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-yellow{background:#FCF4E6;border-color:#FAAE13;color:#9A6300}.zcs-badge-blue{background:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-orange{background:#F8F0EB;border-color:#F4660C;color:#C44E08}.zcs-badge-grey{background:#e8e8e8;border-color:#5d6470;color:#40454d}.zcs-badge-theme{background:var(--zcs-light-bg-color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}
.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;min-width:820px}.zcs-table-wrapper thead{position:sticky;top:0;z-index:2}.zcs-table-wrapper th{background:#F9FAFE;white-space:nowrap}.zcs-table-wrapper th,.zcs-table-wrapper td{padding:9px 12px;border-top:1px solid var(--zcs-border-color);font-size:13px;text-align:left;vertical-align:top}.zcs-table-wrapper tbody tr:hover td{background:#F9FAFE}.sod-page{min-height:100%;width:100%;background:var(--zcs-page-bg-color);padding:14px 20px;font:14px Arial,sans-serif;color:var(--zcs-primary-text-color)}.sod-header,.sod-hero,.sod-section{padding:16px}.sod-header{position:relative;border-left:4px solid var(--zcs_brand_color)}.sod-back{width:34px;height:34px;border:1px solid var(--zcs-border-color);border-radius:8px;color:var(--zcs-primary-text-color);flex:none}.sod-eyebrow{font-size:11px;color:var(--zcs-teritiary-text-color);text-transform:uppercase;letter-spacing:.09em}.sod-identity{min-width:220px}.sod-meta{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-top:4px;color:var(--zcs-teritiary-text-color);font-size:12px}.sod-meta span{display:inline-flex;align-items:center;gap:5px}.sod-actions{display:flex;flex-wrap:wrap;gap:8px}.sod-hero{background:#fff}.sod-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.sod-summary-item{display:flex;align-items:center;gap:10px;padding:10px;border:1px solid var(--zcs-border-color);border-radius:8px;background:#F9FAFE}.sod-icon{width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:7px;background:var(--zcs-light-bg-color);color:var(--zcs_brand_color);font-size:16px;flex:none}.sod-label{display:block;color:var(--zcs-teritiary-text-color);font-size:11px;margin-bottom:2px;text-transform:uppercase;letter-spacing:.03em}.sod-value{font-weight:600;overflow-wrap:anywhere}.sod-content{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(310px,.85fr);gap:12px;align-items:start}.sod-stack{display:flex;flex-direction:column;gap:12px}.sod-section{min-width:0}.sod-section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}.sod-title{margin:0;font-size:15px;font-weight:600}.sod-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.sod-kv{padding:8px 10px;border-bottom:1px solid #eef0f4}.sod-copy{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.45}.sod-note-grid,.sod-related{display:grid;grid-template-columns:1fr 1fr;gap:8px}.sod-note{padding:11px;border-radius:8px;background:#F9FAFE}.sod-scroll{height:286px;overflow:auto}.sod-record-scroll{height:286px;overflow:auto;padding-right:4px}.sod-related{height:286px}.sod-related-card{padding:11px;border:1px solid var(--zcs-border-color);border-radius:8px;background:#F9FAFE;min-width:0;overflow:auto}.sod-related-head,.sod-record-head{display:flex;align-items:center;justify-content:space-between;gap:8px;position:sticky;top:-11px;background:#F9FAFE;padding:10px 0;z-index:1}.sod-record{padding:9px 0;border-top:1px solid var(--zcs-border-color);overflow-wrap:anywhere}.sod-empty{min-height:120px;padding:20px;text-align:center;color:var(--zcs-teritiary-text-color);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px}.sod-empty i{font-size:27px;color:var(--zcs_brand_color)}.sod-timeline{list-style:none;margin:0;padding:0}.sod-timeline li{position:relative;padding:0 0 18px 28px}.sod-timeline li:before{content:'';position:absolute;left:5px;top:5px;width:10px;height:10px;border-radius:50%;background:var(--zcs_brand_color);box-shadow:0 0 0 4px var(--zcs-light-bg-color)}.sod-timeline li:not(:last-child):after{content:'';position:absolute;left:9px;top:18px;width:1px;height:calc(100% - 9px);background:var(--zcs-border-color)}.sod-route{display:flex;align-items:flex-start;margin-top:14px;overflow-x:auto;padding:2px 0 4px}.sod-route-step{position:relative;flex:1;min-width:105px;text-align:center;color:var(--zcs-teritiary-text-color);font-size:11px}.sod-route-step:not(:last-child):before{content:'';position:absolute;left:50%;right:-50%;top:13px;height:2px;background:var(--zcs-border-color)}.sod-route-node{position:relative;z-index:1;width:28px;height:28px;margin:0 auto 6px;border:2px solid var(--zcs-border-color);border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:13px}.sod-route-step.on{color:var(--zcs-primary-text-color);font-weight:600}.sod-route-step.on .sod-route-node{border-color:var(--zcs_brand_color);background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.sod-route-step.on:not(:last-child):before{background:var(--zcs_brand_color)}
#splash-screen{display:none!important}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important;border-radius:0!important}@media(max-width:992px){.sod-page{padding:12px}.sod-content{grid-template-columns:1fr}.sod-summary{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.sod-page{padding:8px}.sod-header,.sod-hero,.sod-section{padding:13px}.sod-summary,.sod-grid,.sod-note-grid,.sod-related{grid-template-columns:1fr}.sod-related{height:auto}.sod-related-card{height:220px}.sod-actions{width:100%}.sod-actions .zcs-button{flex:1;min-width:38px}.sod-actions .zcs-button-text{display:none}.zcs-table-wrapper table{min-width:760px}.sod-route-step{min-width:90px}}
</style>
<div class='sod-page zcs-box-border zcs-flex zcs-direction-column zcs-gap-16'>
<% if(orders.count() == 0) { %>
  <header class='zcs-card sod-header'><a href='#Page:Sales_Orders' class='sod-back zcs-inline-flex zcs-align-items-center zcs-justify-center' title='Back to sales orders'><i class='zc-li-outline arrows-1-tail-left'></i></a></header>
  <div class='zcs-card zcs-flex zcs-align-items-center zcs-justify-center'><div class='sod-empty'><i class='zc-li-outline files-single'></i><h2 class='zcs-font-18 zcs-mt-12 zcs-mb-0'>Sales order unavailable</h2><p>The record was not found or you do not have access.</p></div></div>
<% } else { order = orders; products = Sales_Order_Product[Parent_Sales_Order == order.ID]; quotes = Add_Supplier_Quote[Sales_Order == order.ID] sort by Quote_Date desc; pos = Create_Purchase_Order[Sales_Order == order.ID] sort by PO_Date desc; invoices = Add_Supplier_Invoice[Sales_Order == order.ID] sort by Invoice_Date desc; logisticLinks = Logistics_Booking_Purchase_Order[Sales_Order == order.ID]; returns = Create_Return_Request[Sales_Order == order.ID] sort by Return_Date desc; histories = Add_History[Sales_Order_Lookup == order.ID] sort by Updated_Date_Time desc; supplierIdentity = Add_Supplier[Email == zoho.loginuserid && Active == true]; deliveredPOs = Create_Purchase_Order[Sales_Order == order.ID && Status == "Delivered"]; %>
  <header class='zcs-card sod-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-row-wrap zcs-gap-12'>
    <div class='zcs-flex zcs-align-items-center zcs-gap-12 sod-identity'><a href='#Page:Sales_Orders' class='sod-back zcs-inline-flex zcs-align-items-center zcs-justify-center' title='Back to sales orders'><i class='zc-li-outline arrows-1-tail-left'></i></a><div><div class='sod-eyebrow'>Sales order</div><div class='zcs-flex zcs-align-items-center zcs-gap-8 zcs-row-wrap'><h1 class='zcs-font-22 zcs-font-semibold zcs-m-0'><%=ifnull(order.Sales_Order_ID,"Record " + order.ID)%></h1><span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 <% if(order.Status == "Completed") { %>zcs-badge-green<% } else if(order.Status == "New") { %>zcs-badge-blue<% } else { %>zcs-badge-orange<% } %>'><%=order.Status%></span></div><div class='sod-meta'><span><i class='zc-li-outline files-single'></i><%=if(order.Customer != null,order.Customer.Customer_Name,"Customer not specified")%></span><span><i class='zc-li-outline ui-1-calendar-57'></i><%=ifnull(order.Sales_Order_Date,"Date not specified")%></span></div></div></div>
    <div class='sod-actions'>
      <% if(quotes.count() > 0) { %><a href='#Page:Quote_Comparison?Sales_Order_ID=<%=order.ID%>' class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border'><i class='zc-li-outline arrows-1-trend-up'></i><span class='zcs-button-text'>Compare quotes</span></a><% } %>
      <% if(order.Selected_Supplier_Quote != null && pos.count() == 0) { %><a href='#Form:Create_Purchase_Order?Sales_Order=<%=order.ID%>&amp;Selected_Supplier_Quote=<%=order.Selected_Supplier_Quote.ID%>&amp;zc_LoadIn=dialog' class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border'><i class='zc-li-outline files-single'></i><span class='zcs-button-text'>Create PO</span></a><% } %>
      <% if(order.Status == "New" && supplierIdentity.count() > 0) { %><a href='#Form:Add_Supplier_Quote?Supplier=<%=supplierIdentity.ID%>&amp;Sales_Order=<%=order.ID%>&amp;zc_LoadIn=dialog' class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border'><i class='zc-li-outline ui-1-simple-add'></i><span class='zcs-button-text'>Create quote</span></a><% } %>
    </div>
  </header>
  <section class='zcs-card sod-hero'>
    <div class='sod-summary'><div class='sod-summary-item'><div class='sod-icon'><i class='zc-li-outline ui-1-calendar-57'></i></div><div><span class='sod-label'>Requested delivery</span><span class='sod-value'><%=ifnull(order.Requested_Delivery_Date,"Not specified")%></span></div></div><div class='sod-summary-item'><div class='sod-icon'><i class='zc-li-outline shopping-bag-09'></i></div><div><span class='sod-label'>Products</span><span class='sod-value'><%=products.count()%> requirements</span></div></div><div class='sod-summary-item'><div class='sod-icon'><i class='zc-li-outline files-single'></i></div><div><span class='sod-label'>Sourcing</span><span class='sod-value'><%=quotes.count()%> quotes, <%=pos.count()%> POs</span></div></div><div class='sod-summary-item'><div class='sod-icon'><i class='zc-li-outline transport-truck'></i></div><div><span class='sod-label'>Fulfillment</span><span class='sod-value'><%=logisticLinks.count()%> bookings, <%=returns.count()%> returns</span></div></div></div>
    <div class='sod-route' aria-label='Sales order lifecycle'><div class='sod-route-step on'><div class='sod-route-node'><i class='zc-li-outline ui-1-check-small'></i></div>Requirement</div><div class='sod-route-step <%if(quotes.count()>0){%>on<%}%>'><div class='sod-route-node'><i class='zc-li-outline arrows-1-trend-up'></i></div>Sourcing</div><div class='sod-route-step <%if(pos.count()>0){%>on<%}%>'><div class='sod-route-node'><i class='zc-li-outline files-single'></i></div>Purchasing</div><div class='sod-route-step <%if(invoices.count()>0){%>on<%}%>'><div class='sod-route-node'><i class='zc-li-outline files-single'></i></div>Invoicing</div><div class='sod-route-step <%if(logisticLinks.count()>0 || deliveredPOs.count()>0){%>on<%}%>'><div class='sod-route-node'><i class='zc-li-outline transport-truck'></i></div>Delivery</div><div class='sod-route-step <%if(returns.count()>0){%>on<%}%>'><div class='sod-route-node'><i class='zc-li-outline arrows-1-refresh-69'></i></div>Returns</div></div>
  </section>
  <div class='sod-content'><main class='sod-stack'>
    <section class='zcs-card sod-section'><div class='sod-section-head'><h2 class='sod-title'>Requirement and sourcing status</h2></div><div class='sod-grid'><div class='sod-kv'><span class='sod-label'>Requirement source</span><span class='sod-value'><%=ifnull(order.Requirement_Source,"Not specified")%></span></div><div class='sod-kv'><span class='sod-label'>Lead</span><span class='sod-value'><%=if(order.Lead != null,order.Lead.Lead_ID,"Not linked")%></span></div><div class='sod-kv'><span class='sod-label'>Recommended supplier</span><span class='sod-value'><%=if(order.Recommended_Supplier != null,order.Recommended_Supplier.Supplier_Name,"Not recommended")%></span></div><div class='sod-kv'><span class='sod-label'>Selected quote</span><span class='sod-value'><%=if(order.Selected_Supplier_Quote != null,order.Selected_Supplier_Quote.Supplier_Quote_ID,"Not selected")%></span></div></div><div class='sod-note-grid zcs-mt-12'><div class='sod-note'><span class='sod-label'>Customer requirements</span><div class='sod-copy'><%=ifnull(order.Customer_Requirements,"Not specified")%></div></div><div class='sod-note'><span class='sod-label'>Additional remarks</span><div class='sod-copy'><%=ifnull(order.Additional_Remarks,"Not specified")%></div></div></div></section>
    <section class='zcs-card sod-section'><div class='sod-section-head'><h2 class='sod-title'>Product requirements</h2><span class='zcs-badge zcs-badge-blue zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=products.count()%></span></div><%if(products.count()==0){%><div class='sod-empty'><i class='zc-li-outline files-single'></i><div>No product requirements</div></div><%}else{%><div class='zcs-table-wrapper sod-scroll zcs-rounded-sm'><table class='zcs-w-full'><thead><tr><th>Product</th><th>Configuration and technical requirements</th><th>Quantity</th><th>Availability</th><th>Lead time</th><th>Selected quote</th></tr></thead><tbody><%for each productRow in products{%><tr><td><strong><%=productRow.Product_Name%></strong><br><span class='zcs-color-tertiary'><%=ifnull(productRow.Brand_Make,"")%> <%=ifnull(productRow.Model,"")%></span></td><td><%=ifnull(productRow.Configuration,"Not specified")%><br><span class='zcs-color-tertiary'><%=ifnull(productRow.Technical_Requirements,"")%></span></td><td><%=productRow.Quantity%> <%=ifnull(productRow.Unit_of_Measure,"")%></td><td><%=ifnull(productRow.Required_Availability,"Not specified")%></td><td><%=ifnull(productRow.Required_Lead_Time,"Not specified")%></td><td><%=if(productRow.Selected_Supplier_Quote != null,productRow.Selected_Supplier_Quote.Supplier_Quote_ID,"Not selected")%></td></tr><%}%></tbody></table></div><%}%></section>
    <section class='zcs-card sod-section'><div class='sod-section-head'><h2 class='sod-title'>Quote comparison and recommendation</h2><span class='zcs-badge zcs-badge-blue zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=quotes.count()%></span></div><%if(quotes.count()==0){%><div class='sod-empty'><i class='zc-li-outline files-single'></i><div>No supplier quotes received</div></div><%}else{%><div class='zcs-table-wrapper sod-scroll zcs-rounded-sm'><table class='zcs-w-full'><thead><tr><th>Quote</th><th>Supplier</th><th>Date</th><th>Availability</th><th>Lead time</th><th>Dispatch</th><th>Status</th></tr></thead><tbody><%for each quote in quotes{%><tr><td><%=quote.Supplier_Quote_ID%></td><td><%=if(quote.Supplier != null,quote.Supplier.Supplier_Name,"Not specified")%></td><td><%=quote.Quote_Date%></td><td><%=ifnull(quote.Availability,"Not specified")%></td><td><%=ifnull(quote.Lead_Time,"Not specified")%></td><td><%=ifnull(quote.Dispatch_Location,"Not specified")%></td><td><span class='zcs-badge zcs-px-10 zcs-py-2 zcs-rounded-sm <%if(quote.Status=="Selected"){%>zcs-badge-green<%}else{%>zcs-badge-yellow<%}%>'><%=quote.Status%></span></td></tr><%}%></tbody></table></div><%}%><div class='sod-note-grid zcs-mt-12'><div class='sod-note'><span class='sod-label'>Recommendation</span><div class='sod-value'><%=if(order.Recommended_Supplier != null,order.Recommended_Supplier.Supplier_Name,"Awaiting recommendation")%></div><div class='sod-copy'><%=ifnull(order.Comparison_Remarks,"No comparison remarks")%></div></div><div class='sod-note'><span class='sod-label'>Comparison sheet</span><div class='sod-value'><%=ifnull(order.Comparison_Sheet,"Not attached")%></div></div></div></section>
    <section class='zcs-card sod-section'><div class='sod-section-head'><h2 class='sod-title'>Fulfillment and delivery</h2><span class='zcs-badge zcs-badge-theme zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=logisticLinks.count()%> bookings</span></div><%if(logisticLinks.count()==0){%><div class='sod-empty'><i class='zc-li-outline transport-truck'></i><div>No logistics bookings linked</div></div><%}else{%><div class='sod-record-scroll'><%for each logisticLink in logisticLinks{ booking=logisticLink.Parent_Logistics_Booking; %><div class='sod-record'><div class='sod-record-head'><strong><%=if(booking != null,booking.Logistics_Booking_ID,"Booking")%></strong><span class='zcs-badge zcs-badge-blue zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=if(booking != null,booking.Status,"Linked")%></span></div><%if(booking != null){%><div class='sod-grid'><div class='sod-kv'><span class='sod-label'>Provider</span><%=ifnull(booking.Logistics_Provider,"Not specified")%></div><div class='sod-kv'><span class='sod-label'>Tracking</span><%=ifnull(booking.Tracking_Reference,"Not specified")%></div><div class='sod-kv'><span class='sod-label'>Expected arrival</span><%=ifnull(booking.Expected_Arrival_Date,"Not specified")%></div><div class='sod-kv'><span class='sod-label'>Actual arrival</span><%=ifnull(booking.Actual_Arrival_Date,"Pending")%></div></div><%}%></div><%}%></div><%}%><%if(deliveredPOs.count()>0){%><div class='sod-note zcs-mt-12'><span class='sod-label'>Delivered purchase orders</span><strong><%=deliveredPOs.count()%></strong> delivered and eligible for return requests.</div><%}%></section>
  </main><aside class='sod-stack'>
    <section class='zcs-card sod-section'><div class='sod-section-head'><h2 class='sod-title'>Downstream documents</h2></div><div class='sod-related'><div class='sod-related-card'><div class='sod-related-head'><strong>Purchase orders</strong><span class='zcs-badge zcs-badge-blue zcs-px-10 zcs-py-2'><%=pos.count()%></span></div><%if(pos.count()==0){%><span class='zcs-color-tertiary'>None created</span><%}else{for each po in pos{%><div class='sod-record'><a href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=po.ID%>'><%=po.Purchase_Order_ID%></a><br><span class='zcs-color-tertiary'><%=po.Status%> · <%=ifnull(po.Expected_Delivery_Date,"No due date")%></span><%if(po.Status=="Delivered"){%><br><a href='#Form:Create_Return_Request?Sales_Order=<%=order.ID%>&amp;Purchase_Order=<%=po.ID%>&amp;Customer=<%=order.Customer.ID%>&amp;zc_LoadIn=dialog'>Create return</a><%}%></div><%}}%></div><div class='sod-related-card'><div class='sod-related-head'><strong>Supplier invoices</strong><span class='zcs-badge zcs-badge-orange zcs-px-10 zcs-py-2'><%=invoices.count()%></span></div><%if(invoices.count()==0){%><span class='zcs-color-tertiary'>None received</span><%}else{for each invoice in invoices{%><div class='sod-record'><a href='#Page:Supplier_Invoice_Detail?Supplier_Invoice_ID=<%=invoice.ID%>'><%=invoice.Supplier_Invoice_ID%></a><br><span class='zcs-color-tertiary'><%=invoice.Status%> · <%=invoice.Invoice_Date%></span></div><%}}%></div></div></section>
    <section class='zcs-card sod-section'><div class='sod-section-head'><h2 class='sod-title'>Returns</h2><span class='zcs-badge zcs-badge-grey zcs-px-10 zcs-py-2'><%=returns.count()%></span></div><%if(returns.count()==0){%><div class='sod-empty'><i class='zc-li-outline arrows-1-refresh-69'></i><div>No return requests</div><small>Return actions appear only for delivered purchase orders.</small></div><%}else{%><div class='sod-record-scroll'><%for each returnRow in returns{%><div class='sod-record'><strong><%=returnRow.Return_Request_ID%></strong><br><span class='zcs-color-tertiary'><%=returnRow.Return_Date%> · <%=ifnull(returnRow.Damage_Responsibility,"Responsibility pending")%></span><div class='sod-copy'><%=ifnull(returnRow.Issue_Description,"No issue description")%></div></div><%}%></div><%}%></section>
    <section class='zcs-card sod-section'><div class='sod-section-head'><h2 class='sod-title'>Activity</h2><a href='#Report:All_Histories?Sales_Order_Lookup=<%=order.ID%>'>View report</a></div><%if(histories.count()==0){%><div class='sod-empty'><i class='zc-li-outline ui-2-time'></i><div>No history entries</div></div><%}else{%><div class='sod-record-scroll'><ul class='sod-timeline'><%for each historyRow in histories{%><li><div class='zcs-font-15 zcs-font-semibold'><%=historyRow.Action_Type%></div><div class='zcs-font-13 zcs-color-tertiary'><%=historyRow.Updated_Date_Time%> · <%=if(historyRow.Updated_By != null,historyRow.Updated_By.Employee_Name,ifnull(historyRow.Updated_By_Email,"System"))%></div><%if(historyRow.Previous_Status != null || historyRow.New_Status != null){%><div class='zcs-mt-8'><%=ifnull(historyRow.Previous_Status,"")%> to <%=ifnull(historyRow.New_Status,"")%></div><%}%><%if(historyRow.Comments != null){%><div class='sod-copy'><%=historyRow.Comments%></div><%}%></li><%}%></ul></div><%}%></section>
  </aside></div>
<% } %>
</div>