<%
ordersInSourcing = Create_Sales_Order[Status == "New" || Status == "Quotes Received"] sort by Requested_Delivery_Date asc;
receivedQuotes = Add_Supplier_Quote[Status == "Received"] sort by Quote_Date desc;
selectedQuotes = Add_Supplier_Quote[Status == "Selected"] sort by Quote_Date desc;
activeSuppliers = Add_Supplier[Active == true] sort by Supplier_Name asc;
openPurchaseOrders = Create_Purchase_Order[Status != "Delivered"] sort by PO_Date desc;
awaitingQuoteCount = 0;
comparisonReadyCount = 0;
for each sourcingOrder in ordersInSourcing
{
  orderQuoteCount = Add_Supplier_Quote[Sales_Order == sourcingOrder.ID].count();
  if(orderQuoteCount == 0)
  {
    awaitingQuoteCount = awaitingQuoteCount + 1;
  }
  if(orderQuoteCount > 1 && sourcingOrder.Selected_Supplier_Quote == null)
  {
    comparisonReadyCount = comparisonReadyCount + 1;
  }
}
selectedAwaitingPOCount = 0;
for each selectedQuote in selectedQuotes
{
  if(Create_Purchase_Order[Selected_Supplier_Quote == selectedQuote.ID].count() == 0)
  {
    selectedAwaitingPOCount = selectedAwaitingPOCount + 1;
  }
}
activeSupplierCount = activeSuppliers.count();
%>
<style>
/* ZCS global utility subset for this single-snippet page. */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#f6f5fa;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-tertiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5;--column-gap:0px}
*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-p-0{padding:0}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-20{padding-top:1.25rem;padding-bottom:1.25rem}.zcs-m-0{margin:0}.zcs-mt-6{margin-top:.375rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-22{font-size:1.375rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-tertiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}a{text-decoration:none}
.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%;width:100%;max-width:none}.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zc-pb-tile-container,.zc-pb-page-content-wrapper .zc-pb-tile-card{padding:0!important;margin:0!important;border-radius:0!important;box-shadow:none!important}#splash-screen{display:none!important}
.sourcing-shell{min-height:100%;padding:18px;background:var(--zcs-page-bg-color);font:400 14px/1.5 Arial,sans-serif;color:var(--zcs-primary-text-color)}.dashboard-header{padding:22px 24px;background:#f0edfb;border:1px solid #ddd6f4;border-left:4px solid #7056b8;border-radius:12px}.eyebrow{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#7056b8;font-weight:600}.dashboard-header h1{font-size:23px;margin:3px 0 0}.dashboard-header p{max-width:760px;color:var(--zcs-secondary-text-color);margin:5px 0 0}.demand-overview{display:grid;grid-template-columns:minmax(240px,1.25fr) repeat(4,minmax(130px,1fr));gap:10px}.primary-kpi{padding:16px 18px;background:#40345f;color:#fff;border-color:#40345f}.primary-kpi .kpi-label,.primary-kpi .kpi-note{color:#ddd7ee}.kpi-main{font-size:28px;font-weight:600;line-height:1}.kpi{padding:13px 14px;min-width:0}.kpi-top{display:flex;align-items:center;justify-content:space-between;gap:8px}.kpi-icon{width:30px;height:30px;border-radius:8px;background:#eeeafa;color:#684fae;font-size:15px;flex:0 0 auto}.kpi-value{font-size:20px;font-weight:600;line-height:1.1}.kpi-label{font-size:12px;color:var(--zcs-secondary-text-color);margin-top:5px}.kpi-note{font-size:11px;color:var(--zcs-tertiary-text-color);margin-top:2px}.dashboard-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:14px}.span-5{grid-column:span 5}.span-7{grid-column:span 7}.span-12{grid-column:1/-1}.work-card{min-width:0;overflow:hidden}.section-head{min-height:65px;padding:13px 16px;border-bottom:1px solid var(--zcs-border-color);background:#fff}.section-title{min-width:0}.section-title h2{font-size:16px;margin:0}.section-title p{font-size:12px;color:var(--zcs-secondary-text-color);margin:2px 0 0}.section-link{font-size:12px;font-weight:600;color:#654aa8;white-space:nowrap}.section-scroll{height:322px;overflow:auto}.record-list{padding:3px 16px}.record-row{padding:12px 0;border-bottom:1px solid var(--zcs-border-color)}.record-row:last-child{border-bottom:0}.record-link{color:#5e449f;font-weight:600}.meta{font-size:12px;color:var(--zcs-secondary-text-color);margin-top:3px;overflow-wrap:anywhere}.row-actions{margin-top:8px;flex-wrap:wrap}.zcs-button{width:auto;min-width:5rem;min-height:34px}.zcs-primary-button{background:#6850aa;border:1px solid #6850aa;color:#fff}.zcs-primary-outline-button{background:#fff;border:1px solid #7056b8;color:#5e449f}.zcs-button:hover{filter:brightness(.97)}.row-action{min-height:29px;min-width:0;font-size:12px;font-weight:600}.zcs-badge{width:auto;border:1px solid;font-size:12px}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#137b57}.zcs-badge-yellow{background:#fcf4e6;border-color:#d99a17;color:#8a620f}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#245ac2}.zcs-badge-orange{background:#f8f0eb;border-color:#e46b21;color:#a74b13}.zcs-badge-theme{background:#eeeafa;border-color:#7056b8;color:#5e449f}.zcs-progress-bar{height:7px;background:#ece9f3;overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:#7056b8}.progress-row{padding:12px 16px;border-bottom:1px solid var(--zcs-border-color)}.progress-row:last-child{border-bottom:0}.progress-label{min-width:0}.empty{height:100%;min-height:170px;padding:20px}.empty i{font-size:27px;color:#8b7cad}.empty h5{font-size:16px;margin:8px 0 0}.empty p{font-size:12px;color:var(--zcs-secondary-text-color);margin:4px 0 0}.quote-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:start}.quote-identity{min-width:0}.supplier-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;padding:11px}.supplier-card{padding:12px;border:1px solid var(--zcs-border-color);border-radius:9px;background:#fff;min-width:0}.supplier-card h3{font-size:14px;margin:0}.supplier-card p{font-size:12px;color:var(--zcs-secondary-text-color);margin:3px 0 0;overflow-wrap:anywhere}.zcs-table-wrapper{overflow:auto;background:#fff;border:0}.zcs-table-wrapper table{border-collapse:collapse;min-width:760px;line-height:normal}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:#f7f6fb;box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color);vertical-align:middle}.zcs-table-wrapper tbody tr:first-child td{border-top:0}.zcs-table-wrapper tbody tr:hover td{background:#faf9fd}.po-ready{border-top:1px solid var(--zcs-border-color);background:#fbfafe}.po-ready-scroll{max-height:210px;overflow:auto}
@media(max-width:1180px){.demand-overview{grid-template-columns:repeat(4,minmax(0,1fr))}.primary-kpi{grid-column:1/-1}.span-5,.span-7{grid-column:span 6}}@media(max-width:900px){.dashboard-grid{grid-template-columns:1fr}.span-5,.span-7,.span-12{grid-column:auto}.section-scroll{height:330px}.demand-overview{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.sourcing-shell{padding:11px}.dashboard-header{padding:18px}.demand-overview{grid-template-columns:1fr}.primary-kpi{grid-column:auto}.section-head{align-items:flex-start}.supplier-grid{grid-template-columns:1fr}.zcs-table-wrapper table{min-width:680px}}
</style>
<div class='sourcing-shell zcs-flex zcs-direction-column zcs-gap-16'>
  <header class='dashboard-header'>
    <div class='eyebrow'>Sourcing operations</div>
    <h1>Quote demand and supplier coverage</h1>
    <p>Scan requirements, supplier responses, comparison readiness, and purchase-order handoffs from one compact workspace.</p>
  </header>

  <section class='demand-overview' aria-label='Sourcing activity summary'>
    <div class='primary-kpi zcs-card'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div><div class='kpi-label'>Active quote demand</div><div class='kpi-main zcs-mt-6'><%=ordersInSourcing.count()%></div><div class='kpi-note'>Sales orders currently in sourcing</div></div><span class='kpi-icon zcs-flex zcs-align-items-center zcs-justify-center' style='background:#594979;color:#fff'><i class='zc-li-outline shopping-list'></i></span></div></div>
    <div class='kpi zcs-card'><div class='kpi-top'><span class='kpi-value'><%=awaitingQuoteCount%></span><span class='kpi-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-2-time'></i></span></div><div class='kpi-label'>Awaiting first quote</div><div class='kpi-note'>Demand without coverage</div></div>
    <div class='kpi zcs-card'><div class='kpi-top'><span class='kpi-value'><%=receivedQuotes.count()%></span><span class='kpi-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline shopping-tag-content'></i></span></div><div class='kpi-label'>Responses received</div><div class='kpi-note'>Quotes ready to inspect</div></div>
    <div class='kpi zcs-card'><div class='kpi-top'><span class='kpi-value'><%=comparisonReadyCount%></span><span class='kpi-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline design-2-layout-11'></i></span></div><div class='kpi-label'>Comparisons ready</div><div class='kpi-note'>Multiple quotes available</div></div>
    <div class='kpi zcs-card'><div class='kpi-top'><span class='kpi-value'><%=selectedAwaitingPOCount%></span><span class='kpi-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i></span></div><div class='kpi-label'>Selected, no PO</div><div class='kpi-note'><%=activeSupplierCount%> active suppliers</div></div>
  </section>

  <main class='dashboard-grid'>
    <section class='work-card zcs-card span-5'>
      <div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div class='section-title'><h2>Demand requiring outreach</h2><p>Requirements that have not received a supplier quote.</p></div><a class='section-link' href='#Page:Requests_For_Quote'>Request queue</a></div>
      <div class='section-scroll record-list'>
        <%if(awaitingQuoteCount == 0){%><div class='empty zcs-wh-full zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center'><i class='zc-li-outline ui-1-check-circle-08'></i><h5>Every active order has coverage</h5><p>New requirements will appear here when outreach is needed.</p><a class='zcs-button zcs-primary-outline-button row-action zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-md zcs-mt-12' href='#Form:Create_Sales_Order?zc_LoadIn=dialog'><i class='zc-li-outline ui-1-simple-add'></i>Create request</a></div><%}else{for each awaitingOrder in ordersInSourcing{awaitingOrderQuoteCount = Add_Supplier_Quote[Sales_Order == awaitingOrder.ID].count();if(awaitingOrderQuoteCount == 0){customerName = "No customer linked";if(awaitingOrder.Customer != null){customerName = awaitingOrder.Customer.Customer_Name;}%>
        <article class='record-row'><div class='zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-12'><div><a class='record-link' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=awaitingOrder.ID%>'><%=awaitingOrder.Sales_Order_ID%></a><div class='meta'><%=customerName%> | <%=awaitingOrder.Requirement_Source%> | Needed <%=ifnull(awaitingOrder.Requested_Delivery_Date,"Not set")%></div></div><span class='zcs-badge zcs-badge-yellow zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm'>No response</span></div><div class='row-actions zcs-flex zcs-gap-8'><a class='zcs-button zcs-primary-outline-button row-action zcs-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-md' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=awaitingOrder.ID%>'><i class='zc-li-outline ui-1-eye-19'></i>Detail</a><a class='zcs-button zcs-primary-button row-action zcs-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-md' href='#Form:Add_Supplier_Quote?zc_LoadIn=dialog&amp;Sales_Order=<%=awaitingOrder.ID%>'><i class='zc-li-outline shopping-tag-content'></i>Add response</a></div></article>
        <%}}%><div class='zcs-py-8'><a class='section-link' href='#Form:Create_Sales_Order?zc_LoadIn=dialog'><i class='zc-li-outline ui-1-simple-add'></i> Create another sourcing request</a></div><%}%>
      </div>
    </section>

    <section class='work-card zcs-card span-7'>
      <div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div class='section-title'><h2>Supplier quote records</h2><p>Recent received responses with linked supplier and demand context.</p></div><a class='section-link' href='#Report:All_Supplier_Quotes'>All quotes</a></div>
      <div class='section-scroll record-list'>
        <%if(receivedQuotes.count() == 0){%><div class='empty zcs-wh-full zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center'><i class='zc-li-outline shopping-tag-content'></i><h5>No received quotes</h5><p>Supplier responses will appear here after they are recorded.</p></div><%}else{for each quoteRecord in receivedQuotes{quoteSupplierName = "Supplier not linked";quoteOrderName = "Order not linked";if(quoteRecord.Supplier != null){quoteSupplierName = quoteRecord.Supplier.Supplier_Name;}if(quoteRecord.Sales_Order != null){quoteOrderName = quoteRecord.Sales_Order.Sales_Order_ID;}%>
        <article class='record-row quote-row'><div class='quote-identity'><a class='record-link' href='#Report:All_Supplier_Quotes?ID=<%=quoteRecord.ID%>'><%=quoteRecord.Supplier_Quote_ID%></a><div class='meta'><strong><%=quoteSupplierName%></strong> | <%=quoteOrderName%> | Quoted <%=ifnull(quoteRecord.Quote_Date,"Not set")%></div></div><span class='zcs-badge zcs-badge-theme zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm'>Received</span></article>
        <%}}%>
      </div>
    </section>

    <section class='work-card zcs-card span-5'>
      <div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div class='section-title'><h2>Coverage by order</h2><p>Responses measured only against the current active supplier count.</p></div><a class='section-link' href='#Report:All_Sales_Orders'>All orders</a></div>
      <div class='section-scroll'>
        <%if(ordersInSourcing.count() == 0){%><div class='empty zcs-wh-full zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center'><i class='zc-li-outline ui-2-time'></i><h5>No active sourcing demand</h5><p>Create a request to begin supplier outreach.</p></div><%}else{for each progressOrder in ordersInSourcing{progressQuoteCount = Add_Supplier_Quote[Sales_Order == progressOrder.ID].count();responsePercent = 0;if(activeSupplierCount > 0){responsePercent = ((progressQuoteCount * 100) / activeSupplierCount).round(0);if(responsePercent > 100){responsePercent = 100;}}%>
        <div class='progress-row'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><div class='progress-label'><a class='record-link' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=progressOrder.ID%>'><%=progressOrder.Sales_Order_ID%></a><div class='meta'><%=progressQuoteCount%> response<%if(progressQuoteCount != 1){%>s<%}%> from <%=activeSupplierCount%> active suppliers</div></div><span class='zcs-font-13 zcs-font-semibold'><%=responsePercent%>%</span></div><div class='zcs-progress-bar zcs-rounded-sm zcs-mt-8'><div class='zcs-progress-bar-indicator' style='width:<%=responsePercent%>%'></div></div></div>
        <%}}%>
      </div>
    </section>

    <section class='work-card zcs-card span-7'>
      <div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div class='section-title'><h2>Comparisons ready for decision</h2><p>Orders with multiple responses and no selected supplier quote.</p></div><a class='section-link' href='#Report:All_Sales_Orders'>Order report</a></div>
      <div class='section-scroll record-list'>
        <%if(comparisonReadyCount == 0){%><div class='empty zcs-wh-full zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center'><i class='zc-li-outline design-2-layout-11'></i><h5>No comparisons ready</h5><p>At least two responses are needed before a comparison is surfaced.</p></div><%}else{for each comparisonOrder in ordersInSourcing{comparisonQuoteCount = Add_Supplier_Quote[Sales_Order == comparisonOrder.ID].count();if(comparisonQuoteCount > 1 && comparisonOrder.Selected_Supplier_Quote == null){%>
        <article class='record-row'><div class='zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-12'><div><a class='record-link' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=comparisonOrder.ID%>'><%=comparisonOrder.Sales_Order_ID%></a><div class='meta'><%=comparisonQuoteCount%> quotes | Needed <%=ifnull(comparisonOrder.Requested_Delivery_Date,"Not set")%></div></div><span class='zcs-badge zcs-badge-green zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm'>Ready</span></div><div class='row-actions zcs-flex zcs-gap-8'><a class='zcs-button zcs-primary-button row-action zcs-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-md' href='#Page:Quote_Comparison?Sales_Order_ID=<%=comparisonOrder.ID%>'><i class='zc-li-outline design-2-layout-11'></i>Compare</a><a class='zcs-button zcs-primary-outline-button row-action zcs-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-md' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=comparisonOrder.ID%>'><i class='zc-li-outline ui-1-eye-19'></i>Detail</a></div></article>
        <%}}}%>
      </div>
    </section>

    <section class='work-card zcs-card span-12'>
      <div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div class='section-title'><h2>Active supplier network</h2><p>Partner coverage and recorded response volume for sourcing outreach.</p></div><a class='section-link' href='#Form:Add_Supplier?zc_LoadIn=dialog'><i class='zc-li-outline ui-1-simple-add'></i> Add supplier</a></div>
      <div class='section-scroll'>
        <%if(activeSupplierCount == 0){%><div class='empty zcs-wh-full zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center'><i class='zc-li-outline business-handshake'></i><h5>No active suppliers</h5><p>Add or activate a supplier before requesting quotes.</p></div><%}else{%><div class='supplier-grid'><%for each supplierRecord in activeSuppliers{supplierQuoteCount = Add_Supplier_Quote[Supplier == supplierRecord.ID].count();%><article class='supplier-card'><div class='zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-8'><div><h3><a class='record-link' href='#Report:All_Suppliers?ID=<%=supplierRecord.ID%>'><%=supplierRecord.Supplier_Name%></a></h3><p><%=ifnull(supplierRecord.Contact_Person,"No contact")%> | <%=ifnull(supplierRecord.Country,"Country not set")%></p><p><strong><%=supplierQuoteCount%></strong> quote response<%if(supplierQuoteCount != 1){%>s<%}%> recorded</p></div><span class='zcs-badge zcs-badge-green zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm'>Active</span></div></article><%}%></div><%}%>
      </div>
    </section>

    <section class='work-card zcs-card span-12'>
      <div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div class='section-title'><h2>Purchase-order handoffs</h2><p>Open POs and the next operational handoff implied by each existing status.</p></div><a class='section-link' href='#Report:All_Purchase_Orders'>All purchase orders</a></div>
      <div class='section-scroll zcs-table-wrapper zcs-relative'>
        <%if(openPurchaseOrders.count() == 0){%><div class='empty zcs-wh-full zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-text-center'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i><h5>No open purchase-order handoffs</h5><p>Selected quotes awaiting a PO are shown in the handoff queue below.</p></div><%}else{%><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Purchase order</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Supplier</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Sales order</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Status</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Next handoff</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Action</th></tr></thead><tbody><%for each poRecord in openPurchaseOrders{nextHandoff = "Review status";badgeClass = "zcs-badge-blue";if(poRecord.Status == "New"){nextHandoff = "Internal approval";badgeClass = "zcs-badge-yellow";}else if(poRecord.Status == "Approved"){nextHandoff = "Share with customer";badgeClass = "zcs-badge-orange";}else if(poRecord.Status == "Customer Approved"){nextHandoff = "Supplier invoice";badgeClass = "zcs-badge-green";}else if(poRecord.Status == "Invoice Created"){nextHandoff = "Payment confirmation";}else if(poRecord.Status == "Invoice Paid" || poRecord.Status == "Logistics Pending"){nextHandoff = "Logistics booking";}else if(poRecord.Status == "Products Received"){nextHandoff = "Delivery confirmation";}supplierName = "Supplier not linked";if(poRecord.Supplier != null){supplierName = poRecord.Supplier.Supplier_Name;}salesOrderName = "Order not linked";if(poRecord.Sales_Order != null){salesOrderName = poRecord.Sales_Order.Sales_Order_ID;}%><tr><td class='zcs-px-16 zcs-py-8'><a class='record-link' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=poRecord.ID%>'><%=poRecord.Purchase_Order_ID%></a><div class='meta'><%=poRecord.PO_Date%></div></td><td class='zcs-px-16 zcs-py-8'><%=supplierName%></td><td class='zcs-px-16 zcs-py-8'><%=salesOrderName%></td><td class='zcs-px-16 zcs-py-8'><span class='zcs-badge <%=badgeClass%> zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=ifnull(poRecord.Status,"Unknown")%></span></td><td class='zcs-px-16 zcs-py-8'><%=nextHandoff%></td><td class='zcs-px-16 zcs-py-8'><a class='zcs-button zcs-primary-outline-button row-action zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-md' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=poRecord.ID%>'><i class='zc-li-outline ui-1-eye-19'></i>Detail</a></td></tr><%}%></tbody></table><%}%>
      </div>
      <%if(selectedAwaitingPOCount > 0){%><div class='po-ready zcs-p-16'><div><strong><%=selectedAwaitingPOCount%> selected quote<%if(selectedAwaitingPOCount != 1){%>s<%}%> need a purchase order</strong><div class='meta'>Create the PO from the selected quote to preserve supplier and source links.</div></div><div class='po-ready-scroll record-list' style='padding:0'><%for each poReadyQuote in selectedQuotes{existingPOCount = Create_Purchase_Order[Selected_Supplier_Quote == poReadyQuote.ID].count();if(existingPOCount == 0){poReadySupplierName = "Supplier not linked";poReadyOrderName = "Order not linked";poSupplierID = "";poOrderID = "";if(poReadyQuote.Supplier != null){poReadySupplierName = poReadyQuote.Supplier.Supplier_Name;poSupplierID = poReadyQuote.Supplier.ID;}if(poReadyQuote.Sales_Order != null){poReadyOrderName = poReadyQuote.Sales_Order.Sales_Order_ID;poOrderID = poReadyQuote.Sales_Order.ID;}%><article class='record-row'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div><a class='record-link' href='#Report:All_Supplier_Quotes?ID=<%=poReadyQuote.ID%>'><%=poReadyQuote.Supplier_Quote_ID%></a><div class='meta'><%=poReadySupplierName%> | <%=poReadyOrderName%></div></div><%if(poSupplierID != "" && poOrderID != ""){%><a class='zcs-button zcs-primary-button row-action zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-6 zcs-rounded-md' href='#Form:Create_Purchase_Order?zc_LoadIn=dialog&amp;Supplier=<%=poSupplierID%>&amp;Sales_Order=<%=poOrderID%>&amp;Selected_Supplier_Quote=<%=poReadyQuote.ID%>'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i>Create PO</a><%}else{%><span class='zcs-badge zcs-badge-yellow zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm'>Link data required</span><%}%></div></article><%}}%></div></div><%}%>
    </section>
  </main>
</div>