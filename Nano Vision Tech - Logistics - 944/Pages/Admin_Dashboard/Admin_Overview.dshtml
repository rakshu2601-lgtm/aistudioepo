<%
customerCount = Add_Customer.count();
activeCustomerCount = Add_Customer[Active == true].count();
supplierCount = Add_Supplier.count();
activeSupplierCount = Add_Supplier[Active == true].count();
productCount = Add_Product.count();
activeProductCount = Add_Product[Active == true].count();
newLeadCount = Add_Lead[Status == "New"].count();
openSalesOrderCount = Create_Sales_Order[Status != "Delivered"].count();
receivedQuoteCount = Add_Supplier_Quote[Status == "Received"].count();
openPOCount = Create_Purchase_Order[Status != "Delivered"].count();
unpaidInvoiceCount = Add_Supplier_Invoice[Status == "New"].count();
openLogisticsCount = Create_Logistics_Booking[Status == "New"].count();
returnCount = Create_Return_Request.count();
recentHistoryCount = Add_History[Updated_Date_Time >= zoho.currenttime.subDay(7)].count();
readinessExceptionCount = (customerCount - activeCustomerCount) + (supplierCount - activeSupplierCount) + (productCount - activeProductCount);
priorityExceptionCount = unpaidInvoiceCount + openLogisticsCount + returnCount;
customerReadinessPct = if(customerCount > 0,(activeCustomerCount * 100 / customerCount).round(0),100);
supplierReadinessPct = if(supplierCount > 0,(activeSupplierCount * 100 / supplierCount).round(0),100);
productReadinessPct = if(productCount > 0,(activeProductCount * 100 / productCount).round(0),100);
inactiveCustomers = Add_Customer[Active == false] sort by Last_Updated_Date_Time desc range from 0 to 5;
inactiveSuppliers = Add_Supplier[Active == false] sort by Last_Updated_Date_Time desc range from 0 to 5;
inactiveProducts = Add_Product[Active == false] sort by Last_Updated_Date_Time desc range from 0 to 5;
newLeads = Add_Lead[Status == "New"] sort by Lead_Date desc range from 0 to 7;
activeSalesOrders = Create_Sales_Order[Status != "Delivered"] sort by Sales_Order_Date desc range from 0 to 7;
receivedQuotes = Add_Supplier_Quote[Status == "Received"] sort by Quote_Date desc range from 0 to 7;
activePurchaseOrders = Create_Purchase_Order[Status != "Delivered"] sort by PO_Date desc range from 0 to 7;
unpaidInvoices = Add_Supplier_Invoice[Status == "New"] sort by Invoice_Date asc range from 0 to 9;
openLogistics = Create_Logistics_Booking[Status == "New"] sort by Expected_Arrival_Date asc range from 0 to 7;
returnRequests = Create_Return_Request[ID != 0] sort by Return_Date desc range from 0 to 7;
recentHistory = Add_History[Updated_Date_Time >= zoho.currenttime.subDay(7)] sort by Updated_Date_Time desc range from 0 to 11;
%>
<style>
/* ZCS global utility rules used by this page, included once. */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:.625rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-rounded-sm{border-radius:.25rem}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-sticky{position:sticky}.zcs-card{background:var(--zcs-white-color);border:1px solid #E5E7EF;border-radius:12px}a{text-decoration:none}
/* Full-width Creator canvas overrides. */
html,body,div#zppagesLive,div#elementsContainer,.Layout.elemContainment,.zcpage-elemContainer,.zc-pb-formreport-placeholder,.zc-pb-page-content-wrapper,.zc-pb-tile-container,.zc-pb-tile-card{width:100%!important;min-height:100%;box-sizing:border-box}.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zc-pb-tile-container,.zc-pb-page-content-wrapper .zc-pb-tile-card{padding:0!important;margin:0!important;border-radius:0!important;box-shadow:none!important}#splash-screen,.zc-page-loader,.cogLoader{display:none!important}
.admin-workspace{min-height:100%;padding:18px;background:#F6F5FA;font:400 14px/1.5 Arial,sans-serif;color:var(--zcs-primary-text-color)}
.workspace-header{padding:18px 20px;border:1px solid #DED9EE;border-radius:14px;background:linear-gradient(135deg,#fff 0%,#F3F0FF 100%);display:flex;align-items:center;gap:14px}.header-mark{width:42px;height:42px;flex:none;border-radius:11px;background:#EAE4FF;color:#6246C9;display:flex;align-items:center;justify-content:center;font-size:19px}.header-copy{flex:1;min-width:0}.eyebrow{margin:0 0 2px!important;color:#7058C7!important;font-size:10px!important;font-weight:700;text-transform:uppercase;letter-spacing:.09em}.workspace-header h1{font-size:22px}.workspace-header p{margin-top:3px;max-width:780px}.priority-summary{flex:none;display:flex;align-items:center;gap:9px;padding:8px 11px;border-radius:9px;background:#FFF0F2;border:1px solid #F2B8C1;color:#A72B42}.priority-summary i{font-size:17px}.priority-summary strong{font-size:17px}.priority-summary span{font-size:11px;display:block}
.context-row{display:grid;grid-template-columns:repeat(7,minmax(105px,1fr));gap:8px;margin-top:10px}.context-tile{padding:9px 11px;min-height:54px;border-color:#E4E0EE}.context-tile span{display:block;color:var(--zcs-secondary-text-color);font-size:10px;text-transform:uppercase;letter-spacing:.05em}.context-tile strong{display:block;margin-top:1px;font-size:17px;font-weight:600}.context-tile small{color:var(--zcs-secondary-text-color);font-size:11px}
.health-strip{margin-top:12px;padding:13px 15px;border-color:#E1DCEF}.health-heading{display:flex;align-items:center;justify-content:space-between;gap:12px}.health-heading h2{font-size:15px}.health-grid{display:grid;grid-template-columns:repeat(3,minmax(130px,1fr)) minmax(260px,1.2fr);gap:18px;margin-top:10px;align-items:end}.zcs-progress-bar-wrapper p{display:flex;justify-content:space-between;gap:8px;margin:0 0 5px;font-size:11px;color:var(--zcs-secondary-text-color)}.zcs-progress-bar{height:7px;background:#ECE9F4}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:#7458D6}.exception-mix{display:flex;gap:7px;justify-content:flex-end;flex-wrap:wrap}.exception-mix span{padding:5px 8px;border-radius:6px;background:#F7F5FC;color:#625D70;font-size:11px}.exception-mix i{margin-right:3px;color:#8A6CDE}
.section-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:14px}.ops-section{min-width:0;overflow:hidden;border-color:#E1DDEA;box-shadow:0 3px 12px rgba(47,35,78,.04)}.ops-section.wide{grid-column:1/-1}.section-header{min-height:56px;padding:9px 14px;border-bottom:1px solid #E9E6F0;display:flex;align-items:center;justify-content:space-between;gap:12px;background:#FCFBFE}.section-heading{min-width:0;display:flex;align-items:center;gap:9px}.section-icon{width:31px;height:31px;flex:none;border-radius:8px;display:flex;align-items:center;justify-content:center;background:#EEE9FF;color:#684ACB;font-size:15px}.section-heading h2{font-size:15px}.section-heading p{margin:1px 0 0;color:var(--zcs-secondary-text-color);font-size:11px}.section-link{white-space:nowrap;color:#684ACB;font-weight:600;font-size:11px}.section-link i{margin-left:3px}.section-body{height:292px;overflow:auto;background:#fff}.section-body.tall{height:330px}.subgroup{padding:11px 12px}.subgroup+.subgroup{border-top:1px solid #EAE7F0}.subgroup-title{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:7px}.subgroup-title h3{font-size:12px;margin:0}.subgroup-title span{font-size:11px;color:var(--zcs-secondary-text-color)}
.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:var(--zcs-white-color);overflow:auto;border-radius:6px}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:560px}.zcs-table-wrapper table thead{top:0;z-index:1}.zcs-table-wrapper table thead th{background:#F8F7FC;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap;font-size:11px;color:#605B6C}.zcs-table-wrapper table tbody td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top;font-size:12px}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background:#FAF9FD}.cell-primary{font-weight:500}.cell-secondary{display:block;margin-top:2px;color:var(--zcs-secondary-text-color);font-size:11px}.record-id{font-variant-numeric:tabular-nums;white-space:nowrap}
.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-red{background:#FFF0F2;border-color:#ECA9B5;color:#A72B42}.zcs-badge-yellow{background:#FFF8E8;border-color:#E7C16A;color:#8A6408}.zcs-badge-blue{background:#EEF2FF;border-color:#9CAFEA;color:#3F57A3}.zcs-badge-green{background:#EAF8F1;border-color:#8AC8AB;color:#217653}.zcs-badge-grey{background:#F2F1F4;border-color:#AAA6B0;color:#5D5864}.empty{min-height:92px;padding:18px;color:var(--zcs-secondary-text-color)}.empty i{display:block;margin-bottom:6px;color:#8266D6;font-size:21px}.history-table table{min-width:760px}
@media(max-width:1180px){.context-row{grid-template-columns:repeat(4,minmax(105px,1fr))}.health-grid{grid-template-columns:repeat(3,1fr)}.exception-mix{grid-column:1/-1;justify-content:flex-start}}
@media(max-width:860px){.admin-workspace{padding:13px}.workspace-header{align-items:flex-start;flex-wrap:wrap}.header-copy{flex-basis:calc(100% - 60px)}.priority-summary{margin-left:56px}.section-grid{grid-template-columns:1fr}.ops-section.wide{grid-column:auto}.context-row{grid-template-columns:repeat(2,minmax(0,1fr))}.health-grid{grid-template-columns:1fr}.exception-mix{grid-column:auto}.section-body,.section-body.tall{height:350px}}
@media(max-width:520px){.admin-workspace{padding:9px}.workspace-header{padding:14px}.workspace-header h1{font-size:20px}.header-mark{display:none}.header-copy{flex-basis:100%}.priority-summary{width:100%;margin-left:0;box-sizing:border-box}.context-row{grid-template-columns:1fr 1fr}.health-heading{align-items:flex-start;flex-direction:column}.section-header{align-items:flex-start}.section-link{margin-top:6px}.section-body,.section-body.tall{height:380px}.subgroup{padding:9px}}
</style>
<div class='admin-workspace zcs-box-border'>
  <header class='workspace-header'>
    <div class='header-mark'><span><i class='zc-li-outline ui-1-check-circle-08'></i></span></div>
    <div class='header-copy'><p class='eyebrow'>Administrator workspace</p><h1 class='zcs-m-0'>Cross-module operations</h1><p class='zcs-m-0 zcs-color-secondary'>Live readiness, demand, sourcing, finance, shipment, return, and audit queues.</p></div>
    <div class='priority-summary'><i class='zc-li-outline ui-2-time'></i><div><strong><%=priorityExceptionCount%></strong><span>priority exceptions</span></div></div>
  </header>

  <div class='context-row'>
    <div class='context-tile zcs-card'><span>Customers</span><strong><%=customerCount%></strong><small><%=activeCustomerCount%> active</small></div>
    <div class='context-tile zcs-card'><span>Suppliers</span><strong><%=supplierCount%></strong><small><%=activeSupplierCount%> active</small></div>
    <div class='context-tile zcs-card'><span>Products</span><strong><%=productCount%></strong><small><%=activeProductCount%> active</small></div>
    <div class='context-tile zcs-card'><span>New leads</span><strong><%=newLeadCount%></strong><small>awaiting handoff</small></div>
    <div class='context-tile zcs-card'><span>Open sales</span><strong><%=openSalesOrderCount%></strong><small>not delivered</small></div>
    <div class='context-tile zcs-card'><span>Open POs</span><strong><%=openPOCount%></strong><small>not delivered</small></div>
    <div class='context-tile zcs-card'><span>Recent events</span><strong><%=recentHistoryCount%></strong><small>last 7 days</small></div>
  </div>

  <section class='health-strip zcs-card'>
    <div class='health-heading'><div><p class='eyebrow'>Status distribution</p><h2 class='zcs-m-0'>Operational health</h2></div><span class='zcs-badge zcs-badge-filled-outline zcs-badge-red zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=readinessExceptionCount%> inactive master records</span></div>
    <div class='health-grid'>
      <div class='zcs-progress-bar-wrapper'><p><span>Customer readiness</span><strong><%=customerReadinessPct%>%</strong></p><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=customerReadinessPct%>%'></div></div></div>
      <div class='zcs-progress-bar-wrapper'><p><span>Supplier readiness</span><strong><%=supplierReadinessPct%>%</strong></p><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=supplierReadinessPct%>%'></div></div></div>
      <div class='zcs-progress-bar-wrapper'><p><span>Product readiness</span><strong><%=productReadinessPct%>%</strong></p><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=productReadinessPct%>%'></div></div></div>
      <div class='exception-mix'><span><i class='zc-li-outline ui-2-time'></i> Finance <strong><%=unpaidInvoiceCount%></strong></span><span><i class='zc-li-outline ui-2-time'></i> Logistics <strong><%=openLogisticsCount%></strong></span><span><i class='zc-li-outline ui-2-time'></i> Returns <strong><%=returnCount%></strong></span></div>
    </div>
  </section>

  <div class='section-grid'>
    <section class='ops-section zcs-card'>
      <div class='section-header'><div class='section-heading'><span class='section-icon'><i class='zc-li-outline ui-1-check-circle-08'></i></span><div><h2 class='zcs-m-0'>Master-data readiness</h2><p><%=readinessExceptionCount%> inactive records need review</p></div></div><a class='section-link' href='#Page:Products'>Product catalog <i class='zc-li-outline e-commerce-shopping-cart-simple'></i></a></div>
      <div class='section-body tall'>
        <div class='subgroup'><div class='subgroup-title'><h3>Inactive customers</h3><span><%=customerCount - activeCustomerCount%> total</span></div>
        <% if(inactiveCustomers.count() > 0) { %><div class='zcs-table-wrapper'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Customer</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Contact</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Country</th></tr></thead><tbody><% for each customerRec in inactiveCustomers { %><tr><td class='zcs-px-16 zcs-py-8'><span class='cell-primary'><%=ifnull(customerRec.Customer_Name,"Not named")%></span><span class='cell-secondary'>Customer <%=customerRec.Customer_ID%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(customerRec.Contact_Person,"Not supplied")%><span class='cell-secondary'><%=ifnull(customerRec.Email,"No email")%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(customerRec.Country,"Not supplied")%></td></tr><% } %></tbody></table></div><% } else { %><div class='empty zcs-text-center'><i class='zc-li-outline ui-1-check-circle-08'></i>All customers are active.</div><% } %></div>
        <div class='subgroup'><div class='subgroup-title'><h3>Inactive suppliers</h3><span><%=supplierCount - activeSupplierCount%> total</span></div>
        <% if(inactiveSuppliers.count() > 0) { %><div class='zcs-table-wrapper'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Supplier</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Contact</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Country</th></tr></thead><tbody><% for each supplierRec in inactiveSuppliers { %><tr><td class='zcs-px-16 zcs-py-8'><span class='cell-primary'><%=ifnull(supplierRec.Supplier_Name,"Not named")%></span><span class='cell-secondary'>Supplier <%=supplierRec.Supplier_ID%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(supplierRec.Contact_Person,"Not supplied")%><span class='cell-secondary'><%=ifnull(supplierRec.Email,"No email")%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(supplierRec.Country,"Not supplied")%></td></tr><% } %></tbody></table></div><% } else { %><div class='empty zcs-text-center'><i class='zc-li-outline ui-1-check-circle-08'></i>All suppliers are active.</div><% } %></div>
        <div class='subgroup'><div class='subgroup-title'><h3>Inactive products</h3><span><%=productCount - activeProductCount%> total</span></div>
        <% if(inactiveProducts.count() > 0) { %><div class='zcs-table-wrapper'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Product</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Category</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Part number</th></tr></thead><tbody><% for each productRec in inactiveProducts { %><tr><td class='zcs-px-16 zcs-py-8'><span class='cell-primary'><%=ifnull(productRec.Product_Name,"Not named")%></span><span class='cell-secondary'>Product <%=productRec.Product_ID%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(productRec.Product_Category,"Not categorized")%><span class='cell-secondary'><%=ifnull(productRec.Product_Type,"No type")%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(productRec.Internal_Part_Number,"Not supplied")%></td></tr><% } %></tbody></table></div><% } else { %><div class='empty zcs-text-center'><i class='zc-li-outline ui-1-check-circle-08'></i>All products are active.</div><% } %></div>
      </div>
    </section>

    <section class='ops-section zcs-card'>
      <div class='section-header'><div class='section-heading'><span class='section-icon'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i></span><div><h2 class='zcs-m-0'>Active sales work</h2><p>New demand and orders still in progress</p></div></div><a class='section-link' href='#Page:Sales_Orders'>Sales orders <i class='zc-li-outline e-commerce-shopping-cart-simple'></i></a></div>
      <div class='section-body tall'>
        <div class='subgroup'><div class='subgroup-title'><h3>New leads</h3><span><%=newLeadCount%> total</span></div><% if(newLeads.count() > 0) { %><div class='zcs-table-wrapper'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Lead</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Customer</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Requirement</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Expected</th></tr></thead><tbody><% for each leadRec in newLeads { %><tr><td class='zcs-px-16 zcs-py-8 record-id'>Lead <%=leadRec.Lead_ID%><span class='cell-secondary'><%=ifnull(leadRec.Lead_Date,"No date")%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(leadRec.Customer_Company_Name,"Not supplied")%><span class='cell-secondary'><%=ifnull(leadRec.Contact_Person,"No contact")%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(leadRec.Requirement,"No requirement summary")%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=ifnull(leadRec.Expected_Price,0)%></td></tr><% } %></tbody></table></div><% } else { %><div class='empty zcs-text-center'><i class='zc-li-outline ui-1-check-circle-08'></i>No new leads awaiting review.</div><% } %></div>
        <div class='subgroup'><div class='subgroup-title'><h3>Open sales orders</h3><span><%=openSalesOrderCount%> total</span></div><% if(activeSalesOrders.count() > 0) { %><div class='zcs-table-wrapper'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Order</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Customer</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Requested delivery</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Status</th></tr></thead><tbody><% for each salesOrderRec in activeSalesOrders { %><tr><td class='zcs-px-16 zcs-py-8 record-id'>SO <%=salesOrderRec.Sales_Order_ID%><span class='cell-secondary'><%=ifnull(salesOrderRec.Sales_Order_Date,"No date")%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(salesOrderRec.Customer,"Not linked")%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(salesOrderRec.Requested_Delivery_Date,"Not set")%></td><td class='zcs-px-16 zcs-py-8'><span class='zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=ifnull(salesOrderRec.Status,"Unknown")%></span></td></tr><% } %></tbody></table></div><% } else { %><div class='empty zcs-text-center'><i class='zc-li-outline ui-1-check-circle-08'></i>No active sales orders.</div><% } %></div>
      </div>
    </section>

    <section class='ops-section zcs-card'>
      <div class='section-header'><div class='section-heading'><span class='section-icon'><i class='zc-li-outline ui-1-check-circle-08'></i></span><div><h2 class='zcs-m-0'>Sourcing work</h2><p>Supplier responses and purchase-order handoffs</p></div></div><a class='section-link' href='#Page:Purchase_Orders'>Purchase orders <i class='zc-li-outline e-commerce-shopping-cart-simple'></i></a></div>
      <div class='section-body tall'>
        <div class='subgroup'><div class='subgroup-title'><h3>Quotes received</h3><span><%=receivedQuoteCount%> total</span></div><% if(receivedQuotes.count() > 0) { %><div class='zcs-table-wrapper'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Quote</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Supplier</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Sales order</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Lead time</th></tr></thead><tbody><% for each supplierQuoteRec in receivedQuotes { %><tr><td class='zcs-px-16 zcs-py-8 record-id'>Quote <%=supplierQuoteRec.Supplier_Quote_ID%><span class='cell-secondary'><%=ifnull(supplierQuoteRec.Quote_Date,"No date")%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(supplierQuoteRec.Supplier,"Not linked")%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(supplierQuoteRec.Sales_Order,"Not linked")%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(supplierQuoteRec.Lead_Time,"Not supplied")%></td></tr><% } %></tbody></table></div><% } else { %><div class='empty zcs-text-center'><i class='zc-li-outline ui-1-check-circle-08'></i>No received quotes awaiting handoff.</div><% } %></div>
        <div class='subgroup'><div class='subgroup-title'><h3>Open purchase orders</h3><span><%=openPOCount%> total</span></div><% if(activePurchaseOrders.count() > 0) { %><div class='zcs-table-wrapper'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>PO</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Supplier</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Expected</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Status</th></tr></thead><tbody><% for each purchaseOrderRec in activePurchaseOrders { %><tr><td class='zcs-px-16 zcs-py-8 record-id'>PO <%=purchaseOrderRec.Purchase_Order_ID%><span class='cell-secondary'><%=ifnull(purchaseOrderRec.PO_Date,"No date")%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(purchaseOrderRec.Supplier,"Not linked")%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(purchaseOrderRec.Expected_Delivery_Date,"Not set")%></td><td class='zcs-px-16 zcs-py-8'><span class='zcs-badge zcs-badge-filled-outline zcs-badge-yellow zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=ifnull(purchaseOrderRec.Status,"Unknown")%></span></td></tr><% } %></tbody></table></div><% } else { %><div class='empty zcs-text-center'><i class='zc-li-outline ui-1-check-circle-08'></i>No open purchase orders.</div><% } %></div>
      </div>
    </section>

    <section class='ops-section zcs-card'>
      <div class='section-header'><div class='section-heading'><span class='section-icon'><i class='zc-li-outline ui-2-time'></i></span><div><h2 class='zcs-m-0'>Finance exceptions</h2><p>Unpaid supplier invoices requiring follow-up</p></div></div><a class='section-link' href='#Page:Supplier_Invoices'>Invoices <i class='zc-li-outline e-commerce-shopping-cart-simple'></i></a></div>
      <div class='section-body'><% if(unpaidInvoices.count() > 0) { %><div class='subgroup'><div class='zcs-table-wrapper'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Invoice</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Supplier</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Purchase order</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Amount</th></tr></thead><tbody><% for each supplierInvoiceRec in unpaidInvoices { %><tr><td class='zcs-px-16 zcs-py-8'><span class='cell-primary'><%=ifnull(supplierInvoiceRec.Supplier_Invoice_Number,"Not numbered")%></span><span class='cell-secondary'><%=ifnull(supplierInvoiceRec.Invoice_Date,"No date")%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(supplierInvoiceRec.Supplier,"Not linked")%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(supplierInvoiceRec.Purchase_Order,"Not linked")%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=ifnull(supplierInvoiceRec.Currency,"")%> <%=ifnull(supplierInvoiceRec.Invoice_Amount,0)%></td></tr><% } %></tbody></table></div></div><% } else { %><div class='empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div><i class='zc-li-outline ui-1-check-circle-08'></i>No unpaid supplier invoices.</div></div><% } %></div>
    </section>

    <section class='ops-section wide zcs-card'>
      <div class='section-header'><div class='section-heading'><span class='section-icon'><i class='zc-li-outline ui-2-time'></i></span><div><h2 class='zcs-m-0'>Logistics and returns exceptions</h2><p>Open shipments and return requests requiring operational ownership</p></div></div><a class='section-link' href='#Page:Logistics_Bookings'>Logistics <i class='zc-li-outline e-commerce-shopping-cart-simple'></i></a></div>
      <div class='section-body tall'><div class='subgroup'><div class='subgroup-title'><h3>Open logistics bookings</h3><span><%=openLogisticsCount%> total</span></div><% if(openLogistics.count() > 0) { %><div class='zcs-table-wrapper'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Booking</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Provider</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Route</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Expected arrival</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Tracking</th></tr></thead><tbody><% for each logisticsRec in openLogistics { %><tr><td class='zcs-px-16 zcs-py-8 record-id'>Booking <%=logisticsRec.Logistics_Booking_ID%><span class='cell-secondary'><%=ifnull(logisticsRec.Booking_Date,"No date")%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(logisticsRec.Logistics_Provider,"Not supplied")%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(logisticsRec.Pickup_Location,"Unknown")%><span class='cell-secondary'>to <%=ifnull(logisticsRec.Warehouse_Destination,"unknown")%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(logisticsRec.Expected_Arrival_Date,"Not set")%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(logisticsRec.Tracking_Reference,"Not supplied")%></td></tr><% } %></tbody></table></div><% } else { %><div class='empty zcs-text-center'><i class='zc-li-outline ui-1-check-circle-08'></i>No open logistics bookings.</div><% } %></div>
      <div class='subgroup'><div class='subgroup-title'><h3>Return requests</h3><span><%=returnCount%> total</span></div><% if(returnRequests.count() > 0) { %><div class='zcs-table-wrapper'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Request</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Customer</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Purchase order</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Issue</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Responsibility</th></tr></thead><tbody><% for each returnRequestRec in returnRequests { %><tr><td class='zcs-px-16 zcs-py-8 record-id'>Return <%=returnRequestRec.Return_Request_ID%><span class='cell-secondary'><%=ifnull(returnRequestRec.Return_Date,"No date")%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(returnRequestRec.Customer,"Not linked")%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(returnRequestRec.Purchase_Order,"Not linked")%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(returnRequestRec.Issue_Description,"No issue summary")%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(returnRequestRec.Damage_Responsibility,"Not assigned")%></td></tr><% } %></tbody></table></div><% } else { %><div class='empty zcs-text-center'><i class='zc-li-outline ui-1-check-circle-08'></i>No return requests.</div><% } %></div></div>
    </section>

    <section class='ops-section wide zcs-card'>
      <div class='section-header'><div class='section-heading'><span class='section-icon'><i class='zc-li-outline ui-2-time'></i></span><div><h2 class='zcs-m-0'>Recent history</h2><p>Newest operational changes from the last 7 days</p></div></div><a class='section-link' href='#Report:All_Histories'>History report <i class='zc-li-outline ui-2-time'></i></a></div>
      <div class='section-body history-table'><% if(recentHistory.count() > 0) { %><div class='subgroup'><div class='zcs-table-wrapper'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>When</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Action</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Status change</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Updated by</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Comments</th></tr></thead><tbody><% for each historyRec in recentHistory { %><tr><td class='zcs-px-16 zcs-py-8'><%=ifnull(historyRec.Updated_Date_Time,"No timestamp")%></td><td class='zcs-px-16 zcs-py-8'><span class='cell-primary'><%=ifnull(historyRec.Action_Type,"Update")%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(historyRec.Previous_Status,"Not recorded")%><span class='cell-secondary'>to <%=ifnull(historyRec.New_Status,ifnull(historyRec.Status,"Not recorded"))%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(historyRec.Updated_By,"System")%><span class='cell-secondary'><%=ifnull(historyRec.Updated_By_Email,"")%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(historyRec.Comments,ifnull(historyRec.Subform_Details_Change_Summary,"No comments"))%></td></tr><% } %></tbody></table></div></div><% } else { %><div class='empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div><i class='zc-li-outline ui-2-time'></i>No operational history in the last 7 days.</div></div><% } %></div>
    </section>
  </div>
</div>