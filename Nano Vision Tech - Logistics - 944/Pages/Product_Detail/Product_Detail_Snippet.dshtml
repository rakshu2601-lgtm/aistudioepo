<%
productList = Add_Product[ID == input.Product_ID];
leadRows = Lead_Product[Product == input.Product_ID] sort by ID desc;
soRows = Sales_Order_Product[Product == input.Product_ID] sort by ID desc;
quoteRows = Supplier_Quote_Product[Product == input.Product_ID] sort by ID desc;
poRows = Purchase_Order_Product[Product == input.Product_ID] sort by ID desc;
invoiceRows = Supplier_Invoice_Product[Product == input.Product_ID] sort by ID desc;
logisticsRows = Logistics_Booking_Product[Product == input.Product_ID] sort by ID desc;
returnRows = Return_Request_Product[Product == input.Product_ID] sort by ID desc;
%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#f5f6f8;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-white-color:#fff;--zcs-border-color:var(--zcs_tertiary_border_color);font-size:16px;line-height:1.5}*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-p-0{padding:0}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:.625rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-box-border{box-sizing:border-box}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-22{font-size:1.375rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-sticky{position:sticky}a{text-decoration:none}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{box-shadow:none!important;border-radius:0!important}#splash-screen{display:none!important}
.product-detail-page{min-height:100%;padding:18px;background:var(--zcs-page-bg-color);font:14px/1.5 Arial,sans-serif;color:var(--zcs-primary-text-color)}.detail-shell{max-width:1480px;margin:auto}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.identity-header{padding:16px 18px;margin-bottom:14px}.identity-main{min-width:0}.zcs-back{width:34px;height:34px;border:1px solid var(--zcs_tertiary_border_color);border-radius:8px;color:var(--zcs_tertiary_text_color);flex:0 0 auto}.zcs-back:hover{background:var(--zcs_component_hover_color)}.identity-kicker{font-size:12px;color:var(--zcs_brand_color);font-weight:700;letter-spacing:.04em;text-transform:uppercase}.identity-title{font-size:23px;line-height:1.2;margin:2px 0 4px;overflow-wrap:anywhere}.identity-meta{display:flex;gap:7px;flex-wrap:wrap;color:var(--zcs-secondary-text-color)}.meta-chip{padding:2px 7px;background:#f4f5f8;border-radius:5px}.header-side{display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}.zcs-badge{width:auto;border:1px solid;gap:6px}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#087c51}.zcs-badge-grey{background:#ececf1;border-color:#686875;color:#35353d}.overview-grid{display:grid;grid-template-columns:240px minmax(0,1fr);gap:14px;margin-bottom:14px}.media-card,.spec-card,.narrative-card,.lifecycle-card,.usage-card{padding:16px}.product-image{height:180px;display:flex;align-items:center;justify-content:center;border:1px solid var(--zcs_tertiary_border_color);border-radius:9px;background:#f8f9fc;overflow:hidden}.product-image img{width:100%;height:100%;object-fit:contain}.product-image i{font-size:42px;color:var(--zcs_brand_color)}.document-list{display:grid;gap:7px;margin-top:10px}.document-link{display:flex;align-items:center;gap:7px;padding:7px 8px;border:1px solid var(--zcs_tertiary_border_color);border-radius:6px;color:var(--zcs_brand_color);overflow-wrap:anywhere}.document-link.is-empty{color:var(--zcs-secondary-text-color);background:#fafafa}.section-title{font-size:15px;font-weight:650;margin:0}.section-caption{font-size:12px;color:var(--zcs-secondary-text-color);margin-top:2px}.spec-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:12px}.spec-item{padding:10px 11px;background:#f9fafe;border:1px solid #eceef4;border-radius:8px;min-width:0}.spec-label{display:block;font-size:11px;color:var(--zcs_tertiary_text_color);margin-bottom:3px}.spec-value{display:block;font-weight:600;overflow-wrap:anywhere}.narrative-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-bottom:14px}.narrative-head{display:flex;align-items:center;gap:8px;margin-bottom:9px}.narrative-head i{color:var(--zcs_brand_color);font-size:17px}.field-value{white-space:pre-wrap;overflow-wrap:anywhere}.lifecycle-card{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:14px}.lifecycle-items{display:flex;gap:22px;flex-wrap:wrap}.lifecycle-item span{display:block}.lifecycle-label{font-size:11px;color:var(--zcs_tertiary_text_color)}.lifecycle-value{font-weight:600}.usage-summary{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}.usage-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.usage-titlebar{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px}.section-heading{display:flex;align-items:center;gap:9px}.section-icon{width:31px;height:31px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;background:#e8efff;color:#2a6ffc}.tone-green{background:#e8faf3;color:#179e6c}.tone-orange{background:#fff2e9;color:#c85308}.tone-purple{background:#f4edff;color:#713ab7}.count-pill{background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);padding:2px 8px;border-radius:10px;font-size:12px;font-weight:700}.zcs-table-wrapper{height:248px;max-height:248px;border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto;border-radius:7px}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:700px}.zcs-table-wrapper thead{top:0;z-index:1}.zcs-table-wrapper th{background:#f4f6fa;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper tbody tr:hover td{background:#f9fafe}.record-link{color:var(--zcs_brand_color);font-weight:650}.semantic-tag{display:inline-flex;padding:2px 6px;border-radius:5px;background:#f0f3f8;color:var(--zcs-secondary-text-color);font-size:12px}.zcs-nodata-wrapper{min-height:110px;color:var(--zcs-secondary-text-color)}
@media(max-width:1100px){.spec-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:850px){.product-detail-page{padding:12px}.overview-grid{grid-template-columns:1fr}.media-card{display:grid;grid-template-columns:190px 1fr;gap:12px}.spec-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.narrative-grid,.usage-grid{grid-template-columns:1fr}.identity-header,.lifecycle-card{align-items:flex-start;flex-direction:column}.header-side{justify-content:flex-start}}@media(max-width:560px){.product-detail-page{padding:8px}.identity-header,.media-card,.spec-card,.narrative-card,.lifecycle-card,.usage-card{padding:12px}.media-card{display:block}.product-image{height:190px}.spec-grid{grid-template-columns:1fr}.identity-title{font-size:20px}.zcs-table-wrapper{height:260px;max-height:260px}.lifecycle-items{gap:12px}.header-side{width:100%}.zcs-button{flex:1}}
</style>
<div class='product-detail-page'><div class='detail-shell'>
<% if(productList.count() == 0) { %>
  <div class='zcs-card zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><i class='zc-li-outline ui-2-ban' style='font-size:30px;color:var(--zcs_brand_color)'></i><h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0'>Product not found</h5><div>Check the Product_ID parameter or return to the product catalog.</div><a class='zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Page:Products' style='margin-top:14px'><i class='zc-li-outline arrows-1-tail-left'></i><span>Products</span></a></div></div>
<% } else { product = productList; %>
  <header class='zcs-card identity-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16'>
    <div class='identity-main zcs-flex zcs-align-items-center zcs-gap-12'><a href='#Page:Products' class='zcs-back zcs-flex zcs-align-items-center zcs-justify-center' title='Back to products'><i class='zcs-font-22 zc-li-outline arrows-1-tail-left'></i></a><div><div class='identity-kicker'>Product <%=product.Product_ID%></div><h1 class='identity-title'><%=product.Product_Name%></h1><div class='identity-meta'><span class='meta-chip'><%=ifnull(product.Product_Category,"Uncategorized")%></span><span class='meta-chip'><%=ifnull(product.Product_Type,"Type not set")%></span><span class='meta-chip'><%=ifnull(product.Internal_Part_Number,"Part number not set")%></span></div></div></div>
    <div class='header-side'><span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 <%=if(product.Active == true,"zcs-badge-green","zcs-badge-grey")%>'><i class='zc-li-outline <%=if(product.Active == true,"ui-1-check-circle-08","ui-1-circle-remove")%>'></i><span><%=if(product.Active == true,"Active","Inactive")%></span></span><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Form:Add_Product?recLinkID=<%=product.ID%>&viewLinkName=All_Products'><i class='zc-li-outline ui-1-edit-72'></i><span>Edit</span></a></div>
  </header>
  <div class='overview-grid'>
    <section class='zcs-card media-card'><div class='product-image'><% if(product.Product_Image != null && product.Product_Image != "") { %><img src='<%=product.Product_Image%>' alt='<%=product.Product_Name%>'><% } else { %><i class='zc-li-outline design-image'></i><% } %></div><div class='document-list'><% if(product.Product_Datasheet != null && product.Product_Datasheet != "") { %><a class='document-link' href='<%=product.Product_Datasheet%>' target='_blank'><i class='zc-li-outline files-single-copy-04'></i><span>Product datasheet</span></a><% } else { %><span class='document-link is-empty'><i class='zc-li-outline files-single-copy-04'></i><span>No datasheet</span></span><% } %><% if(product.Additional_Attachments != null && product.Additional_Attachments != "") { %><a class='document-link' href='<%=product.Additional_Attachments%>' target='_blank'><i class='zc-li-outline files-folder-15'></i><span>Additional attachments</span></a><% } else { %><span class='document-link is-empty'><i class='zc-li-outline files-folder-15'></i><span>No additional attachments</span></span><% } %></div></section>
    <section class='zcs-card spec-card'><div><h2 class='section-title'>Specifications</h2><div class='section-caption'>Identity, commercial references, and supply attributes</div></div><div class='spec-grid'>
      <div class='spec-item'><span class='spec-label'>Brand / Make</span><span class='spec-value'><%=ifnull(product.Brand_Make,"-")%></span></div><div class='spec-item'><span class='spec-label'>Model</span><span class='spec-value'><%=ifnull(product.Model,"-")%></span></div><div class='spec-item'><span class='spec-label'>Manufacturer Part Number</span><span class='spec-value'><%=ifnull(product.Manufacturer_Part_Number,"-")%></span></div><div class='spec-item'><span class='spec-label'>Unit of Measure</span><span class='spec-value'><%=ifnull(product.Unit_of_Measure,"-")%></span></div>
      <div class='spec-item'><span class='spec-label'>Currency</span><span class='spec-value'><%=ifnull(product.Default_Currency,"-")%></span></div><div class='spec-item'><span class='spec-label'>Reference Cost</span><span class='spec-value'><%=ifnull(product.Reference_Cost,"-")%></span></div><div class='spec-item'><span class='spec-label'>Reference Selling Price</span><span class='spec-value'><%=ifnull(product.Reference_Selling_Price,"-")%></span></div><div class='spec-item'><span class='spec-label'>Warranty Period</span><span class='spec-value'><%=ifnull(product.Warranty_Period,"-")%></span></div>
      <div class='spec-item'><span class='spec-label'>Country of Origin</span><span class='spec-value'><%=ifnull(product.Country_of_Origin,"-")%></span></div><div class='spec-item'><span class='spec-label'>Product ID</span><span class='spec-value'><%=product.Product_ID%></span></div><div class='spec-item'><span class='spec-label'>Category</span><span class='spec-value'><%=ifnull(product.Product_Category,"-")%></span></div><div class='spec-item'><span class='spec-label'>Type</span><span class='spec-value'><%=ifnull(product.Product_Type,"-")%></span></div>
    </div></section>
  </div>
  <div class='narrative-grid'><section class='zcs-card narrative-card'><div class='narrative-head'><i class='zc-li-outline files-single-copy-04'></i><h2 class='section-title'>Product description</h2></div><div class='field-value'><%=ifnull(product.Product_Description,"No description provided.")%></div></section><section class='zcs-card narrative-card'><div class='narrative-head'><i class='zc-li-outline design-ruler-pencil'></i><h2 class='section-title'>Technical specifications</h2></div><div class='field-value'><%=ifnull(product.Technical_Specifications,"No specifications provided.")%></div></section><section class='zcs-card narrative-card'><div class='narrative-head'><i class='zc-li-outline ui-2-settings-90'></i><h2 class='section-title'>Configuration template</h2></div><div class='field-value'><%=ifnull(product.Configuration_Template,"No configuration template provided.")%></div></section></div>
  <section class='zcs-card lifecycle-card'><div><h2 class='section-title'>Lifecycle</h2><div class='section-caption'>Master record stewardship and availability state</div></div><div class='lifecycle-items'><div class='lifecycle-item'><span class='lifecycle-label'>State</span><span class='lifecycle-value'><%=if(product.Active == true,"Active","Inactive")%></span></div><div class='lifecycle-item'><span class='lifecycle-label'>Created</span><span class='lifecycle-value'><%=ifnull(product.Created_Date_Time,"-")%></span></div><div class='lifecycle-item'><span class='lifecycle-label'>Last updated</span><span class='lifecycle-value'><%=ifnull(product.Last_Updated_Date_Time,"-")%></span></div></div><a class='record-link' href='#Report:All_Products?ID=<%=product.ID%>'><i class='zc-li-outline arrows-1-tail-right'></i> Open record</a></section>
  <div class='usage-summary'><div><h2 class='section-title'>Operational usage</h2><div class='section-caption'>Demand through returns, with each list independently scrollable</div></div><span class='count-pill'><%=leadRows.count() + soRows.count() + quoteRows.count() + poRows.count() + invoiceRows.count() + logisticsRows.count() + returnRows.count()%> total</span></div>
  <div class='usage-grid'>
<%
sectionNames = {"Leads","Sales orders","Supplier quotes","Purchase orders","Supplier invoices","Logistics","Returns"};
sectionCounts = {leadRows.count(),soRows.count(),quoteRows.count(),poRows.count(),invoiceRows.count(),logisticsRows.count(),returnRows.count()};
for each index i in sectionNames
{
%><section class='zcs-card usage-card'><div class='usage-titlebar'><div class='section-heading'><span class='section-icon <%=if(i == 0 || i == 3,"tone-green",if(i == 1 || i == 4,"tone-orange",if(i == 2 || i == 6,"tone-purple","")))%>'><i class='zc-li-outline <%=if(i == 0,"users-single-05",if(i == 1,"e-commerce-shopping-cart-simple",if(i == 2,"business-handshake",if(i == 3,"files-single-copy-04",if(i == 4,"files-single-copy-04",if(i == 5,"transportation-truck-front","arrows-1-reply"))))))%>'></i></span><div><h2 class='section-title'><%=sectionNames.get(i)%></h2><div class='section-caption'>Related product records</div></div></div><span class='count-pill'><%=sectionCounts.get(i)%></span></div><div class='zcs-table-wrapper'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Transaction</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Configuration / Requirement</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Quantity</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Details</th></tr></thead><tbody><%
if(i == 0) { for each leadItem in leadRows { %><tr><td class='zcs-px-16 zcs-py-8'><% if(leadItem.Parent_Lead != null) { %><a class='record-link' href='#Page:Lead_Detail?Lead_ID=<%=leadItem.Parent_Lead.ID%>'><%=leadItem.Parent_Lead.Lead_ID%></a><% } else { %><span class='semantic-tag'>Lead unavailable</span><% } %></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(leadItem.Configuration,"-")%><br><span class='zcs-color-secondary'><%=ifnull(leadItem.Technical_Requirements,"")%></span></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=leadItem.Quantity%></td><td class='zcs-px-16 zcs-py-8'>Expected unit: <%=ifnull(leadItem.Expected_Unit_Price,"-")%><br><%=ifnull(leadItem.Remarks,"")%></td></tr><% } }
else if(i == 1) { for each salesItem in soRows { %><tr><td class='zcs-px-16 zcs-py-8'><% if(salesItem.Parent_Sales_Order != null) { %><a class='record-link' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=salesItem.Parent_Sales_Order.ID%>'><%=salesItem.Parent_Sales_Order.Sales_Order_ID%></a><% } else { %><span class='semantic-tag'>Order unavailable</span><% } %></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(salesItem.Configuration,"-")%><br><span class='zcs-color-secondary'><%=ifnull(salesItem.Technical_Requirements,"")%></span></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=salesItem.Quantity%></td><td class='zcs-px-16 zcs-py-8'>Availability: <%=ifnull(salesItem.Required_Availability,"-")%><br>Lead time: <%=ifnull(salesItem.Required_Lead_Time,"-")%></td></tr><% } }
else if(i == 2) { for each quoteItem in quoteRows { %><tr><td class='zcs-px-16 zcs-py-8'><% if(quoteItem.Parent_Supplier_Quote != null) { %><a class='record-link' href='#Page:Supplier_Quotes'><%=quoteItem.Parent_Supplier_Quote.Supplier_Quote_ID%></a><% } else { %><span class='semantic-tag'>Quote unavailable</span><% } %></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(quoteItem.Offered_Configuration,"-")%><br><span class='zcs-color-secondary'><%=ifnull(quoteItem.Configuration_Match,"")%></span></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=quoteItem.Quoted_Quantity%></td><td class='zcs-px-16 zcs-py-8'><%=quoteItem.Currency%> <%=quoteItem.Supplier_Total_Price%><br><%=ifnull(quoteItem.Availability,"-")%> / <%=ifnull(quoteItem.Lead_Time,"-")%></td></tr><% } }
else if(i == 3) { for each purchaseItem in poRows { %><tr><td class='zcs-px-16 zcs-py-8'><% if(purchaseItem.Parent_Purchase_Order != null) { %><a class='record-link' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=purchaseItem.Parent_Purchase_Order.ID%>'><%=purchaseItem.Parent_Purchase_Order.Purchase_Order_ID%></a><% } else { %><span class='semantic-tag'>PO unavailable</span><% } %></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(purchaseItem.Approved_Configuration,"-")%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=purchaseItem.Quantity%></td><td class='zcs-px-16 zcs-py-8'><%=purchaseItem.Currency%> <%=purchaseItem.Customer_Total_Price%><br><%=ifnull(purchaseItem.Remarks,"")%></td></tr><% } }
else if(i == 4) { for each invoiceItem in invoiceRows { %><tr><td class='zcs-px-16 zcs-py-8'><% if(invoiceItem.Parent_Supplier_Invoice != null) { %><a class='record-link' href='#Page:Supplier_Invoice_Detail?Supplier_Invoice_ID=<%=invoiceItem.Parent_Supplier_Invoice.ID%>'><%=invoiceItem.Parent_Supplier_Invoice.Supplier_Invoice_ID%></a><% } else { %><span class='semantic-tag'>Invoice unavailable</span><% } %></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(invoiceItem.Configuration,"-")%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=invoiceItem.Quantity%></td><td class='zcs-px-16 zcs-py-8'><%=invoiceItem.Currency%> <%=invoiceItem.Total_Price%><br><%=ifnull(invoiceItem.Remarks,"")%></td></tr><% } }
else if(i == 5) { for each logisticsItem in logisticsRows { %><tr><td class='zcs-px-16 zcs-py-8'><% if(logisticsItem.Parent_Logistics_Booking != null) { %><a class='record-link' href='#Page:Logistics_Booking_Detail?Logistics_Booking_ID=<%=logisticsItem.Parent_Logistics_Booking.ID%>'><%=logisticsItem.Parent_Logistics_Booking.Logistics_Booking_ID%></a><% } else { %><span class='semantic-tag'>Booking unavailable</span><% } %></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(logisticsItem.Configuration,"-")%><br><span class='zcs-color-secondary'><%=ifnull(logisticsItem.Serial_Number_Details,"")%></span></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'>Expected <%=logisticsItem.Expected_Quantity%><br>Received <%=ifnull(logisticsItem.Received_Quantity,0)%></td><td class='zcs-px-16 zcs-py-8'>Accepted <%=ifnull(logisticsItem.Accepted_Quantity,0)%> / Rejected <%=ifnull(logisticsItem.Rejected_Quantity,0)%><br><%=ifnull(logisticsItem.Receiving_Remarks,"")%></td></tr><% } }
else { for each returnItem in returnRows { %><tr><td class='zcs-px-16 zcs-py-8'><% if(returnItem.Parent_Return_Request != null) { %><a class='record-link' href='#Page:Return_Request_Detail?Return_Request_ID=<%=returnItem.Parent_Return_Request.ID%>'><%=returnItem.Parent_Return_Request.Return_Request_ID%></a><% } else { %><span class='semantic-tag'>Return unavailable</span><% } %></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(returnItem.Configuration,"-")%><br><span class='zcs-color-secondary'>Serial: <%=ifnull(returnItem.Serial_Number,"-")%></span></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=returnItem.Return_Quantity%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(returnItem.Damage_Responsibility,"-")%><br><%=ifnull(returnItem.Defect_Description,"-")%></td></tr><% } }
if(sectionCounts.get(i) == 0) { %><tr><td colspan='4'><div class='zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><i class='zc-li-outline files-single-copy-04' style='font-size:22px'></i><div>No related <%=sectionNames.get(i)%></div></div></div></td></tr><% }
%></tbody></table></div></section><%
}
%>
  </div>
<% } %>
</div></div>