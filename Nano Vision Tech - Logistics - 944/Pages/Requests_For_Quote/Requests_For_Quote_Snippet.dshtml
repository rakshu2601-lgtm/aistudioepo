<%
loginEmail = zoho.loginuserid;
activeSuppliers = Add_Supplier[Email == loginEmail && Active == true];
supplierCount = activeSuppliers.count();
identityReady = supplierCount == 1;
supplierId = 0;
supplierName = "Supplier";
eligibleOrders = Create_Sales_Order[ID == 0];
myQuotes = Add_Supplier_Quote[ID == 0];
awaitingCount = 0;
dueSoonCount = 0;
if(identityReady)
{
    for each supplierRec in activeSuppliers
    {
        supplierId = supplierRec.ID;
        supplierName = supplierRec.Supplier_Name;
    }
    eligibleOrders = Create_Sales_Order[(Status == "New" || Status == "Quotes Received") && (Recommended_Supplier == null || Recommended_Supplier == supplierId)] sort by Requested_Delivery_Date asc;
    myQuotes = Add_Supplier_Quote[Supplier == supplierId] sort by Quote_Date descending;
    for each summaryOrder in eligibleOrders
    {
        summaryResponses = Add_Supplier_Quote[Supplier == supplierId && Sales_Order == summaryOrder.ID];
        if(summaryResponses.count() == 0)
        {
            awaitingCount = awaitingCount + 1;
        }
        if(summaryOrder.Requested_Delivery_Date != null && summaryOrder.Requested_Delivery_Date >= zoho.currentdate && summaryOrder.Requested_Delivery_Date <= zoho.currentdate.addDay(7))
        {
            dueSoonCount = dueSoonCount + 1;
        }
    }
}
%>
<style>
/* ZCS global utility sheet: page-scoped rules used by this single snippet. */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row-wrap{flex-wrap:wrap}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:.625rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-lh-body{line-height:1.5}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-sticky{position:sticky}.zcs-relative{position:relative}.zcs-card{background:#fff;border:1px solid #e6e2ee;border-radius:12px}a{text-decoration:none}
.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%;width:100%}.zc-container-wrapper .zc-main-content .inner,.zc-page-content-wrapper,.zc-pb-page-content-wrapper,.zc-pb-tile-container,.zc-pb-tile-card{max-width:none!important;width:100%!important;box-sizing:border-box}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}#splash-screen,.zc-page-loader{display:none!important}
/* ZCS: card-sample-4, badge-filled-outlined-badge, table-simple-table, button-primary-button, button-primary-outline-button, no-data-no-data. */
.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto;border:1px solid}.zcs-badge-theme{background:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#167c59}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#245bcc}.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#946200}.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#c92c42}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;line-height:normal;min-width:760px}.zcs-table-wrapper thead{top:0;z-index:2}.zcs-table-wrapper th{background:#f8f6fc;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper tbody tr:hover td{background:#faf9fc}
.rfq-page{min-height:100%;padding:18px;background:#f7f5fa;color:var(--zcs_primary_text_color);font:14px/1.45 Arial,sans-serif;box-sizing:border-box}.rfq-header{padding:20px 22px;border:1px solid #e2dceb;border-left:4px solid #76539b;border-radius:12px;background:#fff}.eyebrow{color:#76539b;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.rfq-title{margin:3px 0 0;font-size:24px;line-height:1.2}.rfq-copy{margin:5px 0 0;color:var(--zcs_secondary_text_color)}.supplier-chip{padding:7px 10px;border-radius:8px;background:#f1edf6;color:#5f437c}.identity-state{max-width:760px;margin:36px auto;padding:32px;border:1px solid #e2dceb;border-radius:12px;background:#fff;text-align:center}.identity-state>i{font-size:34px;color:#76539b}.identity-state p{color:var(--zcs_secondary_text_color)}.summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:12px 0}.metric{padding:12px 14px;border:1px solid #e6e2ee;border-radius:10px;background:#fff}.metric-top{display:flex;align-items:center;justify-content:space-between;gap:8px}.metric-icon{color:#76539b;font-size:17px}.metric-label{color:var(--zcs_secondary_text_color);font-size:12px}.metric-value{margin-top:2px;font-size:21px;font-weight:700}.metric.alert .metric-value,.metric.alert .metric-icon{color:#a56a08}.register-head{margin:15px 2px 9px}.register-title{margin:0;font-size:16px}.register-copy{color:var(--zcs_secondary_text_color);font-size:12px}.rfq-register{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;max-height:690px;overflow:auto;padding:1px 5px 4px 1px}.request-card{min-width:0;height:560px;overflow:hidden;display:flex;flex-direction:column}.request-head{padding:14px 16px;border-bottom:1px solid #e6e2ee;background:#faf8fc}.request-id{font-size:17px;font-weight:600}.request-body{padding:14px 16px 15px;overflow:auto;display:flex;flex:1;flex-direction:column}.meta-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-bottom:11px}.meta{min-width:0;padding:9px 10px;border:1px solid #ece8f1;border-radius:8px;background:#fbfafc;overflow-wrap:anywhere}.meta-label{display:flex;align-items:center;gap:5px;color:var(--zcs_secondary_text_color);font-size:12px;margin-bottom:2px}.meta-label i{color:#76539b}.products{max-height:230px}.action-row{margin-top:auto;padding-top:12px}.empty{min-height:360px;margin-top:12px}.empty-icon{font-size:34px;color:#76539b}.mobile-products{display:none}.mobile-product{padding:10px;border:1px solid var(--zcs_tertiary_border_color);border-radius:8px}.mobile-product+.mobile-product{margin-top:8px}.mobile-kv{display:grid;grid-template-columns:100px 1fr;gap:4px 7px;margin-top:7px}.mobile-kv span:nth-child(odd){color:var(--zcs_secondary_text_color)}
@media(max-width:1050px){.summary{grid-template-columns:repeat(2,1fr)}.rfq-register{grid-template-columns:1fr;max-height:760px}.request-card{height:570px}}@media(max-width:650px){.rfq-page{padding:10px}.rfq-header{padding:16px}.supplier-chip{width:100%;box-sizing:border-box}.summary{grid-template-columns:1fr 1fr}.meta-grid{grid-template-columns:1fr}.desktop-products{display:none}.mobile-products{display:block;max-height:270px;overflow:auto}.request-card{height:610px}.action-row .zcs-button{width:100%}}@media(max-width:420px){.summary{grid-template-columns:1fr}.rfq-title{font-size:21px}.request-card{height:640px}}
</style>
<div class='rfq-page'>
  <header class='rfq-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-row-wrap'>
    <div><div class='eyebrow'>Supplier workspace</div><h1 class='rfq-title'>Requests for quote</h1><p class='rfq-copy'>Demand, response status, and delivery deadlines in one guarded workspace.</p></div>
    <div class='supplier-chip'><i class='zc-li-outline users-single-05'></i> <%if(identityReady){%><strong><%=supplierName%></strong><br><%}%><span class='zcs-font-12'><%=loginEmail%></span></div>
  </header>
  <%if(!identityReady){%>
    <section class='identity-state'><i class='zc-li-outline ui-2-alert-circle'></i><%if(supplierCount==0){%><h2>No active supplier account found</h2><p>This login is not linked to an active supplier. For privacy, quote requests are not shown. Ask your portal administrator to verify <strong><%=loginEmail%></strong>.</p><%}else{%><h2>Supplier account needs review</h2><p>More than one active supplier record uses <strong><%=loginEmail%></strong>. No request or quote data is shown until an administrator resolves the duplicate mapping.</p><%}%></section>
  <%}else{%>
    <section class='summary'>
      <div class='metric'><div class='metric-top'><span class='metric-label'>Eligible demand</span><i class='metric-icon zc-li-outline files-archive-drawer'></i></div><div class='metric-value'><%=eligibleOrders.count()%></div></div>
      <div class='metric'><div class='metric-top'><span class='metric-label'>Awaiting response</span><i class='metric-icon zc-li-outline ui-2-time'></i></div><div class='metric-value'><%=awaitingCount%></div></div>
      <div class='metric'><div class='metric-top'><span class='metric-label'>Quotes submitted</span><i class='metric-icon zc-li-outline ui-1-check-circle-08'></i></div><div class='metric-value'><%=myQuotes.count()%></div></div>
      <div class='metric <%if(dueSoonCount>0){%>alert<%}%>'><div class='metric-top'><span class='metric-label'>Due within 7 days</span><i class='metric-icon zc-li-outline ui-1-calendar-60'></i></div><div class='metric-value'><%=dueSoonCount%></div></div>
    </section>
    <%if(eligibleOrders.count()==0){%>
      <div class='zcs-card empty zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><i class='empty-icon zc-li-outline files-archive-drawer'></i><h2 class='zcs-font-18 zcs-font-medium zcs-mt-10 zcs-mb-0'>No eligible open requests</h2><p class='zcs-color-secondary'>Requests available to your supplier account will appear here when they are open for quotation.</p></div></div>
    <%}else{%>
      <div class='register-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-row-wrap'><h2 class='register-title'>Open RFQ register</h2><span class='register-copy'>Sorted by requested delivery date</span></div>
      <main class='rfq-register'>
      <%for each orderRec in eligibleOrders
      {
          productRows = Sales_Order_Product[Parent_Sales_Order == orderRec.ID];
          existingQuotes = Add_Supplier_Quote[Supplier == supplierId && Sales_Order == orderRec.ID] sort by Quote_Date descending;
          hasResponse = existingQuotes.count() > 0;
          urgencyLabel = "Open deadline";
          urgencyBadge = "zcs-badge-theme";
          if(orderRec.Requested_Delivery_Date != null)
          {
              if(orderRec.Requested_Delivery_Date < zoho.currentdate)
              {
                  urgencyLabel = "Delivery date passed";
                  urgencyBadge = "zcs-badge-red";
              }
              else if(orderRec.Requested_Delivery_Date <= zoho.currentdate.addDay(7))
              {
                  urgencyLabel = "Due within 7 days";
                  urgencyBadge = "zcs-badge-yellow";
              }
          }
      %>
        <article class='request-card zcs-card'>
          <div class='request-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-row-wrap'>
            <div><div class='request-id'><%=orderRec.Sales_Order_ID%></div><div class='zcs-color-secondary zcs-font-12'>Order date <%=ifnull(orderRec.Sales_Order_Date,"Not specified")%></div></div>
            <div class='zcs-flex zcs-gap-6 zcs-row-wrap'><span class='zcs-badge <%=urgencyBadge%> zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-2 zcs-rounded-sm'><i class='zc-li-outline ui-2-time'></i><%=urgencyLabel%></span><%if(hasResponse){%><span class='zcs-badge zcs-badge-green zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-2 zcs-rounded-sm'><i class='zc-li-outline ui-1-check-circle-08'></i>Responded</span><%}else{%><span class='zcs-badge zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-px-10 zcs-py-2 zcs-rounded-sm'><i class='zc-li-outline arrows-1-refresh-69'></i>Awaiting response</span><%}%></div>
          </div>
          <div class='request-body'>
            <div class='meta-grid'>
              <div class='meta'><span class='meta-label'><i class='zc-li-outline files-single-content'></i>Requirement</span><%=ifnull(orderRec.Customer_Requirements,"Not provided")%></div>
              <div class='meta'><span class='meta-label'><i class='zc-li-outline ui-1-calendar-60'></i>Requested delivery</span><%=ifnull(orderRec.Requested_Delivery_Date,"Not specified")%></div>
              <div class='meta'><span class='meta-label'><i class='zc-li-outline location-pin'></i>Source</span><%=ifnull(orderRec.Requirement_Source,"Not specified")%></div>
              <div class='meta'><span class='meta-label'><i class='zc-li-outline files-notebook'></i>Additional remarks</span><%=ifnull(orderRec.Additional_Remarks,"None")%></div>
            </div>
            <%if(productRows.count()==0){%><div class='zcs-color-secondary'><i class='zc-li-outline ui-1-circle-remove'></i> No product requirement lines are available.</div><%}else{%>
              <div class='zcs-table-wrapper zcs-rounded-sm products desktop-products'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Product</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Configuration</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Technical requirement</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Quantity</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Availability / lead time</th></tr></thead><tbody><%for each productRec in productRows{%><tr><td class='zcs-px-16 zcs-py-8'><strong><%=ifnull(productRec.Product_Name,"Product")%></strong><br><span class='zcs-color-secondary'><%=ifnull(productRec.Brand_Make,"")%> <%=ifnull(productRec.Model,"")%></span></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(productRec.Configuration,"Not specified")%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(productRec.Technical_Requirements,"Not specified")%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right'><%=productRec.Quantity%> <%=ifnull(productRec.Unit_of_Measure,"")%></td><td class='zcs-px-16 zcs-py-8'><%=ifnull(productRec.Required_Availability,"Not specified")%><br><%=ifnull(productRec.Required_Lead_Time,"Not specified")%></td></tr><%}%></tbody></table></div>
              <div class='mobile-products'><%for each productRec in productRows{%><div class='mobile-product'><strong><%=ifnull(productRec.Product_Name,"Product")%></strong><div class='mobile-kv'><span>Configuration</span><span><%=ifnull(productRec.Configuration,"Not specified")%></span><span>Technical</span><span><%=ifnull(productRec.Technical_Requirements,"Not specified")%></span><span>Quantity</span><span><%=productRec.Quantity%> <%=ifnull(productRec.Unit_of_Measure,"")%></span><span>Availability</span><span><%=ifnull(productRec.Required_Availability,"Not specified")%></span><span>Lead time</span><span><%=ifnull(productRec.Required_Lead_Time,"Not specified")%></span></div></div><%}%></div>
            <%}%>
            <div class='action-row zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12 zcs-row-wrap'><span class='zcs-color-secondary'><%if(hasResponse){%>Your latest quote is on file.<%}else{%>A supplier response is required.<%}%></span><%if(hasResponse){for each quoteRec in existingQuotes{%><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:All_Supplier_Quotes?ID=<%=quoteRec.ID%>'><i class='zcs-button-icon zc-li-outline files-single'></i><span>View quote</span></a><%break;}}else{%><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Form:Add_Supplier_Quote?Supplier=<%=supplierId%>&amp;Sales_Order=<%=orderRec.ID%>&amp;zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline ui-1-simple-add'></i><span>Submit quote</span></a><%}%></div>
          </div>
        </article>
      <%}%>
      </main>
    <%}%>
  <%}%>
</div>