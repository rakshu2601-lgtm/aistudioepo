<%
histories = Add_History[Sales_Order_Lookup == input.Sales_Order_ID] sort by Updated_Date_Time desc;
orderRec = Create_Sales_Order[ID == input.Sales_Order_ID];
orderFound = orderRec.count() > 0;
orderNumber = input.Sales_Order_ID;
orderCustomer = "Customer not recorded";
orderDate = "Date not recorded";
orderStatus = "Status not recorded";
if(orderFound)
{
    orderNumber = ifnull(orderRec.Sales_Order_ID,input.Sales_Order_ID);
    if(orderRec.Customer != null)
    {
        orderCustomer = ifnull(orderRec.Customer.Customer_Name,"Customer not recorded");
    }
    orderDate = ifnull(orderRec.Sales_Order_Date,"Date not recorded");
    orderStatus = ifnull(orderRec.Status,"Status not recorded");
}
%>
<style>
/* zcs-global: utility subset used by this single page snippet */
:root{--zcs-theme-brand-color:var(--zcs_brand_color,#6147E5);--zcs-light-bg-color:var(--zcs_brand_light_color,#F1EDFF);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color,#1C1C40);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#65657A);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color,#878895);--zcs-border-color:var(--zcs_tertiary_border_color,#E7E7EE);--zcs-white-color:#FFF}*{box-sizing:border-box}#splash-screen{display:none!important}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-row-wrap{flex-wrap:wrap}.zcs-gap-4{gap:4px}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-p-0{padding:0}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-m-0{margin:0}.zcs-wh-full{width:100%;height:100%}.zcs-relative{position:relative}.zcs-rounded-sm{border-radius:4px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-text-center{text-align:center}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}
/* timeline-timeline-advanced */
.zcs-timeline-wrapper{min-width:0}.zcs-tl-li{display:grid;grid-template-columns:132px 32px minmax(0,1fr);align-items:start}.zcs-tl-time{text-align:right;padding-top:3px;line-height:1.4}.zcs-tl-indicator{display:flex;justify-content:center;min-height:100%}.zcs-tl-dot{width:12px;height:12px;margin-top:4px;border-radius:50%;background:var(--event-color);border:3px solid #fff;box-shadow:0 0 0 3px var(--event-soft);position:relative;z-index:1}.timeline-list{list-style:none;background:linear-gradient(var(--zcs-border-color),var(--zcs-border-color)) 147px 0/1px 100% no-repeat}
/* badge-badge-with-icon */
.zcs-badge{width:auto;white-space:nowrap;border:1px solid}.zcs-badge-theme{background:var(--zcs_component_hover_color,#F1EDFF);border-color:var(--zcs_brand_color,#6147E5);color:var(--zcs_brand_color,#6147E5)}.zcs-badge-green{background:#E4FCF3;border-color:#179E6C;color:#147A55}.zcs-badge-red{background:#FDE3E6;border-color:#FE455D;color:#C6243A}.zcs-badge-blue{background:#E8EFFF;border-color:#2A6FFC;color:#245CC4}.zcs-badge-orange{background:#F8F0EB;border-color:#F4660C;color:#B94C08}
.history-page{height:100%;min-height:620px;overflow:hidden;background:var(--zcs-page-bg-color);padding:14px;font:14px/1.5 Arial,sans-serif;color:var(--zcs-primary-text-color)}.history-header{padding:14px 18px;background:#fff;border:1px solid var(--zcs-border-color);border-radius:12px}.heading-icon{width:36px;height:36px;border-radius:9px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);font-size:18px;flex:0 0 auto}.title-line h1{font-size:20px;margin:0}.title-line p{margin:1px 0 0;color:var(--zcs-secondary-text-color);font-size:12px}.event-count{padding:6px 10px;border-radius:7px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);font-weight:600;white-space:nowrap}.order-context{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:12px}.context-item{padding:7px 10px;border-radius:7px;background:#F9FAFE;min-width:0}.context-item label,.detail-label,.status-block label{display:block;color:var(--zcs-teritiary-text-color);font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.04em}.context-item strong{display:block;margin-top:1px;overflow-wrap:anywhere;font-size:13px}.history-shell{height:470px;margin-top:12px;overflow:hidden}.section-head{height:52px;padding:10px 16px;border-bottom:1px solid var(--zcs-border-color)}.section-head h2{font-size:16px;margin:0}.section-head p{font-size:11px;margin:0;color:var(--zcs-secondary-text-color)}.history-scroll{height:calc(100% - 52px);overflow:auto;padding:16px 18px 20px;scrollbar-gutter:stable}.event-card{padding:13px 14px;background:#fff;border:1px solid var(--zcs-border-color);border-radius:9px;box-shadow:0 2px 8px rgba(35,38,70,.04);min-width:0}.event-title{overflow-wrap:anywhere}.actor{margin-top:5px;color:var(--zcs-secondary-text-color);font-size:12px}.actor i{color:var(--event-color)}.status-flow{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:9px;padding:8px 10px;border-radius:7px;background:#F9FAFE}.status-block strong{font-size:12px}.status-arrow{color:var(--zcs-teritiary-text-color)}.detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:9px}.detail-block{padding:9px 10px;background:#FAFAFE;border:1px solid var(--zcs-border-color);border-radius:7px;white-space:pre-wrap;overflow-wrap:anywhere;font-size:13px}.related-links{margin-top:9px;padding-top:9px;border-top:1px solid var(--zcs-border-color)}.related-label{width:100%;color:var(--zcs-teritiary-text-color);font-size:10px;font-weight:600;text-transform:uppercase}.related-link{display:inline-flex;align-items:center;gap:5px;padding:4px 8px;border:1px solid var(--zcs-border-color);border-radius:6px;color:var(--zcs-theme-brand-color);font-size:11px;font-weight:600;text-decoration:none;background:#fff}.related-link:hover{background:var(--zcs-light-bg-color)}.zcs-nodata-wrapper{height:calc(100% - 52px);min-height:280px}.empty-icon{width:46px;height:46px;margin:auto;border-radius:12px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color)}.zcs-nodata-header{margin:10px 0 0}.zcs-nodata-desc{max-width:400px;margin:5px auto 0;color:var(--zcs-secondary-text-color)}
@media(max-width:768px){.history-page{min-height:690px;padding:10px}.history-header{padding:12px}.title-line{align-items:flex-start;flex-direction:column}.title-copy{align-items:flex-start}.order-context{grid-template-columns:repeat(2,minmax(0,1fr))}.history-shell{height:500px}.history-scroll{padding:14px 10px}.timeline-list{background-position:5px 0}.zcs-tl-li{grid-template-columns:22px minmax(0,1fr);grid-template-areas:'dot time' 'dot card';row-gap:5px}.zcs-tl-time{grid-area:time;text-align:left;padding:0}.zcs-tl-indicator{grid-area:dot;justify-content:flex-start}.event-card{grid-area:card;padding:11px}.event-top{align-items:flex-start;flex-direction:column}.detail-grid{grid-template-columns:1fr}.section-head p{display:none}}
@media(max-width:420px){.order-context{grid-template-columns:1fr}.history-shell{height:515px}.heading-icon{display:none}}
</style>
<div class='history-page'>
  <header class='history-header'>
    <div class='title-line zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
      <div class='title-copy zcs-flex zcs-align-items-center zcs-gap-12'><span class='heading-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline arrows-2-time'></i></span><div><h1>Sales order activity</h1><p>Newest activity first</p></div></div>
      <div class='event-count zcs-inline-flex zcs-align-items-center zcs-gap-6'><i class='zc-li-outline ui-2-time'></i><span><%=histories.count()%> events</span></div>
    </div>
    <div class='order-context zcs-labelvalue-wrapper zcs-labelvalue-with-bg'>
      <div class='context-item'><label>Sales order</label><strong><%=orderNumber%></strong></div>
      <div class='context-item'><label>Customer</label><strong><%=orderCustomer%></strong></div>
      <div class='context-item'><label>Order date</label><strong><%=orderDate%></strong></div>
      <div class='context-item'><label>Current status</label><strong><%=orderStatus%></strong></div>
    </div>
  </header>
  <section class='history-shell zcs-card'>
    <div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div><h2>Activity timeline</h2><p>Timestamp, actor, notes, transitions, and related records</p></div><i class='zc-li-outline arrows-2-time zcs-font-20 zcs-color-tertiary'></i></div>
    <%if(histories.count() == 0){%>
      <div class='zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><div class='empty-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline arrows-2-time zcs-font-20'></i></div><h5 class='zcs-nodata-header zcs-font-18 zcs-font-medium zcs-color-primary'>No activity recorded</h5><p class='zcs-nodata-desc zcs-font-14'>Events will appear here when this sales order is created, updated, or progresses through its workflow.</p></div></div>
    <%}else{%>
      <div class='zcs-timeline-wrapper history-scroll'><ul class='timeline-list zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0'>
      <%for each hist in histories{
        actionType = ifnull(hist.Action_Type,"Activity recorded");
        eventStatus = ifnull(hist.Status,"Activity");
        eventTime = ifnull(hist.Updated_Date_Time,"Time not recorded");
        badgeClass = "zcs-badge-theme"; eventColor = "#6147E5"; eventSoft = "#F1EDFF"; eventIcon = "business-notes";
        if(actionType == "Record Created" || actionType == "Products Received" || actionType == "Delivery Confirmed" || actionType == "Customer Approval Recorded" || actionType == "Purchase Order Approved"){badgeClass = "zcs-badge-green";eventColor = "#179E6C";eventSoft = "#E4FCF3";eventIcon = "ui-1-check-circle-08";}
        else if(actionType == "Lead Marked Lost"){badgeClass = "zcs-badge-red";eventColor = "#FE455D";eventSoft = "#FDE3E6";eventIcon = "ui-1-circle-remove";}
        else if(actionType == "Subform Updated" || actionType == "Status Changed"){badgeClass = "zcs-badge-blue";eventColor = "#2A6FFC";eventSoft = "#E8EFFF";eventIcon = "arrows-2-time";}
        else if(actionType.contains("Created")){badgeClass = "zcs-badge-orange";eventColor = "#F4660C";eventSoft = "#F8F0EB";eventIcon = "files-single";}
        actorName = ifnull(hist.Updated_By_Email,"System workflow");
        if(hist.Updated_By != null){actorName = ifnull(hist.Updated_By.Employee_Name,actorName);}
        if(actorName == ""){actorName = "System workflow";}
        hasRelated = hist.Lead_Lookup != null || hist.Sales_Order_Lookup != null || hist.Supplier_Quote_Lookup != null || hist.Purchase_Order_Lookup != null || hist.Supplier_Invoice_Lookup != null || hist.Logistics_Booking_Lookup != null || hist.Return_Request_Lookup != null;
      %>
        <li class='zcs-tl-li zcs-relative' style='--event-color:<%=eventColor%>;--event-soft:<%=eventSoft%>'>
          <time class='zcs-tl-time zcs-font-12 zcs-color-tertiary'><%=eventTime%></time>
          <div class='zcs-tl-indicator'><span class='zcs-tl-dot'></span></div>
          <article class='event-card'>
            <div class='event-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><h3 class='event-title zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-m-0'><%=actionType%></h3><span class='zcs-badge zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-4 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12 <%=badgeClass%>'><i class='zc-li-outline <%=eventIcon%>'></i><span><%=eventStatus%></span></span></div>
            <div class='actor zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-4'><i class='zc-li-outline users-single-29'></i><span><%=actorName%></span><%if(hist.Updated_By_Email != null && hist.Updated_By_Email != "" && actorName != hist.Updated_By_Email){%><span>| <%=hist.Updated_By_Email%></span><%}%></div>
            <%if(hist.Previous_Status != null || hist.New_Status != null){%><div class='status-flow'><div class='status-block'><label>Previous</label><strong><%=ifnull(hist.Previous_Status,"Not recorded")%></strong></div><i class='status-arrow zc-li-outline arrows-1-tail-right'></i><div class='status-block'><label>New</label><strong><%=ifnull(hist.New_Status,eventStatus)%></strong></div></div><%}%>
            <%if((hist.Comments != null && hist.Comments != "") || (hist.Subform_Details_Change_Summary != null && hist.Subform_Details_Change_Summary != "")){%><div class='detail-grid'><%if(hist.Comments != null && hist.Comments != ""){%><div class='detail-block'><span class='detail-label'>Note</span><%=hist.Comments%></div><%}%><%if(hist.Subform_Details_Change_Summary != null && hist.Subform_Details_Change_Summary != ""){%><div class='detail-block'><span class='detail-label'>Change summary</span><%=hist.Subform_Details_Change_Summary%></div><%}%></div><%}%>
            <%if(hasRelated){%><div class='related-links zcs-flex zcs-row-wrap zcs-gap-8'><span class='related-label'>Related records</span>
              <%if(hist.Lead_Lookup != null){%><a class='related-link' href='#Report:All_Leads?ID=<%=hist.Lead_Lookup.ID%>'><i class='zc-li-outline files-single'></i>Lead <%=hist.Lead_Lookup.Lead_ID%></a><%}%>
              <%if(hist.Sales_Order_Lookup != null){%><a class='related-link' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=hist.Sales_Order_Lookup.ID%>'><i class='zc-li-outline files-single'></i>Order <%=hist.Sales_Order_Lookup.Sales_Order_ID%></a><%}%>
              <%if(hist.Supplier_Quote_Lookup != null){%><a class='related-link' href='#Report:All_Supplier_Quotes?ID=<%=hist.Supplier_Quote_Lookup.ID%>'><i class='zc-li-outline files-single'></i>Quote <%=hist.Supplier_Quote_Lookup.Supplier_Quote_ID%></a><%}%>
              <%if(hist.Purchase_Order_Lookup != null){%><a class='related-link' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=hist.Purchase_Order_Lookup.ID%>'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i>PO <%=hist.Purchase_Order_Lookup.Purchase_Order_ID%></a><%}%>
              <%if(hist.Supplier_Invoice_Lookup != null){%><a class='related-link' href='#Page:Supplier_Invoice_Detail?Supplier_Invoice_ID=<%=hist.Supplier_Invoice_Lookup.ID%>'><i class='zc-li-outline files-3-pdf'></i>Invoice <%=hist.Supplier_Invoice_Lookup.Supplier_Invoice_ID%></a><%}%>
              <%if(hist.Logistics_Booking_Lookup != null){%><a class='related-link' href='#Page:Logistics_Booking_Detail?Logistics_Booking_ID=<%=hist.Logistics_Booking_Lookup.ID%>'><i class='zc-li-outline transportation-truck-front'></i>Booking <%=hist.Logistics_Booking_Lookup.Logistics_Booking_ID%></a><%}%>
              <%if(hist.Return_Request_Lookup != null){%><a class='related-link' href='#Page:Return_Request_Detail?Return_Request_ID=<%=hist.Return_Request_Lookup.ID%>'><i class='zc-li-outline e-commerce-box'></i>Return <%=hist.Return_Request_Lookup.Return_Request_ID%></a><%}%>
            </div><%}%>
          </article>
        </li>
      <%}%>
      </ul></div>
    <%}%>
  </section>
</div>