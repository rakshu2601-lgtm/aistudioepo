<%
invoiceList = Add_Supplier_Invoice[ID == input.Supplier_Invoice_ID];
%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#f3f3f4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--column-gap:0px}*{box-sizing:border-box}#splash-screen{display:none!important}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%;width:100%}.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0!important}.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-p-0{padding:0}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-10{padding-top:10px;padding-bottom:10px}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:4px}.zcs-mt-8{margin-top:8px}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-xl{border-radius:12px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-22{font-size:22px}.zcs-font-24{font-size:24px}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-col-2{flex:0 0 16.666%;max-width:16.666%}.zcs-col-10{flex:0 0 83.333%;max-width:83.333%}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}a{text-decoration:none}
.invoice-page{min-height:100vh;background:var(--zcs-page-bg-color);color:var(--zcs-primary-text-color);font:14px/1.45 Arial,sans-serif}.invoice-shell{max-width:1540px;margin:auto;padding:16px}.zcs-page-header{background:#fff;border:1px solid var(--zcs-border-color);border-radius:12px;padding:16px 20px}.zcs-back{width:34px;height:34px;border:1px solid var(--zcs-border-color);border-radius:7px;color:var(--zcs-teritiary-text-color);flex:none}.identity{min-width:0}.identity h1{font-size:20px;margin:0;overflow-wrap:anywhere}.identity p{margin:2px 0 0;color:var(--zcs-secondary-text-color);overflow-wrap:anywhere}.header-actions{flex-wrap:wrap}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-button-icon{width:16px}.zcs-badge{width:auto;white-space:nowrap;border:1px solid}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#137d59}.zcs-badge-yellow{background:#fcf4e6;border-color:#d28a10;color:#9a6208}.zcs-badge-grey{background:#f1f2f4;border-color:#77798b;color:#55576b}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#245fcf}.content{margin-top:14px}.finance-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.finance-card{padding:14px 16px;border:1px solid var(--zcs-border-color);border-radius:10px;background:#fff;min-width:0}.finance-card .metric-label,.kv label{display:block;font-size:12px;color:var(--zcs-teritiary-text-color);margin-bottom:4px}.finance-card strong{display:block;font-size:18px;line-height:1.25;overflow-wrap:anywhere}.finance-card .metric-detail{display:block;margin-top:4px;font-size:12px;color:var(--zcs-secondary-text-color);overflow-wrap:anywhere}.detail-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(360px,.85fr);gap:14px}.section-head{min-height:36px;margin-bottom:12px}.section-head h2{font-size:16px;margin:0}.section-note{font-size:12px;color:var(--zcs-teritiary-text-color)}.section-icon{width:32px;height:32px;border-radius:8px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);font-size:16px;flex:none}.zcs-labelvalue-wrapper ul{list-style:none}.kv{padding:8px 14px 8px 0;min-width:0;width:50%}.kv span{display:block;font-weight:500;overflow-wrap:anywhere}.scroll-section{height:300px;overflow:auto;padding-right:4px}.source-card{padding:12px;border:1px solid var(--zcs-border-color);border-radius:9px;background:#fff;color:var(--zcs-primary-text-color)}.source-card+.source-card{margin-top:8px}.source-card:hover{background:#f9fafe}.source-main{min-width:0}.source-main strong{display:block;overflow-wrap:anywhere}.source-state{margin-top:3px;font-size:12px}.source-state.ok{color:#137d59}.source-state.missing{color:#9a6208}.source-card i{color:var(--zcs_brand_color);font-size:18px}.evidence-row{padding:11px 12px;border:1px solid var(--zcs-border-color);border-radius:9px;color:var(--zcs-primary-text-color);background:#fff}.evidence-row i{font-size:19px;color:var(--zcs_brand_color)}.evidence-copy{min-width:0}.evidence-copy strong,.evidence-copy small{display:block;overflow-wrap:anywhere}.note{white-space:pre-wrap;overflow-wrap:anywhere}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:#fff;overflow:auto;max-height:360px}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:940px}.zcs-table-wrapper thead{top:0;z-index:1}.zcs-table-wrapper th{background:#f9fafe;box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color);vertical-align:top}.zcs-table-wrapper tbody tr:hover td{background:#f9fafe}.empty{min-height:120px;padding:22px;text-align:center;color:var(--zcs-secondary-text-color);background:#f9fafe;border:1px dashed var(--zcs-border-color);border-radius:9px}.empty i{display:block;margin-bottom:8px;color:var(--zcs_brand_color)}.audit-scroll{height:360px;overflow:auto;padding:4px 4px 4px 0}.zcs-tl-indicator{width:44px;left:16.666%}.zcs-tl-dot{width:11px;height:11px;background:var(--zcs_brand_color);border:1px solid #fff;box-shadow:0 2px 6px #c4dee4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:'';position:absolute;width:1px;height:calc(100% + 20px);background:#e1e1e1;top:5px}.timeline-body{padding-left:50px}.link{color:var(--zcs_brand_color);font-weight:600}.not-found{min-height:70vh}.source-summary{padding:10px 12px;margin-bottom:10px;background:#f9fafe;border-radius:8px;color:var(--zcs-secondary-text-color);font-size:12px}
@media(max-width:1000px){.finance-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.detail-grid{grid-template-columns:1fr}}
@media(max-width:700px){.invoice-shell{padding:10px}.zcs-page-header{align-items:flex-start;flex-direction:column}.finance-grid{grid-template-columns:1fr}.kv{width:100%}.header-actions,.header-actions .zcs-button{width:100%}.scroll-section{height:280px}.zcs-tl-li{flex-direction:column}.zcs-tl-indicator{left:0}.zcs-tl-time{text-align:left;padding-left:46px;margin-bottom:6px}.timeline-body{padding-left:46px}.zcs-col-2,.zcs-col-10{max-width:100%;flex-basis:100%}}
</style>
<div class='invoice-page'><div class='invoice-shell'>
<%if(invoiceList.count() == 0){%>
<div class='not-found zcs-flex zcs-align-items-center zcs-justify-center'><section class='zcs-card zcs-p-20 zcs-w-full'><div class='empty'><i class='zc-li-outline ui-1-circle-remove-10 zcs-font-24'></i><h2>Supplier invoice not found</h2><p>The requested invoice is unavailable or outside your access.</p><a class='link' href='#Page:Supplier_Invoices'>Back to supplier invoices</a></div></section></div>
<%}else{
invoice = invoiceList;
products = Supplier_Invoice_Product[Parent_Supplier_Invoice == invoice.ID];
history = Add_History[Supplier_Invoice_Lookup == invoice.ID] sort by Updated_Date_Time desc;
statusValue = ifnull(invoice.Status,"Unknown"); statusBadge = "zcs-badge-grey"; statusIcon = "ui-2-help"; if(statusValue == "Paid"){statusBadge="zcs-badge-green";statusIcon="ui-1-check-circle-08";}else if(statusValue == "New"){statusBadge="zcs-badge-yellow";statusIcon="ui-2-time";}
poExists = false; soExists = false; poID = 0; soID = 0; poLabel = "Not linked"; soLabel = "Not linked";
if(invoice.Purchase_Order != null){poID=invoice.Purchase_Order.ID; relatedPO=Create_Purchase_Order[ID == poID]; if(relatedPO.count()>0){poExists=true;poLabel=ifnull(relatedPO.Purchase_Order_ID,"Purchase order");}}
if(invoice.Sales_Order != null){soID=invoice.Sales_Order.ID; relatedSO=Create_Sales_Order[ID == soID]; if(relatedSO.count()>0){soExists=true;soLabel=ifnull(relatedSO.Sales_Order_ID,"Sales order");}}
supplierName = "Not set"; supplierID = "Not set"; supplierContact = "Not set"; supplierEmail = "Not set";
if(invoice.Supplier != null){supplierName=ifnull(invoice.Supplier.Supplier_Name,"Not set");supplierID=ifnull(invoice.Supplier.Supplier_ID,"Not set");supplierContact=ifnull(invoice.Supplier.Contact_Person,"Not set");supplierEmail=ifnull(invoice.Supplier.Email,"Not set");}
sourceCount = 0; if(poExists){sourceCount=sourceCount+1;} if(soExists){sourceCount=sourceCount+1;}
%>
<header class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-box-border'>
<div class='zcs-flex zcs-align-items-center zcs-gap-12 identity'><a href='#Page:Supplier_Invoices' class='zcs-back zcs-flex zcs-align-items-center zcs-justify-center'><i class='zcs-back-icon zcs-font-22 zc-li-outline arrows-1-tail-left'></i></a><div class='identity'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><h1>Invoice <%=invoice.Supplier_Invoice_ID%></h1><span class='zcs-badge zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 <%=statusBadge%>'><i class='zc-li-outline <%=statusIcon%>'></i><span><%=statusValue%></span></span></div><p><%=ifnull(invoice.Supplier_Invoice_Number,"Supplier invoice")%> | <%=supplierName%></p></div></div>
<div class='header-actions zcs-flex zcs-gap-8'><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Report:All_Histories?Supplier_Invoice_Lookup=<%=invoice.ID%>'><i class='zcs-button-icon zc-li-outline ui-2-time'></i><span>Full history</span></a><%if(statusValue == "New"){%><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Form:Add_Supplier_Invoice?recLinkID=<%=invoice.ID%>&amp;viewLinkName=All_Supplier_Invoices&amp;Action_Mode=Mark Paid&amp;zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline ui-1-check-circle-08'></i><span>Mark paid</span></a><%}%></div>
</header>
<main class='content zcs-flex zcs-direction-column zcs-gap-16'>
<section class='finance-grid'><div class='finance-card'><span class='metric-label'>Invoice total</span><strong><%=ifnull(invoice.Currency,"")%> <%=ifnull(invoice.Invoice_Amount,0)%></strong><span class='metric-detail'>Recorded invoice value</span></div><div class='finance-card'><span class='metric-label'>Payment status</span><strong><%=statusValue%></strong><span class='metric-detail'>Current finance state</span></div><div class='finance-card'><span class='metric-label'>Paid date</span><strong><%=ifnull(invoice.Paid_Date,"Not recorded")%></strong><span class='metric-detail'>Settlement date</span></div><div class='finance-card'><span class='metric-label'>Payment reference</span><strong><%=ifnull(invoice.Payment_Reference,"Not recorded")%></strong><span class='metric-detail'>Bank or remittance reference</span></div></section>
<div class='detail-grid'>
<section class='zcs-card zcs-p-20'><div class='section-head zcs-flex zcs-align-items-center zcs-gap-8'><span class='section-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline files-single'></i></span><div><h2>Invoice identity</h2><div class='section-note'>Commercial and supplier metadata</div></div></div><div class='zcs-labelvalue-wrapper'><ul class='zcs-row zcs-p-0 zcs-m-0'><li class='kv'><label>Invoice ID</label><span><%=invoice.Supplier_Invoice_ID%></span></li><li class='kv'><label>Supplier invoice number</label><span><%=ifnull(invoice.Supplier_Invoice_Number,"Not set")%></span></li><li class='kv'><label>Invoice date</label><span><%=ifnull(invoice.Invoice_Date,"Not set")%></span></li><li class='kv'><label>Currency</label><span><%=ifnull(invoice.Currency,"Not set")%></span></li><li class='kv'><label>Supplier</label><span><%=supplierName%></span></li><li class='kv'><label>Supplier ID</label><span><%=supplierID%></span></li><li class='kv'><label>Contact</label><span><%=supplierContact%></span></li><li class='kv'><label>Email</label><span><%=supplierEmail%></span></li></ul></div></section>
<section class='zcs-card zcs-p-20'><div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><span class='section-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-1-check-circle-08'></i></span><div><h2>Source verification</h2><div class='section-note'>Resolvable purchasing and sales records</div></div></div><span class='zcs-badge zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-badge-blue'><%=sourceCount%> of 2</span></div><div class='scroll-section'><div class='source-summary'><%=sourceCount%> source documents verified. Missing references remain visible but are not routed.</div><%if(poExists){%><a class='source-card zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12' href='#Page:Purchase_Order_Detail?Purchase_Order_ID=<%=poID%>'><span class='source-main'><strong><%=poLabel%></strong><span class='source-state ok zcs-flex zcs-align-items-center zcs-gap-6'><i class='zc-li-outline ui-1-check-circle-08'></i>Purchase order verified</span></span><i class='zc-li-outline arrows-1-tail-right'></i></a><%}else{%><div class='source-card zcs-flex zcs-align-items-center zcs-justify-space-between'><span class='source-main'><strong>Purchase order</strong><span class='source-state missing zcs-flex zcs-align-items-center zcs-gap-6'><i class='zc-li-outline ui-2-time'></i>Missing or unavailable</span></span></div><%}%><%if(soExists){%><a class='source-card zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12' href='#Page:Sales_Order_Detail?Sales_Order_ID=<%=soID%>'><span class='source-main'><strong><%=soLabel%></strong><span class='source-state ok zcs-flex zcs-align-items-center zcs-gap-6'><i class='zc-li-outline ui-1-check-circle-08'></i>Sales order verified</span></span><i class='zc-li-outline arrows-1-tail-right'></i></a><%}else{%><div class='source-card zcs-flex zcs-align-items-center zcs-justify-space-between'><span class='source-main'><strong>Sales order</strong><span class='source-state missing zcs-flex zcs-align-items-center zcs-gap-6'><i class='zc-li-outline ui-2-time'></i>Missing or unavailable</span></span></div><%}%></div></section>
</div>
<section class='zcs-card zcs-p-20'><div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><span class='section-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i></span><div><h2>Product lines</h2><div class='section-note'>Quantities and commercial values</div></div></div><span class='zcs-badge zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-badge-grey'><%=products.count()%> lines</span></div><%if(products.count()==0){%><div class='empty'><i class='zc-li-outline e-commerce-shopping-cart-simple zcs-font-24'></i><strong>No invoice products</strong><div>No product lines are recorded for this invoice.</div></div><%}else{%><div class='zcs-table-wrapper zcs-rounded-md'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Product</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Part / model</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Configuration</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Quantity</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Unit price</th><th class='zcs-px-16 zcs-py-8 zcs-text-right'>Line total</th><th class='zcs-px-16 zcs-py-8 zcs-text-left'>Remarks</th></tr></thead><tbody><%for each item in products{%><tr><td class='zcs-px-16 zcs-py-10'><strong><%=item.Product_Name%></strong><small class='zcs-flex zcs-color-tertiary'><%=item.Product_ID%> | <%=ifnull(item.Brand_Make,"Not set")%></small></td><td class='zcs-px-16 zcs-py-10'><%=ifnull(item.Manufacturer_Part_Number,"Not set")%><small class='zcs-flex zcs-color-tertiary'><%=ifnull(item.Model,"Not set")%></small></td><td class='zcs-px-16 zcs-py-10'><%=ifnull(item.Configuration,"Not set")%><small class='zcs-flex zcs-color-tertiary'><%=ifnull(item.Unit_of_Measure,"Not set")%></small></td><td class='zcs-px-16 zcs-py-10 zcs-text-right'><%=ifnull(item.Quantity,0)%></td><td class='zcs-px-16 zcs-py-10 zcs-text-right'><%=ifnull(item.Currency,invoice.Currency)%> <%=ifnull(item.Unit_Price,0)%></td><td class='zcs-px-16 zcs-py-10 zcs-text-right zcs-font-semibold'><%=ifnull(item.Currency,invoice.Currency)%> <%=ifnull(item.Total_Price,0)%></td><td class='zcs-px-16 zcs-py-10'><%=ifnull(item.Remarks,"Not set")%></td></tr><%}%></tbody></table></div><%}%></section>
<div class='detail-grid'><section class='zcs-card zcs-p-20'><div class='section-head zcs-flex zcs-align-items-center zcs-gap-8'><span class='section-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline business-currency-dollar'></i></span><div><h2>Payment evidence</h2><div class='section-note'>Settlement data captured on the invoice</div></div></div><div class='zcs-labelvalue-wrapper'><ul class='zcs-row zcs-p-0 zcs-m-0'><li class='kv'><label>Status</label><span><%=statusValue%></span></li><li class='kv'><label>Amount</label><span><%=ifnull(invoice.Currency,"")%> <%=ifnull(invoice.Invoice_Amount,0)%></span></li><li class='kv'><label>Paid date</label><span><%=ifnull(invoice.Paid_Date,"Not recorded")%></span></li><li class='kv'><label>Reference</label><span><%=ifnull(invoice.Payment_Reference,"Not recorded")%></span></li><li class='kv zcs-w-full' style='width:100%'><label>Remarks</label><span class='note'><%=ifnull(invoice.Payment_Remarks,"Not recorded")%></span></li></ul></div></section><section class='zcs-card zcs-p-20'><div class='section-head zcs-flex zcs-align-items-center zcs-gap-8'><span class='section-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline files-single'></i></span><div><h2>Document evidence</h2><div class='section-note'>Supplier invoice attachment</div></div></div><%if(invoice.Invoice_Attachment == null || invoice.Invoice_Attachment == ""){%><div class='empty'><i class='zc-li-outline files-single zcs-font-24'></i><strong>No attachment</strong><div>No supplier document is recorded.</div></div><%}else{%><a class='evidence-row zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12' href='<%=invoice.Invoice_Attachment%>' target='_blank'><span class='evidence-copy zcs-flex zcs-align-items-center zcs-gap-12'><i class='zc-li-outline files-single'></i><span><strong>Supplier invoice document</strong><small class='zcs-color-tertiary'>Open recorded evidence</small></span></span><i class='zc-li-outline arrows-2-square-download'></i></a><%}%></section></div>
<section class='zcs-card zcs-p-20'><div class='section-head zcs-flex zcs-align-items-center zcs-justify-space-between'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><span class='section-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-2-time'></i></span><div><h2>Audit activity</h2><div class='section-note'>Newest event first</div></div></div><a class='link' href='#Report:All_Histories?Supplier_Invoice_Lookup=<%=invoice.ID%>'>View full history</a></div><%if(history.count()==0){%><div class='empty'><i class='zc-li-outline ui-2-time zcs-font-24'></i><strong>No audit activity</strong><div>No history events are recorded for this invoice.</div></div><%}else{%><div class='zcs-timeline-wrapper audit-scroll'><ul class='zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0'><%for each event in history{%><li class='zcs-tl-li zcs-row zcs-relative'><div class='zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute'><span class='zcs-tl-dot zcs-rounded-xl zcs-mt-8 zcs-relative'></span></div><span class='zcs-col-2 zcs-tl-time zcs-font-13 zcs-color-tertiary zcs-text-right'><%=event.Updated_Date_Time%></span><div class='timeline-body zcs-flex zcs-direction-column zcs-col-10'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><strong class='zcs-font-15'><%=event.Action_Type%></strong><span class='zcs-font-12 zcs-color-tertiary'><%=ifnull(event.Updated_By.Employee_Name,ifnull(event.Updated_By_Email,"System"))%></span></div><%if(event.Previous_Status != null || event.New_Status != null){%><div class='zcs-font-13 zcs-color-secondary'><%=ifnull(event.Previous_Status,"Not set")%> to <%=ifnull(event.New_Status,ifnull(event.Status,"Not set"))%></div><%}%><p class='note zcs-m-0 zcs-mt-4'><%=ifnull(event.Comments,ifnull(event.Subform_Details_Change_Summary,"No additional details"))%></p></div></li><%}%></ul></div><%}%></section>
</main><%}%></div></div>