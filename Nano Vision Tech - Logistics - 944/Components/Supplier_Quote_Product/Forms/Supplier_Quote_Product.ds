form Supplier_Quote_Product
{
    displayname = "Supplier Quote Product"
    Requested_Product
    (
        type = section
        displayname = "Requested Product"
        row = 1
        column = 0
        width = medium
    )
    Parent_Supplier_Quote
    (
        type = picklist
        displayname = "Parent Supplier Quote"
        values = Add_Supplier_Quote.ID
        bidirectional = Supplier_Quote_Products
        displayformat = [Supplier_Quote_ID]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Sales_Order_Product
    (
        type = picklist
        displayname = "Sales Order Product"
        values = Sales_Order_Product.ID
        displayformat = [Product_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Product
    (
        type = picklist
        values = Add_Product.ID
        displayformat = [Product_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Product_ID
    (
        type = text
        displayname = "Product ID"
        row = 1
        column = 2
        width = medium
    )
    Product_Name
    (
        type = text
        displayname = "Product Name"
        row = 1
        column = 1
        width = medium
    )
    Product_Category
    (
        type = text
        displayname = "Product Category"
        row = 1
        column = 2
        width = medium
    )
    Product_Type
    (
        type = text
        displayname = "Product Type"
        row = 1
        column = 1
        width = medium
    )
    Product_Description
    (
        type = textarea
        displayname = "Product Description"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    Manufacturer_Part_Number
    (
        type = text
        displayname = "Manufacturer Part Number"
        row = 1
        column = 1
        width = medium
    )
    Internal_Part_Number
    (
        type = text
        displayname = "Internal Part Number"
        row = 1
        column = 2
        width = medium
    )
    Brand_Make
    (
        type = text
        displayname = "Brand / Make"
        row = 1
        column = 1
        width = medium
    )
    Model
    (
        type = text
        row = 1
        column = 2
        width = medium
    )
    Requested_Configuration
    (
        type = textarea
        displayname = "Requested Configuration"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    Requested_Quantity
    (
        type = decimal
        displayname = "Requested Quantity"
        decimalplace = 2
        row = 1
        column = 2
        width = medium
    )
    Unit_of_Measure
    (
        type = text
        displayname = "Unit of Measure"
        row = 1
        column = 1
        width = medium
    )
    Supplier_Offer
    (
        type = section
        displayname = "Supplier Offer"
        visibility = true
        row = 2
        column = 1
        width = medium
    )
    Offered_Configuration
    (
        type = textarea
        displayname = "Offered Configuration"
        height = 100px
        row = 2
        column = 1
        width = medium
    )
    Configuration_Match
    (
        type = picklist
        displayname = "Configuration Match"
        values = {"Exact Match","Partial Match","Alternative","Does Not Match"}
        row = 2
        column = 2
        width = medium
    )
    must have Quoted_Quantity
    (
        type = decimal
        displayname = "Quoted Quantity"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    must have Supplier_Unit_Price
    (
        type = USD
        displayname = "Supplier Unit Price"
        decimalplace = 2
        maxchar = 16
        row = 2
        column = 2
        width = medium
    )
    Supplier_Total_Price
    (
        type = USD
        displayname = "Supplier Total Price"
        decimalplace = 2
        maxchar = 16
        row = 2
        column = 1
        width = medium
    )
    Currency
    (
        type = picklist
        values = {"USD","EUR"}
        initial value = "USD"
        row = 2
        column = 2
        width = medium
    )
    Availability
    (
        type = text
        row = 2
        column = 1
        width = medium
    )
    Lead_Time
    (
        type = text
        displayname = "Lead Time"
        row = 2
        column = 2
        width = medium
    )
    Dispatch_Location
    (
        type = text
        displayname = "Dispatch Location"
        row = 2
        column = 1
        width = medium
    )
    Remarks
    (
        type = textarea
        height = 100px
        row = 2
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Add"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
