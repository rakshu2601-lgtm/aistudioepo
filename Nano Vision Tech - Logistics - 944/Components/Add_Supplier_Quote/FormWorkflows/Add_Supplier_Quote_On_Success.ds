Add_Supplier_Quote_On_Success as "Process Supplier Quote Receipt"
{
    type = form
    form = Add_Supplier_Quote
    record event = on add

    on success
    {
        actions
        {
            custom deluge script
            (
                sales_order_record = Create_Sales_Order[ID == input.Sales_Order];
                previous_status = sales_order_record.Status;
                if(sales_order_record.Status == "New")
                {
                    sales_order_record.Status = "Quotes Received";
                }
                insert into Add_History
                [
                    Action_Type = "Supplier Quote Received"
                    Status = input.Status
                    New_Status = input.Status
                    Comments = "Supplier quote received"
                    Sales_Order_Lookup = input.Sales_Order
                    Supplier_Quote_Lookup = input.ID
                    Updated_By_Email = zoho.loginuserid
                    Updated_Date_Time = zoho.currenttime
                ];
                insert into Add_History
                [
                    Action_Type = "Status Changed"
                    Status = sales_order_record.Status
                    Previous_Status = previous_status
                    New_Status = sales_order_record.Status
                    Comments = "Supplier quote received for sales order"
                    Sales_Order_Lookup = input.Sales_Order
                    Supplier_Quote_Lookup = input.ID
                    Updated_By_Email = zoho.loginuserid
                    Updated_Date_Time = zoho.currenttime
                ];
                if(sales_order_record.Lead != null)
                {
                    lead_record = Add_Lead[ID == sales_order_record.Lead];
                    if(lead_record.Sales_Agent != null)
                    {
                        employee_record = Add_Employee[ID == lead_record.Sales_Agent];
                        if(employee_record.Email != null && employee_record.Email != "")
                        {
                            sendmail
                            (
                                from : zoho.adminuserid
                                to : employee_record.Email
                                subject : "Supplier quote received"
                                message : "A supplier quote has been received for sales order " + sales_order_record.Sales_Order_ID + "."
                            )
                        }
                    }
                }
            )
        }
    }
}
