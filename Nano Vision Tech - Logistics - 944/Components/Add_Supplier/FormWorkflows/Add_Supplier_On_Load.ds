Add_Supplier_On_Load as "Add Supplier On Load"
{
    type = form
    form = Add_Supplier
    record event = on add or edit

    on load
    {
        actions
        {
            custom deluge script
            (
                hide Hidden_Section;
                disable Created_Date_Time;
                disable Last_Updated_Date_Time;
            )
        }
    }
}
