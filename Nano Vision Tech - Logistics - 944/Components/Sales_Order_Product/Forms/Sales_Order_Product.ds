form Sales_Order_Product
{
    displayname = "Sales Order Product"
    Product_Details
    (
        type = section
        displayname = "Product Details"
        row = 1
        column = 0
        width = medium
    )
    Parent_Sales_Order
    (
        type = picklist
        displayname = "Parent Sales Order"
        values = Create_Sales_Order.ID
        bidirectional = Sales_Order_Products
        displayformat = [Sales_Order_ID]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Product
    (
        type = picklist
        values = Add_Product[Active == true].ID
        displayformat = [Product_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Product_ID
    (
        type = text
        displayname = "Product ID"
        row = 1
        column = 1
        width = medium
    )
    Product_Name
    (
        type = text
        displayname = "Product Name"
        row = 1
        column = 2
        width = medium
    )
    Product_Category
    (
        type = text
        displayname = "Product Category"
        row = 1
        column = 1
        width = medium
    )
    Product_Type
    (
        type = text
        displayname = "Product Type"
        row = 1
        column = 2
        width = medium
    )
    Product_Description
    (
        type = textarea
        displayname = "Product Description"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    Manufacturer_Part_Number
    (
        type = text
        displayname = "Manufacturer Part Number"
        row = 1
        column = 2
        width = medium
    )
    Internal_Part_Number
    (
        type = text
        displayname = "Internal Part Number"
        row = 1
        column = 1
        width = medium
    )
    Brand_Make
    (
        type = text
        displayname = "Brand / Make"
        row = 1
        column = 2
        width = medium
    )
    Model
    (
        type = text
        row = 1
        column = 1
        width = medium
    )
    Unit_of_Measure
    (
        type = text
        displayname = "Unit of Measure"
        row = 1
        column = 2
        width = medium
    )
    Requirements
    (
        type = section
        displayname = "Requirements"
        visibility = true
        row = 2
        column = 1
        width = medium
    )
    Configuration
    (
        type = textarea
        height = 100px
        row = 2
        column = 1
        width = medium
    )
    Technical_Requirements
    (
        type = textarea
        displayname = "Technical Requirements"
        height = 100px
        row = 2
        column = 2
        width = medium
    )
    must have Quantity
    (
        type = decimal
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Required_Availability
    (
        type = text
        displayname = "Required Availability"
        row = 2
        column = 2
        width = medium
    )
    Required_Lead_Time
    (
        type = text
        displayname = "Required Lead Time"
        row = 2
        column = 1
        width = medium
    )
    Recommended_Supplier
    (
        type = picklist
        displayname = "Recommended Supplier"
        values = Add_Supplier.ID
        displayformat = [Supplier_Name]
        searchable = true
        row = 2
        column = 2
        width = medium
    )
    Selected_Supplier_Quote
    (
        type = picklist
        displayname = "Selected Supplier Quote"
        values = Add_Supplier_Quote.ID
        displayformat = [Supplier_Quote_ID]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    Remarks
    (
        type = textarea
        height = 100px
        row = 2
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Add"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
