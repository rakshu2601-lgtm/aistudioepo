User_Input5 as "User-Input"
{

				type =  form
				form = Create_Template

				record event = on add or edit

				on user input of Select_Template
				{
					actions 
					{
						custom deluge script
						(
											if(input.Select_Template != null)
										{
											input.Template_1 = input.Select_Template.Template_1;
										}
										else
										{
											input.Template_1 = null;
										}
						)
					}
				}

			
}