			Prevent_Protected_Step_Deletion as "Prevent Protected Step Deletion"
			{
			    type = form
			    form = Gate_Route_Steps
			    record event = on delete
			    description = "Prevents deletion of steps from an Active route referenced by an in-flight request."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                route_is_active = Gate_Routes[ID == input.Gate_Route && Status == "Active"].count(ID) > 0;
			                in_flight_request_count = NPD_Requests[Gate_Route == input.Gate_Route && (Process_Status == "Initial QA Review" || Process_Status == "NPD Rework" || Process_Status == "Initial QA Head Approval" || Process_Status == "Stage Gates In Progress" || Process_Status == "Final QA Head Approval")].count(ID);
			                if(route_is_active && in_flight_request_count > 0)
			                {
			                    alert "This step cannot be deleted while its Active route is referenced by an in-flight request.";
			                    cancel delete;
			                }
			            )
			        }
			    }
			}

			Validate_Gate_Route_Step as "Validate Gate Route Step"
			{
			    type = form
			    form = Gate_Route_Steps
			    record event = on add or edit
			    description = "Validates positive and route-unique step values, final-gate eligibility, and protected in-flight route configuration."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                validation_failed = false;
			
			                if(input.Sequence_Number == null || input.Sequence_Number <= 0)
			                {
			                    alert "Sequence Number must be greater than zero.";
			                    validation_failed = true;
			                }
			
			                duplicate_stage_count = Gate_Route_Steps[Gate_Route == input.Gate_Route && Stage_Gate == input.Stage_Gate && ID != input.ID].count(ID);
			                if(duplicate_stage_count > 0)
			                {
			                    alert "The selected Stage Gate already exists for this route.";
			                    validation_failed = true;
			                }
			
			                duplicate_sequence_count = Gate_Route_Steps[Gate_Route == input.Gate_Route && Sequence_Number == input.Sequence_Number && ID != input.ID].count(ID);
			                if(duplicate_sequence_count > 0)
			                {
			                    alert "The Sequence Number already exists for this route.";
			                    validation_failed = true;
			                }
			
			                if(input.Final_Gate == true && input.Stage_Gate != "N30" && input.Stage_Gate != "N50")
			                {
			                    alert "Only N30 or N50 can be marked as the Final Gate.";
			                    validation_failed = true;
			                }
			
			                route_is_active = Gate_Routes[ID == input.Gate_Route && Status == "Active"].count(ID) > 0;
			                in_flight_request_count = NPD_Requests[Gate_Route == input.Gate_Route && (Process_Status == "Initial QA Review" || Process_Status == "NPD Rework" || Process_Status == "Initial QA Head Approval" || Process_Status == "Stage Gates In Progress" || Process_Status == "Final QA Head Approval")].count(ID);
			                if(route_is_active && in_flight_request_count > 0)
			                {
			                    alert "Steps cannot be changed while this Active route is referenced by an in-flight request.";
			                    validation_failed = true;
			                }
			
			                persisted_step = Gate_Route_Steps[ID == input.ID];
			                if(persisted_step.count() > 0 && persisted_step.Gate_Route != input.Gate_Route)
			                {
			                    persisted_route_id = persisted_step.Gate_Route;
			                    persisted_route_is_active = Gate_Routes[ID == persisted_route_id && Status == "Active"].count(ID) > 0;
			                    persisted_in_flight_count = NPD_Requests[Gate_Route == persisted_route_id && (Process_Status == "Initial QA Review" || Process_Status == "NPD Rework" || Process_Status == "Initial QA Head Approval" || Process_Status == "Stage Gates In Progress" || Process_Status == "Final QA Head Approval")].count(ID);
			                    if(persisted_route_is_active && persisted_in_flight_count > 0)
			                    {
			                        alert "This step cannot be moved from an Active route that is referenced by an in-flight request.";
			                        validation_failed = true;
			                    }
			                }
			
			                if(validation_failed == true)
			                {
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Audit_Gate_Route_Status as "Audit Gate Route Status"
			{
			    type = form
			    form = Gate_Routes
			    record event = on add or edit
			    description = "Writes a successful status initialization or change to the process audit trail."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                audit_action = "Gate Route Status Change - " + input.ID;
			                prior_audit_count = Process_Audit_Log[Action_Name == audit_action].count(ID);
			                prior_status = "";
			                if(prior_audit_count > 0)
			                {
			                    prior_status = Process_Audit_Log[Action_Name == audit_action].To_Status sort by Performed_On desc;
			                }
			                if(prior_audit_count == 0 || prior_status != input.Status)
			                {
			                    audit_id = insert into Process_Audit_Log
			                    [
			                        Event_Type = "Configuration Changed"
			                        Action_Name = audit_action
			                        From_Status = prior_status
			                        To_Status = input.Status
			                        Performed_By_Email = zoho.loginuserid
			                        Performed_On = zoho.currenttime
			                        Event_Details = "Gate Route " + input.Route_Code + " (" + input.Route_Name + ") status saved as " + input.Status + "."
			                    ];
			                }
			            )
			        }
			    }
			}

			Filter_Product_Line_By_Plant as "Filter Product Line by Plant"
			{
			    type = form
			    form = Gate_Routes
			    record event = on add or edit
			    description = "Clears Product Line and limits its choices to product lines belonging to the selected plant."
			
			    on user input of Plant
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Product_Line = null;
			                clear Product_Line;
			                if(input.Plant != null)
			                {
			                    matching_product_lines = Product_Lines[Plant == input.Plant] sort by Product_Line_Name;
			                    Product_Line:ui.add(matching_product_lines.ID.getall());
			                }
			            )
			        }
			    }
			}

			Validate_Gate_Route as "Validate Gate Route"
			{
			    type = form
			    form = Gate_Routes
			    record event = on add or edit
			    description = "Validates route ownership, effective dates, active-period uniqueness, activation-ready child steps, and in-flight usage."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                validation_failed = false;
			                persisted_status = "";
			                if(input.ID != null)
			                {
			                    persisted_route_count = Gate_Routes[ID == input.ID].count(ID);
			                    if(persisted_route_count > 0)
			                    {
			                        persisted_status = Gate_Routes[ID == input.ID].Status;
			                    }
			                }
			
			                matching_product_line_count = Product_Lines[ID == input.Product_Line && Plant == input.Plant].count(ID);
			                if(matching_product_line_count == 0)
			                {
			                    alert(Product_Line, "Select a product line that belongs to the selected plant.");
			                    validation_failed = true;
			                }
			
			                if(input.Effective_To != null && input.Effective_To < input.Effective_From)
			                {
			                    alert(Effective_To, "Effective To must be on or after Effective From.");
			                    validation_failed = true;
			                }
			
			                if(input.Status == "Active")
			                {
			                    if(input.Effective_To == null)
			                    {
			                        overlapping_active_routes = Gate_Routes[Plant == input.Plant && Product_Line == input.Product_Line && Status == "Active" && ID != input.ID && (Effective_To == null || Effective_To >= input.Effective_From)].count(ID);
			                    }
			                    else
			                    {
			                        overlapping_active_routes = Gate_Routes[Plant == input.Plant && Product_Line == input.Product_Line && Status == "Active" && ID != input.ID && Effective_From <= input.Effective_To && (Effective_To == null || Effective_To >= input.Effective_From)].count(ID);
			                    }
			                    if(overlapping_active_routes > 0)
			                    {
			                        alert(Status, "Another Active route overlaps this effective period for the selected plant and product line.");
			                        validation_failed = true;
			                    }
			
			                    if(persisted_status != "Active")
			                    {
			                        active_step_count = Gate_Route_Steps[Gate_Route == input.ID && Active == true].count(ID);
			                        unique_sequences = Gate_Route_Steps[Gate_Route == input.ID && Active == true].distinct(Sequence_Number);
			                        final_gate_count = Gate_Route_Steps[Gate_Route == input.ID && Active == true && Final_Gate == true].count(ID);
			                        invalid_final_gate_count = Gate_Route_Steps[Gate_Route == input.ID && Active == true && Final_Gate == true && Stage_Gate != "N30" && Stage_Gate != "N50"].count(ID);
			
			                        sequence_is_valid = true;
			                        if(active_step_count == 0)
			                        {
			                            sequence_is_valid = false;
			                        }
			                        else
			                        {
			                            minimum_sequence = Gate_Route_Steps[Gate_Route == input.ID && Active == true].minimum(Sequence_Number);
			                            maximum_sequence = Gate_Route_Steps[Gate_Route == input.ID && Active == true].maximum(Sequence_Number);
			                            if(unique_sequences.size() != active_step_count || minimum_sequence != 1 || maximum_sequence != active_step_count)
			                            {
			                                sequence_is_valid = false;
			                            }
			                        }
			
			                        if(sequence_is_valid == false)
			                        {
			                            alert(Status, "Activation requires active route steps with a unique contiguous sequence beginning at 1.");
			                            validation_failed = true;
			                        }
			                        if(final_gate_count != 1 || invalid_final_gate_count > 0)
			                        {
			                            alert(Status, "Activation requires exactly one Final Gate, and it must be N30 or N50.");
			                            validation_failed = true;
			                        }
			                    }
			                }
			
			                if(persisted_status == "Active" && input.Status != "Active")
			                {
			                    in_flight_request_count = NPD_Requests[Gate_Route == input.ID && (Process_Status == "Initial QA Review" || Process_Status == "NPD Rework" || Process_Status == "Initial QA Head Approval" || Process_Status == "Stage Gates In Progress" || Process_Status == "Final QA Head Approval")].count(ID);
			                    if(in_flight_request_count > 0)
			                    {
			                        alert(Status, "This route cannot be deactivated while it is used by an in-flight NPD request.");
			                        validation_failed = true;
			                    }
			                }
			
			                if(validation_failed == true)
			                {
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Audit_NPD_Request_Save as "Audit NPD Request Save"
			{
			    type = form
			    form = NPD_Requests
			    record event = on add
			    description = "Creates the request-created audit event after the first draft is saved."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                audit_event_id = insert into Process_Audit_Log
			                [
			                    NPD_Request = input.ID
			                    Event_Type = "Created"
			                    Action_Name = "NPD Request Created"
			                    From_Status = ""
			                    To_Status = input.Process_Status
			                    Performed_By_Email = zoho.loginuserid
			                    Performed_On = zoho.currenttime
			                    Event_Details = "Request " + input.Request_Number + " created with route ID " + input.Gate_Route + " and branch " + input.Branch + "."
			                ];
			            )
			        }
			    }
			}

			Load_NPD_Request as "Load NPD Request"
			{
			    type = form
			    form = NPD_Requests
			    record event = on add or edit
			    description = "Applies status- and profile-specific visibility and editability while keeping controlled lifecycle fields system maintained."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                is_npd_leader = thisapp.permissions.isUserInProfile("NPD Leader");
			                if(input.ID == null && input.Request_Owner == null)
			                {
			                    input.Request_Owner = zoho.loginuser;
			                }
			
			                disable Gate_Route, Branch, Process_Status, Current_Stage_Gate, Submitted_On, Initial_QA_Due_On, Initial_QA_Decision, Initial_QA_Observations, Initial_QA_Reviewer, Initial_QA_Reviewed_On, Initial_QA_Head_Decision, Initial_QA_Head_Observations, Initial_QA_Head_User, Initial_QA_Head_Decided_On, Final_QA_Head_Decision, Final_QA_Head_Observations, Final_QA_Head_User, Final_QA_Head_Decided_On, Mass_Production_Released_On, Termination_Reason, Escalation_Sent;
			
			                hide Initial_QA_Decision, Initial_QA_Observations, Initial_QA_Reviewer, Initial_QA_Reviewed_On, Initial_QA_Head_Decision, Initial_QA_Head_Observations, Initial_QA_Head_User, Initial_QA_Head_Decided_On, Final_QA_Head_Decision, Final_QA_Head_Observations, Final_QA_Head_User, Final_QA_Head_Decided_On, Mass_Production_Released_On, Termination_Reason;
			
			                if(input.Process_Status == "Initial QA Review" || input.Process_Status == "NPD Rework" || input.Initial_QA_Decision != null)
			                {
			                    show Initial_QA_Decision, Initial_QA_Observations, Initial_QA_Reviewer, Initial_QA_Reviewed_On;
			                }
			                if(input.Process_Status == "Initial QA Head Approval" || input.Process_Status == "Stage Gates In Progress" || input.Process_Status == "Final QA Head Approval" || input.Process_Status == "Mass Production" || input.Initial_QA_Head_Decision != null)
			                {
			                    show Initial_QA_Head_Decision, Initial_QA_Head_Observations, Initial_QA_Head_User, Initial_QA_Head_Decided_On;
			                }
			                if(input.Process_Status == "Final QA Head Approval" || input.Process_Status == "Mass Production" || input.Final_QA_Head_Decision != null)
			                {
			                    show Final_QA_Head_Decision, Final_QA_Head_Observations, Final_QA_Head_User, Final_QA_Head_Decided_On, Mass_Production_Released_On;
			                }
			                if(input.Process_Status == "Terminated")
			                {
			                    show Termination_Reason;
			                }
			
			                if(!(is_npd_leader == true && (input.Process_Status == "Draft" || input.Process_Status == "NPD Rework")))
			                {
			                    disable Request_Title, Request_Owner, Plant, Product_Line, Product_Name, Product_Category, Development_Type, Customer_or_Market, Target_Launch_Date, Product_Description, Business_Justification;
			                }
			            )
			        }
			    }
			}

			NPD_Request_Blueprint as "NPD Request Blueprint"
			{
			    type = blueprint
			    form = NPD_Requests
			
			    start
			    {
			        start stage = "Draft"
			    }
			
			    stages
			    {
			        "Draft" { }
			        "Initial QA Review" { }
			        "NPD Rework" { }
			        "Initial QA Head Approval" { }
			        "Stage Gates In Progress" { }
			        "Final QA Head Approval" { }
			        "Mass Production" { }
			        "Terminated" { }
			    }
			
			    transitions
			    {
			        Submit_for_QA as "Submit for QA"
			        {
			            type = normal
			            from stage = "Draft"
			            to stage = "Initial QA Review"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"NPD Leader"}
			                    userfields = {Request_Owner}
			                )
			                confirmation before execution
			                (
			                    message = "Submit this request, its current mandatory documents, and Sample Validation Sheet to QA?"
			                    confirm button text = "Submit for QA"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        settings = Process_Settings[Active == true];
			                        Submitted_On = zoho.currenttime;
			                        Initial_QA_Due_On = zoho.currentdate.addBusinessDay(settings.Review_SLA_Working_Days);
			                        Initial_QA_Reviewer = settings.QA_Reviewer_User;
			                        Escalation_Sent = false;
			                        audit_id = insert into Process_Audit_Log
			                        [
			                            NPD_Request = input.ID
			                            Event_Type = "Submitted"
			                            Action_Name = "Submit for QA"
			                            From_Status = "Draft"
			                            To_Status = "Initial QA Review"
			                            Performed_By_Email = zoho.loginuserid
			                            Performed_On = zoho.currenttime
			                            Event_Details = "Active route, mandatory initial documents, and complete sample validation rows were validated."
			                        ];
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : settings.QA_Reviewer_User.email
			                            subject : "NPD request ready for initial QA review"
			                            message : "Request " + input.Request_Number + " - " + input.Request_Title + " is ready for initial QA review."
			                        )
			                    )
			                }
			            }
			        }
			
			        Resubmit_Documents as "Resubmit Documents"
			        {
			            type = normal
			            from stage = "NPD Rework"
			            to stage = "Initial QA Review"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"NPD Leader"}
			                    userfields = {Request_Owner}
			                )
			                confirmation before execution
			                (
			                    message = "Resubmit the corrected current documents and validation details to QA?"
			                    confirm button text = "Resubmit Documents"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        settings = Process_Settings[Active == true];
			                        Submitted_On = zoho.currenttime;
			                        Initial_QA_Due_On = zoho.currentdate.addBusinessDay(settings.Review_SLA_Working_Days);
			                        Initial_QA_Decision = null;
			                        Initial_QA_Reviewed_On = null;
			                        Initial_QA_Reviewer = settings.QA_Reviewer_User;
			                        Escalation_Sent = false;
			                        audit_id = insert into Process_Audit_Log
			                        [
			                            NPD_Request = input.ID
			                            Event_Type = "Resubmitted"
			                            Action_Name = "Resubmit Documents"
			                            From_Status = "NPD Rework"
			                            To_Status = "Initial QA Review"
			                            Observations = input.Initial_QA_Observations
			                            Performed_By_Email = zoho.loginuserid
			                            Performed_On = zoho.currenttime
			                            Event_Details = "Corrected current documents and sample validation details resubmitted."
			                        ];
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : settings.QA_Reviewer_User.email
			                            subject : "NPD request documents resubmitted"
			                            message : "Request " + input.Request_Number + " - " + input.Request_Title + " has been resubmitted for initial QA review."
			                        )
			                    )
			                }
			            }
			        }
			
			        QA_Docs_Pass as "QA Docs Pass"
			        {
			            type = normal
			            from stage = "Initial QA Review"
			            to stage = "Initial QA Head Approval"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"QA Reviewer"}
			                    userfields = {Initial_QA_Reviewer}
			                )
			            }
			            during
			            {
			                action = update_fields
			                workflow status = true
			                visible fields = [Initial_QA_Decision, Initial_QA_Observations]
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        settings = Process_Settings[Active == true];
			                        Initial_QA_Decision = "Pass";
			                        Initial_QA_Reviewer = zoho.loginuser;
			                        Initial_QA_Reviewed_On = zoho.currenttime;
			                        Initial_QA_Head_User = settings.QA_Head_User;
			                        Initial_QA_Due_On = zoho.currentdate.addBusinessDay(settings.Review_SLA_Working_Days);
			                        Escalation_Sent = false;
			                        audit_id = insert into Process_Audit_Log
			                        [
			                            NPD_Request = input.ID
			                            Event_Type = "Passed"
			                            Action_Name = "QA Docs Pass"
			                            From_Status = "Initial QA Review"
			                            To_Status = "Initial QA Head Approval"
			                            Decision = "Pass"
			                            Observations = input.Initial_QA_Observations
			                            Performed_By_Email = zoho.loginuserid
			                            Performed_On = zoho.currenttime
			                        ];
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : settings.QA_Head_User.email
			                            subject : "NPD request ready for initial QA Head approval"
			                            message : "Request " + input.Request_Number + " passed initial QA document review."
			                        )
			                    )
			                }
			            }
			        }
			
			        QA_Docs_Not_Pass as "QA Docs Not Pass"
			        {
			            type = normal
			            from stage = "Initial QA Review"
			            to stage = "NPD Rework"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"QA Reviewer"}
			                    userfields = {Initial_QA_Reviewer}
			                )
			            }
			            during
			            {
			                action = update_fields
			                workflow status = true
			                visible fields = [Initial_QA_Decision, Initial_QA_Observations]
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        settings = Process_Settings[Active == true];
			                        Initial_QA_Decision = "Not Pass";
			                        Initial_QA_Reviewer = zoho.loginuser;
			                        Initial_QA_Reviewed_On = zoho.currenttime;
			                        Initial_QA_Due_On = null;
			                        Escalation_Sent = false;
			                        audit_id = insert into Process_Audit_Log
			                        [
			                            NPD_Request = input.ID
			                            Event_Type = "Reworked"
			                            Action_Name = "QA Docs Not Pass"
			                            From_Status = "Initial QA Review"
			                            To_Status = "NPD Rework"
			                            Decision = "Not Pass"
			                            Observations = input.Initial_QA_Observations
			                            Performed_By_Email = zoho.loginuserid
			                            Performed_On = zoho.currenttime
			                        ];
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : settings.NPD_Leader_User.email
			                            subject : "NPD request requires document rework"
			                            message : "Request " + input.Request_Number + " requires rework. QA observations: " + input.Initial_QA_Observations
			                        )
			                    )
			                }
			            }
			        }
			
			        Initial_QA_Head_Approve as "Initial QA Head Approve"
			        {
			            type = normal
			            from stage = "Initial QA Head Approval"
			            to stage = "Stage Gates In Progress"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"QA Head"}
			                    userfields = {Initial_QA_Head_User}
			                )
			                confirmation before execution
			                (
			                    message = "Approve the initial gate and materialize the snapshotted route?"
			                    confirm button text = "Approve"
			                    cancel button text = "Cancel"
			                )
			            }
			            during
			            {
			                action = update_fields
			                workflow status = true
			                visible fields = [Initial_QA_Head_Decision, Initial_QA_Head_Observations]
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        settings = Process_Settings[Active == true];
			                        Initial_QA_Head_Decision = "Approved";
			                        Initial_QA_Head_User = zoho.loginuser;
			                        Initial_QA_Head_Decided_On = zoho.currenttime;
			                        Initial_QA_Due_On = null;
			                        Escalation_Sent = false;
			                        route_steps = Gate_Route_Steps[Gate_Route == input.Gate_Route && Active == true] sort by Sequence_Number;
			                        first_stage = "";
			                        for each route_step in route_steps
			                        {
			                            instance_status = "Locked";
			                            activated_time = null;
			                            latest_attempt = 0;
			                            if(route_step.Sequence_Number == 1)
			                            {
			                                instance_status = "Ready for Sourcing";
			                                activated_time = zoho.currenttime;
			                                latest_attempt = 1;
			                                first_stage = route_step.Stage_Gate;
			                            }
			                            instance_id = insert into Stage_Gate_Instances
			                            [
			                                NPD_Request = input.ID
			                                Gate_Route_Step = route_step.ID
			                                Stage_Gate = route_step.Stage_Gate
			                                Sequence_Number = route_step.Sequence_Number
			                                Final_Gate = route_step.Final_Gate
			                                Gate_Status = instance_status
			                                Activated_On = activated_time
			                                Latest_Attempt_Number = latest_attempt
			                                Sourcing_User = settings.Sourcing_User
			                                QA_Reviewer_User = settings.QA_Reviewer_User
			                                Section_Head_User = settings.Section_Head_User
			                            ];
			                            if(route_step.Sequence_Number == 1)
			                            {
			                                submission_id = insert into Stage_Gate_Submissions
			                                [
			                                    Stage_Gate_Instance = instance_id
			                                    Attempt_Number = 1
			                                    Submission_Status = "Sourcing Draft"
			                                ];
			                            }
			                        }
			                        Current_Stage_Gate = first_stage;
			                        audit_id = insert into Process_Audit_Log
			                        [
			                            NPD_Request = input.ID
			                            Event_Type = "Approved"
			                            Action_Name = "Initial QA Head Approve"
			                            From_Status = "Initial QA Head Approval"
			                            To_Status = "Stage Gates In Progress"
			                            Decision = "Approved"
			                            Observations = input.Initial_QA_Head_Observations
			                            Performed_By_Email = zoho.loginuserid
			                            Performed_On = zoho.currenttime
			                            Event_Details = "Route steps were snapshotted as stage gate instances and sequence 1 was activated."
			                        ];
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : settings.Sourcing_User.email
			                            subject : "First NPD stage gate ready for sourcing"
			                            message : "Request " + input.Request_Number + " has entered stage gates. " + first_stage + " attempt 1 is ready for sourcing."
			                        )
			                    )
			                }
			            }
			        }
			
			        Initial_QA_Head_Reject as "Initial QA Head Reject"
			        {
			            type = normal
			            from stage = "Initial QA Head Approval"
			            to stage = "Terminated"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"QA Head"}
			                    userfields = {Initial_QA_Head_User}
			                )
			            }
			            during
			            {
			                action = update_fields
			                workflow status = true
			                visible fields = [Initial_QA_Head_Decision, Initial_QA_Head_Observations, Termination_Reason]
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        settings = Process_Settings[Active == true];
			                        Initial_QA_Head_Decision = "Rejected";
			                        Initial_QA_Head_User = zoho.loginuser;
			                        Initial_QA_Head_Decided_On = zoho.currenttime;
			                        Initial_QA_Due_On = null;
			                        audit_id = insert into Process_Audit_Log
			                        [
			                            NPD_Request = input.ID
			                            Event_Type = "Rejected"
			                            Action_Name = "Initial QA Head Reject"
			                            From_Status = "Initial QA Head Approval"
			                            To_Status = "Terminated"
			                            Decision = "Rejected"
			                            Observations = input.Initial_QA_Head_Observations
			                            Performed_By_Email = zoho.loginuserid
			                            Performed_On = zoho.currenttime
			                            Event_Details = input.Termination_Reason
			                        ];
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : settings.NPD_Leader_User.email
			                            subject : "NPD request terminated at initial QA Head gate"
			                            message : "Request " + input.Request_Number + " was terminated. Reason: " + input.Termination_Reason
			                        )
			                    )
			                }
			            }
			        }
			
			        Final_QA_Head_Approve as "Final QA Head Approve"
			        {
			            type = normal
			            from stage = "Final QA Head Approval"
			            to stage = "Mass Production"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"QA Head"}
			                )
			                confirmation before execution
			                (
			                    message = "Approve final release to Mass Production and notify the configured distribution list?"
			                    confirm button text = "Release"
			                    cancel button text = "Cancel"
			                )
			            }
			            during
			            {
			                action = update_fields
			                workflow status = true
			                visible fields = [Final_QA_Head_Decision, Final_QA_Head_Observations]
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        settings = Process_Settings[Active == true];
			                        Final_QA_Head_Decision = "Approved";
			                        Final_QA_Head_User = zoho.loginuser;
			                        Final_QA_Head_Decided_On = zoho.currenttime;
			                        Mass_Production_Released_On = zoho.currenttime;
			                        Initial_QA_Due_On = null;
			                        Escalation_Sent = false;
			                        audit_id = insert into Process_Audit_Log
			                        [
			                            NPD_Request = input.ID
			                            Event_Type = "Released to Mass Production"
			                            Action_Name = "Final QA Head Approve"
			                            From_Status = "Final QA Head Approval"
			                            To_Status = "Mass Production"
			                            Decision = "Approved"
			                            Observations = input.Final_QA_Head_Observations
			                            Performed_By_Email = zoho.loginuserid
			                            Performed_On = zoho.currenttime
			                            Event_Details = "Final QA Head approval completed and Mass Production release timestamp recorded."
			                        ];
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : settings.Final_Notification_Emails.toList(",")
			                            subject : "NPD released to Mass Production: " + input.Request_Number
			                            message : "Request " + input.Request_Number + " - " + input.Request_Title + " has received final QA Head approval and is released to Mass Production."
			                        )
			                    )
			                }
			            }
			        }
			
			        Final_QA_Head_Reject as "Final QA Head Reject"
			        {
			            type = normal
			            from stage = "Final QA Head Approval"
			            to stage = "Terminated"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"QA Head"}
			                )
			            }
			            during
			            {
			                action = update_fields
			                workflow status = true
			                visible fields = [Final_QA_Head_Decision, Final_QA_Head_Observations, Termination_Reason]
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        settings = Process_Settings[Active == true];
			                        Final_QA_Head_Decision = "Rejected";
			                        Final_QA_Head_User = zoho.loginuser;
			                        Final_QA_Head_Decided_On = zoho.currenttime;
			                        Initial_QA_Due_On = null;
			                        audit_id = insert into Process_Audit_Log
			                        [
			                            NPD_Request = input.ID
			                            Event_Type = "Rejected"
			                            Action_Name = "Final QA Head Reject"
			                            From_Status = "Final QA Head Approval"
			                            To_Status = "Terminated"
			                            Decision = "Rejected"
			                            Observations = input.Final_QA_Head_Observations
			                            Performed_By_Email = zoho.loginuserid
			                            Performed_On = zoho.currenttime
			                            Event_Details = input.Termination_Reason
			                        ];
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : settings.NPD_Leader_User.email
			                            subject : "NPD request terminated at final QA Head gate"
			                            message : "Request " + input.Request_Number + " was terminated. Reason: " + input.Termination_Reason
			                        )
			                    )
			                }
			            }
			        }
			    }
			}

			NPD_Request_Review_SLA as "NPD Request Review SLA"
			{
			    type = schedule
			    form = NPD_Requests[Initial_QA_Due_On != null && Initial_QA_Due_On < zoho.currentdate && (Process_Status == "Initial QA Review" || Process_Status == "Initial QA Head Approval" || Process_Status == "Final QA Head Approval")]
			    start = Initial_QA_Due_On at "09:00:00"
			    frequency = daily
			    time zone = "Asia/Kolkata"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                settings = Process_Settings[Active == true];
			                if(settings.count(ID) == 1)
			                {
			                    recipient_email = settings.QA_Reviewer_User.email;
			                    manager_email = settings.QA_Review_Manager_Email;
			                    if(input.Process_Status == "Initial QA Head Approval" || input.Process_Status == "Final QA Head Approval")
			                    {
			                        recipient_email = settings.QA_Head_User.email;
			                        manager_email = settings.QA_Head_Manager_Email;
			                    }
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : recipient_email
			                        subject : "Overdue NPD review: " + input.Request_Title
			                        message : "Request " + input.Request_Number + " is overdue in " + input.Process_Status + ". Due date: " + input.Initial_QA_Due_On + "."
			                    )
			                    overdue_working_days = input.Initial_QA_Due_On.workDaysBetween(zoho.currentdate);
			                    if(input.Escalation_Sent == false && manager_email != null)
			                    {
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : manager_email
			                            cc : recipient_email
			                            subject : "Escalation: overdue NPD review " + input.Request_Title
			                            message : "Request " + input.Request_Number + " remains in " + input.Process_Status + " beyond the configured working-day SLA."
			                        )
			                        input.Escalation_Sent = true;
			                        audit_event_id = insert into Process_Audit_Log
			                        [
			                            NPD_Request = input.ID
			                            Event_Type = "Escalated"
			                            Action_Name = "NPD Review SLA Escalation"
			                            From_Status = input.Process_Status
			                            To_Status = input.Process_Status
			                            Performed_By_Email = zoho.adminuserid
			                            Performed_On = zoho.currenttime
			                            Event_Details = "One-time escalation sent after " + overdue_working_days + " working days overdue."
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

			Plant_Input_NPD_Request as "Plant Input NPD Request"
			{
			    type = form
			    form = NPD_Requests
			    record event = on add or edit
			    description = "Filters active product lines for the selected plant and clears the route snapshot."
			
			    on user input of Plant
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Product_Line = null;
			                input.Gate_Route = null;
			                input.Branch = "";
			                clear Product_Line;
			                if(input.Plant != null)
			                {
			                    active_product_lines = Product_Lines[Plant == input.Plant && Active == true] sort by Product_Line_Name;
			                    Product_Line:ui.add(active_product_lines.ID.getall());
			                }
			            )
			        }
			    }
			}

			Product_Line_Input_NPD_Request as "Product Line Input NPD Request"
			{
			    type = form
			    form = NPD_Requests
			    record event = on add or edit
			    description = "Snapshots the one effective active route and the plant branch for the selected product line."
			
			    on user input of Product_Line
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Gate_Route = null;
			                input.Branch = "";
			                if(input.Plant != null && input.Product_Line != null)
			                {
			                    effective_routes = Gate_Routes[Plant == input.Plant && Product_Line == input.Product_Line && Status == "Active" && Effective_From <= zoho.currentdate && (Effective_To == null || Effective_To >= zoho.currentdate)];
			                    if(effective_routes.count(ID) == 1)
			                    {
			                        input.Gate_Route = effective_routes.ID;
			                        input.Branch = Plants[ID == input.Plant].Branch;
			                    }
			                    else if(effective_routes.count(ID) == 0)
			                    {
			                        alert "No effective Active gate route is configured for the selected plant and product line.";
			                    }
			                    else
			                    {
			                        alert "More than one effective Active gate route exists. Ask an administrator to correct route configuration.";
			                    }
			                }
			            )
			        }
			    }
			}

			Validate_NPD_Request as "Validate NPD Request"
			{
			    type = form
			    form = NPD_Requests
			    record event = on add
			    description = "Validates new-request ownership and plant, product-line, and route consistency."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                validation_failed = false;
			                settings = Process_Settings[Active == true];
			                if(settings.count(ID) != 1)
			                {
			                    alert "Exactly one Active Process Settings record is required.";
			                    validation_failed = true;
			                }
			                else
			                {
			                    if(input.Request_Owner.email.toLowerCase() != settings.NPD_Leader_User.email.toLowerCase())
			                    {
			                        alert(Request_Owner, "New requests must be owned by the configured NPD Leader.");
			                        validation_failed = true;
			                    }
			
			                    matching_product_line = Product_Lines[ID == input.Product_Line && Plant == input.Plant && Active == true].count(ID);
			                    if(matching_product_line != 1)
			                    {
			                        alert(Product_Line, "Select an active product line belonging to the selected plant.");
			                        validation_failed = true;
			                    }
			
			                    if(input.Gate_Route != null)
			                    {
			                        selected_route_count = Gate_Routes[ID == input.Gate_Route && Plant == input.Plant && Product_Line == input.Product_Line].count(ID);
			                        if(selected_route_count != 1)
			                        {
			                            alert(Gate_Route, "The snapshotted route does not match the selected plant and product line.");
			                            validation_failed = true;
			                        }
			                    }
			                }
			
			                if(validation_failed)
			                {
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Validate_NPD_Request_Edit as "Validate NPD Request Edit"
			{
			    type = form
			    form = NPD_Requests
			    record event = on edit
			    description = "Enforces protected lifecycle fields, immutable snapshots, authorized state transitions, submission completeness, and decision observations."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                validation_failed = false;
			                settings = Process_Settings[Active == true];
			                if(settings.count(ID) != 1)
			                {
			                    alert "Exactly one Active Process Settings record is required.";
			                    validation_failed = true;
			                }
			                else
			                {
			                    matching_product_line = Product_Lines[ID == input.Product_Line && Plant == input.Plant && Active == true].count(ID);
			                    if(matching_product_line != 1)
			                    {
			                        alert(Product_Line, "Select an active product line belonging to the selected plant.");
			                        validation_failed = true;
			                    }
			
			                    if(input.Gate_Route != null)
			                    {
			                        selected_route_count = Gate_Routes[ID == input.Gate_Route && Plant == input.Plant && Product_Line == input.Product_Line].count(ID);
			                        if(selected_route_count != 1)
			                        {
			                            alert(Gate_Route, "The snapshotted route does not match the selected plant and product line.");
			                            validation_failed = true;
			                        }
			                    }
			
			                    if(input.Process_Status == old.Process_Status)
			                    {
			                        protected_change = input.Current_Stage_Gate != old.Current_Stage_Gate || input.Submitted_On != old.Submitted_On || input.Initial_QA_Due_On != old.Initial_QA_Due_On || input.Initial_QA_Decision != old.Initial_QA_Decision || input.Initial_QA_Observations != old.Initial_QA_Observations || input.Initial_QA_Reviewer != old.Initial_QA_Reviewer || input.Initial_QA_Reviewed_On != old.Initial_QA_Reviewed_On || input.Initial_QA_Head_Decision != old.Initial_QA_Head_Decision || input.Initial_QA_Head_Observations != old.Initial_QA_Head_Observations || input.Initial_QA_Head_User != old.Initial_QA_Head_User || input.Initial_QA_Head_Decided_On != old.Initial_QA_Head_Decided_On || input.Final_QA_Head_Decision != old.Final_QA_Head_Decision || input.Final_QA_Head_Observations != old.Final_QA_Head_Observations || input.Final_QA_Head_User != old.Final_QA_Head_User || input.Final_QA_Head_Decided_On != old.Final_QA_Head_Decided_On || input.Mass_Production_Released_On != old.Mass_Production_Released_On || input.Termination_Reason != old.Termination_Reason || input.Escalation_Sent != old.Escalation_Sent;
			                        if(protected_change)
			                        {
			                            alert "Lifecycle, decision, SLA, and release fields can be changed only by controlled transitions and schedules.";
			                            validation_failed = true;
			                        }
			                        if((old.Process_Status != "Draft" && old.Process_Status != "NPD Rework") && (input.Plant != old.Plant || input.Product_Line != old.Product_Line || input.Gate_Route != old.Gate_Route || input.Branch != old.Branch))
			                        {
			                            alert "Plant, product line, gate route, and branch snapshots cannot change after submission.";
			                            validation_failed = true;
			                        }
			                    }
			
			                    if(input.Process_Status != old.Process_Status)
			                    {
			                        actor_email = zoho.loginuserid.toLowerCase();
			                        if((old.Process_Status == "Draft" || old.Process_Status == "NPD Rework") && input.Process_Status == "Initial QA Review")
			                        {
			                            if(actor_email != settings.NPD_Leader_User.email.toLowerCase())
			                            {
			                                alert "Only the configured NPD Leader may submit or resubmit documents.";
			                                validation_failed = true;
			                            }
			                            active_route_count = Gate_Routes[ID == input.Gate_Route && Status == "Active" && Effective_From <= zoho.currentdate && (Effective_To == null || Effective_To >= zoho.currentdate)].count(ID);
			                            if(active_route_count != 1)
			                            {
			                                alert "Submission requires the snapshotted route to remain effective and Active.";
			                                validation_failed = true;
			                            }
			                            mandatory_requirements = Document_Requirements[Gate_Route == input.Gate_Route && Scope == "Initial Request" && Mandatory == true && Active == true];
			                            for each requirement_record in mandatory_requirements
			                            {
			                                current_document_count = Request_Documents[NPD_Request == input.ID && Document_Requirement == requirement_record.ID && Current_Version == true].count(ID);
			                                if(current_document_count == 0)
			                                {
			                                    alert "Upload a current document for every mandatory initial document requirement.";
			                                    validation_failed = true;
			                                }
			                            }
			                            validation_row_count = Sample_Validation_Items[NPD_Request == input.ID].count(ID);
			                            incomplete_row_count = Sample_Validation_Items[NPD_Request == input.ID && (Sequence_Number == null || Check_Category == null || Checkpoint == null || Specification_or_Acceptance_Criteria == null || Result == null || Performed_By == null || Performed_On == null)].count(ID);
			                            if(validation_row_count == 0 || incomplete_row_count > 0)
			                            {
			                                alert "Add at least one complete Sample Validation Item before submission.";
			                                validation_failed = true;
			                            }
			                        }
			                        else if(old.Process_Status == "Initial QA Review" && (input.Process_Status == "Initial QA Head Approval" || input.Process_Status == "NPD Rework"))
			                        {
			                            if(actor_email != settings.QA_Reviewer_User.email.toLowerCase())
			                            {
			                                alert "Only the configured QA Reviewer may complete initial QA review.";
			                                validation_failed = true;
			                            }
			                            observations = ifnull(input.Initial_QA_Observations, "").trim();
			                            if(input.Process_Status == "NPD Rework" && observations.isEmpty())
			                            {
			                                alert(Initial_QA_Observations, "Observations are required when documents do not pass.");
			                                validation_failed = true;
			                            }
			                            if(input.Process_Status == "Initial QA Head Approval" && observations.toLowerCase() != "no observation" && observations.length() < 10)
			                            {
			                                alert(Initial_QA_Observations, "Enter No Observation or substantive QA observations.");
			                                validation_failed = true;
			                            }
			                        }
			                        else if(old.Process_Status == "Initial QA Head Approval" && (input.Process_Status == "Stage Gates In Progress" || input.Process_Status == "Terminated"))
			                        {
			                            if(actor_email != settings.QA_Head_User.email.toLowerCase())
			                            {
			                                alert "Only the configured QA Head may make the initial QA Head decision.";
			                                validation_failed = true;
			                            }
			                            if(input.Process_Status == "Terminated" && ifnull(input.Termination_Reason, "").trim().isEmpty())
			                            {
			                                alert(Termination_Reason, "A termination reason is required.");
			                                validation_failed = true;
			                            }
			                        }
			                        else if(old.Process_Status == "Final QA Head Approval" && (input.Process_Status == "Mass Production" || input.Process_Status == "Terminated"))
			                        {
			                            if(actor_email != settings.QA_Head_User.email.toLowerCase())
			                            {
			                                alert "Only the configured QA Head may make the final QA Head decision.";
			                                validation_failed = true;
			                            }
			                            if(input.Process_Status == "Terminated" && ifnull(input.Termination_Reason, "").trim().isEmpty())
			                            {
			                                alert(Termination_Reason, "A termination reason is required.");
			                                validation_failed = true;
			                            }
			                        }
			                        else
			                        {
			                            alert "This Process Status change is not an allowed NPD request transition.";
			                            validation_failed = true;
			                        }
			                    }
			                }
			
			                if(validation_failed)
			                {
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Load_Process_Audit_Log as "Load Process Audit Log"
			{
			    type = form
			    form = Process_Audit_Log
			    record event = on add or edit
			    description = "Makes every audit field read-only so audit records remain application-controlled and immutable in the user interface."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable NPD_Request, Stage_Gate_Instance, Stage_Gate_Submission, Event_Type, Action_Name, From_Status, To_Status, Decision, Observations, Performed_By_Email, Performed_On, Event_Details;
			            )
			        }
			    }
			}

			Validate_Process_Settings as "Validate Process Settings"
			{
			    type = form
			    form = Process_Settings
			    record event = on add or edit
			    description = "Enforces one active configuration, positive SLA, distinct fixed assignees, and a populated notification list."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                validation_failed = false;
			                if(input.Review_SLA_Working_Days == null || input.Review_SLA_Working_Days <= 0)
			                {
			                    alert "Review SLA Working Days must be greater than zero.";
			                    validation_failed = true;
			                }
			
			                existing_settings = Process_Settings[ID != input.ID].count(ID);
			                other_active_settings = Process_Settings[Active == true && ID != input.ID].count(ID);
			                if(input.Active == true && other_active_settings > 0)
			                {
			                    alert "Only one Process Settings record can be Active.";
			                    validation_failed = true;
			                }
			                if(input.Active == false && (existing_settings == 0 || other_active_settings == 0))
			                {
			                    alert "Exactly one Process Settings record must remain Active.";
			                    validation_failed = true;
			                }
			
			                if(input.NPD_Leader_User == null || input.QA_Reviewer_User == null || input.QA_Head_User == null || input.Sourcing_User == null || input.Section_Head_User == null)
			                {
			                    alert "Select a valid Creator user for every fixed process assignee.";
			                    validation_failed = true;
			                }
			                else
			                {
			                    fixed_assignee_emails = List();
			                    fixed_assignee_emails.add(input.NPD_Leader_User.email.toLowerCase());
			                    fixed_assignee_emails.add(input.QA_Reviewer_User.email.toLowerCase());
			                    fixed_assignee_emails.add(input.QA_Head_User.email.toLowerCase());
			                    fixed_assignee_emails.add(input.Sourcing_User.email.toLowerCase());
			                    fixed_assignee_emails.add(input.Section_Head_User.email.toLowerCase());
			                    if(fixed_assignee_emails.distinct().size() != fixed_assignee_emails.size())
			                    {
			                        alert "Each fixed process role must be assigned to a different Creator user.";
			                        validation_failed = true;
			                    }
			                }
			
			                if(input.Final_Notification_Emails == null || input.Final_Notification_Emails.trim().isEmpty())
			                {
			                    alert "Enter at least one final-release notification recipient.";
			                    validation_failed = true;
			                }
			
			                if(validation_failed == true)
			                {
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Validate_Product_Line as "Validate Product Line"
			{
			    type = form
			    form = Product_Lines
			    record event = on add or edit
			    description = "Prevents duplicate product line names within a plant and activation under an inactive plant"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                validation_failed = false;
			                duplicate_count = Product_Lines[Plant == input.Plant && Product_Line_Name == input.Product_Line_Name && ID != input.ID].count(ID);
			                if(duplicate_count > 0)
			                {
			                    alert(Product_Line_Name, "A product line with this name already exists for the selected plant.");
			                    validation_failed = true;
			                }
			                if(input.Active == true)
			                {
			                    inactive_plant_count = Plants[ID == input.Plant && Active == false].count(ID);
			                    if(inactive_plant_count > 0)
			                    {
			                        alert(Plant, "An active product line cannot be assigned to an inactive plant.");
			                        validation_failed = true;
			                    }
			                }
			                if(validation_failed == true)
			                {
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Finalize_Request_Document_Upload as "Finalize Request Document Upload"
			{
			    type = form
			    form = Request_Documents
			    record event = on add
			    description = "Retires older current flags and audits the new upload without deleting prior versions"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                older_versions = Request_Documents[ID != input.ID && NPD_Request == input.NPD_Request && Document_Requirement == input.Document_Requirement && Current_Version == true];
			                for each older_version in older_versions
			                {
			                    older_version.Current_Version = false;
			                }
			
			                audit_details = "Document Requirement ID: " + input.Document_Requirement + "; Document Name: " + input.Document_Name + "; Version: " + input.Version_Number + "; Request Document ID: " + input.ID;
			                audit_id = insert into Process_Audit_Log
			                [
			                    NPD_Request = input.NPD_Request
			                    Event_Type = "Document Uploaded"
			                    Action_Name = "Initial Request Document Uploaded"
			                    Performed_By_Email = zoho.loginuserid
			                    Performed_On = zoho.currenttime
			                    Event_Details = audit_details
			                ];
			            )
			        }
			    }
			}

			Load_Request_Document as "Load Request Document"
			{
			    type = form
			    form = Request_Documents
			    record event = on add or edit
			    description = "Filters initial-request checklist choices and protects system-maintained version metadata"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                clear Document_Requirement;
			                if(input.NPD_Request != null)
			                {
			                    request_record = NPD_Requests[ID == input.NPD_Request];
			                    allowed_requirements = Document_Requirements[Active == true && Scope == "Initial Request" && Gate_Route == request_record.Gate_Route] sort by Sort_Order;
			                    Document_Requirement:ui.add(allowed_requirements.ID.getall());
			                }
			                if(input.ID == null)
			                {
			                    input.Uploaded_By = zoho.loginuser;
			                    input.Uploaded_On = zoho.currenttime;
			                    input.Current_Version = true;
			                }
			                disable Version_Number, Current_Version, Uploaded_By, Uploaded_On;
			                if(input.ID != null)
			                {
			                    disable NPD_Request, Document_Requirement, Document_Name, Document_File;
			                }
			            )
			        }
			    }
			}

			NPD_Request_Input_Request_Document as "NPD Request Input Request Document"
			{
			    type = form
			    form = Request_Documents
			    record event = on add
			    description = "Refreshes eligible active initial-request requirements for the selected request route"
			
			    on user input of NPD_Request
			    {
			        actions
			        {
			            custom deluge script
			            (
			                clear Document_Requirement;
			                input.Document_Requirement = null;
			                input.Version_Number = 1;
			                if(input.NPD_Request != null)
			                {
			                    request_record = NPD_Requests[ID == input.NPD_Request];
			                    allowed_requirements = Document_Requirements[Active == true && Scope == "Initial Request" && Gate_Route == request_record.Gate_Route] sort by Sort_Order;
			                    Document_Requirement:ui.add(allowed_requirements.ID.getall());
			                }
			            )
			        }
			    }
			}

			Requirement_Input_Request_Document as "Requirement Input Request Document"
			{
			    type = form
			    form = Request_Documents
			    record event = on add
			    description = "Assigns the next document version number for the selected request checklist item"
			
			    on user input of Document_Requirement
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Version_Number = 1;
			                if(input.NPD_Request != null && input.Document_Requirement != null)
			                {
			                    prior_version_count = Request_Documents[NPD_Request == input.NPD_Request && Document_Requirement == input.Document_Requirement].count(ID);
			                    if(prior_version_count > 0)
			                    {
			                        prior_max_version = Request_Documents[NPD_Request == input.NPD_Request && Document_Requirement == input.Document_Requirement].maximum(Version_Number);
			                        input.Version_Number = prior_max_version + 1;
			                    }
			                }
			            )
			        }
			    }
			}

			Validate_Request_Document as "Validate Request Document"
			{
			    type = form
			    form = Request_Documents
			    record event = on add or edit
			    description = "Allows controlled owner uploads in Draft or NPD Rework and preserves immutable document versions"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                validation_failed = false;
			                if(input.ID != null)
			                {
			                    existing_document = Request_Documents[ID == input.ID];
			                    if(input.NPD_Request != existing_document.NPD_Request || input.Document_Requirement != existing_document.Document_Requirement || input.Document_Name != existing_document.Document_Name || input.Document_File != existing_document.Document_File || input.Version_Number != existing_document.Version_Number || input.Current_Version != existing_document.Current_Version || input.Uploaded_By != existing_document.Uploaded_By || input.Uploaded_On != existing_document.Uploaded_On)
			                    {
			                        alert "Uploaded document versions are immutable. Add a new row for a replacement; only Remarks may be edited.";
			                        validation_failed = true;
			                    }
			                }
			                else
			                {
			                    request_count = NPD_Requests[ID == input.NPD_Request].count(ID);
			                    if(request_count == 0)
			                    {
			                        alert(NPD_Request, "Select a valid NPD request.");
			                        validation_failed = true;
			                    }
			                    else
			                    {
			                        request_record = NPD_Requests[ID == input.NPD_Request];
			                        if(request_record.Process_Status != "Draft" && request_record.Process_Status != "NPD Rework")
			                        {
			                            alert(NPD_Request, "Documents may be added only while the request is in Draft or NPD Rework.");
			                            validation_failed = true;
			                        }
			
			                        requirement_count = Document_Requirements[ID == input.Document_Requirement && Active == true && Scope == "Initial Request" && Gate_Route == request_record.Gate_Route].count(ID);
			                        if(requirement_count == 0)
			                        {
			                            alert(Document_Requirement, "Select an active Initial Request requirement configured for this request route.");
			                            validation_failed = true;
			                        }
			
			                        settings_count = Process_Settings[Active == true].count(ID);
			                        if(settings_count != 1)
			                        {
			                            alert "Exactly one active process settings record is required before uploading documents.";
			                            validation_failed = true;
			                        }
			                        else
			                        {
			                            active_settings = Process_Settings[Active == true];
			                            if(request_record.Request_Owner.email.toLowerCase() != zoho.loginuserid.toLowerCase() || active_settings.NPD_Leader_User.email.toLowerCase() != zoho.loginuserid.toLowerCase())
			                            {
			                                alert "Only the request owner who is the configured NPD leader may upload request documents.";
			                                validation_failed = true;
			                            }
			                        }
			
			                        expected_version = 1;
			                        prior_version_count = Request_Documents[NPD_Request == input.NPD_Request && Document_Requirement == input.Document_Requirement].count(ID);
			                        if(prior_version_count > 0)
			                        {
			                            prior_max_version = Request_Documents[NPD_Request == input.NPD_Request && Document_Requirement == input.Document_Requirement].maximum(Version_Number);
			                            expected_version = prior_max_version + 1;
			                        }
			                        if(input.Version_Number == null || input.Version_Number <= 0 || input.Version_Number != expected_version)
			                        {
			                            alert(Version_Number, "Version Number must be the next positive version: " + expected_version + ".");
			                            validation_failed = true;
			                        }
			
			                        input.Uploaded_By = zoho.loginuser;
			                        input.Uploaded_On = zoho.currenttime;
			                        input.Current_Version = true;
			                    }
			                }
			                if(validation_failed)
			                {
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Audit_Sample_Validation_Item_Add as "Audit Sample Validation Item Add"
			{
			    type = form
			    form = Sample_Validation_Items
			    record event = on add
			    description = "Records creation of a structured sample validation check in the process audit trail."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                audit_details = "Validation Item ID: " + input.ID + "; Sequence: " + input.Sequence_Number + "; Category: " + input.Check_Category + "; Checkpoint: " + input.Checkpoint + "; Result: " + input.Result + "; Remarks: " + input.Remarks + "; Performed On: " + input.Performed_On;
			                audit_id = insert into Process_Audit_Log
			                [
			                    NPD_Request = input.NPD_Request
			                    Event_Type = "Created"
			                    Action_Name = "Sample Validation Item Added"
			                    Decision = input.Result
			                    Observations = input.Remarks
			                    Performed_By_Email = zoho.loginuserid
			                    Performed_On = zoho.currenttime
			                    Event_Details = audit_details
			                ];
			            )
			        }
			    }
			}

			Audit_Sample_Validation_Item_Edit as "Audit Sample Validation Item Edit"
			{
			    type = form
			    form = Sample_Validation_Items
			    record event = on edit
			    description = "Records changes to a structured sample validation check in the process audit trail."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                audit_details = "Validation Item ID: " + input.ID + "; Sequence: " + input.Sequence_Number + "; Category: " + input.Check_Category + "; Checkpoint: " + input.Checkpoint + "; Result: " + input.Result + "; Remarks: " + input.Remarks + "; Performed On: " + input.Performed_On;
			                audit_id = insert into Process_Audit_Log
			                [
			                    NPD_Request = input.NPD_Request
			                    Event_Type = "Configuration Changed"
			                    Action_Name = "Sample Validation Item Updated"
			                    Decision = input.Result
			                    Observations = input.Remarks
			                    Performed_By_Email = zoho.loginuserid
