	reports
	{
		default list Document_Requirements_Admin
		{
		    displayName = "Document Requirements Admin"
		    show all rows from Document_Requirements
		    (
		        Requirement_Code as "Requirement Code"
		        Requirement_Name as "Requirement"
		        Scope
		        Gate_Route as "Route"
		        Gate_Route_Step as "Step"
		        Mandatory
		        Sort_Order as "Order"
		        Active
		    )
		    filters
		    (
		        Scope
		        Gate_Route
		        Gate_Route_Step
		        Active
		    )
		    group by
		    (
		        Gate_Route ascending
		        Scope ascending
		    )
		    sort by
		    (
		        Sort_Order ascending
		    )
		}

		default list Gate_Route_Steps_Admin
		{
		    displayName = "Gate Route Steps Admin"
		    show all rows from Gate_Route_Steps
		    (
		        Gate_Route as "Route"
		        Gate_Route.Plant as "Plant"
		        Gate_Route.Product_Line as "Product Line"
		        Stage_Gate as "Stage"
		        Sequence_Number as "Sequence"
		        Final_Gate as "Final Gate"
		        Active
		        Instructions
		    )
		    filters
		    (
		        Gate_Route
		        Stage_Gate
		        Active
		    )
		    group by
		    (
		        Gate_Route ascending
		    )
		    sort by
		    (
		        Sequence_Number ascending
		    )
		}

		default list Gate_Routes_Admin
		{
		    displayName = "Gate Routes Admin"
		    show all rows from Gate_Routes
		    (
		        Route_Code
		        Route_Name
		        Plant
		        Product_Line
		        Version_Number
		        Effective_From
		        Effective_To
		        Status
		        Notes
		    )
		    filters
		    (
		        Plant
		        Product_Line
		        Status
		    )
		    group by
		    (
		        Plant ascending
		    )
		    sort by
		    (
		        Effective_From descending
		    )
		}

		default list All_NPD_Requests
		{
		    displayName = "All NPD Requests"
		    show all rows from NPD_Requests
		    (
		        Request_Number
		        Request_Title
		        Request_Owner
		        Plant
		        Product_Line
		        Branch
		        Gate_Route
		        Development_Type
		        Target_Launch_Date
		        Process_Status
		        Current_Stage_Gate
		        Submitted_On
		        Initial_QA_Due_On
		        Mass_Production_Released_On
		        Termination_Reason
		    )
		    filters
		    (
		        Plant
		        Product_Line
		        Branch
		        Process_Status
		        "Overdue Reviews" : (Initial_QA_Due_On < zoho.currentdate && (Process_Status == "Initial QA Review" || Process_Status == "Initial QA Head Approval" || Process_Status == "Final QA Head Approval"))
		    )
		    sort by
		    (
		        Submitted_On descending
		        Request_Number descending
		    )
		    conditional formatting
		    (
		        "Rework"
		        {
		            condition = (Process_Status == "NPD Rework")
		            fields = [Request_Number, Request_Title, Process_Status]
		            format = "background-color:#FFF4D6;color:#8A5A00;font-weight:bold"
		        }
		        "Overdue"
		        {
		            condition = (Initial_QA_Due_On < zoho.currentdate && (Process_Status == "Initial QA Review" || Process_Status == "Initial QA Head Approval" || Process_Status == "Final QA Head Approval"))
		            fields = [Request_Number, Request_Title, Initial_QA_Due_On, Process_Status]
		            format = "background-color:#FDE2E2;color:#A61B1B;font-weight:bold"
		        }
		        "Terminated"
		        {
		            condition = (Process_Status == "Terminated")
		            fields = [Request_Number, Request_Title, Process_Status, Termination_Reason]
		            format = "background-color:#ECEFF3;color:#5B6472"
		        }
		        "Mass Production"
		        {
		            condition = (Process_Status == "Mass Production")
		            fields = [Request_Number, Request_Title, Process_Status, Mass_Production_Released_On]
		            format = "background-color:#DFF3E4;color:#176B34;font-weight:bold"
		        }
		    )
		}

		list Mass_Production_Queue
		{
		    displayName = "Mass Production Queue"
		    show all rows from NPD_Requests [Process_Status == "Mass Production"]
		    (
		        Request_Number
		        Request_Title
		        Request_Owner
		        Plant
		        Product_Line
		        Branch
		        Product_Name
		        Product_Category
		        Development_Type
		        Process_Status
		        Current_Stage_Gate
		        Target_Launch_Date
		        Mass_Production_Released_On
		    )
		    filters
		    (
		        Plant
		        Product_Line
		        Branch
		        Process_Status
		    )
		    sort by
		    (
		        Mass_Production_Released_On descending
		        Request_Number ascending
		    )
		    conditional formatting
		    (
		        "Released"
		        {
		            condition = (Process_Status == "Mass Production")
		            fields = [Request_Number, Request_Title, Process_Status, Mass_Production_Released_On]
		            format = "background-color:#DFF3E4;color:#176B34;font-weight:bold"
		        }
		    )
		}

		list My_NPD_Requests
		{
		    displayName = "My NPD Requests"
		    show all rows from NPD_Requests [Request_Owner == zoho.loginuser]
		    (
		        Request_Number
		        Request_Title
		        Request_Owner
		        Plant
		        Product_Line
		        Branch
		        Process_Status
		        Current_Stage_Gate
		        Target_Launch_Date
		        Initial_QA_Due_On
		        Submitted_On
		    )
		    filters
		    (
		        Plant
		        Product_Line
		        Branch
		        Process_Status
		    )
		    sort by
		    (
		        Submitted_On descending
		        Request_Number descending
		    )
		    conditional formatting
		    (
		        "Rework"
		        {
		            condition = (Process_Status == "NPD Rework")
		            fields = [Request_Number, Request_Title, Process_Status]
		            format = "background-color:#FFF4D6;color:#8A5A00;font-weight:bold"
		        }
		        "Overdue"
		        {
		            condition = (Initial_QA_Due_On < zoho.currentdate && (Process_Status == "Initial QA Review" || Process_Status == "Initial QA Head Approval" || Process_Status == "Final QA Head Approval"))
		            fields = [Request_Number, Initial_QA_Due_On, Process_Status]
		            format = "background-color:#FDE2E2;color:#A61B1B"
		        }
		        "Terminated"
		        {
		            condition = (Process_Status == "Terminated")
		            fields = [Request_Number, Request_Title, Process_Status]
		            format = "background-color:#ECEFF3;color:#5B6472"
		        }
		        "Mass Production"
		        {
		            condition = (Process_Status == "Mass Production")
		            fields = [Request_Number, Request_Title, Process_Status]
		            format = "background-color:#DFF3E4;color:#176B34;font-weight:bold"
		        }
		    )
		}

