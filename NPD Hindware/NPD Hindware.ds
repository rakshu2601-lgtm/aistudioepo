	reports
	{
		report Document_Requirements_Admin
		{
		 quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( Requirement_Code Requirement_Name Scope Mandatory Sort_Order Active ) ) ) menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) ) action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) ) )
		 detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Requirement_Code Requirement_Name Scope Gate_Route Gate_Route_Step Mandatory Sort_Order Active ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
		}
	
		report Gate_Route_Steps_Admin
		{
		 quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( Gate_Route Stage_Gate Sequence_Number Final_Gate Active ) ) ) menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) ) action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) ) )
		 detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Gate_Route Stage_Gate Sequence_Number Final_Gate Active Instructions ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
		}
	
		report Gate_Routes_Admin
		{
		 quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( Route_Code Route_Name Plant Product_Line Status Effective_From ) ) ) menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) ) action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) ) )
		 detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Route_Code Route_Name Plant Product_Line Version_Number Effective_From Effective_To Status Notes ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
		}
	
		report All_NPD_Requests
		{
		 quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( Request_Number Request_Title Plant Product_Line Process_Status Current_Stage_Gate ) ) ) menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) ) action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) ) )
		 detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Request_Number Request_Title Request_Owner Plant Product_Line Branch Gate_Route Development_Type Target_Launch_Date Process_Status Current_Stage_Gate Submitted_On Initial_QA_Due_On Mass_Production_Released_On Termination_Reason ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
		}
	
		report Mass_Production_Queue
		{
