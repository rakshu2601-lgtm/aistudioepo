application "NPD-Hindware"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Document_Requirements
		{
		    displayname = "Document Requirements"
		
		    Requirement_Details
		    (
		        type = section
		        displayname = "Requirement Details"
		        row = 1
		        column = 0
		    )
		    must have unique Requirement_Code
		    (
		        type = text
		        displayname = "Requirement Code"
		        row = 1
		        column = 1
		    )
		    must have Requirement_Name
		    (
		        type = text
		        displayname = "Requirement Name"
		        row = 1
		        column = 1
		    )
		    must have Scope
		    (
		        type = radiobuttons
		        displayname = "Scope"
		        values = {"Initial Request", "Stage Gate"}
		        row = 1
		        column = 1
		    )
		    must have Gate_Route
		    (
		        type = picklist
		        displayname = "Gate Route"
		        values = Gate_Routes.ID
		        displayformat = [Route_Name]
		        searchable = true
		        row = 1
		        column = 1
		    )
		    Gate_Route_Step
		    (
		        type = picklist
		        displayname = "Gate Route Step"
		        values = Gate_Route_Steps.ID
		        displayformat = [Stage_Gate]
		        searchable = true
		        row = 1
		        column = 1
		    )
		    Mandatory
		    (
		        type = checkbox
		        displayname = "Mandatory"
		        initial value = true
		        row = 1
		        column = 1
		    )
		    Instructions
		    (
		        type = textarea
		        displayname = "Instructions"
		        row = 1
		        column = 1
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 1
		    )
		    must have Sort_Order
		    (
		        type = number
		        displayname = "Sort Order"
		        row = 1
		        column = 1
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Requirement"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Requirement"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Gate_Route_Steps
		{
		    displayname = "Gate Route Steps"
		
		    Step_Details
		    (
		        type = section
		        displayname = "Step Details"
		        row = 1
		        column = 0
		    )
		    must have Gate_Route
		    (
		        type = picklist
		        displayname = "Gate Route"
		        values = Gate_Routes.ID
		        displayformat = [Route_Name]
		        searchable = true
		        row = 1
		        column = 1
		    )
		    must have Stage_Gate
		    (
		        type = radiobuttons
		        displayname = "Stage Gate"
		        values = {"N1", "N5", "N10", "N30", "N50"}
		        row = 1
		        column = 1
		    )
		    must have Sequence_Number
		    (
		        type = number
		        displayname = "Sequence Number"
		        row = 1
		        column = 1
		    )
		    Final_Gate
		    (
		        type = checkbox
		        displayname = "Final Gate"
		        initial value = false
		        row = 1
		        column = 1
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 1
		    )
		    Instructions
		    (
		        type = textarea
		        displayname = "Instructions"
		        row = 1
		        column = 1
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Route Step"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Route Step"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Gate_Routes
		{
		    displayname = "Gate Routes"
		
		    Route_Details
		    (
		        type = section
		        displayname = "Route Details"
		        row = 1
		        column = 0
		    )
		    must have unique Route_Code
		    (
		        type = text
		        displayname = "Route Code"
		        row = 1
		        column = 1
		    )
		    must have Route_Name
		    (
		        type = text
		        displayname = "Route Name"
		        row = 1
		        column = 1
		    )
		    must have Plant
		    (
		        type = picklist
		        displayname = "Plant"
		        values = Plants.ID
		        displayformat = [Plant_Name]
		        searchable = true
		        row = 1
		        column = 1
		    )
		    must have Product_Line
		    (
		        type = picklist
		        displayname = "Product Line"
		        values = Product_Lines.ID
		        displayformat = [Product_Line_Name]
		        searchable = true
		        row = 1
		        column = 1
		    )
		    must have Version_Number
		    (
		        type = number
		        displayname = "Version Number"
		        initial value = 1
		        row = 1
		        column = 1
		    )
		    must have Effective_From
		    (
		        type = date
		        displayname = "Effective From"
		        row = 1
		        column = 1
		    )
		    Effective_To
		    (
		        type = date
		        displayname = "Effective To"
		        row = 1
		        column = 1
		    )
		    must have Status
		    (
		        type = radiobuttons
		        displayname = "Status"
		        values = {"Draft", "Active", "Inactive"}
		        initial value = "Draft"
		        layout = 3
		        row = 1
		        column = 1
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        row = 1
		        column = 1
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Route"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Route"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form NPD_Requests
		{
		    displayname = "NPD Requests"
		    record owner = Request_Owner
		
		    Request_Identity
		    (
		        type = section
		        displayname = "Request Identity"
		        row = 1
		        column = 0
		    )
		    Request_Number
		    (
		        type = autonumber
		        displayname = "Request Number"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Request_Title
		    (
		        type = text
		        displayname = "Request Title"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Request_Owner
		    (
		        type = picklist
		        displayname = "Request Owner"
		        module = users
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Plant
		    (
		        type = picklist
		        values = Plants.ID
		        displayformat = [Plant_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Product_Line
		    (
		        type = picklist
		        displayname = "Product Line"
		        values = Product_Lines.ID
		        displayformat = [Product_Line_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Gate_Route
		    (
		        type = picklist
		        displayname = "Gate Route"
		        values = Gate_Routes.ID
		        displayformat = [Route_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Branch
		    (
		        type = text
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Basic_Information
		    (
		        type = section
		        displayname = "Basic Information"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Product_Name
		    (
		        type = text
		        displayname = "Product Name"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Product_Category
		    (
		        type = text
		        displayname = "Product Category"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Development_Type
		    (
		        type = radiobuttons
		        displayname = "Development Type"
		        values = {"New Product", "Product Modification"}
		        layout = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    Customer_or_Market
		    (
		        type = text
		        displayname = "Customer or Market"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Target_Launch_Date
		    (
		        type = date
		        displayname = "Target Launch Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Product_Description
		    (
		        type = textarea
		        displayname = "Product Description"
		        height = 100px
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Business_Justification
		    (
		        type = textarea
		        displayname = "Business Justification"
		        height = 100px
		        row = 2
		        column = 2
		        width = medium
		    )
		
		    Lifecycle
		    (
		        type = section
		        displayname = "Lifecycle and Decisions"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    must have Process_Status
		    (
		        type = picklist
		        displayname = "Process Status"
		        values = {"Draft", "Initial QA Review", "NPD Rework", "Initial QA Head Approval", "Stage Gates In Progress", "Final QA Head Approval", "Mass Production", "Terminated"}
		        initial value = "Draft"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Current_Stage_Gate
		    (
		        type = text
		        displayname = "Current Stage Gate"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Submitted_On
		    (
		        type = datetime
		        displayname = "Submitted On"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Initial_QA_Due_On
		    (
		        type = date
		        displayname = "Current Review Due On"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Initial_QA_Decision
		    (
		        type = radiobuttons
		        displayname = "Initial QA Decision"
		        values = {"Pass", "Not Pass"}
		        layout = 2
		        row = 3
		        column = 1
		        width = medium
		    )
		    Initial_QA_Observations
		    (
		        type = textarea
		        displayname = "Initial QA Observations"
		        height = 100px
		        row = 3
		        column = 1
		        width = medium
		    )
		    Initial_QA_Reviewer
		    (
		        type = picklist
		        displayname = "Initial QA Reviewer"
		        module = users
		        row = 3
		        column = 1
		        width = medium
		    )
		    Initial_QA_Reviewed_On
		    (
		        type = datetime
		        displayname = "Initial QA Reviewed On"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Initial_QA_Head_Decision
		    (
		        type = radiobuttons
		        displayname = "Initial QA Head Decision"
		        values = {"Approved", "Rejected"}
		        layout = 2
		        row = 3
		        column = 2
		        width = medium
		    )
		    Initial_QA_Head_Observations
		    (
		        type = textarea
		        displayname = "Initial QA Head Observations"
		        height = 100px
		        row = 3
		        column = 2
		        width = medium
		    )
		    Initial_QA_Head_User
		    (
		        type = picklist
		        displayname = "Initial QA Head User"
		        module = users
		        row = 3
		        column = 2
		        width = medium
		    )
		    Initial_QA_Head_Decided_On
		    (
		        type = datetime
		        displayname = "Initial QA Head Decided On"
		        row = 3
		        column = 2
		        width = medium
		    )
		    Final_QA_Head_Decision
		    (
		        type = radiobuttons
		        displayname = "Final QA Head Decision"
		        values = {"Approved", "Rejected"}
		        layout = 2
		        row = 3
		        column = 2
		        width = medium
		    )
		    Final_QA_Head_Observations
		    (
		        type = textarea
		        displayname = "Final QA Head Observations"
		        height = 100px
		        row = 3
		        column = 2
		        width = medium
		    )
		    Final_QA_Head_User
		    (
		        type = picklist
		        displayname = "Final QA Head User"
		        module = users
		        row = 3
		        column = 2
		        width = medium
		    )
		    Final_QA_Head_Decided_On
		    (
		        type = datetime
		        displayname = "Final QA Head Decided On"
		        row = 3
		        column = 2
		        width = medium
		    )
		    Mass_Production_Released_On
		    (
		        type = datetime
		        displayname = "Mass Production Released On"
		        row = 3
		        column = 2
		        width = medium
		    )
		    Termination_Reason
		    (
		        type = textarea
		        displayname = "Termination Reason"
		        height = 100px
		        row = 3
		        column = 2
		        width = medium
		    )
		    Escalation_Sent
		    (
		        type = checkbox
		        displayname = "Escalation Sent"
		        initial value = false
		        row = 3
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Draft"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Request"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
		    blueprint components
		    {
		        stages = {"Draft", "Initial QA Review", "NPD Rework", "Initial QA Head Approval", "Stage Gates In Progress", "Final QA Head Approval", "Mass Production", "Terminated"}
		    }
		}

		form Plants
		{
		    Plant_Details
		    (
		        type = section
		        displayname = "Plant Details"
		        row = 1
		        column = 0
		    )
		    must have unique Plant_Code
		    (
		        type = text
		        displayname = "Plant Code"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Plant_Name
		    (
		        type = text
		        displayname = "Plant Name"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Branch
		    (
		        type = radiobuttons
		        displayname = "Branch"
		        values = {"BPD", "CPD"}
		        layout = 2
		        row = 1
		        column = 1
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        initial value = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Plant"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Plant"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Process_Audit_Log
		{
		    displayname = "Process Audit Log"
		
		    Audit_Event
		    (
		        type = section
		        displayname = "Audit Event"
		        row = 1
		        column = 0
		    )
		    NPD_Request
		    (
		        type = picklist
		        displayname = "NPD Request"
		        values = NPD_Requests.ID
		        displayformat = [Request_Title]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Stage_Gate_Instance
		    (
		        type = picklist
		        displayname = "Stage Gate Instance"
		        values = Stage_Gate_Instances.ID
		        displayformat = [Stage_Gate]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Stage_Gate_Submission
		    (
		        type = picklist
		        displayname = "Stage Gate Submission"
		        values = Stage_Gate_Submissions.ID
		        displayformat = [Submission_Number]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Event_Type
		    (
		        type = picklist
		        displayname = "Event Type"
		        values = {"Created", "Submitted", "Passed", "Approved", "Rejected", "Reworked", "Resubmitted", "Document Uploaded", "Escalated", "Released to Mass Production", "Configuration Changed"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Action_Name
		    (
		        type = text
		        displayname = "Action Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    From_Status
		    (
		        type = text
		        displayname = "From Status"
		        row = 1
		        column = 2
		        width = medium
		    )
		    To_Status
		    (
		        type = text
		        displayname = "To Status"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Decision
		    (
		        type = text
		        row = 1
		        column = 2
		        width = medium
		    )
		    Observations
		    (
		        type = textarea
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Performed_By_Email
		    (
		        type = email
		        displayname = "Performed By Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Performed_On
		    (
		        type = datetime
		        displayname = "Performed On"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Event_Details
		    (
		        type = textarea
		        displayname = "Event Details"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Audit Event"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Audit Event"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Process_Settings
		{
		    displayname = "Process Settings"
		
		    Settings_Section
		    (
		        type = section
		        displayname = "Process Configuration"
		        row = 1
		        column = 0
		    )
		    must have unique Configuration_Name
		    (
		        type = text
		        displayname = "Configuration Name"
		        initial value = "Default"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have NPD_Leader_User
		    (
		        type = picklist
		        displayname = "NPD Leader User"
		        module = users
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have QA_Reviewer_User
		    (
		        type = picklist
		        displayname = "QA Reviewer User"
		        module = users
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have QA_Head_User
		    (
		        type = picklist
		        displayname = "QA Head User"
		        module = users
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Sourcing_User
		    (
		        type = picklist
		        displayname = "Sourcing User"
		        module = users
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Section_Head_User
		    (
		        type = picklist
		        displayname = "Section Head User"
		        module = users
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have QA_Review_Manager_Email
		    (
		        type = email
		        displayname = "QA Review Manager Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Section_Head_Manager_Email
		    (
		        type = email
		        displayname = "Section Head Manager Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    QA_Head_Manager_Email
		    (
		        type = email
		        displayname = "QA Head Manager Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Review_SLA_Working_Days
		    (
		        type = number
		        displayname = "Review SLA Working Days"
		        initial value = 7
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Final_Notification_Emails
		    (
		        type = textarea
		        displayname = "Final Notification Emails"
		        description [ type = tooltip  message = "Enter a comma-separated distribution list." ]
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        initial value = true
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Configuration"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Configuration"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Product_Lines
		{
		    displayname = "Product Lines"
		
		    Product_Line_Details
		    (
		        type = section
		        displayname = "Product Line Details"
		        row = 1
		        column = 0
		    )
		    must have unique Product_Line_Code
		    (
		        type = text
		        displayname = "Product Line Code"
		        row = 1
		        column = 1
		    )
		    must have Product_Line_Name
		    (
		        type = text
		        displayname = "Product Line Name"
		        row = 1
		        column = 1
		    )
		    must have Plant
		    (
		        type = picklist
		        displayname = "Plant"
		        values = Plants.ID
		        displayformat = [Plant_Name]
		        searchable = true
		        row = 1
		        column = 1
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 1
