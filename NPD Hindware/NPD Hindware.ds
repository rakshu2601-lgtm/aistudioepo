	menu
	{
	    unused
	    {
	        form NPD_Requests { icon = "business-bulb-61" }
	        form Request_Documents { icon = "files-folder-14" }
	        form Stage_Gate_Instances { icon = "business-progress" }
	        form Stage_Gate_Submissions { icon = "files-upload" }
	        form Submission_Documents { icon = "files-folder-upload" }
	        form Sample_Validation_Items { icon = "files-check" }
	        form Process_Audit_Log { icon = "files-time" }
	        form Process_Settings { icon = "files-settings-99" }
	        form Plants { icon = "business-factory" }
	        form Product_Lines { icon = "business-stock" }
	        form Gate_Routes { icon = "business-strategy" }
	        form Gate_Route_Steps { icon = "business-hierarchy-54" }
	        form Document_Requirements { icon = "files-single-content-03" }
	    }
	
	    space NPD_Quality_Process
	    {
	        displayname = "NPD Quality Process"
	        icon = "business-goal-64"
	
	        section NPD_Workspace
	        {
	            displayname = "NPD Workspace"
	            icon = "business-chart"
	            page NPD_Dashboard { icon = "business-chart-pie-36" }
	            report My_NPD_Requests { icon = "files-folder-user" }
	            report All_NPD_Requests { icon = "files-folder-19" }
	            report NPD_Pipeline { icon = "business-chart-growth" }
	        }
	
	        section Reviews_and_Approvals
	        {
	            displayname = "Reviews and Approvals"
	            icon = "business-signature"
	            report NPD_Approval_Queue { icon = "files-folder-check" }
	            report My_Review_Queue { icon = "files-user" }
	            report Submission_SLA_Calendar { icon = "business-agenda" }
	        }
	
	        section Stage_Gates
	        {
	            displayname = "Stage Gates"
	            icon = "business-hierarchy-54"
	            report Stage_Gate_Tracker { icon = "business-progress" }
	            report Stage_Gate_Board { icon = "business-board-30" }
	            report All_Stage_Gate_Submissions { icon = "files-upload" }
	            report All_Submission_Documents { icon = "files-folder-upload" }
	        }
	
	        section Validation_and_Documents
	        {
	            displayname = "Validation and Documents"
	            icon = "files-folder-check"
	            report All_Request_Documents { icon = "files-folder-14" }
	            report Sample_Validation_Sheet { icon = "files-notebook" }
	        }
	
	        section Outcomes_and_Audit
	        {
	            displayname = "Outcomes and Audit"
	            icon = "business-award-48"
	            report Mass_Production_Queue { icon = "business-factory" }
	            report Process_Audit_Trail { icon = "files-archive-check" }
	            report Process_Timeline { icon = "files-time" }
	        }
	
	        section Administration
	        {
	            displayname = "Administration"
	            icon = "files-settings-99"
	            report Process_Settings_Admin { icon = "files-settings-46" }
	            report All_Plants { icon = "business-building" }
	            report All_Product_Lines { icon = "business-stock" }
	            report Gate_Routes_Admin { icon = "business-strategy" }
	            report Gate_Route_Steps_Admin { icon = "business-hierarchy-53" }
	            report Document_Requirements_Admin { icon = "files-single-content-02" }
	        }
	
	        section SharedAnalytics_Section
	        {
	            type = shared_user_report_section
	            displayname = "Reports"
	            icon = "business-chart-bar-33"
	        }
	    }
	
	    preference
	    {
	        icon
	        {
	            style = outline
	            show = {space,section,component}
	        }
	    }
	}
	customize
	{
	    layout
	    {
	        theme = "theme_2"
	        variant = "variant_2"
	    }
	
	    font = "lato"
	
	    color options
	    {
	        name = "NPD Quality Teal"
	        brand color = "#0F766E"
	        type = "custom"
	        dark mode color = "#2DD4BF"
	    }
	
	    logo
	    {
	        preference = "app_icon"
	        placement = "left"
	    }
	
	    custom css
	    {
	        content = ".zc-app-header { box-shadow: 0 1px 3px rgba(15,23,42,.14); } [data-value='Approved'],[data-value='Mass Production'],[data-value='Completed'] { color:#166534 !important; background:#DCFCE7 !important; } [data-value='QA Review'],[data-value='Section Head Review'],[data-value='Ready for Sourcing'] { color:#1D4ED8 !important; background:#DBEAFE !important; } [data-value='Rework'],[data-value='Overdue'] { color:#9A3412 !important; background:#FFEDD5 !important; } [data-value='Terminated'],[data-value='Rejected'] { color:#991B1B !important; background:#FEE2E2 !important; }"
	    }
	}
	}

