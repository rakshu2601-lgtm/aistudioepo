			                        QA_Decision = "Reject";
			                        QA_Reviewed_By = zoho.loginuser;
			                        QA_Reviewed_On = zoho.currenttime;
			                        next_attempt_number = input.Attempt_Number + 1;
			                        rework_id = insert into Stage_Gate_Submissions
			                        [
			                            Stage_Gate_Instance = input.Stage_Gate_Instance
			                            Attempt_Number = next_attempt_number
			                            Previous_Attempt_Number = input.Attempt_Number
			                            Submission_Status = "Sourcing Rework"
			                            Copied_Observations = input.QA_Observations
			                        ];
			                        instance_record.Gate_Status = "Rework";
			                        instance_record.Latest_Attempt_Number = next_attempt_number;
			                        audit_id = insert into Process_Audit_Log
			                        [
			                            NPD_Request = instance_record.NPD_Request
			                            Stage_Gate_Instance = input.Stage_Gate_Instance
			                            Stage_Gate_Submission = input.ID
			                            Event_Type = "Rejected"
			                            Action_Name = "QA Reject"
			                            From_Status = "QA Review"
			                            To_Status = "Rejected by QA"
			                            Decision = "Reject"
			                            Observations = input.QA_Observations
			                            Performed_By_Email = zoho.loginuserid
			                            Performed_On = zoho.currenttime
			                            Event_Details = "Attempt frozen; rework attempt " + next_attempt_number + " created."
			                        ];
			                        rework_audit_id = insert into Process_Audit_Log
			                        [
			                            NPD_Request = instance_record.NPD_Request
			                            Stage_Gate_Instance = input.Stage_Gate_Instance
			                            Stage_Gate_Submission = rework_id
			                            Event_Type = "Reworked"
			                            Action_Name = "QA Rework Attempt Created"
			                            From_Status = "Rejected by QA"
			                            To_Status = "Sourcing Rework"
			                            Observations = input.QA_Observations
			                            Performed_By_Email = zoho.loginuserid
			                            Performed_On = zoho.currenttime
			                            Event_Details = "New immutable attempt " + next_attempt_number + " created from attempt " + input.Attempt_Number + "."
			                        ];
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : settings.Sourcing_User.email
			                            subject : "Stage gate attempt returned for rework"
			                            message : "Attempt " + input.Attempt_Number + " for " + instance_record.Stage_Gate + " was rejected by QA. Rework attempt " + next_attempt_number + " is ready."
			                        )
			                    )
			                }
			            }
			        }
			
			        Section_Head_Approve as "Section Head Approve"
			        {
			            type = normal
			            from stage = "Section Head Review"
			            to stage = "Approved"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Section Head"}
			                )
			            }
			            during
			            {
			                action = update_fields
			                workflow status = true
			                visible fields = [Section_Head_Decision, Section_Head_Observations]
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        settings = Process_Settings[Active == true];
			                        instance_record = Stage_Gate_Instances[ID == input.Stage_Gate_Instance];
			                        Section_Head_Decision = "Approve";
			                        Section_Head_Decided_By = zoho.loginuser;
			                        Section_Head_Decided_On = zoho.currenttime;
			                        instance_record.Gate_Status = "Approved";
			                        instance_record.Completed_On = zoho.currenttime;
			                        instance_record.Latest_Attempt_Number = input.Attempt_Number;
			                        request_record = NPD_Requests[ID == instance_record.NPD_Request];
			                        audit_id = insert into Process_Audit_Log
			                        [
			                            NPD_Request = instance_record.NPD_Request
			                            Stage_Gate_Instance = input.Stage_Gate_Instance
			                            Stage_Gate_Submission = input.ID
			                            Event_Type = "Approved"
			                            Action_Name = "Section Head Approve"
			                            From_Status = "Section Head Review"
			                            To_Status = "Approved"
			                            Decision = "Approve"
			                            Observations = input.Section_Head_Observations
			                            Performed_By_Email = zoho.loginuserid
			                            Performed_On = zoho.currenttime
			                            Event_Details = "Stage gate attempt " + input.Attempt_Number + " approved."
			                        ];
			                        if(instance_record.Final_Gate == false)
			                        {
			                            next_instance = Stage_Gate_Instances[NPD_Request == instance_record.NPD_Request && Sequence_Number == instance_record.Sequence_Number + 1 && Gate_Status == "Locked"];
			                            if(next_instance.count(ID) == 1)
			                            {
			                                next_submission_id = insert into Stage_Gate_Submissions
			                                [
			                                    Stage_Gate_Instance = next_instance.ID
			                                    Attempt_Number = 1
			                                    Submission_Status = "Sourcing Draft"
			                                ];
			                                next_instance.Gate_Status = "Ready for Sourcing";
			                                next_instance.Activated_On = zoho.currenttime;
			                                next_instance.Latest_Attempt_Number = 1;
			                                request_record.Current_Stage_Gate = next_instance.Stage_Gate;
			                                sendmail
			                                (
			                                    from : zoho.adminuserid
			                                    to : settings.Sourcing_User.email
			                                    subject : "Next stage gate ready for sourcing"
			                                    message : next_instance.Stage_Gate + " is now active and attempt 1 is ready for sourcing."
			                                )
			                            }
			                        }
			                        else
			                        {
			                            request_record.Process_Status = "Final QA Head Approval";
			                            request_record.Current_Stage_Gate = instance_record.Stage_Gate;
			                            request_record.Initial_QA_Due_On = zoho.currentdate.addBusinessDay(settings.Review_SLA_Working_Days);
			                            request_record.Escalation_Sent = false;
			                            sendmail
			                            (
			                                from : zoho.adminuserid
			                                to : settings.QA_Head_User.email
			                                subject : "Final stage gate approved"
			                                message : instance_record.Stage_Gate + " is approved and the request is ready for final QA Head approval."
			                            )
			                        }
			                    )
			                }
			            }
			        }
			
			        Section_Head_Reject as "Section Head Reject"
			        {
			            type = normal
			            from stage = "Section Head Review"
			            to stage = "Rejected by Section Head"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Section Head"}
			                )
			            }
			            during
			            {
			                action = update_fields
			                workflow status = true
			                visible fields = [Section_Head_Decision, Section_Head_Observations]
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        settings = Process_Settings[Active == true];
			                        instance_record = Stage_Gate_Instances[ID == input.Stage_Gate_Instance];
			                        Section_Head_Decision = "Reject";
			                        Section_Head_Decided_By = zoho.loginuser;
			                        Section_Head_Decided_On = zoho.currenttime;
			                        next_attempt_number = input.Attempt_Number + 1;
			                        rework_id = insert into Stage_Gate_Submissions
			                        [
			                            Stage_Gate_Instance = input.Stage_Gate_Instance
			                            Attempt_Number = next_attempt_number
			                            Previous_Attempt_Number = input.Attempt_Number
			                            Submission_Status = "Sourcing Rework"
			                            Copied_Observations = input.Section_Head_Observations
			                        ];
			                        instance_record.Gate_Status = "Rework";
			                        instance_record.Latest_Attempt_Number = next_attempt_number;
			                        audit_id = insert into Process_Audit_Log
			                        [
			                            NPD_Request = instance_record.NPD_Request
			                            Stage_Gate_Instance = input.Stage_Gate_Instance
			                            Stage_Gate_Submission = input.ID
			                            Event_Type = "Rejected"
			                            Action_Name = "Section Head Reject"
			                            From_Status = "Section Head Review"
			                            To_Status = "Rejected by Section Head"
			                            Decision = "Reject"
			                            Observations = input.Section_Head_Observations
			                            Performed_By_Email = zoho.loginuserid
			                            Performed_On = zoho.currenttime
			                            Event_Details = "Attempt frozen; rework attempt " + next_attempt_number + " created."
			                        ];
			                        rework_audit_id = insert into Process_Audit_Log
			                        [
			                            NPD_Request = instance_record.NPD_Request
			                            Stage_Gate_Instance = input.Stage_Gate_Instance
			                            Stage_Gate_Submission = rework_id
			                            Event_Type = "Reworked"
			                            Action_Name = "Section Head Rework Attempt Created"
			                            From_Status = "Rejected by Section Head"
			                            To_Status = "Sourcing Rework"
			                            Observations = input.Section_Head_Observations
			                            Performed_By_Email = zoho.loginuserid
			                            Performed_On = zoho.currenttime
			                            Event_Details = "New immutable attempt " + next_attempt_number + " created from attempt " + input.Attempt_Number + "."
			                        ];
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : settings.Sourcing_User.email
			                            subject : "Stage gate attempt returned by Section Head"
			                            message : "Attempt " + input.Attempt_Number + " for " + instance_record.Stage_Gate + " was rejected. Rework attempt " + next_attempt_number + " is ready."
			                        )
			                    )
			                }
			            }
			        }
			    }
			}

			Stage_Gate_Submission_SLA as "Stage Gate Submission SLA"
			{
			    type = schedule
			    form = Stage_Gate_Submissions[Applicable_Due_On != null && Applicable_Due_On < zoho.currentdate && (Submission_Status == "QA Review" || Submission_Status == "Section Head Review")]
			    start = Applicable_Due_On at "09:00:00"
			    frequency = daily
			    time zone = "Asia/Kolkata"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                settings = Process_Settings[Active == true];
			                if(settings.count(ID) == 1)
			                {
			                    recipient_email = settings.QA_Reviewer_User.email;
			                    manager_email = settings.QA_Review_Manager_Email;
			                    due_date = input.QA_Due_On;
			                    escalation_sent = input.QA_Escalation_Sent;
			                    if(input.Submission_Status == "Section Head Review")
			                    {
			                        recipient_email = settings.Section_Head_User.email;
			                        manager_email = settings.Section_Head_Manager_Email;
			                        due_date = input.Section_Head_Due_On;
			                        escalation_sent = input.Section_Escalation_Sent;
			                    }
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : recipient_email
			                        subject : "Overdue stage gate review: attempt " + input.Attempt_Number
			                        message : "Submission " + input.Submission_Number + " remains in " + input.Submission_Status + ". Due date: " + due_date + "."
			                    )
			                    overdue_working_days = due_date.workDaysBetween(zoho.currentdate);
			                    if(escalation_sent == false && overdue_working_days > 0 && manager_email != null)
			                    {
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : manager_email
			                            cc : recipient_email
			                            subject : "Escalation: stage gate SLA exceeded for attempt " + input.Attempt_Number
			                            message : "Submission " + input.Submission_Number + " has exceeded the configured " + settings.Review_SLA_Working_Days + "-working-day SLA in " + input.Submission_Status + "."
			                        )
			                        if(input.Submission_Status == "QA Review")
			                        {
			                            input.QA_Escalation_Sent = true;
			                        }
			                        else
			                        {
			                            input.Section_Escalation_Sent = true;
			                        }
			                        instance_record = Stage_Gate_Instances[ID == input.Stage_Gate_Instance];
			                        audit_id = insert into Process_Audit_Log
			                        [
			                            NPD_Request = instance_record.NPD_Request
			                            Stage_Gate_Instance = input.Stage_Gate_Instance
			                            Stage_Gate_Submission = input.ID
			                            Event_Type = "Escalated"
			                            Action_Name = "Stage Gate Review SLA Escalation"
			                            From_Status = input.Submission_Status
			                            To_Status = input.Submission_Status
			                            Performed_By_Email = zoho.adminuserid
			                            Performed_On = zoho.currenttime
			                            Event_Details = "One-time manager escalation sent after the configured SLA was exceeded."
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

			Validate_New_Stage_Gate_Submission as "Validate New Stage Gate Submission"
			{
			    type = form
			    form = Stage_Gate_Submissions
			    record event = on add
			    description = "Prevents manual attempt creation; attempts are created only by controlled instance activation and rejection automation."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                alert "Stage gate attempts are system-created and cannot be added manually.";
			                cancel submit;
			            )
			        }
			    }
			}

			Validate_Stage_Gate_Submission as "Validate Stage Gate Submission"
			{
			    type = form
			    form = Stage_Gate_Submissions
			    record event = on edit
			    description = "Enforces fixed actors, immutable terminal attempts, unique attempt numbers, required current-attempt documents, and decision evidence."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                validation_failed = false;
			                settings = Process_Settings[Active == true];
			                if(settings.count(ID) != 1)
			                {
			                    alert "Exactly one Active Process Settings record is required.";
			                    validation_failed = true;
			                }
			                else
			                {
			                    actor_email = zoho.loginuserid.toLowerCase();
			                    duplicate_attempts = Stage_Gate_Submissions[Stage_Gate_Instance == input.Stage_Gate_Instance && Attempt_Number == input.Attempt_Number && ID != input.ID].count(ID);
			                    if(duplicate_attempts > 0)
			                    {
			                        alert(Attempt_Number, "Attempt Number must be unique within the Stage Gate Instance.");
			                        validation_failed = true;
			                    }
			                    if(input.Attempt_Number <= 0)
			                    {
			                        alert(Attempt_Number, "Attempt Number must be greater than zero.");
			                        validation_failed = true;
			                    }
			                    if(old.Submission_Status == "Rejected by QA" || old.Submission_Status == "Rejected by Section Head" || old.Submission_Status == "Approved")
			                    {
			                        alert "Rejected and approved attempts are immutable historical records.";
			                        validation_failed = true;
			                    }
			
			                    protected_change = input.Stage_Gate_Instance != old.Stage_Gate_Instance || input.Attempt_Number != old.Attempt_Number || input.Previous_Attempt_Number != old.Previous_Attempt_Number || input.Copied_Observations != old.Copied_Observations || input.Applicable_Due_On != old.Applicable_Due_On || input.Sourcing_Submitted_By != old.Sourcing_Submitted_By || input.Sourcing_Submitted_On != old.Sourcing_Submitted_On || input.QA_Reviewed_By != old.QA_Reviewed_By || input.QA_Reviewed_On != old.QA_Reviewed_On || input.QA_Due_On != old.QA_Due_On || input.QA_Escalation_Sent != old.QA_Escalation_Sent || input.Section_Head_Decided_By != old.Section_Head_Decided_By || input.Section_Head_Decided_On != old.Section_Head_Decided_On || input.Section_Head_Due_On != old.Section_Head_Due_On || input.Section_Escalation_Sent != old.Section_Escalation_Sent;
			                    if(input.Submission_Status == old.Submission_Status && protected_change)
			                    {
			                        alert "Identity, copied observations, actor, timestamp, SLA, and escalation fields are system maintained.";
			                        validation_failed = true;
			                    }
			
			                    if(input.Submission_Status != old.Submission_Status)
			                    {
			                        if((old.Submission_Status == "Sourcing Draft" || old.Submission_Status == "Sourcing Rework") && input.Submission_Status == "QA Review")
			                        {
			                            if(actor_email != settings.Sourcing_User.email.toLowerCase())
			                            {
			                                alert "Only the configured Sourcing user may submit this attempt to QA.";
			                                validation_failed = true;
			                            }
			                            if(ifnull(input.Sourcing_Comments, "").trim().isEmpty())
			                            {
			                                alert(Sourcing_Comments, "Sourcing comments are required when submitting.");
			                                validation_failed = true;
			                            }
			                            if(old.Submission_Status == "Sourcing Rework" && ifnull(input.Response_to_Observations, "").trim().isEmpty())
			                            {
			                                alert(Response_to_Observations, "A response to the copied observations is required for rework.");
			                                validation_failed = true;
			                            }
			                            instance_record = Stage_Gate_Instances[ID == input.Stage_Gate_Instance];
			                            mandatory_requirements = Document_Requirements[Scope == "Stage Gate" && Gate_Route_Step == instance_record.Gate_Route_Step && Mandatory == true && Active == true];
			                            for each requirement_record in mandatory_requirements
			                            {
			                                matching_document_count = Submission_Documents[Stage_Gate_Submission == input.ID && Document_Category == "Sourcing Supporting Document" && Document_Requirement == requirement_record.ID].count(ID);
			                                if(matching_document_count == 0)
			                                {
			                                    alert "Upload a current-attempt document for every active mandatory requirement of this route step.";
			                                    validation_failed = true;
			                                }
			                            }
			                        }
			                        else if(old.Submission_Status == "QA Review" && (input.Submission_Status == "Section Head Review" || input.Submission_Status == "Rejected by QA"))
			                        {
			                            if(actor_email != settings.QA_Reviewer_User.email.toLowerCase())
			                            {
			                                alert "Only the configured QA Reviewer may complete QA review.";
			                                validation_failed = true;
			                            }
			                            qa_observations = ifnull(input.QA_Observations, "").trim();
			                            if(input.Submission_Status == "Rejected by QA" && qa_observations.isEmpty())
			                            {
			                                alert(QA_Observations, "QA observations are required when rejecting.");
			                                validation_failed = true;
			                            }
			                            if(input.Submission_Status == "Section Head Review")
			                            {
			                                qa_report_count = Submission_Documents[Stage_Gate_Submission == input.ID && Document_Category == "QA Validation Report"].count(ID);
			                                if(qa_report_count == 0)
			                                {
			                                    alert "Upload at least one QA Validation Report for this attempt before passing it.";
			                                    validation_failed = true;
			                                }
			                                if(qa_observations.toLowerCase() != "no observation" && qa_observations.length() < 10)
			                                {
			                                    alert(QA_Observations, "Enter No Observation or substantive QA observations.");
			                                    validation_failed = true;
			                                }
			                            }
			                        }
			                        else if(old.Submission_Status == "Section Head Review" && (input.Submission_Status == "Approved" || input.Submission_Status == "Rejected by Section Head"))
			                        {
			                            if(actor_email != settings.Section_Head_User.email.toLowerCase())
			                            {
			                                alert "Only the configured Section Head may decide this attempt.";
			                                validation_failed = true;
			                            }
			                            if(input.Submission_Status == "Rejected by Section Head" && ifnull(input.Section_Head_Observations, "").trim().isEmpty())
			                            {
			                                alert(Section_Head_Observations, "Section Head observations are required when rejecting.");
			                                validation_failed = true;
			                            }
			                        }
			                        else
			                        {
			                            alert "This status change is not an allowed stage-gate handoff.";
			                            validation_failed = true;
			                        }
			                    }
			                    else
			                    {
			                        if((old.Submission_Status == "Sourcing Draft" || old.Submission_Status == "Sourcing Rework") && actor_email != settings.Sourcing_User.email.toLowerCase())
			                        {
			                            alert "Only the configured Sourcing user may edit this attempt.";
			                            validation_failed = true;
			                        }
			                        else if(old.Submission_Status == "QA Review" && actor_email != settings.QA_Reviewer_User.email.toLowerCase())
			                        {
			                            alert "Only the configured QA Reviewer may edit this review.";
			                            validation_failed = true;
			                        }
			                        else if(old.Submission_Status == "Section Head Review" && actor_email != settings.Section_Head_User.email.toLowerCase())
			                        {
			                            alert "Only the configured Section Head may edit this review.";
			                            validation_failed = true;
			                        }
			                    }
			                }
			                if(validation_failed)
			                {
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Audit_Submission_Document_Add as "Audit Submission Document Add"
			{
			    type = form
			    form = Submission_Documents
			    record event = on add
			    description = "Audits a Sourcing support document or QA validation report upload against its exact attempt."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                audit_details = "Submission Document ID: " + input.ID + "; Attempt: " + input.Attempt_Number + "; Gate: " + input.Stage_Gate + "; Category: " + input.Document_Category + "; Requirement ID: " + input.Document_Requirement + "; Document: " + input.Document_Name;
			                audit_id = insert into Process_Audit_Log
			                [
			                    NPD_Request = input.NPD_Request
			                    Stage_Gate_Instance = Stage_Gate_Submissions[ID == input.Stage_Gate_Submission].Stage_Gate_Instance
			                    Stage_Gate_Submission = input.Stage_Gate_Submission
			                    Event_Type = "Document Uploaded"
			                    Action_Name = input.Document_Category + " Uploaded"
			                    Observations = input.Remarks
			                    Performed_By_Email = zoho.loginuserid
			                    Performed_On = zoho.currenttime
			                    Event_Details = audit_details
			                ];
			            )
			        }
			    }
			}

			Audit_Submission_Document_Edit as "Audit Submission Document Edit"
			{
			    type = form
			    form = Submission_Documents
			    record event = on edit
			    description = "Audits an allowed remarks update while preserving the original attempt document."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                audit_details = "Submission Document ID: " + input.ID + "; Attempt: " + input.Attempt_Number + "; Gate: " + input.Stage_Gate + "; Category: " + input.Document_Category + "; Document: " + input.Document_Name + "; Remarks updated without replacing the uploaded file.";
			                audit_id = insert into Process_Audit_Log
			                [
			                    NPD_Request = input.NPD_Request
			                    Stage_Gate_Instance = Stage_Gate_Submissions[ID == input.Stage_Gate_Submission].Stage_Gate_Instance
			                    Stage_Gate_Submission = input.Stage_Gate_Submission
			                    Event_Type = "Document Uploaded"
			                    Action_Name = "Submission Document Remarks Updated"
			                    Observations = input.Remarks
			                    Performed_By_Email = zoho.loginuserid
			                    Performed_On = zoho.currenttime
			                    Event_Details = audit_details
			                ];
			            )
			        }
			    }
			}

			Category_Input_Submission_Document as "Category Input Submission Document"
			{
			    type = form
			    form = Submission_Documents
			    record event = on add or edit
			    description = "Shows the configured requirement only for Sourcing supporting documents."
			
			    on user input of Document_Category
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Document_Category == "Sourcing Supporting Document")
			                {
			                    show Document_Requirement;
			                    clear Document_Requirement;
			                    if(input.Stage_Gate_Submission != null)
			                    {
			                        submission_record = Stage_Gate_Submissions[ID == input.Stage_Gate_Submission];
			                        instance_record = Stage_Gate_Instances[ID == submission_record.Stage_Gate_Instance];
			                        allowed_requirements = Document_Requirements[Active == true && Scope == "Stage Gate" && Gate_Route_Step == instance_record.Gate_Route_Step] sort by Sort_Order;
			                        Document_Requirement:ui.add(allowed_requirements.ID.getall());
			                    }
			                }
			                else
			                {
			                    input.Document_Requirement = null;
			                    hide Document_Requirement;
			                }
			            )
			        }
			    }
			}

			Load_Submission_Document as "Load Submission Document"
			{
			    type = form
			    form = Submission_Documents
			    record event = on add or edit
			    description = "Filters stage-gate requirements, controls category-specific visibility, and protects upload metadata."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                hide NPD_Request, Stage_Gate, Attempt_Number;
			                disable Uploaded_By, Uploaded_On, NPD_Request, Stage_Gate, Attempt_Number;
			                clear Document_Requirement;
			                if(input.Stage_Gate_Submission != null)
			                {
			                    submission_record = Stage_Gate_Submissions[ID == input.Stage_Gate_Submission];
			                    instance_record = Stage_Gate_Instances[ID == submission_record.Stage_Gate_Instance];
			                    allowed_requirements = Document_Requirements[Active == true && Scope == "Stage Gate" && Gate_Route_Step == instance_record.Gate_Route_Step] sort by Sort_Order;
			                    Document_Requirement:ui.add(allowed_requirements.ID.getall());
			                }
			                if(input.ID == null)
			                {
			                    input.Uploaded_By = zoho.loginuser;
			                    input.Uploaded_On = zoho.currenttime;
			                }
			                else
			                {
			                    disable Stage_Gate_Submission, Document_Category, Document_Requirement, Document_Name, Document_File;
			                }
			                if(input.Document_Category == "Sourcing Supporting Document")
			                {
			                    show Document_Requirement;
			                }
			                else
			                {
			                    hide Document_Requirement;
			                }
			            )
			        }
			    }
			}

			Submission_Input_Submission_Document as "Submission Input Submission Document"
			{
			    type = form
			    form = Submission_Documents
			    record event = on add
			    description = "Refreshes active stage-gate requirements for the selected submission attempt."
			
			    on user input of Stage_Gate_Submission
			    {
			        actions
			        {
			            custom deluge script
			            (
			                clear Document_Requirement;
			                input.Document_Requirement = null;
			                if(input.Stage_Gate_Submission != null)
			                {
			                    submission_record = Stage_Gate_Submissions[ID == input.Stage_Gate_Submission];
			                    instance_record = Stage_Gate_Instances[ID == submission_record.Stage_Gate_Instance];
			                    allowed_requirements = Document_Requirements[Active == true && Scope == "Stage Gate" && Gate_Route_Step == instance_record.Gate_Route_Step] sort by Sort_Order;
			                    Document_Requirement:ui.add(allowed_requirements.ID.getall());
			                }
			            )
			        }
			    }
			}

			Validate_Submission_Document as "Validate Submission Document"
			{
			    type = form
			    form = Submission_Documents
			    record event = on add or edit
			    description = "Restricts immutable attempt documents to the configured Sourcing or QA actor in the matching attempt state."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                validation_failed = false;
			                settings_count = Process_Settings[Active == true].count(ID);
			                if(settings_count != 1)
			                {
			                    alert "Exactly one active process settings record is required before uploading submission documents.";
			                    validation_failed = true;
			                }
			                else
			                {
			                    active_settings = Process_Settings[Active == true];
			                }
			
			                submission_count = Stage_Gate_Submissions[ID == input.Stage_Gate_Submission].count(ID);
			                if(submission_count == 0)
			                {
			                    alert(Stage_Gate_Submission, "Select a valid stage-gate submission attempt.");
			                    validation_failed = true;
			                }
			                else
			                {
			                    submission_record = Stage_Gate_Submissions[ID == input.Stage_Gate_Submission];
			                    instance_count = Stage_Gate_Instances[ID == submission_record.Stage_Gate_Instance].count(ID);
			                    if(instance_count == 0)
			                    {
			                        alert "The submission is not linked to a valid stage-gate instance.";
			                        validation_failed = true;
			                    }
			                    else
			                    {
			                        instance_record = Stage_Gate_Instances[ID == submission_record.Stage_Gate_Instance];
			                        input.NPD_Request = instance_record.NPD_Request;
			                        input.Stage_Gate = instance_record.Stage_Gate;
			                        input.Attempt_Number = submission_record.Attempt_Number;
			
			                        if(input.Document_Category == "Sourcing Supporting Document")
			                        {
			                            if(input.Document_Requirement == null)
			                            {
			                                alert(Document_Requirement, "A configured document requirement is required for a Sourcing supporting document.");
			                                validation_failed = true;
			                            }
			                            else
			                            {
			                                requirement_count = Document_Requirements[ID == input.Document_Requirement && Active == true && Scope == "Stage Gate" && Gate_Route_Step == instance_record.Gate_Route_Step].count(ID);
			                                if(requirement_count == 0)
			                                {
			                                    alert(Document_Requirement, "Select an active Stage Gate requirement configured for this submission route step.");
			                                    validation_failed = true;
			                                }
			                            }
			                            if(submission_record.Submission_Status != "Sourcing Draft" && submission_record.Submission_Status != "Sourcing Rework")
			                            {
			                                alert "Sourcing documents may be added or changed only while this attempt is in Sourcing Draft or Sourcing Rework.";
			                                validation_failed = true;
			                            }
			                            if(settings_count == 1 && active_settings.Sourcing_User.email.toLowerCase() != zoho.loginuserid.toLowerCase())
			                            {
			                                alert "Only the configured Sourcing user may maintain Sourcing supporting documents.";
			                                validation_failed = true;
			                            }
			                        }
			                        else if(input.Document_Category == "QA Validation Report")
			                        {
			                            if(input.Document_Requirement != null)
			                            {
			                                alert(Document_Requirement, "Document Requirement must be blank for a QA Validation Report.");
			                                validation_failed = true;
			                            }
			                            if(submission_record.Submission_Status != "QA Review")
			                            {
			                                alert "QA Validation Reports may be added or changed only while this attempt is in QA Review.";
			                                validation_failed = true;
			                            }
			                            if(settings_count == 1 && active_settings.QA_Reviewer_User.email.toLowerCase() != zoho.loginuserid.toLowerCase())
			                            {
			                                alert "Only the configured QA Reviewer may maintain QA Validation Reports.";
			                                validation_failed = true;
			                            }
			                        }
			                    }
			                }
			
			                if(input.ID == null)
			                {
			                    input.Uploaded_By = zoho.loginuser;
			                    input.Uploaded_On = zoho.currenttime;
			                }
			                else
			                {
			                    existing_document = Submission_Documents[ID == input.ID];
			                    if(input.Stage_Gate_Submission != existing_document.Stage_Gate_Submission || input.Document_Category != existing_document.Document_Category || input.Document_Requirement != existing_document.Document_Requirement || input.Document_Name != existing_document.Document_Name || input.Document_File != existing_document.Document_File || input.Uploaded_By != existing_document.Uploaded_By || input.Uploaded_On != existing_document.Uploaded_On || input.NPD_Request != existing_document.NPD_Request || input.Stage_Gate != existing_document.Stage_Gate || input.Attempt_Number != existing_document.Attempt_Number)
			                    {
			                        alert "Uploaded document rows are immutable. Add another row during the allowed actor state; only Remarks may be edited on this row.";
			                        validation_failed = true;
			                    }
			                }
			
			                if(validation_failed)
			                {
			                    cancel submit;
			                }
			            )
			        }
			    }
			}
		}
	}

