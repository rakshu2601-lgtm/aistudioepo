	pages
	{
		page NPD_Dashboard
		{
					displayname = "NPD Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<panel elementName='NPD_Dashboard_Panel'>\n\t\t\t\t\t<pr>\n\t\t\t\t\t\t<pc width='100%'>\n\t\t\t\t\t\t\t<text type='Text' value='NPD Dashboard' size='24px' bold='true'> </text>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n\t\t\t\t</panel>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Audit_Document_Requirement as "Audit Document Requirement"
			{
			    type = form
			    form = Document_Requirements
			    record event = on add or edit
			    description = "Records document requirement configuration changes in the process audit log"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                audit_details = "Requirement Code: " + input.Requirement_Code + "; Requirement Name: " + input.Requirement_Name + "; Scope: " + input.Scope + "; Gate Route ID: " + input.Gate_Route + "; Gate Route Step ID: " + input.Gate_Route_Step + "; Mandatory: " + input.Mandatory + "; Active: " + input.Active + "; Sort Order: " + input.Sort_Order;
			                audit_id = insert into Process_Audit_Log
			                [
			                    Event_Type = "Configuration Changed"
			                    Action_Name = "Document Requirement Saved"
			                    Performed_By_Email = zoho.loginuserid
			                    Performed_On = zoho.currenttime
			                    Event_Details = audit_details
			                ];
			            )
			        }
			    }
			}

			Gate_Route_Input_Document_Requirement as "Gate Route Input Document Requirement"
			{
			    type = form
			    form = Document_Requirements
			    record event = on add or edit
			    description = "Filters route-step choices to steps belonging to the selected route"
			
			    on user input of Gate_Route
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Gate_Route_Step = null;
			                clear Gate_Route_Step;
			                if(input.Gate_Route != null)
			                {
			                    route_steps = Gate_Route_Steps[Gate_Route == input.Gate_Route] sort by Sequence_Number;
			                    Gate_Route_Step:ui.add(route_steps.ID.getall());
			                }
			            )
			        }
			    }
			}

			Load_Document_Requirement as "Load Document Requirement"
			{
			    type = form
			    form = Document_Requirements
			    record event = on add or edit
			    description = "Shows and filters the route step only for stage-gate requirements"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                clear Gate_Route_Step;
			                if(input.Gate_Route != null)
			                {
			                    route_steps = Gate_Route_Steps[Gate_Route == input.Gate_Route] sort by Sequence_Number;
			                    Gate_Route_Step:ui.add(route_steps.ID.getall());
			                }
			                if(input.Scope == "Stage Gate")
			                {
			                    show Gate_Route_Step;
			                    enable Gate_Route_Step;
			                }
			                else
			                {
			                    hide Gate_Route_Step;
			                    disable Gate_Route_Step;
			                }
			            )
			        }
			    }
			}

			Scope_Input_Document_Requirement as "Scope Input Document Requirement"
			{
			    type = form
			    form = Document_Requirements
			    record event = on add or edit
			    description = "Toggles the route-step lookup according to requirement scope"
			
			    on user input of Scope
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Scope == "Stage Gate")
			                {
			                    clear Gate_Route_Step;
			                    if(input.Gate_Route != null)
			                    {
			                        route_steps = Gate_Route_Steps[Gate_Route == input.Gate_Route] sort by Sequence_Number;
			                        Gate_Route_Step:ui.add(route_steps.ID.getall());
			                    }
			                    show Gate_Route_Step;
			                    enable Gate_Route_Step;
			                }
			                else
			                {
			                    input.Gate_Route_Step = null;
			                    clear Gate_Route_Step;
			                    hide Gate_Route_Step;
			                    disable Gate_Route_Step;
			                }
			            )
			        }
			    }
			}

			Validate_Document_Requirement as "Validate Document Requirement"
			{
			    type = form
			    form = Document_Requirements
			    record event = on add or edit
			    description = "Validates scope, route-step ownership, positive ordering, and active requirement uniqueness"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                validation_failed = false;
			                scope_step_valid = true;
			
			                if(input.Scope == "Stage Gate")
			                {
			                    if(input.Gate_Route_Step == null)
			                    {
			                        alert(Gate_Route_Step, "Select a route step for a Stage Gate requirement.");
			                        validation_failed = true;
			                        scope_step_valid = false;
			                    }
			                    else
			                    {
			                        matching_step_count = Gate_Route_Steps[ID == input.Gate_Route_Step && Gate_Route == input.Gate_Route].count(ID);
			                        if(matching_step_count == 0)
			                        {
			                            alert(Gate_Route_Step, "The selected route step does not belong to the selected route.");
			                            validation_failed = true;
			                            scope_step_valid = false;
			                        }
			                    }
			                }
			                else if(input.Scope == "Initial Request" && input.Gate_Route_Step != null)
			                {
			                    alert(Gate_Route_Step, "Route step must be blank for an Initial Request requirement.");
			                    validation_failed = true;
			                    scope_step_valid = false;
			                }
			
			                if(input.Sort_Order != null && input.Sort_Order <= 0)
			                {
			                    alert(Sort_Order, "Sort Order must be greater than zero.");
			                    validation_failed = true;
			                }
			
			                if(input.Active == true && input.Gate_Route != null && input.Scope != null && scope_step_valid == true)
			                {
			                    duplicate_name_count = 0;
			                    duplicate_order_count = 0;
			                    if(input.Scope == "Initial Request")
			                    {
			                        duplicate_name_count = Document_Requirements[ID != input.ID && Active == true && Gate_Route == input.Gate_Route && Scope == input.Scope && Gate_Route_Step == null && Requirement_Name == input.Requirement_Name].count(ID);
			                        duplicate_order_count = Document_Requirements[ID != input.ID && Active == true && Gate_Route == input.Gate_Route && Scope == input.Scope && Gate_Route_Step == null && Sort_Order == input.Sort_Order].count(ID);
			                    }
			                    else
			                    {
			                        duplicate_name_count = Document_Requirements[ID != input.ID && Active == true && Gate_Route == input.Gate_Route && Scope == input.Scope && Gate_Route_Step == input.Gate_Route_Step && Requirement_Name == input.Requirement_Name].count(ID);
			                        duplicate_order_count = Document_Requirements[ID != input.ID && Active == true && Gate_Route == input.Gate_Route && Scope == input.Scope && Gate_Route_Step == input.Gate_Route_Step && Sort_Order == input.Sort_Order].count(ID);
			                    }
			                    if(duplicate_name_count > 0)
			                    {
			                        alert(Requirement_Name, "An active requirement with this name already exists for the same route, scope, and step.");
			                        validation_failed = true;
			                    }
			                    if(duplicate_order_count > 0)
			                    {
			                        alert(Sort_Order, "An active requirement with this order already exists for the same route, scope, and step.");
			                        validation_failed = true;
			                    }
			                }
			
			                if(validation_failed == true)
			                {
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Audit_Gate_Route_Step_Changes as "Audit Gate Route Step Changes"
			{
			    type = form
			    form = Gate_Route_Steps
			    record event = on add or edit
			    description = "Records successful gate route step configuration changes in the process audit trail."
			
			    on success
