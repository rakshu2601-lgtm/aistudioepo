			Load_Sample_Validation_Item as "Load Sample Validation Item"
			{
			    type = form
			    form = Sample_Validation_Items
			    record event = on add or edit
			    description = "Initializes the performing user for new sample validation items."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.ID == null && input.Performed_By == null)
			                {
			                    input.Performed_By = zoho.loginuser;
			                }
			            )
			        }
			    }
			}

			Validate_Sample_Validation_Item as "Validate Sample Validation Item"
			{
			    type = form
			    form = Sample_Validation_Items
			    record event = on add or edit
			    description = "Validates sequence, outcome remarks, request ownership and state, and the configured NPD leader."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                validation_failed = false;
			
			                if(input.Sequence_Number == null || input.Sequence_Number <= 0)
			                {
			                    alert(Sequence_Number, "Sequence Number must be greater than zero.");
			                    validation_failed = true;
			                }
			
			                if(input.NPD_Request != null)
			                {
			                    duplicate_sequence_count = Sample_Validation_Items[NPD_Request == input.NPD_Request && Sequence_Number == input.Sequence_Number && ID != input.ID].count(ID);
			                    if(duplicate_sequence_count > 0)
			                    {
			                        alert(Sequence_Number, "This sequence number already exists for the selected NPD request.");
			                        validation_failed = true;
			                    }
			
			                    request_count = NPD_Requests[ID == input.NPD_Request].count(ID);
			                    if(request_count == 0)
			                    {
			                        alert(NPD_Request, "Select a valid NPD request.");
			                        validation_failed = true;
			                    }
			                    else
			                    {
			                        request_record = NPD_Requests[ID == input.NPD_Request];
			                        if(request_record.Process_Status != "Draft" && request_record.Process_Status != "NPD Rework")
			                        {
			                            alert(NPD_Request, "Validation items can be added or edited only while the request is in Draft or NPD Rework.");
			                            validation_failed = true;
			                        }
			                        if(request_record.Request_Owner.email.toLowerCase() != zoho.loginuserid.toLowerCase())
			                        {
			                            alert "Only the request owner can add or edit validation items for this request.";
			                            validation_failed = true;
			                        }
			                    }
			                }
			
			                if(input.Result == "Fail" || input.Result == "Not Applicable")
			                {
			                    if(input.Remarks == null || input.Remarks.trim().isEmpty())
			                    {
			                        alert(Remarks, "Remarks are required when the result is Fail or Not Applicable.");
			                        validation_failed = true;
			                    }
			                }
			
			                active_settings_count = Process_Settings[Active == true].count(ID);
			                if(active_settings_count != 1)
			                {
			                    alert "Exactly one active Process Settings record is required before saving validation items.";
			                    validation_failed = true;
			                }
			                else if(input.Performed_By != null)
			                {
			                    active_settings = Process_Settings[Active == true];
			                    if(input.Performed_By.email.toLowerCase() != active_settings.NPD_Leader_User.email.toLowerCase())
			                    {
			                        alert(Performed_By, "Performed By must be the configured NPD Leader.");
			                        validation_failed = true;
			                    }
			                }
			
			                if(validation_failed == true)
			                {
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Finalize_Stage_Gate_Instance as "Finalize Stage Gate Instance"
			{
			    type = form
			    form = Stage_Gate_Instances
			    record event = on add or edit
			    description = "Audits status changes and initializes the first sourcing attempt when an instance first becomes ready."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                audit_action = "Stage Gate Instance Status - " + input.ID;
			                prior_audit_count = Process_Audit_Log[Action_Name == audit_action].count(ID);
			                prior_status = "";
			                if(prior_audit_count > 0)
			                {
			                    prior_status = Process_Audit_Log[Action_Name == audit_action].To_Status sort by Performed_On desc;
			                }
			
			                if(prior_audit_count == 0 || prior_status != input.Gate_Status)
			                {
			                    audit_event_type = "Submitted";
			                    if(prior_audit_count == 0)
			                    {
			                        audit_event_type = "Created";
			                    }
			                    else if(input.Gate_Status == "Approved")
			                    {
			                        audit_event_type = "Approved";
			                    }
			                    else if(input.Gate_Status == "Rework")
			                    {
			                        audit_event_type = "Reworked";
			                    }
			                    else if(input.Gate_Status == "Terminated")
			                    {
			                        audit_event_type = "Rejected";
			                    }
			
			                    audit_id = insert into Process_Audit_Log
			                    [
			                        NPD_Request = input.NPD_Request
			                        Stage_Gate_Instance = input.ID
			                        Event_Type = audit_event_type
			                        Action_Name = audit_action
			                        From_Status = prior_status
			                        To_Status = input.Gate_Status
			                        Performed_By_Email = zoho.loginuserid
			                        Performed_On = zoho.currenttime
			                        Event_Details = "Stage " + input.Stage_Gate + ", sequence " + input.Sequence_Number + ", latest attempt " + input.Latest_Attempt_Number + "."
			                    ];
			                }
			
			                if(input.Gate_Status == "Ready for Sourcing")
			                {
			                    submission_count = Stage_Gate_Submissions[Stage_Gate_Instance == input.ID].count(ID);
			                    if(submission_count == 0)
			                    {
			                        submission_id = insert into Stage_Gate_Submissions
			                        [
			                            Stage_Gate_Instance = input.ID
			                            Attempt_Number = 1
			                            Submission_Status = "Sourcing Draft"
			                        ];
			
			                        instance_record = Stage_Gate_Instances[ID == input.ID];
			                        instance_record.Latest_Attempt_Number = 1;
			                        if(input.Activated_On == null)
			                        {
			                            instance_record.Activated_On = zoho.currenttime;
			                        }
			
			                        if(input.Sourcing_User != null)
			                        {
			                            sendmail
			                            (
			                                from : zoho.adminuserid
			                                to : input.Sourcing_User.email
			                                subject : "Stage gate ready for sourcing: " + input.Stage_Gate
			                                message : "NPD request " + input.NPD_Request + " stage " + input.Stage_Gate + " is ready. Sourcing attempt 1 has been created."
			                            )
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Load_Stage_Gate_Instance as "Load Stage Gate Instance"
			{
			    type = form
			    form = Stage_Gate_Instances
			    record event = on add or edit
			    description = "Makes system-controlled gate instance fields read-only for ordinary users."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                is_administrator = thisapp.permissions.isUserInProfile("Administrator");
			                if(is_administrator == false)
			                {
			                    disable NPD_Request, Gate_Route_Step, Stage_Gate, Sequence_Number, Final_Gate, Gate_Status, Activated_On, Completed_On, Latest_Attempt_Number, Sourcing_User, QA_Reviewer_User, Section_Head_User;
			                }
			            )
			        }
			    }
			}

			Validate_Stage_Gate_Instance as "Validate Stage Gate Instance"
			{
			    type = form
			    form = Stage_Gate_Instances
			    record event = on add or edit
			    description = "Prevents duplicate request sequence and request stage snapshots."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                validation_failed = false;
			                if(input.NPD_Request != null)
			                {
			                    duplicate_sequence_count = Stage_Gate_Instances[NPD_Request == input.NPD_Request && Sequence_Number == input.Sequence_Number && ID != input.ID].count(ID);
			                    if(duplicate_sequence_count > 0)
			                    {
			                        alert(Sequence_Number, "This sequence number already exists for the selected NPD request.");
			                        validation_failed = true;
			                    }
			
			                    duplicate_stage_count = Stage_Gate_Instances[NPD_Request == input.NPD_Request && Stage_Gate == input.Stage_Gate && ID != input.ID].count(ID);
			                    if(duplicate_stage_count > 0)
			                    {
			                        alert(Stage_Gate, "This stage gate already exists for the selected NPD request.");
			                        validation_failed = true;
			                    }
			                }
			
			                if(validation_failed == true)
			                {
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Audit_Stage_Gate_Submission as "Audit Stage Gate Submission"
			{
			    type = form
			    form = Stage_Gate_Submissions
			    record event = on add
			    description = "Audits creation of every immutable stage-gate attempt; blueprint after-actions audit each handoff."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                instance_record = Stage_Gate_Instances[ID == input.Stage_Gate_Instance];
			                event_type = "Created";
			                if(input.Submission_Status == "Sourcing Rework")
			                {
			                    event_type = "Reworked";
			                }
			                audit_id = insert into Process_Audit_Log
			                [
			                    NPD_Request = instance_record.NPD_Request
			                    Stage_Gate_Instance = input.Stage_Gate_Instance
			                    Stage_Gate_Submission = input.ID
			                    Event_Type = event_type
			                    Action_Name = "Stage Gate Attempt Created"
			                    From_Status = ""
			                    To_Status = input.Submission_Status
			                    Observations = ifnull(input.Copied_Observations, "")
			                    Performed_By_Email = zoho.loginuserid
			                    Performed_On = zoho.currenttime
			                    Event_Details = "Attempt " + input.Attempt_Number + " for stage " + instance_record.Stage_Gate + "."
			                ];
			            )
			        }
			    }
			}

			Load_Stage_Gate_Submission as "Load Stage Gate Submission"
			{
			    type = form
			    form = Stage_Gate_Submissions
			    record event = on add or edit
			    description = "Shows only the sections relevant to the attempt state and enables fields solely for the configured fixed actor profile."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                is_sourcing_user = thisapp.permissions.isUserInProfile("Sourcing Team");
			                is_qa_reviewer = thisapp.permissions.isUserInProfile("QA Reviewer");
			                is_section_head = thisapp.permissions.isUserInProfile("Section Head");
			                hide QA_Review, Section_Head_Review, Copied_Observations, Response_to_Observations;
			                disable Stage_Gate_Instance, Attempt_Number, Previous_Attempt_Number, Copied_Observations, Applicable_Due_On, Submission_Status, Sourcing_Submitted_By, Sourcing_Submitted_On, QA_Reviewed_By, QA_Reviewed_On, QA_Due_On, QA_Escalation_Sent, Section_Head_Decided_By, Section_Head_Decided_On, Section_Head_Due_On, Section_Escalation_Sent;
			                disable Sourcing_Comments, Response_to_Observations, QA_Decision, QA_Observations, Section_Head_Decision, Section_Head_Observations;
			
			                if(input.Submission_Status == "Sourcing Rework")
			                {
			                    show Copied_Observations, Response_to_Observations;
			                }
			                if(input.Submission_Status == "QA Review" || input.Submission_Status == "Section Head Review" || input.Submission_Status == "Rejected by QA" || input.Submission_Status == "Rejected by Section Head" || input.Submission_Status == "Approved")
			                {
			                    show QA_Review;
			                }
			                if(input.Submission_Status == "Section Head Review" || input.Submission_Status == "Rejected by Section Head" || input.Submission_Status == "Approved")
			                {
			                    show Section_Head_Review;
			                }
			
			                if(is_sourcing_user == true && (input.Submission_Status == "Sourcing Draft" || input.Submission_Status == "Sourcing Rework"))
			                {
			                    enable Sourcing_Comments;
			                    if(input.Submission_Status == "Sourcing Rework")
			                    {
			                        enable Response_to_Observations;
			                    }
			                }
			                else if(is_qa_reviewer == true && input.Submission_Status == "QA Review")
			                {
			                    enable QA_Decision, QA_Observations;
			                }
			                else if(is_section_head == true && input.Submission_Status == "Section Head Review")
			                {
			                    enable Section_Head_Decision, Section_Head_Observations;
			                }
			            )
			        }
			    }
			}

			Prevent_Stage_Gate_Submission_Deletion as "Prevent Stage Gate Submission Deletion"
			{
			    type = form
			    form = Stage_Gate_Submissions
			    record event = on delete
			    description = "Preserves every stage-gate attempt as an immutable audit record."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                alert "Stage gate attempts are immutable and cannot be deleted.";
			                cancel delete;
			            )
			        }
			    }
			}

			Stage_Gate_Submission_Blueprint as "Stage Gate Submission Blueprint"
			{
			    type = blueprint
			    form = Stage_Gate_Submissions
			
			    start
			    {
			        start stage = "Sourcing Draft"
			    }
			
			    stages
			    {
			        "Sourcing Draft" { }
			        "Sourcing Rework" { }
			        "QA Review" { }
			        "Section Head Review" { }
			        "Rejected by QA" { }
			        "Rejected by Section Head" { }
			        "Approved" { }
			    }
			
			    transitions
			    {
			        Submit_to_QA as "Submit to QA"
			        {
			            type = normal
			            from stage = "Sourcing Draft"
			            to stage = "QA Review"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Sourcing Team"}
			                )
			            }
			            during
			            {
			                action = update_fields
			                workflow status = true
			                visible fields = [Sourcing_Comments]
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        settings = Process_Settings[Active == true];
			                        instance_record = Stage_Gate_Instances[ID == input.Stage_Gate_Instance];
			                        Sourcing_Submitted_By = zoho.loginuser;
			                        Sourcing_Submitted_On = zoho.currenttime;
			                        QA_Due_On = zoho.currentdate.addBusinessDay(settings.Review_SLA_Working_Days);
			                        Applicable_Due_On = QA_Due_On;
			                        QA_Escalation_Sent = false;
			                        instance_record.Gate_Status = "QA Review";
			                        instance_record.Latest_Attempt_Number = input.Attempt_Number;
			                        audit_id = insert into Process_Audit_Log
			                        [
			                            NPD_Request = instance_record.NPD_Request
			                            Stage_Gate_Instance = input.Stage_Gate_Instance
			                            Stage_Gate_Submission = input.ID
			                            Event_Type = "Submitted"
			                            Action_Name = "Submit to QA"
			                            From_Status = "Sourcing Draft"
			                            To_Status = "QA Review"
			                            Observations = input.Sourcing_Comments
			                            Performed_By_Email = zoho.loginuserid
			                            Performed_On = zoho.currenttime
			                            Event_Details = "Mandatory route-step documents validated for attempt " + input.Attempt_Number + "."
			                        ];
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : settings.QA_Reviewer_User.email
			                            subject : "Stage gate attempt ready for QA"
			                            message : "Attempt " + input.Attempt_Number + " for " + instance_record.Stage_Gate + " is ready for QA review."
			                        )
			                    )
			                }
			            }
			        }
			
			        Send_to_QA_Again as "Send to QA Again"
			        {
			            type = normal
			            from stage = "Sourcing Rework"
			            to stage = "QA Review"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Sourcing Team"}
			                )
			            }
			            during
			            {
			                action = update_fields
			                workflow status = true
			                visible fields = [Response_to_Observations, Sourcing_Comments]
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        settings = Process_Settings[Active == true];
			                        instance_record = Stage_Gate_Instances[ID == input.Stage_Gate_Instance];
			                        Sourcing_Submitted_By = zoho.loginuser;
			                        Sourcing_Submitted_On = zoho.currenttime;
			                        QA_Due_On = zoho.currentdate.addBusinessDay(settings.Review_SLA_Working_Days);
			                        Applicable_Due_On = QA_Due_On;
			                        QA_Escalation_Sent = false;
			                        instance_record.Gate_Status = "QA Review";
			                        instance_record.Latest_Attempt_Number = input.Attempt_Number;
			                        audit_id = insert into Process_Audit_Log
			                        [
			                            NPD_Request = instance_record.NPD_Request
			                            Stage_Gate_Instance = input.Stage_Gate_Instance
			                            Stage_Gate_Submission = input.ID
			                            Event_Type = "Resubmitted"
			                            Action_Name = "Send to QA Again"
			                            From_Status = "Sourcing Rework"
			                            To_Status = "QA Review"
			                            Observations = input.Response_to_Observations
			                            Performed_By_Email = zoho.loginuserid
			                            Performed_On = zoho.currenttime
			                            Event_Details = "Updated mandatory documents validated for rework attempt " + input.Attempt_Number + "."
			                        ];
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : settings.QA_Reviewer_User.email
			                            subject : "Reworked stage gate attempt ready for QA"
			                            message : "Rework attempt " + input.Attempt_Number + " for " + instance_record.Stage_Gate + " is ready for QA review."
			                        )
			                    )
			                }
			            }
			        }
			
			        QA_Pass as "QA Pass"
			        {
			            type = normal
			            from stage = "QA Review"
			            to stage = "Section Head Review"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"QA Reviewer"}
			                )
			            }
			            during
			            {
			                action = update_fields
			                workflow status = true
			                visible fields = [QA_Decision, QA_Observations]
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        settings = Process_Settings[Active == true];
			                        instance_record = Stage_Gate_Instances[ID == input.Stage_Gate_Instance];
			                        QA_Decision = "Pass";
			                        QA_Reviewed_By = zoho.loginuser;
			                        QA_Reviewed_On = zoho.currenttime;
			                        Section_Head_Due_On = zoho.currentdate.addBusinessDay(settings.Review_SLA_Working_Days);
			                        Applicable_Due_On = Section_Head_Due_On;
			                        Section_Escalation_Sent = false;
			                        instance_record.Gate_Status = "Section Head Review";
			                        audit_id = insert into Process_Audit_Log
			                        [
			                            NPD_Request = instance_record.NPD_Request
			                            Stage_Gate_Instance = input.Stage_Gate_Instance
			                            Stage_Gate_Submission = input.ID
			                            Event_Type = "Passed"
			                            Action_Name = "QA Pass"
			                            From_Status = "QA Review"
			                            To_Status = "Section Head Review"
			                            Decision = "Pass"
			                            Observations = input.QA_Observations
			                            Performed_By_Email = zoho.loginuserid
			                            Performed_On = zoho.currenttime
			                            Event_Details = "QA Validation Report confirmed for attempt " + input.Attempt_Number + "."
			                        ];
			                        sendmail
			                        (
