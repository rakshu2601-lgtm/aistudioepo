		 detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( NPD_Request Sequence_Number Check_Category Checkpoint Specification_or_Acceptance_Criteria Observed_Value Result Remarks Evidence_File Performed_By Performed_On ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
		}
	
		report Stage_Gate_Tracker
		{
		 quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( NPD_Request Stage_Gate Sequence_Number Gate_Status Latest_Attempt_Number Activated_On ) ) ) menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) ) action ( on tap ( View Record ) on long press ( Edit Delete Duplicate View Record ) on left swipe ( Delete ) on right swipe ( Edit ) ) )
		 detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( NPD_Request Stage_Gate Sequence_Number Gate_Status Latest_Attempt_Number Activated_On Completed_On Sourcing_User QA_Reviewer_User Section_Head_User ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
		}
	
		report My_Review_Queue
		{
		 quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( Submission_Number Stage_Gate_Instance Attempt_Number Submission_Status QA_Due_On Section_Head_Due_On ) ) ) menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) ) action ( on tap ( View Record ) on long press ( Edit Delete Duplicate View Record ) on left swipe ( Delete ) on right swipe ( Edit ) ) )
		 detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Submission_Number Stage_Gate_Instance Attempt_Number Submission_Status Sourcing_Submitted_On QA_Due_On Section_Head_Due_On ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
		}
	
		report Submission_SLA_Calendar
