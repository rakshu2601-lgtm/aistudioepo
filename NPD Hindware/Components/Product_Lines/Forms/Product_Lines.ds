form Product_Lines
{
    displayname = "Product Lines"

    Product_Line_Details
    (
        type = section
        displayname = "Product Line Details"
        row = 1
        column = 0
    )
    must have unique Product_Line_Code
    (
        type = text
        displayname = "Product Line Code"
        row = 1
        column = 1
    )
    must have Product_Line_Name
    (
        type = text
        displayname = "Product Line Name"
        row = 1
        column = 1
    )
    must have Plant
    (
        type = picklist
        displayname = "Plant"
        values = Plants.ID
        displayformat = [Plant_Name]
        searchable = true
        row = 1
        column = 1
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 1
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 1
        column = 1
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Product Line"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Product Line"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
