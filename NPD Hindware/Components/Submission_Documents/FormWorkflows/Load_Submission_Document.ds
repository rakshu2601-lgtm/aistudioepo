Load_Submission_Document as "Load Submission Document"
{
    type = form
    form = Submission_Documents
    record event = on add or edit
    description = "Filters stage-gate requirements, controls category-specific visibility, and protects upload metadata."

    on load
    {
        actions
        {
            custom deluge script
            (
                hide NPD_Request, Stage_Gate, Attempt_Number;
                disable Uploaded_By, Uploaded_On, NPD_Request, Stage_Gate, Attempt_Number;
                clear Document_Requirement;
                if(input.Stage_Gate_Submission != null)
                {
                    submission_record = Stage_Gate_Submissions[ID == input.Stage_Gate_Submission];
                    instance_record = Stage_Gate_Instances[ID == submission_record.Stage_Gate_Instance];
                    allowed_requirements = Document_Requirements[Active == true && Scope == "Stage Gate" && Gate_Route_Step == instance_record.Gate_Route_Step] sort by Sort_Order;
                    Document_Requirement:ui.add(allowed_requirements.ID.getall());
                }
                if(input.ID == null)
                {
                    input.Uploaded_By = zoho.loginuser;
                    input.Uploaded_On = zoho.currenttime;
                }
                else
                {
                    disable Stage_Gate_Submission, Document_Category, Document_Requirement, Document_Name, Document_File;
                }
                if(input.Document_Category == "Sourcing Supporting Document")
                {
                    show Document_Requirement;
                }
                else
                {
                    hide Document_Requirement;
                }
            )
        }
    }
}
