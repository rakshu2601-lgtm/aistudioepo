Validate_Submission_Document as "Validate Submission Document"
{
    type = form
    form = Submission_Documents
    record event = on add or edit
    description = "Restricts immutable attempt documents to the configured Sourcing or QA actor in the matching attempt state."

    on validate
    {
        actions
        {
            custom deluge script
            (
                validation_failed = false;
                settings_count = Process_Settings[Active == true].count(ID);
                if(settings_count != 1)
                {
                    alert "Exactly one active process settings record is required before uploading submission documents.";
                    validation_failed = true;
                }
                else
                {
                    active_settings = Process_Settings[Active == true];
                }

                submission_count = Stage_Gate_Submissions[ID == input.Stage_Gate_Submission].count(ID);
                if(submission_count == 0)
                {
                    alert(Stage_Gate_Submission, "Select a valid stage-gate submission attempt.");
                    validation_failed = true;
                }
                else
                {
                    submission_record = Stage_Gate_Submissions[ID == input.Stage_Gate_Submission];
                    instance_count = Stage_Gate_Instances[ID == submission_record.Stage_Gate_Instance].count(ID);
                    if(instance_count == 0)
                    {
                        alert "The submission is not linked to a valid stage-gate instance.";
                        validation_failed = true;
                    }
                    else
                    {
                        instance_record = Stage_Gate_Instances[ID == submission_record.Stage_Gate_Instance];
                        input.NPD_Request = instance_record.NPD_Request;
                        input.Stage_Gate = instance_record.Stage_Gate;
                        input.Attempt_Number = submission_record.Attempt_Number;

                        if(input.Document_Category == "Sourcing Supporting Document")
                        {
                            if(input.Document_Requirement == null)
                            {
                                alert(Document_Requirement, "A configured document requirement is required for a Sourcing supporting document.");
                                validation_failed = true;
                            }
                            else
                            {
                                requirement_count = Document_Requirements[ID == input.Document_Requirement && Active == true && Scope == "Stage Gate" && Gate_Route_Step == instance_record.Gate_Route_Step].count(ID);
                                if(requirement_count == 0)
                                {
                                    alert(Document_Requirement, "Select an active Stage Gate requirement configured for this submission route step.");
                                    validation_failed = true;
                                }
                            }
                            if(submission_record.Submission_Status != "Sourcing Draft" && submission_record.Submission_Status != "Sourcing Rework")
                            {
                                alert "Sourcing documents may be added or changed only while this attempt is in Sourcing Draft or Sourcing Rework.";
                                validation_failed = true;
                            }
                            if(settings_count == 1 && active_settings.Sourcing_User.email.toLowerCase() != zoho.loginuserid.toLowerCase())
                            {
                                alert "Only the configured Sourcing user may maintain Sourcing supporting documents.";
                                validation_failed = true;
                            }
                        }
                        else if(input.Document_Category == "QA Validation Report")
                        {
                            if(input.Document_Requirement != null)
                            {
                                alert(Document_Requirement, "Document Requirement must be blank for a QA Validation Report.");
                                validation_failed = true;
                            }
                            if(submission_record.Submission_Status != "QA Review")
                            {
                                alert "QA Validation Reports may be added or changed only while this attempt is in QA Review.";
                                validation_failed = true;
                            }
                            if(settings_count == 1 && active_settings.QA_Reviewer_User.email.toLowerCase() != zoho.loginuserid.toLowerCase())
                            {
                                alert "Only the configured QA Reviewer may maintain QA Validation Reports.";
                                validation_failed = true;
                            }
                        }
                    }
                }

                if(input.ID == null)
                {
                    input.Uploaded_By = zoho.loginuser;
                    input.Uploaded_On = zoho.currenttime;
                }
                else
                {
                    existing_document = Submission_Documents[ID == input.ID];
                    if(input.Stage_Gate_Submission != existing_document.Stage_Gate_Submission || input.Document_Category != existing_document.Document_Category || input.Document_Requirement != existing_document.Document_Requirement || input.Document_Name != existing_document.Document_Name || input.Document_File != existing_document.Document_File || input.Uploaded_By != existing_document.Uploaded_By || input.Uploaded_On != existing_document.Uploaded_On || input.NPD_Request != existing_document.NPD_Request || input.Stage_Gate != existing_document.Stage_Gate || input.Attempt_Number != existing_document.Attempt_Number)
                    {
                        alert "Uploaded document rows are immutable. Add another row during the allowed actor state; only Remarks may be edited on this row.";
                        validation_failed = true;
                    }
                }

                if(validation_failed)
                {
                    cancel submit;
                }
            )
        }
    }
}
