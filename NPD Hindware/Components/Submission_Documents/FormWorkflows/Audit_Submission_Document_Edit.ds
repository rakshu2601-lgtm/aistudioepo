Audit_Submission_Document_Edit as "Audit Submission Document Edit"
{
    type = form
    form = Submission_Documents
    record event = on edit
    description = "Audits an allowed remarks update while preserving the original attempt document."

    on success
    {
        actions
        {
            custom deluge script
            (
                audit_details = "Submission Document ID: " + input.ID + "; Attempt: " + input.Attempt_Number + "; Gate: " + input.Stage_Gate + "; Category: " + input.Document_Category + "; Document: " + input.Document_Name + "; Remarks updated without replacing the uploaded file.";
                audit_id = insert into Process_Audit_Log
                [
                    NPD_Request = input.NPD_Request
                    Stage_Gate_Instance = Stage_Gate_Submissions[ID == input.Stage_Gate_Submission].Stage_Gate_Instance
                    Stage_Gate_Submission = input.Stage_Gate_Submission
                    Event_Type = "Document Uploaded"
                    Action_Name = "Submission Document Remarks Updated"
                    Observations = input.Remarks
                    Performed_By_Email = zoho.loginuserid
                    Performed_On = zoho.currenttime
                    Event_Details = audit_details
                ];
            )
        }
    }
}
