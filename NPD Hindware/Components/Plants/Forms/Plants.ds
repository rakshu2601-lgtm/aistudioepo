form Plants
{
    Plant_Details
    (
        type = section
        displayname = "Plant Details"
        row = 1
        column = 0
    )
    must have unique Plant_Code
    (
        type = text
        displayname = "Plant Code"
        row = 1
        column = 1
        width = medium
    )
    must have unique Plant_Name
    (
        type = text
        displayname = "Plant Name"
        row = 1
        column = 2
        width = medium
    )
    must have Branch
    (
        type = radiobuttons
        displayname = "Branch"
        values = {"BPD", "CPD"}
        layout = 2
        row = 1
        column = 1
        width = medium
    )
    Active
    (
        type = checkbox
        initial value = true
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Plant"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Plant"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
