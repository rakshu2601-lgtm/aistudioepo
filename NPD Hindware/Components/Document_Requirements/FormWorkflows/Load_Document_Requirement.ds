Load_Document_Requirement as "Load Document Requirement"
{
    type = form
    form = Document_Requirements
    record event = on add or edit
    description = "Shows and filters the route step only for stage-gate requirements"

    on load
    {
        actions
        {
            custom deluge script
            (
                clear Gate_Route_Step;
                if(input.Gate_Route != null)
                {
                    route_steps = Gate_Route_Steps[Gate_Route == input.Gate_Route] sort by Sequence_Number;
                    Gate_Route_Step:ui.add(route_steps.ID.getall());
                }
                if(input.Scope == "Stage Gate")
                {
                    show Gate_Route_Step;
                    enable Gate_Route_Step;
                }
                else
                {
                    hide Gate_Route_Step;
                    disable Gate_Route_Step;
                }
            )
        }
    }
}
