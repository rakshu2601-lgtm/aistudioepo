default list Process_Audit_Trail
{
    displayName = "Process Audit Trail"
    show all rows from Process_Audit_Log
    (
        NPD_Request as "Request"
        Stage_Gate_Instance
        Stage_Gate_Submission
        Event_Type
        Action_Name
        From_Status
        To_Status
        Decision
        Observations
        Performed_By_Email
        Performed_On
        Event_Details
    )
    filters
    (
        NPD_Request
        Event_Type
        Performed_By_Email
        Performed_On
    )
    sort by
    (
        Performed_On descending
    )
}
