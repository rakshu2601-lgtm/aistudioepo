timeline Process_Timeline
{
    displayName = "Process Timeline"
    show all rows from Process_Audit_Log
    (
        NPD_Request as "Request"
        Stage_Gate_Instance
        Stage_Gate_Submission
        Event_Type
        Action_Name
        From_Status
        To_Status
        Decision
        Observations
        Performed_By_Email
        Performed_On
        Event_Details
    )
    sort by
    (
        Performed_On descending
    )
    options
    (
        display field = Action_Name
        start date = Performed_On
    )
}
