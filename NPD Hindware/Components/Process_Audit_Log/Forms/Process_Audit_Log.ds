form Process_Audit_Log
{
    displayname = "Process Audit Log"

    Audit_Event
    (
        type = section
        displayname = "Audit Event"
        row = 1
        column = 0
    )
    NPD_Request
    (
        type = picklist
        displayname = "NPD Request"
        values = NPD_Requests.ID
        displayformat = [Request_Title]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Stage_Gate_Instance
    (
        type = picklist
        displayname = "Stage Gate Instance"
        values = Stage_Gate_Instances.ID
        displayformat = [Stage_Gate]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Stage_Gate_Submission
    (
        type = picklist
        displayname = "Stage Gate Submission"
        values = Stage_Gate_Submissions.ID
        displayformat = [Submission_Number]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Event_Type
    (
        type = picklist
        displayname = "Event Type"
        values = {"Created", "Submitted", "Passed", "Approved", "Rejected", "Reworked", "Resubmitted", "Document Uploaded", "Escalated", "Released to Mass Production", "Configuration Changed"}
        row = 1
        column = 2
        width = medium
    )
    must have Action_Name
    (
        type = text
        displayname = "Action Name"
        row = 1
        column = 1
        width = medium
    )
    From_Status
    (
        type = text
        displayname = "From Status"
        row = 1
        column = 2
        width = medium
    )
    To_Status
    (
        type = text
        displayname = "To Status"
        row = 1
        column = 1
        width = medium
    )
    Decision
    (
        type = text
        row = 1
        column = 2
        width = medium
    )
    Observations
    (
        type = textarea
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    must have Performed_By_Email
    (
        type = email
        displayname = "Performed By Email"
        row = 1
        column = 2
        width = medium
    )
    must have Performed_On
    (
        type = datetime
        displayname = "Performed On"
        row = 1
        column = 1
        width = medium
    )
    Event_Details
    (
        type = textarea
        displayname = "Event Details"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Audit Event"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Audit Event"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
