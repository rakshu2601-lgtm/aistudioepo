form Request_Documents
{
    displayname = "Request Documents"
    success message = "Document version uploaded successfully."

    Document_Details
    (
        type = section
        displayname = "Document Details"
        row = 1
        column = 0
    )
    must have NPD_Request
    (
        type = picklist
        displayname = "NPD Request"
        values = NPD_Requests.ID
        displayformat = [Request_Title]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Document_Requirement
    (
        type = picklist
        displayname = "Document Requirement"
        values = Document_Requirements.ID
        displayformat = [Requirement_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Document_Name
    (
        type = text
        displayname = "Document Name"
        row = 1
        column = 1
        width = medium
    )
    must have Document_File
    (
        type = upload file
        displayname = "Document File"
        browse = local_drive, google_docs, zoho_docs
        row = 1
        column = 1
        width = medium
    )
    must have Version_Number
    (
        type = number
        displayname = "Version Number"
        initial value = 1
        row = 1
        column = 2
        width = medium
    )
    Remarks
    (
        type = textarea
        displayname = "Remarks"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    Current_Version
    (
        type = checkbox
        displayname = "Current Version"
        initial value = true
        row = 1
        column = 2
        width = medium
    )
    Uploaded_By
    (
        type = picklist
        displayname = "Uploaded By"
        module = users
        row = 1
        column = 2
        width = medium
    )
    Uploaded_On
    (
        type = datetime
        displayname = "Uploaded On"
        initial value = "${zoho.currenttime}"
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Upload New Version"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Remarks"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
