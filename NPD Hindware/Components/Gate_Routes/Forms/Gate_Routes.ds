form Gate_Routes
{
    displayname = "Gate Routes"

    Route_Details
    (
        type = section
        displayname = "Route Details"
        row = 1
        column = 0
    )
    must have unique Route_Code
    (
        type = text
        displayname = "Route Code"
        row = 1
        column = 1
    )
    must have Route_Name
    (
        type = text
        displayname = "Route Name"
        row = 1
        column = 1
    )
    must have Plant
    (
        type = picklist
        displayname = "Plant"
        values = Plants.ID
        displayformat = [Plant_Name]
        searchable = true
        row = 1
        column = 1
    )
    must have Product_Line
    (
        type = picklist
        displayname = "Product Line"
        values = Product_Lines.ID
        displayformat = [Product_Line_Name]
        searchable = true
        row = 1
        column = 1
    )
    must have Version_Number
    (
        type = number
        displayname = "Version Number"
        initial value = 1
        row = 1
        column = 1
    )
    must have Effective_From
    (
        type = date
        displayname = "Effective From"
        row = 1
        column = 1
    )
    Effective_To
    (
        type = date
        displayname = "Effective To"
        row = 1
        column = 1
    )
    must have Status
    (
        type = radiobuttons
        displayname = "Status"
        values = {"Draft", "Active", "Inactive"}
        initial value = "Draft"
        layout = 3
        row = 1
        column = 1
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 1
        column = 1
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Route"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Route"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
