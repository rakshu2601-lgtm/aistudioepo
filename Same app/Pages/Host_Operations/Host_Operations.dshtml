<%
today = zoho.currentdate;
tomorrow = today.addDay(1);
now = zoho.currenttime;
todayReservations = Reservations[Reservation_Date_Time >= today && Reservation_Date_Time < tomorrow && Reservation_Status != "Cancelled" && Reservation_Status != "No Show"];
reservationCount = todayReservations.count();
expectedCovers = ifnull(todayReservations.sum(Party_Size),0);
arrivedSeatedCount = Reservations[Reservation_Date_Time >= today && Reservation_Date_Time < tomorrow && (Reservation_Status == "Arrived" || Reservation_Status == "Seated")].count();
activeWaitlist = Waitlist_Entries[Waitlist_Status == "Waiting" || Waitlist_Status == "Notified" || Waitlist_Status == "Arrived"] sort by Joined_Date_Time asc;
waitlistCount = activeWaitlist.count();
availableTables = Dining_Tables[Active == true && Operational_Status == "Available"];
availableCount = availableTables.count();
upcoming = Reservations[Reservation_Date_Time >= now && Reservation_Date_Time < tomorrow && (Reservation_Status == "Confirmed" || Reservation_Status == "Tentative" || Reservation_Status == "Arrived")] sort by Reservation_Date_Time asc;
lateReservations = Reservations[Reservation_Date_Time >= today && Reservation_Date_Time < now && Reservation_Status == "Confirmed"];
resetTables = Dining_Tables[Active == true && Operational_Status == "Needs Reset"];
longWaitCount = 0;
for each w0 in activeWaitlist
{
    elapsed0 = ((now - w0.Joined_Date_Time) / 60000).round(0);
    if(elapsed0 > w0.Quoted_Wait_Minutes)
    {
        longWaitCount = longWaitCount + 1;
    }
}
serviceName = "Current service";
for each svc in Service_Periods[Active == true]
{
    serviceName = svc.Service_Name;
}
canEdit = true;
%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color)}*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:4px}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-w-full{width:100%}.zcs-p-0{padding:0}.zcs-p-16{padding:16px}.zcs-p-25{padding:25px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-12{padding-top:12px;padding-bottom:12px}.zcs-px-30{padding-left:30px;padding-right:30px}.zcs-py-24{padding-top:24px;padding-bottom:24px}.zcs-m-0{margin:0}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-xl{border-radius:12px}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.zcs-page{padding:18px;background:var(--zcs-page-bg-color,#f5f5f6);color:var(--zcs-primary-text-color);font-family:inherit}.zcs-page-header{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;margin-bottom:16px}.zcs-header-copy{min-width:240px}.zcs-header-actions{flex-wrap:wrap}.zcs-button{width:auto;min-width:5rem;min-height:36px;text-decoration:none}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color);border:1px solid var(--zcs_brand_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-kpis{display:grid;grid-template-columns:repeat(5,minmax(150px,1fr));gap:12px;margin-bottom:16px}.zcs-property-card{min-height:116px}.zcs-kpi-icon{width:38px;height:38px;border-radius:10px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color)}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-green{background:#179e6c;color:#fff}.zcs-badge-red{background:#fe455d;color:#fff}.zcs-badge-yellow{background:#faae13;color:#fff}.zcs-badge-blue{background:#2a6ffc;color:#fff}.zcs-badge-grey{background:#50505a;color:#fff}.zcs-main-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(290px,1fr);gap:16px}.zcs-section{padding:16px}.zcs-section-title{margin-bottom:12px}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:var(--zcs-white-color);overflow:auto;border-radius:6px}.zcs-table-wrapper table{border-collapse:collapse;min-width:650px}.zcs-table-wrapper thead{top:0}.zcs-table-wrapper th{background:#f9fafe;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tbody tr:hover td{background:#f9fafe}.zcs-queue{display:flex;flex-direction:column;gap:8px}.zcs-queue-row{padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:8px}.zcs-toast{border:1px solid}.zcs-warning-toast{background:#fef4e5;color:#663c01}.zcs-error-toast{background:#feedec;color:#5f2120}.zcs-info-toast{background:#e4f6fd;color:#024361}.zcs-quick-action-item{list-style:none}.zcs-quick-action-item:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-link{text-decoration:none}.zcs-quick-actions-wrapper ul{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.zcs-empty{padding:18px;text-align:center;color:var(--zcs-teritiary-text-color)}@media(max-width:1100px){.zcs-kpis{grid-template-columns:repeat(3,1fr)}.zcs-main-grid{grid-template-columns:1fr}}@media(max-width:700px){.zcs-page{padding:10px}.zcs-page-header{padding:16px}.zcs-kpis{grid-template-columns:repeat(2,1fr)}.zcs-header-actions{width:100%}.zcs-quick-actions-wrapper ul{grid-template-columns:1fr}}@media(max-width:430px){.zcs-kpis{grid-template-columns:1fr}}
</style>
<div class='zcs-page'>
  <div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-24 zcs-box-border'>
    <div class='zcs-header-copy'><h2 class='zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Host Operations</h2><div class='zcs-font-14 zcs-color-secondary'><%=today.toString("EEEE, dd MMMM yyyy")%> · <%=serviceName%> · Updated <%=now.toString("hh:mm a")%></div></div>
    <div class='zcs-header-actions zcs-flex zcs-align-items-center zcs-gap-8'>
      <a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Report:Reservation_Calendar'><i class='zc-li-outline ui-1-calendar-60'></i><span>Reservation Calendar</span></a>
      <a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Report:Live_Waitlist'><i class='zc-li-outline ui-2-time'></i><span>Live Waitlist</span></a>
      <a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md' href='#Report:Live_Table_Status'><i class='zc-li-outline furniture-table'></i><span>Live Table Status</span></a>
    </div>
  </div>
  <div class='zcs-kpis'>
<%
metrics = List();
metrics.add({"label":"Today's reservations","value":reservationCount,"icon":"ui-1-calendar-60"});
metrics.add({"label":"Expected covers","value":expectedCovers,"icon":"users-single-01"});
metrics.add({"label":"Arrived or seated","value":arrivedSeatedCount,"icon":"ui-1-check-circle-08"});
metrics.add({"label":"Active waitlist","value":waitlistCount,"icon":"ui-2-time"});
metrics.add({"label":"Available tables","value":availableCount,"icon":"furniture-table"});
for each metric in metrics
{
%>
    <div class='zcs-property-card zcs-card zcs-p-16 zcs-box-border'><div class='zcs-flex zcs-justify-space-between zcs-gap-16'><div><div class='zcs-font-13 zcs-color-secondary'><%=metric.get("label")%></div><div class='zcs-font-24 zcs-font-semibold zcs-color-primary'><%=metric.get("value")%></div></div><div class='zcs-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline <%=metric.get("icon")%>'></i></div></div></div>
<%
}
%>
  </div>
  <div class='zcs-main-grid'>
    <div class='zcs-flex zcs-direction-column zcs-gap-16'>
      <section class='zcs-section zcs-card'><div class='zcs-section-title zcs-flex zcs-align-items-center zcs-justify-space-between'><h3 class='zcs-font-18 zcs-font-semibold zcs-m-0'>Upcoming arrivals</h3><span class='zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=upcoming.count()%> upcoming</span></div>
        <div class='zcs-table-wrapper zcs-relative'><table class='zcs-w-full'><thead><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14'>Time</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14'>Guest</th><th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14'>Party</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14'>Table</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14'>Status</th></tr></thead><tbody>
<%
for each r in upcoming
{
    statusClass = if(r.Reservation_Status == "Arrived","zcs-badge-green",if(r.Reservation_Status == "Tentative","zcs-badge-yellow","zcs-badge-blue"));
%><tr><td class='zcs-px-16 zcs-py-8 zcs-font-14'><%=r.Reservation_Date_Time.toString("hh:mm a")%></td><td class='zcs-px-16 zcs-py-8 zcs-font-14'><%=r.Guest.Guest_Name.first_name%></td><td class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14'><%=r.Party_Size%></td><td class='zcs-px-16 zcs-py-8 zcs-font-14'><%=ifnull(r.Assigned_Table.Table_Number,"Unassigned")%></td><td class='zcs-px-16 zcs-py-8'><span class='zcs-badge zcs-badge-filled <%=statusClass%> zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm zcs-font-12'><%=r.Reservation_Status%></span></td></tr><%
}
if(upcoming.count() == 0)
{
%><tr><td colspan='5' class='zcs-empty'>No upcoming arrivals for today.</td></tr><%
}
%></tbody></table></div>
      </section>
      <section class='zcs-section zcs-card'><div class='zcs-section-title zcs-flex zcs-align-items-center zcs-justify-space-between'><h3 class='zcs-font-18 zcs-font-semibold zcs-m-0'>Active waitlist</h3><span class='zcs-badge zcs-badge-filled zcs-badge-yellow zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm'><%=waitlistCount%> parties</span></div><div class='zcs-queue'>
<%
for each w in activeWaitlist
{
    elapsed = ((now - w.Joined_Date_Time) / 60000).round(0);
    priorityClass = if(w.Priority == "Standard","zcs-badge-grey",if(w.Priority == "VIP","zcs-badge-blue","zcs-badge-red"));
%><div class='zcs-queue-row zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div><div class='zcs-font-15 zcs-font-semibold'><%=w.Guest.Guest_Name.first_name%> · party of <%=w.Party_Size%></div><div class='zcs-font-13 zcs-color-secondary'>Quoted <%=w.Quoted_Wait_Minutes%> min · elapsed <%=elapsed%> min</div></div><div class='zcs-flex zcs-gap-4'><span class='zcs-badge zcs-badge-filled <%=priorityClass%> zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm zcs-font-12'><%=w.Priority%></span><span class='zcs-badge zcs-badge-filled zcs-badge-yellow zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm zcs-font-12'><%=w.Waitlist_Status%></span></div></div><%
}
if(waitlistCount == 0)
{
%><div class='zcs-empty'>The active queue is clear.</div><%
}
%></div></section>
      <section class='zcs-section zcs-card'><h3 class='zcs-section-title zcs-font-18 zcs-font-semibold zcs-m-0'>Seating opportunities</h3><div class='zcs-queue'>
<%
for each party in activeWaitlist
{
    fitting = Dining_Tables[Active == true && Operational_Status == "Available" && Capacity >= party.Party_Size] sort by Capacity asc;
%><div class='zcs-queue-row'><div class='zcs-font-15 zcs-font-semibold'>Party of <%=party.Party_Size%></div><div class='zcs-font-13 zcs-color-secondary'>Fitting tables: <% shown = 0; for each fit in fitting { if(shown < 5) { %><span class='zcs-badge zcs-badge-filled zcs-badge-green zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm zcs-font-12'>Table <%=fit.Table_Number%> · <%=fit.Capacity%></span> <% shown = shown + 1; } } if(fitting.count() == 0) { %>No available table currently fits.<% } %></div></div><%
}
if(waitlistCount == 0)
{
%><div class='zcs-empty'>Seating matches appear when parties join the waitlist.</div><%
}
%></div></section>
    </div>
    <aside class='zcs-flex zcs-direction-column zcs-gap-16'>
      <section class='zcs-section zcs-card'><h3 class='zcs-section-title zcs-font-18 zcs-font-semibold zcs-m-0'>Operational alerts</h3><div class='zcs-flex zcs-direction-column zcs-gap-8'>
        <div class='zcs-toast zcs-outline-toast <%=if(lateReservations.count() > 0,"zcs-error-toast","zcs-info-toast")%> zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm'><i class='zc-li-outline ui-3-alert'></i><div><strong><%=lateReservations.count()%> late arrivals</strong><div class='zcs-font-13'>Confirmed bookings past arrival time.</div></div></div>
        <div class='zcs-toast zcs-outline-toast <%=if(longWaitCount > 0,"zcs-warning-toast","zcs-info-toast")%> zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm'><i class='zc-li-outline ui-2-time'></i><div><strong><%=longWaitCount%> waits over quote</strong><div class='zcs-font-13'>Parties beyond their quoted wait.</div></div></div>
        <div class='zcs-toast zcs-outline-toast <%=if(resetTables.count() > 0,"zcs-warning-toast","zcs-info-toast")%> zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm'><i class='zc-li-outline ui-1-refresh-69'></i><div><strong><%=resetTables.count()%> tables need reset</strong><div class='zcs-font-13'>Clear reset backlog before the next seating.</div></div></div>
      </div></section>
      <section class='zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16'><h3 class='zcs-font-18 zcs-font-semibold zcs-m-0'>Quick actions</h3>
<%
if(canEdit)
{
%><ul class='zcs-p-0 zcs-m-0'><li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary' href='#Form:Guests'><i class='zc-li-outline users-add-27'></i><span>Add Guest</span></a></li><li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary' href='#Form:Reservations'><i class='zc-li-outline ui-1-calendar-add-61'></i><span>Add Reservation</span></a></li><li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary' href='#Form:Waitlist_Entries'><i class='zc-li-outline ui-2-time'></i><span>Add Waitlist Entry</span></a></li><li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary' href='#Form:Dining_Visits'><i class='zc-li-outline furniture-table'></i><span>Add Dining Visit</span></a></li></ul><%
}
else
{
%><div class='zcs-toast zcs-outline-toast zcs-info-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm'><i class='zc-li-outline ui-1-eye-17'></i><div>Read-only operational view. Use the linked live reports for service context.</div></div><%
}
%></section>
    </aside>
  </div>
</div>