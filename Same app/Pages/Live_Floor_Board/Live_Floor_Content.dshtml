<%
selectedArea = ifnull(input.Area,"All");
activeTables = Dining_Tables[Active == true];
totalTables = activeTables.count();
availableCount = Dining_Tables[Active == true && Operational_Status == "Available"].count();
occupiedCount = Dining_Tables[Active == true && Operational_Status == "Occupied"].count();
reservedCount = Dining_Tables[Active == true && Operational_Status == "Reserved"].count();
resetCount = Dining_Tables[Active == true && Operational_Status == "Needs Reset"].count();
blockedCount = Dining_Tables[Active == true && (Operational_Status == "Blocked" || Operational_Status == "Out of Service")].count();
totalCapacity = ifnull(activeTables.sum(Capacity),0);
occupiedSeats = 0;
for each openVisit in Dining_Visits[Visit_Status != "Closed" && Visit_Status != "Abandoned"]
{
  occupiedSeats = occupiedSeats + ifnull(openVisit.Party_Size,0);
}
%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff}
*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-p-0{padding:0}.zcs-p-16{padding:16px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-12{padding-top:12px;padding-bottom:12px}.zcs-m-0{margin:0}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-20{font-size:20px}.zcs-font-28{font-size:28px}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-xl{border-radius:12px}.zcs-box-border{box-sizing:border-box}.zcs-w-full{width:100%}.zcs-no-underline{text-decoration:none}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}
.floor-board{padding:18px;background:var(--zcs-page-bg-color);min-height:100%;font-family:Arial,sans-serif;color:var(--zcs-primary-text-color)}.floor-header{margin-bottom:16px}.floor-title{margin:0 0 4px;font-size:26px}.live-stamp{font-size:13px;color:var(--zcs-secondary-text-color)}.summary-grid{display:grid;grid-template-columns:repeat(5,minmax(130px,1fr));gap:12px;margin-bottom:14px}.summary-card{padding:15px}.summary-card .value{font-size:26px;font-weight:700;line-height:1.1}.summary-card .label{font-size:12px;color:var(--zcs-teritiary-text-color);margin-top:5px}.summary-card .sub{font-size:12px;color:var(--zcs-secondary-text-color);margin-top:3px}.zcs-horizontal-tabhead{box-shadow:0 -1px 0 var(--zcs-border-color) inset;overflow-x:auto;list-style:none;margin:0 0 14px;padding:0 10px;display:flex;gap:12px}.zcs-horizontal-tabitem{list-style:none;border-bottom:2px solid transparent}.zcs-horizontal-tablink{display:flex;align-items:center;gap:8px;padding:12px 10px;color:var(--zcs-teritiary-text-color);text-decoration:none;white-space:nowrap}.zcs-horizontal-tabcount{min-width:20px;background:var(--zcs-page-bg-color);padding:2px 6px;border-radius:4px;text-align:center;font-size:12px}.zcs-horizontal-tabactive{border-bottom-color:var(--zcs_brand_color)}.zcs-horizontal-tabactive .zcs-horizontal-tablink{color:var(--zcs_brand_color)}.board-meta{display:grid;grid-template-columns:minmax(0,2fr) minmax(260px,1fr);gap:14px;margin-bottom:16px}.legend-card,.alerts-card{padding:14px}.legend-list{display:flex;flex-wrap:wrap;gap:10px 18px;margin:8px 0 0;padding:0;list-style:none}.legend-item{display:flex;align-items:center;gap:7px;font-size:12px}.legend-dot{width:11px;height:11px;border-radius:50%}.zcs-toast{border:1px solid #ed6c03;background:#fef4e5;color:#663c01;padding:12px 16px;border-radius:4px;display:flex;gap:8px}.area-section{margin-bottom:22px}.area-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:10px}.area-heading h2{font-size:19px;margin:0}.area-heading span{font-size:12px;color:var(--zcs-secondary-text-color)}.table-grid{display:grid;grid-template-columns:repeat(4,minmax(220px,1fr));gap:12px}.table-card{border-top:5px solid var(--state);overflow:hidden;min-height:250px}.table-card:hover{border-color:var(--zcs_brand_color)}.table-top{padding:14px 14px 10px;display:flex;justify-content:space-between;gap:10px}.table-number{font-size:22px;font-weight:700}.area-name{font-size:12px;color:var(--zcs-teritiary-text-color)}.zcs-badge{width:auto;border:1px solid currentColor;padding:2px 10px;border-radius:4px;font-size:12px;line-height:1.5;background:var(--state-bg);color:var(--state)}.table-body{padding:0 14px 14px}.kv{background:#F9FAFE;border-radius:12px;padding:7px 12px;margin-bottom:10px}.kv-row{display:grid;grid-template-columns:44% 56%;gap:8px;padding:5px 0;font-size:13px}.kv-row label{color:var(--zcs-teritiary-text-color)}.kv-row span{font-weight:500;overflow-wrap:anywhere}.card-links{display:flex;flex-wrap:wrap;gap:10px;border-top:1px solid #EBECF0;padding-top:10px}.card-links a,.quick-links a{color:var(--zcs_brand_color);font-size:12px;text-decoration:none}.quick-links{display:flex;flex-wrap:wrap;gap:10px}.quick-link{border:1px solid var(--zcs_brand_color);padding:7px 10px;border-radius:6px}.empty{padding:28px;text-align:center;color:var(--zcs-secondary-text-color)}
@media(max-width:1200px){.table-grid{grid-template-columns:repeat(3,minmax(220px,1fr))}.summary-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:820px){.table-grid{grid-template-columns:repeat(2,minmax(210px,1fr))}.board-meta{grid-template-columns:1fr}.summary-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:540px){.floor-board{padding:10px}.table-grid,.summary-grid{grid-template-columns:1fr}.floor-header{align-items:flex-start;flex-direction:column}.table-card{min-height:auto}}
</style>
<div class='floor-board'>
  <div class='floor-header zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12'>
    <div><h1 class='floor-title'>Live Floor Board</h1><div class='live-stamp'><i class='zc-li-outline ui-2-time'></i> Snapshot <%=zoho.currenttime.toString("MMM d, yyyy h:mm a")%></div></div>
    <div class='quick-links'>
      <a class='quick-link' href='#Form:Dining_Tables?zc_LoadIn=dialog'><i class='zc-li-outline design-apps'></i> Dining tables</a>
      <a class='quick-link' href='#Form:Dining_Visits?zc_LoadIn=dialog'><i class='zc-li-outline users-single-05'></i> Dining visits</a>
      <a class='quick-link' href='#Form:Reservations?zc_LoadIn=dialog'><i class='zc-li-outline ui-1-calendar-60'></i> Reservations</a>
    </div>
  </div>
  <div class='summary-grid'>
    <div class='zcs-card summary-card'><div class='value'><%=occupiedCount%>/<%=totalTables%></div><div class='label'>Occupied tables</div><div class='sub'><%=occupiedSeats%> guests seated</div></div>
    <div class='zcs-card summary-card'><div class='value'><%=availableCount%></div><div class='label'>Available now</div><div class='sub'><%=totalCapacity%> total seats</div></div>
    <div class='zcs-card summary-card'><div class='value'><%=reservedCount%></div><div class='label'>Reservation holds</div><div class='sub'>Assigned tables</div></div>
    <div class='zcs-card summary-card'><div class='value'><%=resetCount%></div><div class='label'>Reset backlog</div><div class='sub'>Needs reset</div></div>
    <div class='zcs-card summary-card'><div class='value'><%=blockedCount%></div><div class='label'>Unavailable</div><div class='sub'>Blocked or out of service</div></div>
  </div>
  <ul class='zcs-horizontal-tabhead'>
    <li class='zcs-horizontal-tabitem <%if(selectedArea == "All"){%>zcs-horizontal-tabactive<%}%>'><a class='zcs-horizontal-tablink' href='#Page:Live_Floor_Board?Area=All'><span>All areas</span><span class='zcs-horizontal-tabcount'><%=totalTables%></span></a></li>
    <%for each areaTab in Dining_Areas[Active == true] sort by Display_Order asc{%>
    <li class='zcs-horizontal-tabitem <%if(selectedArea == areaTab.Area_Name){%>zcs-horizontal-tabactive<%}%>'><a class='zcs-horizontal-tablink' href='#Page:Live_Floor_Board?Area=<%=encodeUrl(areaTab.Area_Name)%>'><span><%=areaTab.Area_Name%></span><span class='zcs-horizontal-tabcount'><%=Dining_Tables[Active == true && Dining_Area == areaTab.ID].count()%></span></a></li>
    <%}%>
  </ul>
  <div class='board-meta'>
    <div class='zcs-card legend-card'><strong class='zcs-font-14'>Table state legend</strong><ul class='legend-list'><li class='legend-item'><span class='legend-dot' style='background:#179E6C'></span>Available</li><li class='legend-item'><span class='legend-dot' style='background:#FE455D'></span>Occupied</li><li class='legend-item'><span class='legend-dot' style='background:#2A6FFC'></span>Reserved</li><li class='legend-item'><span class='legend-dot' style='background:#FAAE13'></span>Needs reset</li><li class='legend-item'><span class='legend-dot' style='background:#F4660C'></span>Blocked</li><li class='legend-item'><span class='legend-dot' style='background:#242424'></span>Out of service</li></ul></div>
    <%if(blockedCount > 0 || resetCount > 0){%><div class='zcs-toast'><i class='zc-li-outline travel-info'></i><div><strong>Floor attention</strong><br><%=blockedCount%> unavailable and <%=resetCount%> awaiting reset.</div></div><%}else{%><div class='zcs-card alerts-card'><i class='zc-li-outline ui-1-check-circle-08'></i> No blocked tables or reset backlog.</div><%}%>
  </div>
  <%
  renderedAreas = 0;
  for each area in Dining_Areas[Active == true] sort by Display_Order asc
  {
    if(selectedArea == "All" || selectedArea == area.Area_Name)
    {
      areaTables = Dining_Tables[Active == true && Dining_Area == area.ID];
      renderedAreas = renderedAreas + 1;
  %>
  <section class='area-section'>
    <div class='area-heading'><h2><%=area.Area_Name%></h2><span><%=areaTables.count()%> active tables</span></div>
    <div class='table-grid'>
      <%for each table in areaTables
      {
        state = table.Operational_Status;
        stateColor = "#179E6C"; stateBg = "#E4FCF3";
        if(state == "Occupied"){stateColor="#FE455D";stateBg="#FDE3E6";}else if(state == "Reserved"){stateColor="#2A6FFC";stateBg="#E8EFFF";}else if(state == "Needs Reset"){stateColor="#B8770D";stateBg="#FCF4E6";}else if(state == "Blocked"){stateColor="#F4660C";stateBg="#F8F0EB";}else if(state == "Out of Service"){stateColor="#242424";stateBg="#E8E8E8";}
        visitList = Dining_Visits[Dining_Table == table.ID && Visit_Status != "Closed" && Visit_Status != "Abandoned"] sort by Seated_Date_Time desc range from 1 to 1;
        partyText = "No active visit"; durationText = "Not seated"; posText = "Not available"; visitID = 0;
        for each visit in visitList
        {
          visitID = visit.ID;
          partyText = "Visit " + visit.Visit_Number + " / " + visit.Party_Size + " guests";
          elapsedMinutes = ((zoho.currenttime.toLong() - visit.Seated_Date_Time.toLong()) / 60000).round(0);
          elapsedHours = (elapsedMinutes / 60).floor();
          remainingMinutes = elapsedMinutes - (elapsedHours * 60);
          durationText = elapsedHours + "h " + remainingMinutes + "m";
          if(visit.POS_Check_ID != null && visit.POS_Check_ID != ""){posText = visit.POS_Check_ID;}
        }
        nextReservation = "None assigned"; reservationID = 0;
        reservationList = Reservations[Assigned_Table == table.ID && Reservation_Date_Time >= zoho.currenttime && (Reservation_Status == "Confirmed" || Reservation_Status == "Arrived" || Reservation_Status == "Tentative")] sort by Reservation_Date_Time asc range from 1 to 1;
        for each reservation in reservationList{nextReservation=reservation.Reservation_Date_Time.toString("h:mm a") + " / " + reservation.Party_Size + " guests";reservationID=reservation.ID;}
      %>
      <article class='zcs-card table-card' style='--state:<%=stateColor%>;--state-bg:<%=stateBg%>'>
        <div class='table-top'><div><div class='table-number'>Table <%=table.Table_Number%></div><div class='area-name'><%=area.Area_Name%> · capacity <%=table.Capacity%></div></div><span class='zcs-badge'><%=state%></span></div>
        <div class='table-body'>
          <div class='kv'><div class='kv-row'><label>Current party</label><span><%=partyText%></span></div><div class='kv-row'><label>Seated duration</label><span><%=durationText%></span></div><div class='kv-row'><label>Next reservation</label><span><%=nextReservation%></span></div><div class='kv-row'><label>POS check</label><span><%=posText%></span></div><%if(table.Block_Reason != null && table.Block_Reason != ""){%><div class='kv-row'><label>Reason</label><span><%=table.Block_Reason%></span></div><%}%></div>
          <div class='card-links'><a href='#Form:Dining_Tables?ID=<%=table.ID%>&zc_LoadIn=dialog'>Table record</a><%if(visitID != 0){%><a href='#Form:Dining_Visits?ID=<%=visitID%>&zc_LoadIn=dialog'>Visit record</a><%}%><%if(reservationID != 0){%><a href='#Form:Reservations?ID=<%=reservationID%>&zc_LoadIn=dialog'>Reservation record</a><%}%></div>
        </div>
      </article>
      <%}%>
      <%if(areaTables.count() == 0){%><div class='zcs-card empty'>No active tables in this area.</div><%}%>
    </div>
  </section>
  <%  }
  }
  if(renderedAreas == 0){%><div class='zcs-card empty'>No matching active dining area was found. Choose All areas.</div><%}%>
</div>