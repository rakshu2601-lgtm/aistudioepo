		    filters
		    (
		        Dining_Area
		        Table_Type
		        Operational_Status
		        Active
		    )
		    sort by
		    (
		        Table_Number ascending
		    )
		}

		list Available_Tables
		{
		    displayName = "Available Tables"
		    show all rows from Dining_Tables [Active == true && Operational_Status == "Available"]
		    (
		        Table_Number
		        Dining_Area
		        Capacity
		        Table_Type
		        Combinable
		        Combination_Group
		        Operational_Status
		        Active
		    )
		    filters
		    (
		        Dining_Area
		        Capacity
		        Table_Type
		    )
		    sort by
		    (
		        Capacity ascending
		        Table_Number ascending
		    )
		}

		kanban Live_Table_Status
		{
		    displayName = "Live Table Status"
		    show all rows from Dining_Tables [Active == true]
		    (
		        Table_Number
		        Dining_Area
		        Capacity
		        Table_Type
		        Operational_Status
		        Block_Reason
		        Active
		    )
		    filters
		    (
		        Dining_Area
		        Table_Type
		        Operational_Status
		    )
		    sort by
		    (
		        Table_Number ascending
		    )
		    options
		    (
		        display field = Operational_Status
		        filter type = manual
		        sort order = custom
		        record count = enable
		    )
		}

		default list All_Dining_Visits
		{
		 displayName = "All Dining Visits"
		 show all rows from Dining_Visits ( Visit_Number Guest Reservation Waitlist_Entry Dining_Table Party_Size Visit_Status Server_Name Seated_Date_Time Check_Requested_Date_Time Paid_Date_Time Closed_Date_Time POS_Check_ID POS_Check_Total POS_Sync_Status )
		 filters ( Visit_Status Dining_Table Server_Name POS_Sync_Status )
		 sort by ( Seated_Date_Time descending )
		}

		list Completed_Visits
		{
		 displayName = "Completed Visits"
		 show all rows from Dining_Visits [Visit_Status == "Closed" || Visit_Status == "Abandoned"] ( Visit_Number Guest Reservation Dining_Table Party_Size Visit_Status Server_Name Seated_Date_Time Paid_Date_Time Closed_Date_Time POS_Check_ID POS_Check_Total POS_Sync_Status )
		 filters ( Visit_Status Server_Name POS_Sync_Status )
		 sort by ( Closed_Date_Time descending )
		}

		kanban Live_Dining_Room
		{
		 displayName = "Live Dining Room"
		 show all rows from Dining_Visits [Visit_Status != "Closed" && Visit_Status != "Abandoned"] ( Visit_Number Guest Dining_Table Party_Size Visit_Status Server_Name Seated_Date_Time POS_Check_ID POS_Sync_Status )
		 filters ( Dining_Table Server_Name Visit_Status )
		 sort by ( Seated_Date_Time ascending )
		 options ( display field = Visit_Status filter type = manual sort order = custom record count = enable )
		}

		list POS_Check_Exceptions
		{
		 displayName = "POS Check Exceptions"
		 show all rows from Dining_Visits [POS_Sync_Status == "Failed" || ((Visit_Status == "Paid" || Visit_Status == "Closed") && POS_Check_ID == "")] ( Visit_Number Guest Dining_Table Visit_Status Server_Name Seated_Date_Time POS_Check_ID POS_Check_Total POS_Sync_Status Service_Notes )
		 filters ( Visit_Status POS_Sync_Status Server_Name )
		 sort by ( Seated_Date_Time descending )
		}

		default list All_Guest_Feedback
		{
		 displayName = "All Guest Feedback"
		 show all rows from Guest_Feedback ( Feedback_Number Guest Dining_Visit Feedback_Date_Time Overall_Rating Service_Rating Ambience_Rating Comments Would_Return Follow_Up_Required Follow_Up_Status Recovery_Action Manager_Notes )
		 filters ( Overall_Rating Would_Return Follow_Up_Status Follow_Up_Required )
		 sort by ( Feedback_Date_Time descending )
		}

		kanban Feedback_Follow_Up
		{
		 displayName = "Feedback Follow-up"
		 show all rows from Guest_Feedback [Follow_Up_Required == true] ( Feedback_Number Guest Dining_Visit Feedback_Date_Time Overall_Rating Comments Follow_Up_Required Follow_Up_Status Recovery_Action Manager_Notes )
		 filters ( Overall_Rating Follow_Up_Status )
		 sort by ( Feedback_Date_Time descending )
		 options ( display field = Follow_Up_Status filter type = manual sort order = custom record count = enable )
		}

		list Low_Rating_Feedback
		{
		 displayName = "Low Rating Feedback"
		 show all rows from Guest_Feedback [Overall_Rating <= 2] ( Feedback_Number Guest Dining_Visit Feedback_Date_Time Overall_Rating Service_Rating Ambience_Rating Comments Would_Return Follow_Up_Required Follow_Up_Status Recovery_Action Manager_Notes )
		 filters ( Follow_Up_Status Would_Return )
		 sort by ( Feedback_Date_Time descending )
		}

