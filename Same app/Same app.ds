		{
		 displayName = "Pending POS Sync"
		 show all rows from POS_Sync_Log [Sync_Status == "Pending" || Sync_Status == "Processing"] ( Sync_Number Entity_Type Local_Record_ID External_Record_ID Operation Direction Sync_Status Attempt_Count Last_Attempt_Date_Time Next_Retry_Date_Time Correlation_ID )
		 filters ( Entity_Type Operation Direction Sync_Status )
		 sort by ( Sync_Number ascending )
		}

		default list All_Reservations
		{
		 displayName = "All Reservations"
		 show all rows from Reservations ( Reservation_Number Guest Reservation_Date_Time Expected_End_Date_Time Service_Period Party_Size Assigned_Table Reservation_Status Booking_Source Occasion Special_Requests Arrival_Time Seated_Time Completed_Time POS_Sync_Status )
		 filters ( Reservation_Status Service_Period Assigned_Table Booking_Source )
		 sort by ( Reservation_Date_Time descending )
		}

		list Arrival_Exceptions
		{
		 displayName = "Arrival Exceptions"
		 show all rows from Reservations [Reservation_Status == "No Show" || (Reservation_Status == "Confirmed" && Reservation_Date_Time < zoho.currenttime)] ( Reservation_Number Guest Reservation_Date_Time Service_Period Party_Size Assigned_Table Reservation_Status Cancellation_Reason No_Show_Reason )
		 filters ( Reservation_Status Service_Period )
		 sort by ( Reservation_Date_Time descending )
		}

		calendar Reservation_Calendar
		{
		 displayName = "Reservation Calendar"
		 show all rows from Reservations ( Reservation_Number Guest Reservation_Date_Time Expected_End_Date_Time Service_Period Party_Size Assigned_Table Reservation_Status )
		 filters ( Service_Period Reservation_Status Assigned_Table )
		 options ( display type = week week start day = monday display field = Guest start date = Reservation_Date_Time end date = Expected_End_Date_Time default date ( day = Today month = Currentmonth year = Currentyear ) )
		}

		kanban Reservation_Status_Board
		{
		 displayName = "Reservation Status Board"
		 show all rows from Reservations ( Reservation_Number Guest Reservation_Date_Time Service_Period Party_Size Assigned_Table Reservation_Status )
		 filters ( Service_Period Assigned_Table Reservation_Status )
		 sort by ( Reservation_Date_Time ascending )
		 options ( display field = Reservation_Status filter type = manual sort order = custom record count = enable )
		}

