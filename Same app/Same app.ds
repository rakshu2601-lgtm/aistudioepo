/*
 * Author       : sathish.mjt0local
 * Generated on : 20-Aug-2026 22:12:49
 * Version      : 1.0
 */
application "Same-app"
{
	date format = "dd-MMM-yyyy"
	time zone = "UTC"
	time format = "24-hr"



	forms
	{
		form Audit_Log
		{
		 title { displayname = "Audit Log" on add = "Add Audit Event" on edit = "Edit Audit Event" }
		 Audit_Details ( type = section displayname = "Audit Details" row = 1 column = 0 )
		 Audit_Number ( type = autonumber displayname = "Audit Number" start index = 15001 row = 1 column = 1 )
		 must have Event_Date_Time ( type = datetime displayname = "Event Date & Time" initial value = "${zoho.currenttime}" row = 1 column = 1 width = medium )
		 must have Actor_Email ( type = email displayname = "Actor Email" row = 1 column = 2 width = medium )
		 must have Action_Type ( type = picklist displayname = "Action Type" values = {"Create","Update","Status Change","Assignment","Exception","Recovery","Sync Override"} row = 1 column = 1 width = medium )
		 must have Entity_Type ( type = text displayname = "Entity Type" row = 1 column = 2 width = medium )
		 must have Entity_Record_ID ( type = number displayname = "Entity Record ID" row = 1 column = 1 width = medium )
		 Entity_Reference ( type = text displayname = "Entity Reference" row = 1 column = 2 width = medium )
		 must have Change_Summary ( type = textarea displayname = "Change Summary" height = 100px row = 1 column = 1 width = medium )
		 Before_Value ( type = textarea displayname = "Before Value" height = 80px row = 1 column = 2 width = medium )
		 After_Value ( type = textarea displayname = "After Value" height = 80px row = 1 column = 1 width = medium )
		 must have Source ( type = picklist displayname = "Source" values = {"Form","Workflow","POS Staging","Manager Override"} row = 1 column = 2 width = medium )
		 actions { on add { Submit ( type = submit displayname = "Save Audit Event" ) Reset ( type = reset displayname = "Reset" ) } on edit { Update ( type = submit displayname = "Update Audit Event" ) Cancel ( type = cancel displayname = "Cancel" ) } }
		}

		form Dining_Areas
		{
		    title
		    {
		        displayname = "Dining Areas"
		        on add = "Add Dining Area"
		        on edit = "Edit Dining Area"
		    }
		    success message = "Dining area saved successfully."
		    Area_Details
		    (
		        type = section
		        displayname = "Area Details"
		        row = 1
		        column = 0
		    )
		    must have unique Area_Code
		    (
		        type = text
		        displayname = "Area Code"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Area_Name
		    (
		        type = text
		        displayname = "Area Name"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Description
		    (
		        type = textarea
		        displayname = "Description"
		        height = 80px
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Display_Order
		    (
		        type = number
		        displayname = "Display Order"
		        initial value = 1
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Area_Type
		    (
		        type = picklist
		        displayname = "Area Type"
		        values = {"Main Dining","Patio","Bar","Private Room","Counter","Other"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Area"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Area"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Dining_Tables
		{
		    title
		    {
		        displayname = "Dining Tables"
		        on add = "Add Dining Table"
		        on edit = "Edit Dining Table"
		    }
		    success message = "Dining table saved successfully."
		    Table_Details
		    (
		        type = section
		        displayname = "Table Details"
		        row = 1
		        column = 0
		    )
		    must have unique Table_Number
		    (
		        type = text
		        displayname = "Table Number"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Dining_Area
		    (
		        type = picklist
		        displayname = "Dining Area"
		        values = Dining_Areas[Active == true].ID
		        displayformat = [Area_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Capacity
		    (
		        type = number
		        displayname = "Capacity"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Table_Type
		    (
		        type = picklist
		        displayname = "Table Type"
		        values = {"Standard","Booth","High Top","Counter","Communal","Outdoor","Accessible"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Combination_Group
		    (
		        type = text
		        displayname = "Combination Group"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Combinable
		    (
		        type = checkbox
		        displayname = "Combinable"
		        initial value = false
		        row = 1
		        column = 2
		        width = medium
		    )
		    POS_Table_ID
		    (
		        type = text
		        displayname = "POS Table ID"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Operational_Status
		    (
		        type = picklist
		        displayname = "Operational Status"
		        values = {"Available","Reserved","Occupied","Needs Reset","Blocked","Out of Service"}
		        initial value = "Available"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Block_Reason
		    (
		        type = textarea
		        displayname = "Block Reason"
		        height = 80px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Table"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Table"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Dining_Visits
		{
		 title { displayname = "Dining Visits" on add = "Seat Dining Party" on edit = "Update Dining Visit" }
		 success message = "Dining visit saved successfully."
		 Visit_Details ( type = section displayname = "Visit Details" row = 1 column = 0 )
		 Visit_Number ( type = autonumber displayname = "Visit Number" start index = 9001 row = 1 column = 1 )
		 must have Guest ( type = picklist displayname = "Guest" values = Guests[Active == true].ID displayformat = [Guest_Name.first_name] searchable = true row = 1 column = 1 width = medium )
		 Reservation ( type = picklist displayname = "Reservation" values = Reservations.ID displayformat = [Reservation_Number] searchable = true row = 1 column = 2 width = medium )
		 Waitlist_Entry ( type = picklist displayname = "Waitlist Entry" values = Waitlist_Entries.ID displayformat = [Waitlist_Number] searchable = true row = 1 column = 1 width = medium )
		 must have Dining_Table ( type = picklist displayname = "Dining Table" values = Dining_Tables[Active == true].ID displayformat = [Table_Number] searchable = true row = 1 column = 2 width = medium )
		 must have Party_Size ( type = number displayname = "Party Size" row = 1 column = 1 width = medium )
		 must have Visit_Status ( type = picklist displayname = "Visit Status" values = {"Seated","Dining","Check Requested","Paid","Closed","Abandoned"} initial value = "Seated" row = 1 column = 2 width = medium )
		 Server_Name ( type = text displayname = "Server Name" row = 1 column = 1 width = medium )
		 must have Seated_Date_Time ( type = datetime displayname = "Seated Date & Time" initial value = "${zoho.currenttime}" row = 1 column = 2 width = medium )
		 Check_Requested_Date_Time ( type = datetime displayname = "Check Requested Time" row = 1 column = 1 width = medium )
		 Paid_Date_Time ( type = datetime displayname = "Paid Time" row = 1 column = 2 width = medium )
		 Closed_Date_Time ( type = datetime displayname = "Closed Time" row = 1 column = 1 width = medium )
		 POS_Context ( type = section displayname = "POS Context" visibility = true row = 2 column = 1 )
		 POS_Check_ID ( type = text displayname = "POS Check ID" row = 2 column = 1 width = medium )
		 POS_Check_Total ( type = decimal displayname = "POS Check Total" decimalplace = 2 row = 2 column = 2 width = medium )
		 POS_Sync_Status ( type = picklist displayname = "POS Sync Status" values = {"Pending","Synced","Failed","Manual"} initial value = "Pending" row = 2 column = 1 width = medium )
		 Service_Notes ( type = textarea displayname = "Service Notes" height = 80px row = 2 column = 2 width = medium )
		 actions { on add { Submit ( type = submit displayname = "Start Visit" ) Reset ( type = reset displayname = "Reset" ) } on edit { Update ( type = submit displayname = "Update Visit" ) Cancel ( type = cancel displayname = "Cancel" ) } }
		}

		form Guest_Feedback
		{
		 title { displayname = "Guest Feedback" on add = "Capture Guest Feedback" on edit = "Update Feedback Follow-up" }
		 success message = "Guest feedback saved successfully."
		 Feedback_Details ( type = section displayname = "Feedback Details" row = 1 column = 0 )
		 Feedback_Number ( type = autonumber displayname = "Feedback Number" start index = 11001 row = 1 column = 1 )
		 must have Guest ( type = picklist displayname = "Guest" values = Guests.ID displayformat = [Guest_Name.first_name] searchable = true row = 1 column = 1 width = medium )
		 must have Dining_Visit ( type = picklist displayname = "Dining Visit" values = Dining_Visits.ID displayformat = [Visit_Number] searchable = true row = 1 column = 2 width = medium )
		 must have Feedback_Date_Time ( type = datetime displayname = "Feedback Date & Time" initial value = "${zoho.currenttime}" row = 1 column = 1 width = medium )
		 must have Overall_Rating ( type = number displayname = "Overall Rating" row = 1 column = 2 width = medium )
		 must have Service_Rating ( type = number displayname = "Service Rating" row = 1 column = 1 width = medium )
		 must have Ambience_Rating ( type = number displayname = "Ambience Rating" row = 1 column = 2 width = medium )
		 Comments ( type = textarea displayname = "Comments" height = 100px row = 1 column = 1 width = medium )
		 Would_Return ( type = picklist displayname = "Would Return" values = {"Yes","Maybe","No"} row = 1 column = 2 width = medium )
		 Follow_Up_Required ( type = checkbox displayname = "Follow-up Required" initial value = false row = 1 column = 1 width = medium )
		 Follow_Up_Status ( type = picklist displayname = "Follow-up Status" values = {"Not Required","Open","In Progress","Resolved"} initial value = "Not Required" row = 1 column = 2 width = medium )
		 Recovery_Action ( type = textarea displayname = "Recovery Action" height = 80px row = 1 column = 1 width = medium )
		 Manager_Notes ( type = textarea displayname = "Manager Notes" height = 80px row = 1 column = 2 width = medium )
		 actions { on add { Submit ( type = submit displayname = "Save Feedback" ) Reset ( type = reset displayname = "Reset" ) } on edit { Update ( type = submit displayname = "Update Follow-up" ) Cancel ( type = cancel displayname = "Cancel" ) } }
		}

		form Guests
		{
		    title
		    {
		        displayname = "Guests"
		        on add = "Add Guest"
		        on edit = "Edit Guest Profile"
		    }
		    success message = "Guest profile saved successfully."
		    Guest_Profile
		    (
		        type = section
		        displayname = "Guest Profile"
		        row = 1
		        column = 0
		    )
		    Guest_Number
		    (
		        type = autonumber
		        displayname = "Guest Number"
		        start index = 1001
		        row = 1
		        column = 1
		    )
		    must have Guest_Name
		    (
		        type = name
		        displayname = "Guest Name"
		        personal data = true
		        prefix
		        (
		            type = prefix
		            displayname = "Title"
		            value = {"Mr.","Mrs.","Ms.","Dr."}
		        )
		        first_name
		        (
		            type = first_name
		            displayname = "First Name"
		        )
		        last_name
		        (
		            type = last_name
		            displayname = "Last Name"
		        )
		        suffix
		        (
		            type = suffix
		            displayname = "Suffix"
		            visibility = false
		        )
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Mobile_Number
		    (
		        type = phonenumber
		        displayname = "Mobile Number"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Email_Address
		    (
		        type = email
		        displayname = "Email Address"
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Preferred_Contact_Method
		    (
		        type = picklist
		        displayname = "Preferred Contact Method"
		        values = {"Phone","SMS","Email","WhatsApp","None"}
		        initial value = "Phone"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Contact_Consent
		    (
		        type = checkbox
		        displayname = "Contact Consent"
		        initial value = false
		        row = 1
		        column = 1
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Guest_Preferences
		    (
		        type = section
		        displayname = "Dining Preferences"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Dietary_Preferences
		    (
		        type = checkboxes
		        displayname = "Dietary Preferences"
		        values = {"Vegetarian","Vegan","Halal","Kosher","Gluten Free","Dairy Free","Nut Free","Other"}
		        layout = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    Allergy_Notes
		    (
		        type = textarea
		        displayname = "Allergy Notes"
		        personal data = true
		        height = 80px
		        row = 2
		        column = 2
		        width = medium
		    )
		    Seating_Preferences
		    (
		        type = checkboxes
		        displayname = "Seating Preferences"
		        values = {"Booth","Quiet Area","Patio","Accessible","High Chair","Bar","No Preference"}
		        layout = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    VIP_Guest
		    (
		        type = checkbox
		        displayname = "VIP Guest"
		        initial value = false
		        row = 2
		        column = 2
		        width = medium
		    )
		    Total_Visits
		    (
		        type = number
		        displayname = "Total Visits"
		        initial value = 0
		        row = 2
		        column = 1
		        width = medium
		    )
		    No_Show_Count
		    (
		        type = number
		        displayname = "No-show Count"
		        initial value = 0
		        row = 2
		        column = 2
		        width = medium
		    )
		    Last_Visit_Date
		    (
		        type = date
		        displayname = "Last Visit Date"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Guest_Notes
		    (
		        type = textarea
		        displayname = "Guest Notes"
		        personal data = true
		        height = 80px
		        row = 2
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Guest"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Guest"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form POS_Sync_Log
		{
		 title { displayname = "POS Sync Log" on add = "Add POS Sync Entry" on edit = "Update POS Sync Entry" }
		 success message = "POS staging entry saved."
		 Sync_Details ( type = section displayname = "Sync Details" row = 1 column = 0 )
		 Sync_Number ( type = autonumber displayname = "Sync Number" start index = 13001 row = 1 column = 1 )
		 must have Entity_Type ( type = picklist displayname = "Entity Type" values = {"Reservation","Table","Dining Visit","Guest"} row = 1 column = 1 width = medium )
		 must have Local_Record_ID ( type = number displayname = "Local Record ID" row = 1 column = 2 width = medium )
		 External_Record_ID ( type = text displayname = "External Record ID" row = 1 column = 1 width = medium )
		 must have Operation ( type = picklist displayname = "Operation" values = {"Create","Update","Status Sync","Lookup"} row = 1 column = 2 width = medium )
		 must have Direction ( type = picklist displayname = "Direction" values = {"Outbound","Inbound","Bidirectional"} row = 1 column = 1 width = medium )
		 must have Sync_Status ( type = picklist displayname = "Sync Status" values = {"Pending","Processing","Synced","Failed","Ignored"} initial value = "Pending" row = 1 column = 2 width = medium )
		 Attempt_Count ( type = number displayname = "Attempt Count" initial value = 0 row = 1 column = 1 width = medium )
		 Last_Attempt_Date_Time ( type = datetime displayname = "Last Attempt" row = 1 column = 2 width = medium )
		 Next_Retry_Date_Time ( type = datetime displayname = "Next Retry" row = 1 column = 1 width = medium )
		 Request_Payload ( type = textarea displayname = "Request Payload" height = 100px row = 1 column = 2 width = medium )
		 Response_Payload ( type = textarea displayname = "Response Payload" height = 100px row = 1 column = 1 width = medium )
		 Error_Message ( type = textarea displayname = "Error Message" height = 80px row = 1 column = 2 width = medium )
		 Correlation_ID ( type = text displayname = "Correlation ID" row = 1 column = 1 width = medium )
		 actions { on add { Submit ( type = submit displayname = "Save Staging Entry" ) Reset ( type = reset displayname = "Reset" ) } on edit { Update ( type = submit displayname = "Update Staging Entry" ) Cancel ( type = cancel displayname = "Cancel" ) } }
		}

		form Reservations
		{
		 title { displayname = "Reservations" on add = "Add Reservation" on edit = "Edit Reservation" }
		 success message = "Reservation saved successfully."
		 Reservation_Details ( type = section displayname = "Reservation Details" row = 1 column = 0 )
		 Reservation_Number ( type = autonumber displayname = "Reservation Number" start index = 5001 row = 1 column = 1 )
		 must have Guest ( type = picklist displayname = "Guest" values = Guests[Active == true].ID displayformat = [Guest_Name.first_name] searchable = true row = 1 column = 1 width = medium )
		 must have Reservation_Date_Time ( type = datetime displayname = "Reservation Date & Time" row = 1 column = 2 width = medium )
		 Expected_End_Date_Time ( type = datetime displayname = "Expected End" row = 1 column = 1 width = medium )
		 must have Service_Period ( type = picklist displayname = "Service Period" values = Service_Periods[Active == true].ID displayformat = [Service_Name] searchable = true row = 1 column = 2 width = medium )
		 must have Party_Size ( type = number displayname = "Party Size" row = 1 column = 1 width = medium )
		 Assigned_Table ( type = picklist displayname = "Assigned Table" values = Dining_Tables[Active == true].ID displayformat = [Table_Number] searchable = true row = 1 column = 2 width = medium )
		 must have Reservation_Status ( type = picklist displayname = "Reservation Status" values = {"Tentative","Confirmed","Arrived","Seated","Completed","Cancelled","No Show"} initial value = "Confirmed" row = 1 column = 1 width = medium )
		 must have Booking_Source ( type = picklist displayname = "Booking Source" values = {"Phone","Walk In Advance","Website","Concierge","Social","POS","Other"} row = 1 column = 2 width = medium )
		 Occasion ( type = picklist displayname = "Occasion" values = {"None","Birthday","Anniversary","Business","Date Night","Celebration","Other"} initial value = "None" row = 1 column = 1 width = medium )
		 Special_Requests ( type = textarea displayname = "Special Requests" height = 80px row = 1 column = 2 width = medium )
		 Internal_Notes ( type = textarea displayname = "Internal Notes" height = 80px row = 1 column = 1 width = medium )
		 Lifecycle ( type = section displayname = "Lifecycle & POS" visibility = true row = 2 column = 1 )
		 Arrival_Time ( type = datetime displayname = "Arrival Time" row = 2 column = 1 width = medium )
		 Seated_Time ( type = datetime displayname = "Seated Time" row = 2 column = 2 width = medium )
		 Completed_Time ( type = datetime displayname = "Completed Time" row = 2 column = 1 width = medium )
		 Cancellation_Time ( type = datetime displayname = "Cancellation Time" row = 2 column = 2 width = medium )
		 Cancellation_Reason ( type = textarea displayname = "Cancellation Reason" height = 80px row = 2 column = 1 width = medium )
		 No_Show_Reason ( type = textarea displayname = "No-show Reason" height = 80px row = 2 column = 2 width = medium )
		 POS_Reservation_ID ( type = text displayname = "POS Reservation ID" row = 2 column = 1 width = medium )
		 POS_Sync_Status ( type = picklist displayname = "POS Sync Status" values = {"Not Required","Pending","Synced","Failed"} initial value = "Pending" row = 2 column = 2 width = medium )
		 actions { on add { Submit ( type = submit displayname = "Save Reservation" ) Reset ( type = reset displayname = "Reset" ) } on edit { Update ( type = submit displayname = "Update Reservation" ) Cancel ( type = cancel displayname = "Cancel" ) } }
		}

		form Restaurant_Settings
		{
		    title
		    {
		        displayname = "Restaurant Settings"
		        on add = "Configure Restaurant"
		        on edit = "Update Restaurant Settings"
		    }
		    success message = "Restaurant settings saved successfully."
		    Settings_Section
		    (
		        type = section
		        displayname = "Venue Configuration"
		        row = 1
		        column = 0
		    )
		    must have Restaurant_Name
		    (
		        type = text
		        displayname = "Restaurant Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Venue_Code
		    (
		        type = text
		        displayname = "Venue Code"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Contact_Email
		    (
		        type = email
		        displayname = "Contact Email"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Contact_Phone
		    (
		        type = phonenumber
		        displayname = "Contact Phone"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Venue_Address
		    (
		        type = address
		        displayname = "Venue Address"
		        capture_coordinates = true
		        adjust_using_map = true
		        address_line_1
		        (
		            type = address_line_1
		            displayname = "Street Address"
		        )
		        address_line_2
		        (
		            type = address_line_2
		            displayname = "Address Line 2"
		        )
		        district_city
		        (
		            type = district_city
		            displayname = "City"
		        )
		        state_province
		        (
		            type = state_province
		            displayname = "State / Province"
		        )
		        postal_Code
		        (
		            type = postal_Code
		            displayname = "Postal Code"
		        )
		        country
		        (
		            type = country
		            displayname = "Country"
		        )
		        latitude
		        (
		            type = latitude
		            displayname = "Latitude"
		            visibility = false
		        )
		        longitude
		        (
		            type = longitude
		            displayname = "Longitude"
		            visibility = false
		        )
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Time_Zone
		    (
		        type = picklist
		        displayname = "Time Zone"
		        values = {"Asia/Kolkata","Asia/Dubai","Europe/London","America/New_York","America/Chicago","America/Los_Angeles","Other"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Currency_Code
		    (
		        type = picklist
		        displayname = "Currency Code"
		        values = {"INR","USD","GBP","EUR","AED"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Default_Reservation_Duration_Minutes
		    (
		        type = number
		        displayname = "Default Reservation Duration (Minutes)"
		        initial value = 90
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Table_Turn_Buffer_Minutes
		    (
		        type = number
		        displayname = "Table Turn Buffer (Minutes)"
		        initial value = 15
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Arrival_Grace_Period_Minutes
		    (
		        type = number
		        displayname = "Arrival Grace Period (Minutes)"
		        initial value = 15
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Default_Wait_Quote_Minutes
		    (
		        type = number
		        displayname = "Default Wait Quote (Minutes)"
		        initial value = 20
		        row = 1
		        column = 2
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Settings"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Settings"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Service_Periods
		{
		    title
		    {
		        displayname = "Service Periods"
		        on add = "Add Service Period"
		        on edit = "Edit Service Period"
		    }
		    success message = "Service period saved successfully."
		    Service_Details
		    (
		        type = section
		        displayname = "Service Details"
		        row = 1
		        column = 0
		    )
		    must have Service_Name
		    (
		        type = text
		        displayname = "Service Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Service_Code
		    (
		        type = text
		        displayname = "Service Code"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Days_Of_Week
		    (
		        type = checkboxes
		        displayname = "Days of Week"
		        values = {"Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"}
		        layout = 2
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Start_Time
		    (
		        type = time
		        displayname = "Start Time"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have End_Time
		    (
		        type = time
		        displayname = "End Time"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Last_Seating_Time
		    (
		        type = time
		        displayname = "Last Seating Time"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Booking_Interval_Minutes
		    (
		        type = number
		        displayname = "Booking Interval (Minutes)"
		        initial value = 15
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Default_Duration_Minutes
		    (
		        type = number
		        displayname = "Default Duration (Minutes)"
		        initial value = 90
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Maximum_Covers
		    (
		        type = number
		        displayname = "Maximum Covers"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Service"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Service"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Waitlist_Entries
		{
		 title { displayname = "Waitlist Entries" on add = "Add Walk-in Party" on edit = "Update Waitlist Entry" }
		 success message = "Waitlist entry saved successfully."
		 Waitlist_Details ( type = section displayname = "Waitlist Details" row = 1 column = 0 )
		 Waitlist_Number ( type = autonumber displayname = "Waitlist Number" start index = 7001 row = 1 column = 1 )
		 must have Guest ( type = picklist displayname = "Guest" values = Guests[Active == true].ID displayformat = [Guest_Name.first_name] searchable = true row = 1 column = 1 width = medium )
		 must have Party_Size ( type = number displayname = "Party Size" row = 1 column = 2 width = medium )
		 must have Joined_Date_Time ( type = datetime displayname = "Joined Date & Time" initial value = "${zoho.currenttime}" row = 1 column = 1 width = medium )
		 Preferred_Area ( type = picklist displayname = "Preferred Area" values = Dining_Areas[Active == true].ID displayformat = [Area_Name] searchable = true row = 1 column = 2 width = medium )
		 must have Quoted_Wait_Minutes ( type = number displayname = "Quoted Wait (Minutes)" row = 1 column = 1 width = medium )
		 must have Waitlist_Status ( type = picklist displayname = "Waitlist Status" values = {"Waiting","Notified","Arrived","Seated","Removed","Expired"} initial value = "Waiting" row = 1 column = 2 width = medium )
		 must have Priority ( type = picklist displayname = "Priority" values = {"Standard","VIP","Accessibility","Manager Priority"} initial value = "Standard" row = 1 column = 1 width = medium )
		 Notification_Method ( type = picklist displayname = "Notification Method" values = {"In Person","Phone","SMS","WhatsApp"} initial value = "In Person" row = 1 column = 2 width = medium )
		 Offered_Date_Time ( type = datetime displayname = "Offered Date & Time" row = 1 column = 1 width = medium )
		 Seated_Date_Time ( type = datetime displayname = "Seated Date & Time" row = 1 column = 2 width = medium )
		 Related_Reservation ( type = picklist displayname = "Related Reservation" values = Reservations.ID displayformat = [Reservation_Number] searchable = true row = 1 column = 1 width = medium )
		 Assigned_Table ( type = picklist displayname = "Assigned Table" values = Dining_Tables[Active == true].ID displayformat = [Table_Number] searchable = true row = 1 column = 2 width = medium )
		 Notes ( type = textarea displayname = "Notes" height = 80px row = 1 column = 1 width = medium )
		 Removal_Reason ( type = textarea displayname = "Removal Reason" height = 80px row = 1 column = 2 width = medium )
		 actions { on add { Submit ( type = submit displayname = "Add to Waitlist" ) Reset ( type = reset displayname = "Reset" ) } on edit { Update ( type = submit displayname = "Update Entry" ) Cancel ( type = cancel displayname = "Cancel" ) } }
		}
	}

	reports
	{
		default list Audit_Trail
		{
		 displayName = "Audit Trail"
		 show all rows from Audit_Log ( Audit_Number Event_Date_Time Actor_Email Action_Type Entity_Type Entity_Record_ID Entity_Reference Change_Summary Before_Value After_Value Source )
		 filters ( Action_Type Entity_Type Source Actor_Email )
		 sort by ( Event_Date_Time descending )
		}

		list Operational_Exceptions
		{
		 displayName = "Operational Exceptions"
		 show all rows from Audit_Log [Action_Type == "Exception" || Action_Type == "Recovery" || Action_Type == "Sync Override"] ( Audit_Number Event_Date_Time Actor_Email Action_Type Entity_Type Entity_Record_ID Entity_Reference Change_Summary Before_Value After_Value Source )
		 filters ( Action_Type Entity_Type Source Actor_Email )
		 sort by ( Event_Date_Time descending )
		}

		list Active_Dining_Areas
		{
		    displayName = "Active Dining Areas"
		    show all rows from Dining_Areas [Active == true]
		    (
		        Area_Code
		        Area_Name
		        Area_Type
		        Description
		        Display_Order
		        Active
		    )
		    filters
		    (
		        Area_Type
		    )
		    sort by
		    (
		        Display_Order ascending
		        Area_Name ascending
		    )
		}

		default list All_Dining_Areas
		{
		    displayName = "All Dining Areas"
		    show all rows from Dining_Areas
		    (
		        Area_Code
		        Area_Name
		        Area_Type
		        Description
		        Display_Order
		        Active
		    )
		    filters
		    (
		        Area_Type
		        Active
		    )
		    sort by
		    (
		        Display_Order ascending
		        Area_Name ascending
		    )
		}

		default list All_Dining_Tables
		{
		    displayName = "All Dining Tables"
