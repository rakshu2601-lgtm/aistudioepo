		{
		 displayName = "Failed POS Sync"
		 show all rows from POS_Sync_Log [Sync_Status == "Failed"] ( Sync_Number Entity_Type Local_Record_ID External_Record_ID Operation Direction Sync_Status Attempt_Count Last_Attempt_Date_Time Next_Retry_Date_Time Error_Message Correlation_ID )
		 filters ( Entity_Type Operation Direction )
		 sort by ( Last_Attempt_Date_Time descending )
		}

		kanban POS_Sync_Status_Board
		{
		 displayName = "POS Sync Status Board"
		 show all rows from POS_Sync_Log ( Sync_Number Entity_Type Local_Record_ID External_Record_ID Operation Direction Sync_Status Attempt_Count Last_Attempt_Date_Time Error_Message )
		 filters ( Entity_Type Operation Direction Sync_Status )
		 sort by ( Sync_Number descending )
		 options ( display field = Sync_Status filter type = manual sort order = custom record count = enable )
