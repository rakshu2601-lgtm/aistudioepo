	                Visit_Number{visibility:true,readonly:true} Guest{visibility:true,readonly:true} Reservation{visibility:true,readonly:true} Waitlist_Entry{visibility:true,readonly:true} Dining_Table{visibility:true,readonly:true} Party_Size{visibility:true,readonly:true} Visit_Status{visibility:true,readonly:false} Server_Name{visibility:true,readonly:false} Seated_Date_Time{visibility:true,readonly:true} Check_Requested_Date_Time{visibility:true,readonly:true} Paid_Date_Time{visibility:true,readonly:true} Closed_Date_Time{visibility:true,readonly:true} POS_Check_ID{visibility:true,readonly:false} POS_Check_Total{visibility:true,readonly:true} POS_Sync_Status{visibility:true,readonly:true} Service_Notes{visibility:true,readonly:false}
	            }
	            ReportPermissions { All_Dining_Visits={"View","Edit"} Live_Dining_Room={"View","Edit"} Completed_Visits={"View"} }
	        }
	        Guest_Feedback
	        {
	            enabled = Create,Viewall,Tab,View,Search
	            allFieldsVisible = false
	            FieldPermissions
	            {
	                Feedback_Number{visibility:true,readonly:true} Guest{visibility:true,readonly:false} Dining_Visit{visibility:true,readonly:false} Feedback_Date_Time{visibility:true,readonly:false} Overall_Rating{visibility:true,readonly:false} Service_Rating{visibility:true,readonly:false} Ambience_Rating{visibility:true,readonly:false} Comments{visibility:true,readonly:false} Would_Return{visibility:true,readonly:false} Follow_Up_Required{visibility:true,readonly:true} Follow_Up_Status{visibility:true,readonly:true} Recovery_Action{visibility:false} Manager_Notes{visibility:false}
	            }
	            ReportPermissions { All_Guest_Feedback={"View"} }
	        }
	        Host_Operations { enabled = tab }
	        Live_Floor_Board { enabled = tab }
	    }
	}
	}

