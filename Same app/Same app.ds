		 displayName = "Live Waitlist"
		 show all rows from Waitlist_Entries [Waitlist_Status != "Removed" && Waitlist_Status != "Expired"] ( Waitlist_Number Guest Party_Size Joined_Date_Time Preferred_Area Quoted_Wait_Minutes Waitlist_Status Priority Assigned_Table )
		 filters ( Priority Preferred_Area Waitlist_Status )
		 sort by ( Joined_Date_Time ascending )
		 options ( display field = Waitlist_Status filter type = manual sort order = custom record count = enable )
		}
	}

	pages
	{
		page FOH_Manager_Dashboard
		{
					displayname = "FOH Manager Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='FOH_Manager_Dashboard_Snippet' elementName='FOH Manager Dashboard'>\n\t\t\t\t\t<![CDATA[htmlpage FOH_Manager_Dashboard_Snippet()\ncontent\n&lt;%{%&gt;\n&lt;%\ntoday = zoho.currentdate;\nnow = zoho.currenttime;\ndayStart = today.toDateTime();\ndayEnd = dayStart.addDay(1);\nsettingsGrace = 15;\nfor each setting in Restaurant_Settings[Active == true]\n{\n\t\tsettingsGrace = setting.Arrival_Grace_Period_Minutes;\n}\ntodayReservations = Reservations[Reservation_Date_Time &gt;= dayStart &amp;&amp; Reservation_Date_Time &lt; dayEnd];\nreservationCount = todayReservations.count();\nexpectedCovers = ifnull(todayReservations.sum(Party_Size),0);\nwalkIns = Waitlist_Entries[Joined_Date_Time &gt;= dayStart &amp;&amp; Joined_Date_Time &lt; dayEnd];\nwalkInCount = walkIns.count();\nnoShowCount = Reservations[Reservation_Date_Time &gt;= dayStart &amp;&amp; Reservation_Date_Time &lt; dayEnd &amp;&amp; Reservation_Status == &quot;No Show&quot;].count();\nquotedTotal = 0;\nquotedCount = 0;\nactualTotal = 0;\nactualCount = 0;\nfor each waitMetric in walkIns\n{\n\t\tquotedTotal = quotedTotal + ifnull(waitMetric.Quoted_Wait_Minutes,0);\n\t\tquotedCount = quotedCount + 1;\n\t\tif(waitMetric.Seated_Date_Time != null)\n\t\t{\n\t\t\t\tactualTotal = actualTotal + ((waitMetric.Seated_Date_Time - waitMetric.Joined_Date_Time) / 60000);\n\t\t\t\tactualCount = actualCount + 1;\n\t\t}\n}\navgQuoted = if(quotedCount &gt; 0,(quotedTotal / quotedCount).round(0),0);\navgActualText = &quot;Not yet derivable&quot;;\nif(actualCount &gt; 0)\n{\n\t\tavgActualText = (actualTotal / actualCount).round(0) + &quot; min&quot;;\n}\noccupiedCount = Dining_Tables[Active == true &amp;&amp; Operational_Status == &quot;Occupied&quot;].count();\navailableCount = Dining_Tables[Active == true &amp;&amp; Operational_Status == &quot;Available&quot;].count();\nresetCount = Dining_Tables[Active == true &amp;&amp; Operational_Status == &quot;Needs Reset&quot;].count();\ncompletedVisits = Dining_Visits[Closed_Date_Time &gt;= dayStart &amp;&amp; Closed_Date_Time &lt; dayEnd &amp;&amp; (Visit_Status == &quot;Closed&quot; || Visit_Status == &quot;Paid&quot;)].count();\ntodayFeedback = Guest_Feedback[Feedback_Date_Time &gt;= dayStart &amp;&amp; Feedback_Date_Time &lt; dayEnd];\navgRating = ifnull(todayFeedback.avg(Overall_Rating),0).round(1);\nactiveWaits = Waitlist_Entries[Waitlist_Status == &quot;Waiting&quot; || Waitlist_Status == &quot;Notified&quot; || Waitlist_Status == &quot;Arrived&quot;] sort by Joined_Date_Time asc;\nlateArrivals = Reservations[Reservation_Date_Time &gt;= dayStart &amp;&amp; Reservation_Date_Time &lt; now.subMinutes(settingsGrace) &amp;&amp; Reservation_Status == &quot;Confirmed&quot;] sort by Reservation_Date_Time asc;\nlowFeedback = Guest_Feedback[Overall_Rating &lt;= 2 &amp;&amp; Follow_Up_Status != &quot;Resolved&quot; &amp;&amp; Follow_Up_Status != &quot;Not Required&quot;] sort by Feedback_Date_Time asc;\nposPending = POS_Sync_Log[Sync_Status == &quot;Pending&quot; || Sync_Status == &quot;Processing&quot;].count();\nposFailed = POS_Sync_Log[Sync_Status == &quot;Failed&quot;].count();\nrecentAudit = Audit_Log[Event_Date_Time &gt;= now.subDay(7) &amp;&amp; (Action_Type == &quot;Exception&quot; || Action_Type == &quot;Recovery&quot; || Action_Type == &quot;Sync Override&quot;)] sort by Event_Date_Time desc;\nreservationStatuses = {&quot;Tentative&quot;,&quot;Confirmed&quot;,&quot;Arrived&quot;,&quot;Seated&quot;,&quot;Completed&quot;,&quot;Cancelled&quot;,&quot;No Show&quot;};\ntableStatuses = {&quot;Available&quot;,&quot;Reserved&quot;,&quot;Occupied&quot;,&quot;Needs Reset&quot;,&quot;Blocked&quot;,&quot;Out of Service&quot;};\nmaxReservationStatus = 1;\nfor each rs0 in reservationStatuses\n{\n\t\trsCount0 = Reservations[Reservation_Date_Time &gt;= dayStart &amp;&amp; Reservation_Date_Time &lt; dayEnd &amp;&amp; Reservation_Status == rs0].count();\n\t\tif(rsCount0 &gt; maxReservationStatus){maxReservationStatus = rsCount0;}\n}\nmaxTableStatus = 1;\nfor each ts0 in tableStatuses\n{\n\t\ttsCount0 = Dining_Tables[Active == true &amp;&amp; Operational_Status == ts0].count();\n\t\tif(tsCount0 &gt; maxTableStatus){maxTableStatus = tsCount0;}\n}\nisAllowed = true;\n%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#f3f3f4;--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color)}\n*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:4px}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-w-full{width:100%}.zcs-p-0{padding:0}.zcs-p-8{padding:8px}.zcs-p-12{padding:12px}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-px-30{padding-left:30px;padding-right:30px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-10{padding-top:10px;padding-bottom:10px}.zcs-py-24{padding-top:24px;padding-bottom:24px}.zcs-m-0{margin:0}.zcs-font-11{font-size:11px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-22{font-size:22px}.zcs-font-24{font-size:24px}.zcs-font-28{font-size:28px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-color-red{color:#fe455d}.zcs-color-yellow{color:#9a6508}.zcs-color-green{color:#179e6c}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-xl{border-radius:12px}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.zcs-page{padding:18px;background:var(--zcs-page-bg-color);color:var(--zcs-primary-text-color);font-family:inherit}.zcs-page-header{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;margin-bottom:16px}.zcs-header-copy{min-width:260px}.zcs-header-actions{flex-wrap:wrap}.zcs-button{width:auto;min-width:5rem;min-height:36px;text-decoration:none}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color);border:1px solid var(--zcs_brand_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-kpis{display:grid;grid-template-columns:repeat(5,minmax(150px,1fr));gap:12px;margin-bottom:16px}.zcs-kpi-card{min-height:112px}.zcs-kpi-icon{width:38px;height:38px;border-radius:10px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);flex:0 0 auto}.zcs-main-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:16px;margin-bottom:16px}.zcs-three-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-bottom:16px}.zcs-section-title{margin-bottom:12px}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#147c57}.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#c82e43}.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#9a6508}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#245ac4}.zcs-badge-grey{background:#e8e8e8;border-color:#555;color:#333}.zcs-badge-orange{background:#f8f0eb;border-color:#f4660c;color:#bd4d08}.zcs-progress-list{display:flex;flex-direction:column;gap:12px}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color);border-radius:4px;overflow:hidden}.zcs-progress-bar-indicator{height:100%;background:var(--zcs_brand_color);border-radius:inherit}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:var(--zcs-white-color);overflow:auto;border-radius:6px;max-height:340px}.zcs-table-wrapper table{border-collapse:collapse;min-width:620px}.zcs-table-wrapper thead{position:sticky;top:0;z-index:1}.zcs-table-wrapper th{background:#f9fafe;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tbody tr:hover td{background:#f9fafe}.zcs-empty{padding:18px;text-align:center;color:var(--zcs-teritiary-text-color)}.zcs-service-row{padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:8px}.zcs-quick-actions-wrapper ul{display:grid;grid-template-columns:repeat(5,minmax(150px,1fr));gap:8px}.zcs-quick-action-item{list-style:none}.zcs-quick-action-item:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-link{text-decoration:none}.zcs-pos-note{border-left:4px solid #2a6ffc;background:#e8efff}.zcs-denied{max-width:560px;margin:60px auto;text-align:center}@media(max-width:1200px){.zcs-kpis{grid-template-columns:repeat(3,1fr)}.zcs-three-grid{grid-template-columns:1fr 1fr}.zcs-quick-actions-wrapper ul{grid-template-columns:repeat(3,1fr)}}@media(max-width:850px){.zcs-main-grid,.zcs-three-grid{grid-template-columns:1fr}.zcs-kpis{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.zcs-page{padding:10px}.zcs-page-header{padding:16px}.zcs-header-actions{width:100%}.zcs-kpis{grid-template-columns:1fr}.zcs-quick-actions-wrapper ul{grid-template-columns:1fr}}\n&lt;/style&gt;\n&lt;% if(!isAllowed) { %&gt;\n&lt;div class=&apos;zcs-page&apos;&gt;&lt;div class=&apos;zcs-denied zcs-card zcs-p-20&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-lock zcs-font-28 zcs-color-red&apos;&gt;&lt;/i&gt;&lt;h2 class=&apos;zcs-font-22&apos;&gt;Manager access required&lt;/h2&gt;&lt;p class=&apos;zcs-color-secondary&apos;&gt;This operating dashboard is restricted to FOH Managers and Administrators.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;% } else { %&gt;\n&lt;div class=&apos;zcs-page&apos;&gt;\n\t&lt;header class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-24&apos;&gt;\n\t\t&lt;div class=&apos;zcs-header-copy&apos;&gt;&lt;h1 class=&apos;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-m-0&apos;&gt;FOH Manager Dashboard&lt;/h1&gt;&lt;div class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;&lt;%=today.toString(&quot;EEEE, dd MMMM yyyy&quot;)%&gt; · shift oversight · updated &lt;%=now.toString(&quot;hh:mm a&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-header-actions zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Report:Todays_Reservations&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-60&apos;&gt;&lt;/i&gt;&lt;span&gt;Today&apos;s reservations&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Report:Live_Table_Status&apos;&gt;&lt;i class=&apos;zc-li-outline furniture-table&apos;&gt;&lt;/i&gt;&lt;span&gt;Live tables&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t&lt;/header&gt;\n\t&lt;div class=&apos;zcs-kpis&apos;&gt;\n&lt;%\nmetrics = List();\nmetrics.add({&quot;label&quot;:&quot;Reservations&quot;,&quot;value&quot;:reservationCount,&quot;icon&quot;:&quot;ui-1-calendar-60&quot;});\nmetrics.add({&quot;label&quot;:&quot;Expected covers&quot;,&quot;value&quot;:expectedCovers,&quot;icon&quot;:&quot;users-single-01&quot;});\nmetrics.add({&quot;label&quot;:&quot;Walk-ins&quot;,&quot;value&quot;:walkInCount,&quot;icon&quot;:&quot;arrows-1-log-in&quot;});\nmetrics.add({&quot;label&quot;:&quot;No-shows&quot;,&quot;value&quot;:noShowCount,&quot;icon&quot;:&quot;ui-1-simple-remove&quot;});\nmetrics.add({&quot;label&quot;:&quot;Average quoted wait&quot;,&quot;value&quot;:avgQuoted + &quot; min&quot;,&quot;icon&quot;:&quot;ui-2-time&quot;});\nmetrics.add({&quot;label&quot;:&quot;Average actual wait&quot;,&quot;value&quot;:avgActualText,&quot;icon&quot;:&quot;ui-1-check-circle-08&quot;});\nmetrics.add({&quot;label&quot;:&quot;Occupied tables&quot;,&quot;value&quot;:occupiedCount,&quot;icon&quot;:&quot;furniture-table&quot;});\nmetrics.add({&quot;label&quot;:&quot;Available tables&quot;,&quot;value&quot;:availableCount,&quot;icon&quot;:&quot;ui-1-check-circle-08&quot;});\nmetrics.add({&quot;label&quot;:&quot;Needs reset&quot;,&quot;value&quot;:resetCount,&quot;icon&quot;:&quot;arrows-1-refresh-69&quot;});\nmetrics.add({&quot;label&quot;:&quot;Completed visits&quot;,&quot;value&quot;:completedVisits,&quot;icon&quot;:&quot;ui-1-check-square-09&quot;});\nmetrics.add({&quot;label&quot;:&quot;Average guest rating&quot;,&quot;value&quot;:avgRating + &quot; / 5&quot;,&quot;icon&quot;:&quot;ui-1-star&quot;});\nfor each metric in metrics\n{\n%&gt;&lt;div class=&apos;zcs-kpi-card zcs-card zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;&lt;%=metric.get(&quot;label&quot;)%&gt;&lt;/div&gt;&lt;div class=&apos;zcs-font-24 zcs-font-semibold&apos;&gt;&lt;%=metric.get(&quot;value&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;zcs-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=metric.get(&quot;icon&quot;)%&gt;&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;%\n}\n%&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;zcs-main-grid&apos;&gt;\n\t\t&lt;section class=&apos;zcs-card zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-section-title zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Reservation status distribution&lt;/h2&gt;&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Today&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-progress-list&apos;&gt;\n&lt;% for each rs in reservationStatuses { rsCount = Reservations[Reservation_Date_Time &gt;= dayStart &amp;&amp; Reservation_Date_Time &lt; dayEnd &amp;&amp; Reservation_Status == rs].count(); rsPct = ((rsCount * 100.0) / maxReservationStatus).round(0); %&gt;&lt;div class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=rsPct%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&apos;zcs-flex zcs-justify-space-between zcs-font-12 zcs-font-medium zcs-m-0&apos;&gt;&lt;span&gt;&lt;%=rs%&gt;&lt;/span&gt;&lt;span&gt;&lt;%=rsCount%&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;zcs-card zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-section-title zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Table status distribution&lt;/h2&gt;&lt;a class=&apos;zcs-font-12 zcs-color-theme&apos; href=&apos;#Report:Live_Table_Status&apos;&gt;Open board&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;zcs-progress-list&apos;&gt;\n&lt;% for each ts in tableStatuses { tsCount = Dining_Tables[Active == true &amp;&amp; Operational_Status == ts].count(); tsPct = ((tsCount * 100.0) / maxTableStatus).round(0); %&gt;&lt;div class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;&lt;div class=&apos;zcs-progress-bar&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=tsPct%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&apos;zcs-flex zcs-justify-space-between zcs-font-12 zcs-font-medium zcs-m-0&apos;&gt;&lt;span&gt;&lt;%=ts%&gt;&lt;/span&gt;&lt;span&gt;&lt;%=tsCount%&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;&lt;% } %&gt;\n\t\t&lt;/div&gt;&lt;/section&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;zcs-three-grid&apos;&gt;\n\t\t&lt;section class=&apos;zcs-card zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-section-title&apos;&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Service-period demand&lt;/h2&gt;&lt;div class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Today&apos;s reservations and covers&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-8&apos;&gt;\n&lt;% serviceShown = 0; for each period in Service_Periods[Active == true] sort by Start_Time asc { periodReservations = Reservations[Reservation_Date_Time &gt;= dayStart &amp;&amp; Reservation_Date_Time &lt; dayEnd &amp;&amp; Service_Period == period.ID &amp;&amp; Reservation_Status != &quot;Cancelled&quot;]; periodCovers = ifnull(periodReservations.sum(Party_Size),0); demandPct = if(period.Maximum_Covers &gt; 0,((periodCovers * 100.0) / period.Maximum_Covers).round(0),0); if(demandPct &gt; 100){demandPct = 100;} serviceShown = serviceShown + 1; %&gt;&lt;div class=&apos;zcs-service-row&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between&apos;&gt;&lt;strong class=&apos;zcs-font-14&apos;&gt;&lt;%=period.Service_Name%&gt;&lt;/strong&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;&lt;%=periodReservations.count()%&gt; reservations&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-progress-bar&apos; style=&apos;margin:8px 0&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=demandPct%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-font-12 zcs-color-secondary&apos;&gt;&lt;span&gt;&lt;%=periodCovers%&gt; covers&lt;/span&gt;&lt;span&gt;&lt;%=period.Maximum_Covers%&gt; capacity&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } if(serviceShown == 0){ %&gt;&lt;div class=&apos;zcs-empty&apos;&gt;No active service periods configured.&lt;/div&gt;&lt;% } %&gt;\n\t\t&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;zcs-card zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-section-title zcs-flex zcs-justify-space-between&apos;&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Longest active waits&lt;/h2&gt;&lt;a class=&apos;zcs-font-12 zcs-color-theme&apos; href=&apos;#Report:Active_Waitlist&apos;&gt;Open queue&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-8&apos;&gt;\n&lt;% waitShown = 0; for each wait in activeWaits { if(waitShown &lt; 5){ elapsed = ((now - wait.Joined_Date_Time) / 60000).round(0); waitClass = if(elapsed &gt; wait.Quoted_Wait_Minutes,&quot;zcs-badge-red&quot;,&quot;zcs-badge-yellow&quot;); %&gt;&lt;div class=&apos;zcs-service-row zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;div&gt;&lt;strong class=&apos;zcs-font-14&apos;&gt;&lt;%=wait.Guest.Guest_Name.first_name%&gt; · party &lt;%=wait.Party_Size%&gt;&lt;/strong&gt;&lt;div class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Quoted &lt;%=wait.Quoted_Wait_Minutes%&gt; min · &lt;%=wait.Priority%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline &lt;%=waitClass%&gt; zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm zcs-font-12&apos;&gt;&lt;%=elapsed%&gt; min&lt;/span&gt;&lt;/div&gt;&lt;% waitShown = waitShown + 1; } } if(waitShown == 0){ %&gt;&lt;div class=&apos;zcs-empty&apos;&gt;No active waits.&lt;/div&gt;&lt;% } %&gt;\n\t\t&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;zcs-card zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-section-title zcs-flex zcs-justify-space-between&apos;&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Late-arrival exceptions&lt;/h2&gt;&lt;a class=&apos;zcs-font-12 zcs-color-theme&apos; href=&apos;#Report:Arrival_Exceptions&apos;&gt;Open exceptions&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-8&apos;&gt;\n&lt;% lateShown = 0; for each late in lateArrivals { if(lateShown &lt; 5){ lateMins = ((now - late.Reservation_Date_Time) / 60000).round(0); %&gt;&lt;div class=&apos;zcs-service-row zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;div&gt;&lt;strong class=&apos;zcs-font-14&apos;&gt;&lt;%=late.Guest.Guest_Name.first_name%&gt; · party &lt;%=late.Party_Size%&gt;&lt;/strong&gt;&lt;div class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;&lt;%=late.Reservation_Date_Time.toString(&quot;hh:mm a&quot;)%&gt; · table &lt;%=ifnull(late.Assigned_Table.Table_Number,&quot;Unassigned&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-red zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm zcs-font-12&apos;&gt;&lt;%=lateMins%&gt; min late&lt;/span&gt;&lt;/div&gt;&lt;% lateShown = lateShown + 1; } } if(lateShown == 0){ %&gt;&lt;div class=&apos;zcs-empty&apos;&gt;No late confirmed arrivals.&lt;/div&gt;&lt;% } %&gt;\n\t\t&lt;/div&gt;&lt;/section&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;zcs-main-grid&apos;&gt;\n\t\t&lt;section class=&apos;zcs-card zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-section-title zcs-flex zcs-justify-space-between&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Low-rating follow-up queue&lt;/h2&gt;&lt;div class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Ratings 1–2 requiring manager attention&lt;/div&gt;&lt;/div&gt;&lt;a class=&apos;zcs-font-12 zcs-color-theme&apos; href=&apos;#Report:Feedback_Follow_Up&apos;&gt;Open follow-up&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&apos;&gt;Guest&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&apos;&gt;Rating&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&apos;&gt;Status&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&apos;&gt;Received&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;% feedbackShown = 0; for each feedback in lowFeedback { if(feedbackShown &lt; 8){ %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-14&apos;&gt;&lt;%=feedback.Guest.Guest_Name.first_name%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-color-red&apos;&gt;&lt;%=feedback.Overall_Rating%&gt; / 5&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-orange zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm zcs-font-12&apos;&gt;&lt;%=feedback.Follow_Up_Status%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13&apos;&gt;&lt;%=feedback.Feedback_Date_Time.toString(&quot;dd MMM, hh:mm a&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% feedbackShown = feedbackShown + 1; } } if(feedbackShown == 0){ %&gt;&lt;tr&gt;&lt;td colspan=&apos;4&apos; class=&apos;zcs-empty&apos;&gt;No open low-rating follow-ups.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&apos;zcs-card zcs-p-16&apos;&gt;&lt;div class=&apos;zcs-section-title zcs-flex zcs-justify-space-between&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;POS staging and integration status&lt;/h2&gt;&lt;div class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Readiness queue only; these are not POS sales figures&lt;/div&gt;&lt;/div&gt;&lt;a class=&apos;zcs-font-12 zcs-color-theme&apos; href=&apos;#Report:POS_Sync_Status_Board&apos;&gt;Open staging board&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;zcs-row zcs-gap-12&apos;&gt;&lt;div class=&apos;zcs-card zcs-p-16&apos; style=&apos;flex:1&apos;&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Pending or processing&lt;/div&gt;&lt;div class=&apos;zcs-font-28 zcs-font-semibold zcs-color-yellow&apos;&gt;&lt;%=posPending%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;zcs-card zcs-p-16&apos; style=&apos;flex:1&apos;&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Failed staging items&lt;/div&gt;&lt;div class=&apos;zcs-font-28 zcs-font-semibold zcs-color-red&apos;&gt;&lt;%=posFailed%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;zcs-pos-note zcs-p-12 zcs-font-13&apos; style=&apos;margin-top:12px&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt; Vendor-neutral synchronization staging is monitored here. No sales, revenue, tender, or payment analytics are represented.&lt;/div&gt;&lt;div class=&apos;zcs-flex zcs-gap-8&apos; style=&apos;margin-top:12px&apos;&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Report:Pending_POS_Sync&apos;&gt;Pending&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Report:Failed_POS_Sync&apos;&gt;Failed&lt;/a&gt;&lt;/div&gt;&lt;/section&gt;\n\t&lt;/div&gt;\n\t&lt;section class=&apos;zcs-card zcs-p-16&apos; style=&apos;margin-bottom:16px&apos;&gt;&lt;div class=&apos;zcs-section-title zcs-flex zcs-justify-space-between&apos;&gt;&lt;div&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Recent audit exceptions&lt;/h2&gt;&lt;div class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Exception, recovery, and sync-override events from the last 7 days&lt;/div&gt;&lt;/div&gt;&lt;a class=&apos;zcs-font-12 zcs-color-theme&apos; href=&apos;#Report:Operational_Exceptions&apos;&gt;Open audit exceptions&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;zcs-table-wrapper&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&apos;&gt;When&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&apos;&gt;Type&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&apos;&gt;Entity&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&apos;&gt;Summary&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&apos;&gt;Actor&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;% auditShown = 0; for each audit in recentAudit { if(auditShown &lt; 10){ auditClass = if(audit.Action_Type == &quot;Exception&quot;,&quot;zcs-badge-red&quot;,if(audit.Action_Type == &quot;Recovery&quot;,&quot;zcs-badge-green&quot;,&quot;zcs-badge-blue&quot;)); %&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13&apos;&gt;&lt;%=audit.Event_Date_Time.toString(&quot;dd MMM, hh:mm a&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline &lt;%=auditClass%&gt; zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm zcs-font-12&apos;&gt;&lt;%=audit.Action_Type%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-14&apos;&gt;&lt;%=audit.Entity_Type%&gt; &lt;%=ifnull(audit.Entity_Reference,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-14&apos;&gt;&lt;%=audit.Change_Summary%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-13&apos;&gt;&lt;%=audit.Actor_Email%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% auditShown = auditShown + 1; } } if(auditShown == 0){ %&gt;&lt;tr&gt;&lt;td colspan=&apos;5&apos; class=&apos;zcs-empty&apos;&gt;No recent audit exceptions.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;\n&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/section&gt;\n\t&lt;nav class=&apos;zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16&apos;&gt;&lt;h2 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Quick links&lt;/h2&gt;&lt;ul class=&apos;zcs-p-0 zcs-m-0&apos;&gt;&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary&apos; href=&apos;#Report:Restaurant_Settings_Report&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-settings-gear-63&apos;&gt;&lt;/i&gt;&lt;span&gt;Configuration&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary&apos; href=&apos;#Report:All_Reservations&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-doc&apos;&gt;&lt;/i&gt;&lt;span&gt;Operational reports&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary&apos; href=&apos;#Report:Feedback_Follow_Up&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-star&apos;&gt;&lt;/i&gt;&lt;span&gt;Feedback follow-up&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary&apos; href=&apos;#Report:Failed_POS_Sync&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt;&lt;span&gt;POS sync exceptions&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary&apos; href=&apos;#Report:Audit_Trail&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-folded-content&apos;&gt;&lt;/i&gt;&lt;span&gt;Audit trail&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/nav&gt;\n&lt;/div&gt;\n&lt;% } %&gt;\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Host_Operations
		{
					displayname = "Host Operations"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Host_Operations_Snippet' elementName='Host_Operations_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Host_Operations_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\ntoday = zoho.currentdate;\ntomorrow = today.addDay(1);\nnow = zoho.currenttime;\ntodayReservations = Reservations[Reservation_Date_Time &gt;= today &amp;&amp; Reservation_Date_Time &lt; tomorrow &amp;&amp; Reservation_Status != &quot;Cancelled&quot; &amp;&amp; Reservation_Status != &quot;No Show&quot;];\nreservationCount = todayReservations.count();\nexpectedCovers = ifnull(todayReservations.sum(Party_Size),0);\narrivedSeatedCount = Reservations[Reservation_Date_Time &gt;= today &amp;&amp; Reservation_Date_Time &lt; tomorrow &amp;&amp; (Reservation_Status == &quot;Arrived&quot; || Reservation_Status == &quot;Seated&quot;)].count();\nactiveWaitlist = Waitlist_Entries[Waitlist_Status == &quot;Waiting&quot; || Waitlist_Status == &quot;Notified&quot; || Waitlist_Status == &quot;Arrived&quot;] sort by Joined_Date_Time asc;\nwaitlistCount = activeWaitlist.count();\navailableTables = Dining_Tables[Active == true &amp;&amp; Operational_Status == &quot;Available&quot;];\navailableCount = availableTables.count();\nupcoming = Reservations[Reservation_Date_Time &gt;= now &amp;&amp; Reservation_Date_Time &lt; tomorrow &amp;&amp; (Reservation_Status == &quot;Confirmed&quot; || Reservation_Status == &quot;Tentative&quot; || Reservation_Status == &quot;Arrived&quot;)] sort by Reservation_Date_Time asc;\nlateReservations = Reservations[Reservation_Date_Time &gt;= today &amp;&amp; Reservation_Date_Time &lt; now &amp;&amp; Reservation_Status == &quot;Confirmed&quot;];\nresetTables = Dining_Tables[Active == true &amp;&amp; Operational_Status == &quot;Needs Reset&quot;];\nlongWaitCount = 0;\nfor each w0 in activeWaitlist\n{\n\t\telapsed0 = ((now - w0.Joined_Date_Time) / 60000).round(0);\n\t\tif(elapsed0 &gt; w0.Quoted_Wait_Minutes)\n\t\t{\n\t\t\t\tlongWaitCount = longWaitCount + 1;\n\t\t}\n}\nserviceName = &quot;Current service&quot;;\nfor each svc in Service_Periods[Active == true]\n{\n\t\tserviceName = svc.Service_Name;\n}\ncanEdit = true;\n%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color)}*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:4px}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-w-full{width:100%}.zcs-p-0{padding:0}.zcs-p-16{padding:16px}.zcs-p-25{padding:25px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-12{padding-top:12px;padding-bottom:12px}.zcs-px-30{padding-left:30px;padding-right:30px}.zcs-py-24{padding-top:24px;padding-bottom:24px}.zcs-m-0{margin:0}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-xl{border-radius:12px}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.zcs-page{padding:18px;background:var(--zcs-page-bg-color,#f5f5f6);color:var(--zcs-primary-text-color);font-family:inherit}.zcs-page-header{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;margin-bottom:16px}.zcs-header-copy{min-width:240px}.zcs-header-actions{flex-wrap:wrap}.zcs-button{width:auto;min-width:5rem;min-height:36px;text-decoration:none}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color);border:1px solid var(--zcs_brand_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-kpis{display:grid;grid-template-columns:repeat(5,minmax(150px,1fr));gap:12px;margin-bottom:16px}.zcs-property-card{min-height:116px}.zcs-kpi-icon{width:38px;height:38px;border-radius:10px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color)}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-green{background:#179e6c;color:#fff}.zcs-badge-red{background:#fe455d;color:#fff}.zcs-badge-yellow{background:#faae13;color:#fff}.zcs-badge-blue{background:#2a6ffc;color:#fff}.zcs-badge-grey{background:#50505a;color:#fff}.zcs-main-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(290px,1fr);gap:16px}.zcs-section{padding:16px}.zcs-section-title{margin-bottom:12px}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:var(--zcs-white-color);overflow:auto;border-radius:6px}.zcs-table-wrapper table{border-collapse:collapse;min-width:650px}.zcs-table-wrapper thead{top:0}.zcs-table-wrapper th{background:#f9fafe;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tbody tr:hover td{background:#f9fafe}.zcs-queue{display:flex;flex-direction:column;gap:8px}.zcs-queue-row{padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:8px}.zcs-toast{border:1px solid}.zcs-warning-toast{background:#fef4e5;color:#663c01}.zcs-error-toast{background:#feedec;color:#5f2120}.zcs-info-toast{background:#e4f6fd;color:#024361}.zcs-quick-action-item{list-style:none}.zcs-quick-action-item:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-link{text-decoration:none}.zcs-quick-actions-wrapper ul{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.zcs-empty{padding:18px;text-align:center;color:var(--zcs-teritiary-text-color)}@media(max-width:1100px){.zcs-kpis{grid-template-columns:repeat(3,1fr)}.zcs-main-grid{grid-template-columns:1fr}}@media(max-width:700px){.zcs-page{padding:10px}.zcs-page-header{padding:16px}.zcs-kpis{grid-template-columns:repeat(2,1fr)}.zcs-header-actions{width:100%}.zcs-quick-actions-wrapper ul{grid-template-columns:1fr}}@media(max-width:430px){.zcs-kpis{grid-template-columns:1fr}}\n&lt;/style&gt;\n&lt;div class=&apos;zcs-page&apos;&gt;\n\t&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-header-copy&apos;&gt;&lt;h2 class=&apos;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Host Operations&lt;/h2&gt;&lt;div class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;&lt;%=today.toString(&quot;EEEE, dd MMMM yyyy&quot;)%&gt; · &lt;%=serviceName%&gt; · Updated &lt;%=now.toString(&quot;hh:mm a&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-header-actions zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Report:Reservation_Calendar&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-60&apos;&gt;&lt;/i&gt;&lt;span&gt;Reservation Calendar&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Report:Live_Waitlist&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span&gt;Live Waitlist&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md&apos; href=&apos;#Report:Live_Table_Status&apos;&gt;&lt;i class=&apos;zc-li-outline furniture-table&apos;&gt;&lt;/i&gt;&lt;span&gt;Live Table Status&lt;/span&gt;&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;zcs-kpis&apos;&gt;\n&lt;%\nmetrics = List();\nmetrics.add({&quot;label&quot;:&quot;Today&apos;s reservations&quot;,&quot;value&quot;:reservationCount,&quot;icon&quot;:&quot;ui-1-calendar-60&quot;});\nmetrics.add({&quot;label&quot;:&quot;Expected covers&quot;,&quot;value&quot;:expectedCovers,&quot;icon&quot;:&quot;users-single-01&quot;});\nmetrics.add({&quot;label&quot;:&quot;Arrived or seated&quot;,&quot;value&quot;:arrivedSeatedCount,&quot;icon&quot;:&quot;ui-1-check-circle-08&quot;});\nmetrics.add({&quot;label&quot;:&quot;Active waitlist&quot;,&quot;value&quot;:waitlistCount,&quot;icon&quot;:&quot;ui-2-time&quot;});\nmetrics.add({&quot;label&quot;:&quot;Available tables&quot;,&quot;value&quot;:availableCount,&quot;icon&quot;:&quot;furniture-table&quot;});\nfor each metric in metrics\n{\n%&gt;\n\t\t&lt;div class=&apos;zcs-property-card zcs-card zcs-p-16 zcs-box-border&apos;&gt;&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-gap-16&apos;&gt;&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;&lt;%=metric.get(&quot;label&quot;)%&gt;&lt;/div&gt;&lt;div class=&apos;zcs-font-24 zcs-font-semibold zcs-color-primary&apos;&gt;&lt;%=metric.get(&quot;value&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;zcs-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=metric.get(&quot;icon&quot;)%&gt;&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n}\n%&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;zcs-main-grid&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n\t\t\t&lt;section class=&apos;zcs-section zcs-card&apos;&gt;&lt;div class=&apos;zcs-section-title zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Upcoming arrivals&lt;/h3&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=upcoming.count()%&gt; upcoming&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-relative&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&apos;&gt;Time&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&apos;&gt;Guest&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&apos;&gt;Party&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&apos;&gt;Table&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14&apos;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\nfor each r in upcoming\n{\n\t\tstatusClass = if(r.Reservation_Status == &quot;Arrived&quot;,&quot;zcs-badge-green&quot;,if(r.Reservation_Status == &quot;Tentative&quot;,&quot;zcs-badge-yellow&quot;,&quot;zcs-badge-blue&quot;));\n%&gt;&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-14&apos;&gt;&lt;%=r.Reservation_Date_Time.toString(&quot;hh:mm a&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-14&apos;&gt;&lt;%=r.Guest.Guest_Name.first_name%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&apos;&gt;&lt;%=r.Party_Size%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-font-14&apos;&gt;&lt;%=ifnull(r.Assigned_Table.Table_Number,&quot;Unassigned&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled &lt;%=statusClass%&gt; zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm zcs-font-12&apos;&gt;&lt;%=r.Reservation_Status%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n}\nif(upcoming.count() == 0)\n{\n%&gt;&lt;tr&gt;&lt;td colspan=&apos;5&apos; class=&apos;zcs-empty&apos;&gt;No upcoming arrivals for today.&lt;/td&gt;&lt;/tr&gt;&lt;%\n}\n%&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\t\t\t&lt;section class=&apos;zcs-section zcs-card&apos;&gt;&lt;div class=&apos;zcs-section-title zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Active waitlist&lt;/h3&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-yellow zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm&apos;&gt;&lt;%=waitlistCount%&gt; parties&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-queue&apos;&gt;\n&lt;%\nfor each w in activeWaitlist\n{\n\t\telapsed = ((now - w.Joined_Date_Time) / 60000).round(0);\n\t\tpriorityClass = if(w.Priority == &quot;Standard&quot;,&quot;zcs-badge-grey&quot;,if(w.Priority == &quot;VIP&quot;,&quot;zcs-badge-blue&quot;,&quot;zcs-badge-red&quot;));\n%&gt;&lt;div class=&apos;zcs-queue-row zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div&gt;&lt;div class=&apos;zcs-font-15 zcs-font-semibold&apos;&gt;&lt;%=w.Guest.Guest_Name.first_name%&gt; · party of &lt;%=w.Party_Size%&gt;&lt;/div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Quoted &lt;%=w.Quoted_Wait_Minutes%&gt; min · elapsed &lt;%=elapsed%&gt; min&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;zcs-flex zcs-gap-4&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled &lt;%=priorityClass%&gt; zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm zcs-font-12&apos;&gt;&lt;%=w.Priority%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-yellow zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm zcs-font-12&apos;&gt;&lt;%=w.Waitlist_Status%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;%\n}\nif(waitlistCount == 0)\n{\n%&gt;&lt;div class=&apos;zcs-empty&apos;&gt;The active queue is clear.&lt;/div&gt;&lt;%\n}\n%&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t\t&lt;section class=&apos;zcs-section zcs-card&apos;&gt;&lt;h3 class=&apos;zcs-section-title zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Seating opportunities&lt;/h3&gt;&lt;div class=&apos;zcs-queue&apos;&gt;\n&lt;%\nfor each party in activeWaitlist\n{\n\t\tfitting = Dining_Tables[Active == true &amp;&amp; Operational_Status == &quot;Available&quot; &amp;&amp; Capacity &gt;= party.Party_Size] sort by Capacity asc;\n%&gt;&lt;div class=&apos;zcs-queue-row&apos;&gt;&lt;div class=&apos;zcs-font-15 zcs-font-semibold&apos;&gt;Party of &lt;%=party.Party_Size%&gt;&lt;/div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Fitting tables: &lt;% shown = 0; for each fit in fitting { if(shown &lt; 5) { %&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-green zcs-inline-flex zcs-px-10 zcs-py-2 zcs-rounded-sm zcs-font-12&apos;&gt;Table &lt;%=fit.Table_Number%&gt; · &lt;%=fit.Capacity%&gt;&lt;/span&gt; &lt;% shown = shown + 1; } } if(fitting.count() == 0) { %&gt;No available table currently fits.&lt;% } %&gt;&lt;/div&gt;&lt;/div&gt;&lt;%\n}\nif(waitlistCount == 0)\n{\n%&gt;&lt;div class=&apos;zcs-empty&apos;&gt;Seating matches appear when parties join the waitlist.&lt;/div&gt;&lt;%\n}\n%&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;aside class=&apos;zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n\t\t\t&lt;section class=&apos;zcs-section zcs-card&apos;&gt;&lt;h3 class=&apos;zcs-section-title zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Operational alerts&lt;/h3&gt;&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-8&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-toast zcs-outline-toast &lt;%=if(lateReservations.count() &gt; 0,&quot;zcs-error-toast&quot;,&quot;zcs-info-toast&quot;)%&gt; zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;&lt;%=lateReservations.count()%&gt; late arrivals&lt;/strong&gt;&lt;div class=&apos;zcs-font-13&apos;&gt;Confirmed bookings past arrival time.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-toast zcs-outline-toast &lt;%=if(longWaitCount &gt; 0,&quot;zcs-warning-toast&quot;,&quot;zcs-info-toast&quot;)%&gt; zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;&lt;%=longWaitCount%&gt; waits over quote&lt;/strong&gt;&lt;div class=&apos;zcs-font-13&apos;&gt;Parties beyond their quoted wait.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-toast zcs-outline-toast &lt;%=if(resetTables.count() &gt; 0,&quot;zcs-warning-toast&quot;,&quot;zcs-info-toast&quot;)%&gt; zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-refresh-69&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;&lt;%=resetTables.count()%&gt; tables need reset&lt;/strong&gt;&lt;div class=&apos;zcs-font-13&apos;&gt;Clear reset backlog before the next seating.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;&lt;/section&gt;\n\t\t\t&lt;section class=&apos;zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16&apos;&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-m-0&apos;&gt;Quick actions&lt;/h3&gt;\n&lt;%\nif(canEdit)\n{\n%&gt;&lt;ul class=&apos;zcs-p-0 zcs-m-0&apos;&gt;&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary&apos; href=&apos;#Form:Guests&apos;&gt;&lt;i class=&apos;zc-li-outline users-add-27&apos;&gt;&lt;/i&gt;&lt;span&gt;Add Guest&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary&apos; href=&apos;#Form:Reservations&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-add-61&apos;&gt;&lt;/i&gt;&lt;span&gt;Add Reservation&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary&apos; href=&apos;#Form:Waitlist_Entries&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span&gt;Add Waitlist Entry&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-color-primary&apos; href=&apos;#Form:Dining_Visits&apos;&gt;&lt;i class=&apos;zc-li-outline furniture-table&apos;&gt;&lt;/i&gt;&lt;span&gt;Add Dining Visit&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;%\n}\nelse\n{\n%&gt;&lt;div class=&apos;zcs-toast zcs-outline-toast zcs-info-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-eye-17&apos;&gt;&lt;/i&gt;&lt;div&gt;Read-only operational view. Use the linked live reports for service context.&lt;/div&gt;&lt;/div&gt;&lt;%\n}\n%&gt;&lt;/section&gt;\n\t\t&lt;/aside&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Live_Floor_Board(string Area)
		{
					displayname = "Live Floor Board"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Live_Floor_Content' elementName='Live Floor Content'>\n\t\t\t\t\t<![CDATA[htmlpage Live_Floor_Content()\ncontent\n&lt;%{%&gt;\n&lt;%\nselectedArea = ifnull(input.Area,&quot;All&quot;);\nactiveTables = Dining_Tables[Active == true];\ntotalTables = activeTables.count();\navailableCount = Dining_Tables[Active == true &amp;&amp; Operational_Status == &quot;Available&quot;].count();\noccupiedCount = Dining_Tables[Active == true &amp;&amp; Operational_Status == &quot;Occupied&quot;].count();\nreservedCount = Dining_Tables[Active == true &amp;&amp; Operational_Status == &quot;Reserved&quot;].count();\nresetCount = Dining_Tables[Active == true &amp;&amp; Operational_Status == &quot;Needs Reset&quot;].count();\nblockedCount = Dining_Tables[Active == true &amp;&amp; (Operational_Status == &quot;Blocked&quot; || Operational_Status == &quot;Out of Service&quot;)].count();\ntotalCapacity = ifnull(activeTables.sum(Capacity),0);\noccupiedSeats = 0;\nfor each openVisit in Dining_Visits[Visit_Status != &quot;Closed&quot; &amp;&amp; Visit_Status != &quot;Abandoned&quot;]\n{\n\toccupiedSeats = occupiedSeats + ifnull(openVisit.Party_Size,0);\n}\n%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff}\n*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-p-0{padding:0}.zcs-p-16{padding:16px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-12{padding-top:12px;padding-bottom:12px}.zcs-m-0{margin:0}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-20{font-size:20px}.zcs-font-28{font-size:28px}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-xl{border-radius:12px}.zcs-box-border{box-sizing:border-box}.zcs-w-full{width:100%}.zcs-no-underline{text-decoration:none}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}\n.floor-board{padding:18px;background:var(--zcs-page-bg-color);min-height:100%;font-family:Arial,sans-serif;color:var(--zcs-primary-text-color)}.floor-header{margin-bottom:16px}.floor-title{margin:0 0 4px;font-size:26px}.live-stamp{font-size:13px;color:var(--zcs-secondary-text-color)}.summary-grid{display:grid;grid-template-columns:repeat(5,minmax(130px,1fr));gap:12px;margin-bottom:14px}.summary-card{padding:15px}.summary-card .value{font-size:26px;font-weight:700;line-height:1.1}.summary-card .label{font-size:12px;color:var(--zcs-teritiary-text-color);margin-top:5px}.summary-card .sub{font-size:12px;color:var(--zcs-secondary-text-color);margin-top:3px}.zcs-horizontal-tabhead{box-shadow:0 -1px 0 var(--zcs-border-color) inset;overflow-x:auto;list-style:none;margin:0 0 14px;padding:0 10px;display:flex;gap:12px}.zcs-horizontal-tabitem{list-style:none;border-bottom:2px solid transparent}.zcs-horizontal-tablink{display:flex;align-items:center;gap:8px;padding:12px 10px;color:var(--zcs-teritiary-text-color);text-decoration:none;white-space:nowrap}.zcs-horizontal-tabcount{min-width:20px;background:var(--zcs-page-bg-color);padding:2px 6px;border-radius:4px;text-align:center;font-size:12px}.zcs-horizontal-tabactive{border-bottom-color:var(--zcs_brand_color)}.zcs-horizontal-tabactive .zcs-horizontal-tablink{color:var(--zcs_brand_color)}.board-meta{display:grid;grid-template-columns:minmax(0,2fr) minmax(260px,1fr);gap:14px;margin-bottom:16px}.legend-card,.alerts-card{padding:14px}.legend-list{display:flex;flex-wrap:wrap;gap:10px 18px;margin:8px 0 0;padding:0;list-style:none}.legend-item{display:flex;align-items:center;gap:7px;font-size:12px}.legend-dot{width:11px;height:11px;border-radius:50%}.zcs-toast{border:1px solid #ed6c03;background:#fef4e5;color:#663c01;padding:12px 16px;border-radius:4px;display:flex;gap:8px}.area-section{margin-bottom:22px}.area-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:10px}.area-heading h2{font-size:19px;margin:0}.area-heading span{font-size:12px;color:var(--zcs-secondary-text-color)}.table-grid{display:grid;grid-template-columns:repeat(4,minmax(220px,1fr));gap:12px}.table-card{border-top:5px solid var(--state);overflow:hidden;min-height:250px}.table-card:hover{border-color:var(--zcs_brand_color)}.table-top{padding:14px 14px 10px;display:flex;justify-content:space-between;gap:10px}.table-number{font-size:22px;font-weight:700}.area-name{font-size:12px;color:var(--zcs-teritiary-text-color)}.zcs-badge{width:auto;border:1px solid currentColor;padding:2px 10px;border-radius:4px;font-size:12px;line-height:1.5;background:var(--state-bg);color:var(--state)}.table-body{padding:0 14px 14px}.kv{background:#F9FAFE;border-radius:12px;padding:7px 12px;margin-bottom:10px}.kv-row{display:grid;grid-template-columns:44% 56%;gap:8px;padding:5px 0;font-size:13px}.kv-row label{color:var(--zcs-teritiary-text-color)}.kv-row span{font-weight:500;overflow-wrap:anywhere}.card-links{display:flex;flex-wrap:wrap;gap:10px;border-top:1px solid #EBECF0;padding-top:10px}.card-links a,.quick-links a{color:var(--zcs_brand_color);font-size:12px;text-decoration:none}.quick-links{display:flex;flex-wrap:wrap;gap:10px}.quick-link{border:1px solid var(--zcs_brand_color);padding:7px 10px;border-radius:6px}.empty{padding:28px;text-align:center;color:var(--zcs-secondary-text-color)}\n@media(max-width:1200px){.table-grid{grid-template-columns:repeat(3,minmax(220px,1fr))}.summary-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:820px){.table-grid{grid-template-columns:repeat(2,minmax(210px,1fr))}.board-meta{grid-template-columns:1fr}.summary-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:540px){.floor-board{padding:10px}.table-grid,.summary-grid{grid-template-columns:1fr}.floor-header{align-items:flex-start;flex-direction:column}.table-card{min-height:auto}}\n&lt;/style&gt;\n&lt;div class=&apos;floor-board&apos;&gt;\n\t&lt;div class=&apos;floor-header zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t&lt;div&gt;&lt;h1 class=&apos;floor-title&apos;&gt;Live Floor Board&lt;/h1&gt;&lt;div class=&apos;live-stamp&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt; Snapshot &lt;%=zoho.currenttime.toString(&quot;MMM d, yyyy h:mm a&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;quick-links&apos;&gt;\n\t\t\t&lt;a class=&apos;quick-link&apos; href=&apos;#Form:Dining_Tables?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline design-apps&apos;&gt;&lt;/i&gt; Dining tables&lt;/a&gt;\n\t\t\t&lt;a class=&apos;quick-link&apos; href=&apos;#Form:Dining_Visits?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-05&apos;&gt;&lt;/i&gt; Dining visits&lt;/a&gt;\n\t\t\t&lt;a class=&apos;quick-link&apos; href=&apos;#Form:Reservations?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-60&apos;&gt;&lt;/i&gt; Reservations&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;summary-grid&apos;&gt;\n\t\t&lt;div class=&apos;zcs-card summary-card&apos;&gt;&lt;div class=&apos;value&apos;&gt;&lt;%=occupiedCount%&gt;/&lt;%=totalTables%&gt;&lt;/div&gt;&lt;div class=&apos;label&apos;&gt;Occupied tables&lt;/div&gt;&lt;div class=&apos;sub&apos;&gt;&lt;%=occupiedSeats%&gt; guests seated&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card summary-card&apos;&gt;&lt;div class=&apos;value&apos;&gt;&lt;%=availableCount%&gt;&lt;/div&gt;&lt;div class=&apos;label&apos;&gt;Available now&lt;/div&gt;&lt;div class=&apos;sub&apos;&gt;&lt;%=totalCapacity%&gt; total seats&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card summary-card&apos;&gt;&lt;div class=&apos;value&apos;&gt;&lt;%=reservedCount%&gt;&lt;/div&gt;&lt;div class=&apos;label&apos;&gt;Reservation holds&lt;/div&gt;&lt;div class=&apos;sub&apos;&gt;Assigned tables&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card summary-card&apos;&gt;&lt;div class=&apos;value&apos;&gt;&lt;%=resetCount%&gt;&lt;/div&gt;&lt;div class=&apos;label&apos;&gt;Reset backlog&lt;/div&gt;&lt;div class=&apos;sub&apos;&gt;Needs reset&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card summary-card&apos;&gt;&lt;div class=&apos;value&apos;&gt;&lt;%=blockedCount%&gt;&lt;/div&gt;&lt;div class=&apos;label&apos;&gt;Unavailable&lt;/div&gt;&lt;div class=&apos;sub&apos;&gt;Blocked or out of service&lt;/div&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;ul class=&apos;zcs-horizontal-tabhead&apos;&gt;\n\t\t&lt;li class=&apos;zcs-horizontal-tabitem &lt;%if(selectedArea == &quot;All&quot;){%&gt;zcs-horizontal-tabactive&lt;%}%&gt;&apos;&gt;&lt;a class=&apos;zcs-horizontal-tablink&apos; href=&apos;#Page:Live_Floor_Board?Area=All&apos;&gt;&lt;span&gt;All areas&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount&apos;&gt;&lt;%=totalTables%&gt;&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t&lt;%for each areaTab in Dining_Areas[Active == true] sort by Display_Order asc{%&gt;\n\t\t&lt;li class=&apos;zcs-horizontal-tabitem &lt;%if(selectedArea == areaTab.Area_Name){%&gt;zcs-horizontal-tabactive&lt;%}%&gt;&apos;&gt;&lt;a class=&apos;zcs-horizontal-tablink&apos; href=&apos;#Page:Live_Floor_Board?Area=&lt;%=encodeUrl(areaTab.Area_Name)%&gt;&apos;&gt;&lt;span&gt;&lt;%=areaTab.Area_Name%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount&apos;&gt;&lt;%=Dining_Tables[Active == true &amp;&amp; Dining_Area == areaTab.ID].count()%&gt;&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t&lt;%}%&gt;\n\t&lt;/ul&gt;\n\t&lt;div class=&apos;board-meta&apos;&gt;\n\t\t&lt;div class=&apos;zcs-card legend-card&apos;&gt;&lt;strong class=&apos;zcs-font-14&apos;&gt;Table state legend&lt;/strong&gt;&lt;ul class=&apos;legend-list&apos;&gt;&lt;li class=&apos;legend-item&apos;&gt;&lt;span class=&apos;legend-dot&apos; style=&apos;background:#179E6C&apos;&gt;&lt;/span&gt;Available&lt;/li&gt;&lt;li class=&apos;legend-item&apos;&gt;&lt;span class=&apos;legend-dot&apos; style=&apos;background:#FE455D&apos;&gt;&lt;/span&gt;Occupied&lt;/li&gt;&lt;li class=&apos;legend-item&apos;&gt;&lt;span class=&apos;legend-dot&apos; style=&apos;background:#2A6FFC&apos;&gt;&lt;/span&gt;Reserved&lt;/li&gt;&lt;li class=&apos;legend-item&apos;&gt;&lt;span class=&apos;legend-dot&apos; style=&apos;background:#FAAE13&apos;&gt;&lt;/span&gt;Needs reset&lt;/li&gt;&lt;li class=&apos;legend-item&apos;&gt;&lt;span class=&apos;legend-dot&apos; style=&apos;background:#F4660C&apos;&gt;&lt;/span&gt;Blocked&lt;/li&gt;&lt;li class=&apos;legend-item&apos;&gt;&lt;span class=&apos;legend-dot&apos; style=&apos;background:#242424&apos;&gt;&lt;/span&gt;Out of service&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;\n\t\t&lt;%if(blockedCount &gt; 0 || resetCount &gt; 0){%&gt;&lt;div class=&apos;zcs-toast&apos;&gt;&lt;i class=&apos;zc-li-outline travel-info&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;Floor attention&lt;/strong&gt;&lt;br&gt;&lt;%=blockedCount%&gt; unavailable and &lt;%=resetCount%&gt; awaiting reset.&lt;/div&gt;&lt;/div&gt;&lt;%}else{%&gt;&lt;div class=&apos;zcs-card alerts-card&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt; No blocked tables or reset backlog.&lt;/div&gt;&lt;%}%&gt;\n\t&lt;/div&gt;\n\t&lt;%\n\trenderedAreas = 0;\n\tfor each area in Dining_Areas[Active == true] sort by Display_Order asc\n\t{\n\t\tif(selectedArea == &quot;All&quot; || selectedArea == area.Area_Name)\n\t\t{\n\t\t\tareaTables = Dining_Tables[Active == true &amp;&amp; Dining_Area == area.ID];\n\t\t\trenderedAreas = renderedAreas + 1;\n\t%&gt;\n\t&lt;section class=&apos;area-section&apos;&gt;\n\t\t&lt;div class=&apos;area-heading&apos;&gt;&lt;h2&gt;&lt;%=area.Area_Name%&gt;&lt;/h2&gt;&lt;span&gt;&lt;%=areaTables.count()%&gt; active tables&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;table-grid&apos;&gt;\n\t\t\t&lt;%for each table in areaTables\n\t\t\t{\n\t\t\t\tstate = table.Operational_Status;\n\t\t\t\tstateColor = &quot;#179E6C&quot;; stateBg = &quot;#E4FCF3&quot;;\n\t\t\t\tif(state == &quot;Occupied&quot;){stateColor=&quot;#FE455D&quot;;stateBg=&quot;#FDE3E6&quot;;}else if(state == &quot;Reserved&quot;){stateColor=&quot;#2A6FFC&quot;;stateBg=&quot;#E8EFFF&quot;;}else if(state == &quot;Needs Reset&quot;){stateColor=&quot;#B8770D&quot;;stateBg=&quot;#FCF4E6&quot;;}else if(state == &quot;Blocked&quot;){stateColor=&quot;#F4660C&quot;;stateBg=&quot;#F8F0EB&quot;;}else if(state == &quot;Out of Service&quot;){stateColor=&quot;#242424&quot;;stateBg=&quot;#E8E8E8&quot;;}\n\t\t\t\tvisitList = Dining_Visits[Dining_Table == table.ID &amp;&amp; Visit_Status != &quot;Closed&quot; &amp;&amp; Visit_Status != &quot;Abandoned&quot;] sort by Seated_Date_Time desc range from 1 to 1;\n\t\t\t\tpartyText = &quot;No active visit&quot;; durationText = &quot;Not seated&quot;; posText = &quot;Not available&quot;; visitID = 0;\n\t\t\t\tfor each visit in visitList\n\t\t\t\t{\n\t\t\t\t\tvisitID = visit.ID;\n\t\t\t\t\tpartyText = &quot;Visit &quot; + visit.Visit_Number + &quot; / &quot; + visit.Party_Size + &quot; guests&quot;;\n\t\t\t\t\telapsedMinutes = ((zoho.currenttime.toLong() - visit.Seated_Date_Time.toLong()) / 60000).round(0);\n\t\t\t\t\telapsedHours = (elapsedMinutes / 60).floor();\n\t\t\t\t\tremainingMinutes = elapsedMinutes - (elapsedHours * 60);\n\t\t\t\t\tdurationText = elapsedHours + &quot;h &quot; + remainingMinutes + &quot;m&quot;;\n\t\t\t\t\tif(visit.POS_Check_ID != null &amp;&amp; visit.POS_Check_ID != &quot;&quot;){posText = visit.POS_Check_ID;}\n\t\t\t\t}\n\t\t\t\tnextReservation = &quot;None assigned&quot;; reservationID = 0;\n\t\t\t\treservationList = Reservations[Assigned_Table == table.ID &amp;&amp; Reservation_Date_Time &gt;= zoho.currenttime &amp;&amp; (Reservation_Status == &quot;Confirmed&quot; || Reservation_Status == &quot;Arrived&quot; || Reservation_Status == &quot;Tentative&quot;)] sort by Reservation_Date_Time asc range from 1 to 1;\n\t\t\t\tfor each reservation in reservationList{nextReservation=reservation.Reservation_Date_Time.toString(&quot;h:mm a&quot;) + &quot; / &quot; + reservation.Party_Size + &quot; guests&quot;;reservationID=reservation.ID;}\n\t\t\t%&gt;\n\t\t\t&lt;article class=&apos;zcs-card table-card&apos; style=&apos;--state:&lt;%=stateColor%&gt;;--state-bg:&lt;%=stateBg%&gt;&apos;&gt;\n\t\t\t\t&lt;div class=&apos;table-top&apos;&gt;&lt;div&gt;&lt;div class=&apos;table-number&apos;&gt;Table &lt;%=table.Table_Number%&gt;&lt;/div&gt;&lt;div class=&apos;area-name&apos;&gt;&lt;%=area.Area_Name%&gt; · capacity &lt;%=table.Capacity%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge&apos;&gt;&lt;%=state%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;table-body&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;kv&apos;&gt;&lt;div class=&apos;kv-row&apos;&gt;&lt;label&gt;Current party&lt;/label&gt;&lt;span&gt;&lt;%=partyText%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv-row&apos;&gt;&lt;label&gt;Seated duration&lt;/label&gt;&lt;span&gt;&lt;%=durationText%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv-row&apos;&gt;&lt;label&gt;Next reservation&lt;/label&gt;&lt;span&gt;&lt;%=nextReservation%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;kv-row&apos;&gt;&lt;label&gt;POS check&lt;/label&gt;&lt;span&gt;&lt;%=posText%&gt;&lt;/span&gt;&lt;/div&gt;&lt;%if(table.Block_Reason != null &amp;&amp; table.Block_Reason != &quot;&quot;){%&gt;&lt;div class=&apos;kv-row&apos;&gt;&lt;label&gt;Reason&lt;/label&gt;&lt;span&gt;&lt;%=table.Block_Reason%&gt;&lt;/span&gt;&lt;/div&gt;&lt;%}%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;card-links&apos;&gt;&lt;a href=&apos;#Form:Dining_Tables?ID=&lt;%=table.ID%&gt;&amp;zc_LoadIn=dialog&apos;&gt;Table record&lt;/a&gt;&lt;%if(visitID != 0){%&gt;&lt;a href=&apos;#Form:Dining_Visits?ID=&lt;%=visitID%&gt;&amp;zc_LoadIn=dialog&apos;&gt;Visit record&lt;/a&gt;&lt;%}%&gt;&lt;%if(reservationID != 0){%&gt;&lt;a href=&apos;#Form:Reservations?ID=&lt;%=reservationID%&gt;&amp;zc_LoadIn=dialog&apos;&gt;Reservation record&lt;/a&gt;&lt;%}%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/article&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t&lt;%if(areaTables.count() == 0){%&gt;&lt;div class=&apos;zcs-card empty&apos;&gt;No active tables in this area.&lt;/div&gt;&lt;%}%&gt;\n\t\t&lt;/div&gt;\n\t&lt;/section&gt;\n\t&lt;%  }\n\t}\n\tif(renderedAreas == 0){%&gt;&lt;div class=&apos;zcs-card empty&apos;&gt;No matching active dining area was found. Choose All areas.&lt;/div&gt;&lt;%}%&gt;\n&lt;/div&gt;\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Audit_Log_On_Validate as "Validate Audit Event"
			{
			 type = form
			 form = Audit_Log
			 record event = on add or edit
			 on validate { actions { custom deluge script ( if(ifnull(input.Entity_Type,"").trim() == "" || ifnull(input.Change_Summary,"").trim() == "" || ifnull(input.Action_Type,"").trim() == "") { alert "Audit entity, action, and change summary are required."; cancel submit; } ) } }
			}

			Dining_Areas_On_Validate as "Validate Dining Area"
			{
			    type = form
			    form = Dining_Areas
			    record event = on add or edit
			    description = "Ensures dining areas use a positive display order."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(ifnull(input.Display_Order,0) <= 0)
			                {
			                    alert "Display order must be greater than zero.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Dining_Tables_On_Load as "Prepare Dining Table Form"
			{
			    type = form
			    form = Dining_Tables
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Operational_Status == "Blocked" || input.Operational_Status == "Out of Service")
			                {
			                    show Block_Reason;
			                }
			                else
			                {
			                    hide Block_Reason;
			                }
			                disable POS_Table_ID;
			            )
			        }
			    }
			}

			Dining_Tables_On_Success as "Audit Dining Table Changes"
			{
			    type = form
			    form = Dining_Tables
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                insert into Audit_Log
			                [
			                    Event_Date_Time=zoho.currenttime
			                    Actor_Email=zoho.loginuser
			                    Action_Type="Status Change"
			                    Entity_Type="Dining Table"
			                    Entity_Record_ID=input.ID
			                    Entity_Reference=input.Table_Number
			                    Change_Summary="Dining table saved with operational status " + input.Operational_Status
			                    After_Value=input.Operational_Status
			                    Source="Form"
			                ];
			            )
			        }
			    }
			}

			Dining_Tables_On_Validate as "Validate Dining Table"
			{
			    type = form
			    form = Dining_Tables
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(ifnull(input.Capacity,0) <= 0)
			                {
			                    alert "Capacity must be greater than zero.";
			                    cancel submit;
			                }
			                if((input.Operational_Status == "Blocked" || input.Operational_Status == "Out of Service") && ifnull(input.Block_Reason,"").trim() == "")
			                {
			                    alert "Block reason is required for blocked or out-of-service tables.";
			                    cancel submit;
			                }
			                if(input.Combinable == true && ifnull(input.Combination_Group,"").trim() == "")
			                {
			                    alert "Combination group is required for a combinable table.";
			                    cancel submit;
			                }
			                if(input.ID != null && (input.Operational_Status == "Available" || input.Operational_Status == "Occupied") && Dining_Visits[Dining_Table == input.ID && Visit_Status != "Closed" && Visit_Status != "Abandoned"].count() > 0)
			                {
			                    alert "An active dining visit controls this table status. Update the visit instead.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Operational_Status_On_User_Input as "Update Block Reason Visibility"
			{
			    type = form
			    form = Dining_Tables
			    record event = on add or edit
			
			    on user input of Operational_Status
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Operational_Status == "Blocked" || input.Operational_Status == "Out of Service")
			                {
			                    show Block_Reason;
			                }
			                else
			                {
			                    input.Block_Reason = "";
			                    hide Block_Reason;
			                }
			            )
			        }
			    }
			}

			Dining_Visits_On_Load as "Prepare Dining Visit"
			{
			 type = form
			 form = Dining_Visits
			 record event = on add or edit
			 on load { actions { custom deluge script ( disable Seated_Date_Time; disable Check_Requested_Date_Time; disable Paid_Date_Time; disable Closed_Date_Time; disable POS_Sync_Status; ) } }
			}

			Dining_Visits_On_Success as "Process Dining Visit"
			{
			 type = form
			 form = Dining_Visits
			 record event = on add or edit
			 on success { actions { custom deluge script ( visitRec = Dining_Visits[ID == input.ID]; nowTime = zoho.currenttime; if(input.Visit_Status == "Check Requested" && visitRec.Check_Requested_Date_Time == null) { visitRec.Check_Requested_Date_Time = nowTime; } if(input.Visit_Status == "Paid" && visitRec.Paid_Date_Time == null) { visitRec.Paid_Date_Time = nowTime; } if((input.Visit_Status == "Closed" || input.Visit_Status == "Abandoned") && visitRec.Closed_Date_Time == null) { visitRec.Closed_Date_Time = nowTime; } tableRec = Dining_Tables[ID == input.Dining_Table]; if(input.Visit_Status == "Closed" || input.Visit_Status == "Paid" || input.Visit_Status == "Abandoned") { tableRec.Operational_Status = "Needs Reset"; } else { tableRec.Operational_Status = "Occupied"; } if(input.Reservation != null) { reservationRec = Reservations[ID == input.Reservation]; if(input.Visit_Status == "Closed") { reservationRec.Reservation_Status = "Completed"; reservationRec.Completed_Time = nowTime; } else { reservationRec.Reservation_Status = "Seated"; if(reservationRec.Seated_Time == null) { reservationRec.Seated_Time = nowTime; } } } if(input.Visit_Status == "Closed") { guestRec = Guests[ID == input.Guest]; if(guestRec.Last_Visit_Date == null || guestRec.Last_Visit_Date != nowTime.toDate()) { guestRec.Total_Visits = ifnull(guestRec.Total_Visits,0) + 1; guestRec.Last_Visit_Date = nowTime.toDate(); } } insert into POS_Sync_Log [ Entity_Type="Dining Visit" Local_Record_ID=input.ID External_Record_ID=input.POS_Check_ID Operation="Status Sync" Direction="Bidirectional" Sync_Status="Pending" Attempt_Count=0 ]; insert into Audit_Log [ Event_Date_Time=nowTime Actor_Email=zoho.loginuser Action_Type="Status Change" Entity_Type="Dining Visit" Entity_Record_ID=input.ID Entity_Reference=input.Visit_Number.toString() Change_Summary="Dining visit saved as " + input.Visit_Status After_Value=input.Visit_Status Source="Workflow" ]; ) } }
			}

			Dining_Visits_On_Validate as "Validate Dining Visit"
			{
			 type = form
			 form = Dining_Visits
			 record event = on add or edit
			 on validate { actions { custom deluge script ( if(ifnull(input.Party_Size,0) <= 0) { alert "Party size must be greater than zero."; cancel submit; } tableRec = Dining_Tables[ID == input.Dining_Table]; if(tableRec.Active != true || tableRec.Capacity < input.Party_Size) { alert "Dining table is inactive or too small."; cancel submit; } if(Dining_Visits[ID != input.ID && Dining_Table == input.Dining_Table && Visit_Status != "Closed" && Visit_Status != "Abandoned"].count() > 0) { alert "This table already has an active dining visit."; cancel submit; } if((input.Visit_Status == "Paid" || input.Visit_Status == "Closed") && ifnull(input.POS_Check_ID,"").trim() == "" && input.POS_Sync_Status != "Manual") { alert "Enter the POS check ID or mark the sync status as Manual before closing."; cancel submit; } ) } }
			}

			Visit_Status_On_User_Input as "Preview Visit Status Time"
			{
			 type = form
			 form = Dining_Visits
			 record event = on add or edit
			 on user input of Visit_Status { actions { custom deluge script ( if(input.Visit_Status == "Check Requested" && input.Check_Requested_Date_Time == null) { input.Check_Requested_Date_Time = zoho.currenttime; } if(input.Visit_Status == "Paid" && input.Paid_Date_Time == null) { input.Paid_Date_Time = zoho.currenttime; } if((input.Visit_Status == "Closed" || input.Visit_Status == "Abandoned") && input.Closed_Date_Time == null) { input.Closed_Date_Time = zoho.currenttime; } ) } }
			}

			Guest_Feedback_On_Load as "Prepare Guest Feedback"
			{
			 type = form
			 form = Guest_Feedback
			 record event = on add or edit
			 on load { actions { custom deluge script ( if(input.Follow_Up_Required != true) { hide Recovery_Action; hide Manager_Notes; } else { show Recovery_Action; show Manager_Notes; } ) } }
			}

			Guest_Feedback_On_Success as "Audit Feedback Follow-up"
			{
			 type = form
			 form = Guest_Feedback
			 record event = on add or edit
			 on success { actions { custom deluge script ( if(input.Overall_Rating <= 2 || input.Follow_Up_Status == "Resolved") { insert into Audit_Log [ Event_Date_Time=zoho.currenttime Actor_Email=zoho.loginuser Action_Type=if(input.Follow_Up_Status == "Resolved","Recovery","Exception") Entity_Type="Guest Feedback" Entity_Record_ID=input.ID Entity_Reference=input.Feedback_Number.toString() Change_Summary="Feedback rating " + input.Overall_Rating + ", follow-up " + input.Follow_Up_Status After_Value=input.Recovery_Action Source="Workflow" ]; } ) } }
			}

			Guest_Feedback_On_Validate as "Validate Guest Feedback"
			{
			 type = form
			 form = Guest_Feedback
			 record event = on add or edit
			 on validate { actions { custom deluge script ( if(input.Overall_Rating < 1 || input.Overall_Rating > 5 || input.Service_Rating < 1 || input.Service_Rating > 5 || input.Ambience_Rating < 1 || input.Ambience_Rating > 5) { alert "All ratings must be between 1 and 5."; cancel submit; } visitRec = Dining_Visits[ID == input.Dining_Visit]; if(visitRec.Guest != input.Guest) { alert "The selected guest does not match the dining visit."; cancel submit; } if(input.Overall_Rating <= 2 && (ifnull(input.Comments,"").trim() == "" || input.Follow_Up_Required != true)) { alert "Comments and follow-up are required for low ratings."; cancel submit; } if(input.Follow_Up_Status == "Resolved" && ifnull(input.Recovery_Action,"").trim() == "") { alert "Record the recovery action before resolving follow-up."; cancel submit; } ) } }
			}

			Overall_Rating_On_User_Input as "Set Feedback Follow-up"
			{
			 type = form
			 form = Guest_Feedback
			 record event = on add or edit
			 on user input of Overall_Rating { actions { custom deluge script ( if(ifnull(input.Overall_Rating,0) <= 2 && ifnull(input.Overall_Rating,0) > 0) { input.Follow_Up_Required = true; input.Follow_Up_Status = "Open"; show Recovery_Action; show Manager_Notes; } else { input.Follow_Up_Required = false; input.Follow_Up_Status = "Not Required"; hide Recovery_Action; hide Manager_Notes; } ) } }
			}

			Guests_On_Load as "Prepare Guest Profile"
			{
			    type = form
			    form = Guests
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Total_Visits;
			                disable No_Show_Count;
			                disable Last_Visit_Date;
			            )
			        }
			    }
			}

			Guests_On_Success as "Audit Guest Preferences"
			{
			    type = form
			    form = Guests
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                insert into Audit_Log
			                [
			                    Event_Date_Time=zoho.currenttime
			                    Actor_Email=zoho.loginuser
			                    Action_Type="Update"
			                    Entity_Type="Guest"
			                    Entity_Record_ID=input.ID
			                    Entity_Reference=input.Guest_Number.toString()
			                    Change_Summary="Guest preferences, allergy context, or profile details saved."
			                    After_Value=ifnull(input.Allergy_Notes,"")
			                    Source="Form"
			                ];
			            )
			        }
			    }
			}

			Guests_On_Validate as "Validate Guest Profile"
			{
			    type = form
			    form = Guests
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(ifnull(input.Mobile_Number,"").trim() == "" && ifnull(input.Email_Address,"").trim() == "")
			                {
			                    alert "Provide at least a mobile number or email address.";
			                    cancel submit;
			                }
			                if(input.Preferred_Contact_Method != "Phone" && input.Preferred_Contact_Method != "None" && input.Contact_Consent != true)
			                {
			                    alert "Contact consent is required for SMS, email, or WhatsApp communication.";
			                    cancel submit;
			                }
			                normalizedMobile = ifnull(input.Mobile_Number,"").replaceAll("[^0-9]","");
			                if(normalizedMobile != "" && Guests[ID != input.ID && Active == true && Mobile_Number == input.Mobile_Number].count() > 0)
			                {
			                    alert "A likely duplicate active guest exists with this mobile number.";
			                    cancel submit;
			                }
			                if(ifnull(input.Email_Address,"").trim() != "" && Guests[ID != input.ID && Active == true && Email_Address == input.Email_Address].count() > 0)
			                {
			                    alert "A likely duplicate active guest exists with this email address.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			POS_Sync_Log_On_Load as "Protect POS Sync Data"
			{
			 type = form
			 form = POS_Sync_Log
			 record event = on add or edit
			 on load { actions { custom deluge script ( disable Entity_Type; disable Local_Record_ID; disable External_Record_ID; disable Operation; disable Direction; disable Attempt_Count; disable Last_Attempt_Date_Time; disable Request_Payload; disable Response_Payload; disable Correlation_ID; ) } }
			}

			POS_Sync_Log_On_Success as "Audit POS Sync Override"
			{
			 type = form
			 form = POS_Sync_Log
			 record event = on edit
			 on success { actions { custom deluge script ( if(input.Sync_Status == "Pending" || input.Sync_Status == "Ignored") { insert into Audit_Log [ Event_Date_Time=zoho.currenttime Actor_Email=zoho.loginuser Action_Type="Sync Override" Entity_Type="POS Sync Log" Entity_Record_ID=input.ID Entity_Reference=input.Sync_Number.toString() Change_Summary="POS staging status manually set to " + input.Sync_Status After_Value=input.Sync_Status Source="POS Staging" ]; } ) } }
			}

			POS_Sync_Log_On_Validate as "Validate POS Sync Entry"
			{
			 type = form
			 form = POS_Sync_Log
			 record event = on add or edit
			 on validate { actions { custom deluge script ( if(ifnull(input.Local_Record_ID,0) <= 0) { alert "Local record ID must be greater than zero."; cancel submit; } if(input.Sync_Status == "Failed" && ifnull(input.Error_Message,"").trim() == "") { alert "Error message is required for a failed sync entry."; cancel submit; } ) } }
			}

			Reservation_Party_Size_On_User_Input as "Check Party Capacity"
			{
			 type = form
			 form = Reservations
			 record event = on add or edit
			 on user input of Party_Size { actions { custom deluge script ( if(ifnull(input.Party_Size,0) > 0 && Dining_Tables[Active == true && Capacity >= input.Party_Size].count() == 0) { alert "No active table currently fits this party size."; } ) } }
			}

			Reservation_Date_Time_On_User_Input as "Calculate Reservation End"
			{
			 type = form
			 form = Reservations
			 record event = on add or edit
			 on user input of Reservation_Date_Time { actions { custom deluge script ( if(input.Reservation_Date_Time != null) { duration = 90; if(input.Service_Period != null) { service = Service_Periods[ID == input.Service_Period]; duration = service.Default_Duration_Minutes; } input.Expected_End_Date_Time = input.Reservation_Date_Time.addMinutes(duration); } ) } }
			}

			Reservation_Status_On_User_Input as "Update Reservation Status Fields"
			{
			 type = form
			 form = Reservations
			 record event = on add or edit
			 on user input of Reservation_Status { actions { custom deluge script ( if(input.Reservation_Status == "Cancelled") { show Cancellation_Reason; } else { hide Cancellation_Reason; } if(input.Reservation_Status == "No Show") { show No_Show_Reason; } else { hide No_Show_Reason; } ) } }
			}

			Reservations_On_Load as "Prepare Reservation Form"
			{
			 type = form
			 form = Reservations
			 record event = on add or edit
			 on load { actions { custom deluge script ( disable Expected_End_Date_Time; disable Arrival_Time; disable Seated_Time; disable Completed_Time; disable Cancellation_Time; disable POS_Sync_Status; if(input.Reservation_Status == "Cancelled") { show Cancellation_Reason; } else { hide Cancellation_Reason; } if(input.Reservation_Status == "No Show") { show No_Show_Reason; } else { hide No_Show_Reason; } ) } }
			}

			Reservations_On_Success as "Process Reservation Status"
			{
			 type = form
			 form = Reservations
			 record event = on add or edit
			 on success { actions { custom deluge script ( nowTime = zoho.currenttime; reservationRec = Reservations[ID == input.ID]; if(input.Reservation_Status == "Arrived" && reservationRec.Arrival_Time == null) { reservationRec.Arrival_Time = nowTime; } if(input.Reservation_Status == "Seated" && reservationRec.Seated_Time == null) { reservationRec.Seated_Time = nowTime; } if(input.Reservation_Status == "Completed" && reservationRec.Completed_Time == null) { reservationRec.Completed_Time = nowTime; } if(input.Reservation_Status == "Cancelled" && reservationRec.Cancellation_Time == null) { reservationRec.Cancellation_Time = nowTime; } if(input.Assigned_Table != null && input.Reservation_Status in {"Tentative","Confirmed","Arrived"}) { tableRec = Dining_Tables[ID == input.Assigned_Table]; tableRec.Operational_Status = "Reserved"; } insert into POS_Sync_Log [ Entity_Type="Reservation" Local_Record_ID=input.ID Operation="Update" Direction="Outbound" Sync_Status="Pending" Attempt_Count=0 ]; insert into Audit_Log [ Event_Date_Time=nowTime Actor_Email=zoho.loginuser Action_Type="Status Change" Entity_Type="Reservation" Entity_Record_ID=input.ID Entity_Reference=input.Reservation_Number.toString() Change_Summary="Reservation saved as " + input.Reservation_Status After_Value=input.Reservation_Status Source="Workflow" ]; ) } }
			}

			Reservations_On_Validate as "Validate Reservation"
			{
			 type = form
			 form = Reservations
			 record event = on add or edit
			 on validate { actions { custom deluge script ( if(ifnull(input.Party_Size,0) <= 0) { alert "Party size must be greater than zero."; cancel submit; } service = Service_Periods[ID == input.Service_Period]; if(service.count() == 0 || service.Active != true) { alert "Select an active service period."; cancel submit; } input.Expected_End_Date_Time = input.Reservation_Date_Time.addMinutes(service.Default_Duration_Minutes); if(input.Assigned_Table != null) { tableRec = Dining_Tables[ID == input.Assigned_Table]; if(tableRec.Active != true || tableRec.Capacity < input.Party_Size) { alert "Assigned table is inactive or too small."; cancel submit; } overlap = Reservations[ID != input.ID && Assigned_Table == input.Assigned_Table && Reservation_Status != "Cancelled" && Reservation_Status != "No Show" && Reservation_Status != "Completed" && Reservation_Date_Time < input.Expected_End_Date_Time && Expected_End_Date_Time > input.Reservation_Date_Time].count(); if(overlap > 0) { alert "The assigned table has an overlapping reservation."; cancel submit; } } covers = Reservations[ID != input.ID && Service_Period == input.Service_Period && Reservation_Date_Time >= input.Reservation_Date_Time.toDate() && Reservation_Date_Time < input.Reservation_Date_Time.toDate().addDay(1) && Reservation_Status != "Cancelled" && Reservation_Status != "No Show"].sum(Party_Size); if(ifnull(covers,0) + input.Party_Size > service.Maximum_Covers) { alert "This service period has reached its cover capacity."; cancel submit; } if(input.Reservation_Status == "Cancelled" && ifnull(input.Cancellation_Reason,"").trim() == "") { alert "Cancellation reason is required."; cancel submit; } if(input.Reservation_Status == "No Show" && ifnull(input.No_Show_Reason,"").trim() == "") { alert "No-show reason is required."; cancel submit; } ) } }
			}

			Service_Period_On_User_Input as "Apply Service Duration"
			{
			 type = form
			 form = Reservations
			 record event = on add or edit
			 on user input of Service_Period { actions { custom deluge script ( if(input.Service_Period != null && input.Reservation_Date_Time != null) { service = Service_Periods[ID == input.Service_Period]; input.Expected_End_Date_Time = input.Reservation_Date_Time.addMinutes(service.Default_Duration_Minutes); } ) } }
			}

			Restaurant_Settings_On_Validate as "Validate Restaurant Settings"
			{
			    type = form
			    form = Restaurant_Settings
			    record event = on add or edit
			    description = "Validates operating defaults and enforces one active settings record."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(ifnull(input.Default_Reservation_Duration_Minutes,0) <= 0 || ifnull(input.Table_Turn_Buffer_Minutes,0) <= 0 || ifnull(input.Arrival_Grace_Period_Minutes,0) <= 0 || ifnull(input.Default_Wait_Quote_Minutes,0) <= 0)
			                {
			                    alert "Reservation duration, table buffer, arrival grace period, and default wait quote must all be greater than zero.";
			                    cancel submit;
			                }
			                if(input.Active == true && Restaurant_Settings[Active == true && ID != input.ID].count() > 0)
			                {
			                    alert "Only one restaurant settings record can be active.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Service_Periods_On_Validate as "Validate Service Period"
			{
			    type = form
			    form = Service_Periods
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Start_Time >= input.End_Time)
			                {
			                    alert "Service start time must be before end time.";
			                    cancel submit;
			                }
			                if(input.Last_Seating_Time < input.Start_Time || input.Last_Seating_Time > input.End_Time)
			                {
			                    alert "Last seating time must fall within the service period.";
			                    cancel submit;
			                }
			                if(ifnull(input.Booking_Interval_Minutes,0) <= 0 || ifnull(input.Default_Duration_Minutes,0) <= 0 || ifnull(input.Maximum_Covers,0) <= 0)
			                {
			                    alert "Booking interval, default duration, and maximum covers must be greater than zero.";
			                    cancel submit;
			                }
			                if(input.Days_Of_Week == null || input.Days_Of_Week.isEmpty())
			                {
			                    alert "Select at least one operating day.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Waitlist_Party_Size_On_User_Input as "Suggest Wait Quote"
			{
			 type = form
			 form = Waitlist_Entries
			 record event = on add or edit
			 on user input of Party_Size { actions { custom deluge script ( settings = Restaurant_Settings[Active == true]; if(settings.count() > 0 && ifnull(input.Quoted_Wait_Minutes,0) <= 0) { input.Quoted_Wait_Minutes = settings.Default_Wait_Quote_Minutes; } if(ifnull(input.Party_Size,0) > 0 && Dining_Tables[Active == true && Capacity >= input.Party_Size].count() == 0) { alert "No active table can fit this party size."; } ) } }
			}

			Waitlist_Entries_On_Load as "Prepare Waitlist Entry"
			{
			 type = form
			 form = Waitlist_Entries
			 record event = on add or edit
			 on load { actions { custom deluge script ( disable Offered_Date_Time; disable Seated_Date_Time; if(input.Waitlist_Status == "Removed" || input.Waitlist_Status == "Expired") { show Removal_Reason; } else { hide Removal_Reason; } ) } }
			}

			Waitlist_Entries_On_Success as "Process Waitlist Status"
			{
			 type = form
			 form = Waitlist_Entries
			 record event = on add or edit
			 on success { actions { custom deluge script ( entry = Waitlist_Entries[ID == input.ID]; if(input.Waitlist_Status == "Notified" && entry.Offered_Date_Time == null) { entry.Offered_Date_Time = zoho.currenttime; } if(input.Waitlist_Status == "Seated") { if(entry.Seated_Date_Time == null) { entry.Seated_Date_Time = zoho.currenttime; } if(Dining_Visits[Waitlist_Entry == input.ID].count() == 0) { visitId = insert into Dining_Visits [ Guest=input.Guest Waitlist_Entry=input.ID Reservation=input.Related_Reservation Dining_Table=input.Assigned_Table Party_Size=input.Party_Size Visit_Status="Seated" Seated_Date_Time=zoho.currenttime POS_Sync_Status="Pending" ]; } tableRec = Dining_Tables[ID == input.Assigned_Table]; tableRec.Operational_Status = "Occupied"; insert into Audit_Log [ Event_Date_Time=zoho.currenttime Actor_Email=zoho.loginuser Action_Type="Assignment" Entity_Type="Waitlist Entry" Entity_Record_ID=input.ID Entity_Reference=input.Waitlist_Number.toString() Change_Summary="Waitlist party seated at table " + tableRec.Table_Number After_Value="Seated" Source="Workflow" ]; } ) } }
			}

			Waitlist_Entries_On_Validate as "Validate Waitlist Entry"
			{
			 type = form
			 form = Waitlist_Entries
			 record event = on add or edit
			 on validate { actions { custom deluge script ( if(ifnull(input.Party_Size,0) <= 0 || ifnull(input.Quoted_Wait_Minutes,0) <= 0) { alert "Party size and quoted wait must be greater than zero."; cancel submit; } if(Waitlist_Entries[ID != input.ID && Guest == input.Guest && (Waitlist_Status == "Waiting" || Waitlist_Status == "Notified" || Waitlist_Status == "Arrived")].count() > 0) { alert "This guest already has an active waitlist entry."; cancel submit; } if(input.Waitlist_Status == "Seated") { if(input.Assigned_Table == null) { alert "Assign a table before seating the party."; cancel submit; } tableRec = Dining_Tables[ID == input.Assigned_Table]; if(tableRec.Active != true || tableRec.Capacity < input.Party_Size || tableRec.Operational_Status != "Available") { alert "The assigned table is unavailable or too small."; cancel submit; } } if((input.Waitlist_Status == "Removed" || input.Waitlist_Status == "Expired") && ifnull(input.Removal_Reason,"").trim() == "") { alert "Removal reason is required."; cancel submit; } ) } }
			}

			Waitlist_Status_On_User_Input as "Update Waitlist Status Fields"
			{
			 type = form
			 form = Waitlist_Entries
			 record event = on add or edit
			 on user input of Waitlist_Status { actions { custom deluge script ( if(input.Waitlist_Status == "Removed" || input.Waitlist_Status == "Expired") { show Removal_Reason; hide Assigned_Table; } else { hide Removal_Reason; show Assigned_Table; } ) } }
			}
		}
	}

