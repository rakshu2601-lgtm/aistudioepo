list Guests_With_Allergies
{
    displayName = "Guests With Allergies"
    show all rows from Guests [Allergy_Notes != "" && Active == true]
    (
        Guest_Number
        Guest_Name
        Mobile_Number
        Dietary_Preferences
        Allergy_Notes
        Seating_Preferences
        VIP_Guest
        Active
    )
    filters
    (
        Dietary_Preferences
        VIP_Guest
    )
    sort by
    (
        Guest_Name ascending
    )
}
