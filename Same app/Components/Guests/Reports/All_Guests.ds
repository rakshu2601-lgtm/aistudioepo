default list All_Guests
{

			displayName = "All Guests"
			show all rows from Guests    
			(
				Guest_Number
				Guest_Name 
				Mobile_Number
				Email_Address
				Preferred_Contact_Method
				Dietary_Preferences
				Allergy_Notes
				Seating_Preferences
				VIP_Guest
				Total_Visits
				No_Show_Count
				Last_Visit_Date
				Active
			)
			filters
			(
				Preferred_Contact_Method
				VIP_Guest
				Active
			)
			sort by
			(
				Guest_Name.first_name ascending
			)
		
}