default list All_Dining_Visits
{

			displayName = "All Dining Visits"
			show all rows from Dining_Visits    
			(
				Visit_Number
				Guest
				Reservation
				Waitlist_Entry
				Dining_Table
				Party_Size
				Visit_Status
				Server_Name
				Seated_Date_Time
				Check_Requested_Date_Time
				Paid_Date_Time
				Closed_Date_Time
				POS_Check_ID
				POS_Check_Total
				POS_Sync_Status
			)
			filters
			(
				Visit_Status
				Dining_Table
				Server_Name
				POS_Sync_Status
			)
			sort by
			(
				Seated_Date_Time descending
			)
		
}