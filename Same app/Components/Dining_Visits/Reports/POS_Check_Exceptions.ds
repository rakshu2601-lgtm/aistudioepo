list POS_Check_Exceptions
{

			displayName = "POS Check Exceptions"
			show all rows from Dining_Visits  [POS_Sync_Status == "Failed" || (Visit_Status == "Paid" || Visit_Status == "Closed" && POS_Check_ID == "")]  
			(
				Visit_Number
				Guest
				Dining_Table
				Visit_Status
				Server_Name
				Seated_Date_Time
				POS_Check_ID
				POS_Check_Total
				POS_Sync_Status
				Service_Notes
			)
			filters
			(
				Visit_Status
				POS_Sync_Status
				Server_Name
			)
			sort by
			(
				Seated_Date_Time descending
			)
		
}