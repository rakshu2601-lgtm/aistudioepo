default list All_POS_Sync_Logs
{

			displayName = "All POS Sync Logs"
			show all rows from POS_Sync_Log    
			(
				Sync_Number
				Entity_Type
				Local_Record_ID
				External_Record_ID
				Operation
				Direction
				Sync_Status
				Attempt_Count
				Last_Attempt_Date_Time
				Next_Retry_Date_Time
				Error_Message
				Correlation_ID
			)
			filters
			(
				Entity_Type
				Operation
				Direction
				Sync_Status
			)
			sort by
			(
				Sync_Number descending
			)
		
}