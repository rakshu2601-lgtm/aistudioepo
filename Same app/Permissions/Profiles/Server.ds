"Server"
{
    name = "Server"
    type = Users_Permissions
    permissions = {Chat:true,Predefined:false,ApiAccess:false,PIIAccess:false,ePHIAccess:false}
    description = "Dining-room server with live floor visibility, controlled visit updates, and feedback capture."
    ModulePermissions
    {
        Dining_Areas { enabled = Viewall,View,Search allFieldsVisible = true ReportPermissions { Active_Dining_Areas={"View"} } }
        Dining_Tables { enabled = Viewall,View,Search allFieldsVisible = false FieldPermissions { Table_Number{visibility:true,readonly:true} Dining_Area{visibility:true,readonly:true} Capacity{visibility:true,readonly:true} Table_Type{visibility:true,readonly:true} Operational_Status{visibility:true,readonly:true} Block_Reason{visibility:true,readonly:true} Active{visibility:true,readonly:true} } ReportPermissions { Live_Table_Status={"View"} Available_Tables={"View"} } }
        Guests
        {
            enabled = Viewall,View,Search
            allFieldsVisible = false
            FieldPermissions
            {
                Guest_Number{visibility:true,readonly:true} Guest_Name{visibility:true,readonly:true} Dietary_Preferences{visibility:true,readonly:true} Allergy_Notes{visibility:true,readonly:true} Seating_Preferences{visibility:true,readonly:true} VIP_Guest{visibility:true,readonly:true}
            }
            ReportPermissions { Guests_With_Allergies={"View"} }
        }
        Reservations
        {
            enabled = Viewall,View,Search
            allFieldsVisible = false
            FieldPermissions
            {
                Reservation_Number{visibility:true,readonly:true} Guest{visibility:true,readonly:true} Reservation_Date_Time{visibility:true,readonly:true} Expected_End_Date_Time{visibility:true,readonly:true} Service_Period{visibility:true,readonly:true} Party_Size{visibility:true,readonly:true} Assigned_Table{visibility:true,readonly:true} Reservation_Status{visibility:true,readonly:true} Occasion{visibility:true,readonly:true} Special_Requests{visibility:true,readonly:true} Arrival_Time{visibility:true,readonly:true} Seated_Time{visibility:true,readonly:true}
            }
            ReportPermissions { Todays_Reservations={"View"} Reservation_Status_Board={"View"} }
        }
        Dining_Visits
        {
            enabled = Viewall,Modifyall,Tab,View,Edit,Search
            allFieldsVisible = false
            FieldPermissions
            {
                Visit_Number{visibility:true,readonly:true} Guest{visibility:true,readonly:true} Reservation{visibility:true,readonly:true} Waitlist_Entry{visibility:true,readonly:true} Dining_Table{visibility:true,readonly:true} Party_Size{visibility:true,readonly:true} Visit_Status{visibility:true,readonly:false} Server_Name{visibility:true,readonly:false} Seated_Date_Time{visibility:true,readonly:true} Check_Requested_Date_Time{visibility:true,readonly:true} Paid_Date_Time{visibility:true,readonly:true} Closed_Date_Time{visibility:true,readonly:true} POS_Check_ID{visibility:true,readonly:false} POS_Check_Total{visibility:true,readonly:true} POS_Sync_Status{visibility:true,readonly:true} Service_Notes{visibility:true,readonly:false}
            }
            ReportPermissions { All_Dining_Visits={"View","Edit"} Live_Dining_Room={"View","Edit"} Completed_Visits={"View"} }
        }
        Guest_Feedback
        {
            enabled = Create,Viewall,Tab,View,Search
            allFieldsVisible = false
            FieldPermissions
            {
                Feedback_Number{visibility:true,readonly:true} Guest{visibility:true,readonly:false} Dining_Visit{visibility:true,readonly:false} Feedback_Date_Time{visibility:true,readonly:false} Overall_Rating{visibility:true,readonly:false} Service_Rating{visibility:true,readonly:false} Ambience_Rating{visibility:true,readonly:false} Comments{visibility:true,readonly:false} Would_Return{visibility:true,readonly:false} Follow_Up_Required{visibility:true,readonly:true} Follow_Up_Status{visibility:true,readonly:true} Recovery_Action{visibility:false} Manager_Notes{visibility:false}
            }
            ReportPermissions { All_Guest_Feedback={"View"} }
        }
        Host_Operations { enabled = tab }
        Live_Floor_Board { enabled = tab }
    }
}